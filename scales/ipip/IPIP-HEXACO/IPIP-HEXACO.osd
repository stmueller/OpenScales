    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_X91": "Dešava mi se da se služim laskanjem kako bih napredovao.",
      "ipip_Q151": "Održavam visok nivo energije tokom celog dana.",
      "ipip_H1206": "Vredno radim.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_H1351": "Kad nešto radim, obično se pridržavam plana.",
      "ipip_H1195": "Ne verujem ljudima.",
      "ipip_Q191": "Osećam da imam mnogo unutrašnje snage.",
      "ipip_Q82": "Ne znam mnogo o istoriji.",
      "ipip_H252": "Izbegavam svoje greške.",
      "ipip_E150": "Ne brinem o onome što se već dogodilo.",
      "ipip_P445": "Imam snažnu potrebu za moći.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_H1227": "Podižem razgovor na viši nivo.",
      "ipip_H1285": "Obavljam zadatke uspešno.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_X210": "Teško opraštam drugima.",
      "ipip_H1376": "Teško me je urazumiti.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_D11": "Retko mi se desi da mi sine rešenje problema.",
      "ipip_H822": "Ostavljam nered u svojoj sobi.",
      "ipip_Q243": "Radim stveri ne razmišljajući o posledicama.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_D39": "U društvu se uvek nađe bar jedna osoba koja me iritira.",
      "ipip_D82": "Retko uživam u društvu drugih ljudi.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_H1230": "Smišljam nove stvari.",
      "ipip_H1146": "Svoja osećanja zadržavam za sebe..",
      "ipip_R12": "Stvari koje počnem, često ne završim.",
      "ipip_Q69": "Zanima me nauka.",
      "ipip_D63": "Obično sam strpljiva osoba.",
      "ipip_H2016": "Uživam da budem deo grupe.",
      "ipip_Q160": "Uživam u intelektualnim igrama.",
      "ipip_D46": "Jako bi mi smetalo da me smatraju čudnim ili neobičnim.",
      "ipip_P342": "U različitim situacijama se ponašam potpuno različito.",
      "ipip_H1150": "Volim da privlačim pažnju.",
      "ipip_X118": "Volim red.",
      "ipip_Q66": "Pravim budalu od sebe.",
      "ipip_E82": "Iritira me kada drugi greše.",
      "ipip_H995": "Potrebna mi je zastita.",
      "ipip_H286": "Ono što radim, dovodim do savršenstva.",
      "ipip_H279": "Sklon sam da kritikujem tuđe nedostatke.",
      "ipip_P491": "Ponašam se upadljivo da bih impresionirao druge.",
      "ipip_H1325": "Činim sve da ostvarim ličnu korist.",
      "ipip_A80": "Imam utisak da me izraz lica odaje kada sam tužan..",
      "ipip_D99": "Uživam da me smatraju normalnom, uobičajenom osobom.",
      "ipip_Q65": "Brzo se umaram.",
      "ipip_D65": "Retko kad se rastužim dok čitam tužne delove neke priče.",
      "ipip_R75": "Pravim nesmotrene greške.",
      "ipip_X225": "Volim da smišljam nove načine kako da uradim nesto.",
      "ipip_H975": "Često dozvoljavam da drugi utiču na mene.",
      "ipip_Q236": "Posedujem veliku izdržljivost.",
      "ipip_H1302": "Nikad ne ostajem \"bez teksta\".",
      "ipip_D30": "Smejem se glasno i snažno.",
      "ipip_D20": "Mislim da manje uživam u kontaktima nego drugi ljudi.",
      "ipip_Q126": "Samouvereno se suočavam sa opasnostima.",
      "ipip_D4": "Retko primećujem emocije koje sa sobom nose fotografije i slike.",
      "ipip_X115": "Radim tek toliko koliko je potrebno.",
      "ipip_D73": "Znam da moje ideje ponekad iznenade druge ljude.",
      "ipip_P399": "Dopuštam ljudima da mi pomognu kako bi se osećali važnima.",
      "ipip_Q189": "Imam osećaj da se većini ljudi ne može verovati.",
      "ipip_H755": "Često gubim živce.",
      "ipip_H917": "Imam oštar jezik.",
      "ipip_A41": "Brzo izgubim interes za poslove koje započnem.",
      "ipip_Q14": "Imam snažnu ličnost.",
      "ipip_H584": "Malo govorim.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_H691": "Radim stvari koje drugima deluju čudno.",
      "ipip_A101": "Kada sam tužan, to i pokažem.",
      "ipip_D101": "Ne dopadaju mi se poslovi koji zahtevaju mnogo kontakata s ljudima.",
      "ipip_R53": "Volim da radim zastrašujuće stvari.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_Q220": "Često odustajem kada posao postane isuviše težak.",
      "ipip_P367": "Nikada ne bih uzeo nešto što nije moje.",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_R11": "Puno pričam.",
      "ipip_E156": "Ne razumem ljude koji su osetljivi.",
      "ipip_X79": "Ostajem smiren/a kada sam pod pritiskom.",
      "ipip_H244": "Volim da spremam.",
      "ipip_H137": "Sklon sam praštanju.",
      "ipip_Q175": "Ne mislim da sam bolji od drugih.",
      "ipip_D87": "Retko se osećam depresivno.",
      "ipip_H288": "Zahtevam kvalitet.",
