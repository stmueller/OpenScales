  "translations": {
    "en": {
      "r1": "strongly disagree",
      "r2": "somewhat disagree",
      "r3": "somewhat agree",
      "r4": "strongly agree",
      "qh": "Please indicate how much you agree with each of the following statements.",
      "LANGUAGE": "English",
      "ns1": "When I am down, I need someone who boosts my spirits.",
      "ns2": "It is important for me always to have someone who listens to me.",
      "ns3": "Before making any important decisions, I absolutely need a second opinion.",
      "ns4": "I get along best without any outside help."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "LANGUAGE": "Deutsch",
      "ns1": "Wenn ich niedergeschlagen bin, dann brauche ich jemanden, der mich wieder aufbaut.",
      "ns2": "Mir ist es wichtig, dass immer jemand da ist, der mir zuhört.",
      "ns3": "Bevor ich wichtige Entscheidungen treffe, brauche ich unbedingt die Meinung von anderen.",
      "ns4": "Ich komme am besten ohne fremde Hilfe zurecht."
    },
    "es": {
      "r1": "falsa",
      "r2": "rara vez verdadero",
      "r3": "moderadamente verdadero",
      "r4": "totalmente verdadero",
      "qh": "Indique en qué medida cada afirmación es cierta para usted (de 1 a 4).",
      "LANGUAGE": "Español",
      "ns1": "Cuando estoy decaído(a), necesito alguien para levantarme el ánimo.",
      "ns2": "Para mi es importante tener siempre alguien que me escuche.",
      "ns3": "Antes de tomar una decisión importante, definitivamente necesito una segunda opinión.",
      "ns4": "Me arreglo mejor sin ninguna ayuda."
    },
    "fr": {
      "r1": "pas du tout vrai",
      "r2": "plutôt pas vrai",
      "r3": "plutôt vrai",
      "r4": "tout à fait vrai",
      "qh": "Veuillez indiquer dans quelle mesure chaque affirmation est vraie pour vous.",
      "LANGUAGE": "Français",
      "ns1": "Quand je n'ai pas le moral j'ai besoin de quelqu'un pour me le remonter.",
      "ns2": "C'est important pour moi de toujours avoir quelqu'un qui m'écoute.",
      "ns3": "Avant de prendre des décisions importantes, j'ai absolument besoin de l'avis des autres.",
      "ns4": "Je me débrouille mieux sans l'aide des autres."
    },
    "pl": {
      "r1": "całkowicie nieprawdziwe",
      "r2": "w małym stopniu prawdziwe",
      "r3": "w umiarkowanym stopniu prawdziwe",
      "r4": "całkowicie prawdziwe",
      "qh": "Proszę wskazać, w jakim stopniu każde stwierdzenie jest prawdziwe dla Pana/Pani.",
      "LANGUAGE": "Polski",
      "ns1": "Kiedy jestem przygnębiony, potrzebuję kogoś, kto podniesie mnie na duchu",
      "ns2": "Ważną rzeczą jest dla mnie, by zawsze mieć kogoś, kto mnie wysłucha",
      "ns3": "Zanim podejmę ważne decyzje, koniecznie muszę zasięgnąć czyjejś opinii",
      "ns4": "Najlepiej daję sobie radę bez żadnej pomocy z zewnątrz"
    },
    "sr": {
      "r1": "uopšte ne",
      "r2": "uglavnom ne",
      "r3": "uglavnom da",
      "r4": "da, u potpunosti",
      "qh": "Molimo Vas da označite u kojoj meri svaka tvrdnja važi za Vas.",
      "LANGUAGE": "Srpski",
      "ns1": "Kada doživim neuspeh, treba mi neko ko će mi pomoći da se oporavim.",
      "ns2": "Važno mi je da uvek postoji neko ko će da me sasluša.",
      "ns3": "Pre nego što donesem važne odluke, neophodno mi je mišljenje drugih.",
      "ns4": "Najbolje se snalazim bez ičije pomoći."
