{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Proactive Coping Scale",
      "code": "PCOPE",
      "abbreviation": "PCOPE",
      "description": "Proactive Coping (Greenglass, Schwarzer & Taubert, 1999) — the standalone Proactive Coping subscale of the PCI. LANGUAGE VARIANT: English = 14-item PCI subscale; German & Spanish = 17-item standalone version. 4-point; reverse items differ by version; mean.",
      "citation": "Greenglass, E., Schwarzer, R., & Taubert, S. (1999). The Proactive Coping Inventory (PCI). http://userpage.fu-berlin.de/~health/greenpci.htm",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~health/procoping.htm",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "LANGUAGE VARIANT (variants.sets). English = the 14-item PCI 'Proactive Coping' subscale (Greenglass/Schwarzer/Taubert 1999; reverse 2,9,14). German (FU-Berlin skalen) and Spanish (Schwarzer/Greenglass/Gutiérrez/Taubert 1999) share the 17-item standalone 'Proaktives Coping' version (reverse 3,8,14,15); German and Spanish map 1:1. Cronbach's alpha .86 (German, N=285). 4-point; mean."
    },
    "likert_options": {
