  "translations": {
    "en": {
      "DASSY_head": "Please read each statement and indicate how true it was for you during the past week.",
      "DASSY_r0": "Not true",
      "DASSY_r1": "Sometimes true",
      "DASSY_r2": "Often true",
      "DASSY_r3": "Very true",
      "DASSY001": "I hated my life.",
      "DASSY002": "I hated myself.",
      "DASSY003": "I felt that life was terrible.",
      "DASSY004": "I felt like I was no good.",
      "DASSY005": "I could not stop feeling sad.",
      "DASSY006": "I did not enjoy anything.",
      "DASSY007": "There was nothing nice I could look forward to.",
      "DASSY008": "I felt like I was about to panic.",
      "DASSY009": "I felt terrified.",
      "DASSY010": "I felt scared for no good reason.",
      "DASSY011": "I could feel my heart beating.",
      "DASSY012": "I had trouble breathing.",
      "DASSY013": "My hands felt shaky.",
      "DASSY014": "I felt dizzy, like I was about to faint.",
      "DASSY015": "I got upset about little things.",
      "DASSY016": "I was easily irritated.",
      "DASSY017": "I found myself over-reacting to situations.",
      "DASSY018": "I was easily annoyed.",
      "DASSY019": "I was stressing about lots of things.",
      "DASSY020": "I got annoyed when people interrupted.",
      "DASSY021": "I found it difficult to relax."
    },
    "de": {
      "DASSY015": "Ich regte mich über Kleinigkeiten auf",
      "DASSY014": "Mir war schwindelig, wie wenn ich in Ohnmacht fallen würde",
      "DASSY006": "Ich habe nichts genossen",
      "DASSY012": "Ich hatte Schwierigkeiten zu atmen (z.B. schnelles Atmen), obwohl ich keinen Sport machte und ich nicht krank war",
      "DASSY001": "Ich hasste mein Leben",
      "DASSY017": "Ich reagierte in Situationen über",
      "DASSY013": "Meine Hände fühlten sich zittrig an",
      "DASSY019": "Ich war wegen vieler Dinge gestresst",
      "DASSY009": "Ich fühlte mich verschreckt",
      "DASSY007": "Es gab nichts Schönes, auf das ich mich freuen konnte",
      "DASSY016": "Ich war schnell gereizt",
      "DASSY021": "Ich fand es schwierig mich zu entspannen",
      "DASSY005": "Ich konnte nicht aufhören mich traurig zu fühlen",
      "DASSY020": "Ich war genervt, wenn Leute mich unterbrachen",
      "DASSY008": "Ich fühlte mich einer Panik nahe",
      "DASSY002": "Ich hasste mich selbst",
      "DASSY004": "Ich fühlte mich zu nichts zu gebrauchen",
      "DASSY018": "Ich war schnell genervt",
      "DASSY011": "Ich konnte mein Herz schnell schlagen fühlen, obwohl ich mich nicht stark körperlich betätigt hatte",
      "DASSY010": "Ich fühlte mich grundlos ängstlich",
      "DASSY003": "Ich fand das Leben war furchtbar",
      "DASSY_head": "Bitte lies jeden Satz und kreise die Zahl ein, die am besten angibt, wie sehr jeder Satz auf dich während der letzten Woche zutraf.",
      "DASSY_r0": "Nicht zutreffend",
      "DASSY_r1": "Ein wenig zutreffend",
      "DASSY_r2": "Ziemlich zutreffend",
      "DASSY_r3": "Sehr stark zutreffend"
    },
    "nl": {
      "DASSY015": "Ik merkte dat ik overstuur raakte van onbelangrijke zaken",
      "DASSY014": "Ik had het gevoel flauw te gaan vallen",
      "DASSY006": "Ik kon nergens van genieten",
      "DASSY012": "Ik zweette merkbaar (bijv. zweethanden) terwijl het niet warm was en ik me niet inspande",
      "DASSY001": "Ik haatte mijn leven",
      "DASSY017": "Ik had de neiging om overdreven te reageren op situaties",
      "DASSY013": "Mijn handen voelden trillerig aan",
      "DASSY019": "Ik vond het moeilijk om me te ontspannen",
      "DASSY009": "Ik voelde me doodsbang",
      "DASSY007": "Ik had het gevoel dat ik niets had om naar uit te kijken",
      "DASSY016": "Ik merkte dat ik gemakkelijk overstuur raakte",
      "DASSY021": "Ik vond het moeilijk om te ontspannen",
      "DASSY005": "Ik voelde me verdrietig en depressief",
      "DASSY020": "Ik raakte geïrriteerd als mensen mij onderbraken",
      "DASSY008": "Ik had het gevoel dat ik in paniek zou raken",
      "DASSY002": "Ik haatte mezelf",
      "DASSY004": "Ik had het gevoel dat ik als persoon niet veel voorstel",
      "DASSY018": "Ik raakte snel geïrriteerd",
      "DASSY011": "Ik had moeite met ademhalen (bijv. te snel ademen, buiten adem zijn zonder me in te spannen)",
      "DASSY010": "Ik was angstig zonder enige reden",
      "DASSY003": "Ik vond het leven verschrikkelijk",
      "DASSY_head": "Geef voor elk van de onderstaande uitspraken aan in hoeverre de uitspraak de afgelopen week voor jou van toepassing was.",
      "DASSY_r0": "Niet waar",
      "DASSY_r1": "Een beetje waar",
      "DASSY_r2": "Redelijk waar",
      "DASSY_r3": "Heel waar"
    },
    "pl": {
      "DASSY015": "Denerwowałam/denerwowałem się z powodu drobnych rzeczy",
      "DASSY014": "Czułam/czułem zawroty głowy, jakbym miała/miał zemdleć",
      "DASSY006": "Nic mnie nie cieszyło",
      "DASSY012": "Miałam/miałem trudności z oddychaniem (np. szybki oddech), nawet jeśli nie ćwiczyłam/ćwiczyłem i nie byłam/byłem chora/chory",
      "DASSY001": "Nienawidziłam/nienawidziłem swojego życia",
      "DASSY017": "Nadmiernie reagowałam/reagowałem na sytuacje",
      "DASSY013": "Moje ręce drżały",
      "DASSY019": "Stresowałam/stresowałem się z powodu wielu rzeczy",
      "DASSY009": "Czułam/czułem przerażenie",
      "DASSY007": "Nie było niczego miłego, na co mogłam/mogłem czekać",
      "DASSY016": "Łatwo było mnie zirytować",
      "DASSY021": "Trudno było mi się zrelaksować",
      "DASSY005": "Nie mogłam/mogłem przestać czuć smutku",
      "DASSY020": "Denerwowałam/denerwowałem się, gdy ktoś mi przerywał",
      "DASSY008": "Czułam/czułem, że zaraz zacznę panikować",
      "DASSY002": "Nienawidziłam/nienawidziłem siebie",
      "DASSY004": "Czułam/czułem, że nie jestem dobra/dobry",
      "DASSY018": "Łatwo było mnie zdenerwować",
      "DASSY011": "Czułam/czułem, jak serce mi bardzo szybko bije, nawet jeśli nie wykonywałam/wykonywałem żadnego wysiłku fizycznego",
      "DASSY010": "Czułam/czułem się przestraszony/a bez żadnego powodu",
      "DASSY003": "Czułam/czułem, że życie jest okropne",
      "DASSY_head": "Proszę przeczytać każde zdanie i zakreślić liczbę, która najlepiej pokazuje, jak prawdziwe było to zdanie w ciągu ostatniego tygodnia.",
      "DASSY_r0": "Nieprawdziwe",
      "DASSY_r1": "Mało prawdziwe",
      "DASSY_r2": "Całkiem prawdziwe",
      "DASSY_r3": "Bardzo prawdziwe"
    },
    "sr": {
      "DASSY015": "Uznemirio bih se zbog sitnica.",
      "DASSY014": "Osećao sam vrtoglavicu, kao da ću da se onesvestim.",
      "DASSY006": "Ni u čemu nisam uživao.",
      "DASSY012": "Imao sam poteškoća sa disanjem (na primer, ubrzano sam disao), iako se nisam fizički naprezao niti sam bio bolestan.",
      "DASSY001": "Mrzeo sam svoj život.",
      "DASSY017": "Preterano sam reagovao na razne situacije.",
      "DASSY013": "Osećao sam da mi ruke drhte.",
      "DASSY019": "Osećao sam se napeto povodom raznih stvari.",
      "DASSY009": "Osećao sam se prestravljeno.",
      "DASSY007": "Nije bilo ničeg lepog čemu bih se radovao.",
      "DASSY016": "Lako bi me nešto iznerviralo.",
      "DASSY021": "Bilo mi je teško da se opustim.",
      "DASSY005": "Nisam mogao da prestanem da se osećam tužno.",
      "DASSY020": "Nerviralo me kada bi me neko prekinuo u onome što radim.",
      "DASSY008": "Osećao sam se kao da sam na ivici panike.",
      "DASSY002": "Mrzeo sam sebe.",
      "DASSY004": "Osećao sam se bezvredno.",
      "DASSY018": "Lako bi me nešto naljutilo.",
      "DASSY011": "Osećao sam da mi srce brzo lupa, iako se nisam fizički naprezao.",
      "DASSY010": "Osećao sam se uplašeno bez razloga.",
      "DASSY003": "Osećao sam da je život grozan.",
      "DASSY_head": "Pročitaj svaku rečenicu i označi koliko tačno svaka od njih opisuje tvoja osećanja u poslednjih nedelju dana.",
      "DASSY_r0": "Nimalo tačno",
      "DASSY_r1": "Malo tačno",
      "DASSY_r2": "Donekle tačno",
      "DASSY_r3": "Veoma tačno"
    },
    "es": {
      "DASSY015": "Me molesté por cosas pequeñas",
      "DASSY014": "Me sentí mareado(a), como si estuviera a punto de desmayarme",
      "DASSY006": "No disfruté nada.",
      "DASSY012": "Tuve dificultad para respirar (por ejemplo, respiración rápida), aunque no estaba haciendo ejercicio ni estaba enfermo(a)",
      "DASSY001": "Odié mi vida.",
      "DASSY017": "Reaccioné de forma exagerada a las situaciones.",
      "DASSY013": "Sentí que mis manos temblaban",
      "DASSY019": "Estuve estresado(a) por muchas cosas.",
      "DASSY009": "Me sentí aterrorizado(a).",
      "DASSY007": "No hubo nada bueno que pudiera esperar con entusiasmo",
      "DASSY016": "Me irrité con bastante facilidad.",
      "DASSY021": "Me fue difícil relajarme",
      "DASSY005": "No pude dejar de sentirme triste.",
      "DASSY020": "Me molesté cuando las personas me interrumpieron",
      "DASSY008": "Estuve cerca de entrar en pánico",
      "DASSY002": "Me odié a mí mismo(a)",
      "DASSY004": "Sentí que no valía nada",
      "DASSY018": "Me enojé fácilmente",
      "DASSY011": "Sentí que mi corazón latía muy rápido, aunque no había hecho ningún ejercicio intenso.",
      "DASSY010": "Sentí miedo sin razón aparente",
      "DASSY003": "Sentí que la vida era terrible",
      "DASSY_head": "Por favor, lee cada frase e indica cuán verdadera fue para ti durante la última semana.",
      "DASSY_r0": "No fue verdadera",
      "DASSY_r1": "Un poco verdadera",
      "DASSY_r2": "Bastante verdadera",
      "DASSY_r3": "Muy verdadera"
    },
    "vi": {
      "DASSY015": "Tôi dễ bị buồn bực về những chuyện nhỏ nhặt",
      "DASSY014": "Tôi cảm thấy chóng mặt, như sắp ngất",
      "DASSY006": "Tôi không thấy vui vẻ gì",
      "DASSY012": "Tôi gặp khó khăn khi thở (ví dụ: thở nhanh), dù tôi không tập thể dục và không bị ốm",
      "DASSY001": "Tôi ghét cuộc sống của mình",
      "DASSY017": "Tôi thấy mình phản ứng quá mức với tình huống",
      "DASSY013": "Tôi thấy tay mình run rẩy",
      "DASSY019": "Tôi căng thẳng về nhiều thứ",
      "DASSY009": "Tôi cảm thấy kinh hoàng",
      "DASSY007": "Tôi không thấy có điều gì dễ chịu để mong chờ",
      "DASSY016": "Tôi dễ bị kích động",
      "DASSY021": "Tôi thấy khó thư giãn",
      "DASSY005": "Tôi không thể ngừng cảm thấy buồn",
      "DASSY020": "Tôi thấy bực bội khi bị người khác làm gián đoạn",
      "DASSY008": "Tôi cảm thấy như sắp hoảng sợ",
      "DASSY002": "Tôi ghét bản thân mình",
      "DASSY004": "Tôi cảm thấy mình vô dụng",
      "DASSY018": "Tôi dễ bị khó chịu",
      "DASSY011": "Tôi cảm thấy tim mình đập rất nhanh, dù tôi không tập thể dục nặng",
      "DASSY010": "Tôi cảm thấy sợ hãi không rõ lý do",
      "DASSY003": "Tôi cảm thấy cuộc sống thật tồi tệ",
      "DASSY_head": "Vui lòng đọc từng câu và cho biết câu đó đúng với bạn đến mức nào trong tuần qua.",
      "DASSY_r0": "Không đúng",
      "DASSY_r1": "Đúng một chút",
      "DASSY_r2": "Khá đúng",
      "DASSY_r3": "Rất đúng"
    },
    "ar": {
      "DASSY015": "لقد انزعجت بسبب أشياء صغيرة",
      "DASSY014": "شعرت بالدوار وكأني على وشك الإغماء",
      "DASSY006": "لم أستمتع بأي شيء",
      "DASSY012": "كنت أعاني من صعوبة في التنفس (مثلاً تنفس سريع) رغم أنني لم أكن أمارس الرياضة أو أعاني من المرض",
      "DASSY001": "لقد كرهت حياتي",
      "DASSY017": "لقد وجدت نفسي أبالغ في ردود أفعالي تجاه المواقف",
      "DASSY013": "بدت يدي وكأنها ترتجف",
      "DASSY019": "لقد شعرت بالتوتر تجاه الكثير من الأشياء",
      "DASSY009": "شعرت بالرعب (الخوف الشديد)",
      "DASSY007": "شعرت أنه ليس لدي شيء لطيف لأتطلع إليه",
      "DASSY016": "شعرت بأنني أنزعج بسهولة",
      "DASSY021": "وجدت صعوبة في الاسترخاء",
      "DASSY005": "لم أستطع التوقف عن الشعور بالحزن",
      "DASSY020": "كنت أشعر بالانزعاج عندما يقاطعني الناس",
      "DASSY008": "شعرت بأنني على وشك الوقوع في حالة من الرعب المفاجئ",
      "DASSY002": "لقد كرهت نفسي",
      "DASSY004": "شعرت بأنني لست شخصاً جيداً",
      "DASSY018": "شعرت بأنني أميل للغيظ بسرعة",
      "DASSY011": "شعرت بدقات قلبي بدون أي مجهود جسدي",
      "DASSY010": "شعرت بالخوف بدون وجود أي سبب وجيه",
      "DASSY003": "شعرت بأن الحياة كانت مريعة",
      "DASSY_head": "يرجى قراءة كل جملة وتحديد مدى صحتها بالنسبة لك خلال الأسبوع الماضي.",
      "DASSY_r0": "لا ينطبق علي",
      "DASSY_r1": "ينطبق علي بعض الشيء",
      "DASSY_r2": "ينطبق علي بدرجة ملحوظة",
      "DASSY_r3": "ينطبق علي كثيراً جداً"
    },
    "he": {
      "DASSY015": "דברים קטנים הרגיזו אותי",
      "DASSY014": "הרגשתי סחרחורת, שאני הולך להתעלף",
      "DASSY006": "לא נהניתי משום דבר",
      "DASSY012": "היה לי קשה לנשום למרות שלא הייתי חולה",
      "DASSY001": "שנאתי את החיים",
      "DASSY017": "מצאתי את עצמי מגיב למצבים בצורה מוגזמת",
      "DASSY013": "רעדו ידי",
      "DASSY019": "נלחצתי מהרבה דברים",
      "DASSY009": "פחדתי מאוד",
      "DASSY007": "לא היה משהו נחמד או נעים לצפות לו",
      "DASSY016": "התעצבנתי בקלות",
      "DASSY021": "היה לי קשה להירגע",
      "DASSY005": "הרגשתי עצוב רוב הזמן",
      "DASSY020": "התעצבנתי כשאחרים הפריעו לי",
      "DASSY008": "הרגשתי כמו התקף חרדה",
      "DASSY002": "שנאתי את עצמי",
      "DASSY004": "הרגשתי שאני לא טוב",
      "DASSY018": "הרגשתי שכל דבר הפריע לי",
      "DASSY011": "הרגשתי שהלב דופק מהר למרות שלא התאמצתי יותר מדי",
      "DASSY010": "פחדתי ללא סיבה",
      "DASSY003": "הרגשתי שהחיים שלי גרועים",
      "DASSY_head": "נא לקרוא כל משפט ולסמן את המספר המשקף בצורה הכי טובה איך הרגשת במהלך השבוע.",
      "DASSY_r0": "לא נכון",
      "DASSY_r1": "קצת נכון",
      "DASSY_r2": "פחות או יותר נכון",
      "DASSY_r3": "מאוד נכון"
    },
    "hi": {
      "DASSY015": "मैं छोटी-छोटी बातों पर परेशान हो गया",
      "DASSY014": "मुझे चक्कर आ रहा था, जैसे मैं बेहोश होने वाला था",
      "DASSY006": "मुझे कुछ भी अच्छा नहीं लग रहा था",
      "DASSY012": "मुझे सांस लेने में परेशानी हुई (जैसे तेज सांस लेना), हालांकि मैं व्यायाम नहीं कर रहा था और मैं बीमार नहीं था",
      "DASSY001": "मुझे अपनी जिंदगी से नफरत थी",
      "DASSY017": "मैंने पाया कि मैं परिस्थितियों पर जरूरत से ज्यादा प्रतिक्रिया कर रहा हूं",
      "DASSY013": "मेरे हाथ कांप रहे थे",
      "DASSY019": "मैं कई चीजों को लेकर तनाव में था",
      "DASSY009": "मुझे डर लग रहा था",
      "DASSY007": "ऐसा कुछ भी अच्छा नहीं था जिसकी मैं आशा कर सकूं",
      "DASSY016": "मैं आसानी से चिढ़ जाता था",
      "DASSY021": "मुझे आराम करना कठिन लग रहा था",
      "DASSY005": "मैं उदास महसूस करना बंद नहीं कर पा रहा था",
      "DASSY020": "जब लोगों ने मुझे टोका तो मुझे गुस्सा आ गया",
      "DASSY008": "मुझे ऐसा लगा जैसे मुझे घबराहट होने वाली है",
      "DASSY002": "मुझे खुद से नफरत होने लगी थी",
      "DASSY004": "मुझे ऐसा लगा जैसे मैं किसी काम का नहीं हूं",
      "DASSY018": "मैं आसानी से गुस्सा हो जाता था",
      "DASSY011": "मैं महसूस कर सकता था कि मेरा दिल बहुत तेजी से धड़क रहा है, भले ही मैंने कोई कठिन व्यायाम नहीं किया हो",
      "DASSY010": "मुझे बिना किसी सही कारण के डर महसूस हुआ",
      "DASSY003": "मुझे लगा कि जिंदगी बहुत बुरी थी",
      "DASSY_head": "कृपया हर वाक्य पढ़ें और उनके आगे दी गयी संख्या, जो आपके पिछले हफ्ते की दशा को सही तरीके से दर्शाता हो, उसको एक गोले से इंगित करें।",
      "DASSY_r0": "सही नहीं",
      "DASSY_r1": "थोड़ा सही",
      "DASSY_r2": "काफी सही",
      "DASSY_r3": "पूरा सही"
    },
    "fa": {
      "DASSY015": "کوچکترین چیزها مرا ناراحت و عصبانی می‌کند.",
      "DASSY014": "احساس سرگیجه داشتم، انگار نزدیک بود غش کنم.",
      "DASSY006": "از هیچ چیز لذت نمی‌بردم.",
      "DASSY012": "با وجود اینکه ورزش نمی‌کردم و بیمار هم نبودم، نفس کشیدن برایم مشکل بود.",
      "DASSY001": "از زندگی کردن متنفر بودم.",
      "DASSY017": "متوجه شدم که بیش از حد نسبت به اتفاقات پیرامونم واکنش نشان می‌دهم.",
      "DASSY013": "احساس می‌کردم دست‌هایم می‌لرزد.",
      "DASSY019": "درباره اتفاقات زیادی استرس داشتم.",
      "DASSY009": "احساس ترس می‌کردم.",
      "DASSY007": "هیچ چیز خوبی وجود نداشت که بتوانم منتظرش باشم.",
      "DASSY016": "به راحتی عصبانی می‌شدم.",
      "DASSY021": "برایم سخت بود که آرام باشم.",
      "DASSY005": "نمی‌توانستم حس غمگین بودن را متوقف کنم.",
      "DASSY020": "وقتی مردم حرفم را قطع می‌کردند، عصبانی می‌شدم.",
      "DASSY008": "احساس می‌کردم هر لحظه ممکن است وحشت‌زده شوم.",
      "DASSY002": "از خودم متنفر بودم.",
      "DASSY004": "احساس می‌کردم هیچ ارزشی ندارم.",
      "DASSY018": "به سادگی دلخور می‌شدم.",
      "DASSY011": "با وجود اینکه هیچ ورزش سختی انجام نداده بودم، می‌توانستم ضربان قلبم را خیلی سریع احساس کنم.",
      "DASSY010": "بدون هیچ دلیلی احساس ترس می‌کردم.",
      "DASSY003": "احساس می‌کردم، زندگی ترسناک است.",
      "DASSY_head": "لطفاً هر یک از جملات زیر را به دقت بخوانید. سپس دور عددی که نشان می‌دهد چقدر آن جمله طی هفته گذشته در مورد شما صحیح است، دایره بکشید.",
      "DASSY_r0": "اصلاً درست نبود",
      "DASSY_r1": "کمی درست بود",
      "DASSY_r2": "زیاد درست بود",
      "DASSY_r3": "خیلی زیاد درست بود"
    },
    "tr": {
      "DASSY015": "Küçük şeyler için üzüldüm.",
      "DASSY014": "Başım döndü, bayılacak gibi hissettim.",
      "DASSY006": "Hiçbir şeyden keyif almadım.",
      "DASSY012": "Egzersiz yapmadığım ve hasta olmadığım halde nefes almakta zorlandım (örneğin, hızlı nefes alma).",
      "DASSY001": "Hayatımdan nefret ettim.",
      "DASSY017": "Olaylara aşırı tepki verdiğimi fark ettim.",
      "DASSY013": "Ellerim titredi.",
      "DASSY019": "Pek çok şey hakkında stres yapıyordum.",
      "DASSY009": "Çok korktum.",
      "DASSY007": "Sabırsızlıkla bekleyebileceğim güzel hiçbir şey yoktu.",
      "DASSY016": "Kolayca sinirlendim.",
      "DASSY021": "Rahatlamakta zorlandım.",
      "DASSY005": "Üzgün hissetmeyi durduramadım.",
      "DASSY020": "İnsanlar beni böldüğünde sinirlendim.",
      "DASSY008": "Paniğe kapılacakmışım gibi hissettim.",
      "DASSY002": "Kendimden nefret ettim.",
      "DASSY004": "Kendimi işe yaramaz hissettim.",
      "DASSY018": "Kolayca öfkelendim.",
      "DASSY011": "Zor bir egzersiz yapmadığım halde kalbimin çok hızlı attığını hissedebiliyordum.",
      "DASSY010": "Sebepsiz bir şekilde korkmuş hissettim.",
      "DASSY003": "Hayatın berbat olduğunu hissettim.",
      "DASSY_head": "Lütfen her bir ifadeyi okuyun ve geçen hafta boyunca sizin için ne kadar doğru olduğunu gösteren sayıyı daire içine alın.",
