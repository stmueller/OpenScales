{
  "scale_info": {
    "name": "Media Use",
    "code": "PX750702",
    "abbreviation": "PX750702",
    "description": "This protocol uses seven questions from Wave 6 of the Population Assessment of Tobacco and Health (PATH) study to assess the average amount of time spent using different types of media and viewing various social media sites.",
    "domain": "Tobacco - Social Norms & Awareness",
    "citation": "Unger JB, Chaloupka FJ, Vallone D, Thrasher JF, Nettles DS, Hendershot TP, Swan GE. PhenX: environment measures for tobacco regulatory research. Tobacco Control. 2020 Jan;29(Suppl 1):s35. [PhenX: https://www.phenxtoolkit.org/protocols/view/750702]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/750702"
  },
