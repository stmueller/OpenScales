  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H871": "Act wild and crazy.",
      "ipip_R44": "Am a physical coward.",
      "ipip_R38": "Am afraid of heights.",
      "ipip_R28": "Am afraid of large dogs.",
      "ipip_E15": "Am easily talked into doing silly things.",
      "ipip_Q61": "Am open to new experiences.",
      "ipip_text_am_unpredictable_people_never_know_what_": "Am unpredictable, people never know what I am going to say.",
      "ipip_Q95": "Am willing to take risks.",
      "ipip_H893": "Do unexpected things.",
      "ipip_X238": "Enjoy wild flights of fantasy.",
      "ipip_Q126": "Face danger confidently.",
      "ipip_R16": "Might actually enjoy being caught in an earthquake or tornado.",
      "ipip_R32": "Might enjoy a free fall from an airplane.",
      "ipip_R13": "Might enjoy the thrill of being lost at sea.",
      "ipip_R3": "Prefer fear to boredom.",
      "ipip_H446": "Seek adventure.",
      "ipip_H864": "Take risks.",
      "ipip_R39": "Try to stay inside when the weather is bad.",
      "ipip_Q31": "Would be good at rescuing people from a burning building.",
      "ipip_Q115": "Would enjoy being out on a sailboat during a storm.",
      "ipip_R52": "Would fear walking in a high-crime part of a city.",
      "ipip_R77": "Would like to try bungee jumping.",
      "ipip_R71": "Would love to explore strange places.",
      "ipip_Q136": "Would never go riding down a stretch of rapids in a canoe."
    }
  }
