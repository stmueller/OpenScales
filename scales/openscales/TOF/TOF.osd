    "_manual_notes": "Items 3, 4, and 7 are reverse-scored. Higher scores indicate greater awareness of the function of one's behavior (tacting of function)."
  },
  "translations": {
    "en": {
      "lk_1": "Never True",
      "lk_2": "2",
      "lk_3": "3",
      "lk_4": "4",
      "lk_5": "5",
      "lk_6": "6",
      "lk_7": "Always True",
      "question_head": "Please rate the truthfulness of the following statements, based on the past two weeks.",
      "tof_1": "I am aware of when I feel a sense of meaning in my actions.",
      "tof_2": "I can tell when my actions are in-line with the person I want to be.",
      "tof_3": "It is hard to tell whether or not my choices lead to personal growth.",
      "tof_4": "It is hard to say if my choices are connected with my deepest held values.",
      "tof_5": "I am aware of when my actions fall short of my intentions.",
      "tof_6": "I am aware of when I am fighting with my unpleasant feelings or thoughts.",
      "tof_7": "I don't notice when strong emotions have taken the 'driver's seat' of my actions.",
      "tof_8": "I notice whether or not my choices are based on reducing feelings of sadness.",
      "tof_9": "I notice whether or not my choices are based on reducing feelings of irritation or anger.",
      "tof_10": "I notice whether or not my choices are based on increasing feelings of happiness or joy."
    }
  }
