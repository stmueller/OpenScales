{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Emotional Self-Efficacy",
      "code": "EmSE",
      "abbreviation": "EmSE",
      "description": "Emotionale Selbstwirksamkeit (Schmitz & von Salisch, 2002): self-efficacy in handling emotions. 29 items across 8 subscales following Saarni's (2002) eight emotional-competence skills: Awareness, Decoding emotions, Expression/scripts, Empathy, State/Expression, Emotion coping, Relationship, and Capacity. 4-point; means. German only.",
      "citation": "Schmitz, G. S., & von Salisch, M. (2002). Emotionale Selbstwirksamkeit [measurement instrument]. http://userpage.fu-berlin.de/~gesund/skalen/Emotionale_Selbstwirksamkeit/emotionale_selbstwirksamkeit.htm",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his/his group's scales.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~gesund/skalen/Emotionale_Selbstwirksamkeit/emotionale_selbstwirksamkeit.htm",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "German only (no English version exists on the site). A DISTINCT construct from General Self-Efficacy (GSE) — about self-efficacy in dealing with emotions, not general problem-solving. 8 subscales, 29 items, all forward-scored, 4-point. Items reproduced verbatim from the FU-Berlin skalen page."
    },
