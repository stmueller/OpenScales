      "ipip_X109": "J'évite les lectures difficiles.",
      "ipip_E35": "J'agis de manière effrénée.",
      "ipip_H1119": "Je donne libre cours à mes fantaisies.",
      "ipip_H646": "J'ai une faible opinion de moi-même.",
      "ipip_E92": "J'ai des sautes d'humeur fréquentes.",
      "ipip_H1039": "J'ai peu à dire.",
      "ipip_H1108": "J'adore aider les autres.",
      "ipip_H1182": "Je dénature les faits.",
      "ipip_E24": "Je fais des choses que je regrette par la suite.",
