    "scoring": {
      "_note": "Gap scores (democratic deficit) = evaluative score − normative score per dimension. Negative gap = country falls short of respondent's democratic ideal. Gap scores must be computed post-hoc from dimension means.",
      "norm_electoral": {
        "method": "mean_coded",
        "description": "Mean of fairelc, dfprtal, gptpelc. Range 0–10; higher = greater importance assigned to electoral democracy.",
        "items": {
          "fairelc": 1,
          "dfprtal": 1,
          "gptpelc": 1
        }
      },
      "norm_liberal": {
        "method": "mean_coded",
        "description": "Mean of medcrgv, rghmgpr. Range 0–10; higher = greater importance assigned to liberal protections.",
        "items": {
          "medcrgv": 1,
          "rghmgpr": 1
        }
      },
      "norm_social": {
        "method": "mean_coded",
        "description": "Mean of gvctzpv, grdfinc. Range 0–10; higher = greater importance assigned to social democracy.",
        "items": {
          "gvctzpv": 1,
          "grdfinc": 1
        }
      },
      "norm_populist": {
        "method": "mean_coded",
        "description": "Mean of votedir, viepol, wpestop. Range 0–10; higher = greater importance assigned to populist/direct democracy features.",
        "items": {
          "votedir": 1,
          "viepol": 1,
          "wpestop": 1
        }
      },
      "norm_rule_of_law": {
        "method": "mean_coded",
        "description": "cttresa only. Range 0–10; higher = greater importance assigned to equal court treatment.",
        "items": {
          "cttresa": 1
        }
      },
      "norm_sovereignty": {
        "method": "mean_coded",
        "description": "keydec only. Range 0–10; higher = greater importance assigned to national sovereignty over EU.",
        "items": {
          "keydec": 1
        }
      },
      "norm_total": {
        "method": "mean_coded",
        "description": "Mean of all 12 normative items. Range 0–10; higher = stronger overall democratic norms.",
        "items": {
          "fairelc": 1,
          "dfprtal": 1,
          "medcrgv": 1,
          "rghmgpr": 1,
          "votedir": 1,
          "cttresa": 1,
          "gptpelc": 1,
          "gvctzpv": 1,
          "grdfinc": 1,
          "viepol": 1,
          "wpestop": 1,
          "keydec": 1
        }
      },
      "eval_electoral": {
        "method": "mean_coded",
        "description": "Mean of fairelc_e, dfprtal_e, gptpelc_e. Range 0–10; higher = more positive evaluation of [country]'s electoral democracy.",
        "items": {
          "fairelc_e": 1,
          "dfprtal_e": 1,
          "gptpelc_e": 1
        }
      },
      "eval_liberal": {
        "method": "mean_coded",
        "description": "Mean of medcrgv_e, rghmgpr_e. Range 0–10; higher = more positive evaluation of [country]'s liberal protections.",
        "items": {
          "medcrgv_e": 1,
          "rghmgpr_e": 1
        }
      },
      "eval_social": {
        "method": "mean_coded",
        "description": "Mean of gvctzpv_e, grdfinc_e. Range 0–10; higher = more positive evaluation of [country]'s social democracy.",
        "items": {
          "gvctzpv_e": 1,
          "grdfinc_e": 1
        }
      },
      "eval_populist": {
        "method": "mean_coded",
        "description": "Mean of votedir_e, viepol_e, wpestop_e. Range 0–10; higher = more positive evaluation of [country]'s populist/direct democracy features.",
        "items": {
          "votedir_e": 1,
