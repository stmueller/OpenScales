{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Acceptance and Action Questionnaire-II",
      "code": "AAQII",
      "abbreviation": "AAQ-II",
      "description": "7-item self-report measure of psychological flexibility (experiential avoidance). Items use a 7-point scale (1=Never True to 7=Always True). Higher scores indicate greater psychological inflexibility/experiential avoidance. A single total score is computed as the sum of all 7 items (range 7–49); scores ≥28 suggest clinically meaningful psychological inflexibility.",
      "citation": "Bond, F. W., Hayes, S. C., Baer, R. A., Carpenter, K. M., Guenole, N., Orcutt, H. K., Waltz, T., & Zettle, R. D. (2011). Preliminary psychometric properties of the Acceptance and Action Questionnaire-II: A revised measure of psychological inflexibility and experiential avoidance. Behavior Therapy, 42(4), 676–688. https://doi.org/10.1016/j.beth.2011.03.007",
      "license": "free for research/clinical",
      "version": "1.0",
      "url": "https://contextualscience.org/acceptance_action_questionnaire_aaq_aaqii",
      "domain": "Well-being",
      "license_explanation": "Free for research and clinical use (Association for Contextual Behavioral Science, ACBS). Translations in 30 languages available at https://contextualscience.org/aaqii_30_languages",
      "license_url": "https://contextualscience.org/acceptance_action_questionnaire_aaq_aaqii",
      "licensor": "Mapi Research Trust / ePROVIDE",
      "licensor_url": "https://eprovide.mapi-trust.org/instruments/acceptance-and-action-questionnaire-ii"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-04-01",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "aaq_r1",
        "aaq_r2",
        "aaq_r3",
        "aaq_r4",
        "aaq_r5",
        "aaq_r6",
        "aaq_r7"
      ],
      "question_head": "aaq_inst"
    },
    "dimensions": [
      {
        "id": "inflexibility",
        "name": "Psychological Inflexibility",
        "abbreviation": "PI",
        "description": "Sum of all 7 items (range 7–49). Higher scores indicate greater psychological inflexibility and experiential avoidance."
      }
    ],
    "items": [
      {
        "id": "aaq1",
        "text_key": "aaq1",
        "type": "likert",
        "dimension": "inflexibility"
      },
