  },
  "translations": {
    "en": {
      "BMCQ_head": "Please indicate how true each statement is of you.",
      "BMCQ_r1": "Not at all true of me",
      "BMCQ_r7": "Very true of me",
      "BMCQ001": "Feeling physically well is something that I prioritise in life.",
      "BMCQ002": "I value being well-balanced in my body and my mind.",
      "BMCQ003": "Feeling mentally well is something that I prioritise in life.",
      "BMCQ004": "I am usually proactive in addressing the needs of my body.",
      "BMCQ005": "Where possible, I always attend to what my body is telling me.",
      "BMCQ006": "I feel disconnected from my body.",
      "BMCQ007": "If I were asked to, I'd find it hard to describe changes in my body associated with positive and negative emotions.",
      "BMCQ008": "I find it hard to identify changes in my body associated with positive and negative emotions.",
      "BMCQ009": "I tend to focus on things happening in my physical environment rather than what is happening inside of me.",
      "BMCQ010": "I can direct my focus toward how specific parts of my body feel.",
      "BMCQ011": "It is easy for me to focus on specific sensations if they are suddenly experienced.",
      "BMCQ012": "It is easy for me to focus on specific sensations if I purposefully think about them.",
      "BMCQ013": "I consider myself in touch with my body and mind."
    }
  }
}