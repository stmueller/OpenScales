{
  "scale_info": {
    "name": "Mental Health Services Satisfaction",
    "code": "PX661401",
    "abbreviation": "PX661401",
    "description": "The Mental Health Statics Improvement Program (MHSIP) Youth Services Survey (YSS) is a 25-item, self-administered rating scale that captures a patient’s viewpoint about service satisfaction. The YSS should be completed in proximity to another professional or person to discuss any questions or issues",
    "domain": "Psychiatric Symptoms & Wellbeing",
    "citation": "Riley, S. E., Stromberg, A. J., & Clark, J. (2005). Parental satisfaction with children’s mental health services with the Youth Services Survey for Families. Journal of Child and Family Studies, 14 (1), 87-99. Shafer, A. B., & Temple, J. M. (2013). Factor structure of the Mental Health Statistics Improvement Program (MHSIP) Family and Youth Satisfaction Surveys. Journal of Behavioral Health Services and Research, 40 (3), 306-316. [PhenX: https://www.phenxtoolkit.org/protocols/view/661401]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/661401"
  },
