{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Environmental Worry Scale",
      "code": "EWS",
      "abbreviation": "EWS",
      "description": "Environmental worry / anxiety. Language variant: English = Bowler & Schwarzer (1991), 17 items; German = Hodapp, Neuhann & Reinschmidt (1996) Umweltbesorgnis, 16 items — related but distinct instruments. 4-point; mean.",
      "citation": "Bowler, R. M., & Schwarzer, R. (1991). Environmental anxiety: Assessing emotional distress and concerns after toxin exposure. Anxiety Research, 4, 167-180 (English); Hodapp, V., Neuhann, H. F., & Reinschmidt, U. (1996). Evaluation eines Fragebogens zur Erfassung von Umweltbesorgnis. Zeitschrift für Gesundheitspsychologie, 4, 22-36 (German).",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~gesund/skalen/Umweltbesorgnis/umweltbesorgnis.htm",
      "domain": "Health",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "LANGUAGE VARIANT (variants.sets): English and German are DISTINCT instruments (different authors, items, counts) measuring environmental worry. English (Bowler & Schwarzer 1991): 17 items; REVERSE items 3,5,7,11,12,13,15,16,17 INFERRED from wording (low-worry statements) — the source page did not explicitly mark reverse keys; VERIFY against Bowler & Schwarzer (1991). German (Hodapp et al. 1996): 16 items, no reverse items marked. Each language administers its own instrument; single dimension."
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "max": 4,
      "labels": [
