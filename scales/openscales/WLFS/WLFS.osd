{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "WLFS",
      "name": "Work-Life Fulfilment Scale",
      "abbreviation": "WLFS",
      "description": "22-item scale measuring work-life fulfilment across six factors: Work Prowess, Work-Life Balance, Reward and Recognition, Healthy Lifestyle, Relationship Management, and Self-Transcendence. Items rated on a 7-point Likert scale of agreement.",
      "citation": "Khatri, P., Shukla, S., Thomas, A., Shiva, A., & Behl, A. (2025). Towards work life fulfilment: Scale development and validation. Journal of Business Research, 186. https://doi.org/10.1016/j.jbusres.2024.115006",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1016/j.jbusres.2024.115006",
      "version": "1.0",
      "domain": "Work & Organizational"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "WLFS_r1", "WLFS_r2", "WLFS_r3", "WLFS_r4",
        "WLFS_r5", "WLFS_r6", "WLFS_r7"
      ],
      "question_head": "WLFS_head"
    },
    "dimensions": [
      {
        "id": "WorkProwess",
        "name": "Work Prowess",
        "description": "Perceived ability and capability to excel and progress at work"
      },
      {
        "id": "WorkLifeBalance",
        "name": "Work-Life Balance",
        "description": "Ability to balance work responsibilities with personal and family life"
      },
      {
        "id": "RewardRecognition",
        "name": "Reward and Recognition",
        "description": "Satisfaction with appraisal and recognition received at work"
      },
      {
        "id": "HealthyLifestyle",
        "name": "Healthy Lifestyle",
        "description": "Perceived health and its support for fulfilling life goals"
      },
      {
        "id": "RelationshipManagement",
        "name": "Relationship Management",
        "description": "Quality and strength of personal and professional relationships"
      },
      {
        "id": "SelfTranscendence",
        "name": "Self-Transcendence",
        "description": "Sense of contributing to a larger social purpose through one's work"
      }
    ],
    "items": [
      { "id": "WLFS001", "type": "likert", "text_key": "WLFS001", "dimension": "WorkProwess" },
      { "id": "WLFS002", "type": "likert", "text_key": "WLFS002", "dimension": "WorkProwess" },
      { "id": "WLFS003", "type": "likert", "text_key": "WLFS003", "dimension": "WorkProwess" },
      { "id": "WLFS004", "type": "likert", "text_key": "WLFS004", "dimension": "WorkProwess" },
      { "id": "WLFS005", "type": "likert", "text_key": "WLFS005", "dimension": "WorkProwess" },
      { "id": "WLFS006", "type": "likert", "text_key": "WLFS006", "dimension": "WorkProwess" },
      { "id": "WLFS007", "type": "likert", "text_key": "WLFS007", "dimension": "WorkLifeBalance" },
      { "id": "WLFS008", "type": "likert", "text_key": "WLFS008", "dimension": "WorkLifeBalance" },
      { "id": "WLFS009", "type": "likert", "text_key": "WLFS009", "dimension": "WorkLifeBalance" },
      { "id": "WLFS010", "type": "likert", "text_key": "WLFS010", "dimension": "WorkLifeBalance" },
      { "id": "WLFS011", "type": "likert", "text_key": "WLFS011", "dimension": "WorkLifeBalance" },
      { "id": "WLFS012", "type": "likert", "text_key": "WLFS012", "dimension": "RewardRecognition" },
      { "id": "WLFS013", "type": "likert", "text_key": "WLFS013", "dimension": "RewardRecognition" },
      { "id": "WLFS014", "type": "likert", "text_key": "WLFS014", "dimension": "RewardRecognition" },
      { "id": "WLFS015", "type": "likert", "text_key": "WLFS015", "dimension": "HealthyLifestyle" },
      { "id": "WLFS016", "type": "likert", "text_key": "WLFS016", "dimension": "HealthyLifestyle" },
      { "id": "WLFS017", "type": "likert", "text_key": "WLFS017", "dimension": "HealthyLifestyle" },
      { "id": "WLFS018", "type": "likert", "text_key": "WLFS018", "dimension": "HealthyLifestyle" },
      { "id": "WLFS019", "type": "likert", "text_key": "WLFS019", "dimension": "RelationshipManagement" },
      { "id": "WLFS020", "type": "likert", "text_key": "WLFS020", "dimension": "RelationshipManagement" },
      { "id": "WLFS021", "type": "likert", "text_key": "WLFS021", "dimension": "RelationshipManagement" },
      { "id": "WLFS022", "type": "likert", "text_key": "WLFS022", "dimension": "RelationshipManagement" },
      { "id": "WLFS023", "type": "likert", "text_key": "WLFS023", "dimension": "SelfTranscendence" },
      { "id": "WLFS024", "type": "likert", "text_key": "WLFS024", "dimension": "SelfTranscendence" },
      { "id": "WLFS025", "type": "likert", "text_key": "WLFS025", "dimension": "SelfTranscendence" },
      { "id": "WLFS026", "type": "likert", "text_key": "WLFS026", "dimension": "SelfTranscendence" }
    ],
    "scoring": {
      "WorkProwess": {
        "method": "mean_coded",
        "description": "Mean of Work Prowess items (1-6).",
        "items": {
          "WLFS001": 1, "WLFS002": 1, "WLFS003": 1,
          "WLFS004": 1, "WLFS005": 1, "WLFS006": 1
        }
      },
      "WorkLifeBalance": {
        "method": "mean_coded",
        "description": "Mean of Work-Life Balance items (7-11).",
        "items": {
          "WLFS007": 1, "WLFS008": 1, "WLFS009": 1,
          "WLFS010": 1, "WLFS011": 1
        }
      },
      "RewardRecognition": {
        "method": "mean_coded",
        "description": "Mean of Reward and Recognition items (12-14).",
        "items": {
          "WLFS012": 1, "WLFS013": 1, "WLFS014": 1
        }
      },
      "HealthyLifestyle": {
        "method": "mean_coded",
        "description": "Mean of Healthy Lifestyle items (15-18).",
        "items": {
          "WLFS015": 1, "WLFS016": 1, "WLFS017": 1, "WLFS018": 1
        }
      },
      "RelationshipManagement": {
        "method": "mean_coded",
        "description": "Mean of Relationship Management items (19-22).",
        "items": {
          "WLFS019": 1, "WLFS020": 1, "WLFS021": 1, "WLFS022": 1
        }
      },
      "SelfTranscendence": {
        "method": "mean_coded",
        "description": "Mean of Self-Transcendence items (23-26).",
        "items": {
          "WLFS023": 1, "WLFS024": 1, "WLFS025": 1, "WLFS026": 1
        }
      }
    }
  },
  "translations": {
    "en": {
      "WLFS_head": "Please indicate your level of agreement with the following statements.",
      "WLFS_r1": "Strongly disagree",
      "WLFS_r2": "Disagree",
      "WLFS_r3": "Somewhat disagree",
      "WLFS_r4": "Neither agree nor disagree",
      "WLFS_r5": "Somewhat agree",
      "WLFS_r6": "Agree",
      "WLFS_r7": "Strongly agree",
      "WLFS001": "I feel I have the ability to learn to excel at work.",
      "WLFS002": "I believe I have the ability to take up more challenging roles at work.",
      "WLFS003": "I have the ability to handle challenging situations at work.",
      "WLFS004": "I have the ability to make work life worth living.",
      "WLFS005": "I have the ability to reach the top of my profession.",
      "WLFS006": "I feel grateful for my life at work.",
      "WLFS007": "I am able to devote time to my family without compromising on my work responsibilities.",
      "WLFS008": "I am able to balance work with leisure.",
      "WLFS009": "I have the ability to meet the needs of my job along with that of my family.",
      "WLFS010": "I am able to fulfill my responsibilities across life domains.",
      "WLFS011": "My professional life fits well with my personal life.",
      "WLFS012": "I am satisfied with my appraisal at work.",
      "WLFS013": "My supervisor publicly praises me for my work.",
      "WLFS014": "I am always recognized for my contribution at work.",
      "WLFS015": "I feel healthy enough to do the things I want to do.",
      "WLFS016": "My health is not a challenge to living a fulfilled life.",
      "WLFS017": "My health supports my efforts in reaching my goals.",
      "WLFS018": "I believe I am on my way to reaching my potential in life.",
      "WLFS019": "People I am closely related to love me unconditionally.",
      "WLFS020": "I have people I can depend on in times of need.",
      "WLFS021": "My relationships give me strength.",
      "WLFS022": "I have meaningful relationships at work.",
      "WLFS023": "I try to make a positive social change to society.",
      "WLFS024": "My work contributes to the betterment of society.",
      "WLFS025": "I believe I am contributing to a bigger purpose through my work.",
      "WLFS026": "I have been able to positively touch the lives of several people."
    }
  }
}
