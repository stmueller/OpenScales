{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "DFQ18",
      "name": "Divine Forgiveness Questionnaire",
      "abbreviation": "DFQ-18",
      "description": "18-item scale measuring the experience of God's forgiveness across Abrahamic religions, comprising three subscales: Moral Fortification (items 1-7), Self-Acceptance (items 8-13), and Absolution (items 14-18). No reverse-scored items.",
      "citation": "Bartholomaeus, J., Mandrell, J., & Strelan, P. (2025). The Divine Forgiveness Questionnaire: Developing and validating a measure of the experience of God's forgiveness across the Abrahamic religions. Psychology of Religion and Spirituality. https://doi.org/10.1037/rel0000603",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1037/rel0000603",
      "version": "1.0",
      "domain": "Other"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 6,
      "min": 1,
      "labels": ["DFQ18_r1", "DFQ18_r2", "DFQ18_r3", "DFQ18_r4", "DFQ18_r5", "DFQ18_r6"],
      "question_head": "DFQ18_head"
    },
    "dimensions": [
      {
        "id": "moral_fortification",
        "name": "Moral Fortification",
        "description": "God's forgiveness strengthens moral character and accountability (items 1-7)"
      },
      {
        "id": "self_acceptance",
        "name": "Self-Acceptance",
        "description": "God's forgiveness promotes self-acceptance and emotional peace (items 8-13)"
      },
      {
        "id": "absolution",
        "name": "Absolution",
        "description": "God's forgiveness removes sin, guilt, and shame (items 14-18)"
      },
      {
        "id": "total",
        "name": "Total Divine Forgiveness",
        "description": "Mean of all items reflecting overall experience of divine forgiveness"
      }
    ],
    "items": [
      {"id": "DFQ18001", "type": "likert", "text_key": "DFQ18001", "dimension": "moral_fortification"},
      {"id": "DFQ18002", "type": "likert", "text_key": "DFQ18002", "dimension": "moral_fortification"},
      {"id": "DFQ18003", "type": "likert", "text_key": "DFQ18003", "dimension": "moral_fortification"},
