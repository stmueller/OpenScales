    "scale_info": {
      "name": "Collective Teacher Self-Efficacy Scale",
      "code": "CTSES",
      "abbreviation": "CTSES",
      "description": "12-item Collective Teacher Self-Efficacy Scale (Schwarzer et al.). Rated 1-4 (not at all true..exactly true). No reverse-coded items.",
      "citation": "Schwarzer, R., Schmitz, G. S., & Daytner, G. T. (1999). Collective Teacher Self-Efficacy [measurement instrument]; Schwarzer, R. & Schmitz, G. S. (1999), Z. f. Sozialpsychologie, 30(4), 262-274.",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales. Items reproduced from the authors' official documentation (userpage.fu-berlin.de/~gesund/skalen/ and userpage.fu-berlin.de/~health/).",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~gesund/skalen/Kollektive_Selbstwirksamkeit/kollektive_selbstwirksamkeit.htm",
      "domain": "Education",
      "version": "1.0"
    },
    "implementation": {
