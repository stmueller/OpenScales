{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "TAS",
      "name": "Time Appropriation Scale",
      "abbreviation": "TAS",
      "description": "29-item scale measuring the psychological experience of time appropriation — a sense of ownership, belonging, control, and meaning associated with time felt as one's own. Organized into three subscales: Self-Discipline (9 items; control, ownership, commitment, personal growth), Spontaneity (8 items; freedom, awareness, savoring the moment), and Inwardness (12 items; meaning, spirituality, compassion, authenticity). Developed and validated in Turkish; English translations are provided by the authors as general guidance and require formal back-translation before use in English-language research.",
      "citation": "Karasu, M., Cesur, S., & Gurluk, Y. O. (2025). Exploring time appropriation: Development and validation of the Time Appropriation Scale. Current Psychology, 44(7), 5713–5733. https://doi.org/10.1007/s12144-025-07601-9",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1007/s12144-025-07601-9",
      "version": "1.0",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English item translations are provided by the authors as general guidance only; formal back-translation protocols should be applied before using this instrument in English-language research."
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
