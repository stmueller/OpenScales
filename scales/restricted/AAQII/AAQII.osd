      {
        "id": "aaq7",
        "text_key": "aaq7",
        "type": "likert",
        "dimension": "inflexibility"
      }
    ],
    "scoring": {
      "inflexibility": {
        "description": "Sum of all 7 items (range 7–49). Higher scores indicate greater psychological inflexibility. Scores ≥28 suggest clinically meaningful levels of experiential avoidance.",
        "method": "sum_coded",
        "items": [
          "aaq1",
          "aaq2",
          "aaq3",
          "aaq4",
          "aaq5",
          "aaq6",
          "aaq7"
        ],
        "norms": {
          "thresholds": [
            {
              "min": 7,
              "max": 27,
              "label": "Low Inflexibility"
            },
            {
              "min": 28,
              "max": 49,
              "label": "High Inflexibility"
            }
          ]
        }
      }
    }
  },
  "translations": {
    "en": {
      "aaq_r1": "Never true",
      "aaq_r2": "Very rarely true",
      "aaq_r3": "Seldom true",
      "aaq_r4": "Sometimes true",
      "aaq_r5": "Often true",
      "aaq_r6": "Almost always true",
      "aaq_r7": "Always true",
      "aaq_inst": "Below you will find a list of statements. Please rate how true each statement is for you by circling a number next to it.",
      "aaq1": "My painful experiences and memories make it difficult for me to live a life that I would value.",
      "aaq2": "I'm afraid of my feelings.",
      "aaq3": "I worry about not being able to control my worries and feelings.",
      "aaq4": "My painful memories prevent me from having a fulfilling life.",
      "aaq5": "Emotions cause problems in my life.",
      "aaq6": "It seems like most people are handling their lives better than I am.",
      "aaq7": "Worries get in the way of my success.",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}