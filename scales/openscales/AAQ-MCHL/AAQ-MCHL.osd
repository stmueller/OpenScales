  "translations": {
    "en": {
      "lk_0": "Never True",
      "lk_1": "Very rarely true",
      "lk_2": "Seldom true",
      "lk_3": "Sometimes true",
      "lk_4": "Often true",
      "lk_5": "Almost always true",
      "lk_6": "Always true",
      "question_head": "In this questionnaire, we use the term 'frustration' to describe negative thoughts and feelings about your child's hearing loss. Please replace the word 'frustration' with thoughts and feelings about your child's hearing loss that bother you the most.",
      "aaq_mchl_1": "My frustration with my child's hearing loss has negatively affected my parenting.",
      "aaq_mchl_2": "I wish I could control negative thoughts and feelings about my child's hearing loss.",
      "aaq_mchl_3": "I need to manage negative thoughts about my child's hearing loss to be a better parent.",
      "aaq_mchl_4": "My negative thoughts and feelings about my child's hearing loss lead me to avoid situations.",
      "aaq_mchl_5": "I worry about what others think of my child's hearing loss.",
      "aaq_mchl_6": "I suppress negative thoughts and feelings related to my child's hearing loss.",
      "aaq_mchl_7": "I spend a lot of time thinking how things would be for me without my child's hearing loss.",
      "aaq_mchl_8": "Frustration with my child's hearing loss keeps me from effectively treating and managing it."
    }
  }
