    "lt": {
      "ao_head": "KORTELĖ 16",
      "accalaw": "Ar jums būtų priimtina, jei Lietuva turėtų stiprų politinį lyderį, esantį aukščiau įstatymo? Pasirinkite atsakymą iš šios kortelės, kur 0 reiškia „visiškai nepriimtina”, o 10 – „visiškai priimtina”.",
      "ao_acc_lo": "Visiškai nepriimtina",
      "ao_acc_hi": "Visiškai priimtina",
      "ao_head2": "Naudodamiesi šia kortele, pasakykite, kiek sutinkate arba nesutinkate su kiekvienu iš šių teiginių. SKAITYKITE KIEKVIENĄ TEIGINĮ",
      "imobed": "Paklusnumas ir pagarba autoritetui yra svarbiausi vertybės, kurių vaikai turėtų išmokti.",
      "loylead": "Tai, ko labiausiai reikia Lietuvai – lojalumas savo politiniams lyderiams.",
      "ao_r1": "Labai pritariu",
      "ao_r2": "Pritariu",
      "ao_r3": "Nei pritariu, nei nepritariu",
      "ao_r4": "Nepritariu",
      "ao_r5": "Labai nepritariu",
      "debrief": "Dėkojame, kad užpildėte šį klausimyną."
    },
    "lv": {
      "ao_head": "KARTĪTE 16",
      "accalaw": "Cik pieņemami jums būtu, ja Latvijā būtu spēcīgs līderis, kas stāv pāri likumam? Atbildiet, lūdzu, izvēloties atbildi no šīs kartītes, kur 0 nozīmē „nemaz nebūtu pieņemami”, bet 10 – „pilnībā pieņemami”.",
      "ao_acc_lo": "Nemaz nebūtu pieņemami",
      "ao_acc_hi": "Pilnībā pieņemami",
      "ao_head2": "Izmantojot šo kartīti, lūdzu sakiet, cik lielā mērā jūs piekrītat vai nepiekrītat katram no šiem apgalvojumiem.",
      "imobed": "Paklausība un cieņa pret autoritāti ir vissvarīgākās vērtības, kas bērniem būtu jāapgūst.",
      "loylead": "Visvairāk Latvijā ir nepieciešama lojalitāte pret tās līderiem.",
      "ao_r1": "Pilnībā piekrītu",
      "ao_r2": "Piekrītu",
      "ao_r3": "Ne piekrītu, ne nepiekrītu",
      "ao_r4": "Nepiekrītu",
      "ao_r5": "Pilnībā nepiekrītu",
      "debrief": "Paldies par šīs anketas aizpildīšanu."
    },
    "sq": {
      "ao_head": "KARTA 16",
      "accalaw": "Sa e pranueshme për ju do të ishte që Mali i Zi të kishte një udhëheqës të fortë që është mbi ligjin? Zgjidhni përgjigjen tuaj nga kjo kartë ku 0 do të thotë aspak e pranueshme dhe 10 do të thotë tërësisht e pranueshme.",
      "ao_acc_lo": "Aspak e pranueshme",
      "ao_acc_hi": "Tërësisht e pranueshme",
      "ao_head2": "Duke përdorur këtë kartë, ju lutemi tregoni në çfarë mase jeni dakord ose nuk jeni dakord me secilin nga pohimet e mëposhtme.",
      "imobed": "Bindja dhe respektimi i autoritetit janë vlerat më të rëndësishme që fëmijët duhet të mësojnë.",
      "loylead": "Ajo që Malit të Zi i duhet më së shumti është besnikëria ndaj udhëheqësve të tij.",
      "ao_r1": "Pajtohem plotësisht",
      "ao_r2": "Pajtohem",
      "ao_r3": "As pajtohem as kundër",
      "ao_r4": "Nuk pajtohem",
      "ao_r5": "Nuk pajtohem aspak",
      "debrief": "Faleminderit për plotësimin e këtij pyetësori."
    },
    "cnr": {
      "ao_head": "KARTICA 16",
      "accalaw": "Koliko bi za Vas bilo prihvatljivo da Crna Gora ima snažnog lidera koji je iznad zakona? Odaberite odgovor s ove kartice na kojoj 0 znači da Vam to uopšte nije prihvatljivo, a 10 da Vam je to potpuno prihvatljivo.",
