{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-BSTS",
      "name": "Breyer Social Trust Scale",
      "abbreviation": "ESS-BSTS",
      "description": "3-item measure of generalized social trust using items from the European Social Survey (ESS) Round 5 (2010/2011). Respondents rate the trustworthiness, fairness, and helpfulness of most people on 0–10 scales. The composite score is the mean of the three items. Higher scores indicate greater social trust. Items are the classic ESS social trust battery (ppltrst, pplfair, pplhlp) validated and documented as a scale by Breyer (2015).",
      "citation": "Breyer, B. (2015). Soziales Vertrauen [Social Trust Scale]. Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis235\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://ess.sikt.no/en/study/412db4fe-c77a-4e98-8ea4-6c19007f551b",
      "license_explanation": "ESS Round 5 data and documentation are available under CC BY-SA 4.0 per https://ess.sikt.no/en/study/412db4fe-c77a-4e98-8ea4-6c19007f551b. Item texts are from the ESS source questionnaire (https://europeansocialsurvey.org/methodology/source-questionnaire). The BSTS documentation is published in ZIS under CC BY-SA 4.0.",
      "url": "https://zis.gesis.org/skala/Breyer-Social-Trust-Scale-%28ESS%29?lang=en",
      "version": "1.1",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items ppltrst, pplfair, pplhlp from ESS Round 5 source questionnaire. Translations for 35 languages extracted from ESS Round 4–10 national questionnaires (CC BY 4.0, https://ess.sikt.no). Scoring: mean of 3 items, range 0–10."
    },
    "likert_options": {
      "points": 11,
      "min": 0
    },
    "dimensions": [
      {
        "id": "total",
        "name": "Social Trust",
        "description": "Mean of all three items. Range 0–10; higher = greater generalized social trust."
      }
