    "scoring": {
      "_note": "Lower raw score = stronger endorsement (1='Very much like me', 6='Not like me at all'). Subscale raw scores are means of constituent items (range 1–6). Ipsatized scores center each subscale on the respondent's grand mean across all 21 items: ipsatized = raw_subscale_mean - grand_mean. Positive ipsatized score = relatively more important than average; negative = relatively less important.",
      "self_direction": {
        "method": "mean_coded",
        "description": "Mean of ipcrtiv and impfree. Range 1–6; lower = stronger self-direction value.",
        "items": {
          "ipcrtiv": 1,
          "impfree": 1,
          "ipcrtiv_f": 1,
          "impfree_f": 1
        }
      },
      "stimulation": {
        "method": "mean_coded",
        "description": "Mean of impdiff and ipadvnt. Range 1–6; lower = stronger stimulation value.",
        "items": {
          "impdiff": 1,
          "ipadvnt": 1,
          "impdiff_f": 1,
          "ipadvnt_f": 1
        }
      },
      "hedonism": {
        "method": "mean_coded",
        "description": "Mean of ipgdtim and impfun. Range 1–6; lower = stronger hedonism value.",
        "items": {
          "ipgdtim": 1,
          "impfun": 1,
          "ipgdtim_f": 1,
          "impfun_f": 1
        }
      },
      "achievement": {
        "method": "mean_coded",
        "description": "Mean of ipshabt and ipsuces. Range 1–6; lower = stronger achievement value.",
        "items": {
          "ipshabt": 1,
          "ipsuces": 1,
          "ipshabt_f": 1,
          "ipsuces_f": 1
        }
      },
      "power": {
        "method": "mean_coded",
        "description": "Mean of imprich and iprspot. Range 1–6; lower = stronger power value.",
        "items": {
          "imprich": 1,
          "iprspot": 1,
          "imprich_f": 1,
          "iprspot_f": 1
        }
      },
      "security": {
        "method": "mean_coded",
        "description": "Mean of impsafe and ipstrgv. Range 1–6; lower = stronger security value.",
        "items": {
          "impsafe": 1,
          "ipstrgv": 1,
          "impsafe_f": 1,
          "ipstrgv_f": 1
        }
      },
      "conformity": {
        "method": "mean_coded",
        "description": "Mean of ipfrule and ipbhprp. Range 1–6; lower = stronger conformity value.",
        "items": {
          "ipfrule": 1,
          "ipbhprp": 1,
          "ipfrule_f": 1,
          "ipbhprp_f": 1
        }
      },
      "tradition": {
        "method": "mean_coded",
        "description": "Mean of ipmodst and imptrad. Range 1–6; lower = stronger tradition value.",
        "items": {
          "ipmodst": 1,
          "imptrad": 1,
          "ipmodst_f": 1,
          "imptrad_f": 1
        }
      },
      "benevolence": {
        "method": "mean_coded",
        "description": "Mean of iphlppl and iplylfr. Range 1–6; lower = stronger benevolence value.",
        "items": {
          "iphlppl": 1,
          "iplylfr": 1,
          "iphlppl_f": 1,
          "iplylfr_f": 1
        }
      },
      "universalism": {
        "method": "mean_coded",
        "description": "Mean of ipeqopt, ipudrst, and impenv. Range 1–6; lower = stronger universalism value.",
        "items": {
          "ipeqopt": 1,
          "ipudrst": 1,
          "impenv": 1,
          "ipeqopt_f": 1,
          "ipudrst_f": 1,
          "impenv_f": 1
        }
      },
      "grand_mean": {
        "method": "mean_coded",
        "description": "Grand mean of all 21 items. Used as the centering constant for ipsatization.",
        "items": {
          "ipcrtiv": 1,
          "imprich": 1,
          "ipeqopt": 1,
          "ipshabt": 1,
          "impsafe": 1,
          "impdiff": 1,
          "ipfrule": 1,
          "ipudrst": 1,
          "ipmodst": 1,
          "ipgdtim": 1,
          "impfree": 1,
          "iphlppl": 1,
          "ipsuces": 1,
          "ipstrgv": 1,
          "ipadvnt": 1,
          "ipbhprp": 1,
          "iprspot": 1,
          "iplylfr": 1,
          "impenv": 1,
          "imptrad": 1,
          "impfun": 1,
          "ipcrtiv_f": 1,
          "imprich_f": 1,
          "ipeqopt_f": 1,
          "ipshabt_f": 1,
          "impsafe_f": 1,
          "impdiff_f": 1,
          "ipfrule_f": 1,
          "ipudrst_f": 1,
          "ipmodst_f": 1,
          "ipgdtim_f": 1,
          "impfree_f": 1,
          "iphlppl_f": 1,
          "ipsuces_f": 1,
          "ipstrgv_f": 1,
          "ipadvnt_f": 1,
          "ipbhprp_f": 1,
          "iprspot_f": 1,
          "iplylfr_f": 1,
          "impenv_f": 1,
          "imptrad_f": 1,
          "impfun_f": 1
        }
      }
    },
    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Portrait Values Questionnaire – 21 (PVQ-21) Report",
      "footer_refs": [
        "Sandy, C. J., Gosling, S. D., Schwartz, S. H., & Koelkebeck, T. (2017). The development and validation of brief and ultrabrief measures of values. Journal of Personality Assessment, 99(5), 545–555. https://doi.org/10.1080/00223891.2016.1231115",
        "Bilsky, W., Janik, M., & Schwartz, S. H. (2011). The structural organization of human values — Evidence from three rounds of the ESS. Journal of Cross-Cultural Psychology, 42, 759–776. https://doi.org/10.1177/0022022110362757",
        "Schwartz, S. H. (2003). A proposal for measuring value orientations across nations. In ESS Questionnaire Development Report (pp. 259–319). ESS ERIC.",
        "Items from: European Social Survey Round 10 (2020/2021). ESS ERIC. https://ess.sikt.no. License: CC BY-SA 4.0.",
        "Scoring: raw = mean of dimension items (1–6; lower = stronger endorsement). Ipsatized = raw minus grand mean of all 21 items."
      ]
    },
    "branches": [
      {
        "id": "gender",
        "method": "parameter",
        "parameter": "gender",
        "arms": [
          {
