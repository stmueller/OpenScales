      "durel_ir_4": "Benar sedikit",
      "durel_ir_5": "Sangat benar"
    },
    "ne": {
      "durel_ora": "तपाई कत्तिको चर्च, मन्दिर, मस्जिद, वा अन्य कार्यक्रममा जानु हुन्छ?",
      "durel_ora_0": "कहिले जान्न",
      "durel_ora_1": "बर्षमा एक पटक वा कम्ति",
      "durel_ora_2": "बर्षमा केहि पटक",
      "durel_ora_3": "महिनामा केहि पटक",
      "durel_ora_4": "हप्तामा एक पटक",
      "durel_ora_5": "हप्तामा एक पटकभन्दा धेरै",
      "durel_nora": "तपाई आफु स्वय धार्मिक कार्यमा कतिको समय दिनु हुन्छ? जस्तै प्राथना, पुजा, ध्यान, वा धार्मिक ग्रन्थहरुको अध्यन?",
      "durel_nora_0": "कहिले जान्न",
      "durel_nora_1": "बर्षमा एक पटक वा कम्ति",
      "durel_nora_2": "बर्षमा केहि पटक",
      "durel_nora_3": "हप्तामा केहि पटक",
      "durel_nora_4": "दिनमा एक पटक",
      "durel_nora_5": "दिनमा एक पटकभन्दा धेरै",
      "durel_ir_stem": "तपाईंको बारेमा वर्णन गर्नु पर्दा तलका तीनवटा भनाइहरु कत्तिको ठिक हुन्?",
      "durel_ir1": "जीवनमा मैले इस्वरीय शक्तिको साच्यात्कारको अनुभाव गरेको छु।",
      "durel_ir2": "मेरो धार्मिक विश्वास जीवनको प्रति मेरो दृष्टिकोणमा आधारित छ।",
      "durel_ir3": "म जीवनको हरेक काम र व्यवहारमा आफ्नो धर्मलाई पालन गर्न सकेसम्म प्रयास गर्दछु।",
      "durel_ir_1": "पुरा असत्य",
      "durel_ir_2": "अलिकति असत्य",
      "durel_ir_3": "न सत्य न असत्य",
      "durel_ir_4": "अलिकति सत्य",
      "durel_ir_5": "पुरा सत्य"
    },
    "nl": {
      "durel_ora": "Hoe vaak gaat u naar de kerk, moskee, tempel of een andere religieuze plek voor religieuze bijeenkomsten?",
      "durel_ora_0": "Nooit",
      "durel_ora_1": "Eens per jaar of minder",
      "durel_ora_2": "Een aantal keren per jaar",
      "durel_ora_3": "Een aantal keren per maand",
      "durel_ora_4": "Eens per week",
      "durel_ora_5": "Vaker dan eens per week",
      "durel_nora": "Hoe vaak besteed je tijd aan religieuze activiteiten, zoals gebed, meditatie, of aan studie van religieuze geschriften?",
      "durel_nora_0": "Nooit of zelden",
      "durel_nora_1": "Een aantal keer per jaar",
      "durel_nora_2": "Een aantal keer per maand",
      "durel_nora_3": "Een aantal keer per week",
      "durel_nora_4": "Eens per dag",
      "durel_nora_5": "Vaker dan eens per dag",
      "durel_ir_stem": "Hoe juist is elk van de volgende uitspraken voor u?",
      "durel_ir1": "Ik ervaar de aanwezigheid van het goddelijke in mijn leven.",
      "durel_ir2": "Mijn religieuze overtuigingen vormen de basis van mijn levensbeschouwing.",
      "durel_ir3": "Ik probeer zeer zeker mijn religie door te laten schijnen in alles wat ik doe in het leven.",
      "durel_ir_1": "Absoluut onjuist",
      "durel_ir_2": "Enigszins onjuist",
      "durel_ir_3": "juist noch onjuist",
      "durel_ir_4": "Enigszins juist",
      "durel_ir_5": "Absoluut juist"
    },
    "pl": {
      "durel_ora": "Jak często chodzisz do kościoła, meczetu, synagogi, lub na inne spotkania religijne?",
      "durel_ora_0": "Nigdy",
      "durel_ora_1": "Raz w roku lub mniej",
      "durel_ora_2": "Kilka razy w roku",
      "durel_ora_3": "Kilka razy w miesiącu",
      "durel_ora_4": "Raz w tygodniu",
      "durel_ora_5": "Więcej niż raz w tygodniu",
      "durel_nora": "Jak często spędzasz czas w prywatnych zajęciach religijnych typu modlitwa, medytacja lub studiowanie ksiąg religijnych?",
      "durel_nora_0": "Nigdy lub rzadko",
      "durel_nora_1": "Kilka razy w roku",
      "durel_nora_2": "Kilka razy w miesiącu",
      "durel_nora_3": "Kilka razy w tygodniu",
      "durel_nora_4": "Raz dziennie",
      "durel_nora_5": "Więcej niż raz dziennie",
      "durel_ir_stem": "Jak prawdziwe, jeśli chodzi o Twój opis, jest każde z trzech następujących stwierdzeń?",
      "durel_ir1": "W moim życiu doświadczam obecności Bożej.",
      "durel_ir2": "Moje przekonania religijne są naprawdę podwaliną całego mojego podejścia do świata.",
      "durel_ir3": "Bardzo się staram wnosić moją religię do wszystkich innych dziedzin mojego życia.",
      "durel_ir_1": "Zdecydowanie nieprawdziwe",
      "durel_ir_2": "Poniekąd nieprawdziwe",
      "durel_ir_3": "Ani prawdziwe ani nieprawdziwe",
      "durel_ir_4": "Poniekąd prawdziwe",
      "durel_ir_5": "Zdecydowanie prawdziwe"
    },
    "ro": {
      "durel_ora": "Cat de des frecventez biserica, moschee, templu, sau alte reuniuni religioase?",
      "durel_ora_0": "Niciodata",
      "durel_ora_1": "o data pe an sau mai putin",
      "durel_ora_2": "de cateva ori pe an",
      "durel_ora_3": "de cateva ori pe luna",
      "durel_ora_4": "o data pe saptamana",
      "durel_ora_5": "mai mult decat o data pe saptamana",
      "durel_nora": "Cat de des iti petreci timpul in activitati religioase particulare, cum ar fi rugaciunea, meditatie, sau de studiu al Scripturilor religioase?",
      "durel_nora_0": "Niciodata sau rareori",
      "durel_nora_1": "de cateva ori pe an",
      "durel_nora_2": "de cateva ori pe luna",
      "durel_nora_3": "de cateva ori pe saptamana",
      "durel_nora_4": "o data pe zi",
      "durel_nora_5": "mai mult decat o data pe zi",
      "durel_ir_stem": "Cat de adevarat este fiecare din urmatoarele trei declaratii, in descrierea despre tine?",
      "durel_ir1": "In viata mea, am experienta prezentei Divine.",
      "durel_ir2": "Convingerile religioase ale mele sunt cu adevarat ceea ce stau la baza abordarii intregii mele vieti.",
      "durel_ir3": "Incerc din greu sa fiu credincios religiei mele.",
      "durel_ir_1": "Categoric neadevarat",
      "durel_ir_2": "Oarecum neadevarat",
      "durel_ir_3": "Nici adevarat, nici neadevarat",
      "durel_ir_4": "Oarecum adevarat",
      "durel_ir_5": "Cu siguranta adevarat"
    },
    "ru": {
      "durel_ora": "Как часто вы посещаете церковь, мечеть, храм или другие религиозные собрания?",
      "durel_ora_0": "Никогда",
      "durel_ora_1": "Раз в год или реже",
      "durel_ora_2": "2–3 раза в год",
      "durel_ora_3": "2–3 раза в месяц",
      "durel_ora_4": "Один раз в неделю",
      "durel_ora_5": "Больше одного раза в неделю",
      "durel_nora": "Как часто вы уделяете время личным религиозным занятиям, таким как молитва, размышления или изучение священных религиозных писаний?",
      "durel_nora_0": "Никогда или редко",
      "durel_nora_1": "Несколько раз в год",
      "durel_nora_2": "Несколько раз в месяц",
      "durel_nora_3": "Несколько раз в неделю",
      "durel_nora_4": "Один раз в день",
      "durel_nora_5": "Больше одного раза в день",
      "durel_ir_stem": "Насколько верно относительно вас каждое из трёх следующих утверждений?",
      "durel_ir1": "В моей жизни я испытываю присутствие божественного.",
      "durel_ir2": "Мои религиозные верования являются основой моего отношения к жизни.",
      "durel_ir3": "Я очень стараюсь прилагать мои религиозные убеждения во всех жизненных ситуациях.",
      "durel_ir_1": "Определённо неправда",
      "durel_ir_2": "Не совсем правда",
      "durel_ir_3": "Не правда и не ложь",
