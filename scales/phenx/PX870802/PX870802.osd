  "translations": {
    "en": {
      "opt_1": "No, my child does not do this.",
      "opt_2": "No, but my child is learning how to do this.",
      "opt_3": "Yes, my child has started doing this when reminded.",
      "opt_4": "Yes, my child always does this when reminded.",
      "opt_5": "Yes, my child always does this when needed.",
      "sec_directions_below_is_a_list_of_skills_tha_title": "Directions: Below is a list of skills that teens use to manage their sickle cell disease. Please circle the number that best describes your child for each question.",
      "self_management_skills_checklist_caregiver_child_name_medicine": "Can your child name all of his medicines?",
      "self_management_skills_checklist_caregiver_child_find_information_sickle_cell": "Can your child find information about sickle cell disease if needed (like at the doctor's office, on the internet, or in a community)?",
      "self_management_skills_checklist_caregiver_child_find_information_educational_options": "Can you child find information about educational options if needed?",
      "self_management_skills_checklist_caregiver_child_ask_doctor_questions": "Does your child ask the doctor or medical team questions during clinical appointments?",
      "self_management_skills_checklist_caregiver_child_strategy_manage_pain": "Does your child use strategies other than pain medicines to manage pain (like deep breathing, distraction, imagery)?",
      "self_management_skills_checklist_caregiver_child_medicine_correct_schedule": "Does your child take medicines on the correct schedule?",
      "self_management_skills_checklist_caregiver_child_refill_pain_medicine": "Does your child refill pain medicines on his own?",
      "self_management_skills_checklist_caregiver_child_complete_medical_history_form": "Does your child complete a medical history form?",
      "self_management_skills_checklist_caregiver_child_activity_stay_healthy": "Does your child take part in activities to stay healthy like exercising and eating healthy foods?",
      "self_management_skills_checklist_caregiver_child_someone_talk_sad_down_anxious_angry": "Does your child find someone to talk to when feeling sad, down, anxious, or angry?",
      "self_management_skills_checklist_caregiver_child_talk_education_future": "Does your child talk to the school or medical team about education and the future?",
      "self_management_skills_checklist_caregiver_child_type_sickle_cell_disease": "Does your child know the type of sickle cell disease he has?",
