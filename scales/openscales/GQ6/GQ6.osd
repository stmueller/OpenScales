{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "GQ6",
      "name": "Gratitude Questionnaire-6 (German)",
      "abbreviation": "GQ-6",
      "description": "6-item scale measuring dispositional gratitude — the tendency to notice and appreciate the positive in life. German translation (GQ-6-G) validated by Hudecek et al. (2020). Original English by McCullough et al. (2002) is APA-licensed; only the German translation is included here under CC BY 4.0.",
      "citation": "Hudecek, M. F. C., Ścigała, K. A., Trautwein, U., & Zettler, I. (2020). Validation of the German version of the Gratitude Questionnaire (GQ-6-G). Frontiers in Psychology, 11. https://doi.org/10.3389/fpsyg.2020.590108",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2020.590108",
      "version": "1.0",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Original scale by McCullough et al. (2002). CC BY 4.0 license via German validation: Hudecek et al. (2020), Frontiers in Psychology. https://doi.org/10.3389/fpsyg.2020.590108"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "GQ6_r1",
        null,
