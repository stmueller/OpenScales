    "scoring": {
      "ra": {
        "description": "Sum of ORA and NORA. Range 0–10; higher = more frequent religious activity.",
        "method": "sum_coded",
        "items": ["durel_ora", "durel_nora"]
      },
      "ir": {
        "description": "Sum of IR1, IR2, IR3. Range 3–15; higher = stronger intrinsic religiosity.",
        "method": "sum_coded",
        "items": ["durel_ir1", "durel_ir2", "durel_ir3"]
      },
      "total": {
        "description": "Sum of all 5 items. Range 3–25; higher = greater overall religious involvement.",
        "method": "sum_coded",
        "items": ["durel_ora", "durel_nora", "durel_ir1", "durel_ir2", "durel_ir3"]
      }
    },
    "report": {
