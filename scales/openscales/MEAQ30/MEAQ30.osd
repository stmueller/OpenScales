      { "id": "MEAQ30005", "type": "likert", "text_key": "MEAQ30005", "dimension": "BA" },
      { "id": "MEAQ30006", "type": "likert", "text_key": "MEAQ30006", "dimension": "DA" },
      { "id": "MEAQ30007", "type": "likert", "text_key": "MEAQ30007", "dimension": "DA" },
      { "id": "MEAQ30008", "type": "likert", "text_key": "MEAQ30008", "dimension": "DA" },
      { "id": "MEAQ30009", "type": "likert", "text_key": "MEAQ30009", "dimension": "DA" },
      { "id": "MEAQ30010", "type": "likert", "text_key": "MEAQ30010", "dimension": "DA" },
      { "id": "MEAQ30011", "type": "likert", "text_key": "MEAQ30011", "dimension": "PR" },
      { "id": "MEAQ30012", "type": "likert", "text_key": "MEAQ30012", "dimension": "PR" },
      { "id": "MEAQ30013", "type": "likert", "text_key": "MEAQ30013", "dimension": "PR" },
      { "id": "MEAQ30014", "type": "likert", "text_key": "MEAQ30014", "dimension": "PR" },
      { "id": "MEAQ30015", "type": "likert", "text_key": "MEAQ30015", "dimension": "PR" },
      { "id": "MEAQ30016", "type": "likert", "text_key": "MEAQ30016", "dimension": "DS" },
      { "id": "MEAQ30017", "type": "likert", "text_key": "MEAQ30017", "dimension": "DS" },
      { "id": "MEAQ30018", "type": "likert", "text_key": "MEAQ30018", "dimension": "DS" },
      { "id": "MEAQ30019", "type": "likert", "text_key": "MEAQ30019", "dimension": "DS" },
      { "id": "MEAQ30020", "type": "likert", "text_key": "MEAQ30020", "dimension": "DS" },
      { "id": "MEAQ30021", "type": "likert", "text_key": "MEAQ30021", "dimension": "RD" },
      { "id": "MEAQ30022", "type": "likert", "text_key": "MEAQ30022", "dimension": "RD" },
      { "id": "MEAQ30023", "type": "likert", "text_key": "MEAQ30023", "dimension": "RD" },
      { "id": "MEAQ30024", "type": "likert", "text_key": "MEAQ30024", "dimension": "RD" },
      { "id": "MEAQ30025", "type": "likert", "text_key": "MEAQ30025", "dimension": "RD" },
      { "id": "MEAQ30026", "type": "likert", "text_key": "MEAQ30026", "dimension": "DE" },
      { "id": "MEAQ30027", "type": "likert", "text_key": "MEAQ30027", "dimension": "DE" },
      { "id": "MEAQ30028", "type": "likert", "text_key": "MEAQ30028", "dimension": "DE" },
      { "id": "MEAQ30029", "type": "likert", "text_key": "MEAQ30029", "dimension": "DE" },
      { "id": "MEAQ30030", "type": "likert", "text_key": "MEAQ30030", "dimension": "DE" }
    ],
    "scoring": {
      "BA": {
        "method": "mean_coded",
        "description": "Behavioral Avoidance",
        "items": { "MEAQ30001": 1, "MEAQ30002": 1, "MEAQ30003": 1, "MEAQ30004": 1, "MEAQ30005": 1 }
      },
      "DA": {
        "method": "mean_coded",
        "description": "Distress Aversion",
        "items": { "MEAQ30006": 1, "MEAQ30007": 1, "MEAQ30008": 1, "MEAQ30009": 1, "MEAQ30010": 1 }
      },
      "PR": {
        "method": "mean_coded",
        "description": "Procrastination. Item 15 is reverse-scored.",
        "items": { "MEAQ30011": 1, "MEAQ30012": 1, "MEAQ30013": 1, "MEAQ30014": 1, "MEAQ30015": -1 }
      },
      "DS": {
        "method": "mean_coded",
        "description": "Distraction and Suppression",
        "items": { "MEAQ30016": 1, "MEAQ30017": 1, "MEAQ30018": 1, "MEAQ30019": 1, "MEAQ30020": 1 }
      },
      "RD": {
        "method": "mean_coded",
        "description": "Repression/Denial",
        "items": { "MEAQ30021": 1, "MEAQ30022": 1, "MEAQ30023": 1, "MEAQ30024": 1, "MEAQ30025": 1 }
      },
      "DE": {
        "method": "mean_coded",
        "description": "Distress Endurance — high scores indicate low avoidance (opposite direction from other subscales)",
        "items": { "MEAQ30026": 1, "MEAQ30027": 1, "MEAQ30028": 1, "MEAQ30029": 1, "MEAQ30030": 1 }
      }
    }
  },
  "translations": {
    "en": {
      "MEAQ30_head": "Please indicate how much you agree or disagree with each statement.",
      "MEAQ30_r1": "Strongly disagree",
      "MEAQ30_r2": "2",
      "MEAQ30_r3": "3",
      "MEAQ30_r4": "4",
      "MEAQ30_r5": "5",
      "MEAQ30_r6": "Strongly agree",
      "MEAQ30001": "I won't do something if I think it will make me uncomfortable.",
      "MEAQ30002": "I avoid activities if there is even a small possibility of getting hurt.",
      "MEAQ30003": "If I am starting to feel trapped, I leave the situation immediately.",
      "MEAQ30004": "If I am in a slightly uncomfortable situation, I try to leave right away.",
      "MEAQ30005": "I avoid situations if there is a chance that I'll feel nervous.",
      "MEAQ30006": "If I could magically remove all of my painful memories, I would.",
      "MEAQ30007": "Happiness means never feeling any pain or disappointment.",
      "MEAQ30008": "One of my big goals is to be free from painful emotions.",
      "MEAQ30009": "I'd do anything to feel less stressed.",
      "MEAQ30010": "I would give up a lot not to feel bad.",
      "MEAQ30011": "I tend to put off unpleasant things that need to get done.",
      "MEAQ30012": "When I have something important to do I find myself doing a lot of other things instead.",
      "MEAQ30013": "I try to put off unpleasant tasks for as long as possible.",
      "MEAQ30014": "I won't do something until I absolutely have to.",
      "MEAQ30015": "I try to deal with problems right away.",
      "MEAQ30016": "When negative thoughts come up, I try to fill my head with something else.",
      "MEAQ30017": "When upsetting memories come up, I try to focus on other things.",
      "MEAQ30018": "I work hard to keep out upsetting feelings.",
      "MEAQ30019": "When unpleasant memories come to me, I try to put them out of my mind.",
      "MEAQ30020": "When a negative thought comes up, I immediately try to think of something else.",
      "MEAQ30021": "Others have told me that I suppress my feelings.",
      "MEAQ30022": "It's hard for me to know what I'm feeling.",
      "MEAQ30023": "It takes me awhile to realize when I'm feeling bad.",
      "MEAQ30024": "I feel disconnected from my emotions.",
      "MEAQ30025": "People have told me that I'm not aware of my problems.",
      "MEAQ30026": "Even when I feel uncomfortable, I don't give up working toward things I value.",
      "MEAQ30027": "When I am hurting, I still do what needs to be done.",
      "MEAQ30028": "I don't let pain and discomfort stop me from getting what I want.",
      "MEAQ30029": "I don't let gloomy thoughts stop me from doing what I want.",
      "MEAQ30030": "When working on something important, I won't quit even if things get difficult."
    }
  }
}
