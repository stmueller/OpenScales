      "ipip_R75": "Gör slarviga misstag",
      "ipip_D101": "Skulle inte uppskatta ett arbete som innehåller mycket social interaktion",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_P399": "Låter andra bestämma över mig så att de skall känna sig viktiga",
      "ipip_H1382": "Har svårt att föreställa mig saker",
      "ipip_Q189": "Känner att många människor inte går att lita på",
      "ipip_D86": "Skulle inte ångra mitt beteende om jag impulsivt drog nytta av någon",
      "ipip_R24": "Blir upprörd om andra ändrar hur jag har ordnat saker",
      "ipip_X125": "Ser mig själv som en medelmåtta",
      "ipip_H1325": "Är ute efter min egen personliga vinning",
      "ipip_H1230": "Kommer upp med något nytt",
      "ipip_D63": "Är oftast en tålmodig person",
      "ipip_H244": "Tycker om att städa upp",
      "ipip_Q125": "Byter lojalitet när jag känner för det",
      "ipip_E11": "Vill att allt ska vara precis rätt",
      "ipip_Q256": "Är känslig för andras behov",
      "ipip_H744": "Försöker att imponera på andra",
      "ipip_Q197": "Sätter snabbt igång med ett jobb",
      "ipip_A96": "Föredrar att bara låta saker hända",
      "ipip_R35": "Anses vara lite excentrisk",
      "ipip_Q253": "Agerar impulsivt när något stör mig",
      "ipip_E136": "Känner andra människors känslor",
      "ipip_E46": "Kastar mig över saker utan att tänka efter",
      "ipip_Q191": "Känner att jag har massor av inre styrka",
      "ipip_Q151": "Upprätthåller hög energinivå dagen igenom",
