{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Schwarzer Procrastination Scale",
      "code": "PROCR",
      "abbreviation": "PROCR",
      "description": "10-item Procrastination Scale (Schwarzer et al.). Rated 1-4 (not at all true..exactly true). Items 2,3,5,7,8 are reverse-scored.",
      "citation": "Schwarzer, R., Schmitz, G. S., & Diehl, M. (2000). Procrastination [measurement instrument]; Schwarzer, R. (2000). Stress, Angst und Handlungsregulation (4th ed.). Stuttgart: Kohlhammer.",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales. Items reproduced from the authors' official documentation (userpage.fu-berlin.de/~gesund/skalen/ and userpage.fu-berlin.de/~health/).",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~gesund/skalen/Prokrastination/prokrastination.htm",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Bilingual English/German. English items from userpage.fu-berlin.de/~health/; German items from the FU-Berlin skalen documentation. 4-point response (1-4). Items 2,3,5,7,8 are reverse-scored. Source does not state sum vs mean; sum used (range 10-40), mean also common. Reverse markers (R/–) identical on English and German source pages."
    },
