      "ipip_H973": "Kan inte stå på egna ben",
      "ipip_P433": "Vet alltid varför jag gör saker",
      "ipip_H1185": "Vet hur man roar sig",
      "ipip_H1116": "Känner att jag kan klar vad som helst",
      "ipip_H33": "Älskar livet",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_H64": "Tar initiativet",
      "ipip_P404": "Tror att somliga är födda med tur",
      "ipip_H954": "Tycker att jag har svårt att handskas med saker",
      "ipip_H1183": "Missar mina chanser för jämnan",
      "ipip_P369": "Tror att världen kontrolleras av några mäktiga människor",
      "ipip_P360": "Tror på kraften i ödet",
      "ipip_H1166": "Är resignerad i relation till mitt öde",
      "ipip_X129": "Känner mig trygg med mig själv",
      "ipip_X205": "Känns som om mitt liv saknar inriktning",
