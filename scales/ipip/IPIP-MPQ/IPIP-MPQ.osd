{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "IPIP-MPQ",
      "name": "IPIP MPQ",
      "abbreviation": "IPIP-MPQ",
      "description": "Meta-scale aggregating all 12 IPIP-MPQ subscales. Each subscale is a separate section controlled by a boolean parameter. Intended primarily for translation and bulk administration.",
      "citation": "Tellegen, A., & Waller, N. G. (2008). Exploring personality through test construction: Development of the Multidimensional Personality Questionnaire. In G. J. Boyle, G. Matthews, & D. H. Saklofske (Eds.), The SAGE Handbook of Personality Theory and Assessment (Vol. 2, pp. 261–292). SAGE.",
      "license": "Public Domain",
      "version": "1.0",
      "url": "https://ipip.ori.org/newMPQKey.htm",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-10",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Auto-generated by build_ipip_meta_scales.py from 12 subscales."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
