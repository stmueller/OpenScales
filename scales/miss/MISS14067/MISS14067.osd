{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Big Five Inventory-2 Extra-Short (PIAAC)",
      "code": "MISS14067",
      "abbreviation": "BFI-2-XS",
      "description": "A 15-item ultra-brief measure of the Big Five personality domains (Extraversion, Agreeableness, Conscientiousness, Emotional Stability, Openness) developed for use in the Programme for the International Assessment of Adult Competencies (PIAAC). Three items per domain, one per facet. Available in 39 language versions across 40 countries.",
      "citation": "Rammstedt, B., Roemer, L., Behr, D., Bluemke, M., Lechner, C., Dept, S., Wäyrynen, L., Soto, C., & John, O. P. (2025). Going global: 39 language versions of the BFI-2-XS. Measurement Instruments for the Social Sciences, 7, Article e14067. https://doi.org/10.5964/miss.14067",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/14067",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items and translations from OSF supplementary materials (Roemer et al., 2024, https://osf.io/u4f36), AppendixC_BFI-2-XS_PIAAC_Country-versions.xlsx. 15 BFI-2-XS items; items 1,3,4,8,9,10 are reverse-scored per facet code (R) notation (bfi2xs1 EXTR_SOC(R), bfi2xs3 CONS_ORG(R), bfi2xs4 EMOS_ANX(R), bfi2xs8 CONS_PRO(R), bfi2xs9 EMOS_DEP(R), bfi2xs10 OPEN_INT(R); bfi2xs7 AGRE_RES(R)). Response scale: 1=Strongly disagree to 5=Strongly agree. Facets: EXTR_SOC(Sociability), EXTR_ASS(Assertiveness), EXTR_ENE(Energy); AGRE_COM(Compassion), AGRE_RES(Respectfulness), AGRE_TRU(Trust); CONS_ORG(Organization), CONS_PRO(Productiveness), CONS_RES(Responsibility); EMOS_ANX(Anxiety), EMOS_DEP(Depression), EMOS_VOL(Volatility); OPEN_AES(Aesthetic Sensitivity), OPEN_INT(Intellectual Curiosity), OPEN_CRE(Creative Imagination). No question stem is used — items are standalone first-person statements (e.g., 'I tend to be quiet.'). Country variants included where translations differ from the canonical language version: es-CL (Chilean Spanish, esp-CHL), fr-CA (Canadian French, fra-CAN), sv-FI (Swedish Finland, swe-FIN), nl-BE (Belgian Dutch/Flemish, nld-BEL), hu-SK (Hungarian Slovakia, hun-SVK)."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "bfi2xs_r1",
        "bfi2xs_r2",
        "bfi2xs_r3",
        "bfi2xs_r4",
        "bfi2xs_r5"
      ]
    },
    "dimensions": [
      {
        "id": "extraversion",
        "name": "Extraversion",
        "abbreviation": "E",
        "description": "3 items: Sociability(R), Assertiveness, Energy Level. Mean range 1–5."
      },
      {
        "id": "agreeableness",
        "name": "Agreeableness",
        "abbreviation": "A",
        "description": "3 items: Compassion, Respectfulness(R), Trust. Mean range 1–5."
      },
      {
        "id": "conscientiousness",
        "name": "Conscientiousness",
        "abbreviation": "C",
        "description": "3 items: Organization(R), Productiveness(R), Responsibility. Mean range 1–5."
      },
      {
        "id": "emotional_stability",
        "name": "Emotional Stability",
        "abbreviation": "ES",
        "description": "3 items: Anxiety(R), Depression(R), Volatility. Mean range 1–5."
      },
      {
        "id": "openness",
        "name": "Openness",
        "abbreviation": "O",
        "description": "3 items: Aesthetic Sensitivity, Intellectual Curiosity(R), Creative Imagination. Mean range 1–5."
      }
    ],
