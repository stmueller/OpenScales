      "ipip_H160": "Dedico tiempo a los demás",
      "ipip_H823": "Dejo mis pertenencias en cualquier lado",
      "ipip_X156": "Rara vez me siento triste",
      "ipip_E119": "Realizo mis tareas inmediatamente",
      "ipip_H154": "Prefiero mantenerme al margen",
      "ipip_X177": "Tengo un corazón sensible",
