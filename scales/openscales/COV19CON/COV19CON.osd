{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "COV19CON",
      "name": "COVID-19 Conspiracy Measure",
      "abbreviation": "COV19CON",
      "description": "6-item measure assessing beliefs in conspiracy theories about COVID-19. A 3-item short version uses only the first three items. Items rated on a 10-point scale from do not agree at all (1) to fully agree (10).",
      "citation": "De Coninck, D., Frissen, T., Matthijs, K., d'Haenens, L., Lits, G., Champagne-Poirier, O., Carignan, M.-E., David, M. D., Pignard-Cheynel, N., Salerno, S., & Généreux, M. (2021). Beliefs in conspiracy theories and misinformation about COVID-19: Comparative perspectives on the role of anxiety, depression and exposure to and trust in information sources. Frontiers in Psychology, 12. https://doi.org/10.3389/fpsyg.2021.646394",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2021.646394",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 10,
      "min": 1,
      "labels": [
        "COV19CON_r1",
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        "COV19CON_r10"
      ],
      "question_head": "COV19CON_head"
    },
    "dimensions": [
      {
        "id": "ConspiracyBeliefs",
        "name": "Conspiracy Beliefs",
        "description": "Degree of belief in conspiracy theories about the COVID-19 pandemic"
      }
    ],
    "items": [
      {
        "id": "COV19CON001",
        "type": "likert",
        "text_key": "COV19CON001",
        "dimension": "ConspiracyBeliefs"
