  "translations": {
    "en": {
      "instructions": "Please work through the statements. For each, choose a number between 1 (strongly disagree) and 7 (strongly agree) to say how much you disagree or agree. Do not think too much about it — your initial responses are usually the best. Thank you.",
      "question_head": "",
      "debrief": "Thank you for completing this questionnaire.",
      "LANGUAGE": "English",
      "rfq12_r1": "Strongly Disagree",
      "rfq12_r2": "",
      "rfq12_r3": "",
      "rfq12_r4": "",
      "rfq12_r5": "",
      "rfq12_r6": "",
      "rfq12_r7": "Strongly Agree",
      "rfq12_1": "It’s easy for me to figure out what someone else is thinking or feeling",
      "rfq12_2": "I often get confused about what I am feeling",
      "rfq12_3": "Understanding what’s on someone else’s mind is never difficult for me",
      "rfq12_4": "It’s really hard for me to figure out what goes on in other people’s heads",
      "rfq12_5": "Other people’s thoughts and feelings are confusing to me",
      "rfq12_6": "Strong feelings often cloud my thinking",
      "rfq12_7": "I normally have a good idea of what is on other people’s minds",
      "rfq12_8": "When I get angry I say things that I later regret",
      "rfq12_9": "I am a good mind reader",
      "rfq12_10": "I usually know exactly what other people are thinking",
      "rfq12_11": "Sometimes I do things without really knowing why",
      "rfq12_12": "My gut feeling about what someone else is thinking is usually very accurate"
    },
    "ko": {
      "instructions": "아래의 각 문항을 잘 읽은 후, 평소 자신을 잘 나타내는 곳에 \"O\"표를 해 주십시오.",
      "question_head": "",
      "debrief": "설문에 응해 주셔서 감사합니다.",
      "LANGUAGE": "한국어",
      "rfq12_r1": "전혀 그렇지 않다",
      "rfq12_r2": "거의 그렇지 않다",
      "rfq12_r3": "별로 그렇지 않다",
      "rfq12_r4": "보통이다",
      "rfq12_r5": "조금 그렇다",
      "rfq12_r6": "거의 그렇다",
      "rfq12_r7": "매우 그렇다",
      "rfq12_1": "사람들이 무슨 생각을 하고 어떻게 느끼는지 알아내기란 쉬운 일이다.",
      "rfq12_2": "가끔 내가 어떤 기분인지 혼란스럽다.",
      "rfq12_3": "다른 사람의 마음을 이해하는 일이 나에게는 결코 어렵지 않다.",
      "rfq12_4": "다른 사람의 머릿속에 무슨 일이 일어나는지 알아내기란 정말 힘든 일이다.",
      "rfq12_5": "다른 사람이 어떻게 생각하고 느끼는지 헷갈릴 때가 많다.",
      "rfq12_6": "종종 격한 감정이 일어나 생각이 흐려진다.",
      "rfq12_7": "다른 사람의 마음속을 잘 파악하는 편이다.",
      "rfq12_8": "화가 나면 나중에 후회할 말을 곧잘 한다.",
      "rfq12_9": "남의 마음을 곧잘 읽는다.",
      "rfq12_10": "다른 사람들이 무슨 생각을 하는지 대부분 정확하게 알고 있다.",
      "rfq12_11": "가끔 그렇게 행동하는 이유를 알지 못한 채 행동하곤 한다.",
      "rfq12_12": "다른 사람의 생각에 대한 내 짐작은, 거의 언제나 잘 맞다."
    }
  }
}