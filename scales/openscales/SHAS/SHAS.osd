{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "SHAS",
      "name": "Short Home Attachment Scale",
      "abbreviation": "SHAS",
      "description": "7-item scale measuring emotional attachment to one's home, including place identity, place dependence, and affective bonds with the home environment.",
      "citation": "Nartova-Bochaver, S., Reznichenko, S., Bardadymov, V., Khachaturova, M., Yerofeyeva, V., Khachatryan, N., Kryazh, I., Kamble, S., & Zulkarnain, Z. (2022). Measurement invariance of the short home attachment scale: A cross-cultural study. Frontiers in Psychology, 13. https://doi.org/10.3389/fpsyg.2022.834421",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2022.834421",
      "version": "1.0",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "SHAS_r1",
        null,
        null,
        null,
        null,
        null,
        "SHAS_r7"
      ],
      "question_head": "SHAS_head"
    },
    "dimensions": [
      {
        "id": "SHAS",
        "name": "Home Attachment",
        "description": "Overall emotional attachment to one's home"
      }
    ],
    "items": [
      {
        "id": "SHAS001",
        "type": "likert",
        "text_key": "SHAS001",
        "dimension": "SHAS"
      },
      {
        "id": "SHAS002",
        "type": "likert",
        "text_key": "SHAS002",
        "dimension": "SHAS"
      },
      {
        "id": "SHAS003",
        "type": "likert",
        "text_key": "SHAS003",
        "dimension": "SHAS"
      },
      {
        "id": "SHAS004",
