{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Momentary-Chronic Regulatory Focus Scale",
      "code": "MISS10993",
      "abbreviation": "MPRF",
      "description": "A 16-item state/trait scale measuring regulatory focus theory constructs across four subscales: Ideals focus (Id; 4 items), Oughts focus (Ou; 4 items), Gain focus (G; 4 items), and Non-Loss focus (N-L; 4 items). Items use a flexible stem allowing temporal or domain specificity (e.g., 'at this moment', 'today', 'at work'). All 16 items use a 7-point scale (1=does not apply at all to 7=applies fully). An 8-item abbreviated version (marked with superscript a) uses items Id1, Id4, Ou1, Ou3, G1, G2, N-L1, N-L3. Validated for momentary (state) and chronic (trait) measurement. Developed in English and German.",
      "citation": "Fay, D., Urbach, T., & Scheithauer, M. (2019). The Momentary-Chronic Regulatory Focus scale. Measurement Instruments for the Social Sciences, 1, Article e10993. https://doi.org/10.5964/miss.10993",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/10993",
      "domain": "Social",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items and instructions verbatim from Additional file 1 of Fay et al. (2019), chronic (trait) form using 'in general'. For the momentary (state) form, the instruction phrase 'in general' is replaced with a temporal/domain qualifier (e.g., 'at this moment', 'today', 'this morning', 'at work'). Items marked 'abbreviated' in the source form an 8-item short form (Id1, Id4, Ou1, Ou3, G1, G2, N-L1, N-L3). Subscale scores are means. ICC values from Studies 4 and 5 are provided in the source for reliability benchmarking. No reverse-coded items."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "mprf_r1",
        null,
        null,
        null,
        null,
        null,
        "mprf_r7"
      ]
    },
    "dimensions": [
      {
        "id": "ideals",
        "name": "Ideals Focus",
        "abbreviation": "Id",
        "description": "Promotion focus via ideals — thoughts and actions directed toward personal growth, hopes, wishes, and dreams. Mean of 4 items, range 1–7; higher = stronger ideals orientation."
      },
      {
        "id": "oughts",
        "name": "Oughts Focus",
        "abbreviation": "Ou",
        "description": "Prevention focus via oughts — thoughts and actions directed toward obligations, responsibilities, expectations, and guidelines. Mean of 4 items, range 1–7; higher = stronger oughts orientation."
      },
      {
        "id": "gain",
        "name": "Gain Focus",
        "abbreviation": "G",
        "description": "Promotion focus via gains — thoughts and actions directed toward success, accomplishment, and maximizing outcomes. Mean of 4 items, range 1–7; higher = stronger gain orientation."
      },
      {
        "id": "nonloss",
        "name": "Non-Loss Focus",
        "abbreviation": "N-L",
        "description": "Prevention focus via non-loss — thoughts and actions directed toward averting losses, setbacks, mistakes, and undesirable events. Mean of 4 items, range 1–7; higher = stronger non-loss orientation."
      }
    ],
