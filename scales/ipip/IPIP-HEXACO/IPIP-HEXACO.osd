      "ipip_D93": "Retko me uznemiri patnja nepoznatih ljudi.",
      "ipip_Q183": "Volim svoje neprijatelje.",
      "ipip_P385": "Premalo radim.",
      "ipip_R71": "Voleo bih da istražujem nepoznata mesta.",
      "ipip_H1356": "Imam oko za detalje.",
      "ipip_Q186": "Uživam u osećanju da sam deo prirode.",
      "ipip_H747": "Trudim se da steknem visok društveni položaj.",
      "ipip_P371": "Ne težim eleganciji u svom izgledu.",
