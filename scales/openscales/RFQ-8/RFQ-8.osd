    ],
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "RFQ_response_1",
        "RFQ_response_2",
        "RFQ_response_3",
        "RFQ_response_4",
        "RFQ_response_5",
        "RFQ_response_6",
        "RFQ_response_7"
      ],
      "question_head": "question_head"
    },
    "dimensions": [
      {
        "id": "RFQ_C",
        "name": "Certainty about Mental States",
        "description": "Certainty subscale (6 items: 1,2,3,4,5,6). Higher scores indicate greater certainty about mental states. Recoded: 1→3, 2→2, 3→1, 4–7→0. Range: 0–3."
      },
      {
        "id": "RFQ_U",
        "name": "Uncertainty about Mental States",
        "description": "Uncertainty subscale (6 items: 2,4,5,6,7,8). Higher scores indicate greater uncertainty about mental states. Recoded: 1–4→0, 5→1, 6→2, 7→3 (item 7 reverse-recoded). Range: 0–3."
      }
    ],
    "scoring": {
      "RFQ_C": {
        "description": "Mean of 6 recoded items (range 0–3). Items recoded: 1→3, 2→2, 3→1, 4–7→0. Higher = greater certainty about mental states.",
        "method": "mean_coded",
        "items": [
          "RFQ001",
          "RFQ002",
          "RFQ003",
          "RFQ004",
          "RFQ005",
          "RFQ006"
        ],
        "value_map": {
          "default": [
            3,
            2,
            1,
            0,
            0,
            0,
            0
          ]
        }
      },
      "RFQ_U": {
        "description": "Mean of 6 recoded items (range 0–3). Items recoded: 1–4→0, 5→1, 6→2, 7→3 (item 7 reverse-recoded: 1→3, 2→2, 3→1, 4–7→0). Higher = greater uncertainty about mental states.",
        "method": "mean_coded",
        "items": [
          "RFQ002",
          "RFQ004",
          "RFQ005",
          "RFQ006",
          "RFQ007",
          "RFQ008"
        ],
        "value_map": {
          "default": [
            0,
            0,
            0,
            0,
            1,
            2,
            3
          ],
          "RFQ007": [
            3,
            2,
            1,
            0,
            0,
            0,
            0
          ]
        }
      }
    },
    "data_output": {
      "individual_file": "{code}-{subnum}.csv",
      "pooled_file": "{code}-pooled.csv",
      "report_file": "{code}-report-{subnum}.html",
      "columns": "",
      "pooled_columns": ""
    },
    "report": {
      "template": "standard",
      "header": "",
      "include": [],
      "footer_refs": []
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "notes": "PROVENANCE: RFQ-8 (8-item validated short form; Fonagy et al., 2016). Its 8 items are original RFQ-54 items 1,8,17,22,27,29,35,36 (per UCL RFQ_8.docx). Scoring VERIFIED against UCL's official SPSS syntax (RFQ_8_7pointscale.sps): Certainty recode 1→3,2→2,3→1,4-7→0 (mean of 6); Uncertainty 1-4→0,5→1,6→2,7→3 with item 7 reverse (mean of 6). No English RFQ-54/26/12 is publicly available from UCL (only RFQ-8); the 54/26/12 forms appear in some non-English zips (e.g. Korean). Added Korean (ko) translation from UCL (July 2017); 15 languages.",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "translations": {
    "en": {
      "translated_by": "Fonagy P, Luyten P, Moulton-Perkins A, Lee YW, Warren F, Howard S, et al.",
      "instructions": "Please work through the next 8 statements. For each statement, choose a number between 1 and 7 to say how much you disagree or agree with the statement. Do not think too much about it — your initial responses are usually the best. Thank you.",
      "question_head": "Please answer the following questions:",
      "RFQ001": "People's thoughts are a mystery to me",
      "RFQ002": "I don't always know why I do what I do",
      "RFQ003": "When I get angry I say things without really knowing why I am saying them",
      "RFQ004": "When I get angry I say things that I later regret",
      "RFQ005": "If I feel insecure I can behave in ways that put others' backs up",
      "RFQ006": "Sometimes I do things without really knowing why",
      "RFQ007": "I always know what I feel",
      "RFQ008": "Strong feelings often cloud my thinking",
      "RFQ_response_1": "Strongly Disagree",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Strongly Agree",
      "debrief": "Thank you for completing this questionnaire."
    },
    "de": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Bitte bearbeiten Sie die folgenden 8 Aussagen, indem Sie jedes Mal die eine Antwortmöglichkeit auswählen und neben die Aussage schreiben, von der Sie meinen, dass sie Sie am besten beschreibt; 1 wenn Sie gar nicht zustimmen, 7 wenn sie völlig zustimmen. Die Mitte, d.h. wenn sie neutral oder unentschlossen sind, ist die 4. Denken Sie nicht zuviel darüber nach – Ihre spontanen Antworten sind gewöhnlich die besten. Vielen Dank!",
      "question_head": "Benutzen Sie die folgende Skala von 1–7:",
      "RFQ001": "Ich finde die Gedanken anderer verwirrend.",
      "RFQ002": "Ich weiß nicht immer, warum ich tue, was ich tue.",
      "RFQ003": "Wenn ich wütend werde, sage ich Dinge, ohne wirklich zu wissen, warum ich sie sage.",
      "RFQ004": "Wenn ich wütend werde, sage ich Dinge, die mir später leidtun.",
      "RFQ005": "Wenn ich mich unsicher fühle, verhalte ich mich auf eine Weise, die andere irritieren kann.",
      "RFQ006": "Manchmal tue ich Dinge, ohne wirklich zu wissen warum.",
      "RFQ007": "Ich weiß immer, was ich fühle.",
      "RFQ008": "Starke Gefühle machen es mir oft schwer, klare Gedanken zu fassen.",
      "RFQ_response_1": "Stimme gar nicht zu",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Stimme völlig zu",
      "debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens."
    },
    "fr": {
      "translated_by": "Badoud D",
      "instructions": "Vous trouverez un certain nombre d'énoncés listés ci-dessous. Lisez chaque énoncé et décidez si vous êtes en accord ou en désaccord avec ce dernier. Afin d'évaluer dans quelle mesure vous êtes en accord ou en désaccord, veuillez utiliser l'échelle suivante: le 7 si vous êtes fortement en accord, et le 1 si vous êtes fortement en désaccord. Utilisez le point milieu (le 4) si vous êtes neutre ou indécis.",
      "question_head": "Utilisez l'échelle suivante de 1 à 7 :",
      "RFQ001": "Les pensées des gens sont un mystère pour moi.",
      "RFQ002": "Je ne sais pas toujours pourquoi je fais ce que je fais.",
      "RFQ003": "Quand je me fâche, je dis des choses sans vraiment savoir pourquoi je les dis.",
      "RFQ004": "Quand je me fâche, je dis des choses que je regrette plus tard.",
      "RFQ005": "Si je manque d'assurance, je peux me comporter d'une manière qui monte les autres contre moi.",
      "RFQ006": "Parfois, je fais des choses sans vraiment savoir pourquoi.",
      "RFQ007": "Je sais toujours ce que je ressens.",
      "RFQ008": "Les sentiments intenses brouillent souvent ma pensée.",
      "RFQ_response_1": "Fortement en désaccord",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Fortement en accord",
      "debrief": "Merci d'avoir rempli ce questionnaire."
    },
    "es": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Por favor lea y valore las siguientes 8 afirmaciones. Elija un número del 1 al 7 para describir en qué forma está en desacuerdo o de acuerdo con cada una de ellas. Marque con un círculo el número elegido para cada afirmación. No piense mucho la respuesta, la primera que se le ocurra será normalmente la mejor.",
      "question_head": "Por favor responda las siguientes preguntas:",
      "RFQ001": "Los pensamientos de la gente son un misterio para mí",
      "RFQ002": "No siempre sé por qué hago lo que hago",
      "RFQ003": "Cuando me enfado digo cosas sin realmente saber por qué las digo",
      "RFQ004": "Cuando me enfado digo cosas de las que luego me arrepiento",
      "RFQ005": "Si me siento inseguro puedo comportarme de una manera que molesta a los demás",
      "RFQ006": "A veces hago cosas sin saber exactamente por qué",
      "RFQ007": "Siempre sé lo que siento",
      "RFQ008": "A menudo sentimientos muy fuertes nublan mi pensamiento",
      "RFQ_response_1": "Muy en desacuerdo",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Muy de acuerdo",
      "debrief": "Gracias por completar este cuestionario."
    },
    "nl": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Hieronder volgen 8 uitspraken die mensen gebruiken om zichzelf te beschrijven. Schrijf vóór elke uitspraak het cijfer dat het beste aangeeft in welke mate u het eens bent met die uitspraak. Maak hierbij gebruik van volgende schaal. Als u helemaal akkoord bent, vul dan het cijfer 7 in; als u helemaal niet akkoord bent, vul dan het cijfer 1 in; als u zich ergens tussenin voelt, vul dan één van de cijfers tussen 1 en 7 in. Het middelpunt, als u neutraal of onbeslist staat ten opzichte van een uitspraak, is 4.",
      "question_head": "Beweringenvragenlijst:",
      "RFQ001": "Wat mensen denken is een raadsel voor mij.",
      "RFQ002": "Ik weet niet altijd waarom ik doe wat ik doe.",
      "RFQ003": "Wanneer ik kwaad word, zeg ik dingen zonder echt te weten waarom ik ze zeg.",
      "RFQ004": "Wanneer ik kwaad word, zeg ik dingen waar ik later spijt van heb.",
      "RFQ005": "Als ik me niet veilig voel, kan ik dingen doen die anderen ergeren.",
      "RFQ006": "Soms doe ik dingen zonder echt te weten waarom.",
      "RFQ007": "Ik weet altijd wat ik voel.",
      "RFQ008": "Sterke gevoelens vertroebelen vaak mijn denken.",
      "RFQ_response_1": "Helemaal niet akkoord",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Helemaal akkoord",
      "debrief": "Bedankt voor het invullen van deze vragenlijst."
    },
    "it": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Legga con attenzione le affermazioni seguenti e segni, per ognuna, la risposta che descrive meglio la sua persona. Scelga un numero tra 1 e 7 per esprimere quanto è in accordo o in disaccordo con ogni affermazione. Il completo disaccordo corrisponde al punteggio 1; se è fortemente in accordo il punteggio è 7. Né d'accordo né in disaccordo corrisponde a 4. Non rifletta troppo sulla risposta, la prima è di solito la migliore. Grazie.",
      "question_head": "Risponda alle seguenti domande:",
      "RFQ001": "Per me è un mistero ciò che pensano le persone",
      "RFQ002": "Non conosco sempre il perché di quello che faccio",
      "RFQ003": "Quando mi arrabbio dico cose senza sapere bene perché le sto dicendo",
      "RFQ004": "Quando mi arrabbio dico cose di cui dopo mi pento",
      "RFQ005": "Se mi sento insicuro posso comportarmi in modi che fanno arrabbiare gli altri",
      "RFQ006": "Qualche volta faccio cose senza realmente sapere il perché",
      "RFQ007": "So sempre cosa provo",
      "RFQ008": "Le emozioni forti spesso annebbiano il mio pensiero",
      "RFQ_response_1": "Fortemente in disaccordo",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Fortemente in accordo",
      "debrief": "Grazie per aver compilato questo questionario."
    },
    "cs": {
      "translated_by": "Hrdličková M",
      "instructions": "Prosíme posuďte následujících 8 výroků. U každého z výroků zvolte číslo od 1 do 7, abyste vyjádřili, jak moc s daným tvrzením nesouhlasíte nebo souhlasíte a napište číslo vedle každého tvrzení. Příliš o tom nepřemýšlejte – první odpověď, která vás napadne, je obvykle ta nejlepší. Děkujeme.",
      "question_head": "Použijte následující škálu od 1 do 7:",
      "RFQ001": "Myšlení lidí je pro mě záhadou.",
      "RFQ002": "Ne vždycky vím, proč dělám to, co dělám.",
      "RFQ003": "Když se rozzlobím, říkám věci, aniž bych opravdu věděl/a, proč je říkám.",
      "RFQ004": "Když se rozzlobím, říkám věci, kterých později lituji.",
      "RFQ005": "Když se cítím nejistý/á, mohu se chovat tak, že to ostatní rozzlobí.",
      "RFQ006": "Někdy dělám věci, aniž bych doopravdy věděl/a proč.",
      "RFQ007": "Vždycky vím, co cítím.",
      "RFQ008": "Silné pocity často zatemňují moje myšlení.",
      "RFQ_response_1": "Zcela nesouhlasím",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Zcela souhlasím",
      "debrief": "Děkujeme za vyplnění tohoto dotazníku."
    },
    "sv": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Besvara de 8 påståendena nedan. Välj det svar som du tycker beskriver dig bäst. Välj en av siffrorna 1 till 7 för att visa hur mycket du instämmer i påståendet. Om du inte instämmer alls ringar du in nummer 1. Om du instämmer helt ringar du in nummer 7. Om du varken instämmer eller inte instämmer kan du ringa in nummer 4. Tänk inte för länge på varje påstående – din första tanke är ofta rätt.",
      "question_head": "Svara på följande frågor:",
      "RFQ001": "Människors tankar är ett mysterium för mig.",
      "RFQ002": "Jag vet inte alltid varför jag gör som jag gör.",
      "RFQ003": "När jag blir arg säger jag saker utan att riktigt veta varför jag säger dem.",
      "RFQ004": "När jag blir arg säger jag saker som jag sedan ångrar.",
      "RFQ005": "När jag känner mig osäker kan jag bete mig på ett sätt som retar upp andra.",
      "RFQ006": "Ibland gör jag saker utan att riktigt veta varför.",
      "RFQ007": "Jag vet alltid vad jag känner.",
      "RFQ008": "Starka känslor stör ofta mina tankar.",
      "RFQ_response_1": "Instämmer inte alls",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Instämmer helt",
      "debrief": "Tack för att du har fyllt i detta frågeformulär."
    },
    "tr": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Lütfen aşağıdaki cümleleri dikkatlice okuyunuz. Her bir cümle için, cümleye ne kadar katıldığınızı ifade etmek üzere 1 ile 7 arasında bir numara seçip cümlenin yanına yazınız. Cümleler üzerinde çok fazla düşünmeyin – ilk tepkiniz genellikle en iyisidir. Teşekkür ederiz.",
      "question_head": "1'den 7'ye kadar olan aşağıdaki ölçeği kullanın:",
      "RFQ001": "İnsanların düşünceleri benim için bir bilinmezdir.",
      "RFQ002": "Neyi neden yaptığımı her zaman bilmem.",
      "RFQ003": "Sinirlendiğimde, neden söylediğimi gerçekten bilmediğim şeyler söylerim.",
      "RFQ004": "Sinirlendiğimde, sonradan pişman olacağım şeyler söylerim.",
      "RFQ005": "Eğer güvensiz hissedersem, diğerlerini sinirlendirecek şekilde davranırım.",
      "RFQ006": "Bazen neden yaptığımı gerçekten bilmediğim şeyler yaparım.",
      "RFQ007": "Ne hissettiğimi her zaman bilirim.",
      "RFQ008": "Güçlü duygular genellikle düşüncelerimi bulanıklaştırır.",
      "RFQ_response_1": "Kesinlikle Katılmıyorum",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Kesinlikle Katılıyorum",
      "debrief": "Bu anketi tamamladığınız için teşekkür ederiz."
    },
    "pl": {
      "translated_by": "Gambin M, Wydział Psychologii Uniwersytetu Warszawskiego",
      "instructions": "Proszę przeczytaj osiem zdań zamieszczonych poniżej. Dla każdego zdania wybierz wartość pomiędzy 1 a 7, aby określić jak bardzo zgadzasz się lub nie zgadzasz z tym zdaniem i napisz te wartości w polu przed każdym zdaniem. Nie zastanawiaj się nad tym zbyt długo – pierwsze odpowiedzi są zazwyczaj najlepsze.",
      "question_head": "Proszę odpowiedzieć na poniższe pytania:",
      "RFQ001": "Myśli ludzi są dla mnie zagadką.",
      "RFQ002": "Nie zawsze wiem z jakiego powodu coś robię.",
      "RFQ003": "Kiedy się zezłoszczę, mówię rzeczy bez świadomości dlaczego je mówię.",
      "RFQ004": "Kiedy się zezłoszczę, mówię rzeczy, których później żałuję.",
      "RFQ005": "Kiedy czuję się niepewnie, mogę zachować się w sposób złośliwy wobec drugiej osoby.",
      "RFQ006": "Czasami robię różne rzeczy nie wiedząc tak naprawdę dlaczego.",
      "RFQ007": "Zawsze wiem, co czuję.",
      "RFQ008": "Silne uczucia często zaciemniają moje myślenie.",
      "RFQ_response_1": "Zdecydowanie się nie zgadzam",
      "RFQ_response_2": "",
      "RFQ_response_3": "",
      "RFQ_response_4": "",
      "RFQ_response_5": "",
      "RFQ_response_6": "",
      "RFQ_response_7": "Zdecydowanie się zgadzam",
      "debrief": "Dziękujemy za wypełnienie tego kwestionariusza."
    },
    "el": {
      "translated_by": "Via UCL Psychoanalysis Unit",
      "instructions": "Για κάθε μια από τις επόμενες 8 ερωτήσεις επιλέξτε έναν αριθμό μεταξύ 1 (διαφωνώ απόλυτα) και 7 (συμφωνώ απόλυτα) ανάλογα με το πόσο διαφωνείτε ή συμφωνείτε με τη δήλωση και γράψτε τον αριθμό δίπλα στη δήλωση. Μην το σκεφτείτε πάρα πολύ – οι αρχικές σας απαντήσεις είναι συνήθως οι καλύτερες.",
      "question_head": "Παρακαλώ απαντήστε στις ακόλουθες ερωτήσεις:",
      "RFQ001": "Το πώς σκέφτονται οι άλλοι είναι για μένα ένα μυστήριο",
      "RFQ002": "Δεν ξέρω πάντα γιατί κάνω ό,τι κάνω",
      "RFQ003": "Όταν είμαι θυμωμένος, λέω πράγματα χωρίς να ξέρω πραγματικά γιατί τα λέω",
      "RFQ004": "Όταν είμαι θυμωμένος λέω πράγματα που μετά μετανιώνω",
      "RFQ005": "Αν νιώσω ανασφάλεια μπορεί να συμπεριφερθώ με τρόπο που εκνευρίζει τους άλλους",
      "RFQ006": "Μερικές φορές κάνω πράγματα χωρίς να ξέρω πραγματικά γιατί",
