      "ipip_H596": "Am hard to get to know.",
      "ipip_H2016": "Enjoy being part of a group.",
      "ipip_H704": "Keep others at a distance.",
      "ipip_H1095": "Love to chat.",
      "ipip_H29": "Make friends easily.",
      "ipip_D82": "Rarely enjoy being with people.",
      "ipip_D20": "Seem to derive less enjoyment from interacting with people than others do.",
      "ipip_D70": "Usually like to spend my free time with people.",
      "ipip_D101": "Would not enjoy a job that involves a lot of social interaction.",
      "ipip_H137": "Am inclined to forgive others.",
      "ipip_Q202": "Am nice to people I should be angry at.",
      "ipip_H1195": "Distrust people.",
      "ipip_Q189": "Feel that most people can't be trusted.",
      "ipip_X210": "Find it hard to forgive others.",
      "ipip_Q154": "Get back at people who insult me.",
      "ipip_H711": "Get even with others.",
      "ipip_X217": "Hold a grudge.",
      "ipip_Q183": "Love my enemies.",
      "ipip_E126": "Try to forgive and forget.",
      "ipip_Q69": "Am interested in science.",
      "ipip_X109": "Avoid difficult reading material.",
      "ipip_Q222": "Don't bother worrying about political and social problems.",
      "ipip_Q82": "Don't know much about history.",
      "ipip_Q160": "Enjoy intellectual games.",
      "ipip_X174": "Find political discussions interesting.",
      "ipip_H1276": "Have a rich vocabulary.",
      "ipip_X211": "Love to read challenging material.",
      "ipip_H1392": "Will not probe deeply into a subject.",
      "ipip_R71": "Would love to explore strange places.",
      "ipip_Q103": "Am just an ordinary person.",
      "ipip_P441": "Am likely to show off if I get the chance.",
      "ipip_P469": "Am more capable than most others.",
      "ipip_H736": "Believe that I am better than others.",
      "ipip_H746": "Boast about my virtues.",
      "ipip_X125": "Consider myself an average person.",
      "ipip_Q175": "Don't think that I'm better than other people.",
      "ipip_H1150": "Like to attract attention.",
      "ipip_Q12": "See myself as an average person.",
      "ipip_Q165": "Would like to have more power than other people.",
      "ipip_Q179": "Am mainly interested in money.",
      "ipip_H1325": "Am out for my own personal gain.",
      "ipip_P371": "Don't strive for elegance in my appearance.",
      "ipip_P445": "Have a strong need for power.",
      "ipip_Q161": "Love luxury.",
      "ipip_P370": "Prefer to eat at expensive restaurants.",
      "ipip_H747": "Seek status.",
      "ipip_H744": "Try to impress others.",
      "ipip_Q19": "Wish to stay young forever.",
      "ipip_Q226": "Would not enjoy being a famous celebrity.",
      "ipip_H1302": "Am never at a loss for words.",
      "ipip_H34": "Am the life of the party.",
      "ipip_H1146": "Bottle up my feelings.",
      "ipip_X68": "Don't like to draw attention to myself.",
      "ipip_X56": "Don't talk a lot.",
