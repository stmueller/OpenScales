  "translations": {
    "en": {
      "ao_head": "How acceptable for you would it be for your country to have a strong leader who is above the law? Please choose your answer on a scale where 0 is not at all acceptable and 10 is completely acceptable.",
      "accalaw": "How acceptable would it be for your country to have a strong leader who is above the law?",
      "ao_acc_lo": "Not at all acceptable",
      "ao_acc_hi": "Completely acceptable",
      "ao_head2": "Please say to what extent you agree or disagree with each of the following statements.",
      "imobed": "Obedience and respect for authority are the most important values children should learn.",
      "loylead": "What the country needs most is loyalty towards its leaders.",
      "ao_r1": "Agree strongly",
      "ao_r2": "Agree",
      "ao_r3": "Neither agree nor disagree",
      "ao_r4": "Disagree",
      "ao_r5": "Disagree strongly",
      "debrief": "Thank you for completing this questionnaire."
    },
    "de": {
      "ao_head": "KARTE 16",
      "accalaw": "Wie akzeptabel wäre es für Sie, wenn Deutschland eine starke Führungsperson hätte, die über dem Gesetz steht?",
      "ao_acc_lo": "Überhaupt nicht akzeptabel",
      "ao_acc_hi": "Voll und ganz akzeptabel",
      "ao_head2": "Inwieweit stimmen Sie jeder der folgenden Aussagen zu oder lehnen diese ab? Markieren Sie für jede Aussage ein Kästchen.",
      "imobed": "Gehorsam und Respekt vor Autorität sind die wichtigsten Werte, die Kinder lernen sollten.",
      "loylead": "Was Deutschland am meisten braucht, ist Loyalität gegenüber der politischen Führung.",
      "ao_r1": "Stimme stark zu",
      "ao_r2": "Stimme zu",
      "ao_r3": "Weder noch",
      "ao_r4": "Lehne ab",
      "ao_r5": "Lehne stark ab",
      "debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens."
    },
    "at": {
      "ao_head": "KARTE 16",
      "accalaw": "Wie akzeptabel wäre es für Sie, wenn Österreich eine starke Regierungschefin/einen starken Regierungschef hat, die/der über dem Gesetz steht?",
      "ao_acc_lo": "Überhaupt nicht akzeptabel",
      "ao_acc_hi": "Voll und ganz akzeptabel",
      "ao_head2": "Inwieweit stimmen Sie jeder der folgenden Aussagen zu oder lehnen diese ab? Kreuzen Sie für jede Aussage ein Kästchen an.",
      "imobed": "Gehorsam und Respekt vor Autorität sind die wichtigsten Werte, die Kinder lernen sollten.",
      "loylead": "Was Österreich am meisten braucht, ist Loyalität gegenüber der politischen Führung.",
      "ao_r1": "Stimme stark zu",
      "ao_r2": "Stimme zu",
      "ao_r3": "Weder noch",
      "ao_r4": "Lehne ab",
      "ao_r5": "Lehne stark ab",
      "debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens."
    },
    "bg": {
      "ao_head": "ШОУ КАРТА 16",
      "accalaw": "Доколко приемливо би било за Вас България да има силен лидер, който стои над закона? Изберете отговора си от тази карта, където „0” означава „напълно неприемливо”, а \"10\" - „напълно приемливо”.",
      "ao_acc_lo": "Напълно неприемливо",
      "ao_acc_hi": "Напълно приемливо",
      "ao_head2": "Доколко сте съгласни или не с всяко от следващите твърдения? Ползвайте тази карта. ПРОЧЕТЕТЕ ВСЯКО ОТ ТВЪРДЕНИЯТА",
      "imobed": "Най-важните ценности, на които трябва да научим децата си, са послушанието и уважението към авторитетите.",
      "loylead": "Това, от което България се нуждае най-много, е лоялност към своите лидери.",
      "ao_r1": "Напълно съгласен",
      "ao_r2": "Съгласен",
      "ao_r3": "Нито съгласен, нито несъгласен",
      "ao_r4": "Несъгласен",
      "ao_r5": "Напълно несъгласен",
      "debrief": "Благодарим ви за попълването на този въпросник."
    },
    "cs": {
      "ao_head": "KARTA 16",
      "accalaw": "Do jaké míry by pro vás bylo přijatelné, kdyby Česká republika měla silného lídra, který stojí nad zákonem? Odpovězte mi prosím s použitím této karty, kde 0 znamená zcela nepřijatelné a 10 zcela přijatelné.",
      "ao_acc_lo": "Zcela nepřijatelné",
      "ao_acc_hi": "Zcela přijatelné",
      "ao_head2": "PŘEDLOŽTE KARTU 17 S použitím této karty prosím řekněte, do jaké míry souhlasíte, či nesouhlasíte s každým z následujících výroků. ČTĚTE NAHLAS KAŽDÝ VÝROK",
      "imobed": "Poslušnost a respekt k autoritě jsou nejdůležitější hodnoty, které by se děti měly naučit.",
      "loylead": "To, co Česká republika nejvíce potřebuje, je loajalita ke svým lídrům.",
      "ao_r1": "Rozhodně souhlasím",
      "ao_r2": "Souhlasím",
      "ao_r3": "Ani souhlas, ani nesouhlas",
      "ao_r4": "Nesouhlasím",
      "ao_r5": "Rozhodně nesouhlasím",
      "debrief": "Děkujeme za vyplnění tohoto dotazníku."
    },
    "et": {
      "ao_head": "KAART 16",
      "accalaw": "Kui vastuvõetav see Teile oleks, kui Eestil oleks tugev juht, kes on seadusest kõrgemal? Vastus valige kaardilt 16, kus 0 tähendab üldse mitte vastuvõetav ja 10 tähendab täiesti vastuvõetav.",
      "ao_acc_lo": "Üldse mitte vastuvõetav",
      "ao_acc_hi": "Täiesti vastuvõetav",
      "ao_head2": "KAART 17 Kasutades kaarti 17, öelge palun, mil määral Te nõustute või ei nõustu järgnevate väidetega. LUGEGE ETTE IGA VÄIDE",
      "imobed": "Sõnakuulikkus ja austus autoriteedi vastu on kõige tähtsamad väärtused, mida lapsed peaksid õppima.",
      "loylead": "See, mida Eesti kõige rohkem vajab, on lojaalsus oma juhtidele.",
      "ao_r1": "Olen täiesti nõus",
      "ao_r2": "Olen nõus",
      "ao_r3": "Ei ole nõus ega ole vastu",
      "ao_r4": "Ei ole nõus",
      "ao_r5": "Ei ole üldse nõus",
      "debrief": "Täname teid selle küsimustiku täitmise eest."
    },
    "ru": {
      "ao_head": "КАРТОЧКА 16",
      "accalaw": "Насколько приемлемо для Вас, чтобы в [Эстонии] был сильный лидер, стоящий выше закона? Выберите свой ответ на этой карточке 16, где 0 означает «совсем неприемлемо», а 10 – «полностью приемлемо».",
      "ao_acc_lo": "Совершенно неприемлемо",
      "ao_acc_hi": "Полностью приемлемо",
      "ao_head2": "Используя карточку 17, пожалуйста скажите, насколько Вы согласны или не согласны со следующими утверждениями. ЗАЧИТАЙТЕ КАЖДОЕ УТВЕРЖДЕНИЕ",
      "imobed": "Послушание и уважение к авторитету – это самые важные ценности, которые дети должны усвоить.",
      "loylead": "Что больше всего нужно Эстонии – это лояльность по отношению к своим лидерам.",
      "ao_r1": "Совершенно согласен(на)",
      "ao_r2": "Согласен(на)",
      "ao_r3": "Ни согласен(на), ни против этого",
      "ao_r4": "Не согласен(на)",
      "ao_r5": "Совершенно не согласен(на)",
      "debrief": "Благодарим вас за заполнение этого вопросника."
    },
    "fi": {
      "ao_head": "KORTTI 16",
      "accalaw": "Kuinka hyväksyttävää sinulle olisi, että Suomella olisi vahva johtaja, joka on lain yläpuolella?",
      "ao_acc_lo": "Ei lainkaan hyväksyttävää",
      "ao_acc_hi": "Täysin hyväksyttävää",
      "ao_head2": "KORTTI 17 Käytä tätä korttia ja kerro, missä määrin olet samaa tai eri mieltä seuraavien väittämien kanssa. LUE…",
      "imobed": "Tottelevaisuus ja auktoriteettien kunnioittaminen ovat tärkeimmät arvot, jotka lasten tulisi oppia.",
      "loylead": "Eniten Suomi tarvitsee uskollisuutta päättäjiä kohtaan.",
      "ao_r1": "Täysin samaa mieltä",
      "ao_r2": "Samaa mieltä",
      "ao_r3": "En samaa enkä eri mieltä",
      "ao_r4": "Eri mieltä",
      "ao_r5": "Täysin eri mieltä",
      "debrief": "Kiitos kyselylomakkeen täyttämisestä."
    },
    "fr": {
      "ao_head": "LISTE 16",
      "accalaw": "Dans quelle mesure serait-il acceptable pour vous que la France ait un leader politique fort qui soit au-dessus des lois ? Choisissez votre réponse sur cette liste où 0 signifie pas du tout acceptable et 10 tout à fait acceptable.",
      "ao_acc_lo": "Pas du tout acceptable",
      "ao_acc_hi": "Tout à fait acceptable",
      "ao_head2": "À l'aide de cette liste de réponses, dites-moi dans quelle mesure vous êtes d'accord ou non avec chacune des propositions suivantes.",
      "imobed": "L'obéissance et le respect de l'autorité sont les valeurs les plus importantes que les enfants doivent apprendre.",
      "loylead": "Ce dont la France a le plus besoin, c'est de loyauté envers ses leaders politiques.",
      "ao_r1": "Tout à fait d'accord",
      "ao_r2": "Plutôt d'accord",
      "ao_r3": "Ni d'accord, ni pas d'accord",
      "ao_r4": "Plutôt pas d'accord",
      "ao_r5": "Pas du tout d'accord",
      "debrief": "Merci d'avoir complété ce questionnaire."
    },
    "el": {
      "ao_head": "ΚΑΡΤΑ 16",
      "accalaw": "Πόσο αποδεκτό θα ήταν για εσάς η Ελλάδα να έχει έναν ισχυρό ηγέτη που να είναι υπεράνω του νόμου; Επιλέξτε την απάντησή σας από αυτήν την κάρτα όπου το 0 σημαίνει καθόλου αποδεκτό και το 10 σημαίνει απόλυτα αποδεκτό.",
      "ao_acc_lo": "Καθόλου αποδεκτό",
      "ao_acc_hi": "Απόλυτα αποδεκτό",
      "ao_head2": "Χρησιμοποιώντας αυτήν την κάρτα, πείτε μου σε ποιο βαθμό συμφωνείτε ή διαφωνείτε με την καθεμία από τις παρακάτω δηλώσεις. ΔΙΑΒΑΣΤΕ ΔΥΝΑΤΑ ΚΑΘΕ ΑΠΟΨΗ",
      "imobed": "Η υπακοή και ο σεβασμός προς την εξουσία είναι οι πιο σημαντικές αξίες που πρέπει να μάθουν τα παιδιά.",
      "loylead": "Αυτό που χρειάζεται περισσότερο η Ελλάδα είναι αφοσίωση προς τους ηγέτες της.",
      "ao_r1": "Συμφωνώ απόλυτα",
      "ao_r2": "Συμφωνώ",
      "ao_r3": "Ούτε συμφωνώ ούτε διαφωνώ",
      "ao_r4": "Διαφωνώ",
      "ao_r5": "Διαφωνώ απόλυτα",
      "debrief": "Σας ευχαριστούμε για τη συμπλήρωση αυτού του ερωτηματολογίου."
    },
    "hr": {
      "ao_head": "KARTICA 16",
      "accalaw": "Koliko bi vama bilo prihvatljivo da Hrvatska ima jakog vođu koji je iznad zakona? Odaberite odgovor s ove kartice na kojoj 0 znači da vam to uopće nije prihvatljivo, a 10 da vam je to u potpunosti prihvatljivo.",
      "ao_acc_lo": "Uopće nije prihvatljivo",
      "ao_acc_hi": "U potpunosti je prihvatljivo",
      "ao_head2": "KARTICA 17 Koristeći se ovom karticom, recite u kojoj se mjeri slažete ili ne slažete sa svakom od sljedećih tvrdnji. PROČITAJTE NAGLAS SVAKU TVRDNJU",
      "imobed": "Poslušnost i poštivanje autoriteta najvažnije su vrijednosti koje djeca trebaju naučiti.",
      "loylead": "Ono što Hrvatskoj najviše treba je odanost njezinim vođama.",
      "ao_r1": "U potpunosti se slažem",
      "ao_r2": "Slažem se",
      "ao_r3": "Niti se slažem niti ne slažem",
      "ao_r4": "Ne slažem se",
      "ao_r5": "Uopće se ne slažem",
      "debrief": "Hvala vam što ste ispunili ovaj upitnik."
    },
    "hu": {
      "ao_head": "16. KÁRTYALAP",
      "accalaw": "Mennyire tartja elfogadhatónak, hogy Magyarországnak erős vezetője legyen, aki a törvények felett áll? Kérem, válaszoljon a 16. kártyalap segítségével, amelyen a „0” azt jelenti, hogy egyáltalán nem elfogadható, a „10” pedig azt, hogy teljes mértékben elfogadható.",
      "ao_acc_lo": "Egyáltalán nem elfogadható",
      "ao_acc_hi": "Teljes mértékben elfogadható",
      "ao_head2": "Kérem mondja meg, hogy milyen mértékben ért vagy nem ért egyet a következő kijelentésekkel. Kérem, használja a 17. kártyalapot! MINDEGYIK ÁLLÍTÁST OLVASD FEL",
      "imobed": "Az engedelmesség és a tekintély tisztelete a legfőbb érték, amit egy gyermeknek meg kell tanulnia.",
      "loylead": "Magyarországnak arra van leginkább szüksége, hogy az emberek lojálisak legyenek az ország vezetőihez.",
      "ao_r1": "teljesen egyetértek",
      "ao_r2": "egyetértek",
      "ao_r3": "egyet is értek, meg nem is",
      "ao_r4": "nem értek egyet",
      "ao_r5": "egyáltalán nem értek egyet",
      "debrief": "Köszönjük, hogy kitöltötte ezt a kérdőívet."
    },
    "is": {
      "ao_head": "SPJALD 16",
      "accalaw": "Hversu sátt/-ur værir þú við að Ísland væri undir stjórn öflugs leiðtoga sem væri hafinn yfir lög? Veldu svar þitt af þessu spjaldi þar sem 0 þýðir að þú værir alls ekki sátt/-ur og 10 þýðir að þú værir fullkomlega sátt/-ur.",
      "ao_acc_lo": "Alls ekki sátt/-ur",
      "ao_acc_hi": "Fullkomlega sátt/-ur",
      "ao_head2": "SPJALD 17 Hversu sammála eða ósammála ert þú fullyrðingunum á þessu spjaldi. LESA UPP HVERJA FULLYRÐINGU",
      "imobed": "Hlýðni og virðing fyrir yfirvöldum eru mikilvægustu gildin sem börn ættu að læra.",
      "loylead": "Það sem Ísland þarfnast mest er hollusta við þá sem stjórna landinu.",
      "ao_r1": "Mjög sammála",
      "ao_r2": "Sammála",
      "ao_r3": "Hvorki sammála né ósammála",
      "ao_r4": "Ósammála",
      "ao_r5": "Mjög ósammála",
      "debrief": "Þakka þér fyrir að fylla út þennan spurningarlista."
    },
    "ar": {
      "ao_head": "بطاقة 16",
      "accalaw": "إلى أي مدى يكون مقبول عليك أن يكون لإسرائيل قائد قوي فوق القانون؟",
      "ao_acc_lo": "غير مقبول بتاتاً",
