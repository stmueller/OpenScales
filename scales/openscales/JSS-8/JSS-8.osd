{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "JSS-8",
      "name": "Justice Sensitivity Short Scales–8 (JSS-8)",
      "abbreviation": "JSS-8",
      "description": "8-item English-language adaptation measuring justice sensitivity from four perspectives with two items each: victim, observer, beneficiary, and perpetrator sensitivity. All items positively keyed (no reverse). 6-point scale with no neutral midpoint. Subscale score is the mean of its two items; a total across perspectives is not recommended.",
      "citation": "Groskurth, K., Beierlein, C., Nießen, D., Baumert, A., Rammstedt, B., & Lechner, C. M. (2024). Justice Sensitivity Short Scales–8 (JSS-8). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis337_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis337_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Justice-Sensitivity-Short-Scales-8-(JSS-8)",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English-language adaptation of the German USS-8 (Baumert/Beierlein et al., 2014). 6-point apply scale with NO neutral midpoint (endpoints labeled, middle points unlabeled). All items positively keyed; none reverse-keyed. Score each of the four sensitivity perspectives as the mean of its two items; a total across perspectives is NOT recommended."
    },
