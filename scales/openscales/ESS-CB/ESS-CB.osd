{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-CB",
      "name": "Conspiracy Beliefs Battery (ESS)",
      "abbreviation": "ESS-CB",
      "description": "3-item measure of conspiracy beliefs from the ESS Round 10 COVID module. Two items tap generic conspiracy mentality (secret group controlling world politics; scientists suppressing evidence) and one item taps a COVID-specific conspiracy belief (coronavirus as deliberate effort). Higher scores indicate stronger conspiracy beliefs.",
      "citation": "ESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items K1, K2, K16 from ESS10 GB source questionnaire (COVID module). ESS variable names used as item IDs. Raw ESS coding: 1=Agree strongly (more conspiratorial), 5=Disagree strongly. For an intuitive conspiracy score (higher=more conspiratorial), items are reverse-coded in scoring (code=-1, plus constant). gvconc19 (K16) is COVID-event-specific and may feel anachronistic in non-pandemic contexts — consider omitting or flagging as context-dependent."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "labels": [
        "cb_r1",
        "cb_r2",
        "cb_r3",
        "cb_r4",
        "cb_r5"
      ]
    },
    "dimensions": [
      {
        "id": "generic",
        "name": "Generic Conspiracy Mentality",
        "description": "Belief in secret groups controlling world events and scientists suppressing evidence. Items: secgrdec, scidecpb."
      },
      {
        "id": "total",
        "name": "Conspiracy Beliefs",
        "description": "Mean of all 3 items recoded so higher = more conspiratorial. Range 1–5."
      }
    ],
    "items": [
      {
        "id": "secgrdec",
        "type": "likert",
        "text_key": "secgrdec",
        "dimension": "generic",
        "question_head": "cb_head"
      },
      {
        "id": "scidecpb",
        "type": "likert",
        "text_key": "scidecpb",
        "dimension": "generic",
        "question_head": "cb_head"
      },
      {
        "id": "gvconc19",
        "type": "likert",
        "text_key": "gvconc19",
        "dimension": "total",
        "question_head": "cb_head"
      }
    ],
    "scoring": {
      "_note": "Raw coding: 1=Agree strongly=most conspiratorial. All items coded -1 (reverse) so that higher score = more conspiratorial.",
      "generic": {
        "method": "mean_coded",
        "description": "Mean of secgrdec and scidecpb, recoded so higher = more conspiratorial. Range 1–5.",
        "items": {
          "secgrdec": -1,
          "scidecpb": -1
        }
      },
      "total": {
        "method": "mean_coded",
        "description": "Mean of all 3 items recoded so higher = more conspiratorial. Range 1–5.",
        "items": {
          "secgrdec": -1,
          "scidecpb": -1,
          "gvconc19": -1
        }
      }
    },
    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Conspiracy Beliefs Battery (ESS) Report",
      "footer_refs": [
        "ESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no. License: CC BY-SA 4.0.",
        "Scoring: items reverse-coded so higher = more conspiratorial (1–5). gvconc19 is COVID-specific."
      ]
    }
  },
  "translations": {
    "en": {
      "cb_r1": "Agree strongly",
      "cb_r2": "Agree",
      "cb_r3": "Neither agree nor disagree",
      "cb_r4": "Disagree",
      "cb_r5": "Disagree strongly",
      "secgrdec": "A small secret group of people is responsible for making all major decisions in world politics.",
      "scidecpb": "Groups of scientists manipulate, fabricate, or suppress evidence in order to deceive the public.",
      "gvconc19": "Coronavirus is the result of deliberate and concealed efforts of some government or organisation.",
      "debrief": "Thank you for completing this questionnaire.",
      "cb_head": "How much do you agree or disagree with the following statements?"
    },
    "ar": {
      "cb_head": "إلى أي مدى توافق/ين أو لا توافق/ين مع الجمل التالية؟",
      "secgrdec": "مجموعة صغيرة سريّة مسؤولة عن اتخاذ كل القرارات الهامة في السياسة العالمية.",
      "scidecpb": "مجموعة صغيرة من العلماء تقوم بالتلاعب والتلفيق أو إخفاء أدلة من أجل خداع الجماهير.",
      "gvconc19": "فيروس الكورونا هو نتيجة جهود موجهة وخفيّة قامت بها حكومة أو تنظيم ما.",
      "cb_r1": "جداً موافق/ة",
      "cb_r2": "موافق/ة",
      "cb_r3": "لست موافق/ة ولست غير موافق/ة",
      "cb_r4": "غير موافق/ة",
      "cb_r5": "غير موافق/ة بتاتاً",
      "debrief": "شكراً لمشاركتك."
    },
    "at": {
      "cb_head": "Wie sehr stimmen Sie der folgenden Aussage zu oder lehnen diese ab?",
      "secgrdec": "Eine kleine geheime Gruppe von Personen trifft alle wichtigen Entscheidungen in der Weltpolitik.",
      "scidecpb": "Gruppen von Wissenschafterinnen und Wissenschaftern manipulieren, erfinden oder unterdrücken Beweise, um die Öffentlichkeit zu täuschen.",
      "gvconc19": "Das Coronavirus ist das Ergebnis von gezielten und geheimen Machenschaften eines Staates oder einer Organisation.",
      "cb_r1": "Stimme stark zu",
      "cb_r2": "Stimme zu",
      "cb_r3": "Weder noch",
      "cb_r4": "Lehne ab",
      "cb_r5": "Lehne stark ab",
      "debrief": "Vielen Dank für Ihre Teilnahme."
    },
    "bg": {
      "cb_head": "Доколко сте съгласен или не със следните твърдения?",
      "secgrdec": "Важните решения в световната политика се вземат от малка тайна група от хора.",
      "scidecpb": "Групи учени манипулират, измислят или укриват доказателства, за да заблудят обществеността.",
      "gvconc19": "Коронавирусът е резултат от умишлените и скритите усилия на някое правителство или организация.",
      "cb_r1": "Напълно съгласен",
      "cb_r2": "Съгласен",
      "cb_r3": "Нито съгласен, нито несъгласен",
      "cb_r4": "Несъгласен",
      "cb_r5": "Напълно несъгласен",
      "debrief": "Благодарим ви за участието."
    },
    "cs": {
      "cb_head": "Jak moc souhlasíte nebo nesouhlasíte s následujícími tvrzeními?",
      "secgrdec": "Malá tajná skupina lidí je zodpovědná za veškerá důležitá rozhodnutí ve světové politice.",
      "scidecpb": "Skupiny vědců manipulují, falšují, nebo zatajují důkazy, aby oklamali veřejnost.",
      "gvconc19": "Koronavirus je výsledkem záměrného a skrytého úsilí nějaké vlády nebo organizace.",
      "cb_r1": "Rozhodně souhlasím",
      "cb_r2": "Souhlasím",
      "cb_r3": "Ani souhlas, ani nesouhlas",
      "cb_r4": "Nesouhlasím",
      "cb_r5": "Rozhodně nesouhlasím",
      "debrief": "Děkujeme za vaši účast."
    },
    "de": {
      "cb_head": "Wie sehr stimmen Sie den folgenden Aussagen zu oder lehnen diese ab?",
      "secgrdec": "Eine kleine geheime Gruppe von Personen trifft alle wichtigen Entscheidungen in der Weltpolitik.",
      "scidecpb": "Gruppen von Wissenschaftlerinnen und Wissenschaftlern manipulieren, erfinden oder unterdrücken Beweise, um die Öffentlichkeit zu täuschen.",
      "gvconc19": "Das Coronavirus ist das Ergebnis von gezielten und geheimen Machenschaften eines Staates oder einer Organisation.",
      "cb_r1": "Stimme stark zu",
      "cb_r2": "Stimme zu",
      "cb_r3": "Weder noch",
      "cb_r4": "Lehne ab",
      "cb_r5": "Lehne stark ab",
      "debrief": "Vielen Dank für Ihre Teilnahme."
    },
    "et": {
      "cb_head": "Mil määral Te nõustute või ei nõustu järgnevate väidetega?",
      "secgrdec": "Väike salajane rühm inimesi on vastutav kõigi suurte otsuste tegemise eest maailmapoliitikas.",
      "scidecpb": "Teadlaste rühmad manipuleerivad, fabrikeerivad või varjavad tõendeid, et üldsust petta.",
      "gvconc19": "Koroonaviirus on mõne valitsuse või organisatsiooni tahtliku ja varjatud tegevuse tulemus.",
