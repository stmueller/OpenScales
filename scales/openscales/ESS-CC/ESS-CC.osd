{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-CC",
      "name": "Climate Concern Battery (ESS)",
      "abbreviation": "ESS-CC",
      "description": "3-item battery measuring climate change cognition and concern, from the European Social Survey core module (first included as rotating module in ESS8, became core in ESS10). Items tap causal attribution (natural vs. human causes), personal responsibility to reduce climate change (0–10), and worry about climate change (5-point). Due to incompatible response formats the three items are scored separately, not as a composite.",
      "citation": "Poortinga, W., Spence, A., Whitmarsh, L., Capstick, S., & Pidgeon, N. F. (2011). Uncertain climate: An investigation into public scepticism about anthropogenic climate change. Global Environmental Change, 21(3), 1015–1024. https://doi.org/10.1016/j.gloenvcha.2011.03.001\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Environment & Climate"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items C30–C32 from ESS10 GB source questionnaire. ESS variable names used as item IDs. Three incompatible response formats: ccnthum is a 5-point ordered categorical plus a distinct 'climate not happening' skeptic option (coded 0 in ESS, not on the attribution scale); ccrdprs is 0–10; wrclmch is 5-point ordered. No composite total score is computed. ccnthum skeptic response ('I don't think climate change is happening') is presented as option 6 and coded separately."
    },
    "dimensions": [
      {
        "id": "attribution",
        "name": "Causal Attribution",
        "description": "Belief about whether climate change is caused by natural processes, human activity, or both. Item: ccnthum. Range 1–5 (1=entirely natural, 5=entirely human); code 0=skeptic (climate not happening)."
      },
      {
        "id": "responsibility",
        "name": "Personal Responsibility",
        "description": "Felt personal responsibility to reduce climate change. Item: ccrdprs. Range 0–10; higher = greater sense of responsibility."
      },
      {
        "id": "worry",
        "name": "Climate Worry",
        "description": "Degree of worry about climate change. Item: wrclmch. Range 1–5; higher = more worried."
      }
    ],
    "items": [
      {
        "id": "cc_inst",
        "type": "inst",
        "text_key": "cc_inst"
      },
      {
        "id": "ccnthum",
        "type": "multi",
        "text_key": "ccnthum",
        "dimension": "attribution",
        "options": [
          {
            "text_key": "cc_attr1",
            "value": 1
          },
          {
            "text_key": "cc_attr2",
            "value": 2
          },
          {
            "text_key": "cc_attr3",
            "value": 3
          },
          {
            "text_key": "cc_attr4",
            "value": 4
          },
          {
            "text_key": "cc_attr5",
            "value": 5
          },
          {
            "text_key": "cc_attr0",
            "value": 0
          }
        ]
      },
      {
        "id": "ccrdprs",
        "type": "likert",
        "text_key": "ccrdprs",
        "dimension": "responsibility",
        "likert_options": {
          "points": 11,
          "min": 0,
          "labels": [
            "cc_resp_lo",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "cc_resp_hi"
          ]
        }
      },
      {
        "id": "wrclmch",
        "type": "likert",
        "text_key": "wrclmch",
        "dimension": "worry",
        "likert_options": {
          "points": 5,
          "min": 1,
          "labels": [
            "cc_wr1",
            "cc_wr2",
            "cc_wr3",
            "cc_wr4",
            "cc_wr5"
          ]
        }
      }
    ],
    "scoring": {
      "attribution": {
        "method": "mean_coded",
        "description": "ccnthum: 1=entirely natural, 5=entirely human, 0=skeptic (climate not happening). Skeptic response should be excluded or treated as missing for the attribution score. Higher = more human attribution.",
        "items": {
          "ccnthum": 1
        }
      },
      "responsibility": {
        "method": "mean_coded",
        "description": "ccrdprs: 0–10; higher = greater felt responsibility.",
        "items": {
          "ccrdprs": 1
        }
      },
      "worry": {
        "method": "mean_coded",
        "description": "wrclmch: 1–5; higher = more worried.",
        "items": {
          "wrclmch": 1
        }
      }
    },
    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Climate Concern Battery (ESS) Report",
      "footer_refs": [
        "ESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no. License: CC BY-SA 4.0.",
        "Scoring: three separate scores — attribution (1–5; 0=skeptic), responsibility (0–10), worry (1–5). No composite."
      ]
    }
  },
  "translations": {
    "en": {
      "cc_inst": "Now some questions about climate change.",
      "ccnthum": "Do you think that climate change is caused by natural processes, human activity, or both?",
      "cc_attr1": "Entirely by natural processes",
      "cc_attr2": "Mainly by natural processes",
      "cc_attr3": "About equally by natural processes and human activity",
      "cc_attr4": "Mainly by human activity",
      "cc_attr5": "Entirely by human activity",
      "cc_attr0": "I don't think climate change is happening",
      "ccrdprs": "To what extent do you feel a personal responsibility to try to reduce climate change?",
      "cc_resp_lo": "Not at all",
      "cc_resp_hi": "A great deal",
      "wrclmch": "How worried are you about climate change?",
      "cc_wr1": "Not at all worried",
      "cc_wr2": "Not very worried",
      "cc_wr3": "Somewhat worried",
      "cc_wr4": "Very worried",
      "cc_wr5": "Extremely worried",
      "debrief": "Thank you for completing this questionnaire."
    },
    "ar": {
      "cc_inst": "شكراً لإجاباتك على أسئلتنا حتى هذه المرحلة. والآن بعض الأسئلة عن مواضيع أخرى.",
      "ccnthum": "هل تعتقد/ين أنّ التغيير المناخي هو بسبب عمليات طبيعية، أم هو ناتج عن النشاط البشري، أم كليهما؟",
      "cc_attr1": "بسبب عمليّات طبيعيّة بالكامل",
      "cc_attr2": "بسبب عمليّات طبيعيّة بشكل رئيسيّ",
      "cc_attr3": "بقدر متساوٍ بسبب عمليات طبيعية وبسبب تصرفات البشر",
      "cc_attr4": "بسبب تصرفات البشر باألساس",
      "cc_attr5": "بسبب تصرفات البشر بالكامل",
      "cc_attr0": "أنا لا أعتقد أن هنالك تغيير بالمناخ",
      "ccrdprs": "إلى أي مدى تشعر/ين بأن محاولة التقليل من تغييرات المناخ هي بمثابة مسؤولية شخصية؟",
      "cc_resp_lo": "بتاتاً لا",
      "cc_resp_hi": "بدرجة كبيرة جداً",
      "wrclmch": "إلى أي مدى أنت قلق/ة من تغييرات المناخ؟",
      "cc_wr1": "غير قلق/ة بالمرة",
      "cc_wr2": "غير قلق/ة كثيراً",
      "cc_wr3": "قلق/ة إلى حدٍّ ما",
      "cc_wr4": "قلق/ة جداً",
      "cc_wr5": "قلق/ة للغاية",
      "debrief": "نشكرك جزيل الشكر على تعبئة الاستمارة - نحن نقدّر جداً تكريسك الوقت لذلك."
    },
    "at": {
      "cc_inst": "Nun einige Fragen zu anderen Themen.",
      "ccnthum": "Denken Sie, dass der Klimawandel durch natürliche Prozesse, durch menschliches Handeln oder durch beides verursacht wird?",
      "cc_attr1": "Nur durch natürliche Prozesse",
      "cc_attr2": "Vor allem durch natürliche Prozesse",
      "cc_attr3": "Zu gleichen Teilen durch natürliche Prozesse und menschliches Handeln",
      "cc_attr4": "Vor allem durch menschliches Handeln",
      "cc_attr5": "Nur durch menschliches Handeln",
      "cc_attr0": "Ich denke nicht, dass ein Klimawandel stattfindet",
      "ccrdprs": "Wie sehr fühlen Sie sich persönlich verantwortlich, den Klimawandel zu reduzieren?",
      "cc_resp_lo": "Überhaupt nicht",
      "cc_resp_hi": "Sehr stark",
      "wrclmch": "Wie besorgt sind Sie über den Klimawandel?",
      "cc_wr1": "Überhaupt nicht besorgt",
      "cc_wr2": "Nicht sehr besorgt",
      "cc_wr3": "Etwas besorgt",
      "cc_wr4": "Sehr besorgt",
      "cc_wr5": "Äußerst besorgt",
      "debrief": "Vielen Dank, dass Sie diese Umfrage ausgefüllt haben - wir wissen es wirklich zu schätzen, dass Sie sich die Zeit dafür nehmen."
    },
    "bg": {
      "cc_inst": "А сега няколко въпроса на друга тема.",
      "ccnthum": "Смятате ли, че изменението на климата се дължи на естествени процеси, на човешка дейност или и на двете?",
      "cc_attr1": "Изцяло на естествени процеси",
      "cc_attr2": "Предимно на естествени процеси",
      "cc_attr3": "В еднаква степен на естествени процеси и на човешка дейност",
      "cc_attr4": "Предимно на човешка дейност",
      "cc_attr5": "Изцяло на човешка дейност",
      "cc_attr0": "Не смятам, че има изменение на климата",
      "ccrdprs": "До каква степен чувствате лична отговорност да се опитате да намалите климатичните промени?",
      "cc_resp_lo": "Изобщо не",
      "cc_resp_hi": "В много голяма степен",
      "wrclmch": "Доколко сте разтревожени от климатичните промени?",
      "cc_wr1": "Изобщо не съм разтревожен",
      "cc_wr2": "Не съм много разтревожен",
      "cc_wr3": "Донякъде съм разтревожен",
      "cc_wr4": "Много съм разтревожен",
      "cc_wr5": "Изключително съм разтревожен",
      "debrief": "БЛАГОДАРЯ ВИ!"
    },
    "cnr": {
      "cc_inst": "Sada ću postaviti neka pitanja na drugu temu.",
      "ccnthum": "Da li smatrate da klimatske promjene nastaju djelovanjem prirode, čovjeka ili oboje?",
      "cc_attr1": "U potpunosti zbog prirodnih procesa",
      "cc_attr2": "Uglavnom zbog prirodnih procesa",
      "cc_attr3": "Otprilike podjednako zbog prirodnih procesa kao i zbog ljudskih aktivnosti",
      "cc_attr4": "Uglavnom zbog ljudskih aktivnosti",
      "cc_attr5": "U potpunosti zbog ljudskih aktivnosti",
      "cc_attr0": "Ne smatram da se klimatske promjene dešavaju",
      "ccrdprs": "U kojoj mjeri osjećate da ste lično odgovorni da pokušate da se umanje klimatske promjene?",
      "cc_resp_lo": "Ni najmanje",
      "cc_resp_hi": "U velikoj mjeri",
      "wrclmch": "Koliko ste zabrinuti zbog klimatskih promjena?",
      "cc_wr1": "Ni najmanje nijesam zabrinut/a",
      "cc_wr2": "Nijesam puno zabrinut/a",
      "cc_wr3": "Donekle sam zabrinut/a",
      "cc_wr4": "Veoma sam zabrinut/a",
      "cc_wr5": "Izuzetno sam zabrinut/a",
      "debrief": "HVALA VAM NA VREMENU KOJE STE ODVOJILI ZA OVAJ UPITNIK."
    },
    "cs": {
      "cc_inst": "Nyní několik otázek na jiné téma.",
      "ccnthum": "Myslíte si, že je změna klimatu způsobena přírodními procesy, lidskou činností nebo obojím?",
      "cc_attr1": "Výhradně přírodními procesy",
      "cc_attr2": "Zejména přirodními procesy",
      "cc_attr3": "V podobné míře přírodními procesy a lidskou činností",
      "cc_attr4": "Zejména lidskou činností",
      "cc_attr5": "Výhradně lidskou činností",
      "cc_attr0": "Nemyslím si, že dochází ke změně klimatu",
      "ccrdprs": "Do jaké míry se cítíte osobně zodpovědný(á) za snahu o zmírnění změny klimatu?",
      "cc_resp_lo": "Vůbec ne",
      "cc_resp_hi": "Opravdu hodně",
      "wrclmch": "Jak moc se obáváte změny klimatu?",
      "cc_wr1": "Vůbec se neobávám",
      "cc_wr2": "Spíše se neobávám",
      "cc_wr3": "Poněkud se obávám",
      "cc_wr4": "Spíše se obávám",
      "cc_wr5": "Velmi se obávám",
      "debrief": "Přesto děkujeme za vaši pomoc s tímto rozhovorem."
    },
    "de": {
      "cc_inst": "Vielen Dank für die Beantwortung unserer bisherigen Fragen. Nun einige Fragen zu anderen Themen.",
      "ccnthum": "Denken Sie, dass der Klimawandel durch natürliche Prozesse, durch menschliches Handeln oder durch beides verursacht wird?",
      "cc_attr1": "Nur durch natürliche Prozesse",
      "cc_attr2": "Vor allem durch natürliche Prozesse",
      "cc_attr3": "Zu etwa gleichen Teilen durch natürliche Prozesse und menschliches Handeln",
      "cc_attr4": "Vor allem durch menschliches Handeln",
      "cc_attr5": "Nur durch menschliches Handeln",
      "cc_attr0": "Ich denke nicht, dass ein Klimawandel stattfindet",
      "ccrdprs": "Wie sehr fühlen Sie sich persönlich verantwortlich, einen Beitrag zu leisten, damit der Klimawandel reduziert wird?",
      "cc_resp_lo": "Überhaupt nicht",
      "cc_resp_hi": "Sehr stark",
      "wrclmch": "Wie besorgt sind Sie über den Klimawandel?",
      "cc_wr1": "Überhaupt nicht besorgt",
      "cc_wr2": "Nicht sehr besorgt",
      "cc_wr3": "Etwas besorgt",
      "cc_wr4": "Sehr besorgt",
      "cc_wr5": "Äußerst besorgt",
      "debrief": "Vielen Dank für die Teilnahme an dieser Umfrage - wir danken Ihnen herzlich, dass Sie sich die Zeit dafür genommen haben."
    },
    "el": {
      "cc_inst": "Τώρα μερικές ερωτήσεις για ένα διαφορετικό θέμα.",
      "ccnthum": "Πιστεύετε ότι η κλιματική αλλαγή προκαλείται από φυσικές διεργασίες, ανθρώπινη δραστηριότητα, ή και τα δύο;",
      "cc_attr1": "Αποκλειστικά από φυσικές διεργασίες",
      "cc_attr2": "Κυρίως από φυσικές διεργασίες",
      "cc_attr3": "Σχεδόν εξίσου από φυσικές διεργασίες και ανθρώπινη δραστηριότητα",
      "cc_attr4": "Κυρίως από ανθρώπινη δραστηριότητα",
      "cc_attr5": "Αποκλειστικά από ανθρώπινη δραστηριότητα",
      "cc_attr0": "Δεν πιστεύω ότι υπάρχει κλιματική αλλαγή",
      "ccrdprs": "Σε ποιο βαθμό αισθάνεστε προσωπική ευθύνη για να προσπαθήσετε να περιορίσετε την κλιματική αλλαγή;",
      "cc_resp_lo": "Καθόλου",
      "cc_resp_hi": "Πολύ",
      "wrclmch": "Πόσο ανήσυχος/η είστε για την κλιματική αλλαγή;",
      "cc_wr1": "Καθόλου ανήσυχος/η",
      "cc_wr2": "Λίγο ανήσυχος/η",
      "cc_wr3": "Αρκετά ανήσυχος/η",
      "cc_wr4": "Πολύ ανήσυχος/η",
      "cc_wr5": "Εξαιρετικά ανήσυχος/η",
      "debrief": "ΣΑΣ ΕΥΧΑΡΙΣΤΟΥΜΕ ΠΟΥ ΑΦΙΕΡΩΣΑΤΕ ΧΡΟΝΟ ΝΑ ΑΠΑΝΤΗΣΕΤΕ ΣΕ ΑΥΤΕΣ ΤΙΣ ΕΡΩΤΗΣΕΙΣ"
    },
    "es": {
      "cc_inst": "Gracias por responder a nuestras preguntas. Ahora algunas preguntas sobre diferentes temas.",
      "ccnthum": "¿Cree usted que el cambio climático se debe a procesos naturales, a la acción humana o a las dos cosas?",
      "cc_attr1": "Únicamente a procesos naturales",
      "cc_attr2": "Sobre todo a procesos naturales",
      "cc_attr3": "Por igual a procesos naturales y a la actividad humana",
      "cc_attr4": "Sobre todo a la actividad humana",
      "cc_attr5": "Únicamente a la acción humana",
      "cc_attr0": "No creo que el cambio climático esté ocurriendo",
      "ccrdprs": "¿En qué medida siente usted la responsabilidad personal de intentar reducir el cambio climático?",
      "cc_resp_lo": "En ninguna medida",
      "cc_resp_hi": "En gran medida",
      "wrclmch": "¿En qué medida está usted preocupado/a por el cambio climático?",
      "cc_wr1": "Nada preocupado/a",
      "cc_wr2": "No muy preocupado/a",
      "cc_wr3": "Algo preocupado/a",
      "cc_wr4": "Muy preocupado/a",
      "cc_wr5": "Extremadamente preocupado/a",
      "debrief": "Gracias por su colaboración."
    },
    "et": {
      "cc_inst": "Nüüd mõned küsimused teistsugusel teemal.",
      "ccnthum": "Kas kliimamuutus on teie arvates põhjustatud looduslikest protsessidest, inimtegevusest või mõlemast?",
      "cc_attr1": "Täielikult looduslikest protsessidest",
      "cc_attr2": "Peamiselt looduslikest protsessidest",
      "cc_attr3": "Umbes võrdselt looduslikest protsessidest ja inimtegevusest",
      "cc_attr4": "Peamiselt inimtegevusest",
      "cc_attr5": "Täielikult inimtegevusest",
      "cc_attr0": "Ma ei arva, et kliimamuutus aset leiaks",
      "ccrdprs": "Mil määral tunnete te isiklikku kohustust püüda kliimamuutust vähendada?",
      "cc_resp_lo": "Üldse mitte",
      "cc_resp_hi": "Suurel määral",
      "wrclmch": "Kuivõrd mures te olete kliimamuutuse pärast?",
      "cc_wr1": "Üldse mitte mures",
      "cc_wr2": "Mitte väga mures",
      "cc_wr3": "Mõnevõrra mures",
      "cc_wr4": "Väga mures",
      "cc_wr5": "Äärmiselt mures",
      "debrief": "Suur tänu teile uuringus osalemast! Sellega on intervjuu lõppenud!"
    },
    "fi": {
      "cc_inst": "Seuraavaksi muutamia kysymyksiä toisesta aiheesta.",
      "ccnthum": "Aiheutuuko ilmastonmuutos mielestäsi luonnonilmiöistä, ihmisen toiminnasta vai molemmista?",
      "cc_attr1": "Yksinomaan luonnonilmiöistä",
      "cc_attr2": "Pääosin luonnonilmiöistä",
      "cc_attr3": "Yhtä paljon luonnonilmiöistä ja ihmisen toiminnasta",
      "cc_attr4": "Pääosin ihmisen toiminnasta",
      "cc_attr5": "Yksinomaan ihmisen toiminnasta",
      "cc_attr0": "Ilmastonmuutosta ei mielestäni ole tapahtumassa",
      "ccrdprs": "Missä määrin sinun pitäisi mielestäsi omalta osaltasi yrittää vähentää ilmastonmuutoksen vaikutuksia?",
      "cc_resp_lo": "Ei lainkaan",
      "cc_resp_hi": "Hyvin paljon",
      "wrclmch": "Kuinka huolestunut olet ilmastonmuutoksesta?",
      "cc_wr1": "En lainkaan huolestunut",
      "cc_wr2": "En kovin huolestunut",
      "cc_wr3": "Jonkin verran huolestunut",
      "cc_wr4": "Erittäin huolestunut",
      "cc_wr5": "Äärimmäisen huolestunut",
      "debrief": "Kiitos vastauksestasi!"
    },
    "fr": {
      "cc_inst": "Voici maintenant quelques questions sur un tout autre sujet.",
      "ccnthum": "Pensez-vous que le changement climatique est dû à des processus naturels, à l'activité humaine ou aux deux ?",
      "cc_attr1": "Uniquement à des processus naturels",
      "cc_attr2": "Principalement à des processus naturels",
      "cc_attr3": "Autant à des processus naturels qu'à l'activité humaine",
      "cc_attr4": "Principalement à l'activité humaine",
      "cc_attr5": "Uniquement à l'activité humaine",
      "cc_attr0": "Je ne pense pas qu'il y ait un changement climatique",
      "ccrdprs": "À quel point estimez-vous qu'il est de votre devoir personnel d'essayer de lutter contre le changement climatique ?",
      "cc_resp_lo": "Pas du tout",
      "cc_resp_hi": "Énormément",
      "wrclmch": "Dans quelle mesure êtes-vous préoccupé·e par le changement climatique ?",
      "cc_wr1": "Pas du tout préoccupé·e",
      "cc_wr2": "Pas très préoccupé·e",
      "cc_wr3": "Assez préoccupé·e",
      "cc_wr4": "Très préoccupé·e",
      "cc_wr5": "Extrêmement préoccupé·e",
      "debrief": "MERCI D'AVOIR PRIS LE TEMPS DE RÉPONDRE À CES QUESTIONS."
    },
    "he": {
      "cc_inst": "תודה שענית לשאלות שלנו עד כה. כעת כמה שאלות בנושאים אחרים.",
      "ccnthum": "האם לדעתך שינוי האקלים נגרם על ידי תהליכים טבעיים, פעילות של בני האדם או שניהם?",
      "cc_attr1": "לחלוטין על ידי תהליכים טבעיים",
