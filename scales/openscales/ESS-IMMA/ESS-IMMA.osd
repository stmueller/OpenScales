    "scoring": {
      "_note": "Admission items: 1=Allow many (most permissive), 4=Allow none (most restrictive). Mean reported as-is; higher=more restrictive. Impact items: 0=negative extreme, 10=positive extreme; higher=more positive evaluation. No composite across subscales recommended.",
      "admission": {
        "method": "mean_coded",
        "description": "Mean of imsmetn, imdfetn, impcntr. Range 1–4; higher = more restrictive admission preference.",
        "items": {
          "imsmetn": 1,
          "imdfetn": 1,
          "impcntr": 1
        }
      },
      "impact": {
        "method": "mean_coded",
        "description": "Mean of imbgeco, imueclt, imwbcnt. Range 0–10; higher = more positive perceived impact of immigration.",
        "items": {
          "imbgeco": 1,
          "imueclt": 1,
          "imwbcnt": 1
        }
      }
    },
