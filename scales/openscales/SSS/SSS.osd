  "translations": {
    "en": {
      "SSS_head": "Please indicate how much you agree or disagree with each of the following statements.",
      "SSS_r1": "Strongly disagree",
      "SSS_r7": "Strongly agree",
      "SSS001": "Science makes me step outside myself to a larger sense of fulfillment.",
      "SSS002": "I have had a \"peak\" experience while engaged in science.",
      "SSS003": "Thinking about science brings me deep joy.",
      "SSS004": "Science helps to show greater meaning in life.",
      "SSS005": "There is an order to science that transcends human thinking.",
      "SSS006": "I have lost track of time while engaged in science.",
      "SSS007": "Science makes me feel deeply connected to everything.",
      "SSS008": "Science reveals the beauty of the world we live in.",
      "SSS009": "All things are connected through science.",
      "SSS010": "Science is a source of spirituality."
    }
  }
