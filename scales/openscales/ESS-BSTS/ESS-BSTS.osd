    "nl": {
      "ppltrst": "Denkt u, in het algemeen, dat de meeste mensen te vertrouwen zijn, of dat je niet voorzichtig genoeg kunt zijn in de omgang met mensen?",
      "bsts_trst_lo": "Je kunt niet voorzichtig genoeg zijn",
      "bsts_trst_hi": "De meeste mensen zijn te vertrouwen",
      "pplfair": "Denkt u dat de meeste mensen zouden proberen misbruik van u te maken als zij daartoe de kans krijgen, of zouden zij proberen eerlijk te zijn?",
      "bsts_fair_lo": "De meeste mensen zouden proberen misbruik van mij te maken",
      "bsts_fair_hi": "De meeste mensen zouden proberen eerlijk te zijn",
