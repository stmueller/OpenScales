{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "AWES",
      "name": "Awe Experience Scale",
      "abbreviation": "AWE-S",
      "description": "30-item self-report measure of awe experience across six dimensions: Time Dilation (5 items), Self-Loss (5 items), Connectedness (5 items), Vastness (5 items), Physiological Changes (5 items), and Need for Accommodation (5 items). Developed and validated by Yaden et al. (2019); factor loadings for the full scale reported in Graziosi et al. (2024).",
      "citation": "Yaden, D. B., Kaufman, S. B., Hyde, E., Chirico, A., Gaggioli, A., Zhang, J. W., & Keltner, D. (2019). The development of the Awe Experience Scale (AWE-S): A multifactorial measure for a complex emotion. Journal of Positive Psychology, 14(4), 474–488. https://doi.org/10.1080/17439760.2018.1484940",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "CC BY 4.0 license confirmed by open-access publication of Graziosi et al. (2024) (https://doi.org/10.1371/journal.pone.0314469), which reproduces all 30 items of the AWE-S (Table 1) under CC BY 4.0.",
      "url": "https://doi.org/10.1080/17439760.2018.1484940",
      "version": "1.0",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-11",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Item texts and factor structure from Table 1 of Graziosi et al. (2024). Items listed in factor-loading order within each dimension. Scoring per original AWE-S: mean of items within each subscale."
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "AWES_r1", "AWES_r2", "AWES_r3", "AWES_r4",
        "AWES_r5", "AWES_r6", "AWES_r7"
      ],
      "question_head": "AWES_head"
    },
    "dimensions": [
      {
        "id": "Time",
        "name": "Time Dilation",
        "description": "Sense of time slowing down during the awe experience. Mean of 5 items, range 1–7."
      },
      {
        "id": "SelfLoss",
        "name": "Self-Loss",
        "description": "Diminished or shrunken sense of self. Mean of 5 items, range 1–7."
      },
      {
        "id": "Connectedness",
        "name": "Connectedness",
        "description": "Sense of oneness and connection to everything and all living things. Mean of 5 items, range 1–7."
      },
      {
        "id": "Vastness",
        "name": "Vastness",
        "description": "Perception of grandeur and something much larger than oneself. Mean of 5 items, range 1–7."
      },
      {
        "id": "PhysioChanges",
        "name": "Physiological Changes",
        "description": "Bodily responses such as goosebumps, chills, and jaw drop. Mean of 5 items, range 1–7."
      },
      {
        "id": "Accommodation",
        "name": "Need for Accommodation",
        "description": "Cognitive challenge in mentally processing the experience. Mean of 5 items, range 1–7."
      }
    ],
    "items": [
      { "id": "AWES001", "type": "likert", "text_key": "AWES001", "dimension": "Time" },
      { "id": "AWES002", "type": "likert", "text_key": "AWES002", "dimension": "Time" },
      { "id": "AWES003", "type": "likert", "text_key": "AWES003", "dimension": "Time" },
      { "id": "AWES004", "type": "likert", "text_key": "AWES004", "dimension": "Time" },
      { "id": "AWES005", "type": "likert", "text_key": "AWES005", "dimension": "Time" },
      { "id": "AWES006", "type": "likert", "text_key": "AWES006", "dimension": "SelfLoss" },
      { "id": "AWES007", "type": "likert", "text_key": "AWES007", "dimension": "SelfLoss" },
      { "id": "AWES008", "type": "likert", "text_key": "AWES008", "dimension": "SelfLoss" },
      { "id": "AWES009", "type": "likert", "text_key": "AWES009", "dimension": "SelfLoss" },
      { "id": "AWES010", "type": "likert", "text_key": "AWES010", "dimension": "SelfLoss" },
      { "id": "AWES011", "type": "likert", "text_key": "AWES011", "dimension": "Connectedness" },
      { "id": "AWES012", "type": "likert", "text_key": "AWES012", "dimension": "Connectedness" },
      { "id": "AWES013", "type": "likert", "text_key": "AWES013", "dimension": "Connectedness" },
      { "id": "AWES014", "type": "likert", "text_key": "AWES014", "dimension": "Connectedness" },
      { "id": "AWES015", "type": "likert", "text_key": "AWES015", "dimension": "Connectedness" },
      { "id": "AWES016", "type": "likert", "text_key": "AWES016", "dimension": "Vastness" },
      { "id": "AWES017", "type": "likert", "text_key": "AWES017", "dimension": "Vastness" },
      { "id": "AWES018", "type": "likert", "text_key": "AWES018", "dimension": "Vastness" },
      { "id": "AWES019", "type": "likert", "text_key": "AWES019", "dimension": "Vastness" },
      { "id": "AWES020", "type": "likert", "text_key": "AWES020", "dimension": "Vastness" },
      { "id": "AWES021", "type": "likert", "text_key": "AWES021", "dimension": "PhysioChanges" },
      { "id": "AWES022", "type": "likert", "text_key": "AWES022", "dimension": "PhysioChanges" },
      { "id": "AWES023", "type": "likert", "text_key": "AWES023", "dimension": "PhysioChanges" },
      { "id": "AWES024", "type": "likert", "text_key": "AWES024", "dimension": "PhysioChanges" },
      { "id": "AWES025", "type": "likert", "text_key": "AWES025", "dimension": "PhysioChanges" },
      { "id": "AWES026", "type": "likert", "text_key": "AWES026", "dimension": "Accommodation" },
      { "id": "AWES027", "type": "likert", "text_key": "AWES027", "dimension": "Accommodation" },
      { "id": "AWES028", "type": "likert", "text_key": "AWES028", "dimension": "Accommodation" },
      { "id": "AWES029", "type": "likert", "text_key": "AWES029", "dimension": "Accommodation" },
      { "id": "AWES030", "type": "likert", "text_key": "AWES030", "dimension": "Accommodation" }
    ],
    "scoring": {
      "Time": {
        "method": "mean_coded",
        "description": "Time Dilation subscale — mean of items 1–5. Range 1–7; higher = stronger time dilation.",
        "items": { "AWES001": 1, "AWES002": 1, "AWES003": 1, "AWES004": 1, "AWES005": 1 }
      },
      "SelfLoss": {
        "method": "mean_coded",
        "description": "Self-Loss subscale — mean of items 6–10. Range 1–7; higher = greater self-loss.",
        "items": { "AWES006": 1, "AWES007": 1, "AWES008": 1, "AWES009": 1, "AWES010": 1 }
      },
      "Connectedness": {
        "method": "mean_coded",
        "description": "Connectedness subscale — mean of items 11–15. Range 1–7; higher = greater connectedness.",
        "items": { "AWES011": 1, "AWES012": 1, "AWES013": 1, "AWES014": 1, "AWES015": 1 }
      },
      "Vastness": {
        "method": "mean_coded",
        "description": "Vastness subscale — mean of items 16–20. Range 1–7; higher = greater perceived vastness.",
        "items": { "AWES016": 1, "AWES017": 1, "AWES018": 1, "AWES019": 1, "AWES020": 1 }
      },
      "PhysioChanges": {
        "method": "mean_coded",
        "description": "Physiological Changes subscale — mean of items 21–25. Range 1–7; higher = stronger physiological response.",
        "items": { "AWES021": 1, "AWES022": 1, "AWES023": 1, "AWES024": 1, "AWES025": 1 }
      },
      "Accommodation": {
        "method": "mean_coded",
        "description": "Need for Accommodation subscale — mean of items 26–30. Range 1–7; higher = greater cognitive challenge.",
        "items": { "AWES026": 1, "AWES027": 1, "AWES028": 1, "AWES029": 1, "AWES030": 1 }
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "Awe Experience Scale (AWE-S) Report",
      "footer_refs": [
        "Yaden, D. B., Kaufman, S. B., Hyde, E., Chirico, A., Gaggioli, A., Zhang, J. W., & Keltner, D. (2019). The development of the Awe Experience Scale (AWE-S): A multifactorial measure for a complex emotion. Journal of Positive Psychology, 14(4), 474–488. https://doi.org/10.1080/17439760.2018.1484940",
        "Graziosi, M., Rohde, J. S., Lake, S., Lucas, P., Kaufman, S. B., & Yaden, D. B. (2024). Developing a short form of the Awe Experience Scale (AWE-SF) in psychedelic samples. PLoS ONE, 19(12). https://doi.org/10.1371/journal.pone.0314469",
        "Six subscales (Time Dilation, Self-Loss, Connectedness, Vastness, Physiological Changes, Need for Accommodation); no total score is specified. Each subscale is the mean of its 5 items."
      ]
    }
  },
  "translations": {
    "en": {
      "AWES_head": "Please indicate how much each statement describes your experience.",
      "AWES_r1": "Strongly disagree",
      "AWES_r2": "Moderately disagree",
      "AWES_r3": "Somewhat disagree",
      "AWES_r4": "Neutral",
      "AWES_r5": "Somewhat agree",
      "AWES_r6": "Moderately agree",
      "AWES_r7": "Strongly agree",
      "AWES001": "I noticed time slowing.",
      "AWES002": "I sensed things momentarily slow down.",
      "AWES003": "I felt my sense of time change.",
      "AWES004": "I experienced the passage of time differently.",
      "AWES005": "I had the sense that moment lasted longer than usual.",
      "AWES006": "I felt that my sense of self was diminished.",
      "AWES007": "I experienced a reduced sense of self.",
      "AWES008": "I felt my sense of self shrink.",
      "AWES009": "I felt my sense of self become somehow smaller.",
      "AWES010": "I felt small compared to everything else.",
      "AWES011": "I experienced a sense of oneness with all things.",
      "AWES012": "I felt a sense of communion with all living things.",
      "AWES013": "I had the sense of being connected to everything.",
      "AWES014": "I had a sense of complete connectedness.",
      "AWES015": "I felt closely connected to humanity.",
      "AWES016": "I perceived something that was much larger than me.",
      "AWES017": "I felt the presence of greatness.",
      "AWES018": "I felt that I was in the presence of something grand.",
      "AWES019": "I experienced something greater than myself.",
      "AWES020": "I perceived vastness.",
      "AWES021": "I had goosebumps.",
      "AWES022": "I gasped.",
      "AWES023": "I had chills.",
      "AWES024": "I felt my jaw drop.",
      "AWES025": "I felt my eyes widen.",
      "AWES026": "I felt challenged to understand the experience.",
      "AWES027": "I found it hard to comprehend the experience in full.",
      "AWES028": "I struggled to take in all that I was experiencing at once.",
      "AWES029": "I felt challenged to mentally process what I was experiencing.",
      "AWES030": "I tried to understand the magnitude of what I was experiencing.",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}
