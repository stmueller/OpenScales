{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-ITS",
      "name": "Institutional Trust Scale (ESS)",
      "abbreviation": "ESS-ITS",
      "description": "7-item measure of trust in political and civic institutions, using core items from the European Social Survey administered since Round 1 (2002). Respondents rate trust in parliament, the legal system, police, politicians, political parties, the European Parliament, and the United Nations on 0–10 scales. Three subscales reflect domestic political trust, order institutions, and supranational trust.",
      "citation": "Torcal, M. (2014). The decline of political trust in Spain and Portugal: Economic performance or political responsiveness? American Behavioral Scientist, 58(12), 1542–1567. https://doi.org/10.1177/0002764214534662\nZmerli, S., & Newton, K. (2008). Social trust and attitudes toward democracy. Public Opinion Quarterly, 72(4), 706–724. https://doi.org/10.1093/poq/nfn054\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items B6–B12 from ESS10 GB source questionnaire. ESS variable names used as item IDs. Country-specific text ([country's] parliament) is parameterized via the 'country' translation key. trstep (European Parliament) and trstun (United Nations) may be less relevant outside European contexts — implementers may omit from total scoring."
    },
    "likert_options": {
      "points": 11,
      "min": 0,
      "question_head": "its_head"
    },
    "dimensions": [
      {
        "id": "domestic_political",
        "name": "Domestic Political Trust",
        "description": "Trust in parliament, politicians, and political parties. Items: trstprl, trstplt, trstprt."
      },
      {
        "id": "order",
        "name": "Order Institutions Trust",
        "description": "Trust in the legal system and police. Items: trstlgl, trstplc."
      },
      {
        "id": "supranational",
        "name": "Supranational Trust",
        "description": "Trust in the European Parliament and United Nations. Items: trstep, trstun."
      },
      {
        "id": "total",
        "name": "Institutional Trust",
        "description": "Mean of all 7 items. Range 0–10; higher = greater institutional trust."
      }
    ],
    "items": [
