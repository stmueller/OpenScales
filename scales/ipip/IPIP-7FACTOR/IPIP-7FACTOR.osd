  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "section_title_ipip_7factor_agr": "IPIP 7-Factor: Agreeableness",
      "section_title_ipip_7factor_att": "IPIP 7-Factor: Attractiveness",
      "section_title_ipip_7factor_con": "IPIP 7-Factor: Conscientiousness",
      "section_title_ipip_7factor_es": "IPIP 7-Factor: Emotional Stability",
      "section_title_ipip_7factor_ext": "IPIP 7-Factor: Extraversion",
      "section_title_ipip_7factor_int": "IPIP 7-Factor: Intellect",
      "section_title_ipip_7factor_nv": "IPIP 7-Factor: Negative-Valence",
      "ipip_H1100": "Am concerned about others.",
      "ipip_X227": "Am not interested in other people's problems.",
      "ipip_E136": "Feel others' emotions.",
      "ipip_H1067": "Find fault with everything.",
      "ipip_X177": "Have a soft heart.",
      "ipip_H1103": "Insult people.",
      "ipip_H107": "Make people feel at ease.",
      "ipip_H774": "Put people under pressure.",
      "ipip_H1130": "Sympathize with others' feelings.",
      "ipip_H427": "Take advantage of others.",
      "ipip_X110": "Am not highly motivated to succeed.",
      "ipip_E85": "Don't care about dressing nicely.",
      "ipip_E53": "Don't like to get dressed up.",
      "ipip_H555": "Get things done quickly.",
      "ipip_H1273": "Keep improving myself.",
      "ipip_H314": "Keep myself well-groomed.",
      "ipip_X234": "Know that I am not a special person.",
      "ipip_H244": "Like to tidy up.",
      "ipip_H834": "Pay no attention to my appearance.",
      "ipip_H740": "Believe that I am important.",
      "ipip_H871": "Act wild and crazy.",
      "ipip_H870": "Do crazy things.",
      "ipip_H250": "Do things by the book.",
      "ipip_H1413": "Do things in a half-way manner.",
      "ipip_E46": "Jump into things without thinking.",
      "ipip_X118": "Like order.",
      "ipip_H1362": "Pay attention to details.",
      "ipip_X150": "Try to follow the rules.",
