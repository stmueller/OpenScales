    "scoring": {
      "anxiety": {
        "description": "Sum of all items (0-21). Severity: 0-4 minimal, 5-9 mild, 10-14 moderate, 15-21 severe.",
        "method": "sum_coded",
        "items": [
          "gad1",
          "gad2",
          "gad3",
          "gad4",
          "gad5",
          "gad6",
          "gad7"
        ],
        "norms": {
          "thresholds": [
            {
              "min": 0,
              "max": 4,
              "label": "Minimal"
            },
            {
              "min": 5,
              "max": 9,
              "label": "Mild"
            },
            {
              "min": 10,
              "max": 14,
              "label": "Moderate"
            },
            {
              "min": 15,
              "max": 21,
              "label": "Severe"
            }
          ]
        }
      }
    }
