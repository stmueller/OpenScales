{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "RCS",
      "name": "Recycling and Saving Scale",
      "abbreviation": "RCS",
      "description": "10-item scale measuring pro-environmental behaviors across three subscales: Costless Saving Behavior (4 items; low-effort conservation habits), Costly Saving Behavior (2 items; higher-effort conservation habits), and Recycling Cost (4 items; perceived personal cost of recycling, item 10 reverse-scored). All items rated on a 7-point scale (1=Very inconsistent to 7=Very consistent with your actual situation).",
      "citation": "Wei, S., Xu, J., She, S., Wang, Y., & Zhang, Y. (2021). Are recycling people also saving? Costliness matters. Frontiers in Psychology, 11. https://doi.org/10.3389/fpsyg.2020.609371",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2020.609371",
      "version": "1.0",
      "domain": "Environment"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "RCS_r1",
        null,
        null,
        null,
        null,
        null,
        "RCS_r7"
      ],
      "question_head": "RCS_head"
    },
    "dimensions": [
      {
        "id": "CostlessSaving",
        "name": "Costless Saving Behavior",
        "description": "Low-effort everyday conservation habits"
      },
      {
        "id": "CostlySaving",
        "name": "Costly Saving Behavior",
        "description": "Higher-effort conservation behaviors requiring deliberate action"
      },
      {
        "id": "RecyclingCost",
        "name": "Recycling Cost",
        "description": "Perceived personal cost (time, effort, money) associated with recycling behavior"
      }
    ],
    "items": [
      {
        "id": "RCS001",
        "type": "likert",
        "text_key": "RCS001",
        "dimension": "CostlessSaving"
      },
      {
        "id": "RCS002",
        "type": "likert",
        "text_key": "RCS002",
        "dimension": "CostlessSaving"
      },
      {
        "id": "RCS003",
        "type": "likert",
        "text_key": "RCS003",
        "dimension": "CostlessSaving"
      },
      {
        "id": "RCS004",
        "type": "likert",
        "text_key": "RCS004",
        "dimension": "CostlessSaving"
      },
      {
        "id": "RCS005",
        "type": "likert",
        "text_key": "RCS005",
        "dimension": "CostlySaving"
      },
      {
        "id": "RCS006",
        "type": "likert",
        "text_key": "RCS006",
        "dimension": "CostlySaving"
      },
      {
        "id": "RCS007",
        "type": "likert",
        "text_key": "RCS007",
        "dimension": "RecyclingCost"
      },
      {
        "id": "RCS008",
        "type": "likert",
        "text_key": "RCS008",
        "dimension": "RecyclingCost"
      },
      {
        "id": "RCS009",
        "type": "likert",
