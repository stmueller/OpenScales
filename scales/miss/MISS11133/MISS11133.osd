  "translations": {
    "en": {
      "durel_ora": "How often do you attend church, mosque, temple, or other religious meetings?",
      "durel_ora_0": "Never",
      "durel_ora_1": "Once a year or less",
      "durel_ora_2": "A few times a year",
      "durel_ora_3": "A few times a month",
      "durel_ora_4": "Once a week",
      "durel_ora_5": "More than once a week",
      "durel_nora": "How often do you spend time in private religious activities, such as prayer, meditation, or study of religious scriptures?",
      "durel_nora_0": "Never or rarely",
      "durel_nora_1": "A few times a year",
      "durel_nora_2": "A few times a month",
      "durel_nora_3": "A few times a week",
      "durel_nora_4": "Once a day",
      "durel_nora_5": "More than once a day",
      "durel_ir_stem": "How true is each of the following three statements, in describing you?",
      "durel_ir1": "In my life, I experience the presence of the Divine.",
      "durel_ir2": "My religious beliefs are what really lie behind my whole approach to life.",
      "durel_ir3": "I try hard to carry my religion over into all other dealings in life.",
      "durel_ir_1": "Definitely untrue",
      "durel_ir_2": "Somewhat untrue",
      "durel_ir_3": "Neither true nor untrue",
      "durel_ir_4": "Somewhat true",
      "durel_ir_5": "Definitely true",
      "debrief": "Thank you for completing this questionnaire."
    },
    "am": {
      "durel_ora": "ምን ያህል ጊዜ ወደ ቤተ ክርስቲያን፣ መስጊድ፣ ቤተመቅደስ ወይም ወደ ሌላ ሃይማኖታዊ ስብሰባዎች መሄድ ያዘወትራሉ?",
      "durel_ora_0": "ፈጽሞ አልሄድም",
      "durel_ora_1": "በዓመት አንዴ ወይም ከዚያ ያነሰ",
      "durel_ora_2": "በዓመት ጥቂት ጊዜ",
      "durel_ora_3": "በወር ጥቂት ጊዜ",
      "durel_ora_4": "ሳምንታዊ አንዴ",
      "durel_ora_5": "ሳምንታዊ ከአንዴ በላይ",
      "durel_nora": "በግል ሃይማኖታዊ ሂደትዎ ማለትም በፀሎት፣ ስለ ነፍስዎ ጠልቆ በማሰብ፣ ወይም የሃይማኖት መጽሓፍትን በማጥናት ምን ያህል ጊዜ ያጠፋሉ?",
      "durel_nora_0": "ምንም ጊዜ ስለርሱ አላስብም",
      "durel_nora_1": "በዓመት ውስጥ አንዳንድ ጊዜ",
      "durel_nora_2": "በወር ውስጥ አንዳንድ ጊዜ",
      "durel_nora_3": "በሳምንት ውስጥ አንዳንድ ጊዜ",
      "durel_nora_4": "ቀናዊ አንዴ",
      "durel_nora_5": "ቀናዊ ከአንዴ በላይ",
      "durel_ir_stem": "ከዚህ ቀጥለው የሰፈሩት ሶስት መግለጫዎች እርስዎን ምን ያህል ያንጸባርቃሉ ወይም ይገልጻሉ?",
      "durel_ir1": "በሕይወቴ፣ እግዚአብሔር በእኔ ውስጥ እንዳደረ ይሰማኛል።",
      "durel_ir2": "እኔ ስለ ሕይወቴ ሳስብ የሕይወቴን አካሄድ የሚመራው በሃይማነቴ እምነቶች ነው።",
      "durel_ir3": "ሃይማኖቴን ወደ ሌሎቹ ሁሉ ጉዳዩ ለማስፋፋት ጥረት አደርጋለሁ።",
      "durel_ir_1": "ሙሉ በሙሉ ሀሰት ነው",
      "durel_ir_2": "በመጠኑም ቢሆን ሀሰት ነው",
      "durel_ir_3": "ሀሰትም አይደለም እውነትም አይደለም",
      "durel_ir_4": "በመጠኑም ቢሆን እውነት ነው",
      "durel_ir_5": "ሙሉ በሙሉ እውነት ነው"
    },
    "ar": {
      "durel_ora": "كم مرة تذهب الى الكنيسة أوالمسجد أوالمعبد أو غيرها من الاجتماعات الدينية؟",
      "durel_ora_0": "أبداً",
      "durel_ora_1": "مرة في السنة أو أقل",
      "durel_ora_2": "عدة مرات في السنة",
      "durel_ora_3": "بضع مرات في الشهر",
      "durel_ora_4": "مرة في الأسبوع",
      "durel_ora_5": "أكثر من مرة في الأسبوع",
      "durel_nora": "كم تقضي من الوقت في نشاطات دينية خاصة، مثل الصلاة والتأمل، أو دراسة الكتب الدينية؟",
      "durel_nora_0": "أبدا أو نادرا",
      "durel_nora_1": "بضع مرات في السنة",
      "durel_nora_2": "بضع مرات في الشهر",
      "durel_nora_3": "بضع مرات في الأسبوع",
      "durel_nora_4": "مرة واحدة في اليوم",
      "durel_nora_5": "أكثر من مرة في اليوم",
      "durel_ir_stem": "الى أي حد تصح العبارات الثلاثة التالية في وصفك؟",
      "durel_ir1": "في حياتي إختبرت الوجود الإلهي.",
      "durel_ir2": "معتقداتي الدينية لها تأثير حول نظرتي الى الحياة.",
      "durel_ir3": "أحاول جاهداً أن أمارس معتقداتي الدينية في جميع التعاملات الأخرى في الحياة.",
      "durel_ir_1": "بالتأكيد غير صحيح",
      "durel_ir_2": "إلى حد ما غير صحيح",
      "durel_ir_3": "ليس صحيحا وليس خطأ",
      "durel_ir_4": "صحيح نوعا ما",
      "durel_ir_5": "بالتأكيد صحيح"
    },
    "bn": {
      "durel_ora": "আপনি কত ঘন ঘন চার্চ, মসজিদ, মন্দির, বা অন্যান্য ধর্মীয় সমাবেশে যোগ দেন?",
      "durel_ora_0": "কখনোই নয়",
      "durel_ora_1": "বছরে একবার বা তার কম",
      "durel_ora_2": "বছরে অল্প কয়েকবার",
      "durel_ora_3": "মাসে অল্প কয়েকবার",
      "durel_ora_4": "সপ্তাহে একবার",
      "durel_ora_5": "সপ্তাহে একবারের বেশি",
      "durel_nora": "ব্যক্তিগত ধর্মীয় কাজকর্ম, যেমন- প্রার্থনা, মেডিটেশন, বা ধর্মগ্রন্থ পড়ার জন্য আপনি কত ঘন ঘন সময় দেন?",
      "durel_nora_0": "কখনোই নয় অথবা কদাচিৎ",
      "durel_nora_1": "বছরে অল্প কয়েকবার",
      "durel_nora_2": "মাসে অল্প কয়েকবার",
      "durel_nora_3": "সপ্তাহে অল্প কয়েকবার",
      "durel_nora_4": "দিনে একবার",
      "durel_nora_5": "দিনে একবারের বেশি",
      "durel_ir_stem": "আপনাকে বর্ণনা করার ক্ষেত্রে, নিচের তিনটি বিবৃতির প্রতিটি কতটা সত্য?",
      "durel_ir1": "আমার জীবনে, আমি ঈশ্বরের উপস্থিতি টের পাই।",
      "durel_ir2": "আমার ধর্মীয় বিশ্বাসই জীবনের প্রতি আমার সমগ্র ধারণার পেছনে সত্যিকারভাবে কাজ করে।",
      "durel_ir3": "জীবনের প্রতিটি ক্ষেত্র আমার ধর্মকে টেনে আনার জন্য আমি দৃঢ়ভাবে চেষ্টা করি।",
      "durel_ir_1": "সম্পূর্ণভাবে অসত্য",
      "durel_ir_2": "কিছুটা অসত্য",
      "durel_ir_3": "সত্যও নয় আবার অসত্যও নয়",
      "durel_ir_4": "কিছুটা সত্য",
      "durel_ir_5": "সম্পূর্ণভাবে সত্য"
    },
    "de": {
      "durel_ora": "Wie oft gehen Sie in die Kirche, Moschee, Synagoge oder andere religiöse Treffen?",
      "durel_ora_0": "Niemals",
      "durel_ora_1": "Einmal im Jahr oder seltener",
      "durel_ora_2": "Mehrmals pro Jahr",
      "durel_ora_3": "Mehrmals im Monat",
      "durel_ora_4": "Einmal die Woche",
      "durel_ora_5": "Öfter als einmal die Woche",
      "durel_nora": "Wieviel Zeit verwenden Sie auf private religiöse Aktivitäten wie Gebet, Meditation oder der Lektüre religiöser Schriften?",
      "durel_nora_0": "Niemals oder Selten",
      "durel_nora_1": "ein paar Mal im Jahr",
      "durel_nora_2": "ein paar Mal im Monat",
      "durel_nora_3": "ein paar Mal in der Woche",
      "durel_nora_4": "Einmal am Tag",
      "durel_nora_5": "Öfter als einmal am Tag",
      "durel_ir_stem": "Wie wahrheitsgemäß beschreiben Sie die folgenden 3 Aussagen?",
      "durel_ir1": "In meinem Leben spüre ich die Gegenwart des Göttlichen.",
      "durel_ir2": "Meine religiösen Ansichten sind der wahre Hintergrund meines Lebensansatzes.",
      "durel_ir3": "Ich gebe mir große Mühe meine Religion auf alle anderen Bereiche meines Lebens zu übertragen.",
      "durel_ir_1": "Definitiv unwahr",
      "durel_ir_2": "Etwas unwahr",
      "durel_ir_3": "Weder unwahr noch wahr",
      "durel_ir_4": "Etwas wahr",
      "durel_ir_5": "Definitiv wahr"
    },
    "el": {
      "durel_ora": "Πόσο συχνά πηγαίνετε σε εκκλησία, τζαμί, ναό, ή άλλες θρησκευτικές συναντήσεις;",
      "durel_ora_0": "Ποτέ",
      "durel_ora_1": "Μια φορά τον χρόνο ή λιγότερο",
      "durel_ora_2": "Μερικές φορές τον χρόνο",
      "durel_ora_3": "Μερικές φορές το μήνα",
      "durel_ora_4": "Μια φορά την εβδομάδα",
      "durel_ora_5": "Περισσότερες από μια φορές την εβδομάδα",
      "durel_nora": "Πόσο συχνά ξοδεύετε χρόνο σε προσωπικές θρησκευτικές δραστηριότητες, όπως προσευχή, διαλογισμός, ή μελέτη θρησκευτικών κειμένων;",
      "durel_nora_0": "Ποτέ ή σπάνια",
      "durel_nora_1": "Μερικές φορές τον χρόνο",
      "durel_nora_2": "Μερικές φορές τον μήνα",
      "durel_nora_3": "Μερικές φορές την εβδομάδα",
      "durel_nora_4": "Μια φορά την μέρα",
      "durel_nora_5": "Περισσότερες από μια φορά την μέρα",
      "durel_ir_stem": "Πόσο αληθεύουν οι παρακάτω τρεις προτάσεις στην περιγραφή σας;",
      "durel_ir1": "Στην ζωή μου, βιώνω την θεϊκή παρουσία.",
      "durel_ir2": "Οι θρησκευτικές μου πεποιθήσεις είναι αυτές που πραγματικά βρίσκονται πίσω από την προσέγγιση μου για την ζωή.",
      "durel_ir3": "Προσπαθώ πάρα πολύ για να εντάξω την θρησκεία μου σε όλα τα άλλα ζητήματα της ζωής.",
      "durel_ir_1": "Απολύτως αναληθές",
      "durel_ir_2": "Μερικώς αναληθές",
      "durel_ir_3": "Ούτε αληθές ούτε αναληθές",
      "durel_ir_4": "Μερικώς αληθές",
      "durel_ir_5": "Απολύτως αληθές"
    },
    "es": {
      "durel_ora": "¿Cuantas veces asiste a la iglesia, mezquita, o a otras juntas religiosas?",
      "durel_ora_0": "Nunca",
      "durel_ora_1": "Una vez al año o menos",
      "durel_ora_2": "Unas pocas veces al año",
      "durel_ora_3": "Unas pocas veces al mes",
      "durel_ora_4": "Una vez por semana",
      "durel_ora_5": "Mas de una vez por semana",
      "durel_nora": "¿Cuán a menudo pasa tiempo en actividades privadas religiosas, como oración, meditación, o estudio de escrituras religiosas?",
      "durel_nora_0": "Nunca o raramente",
      "durel_nora_1": "Pocas veces al año",
      "durel_nora_2": "Pocas veces al mes",
      "durel_nora_3": "Pocas veces por semana",
      "durel_nora_4": "Una vez al día",
      "durel_nora_5": "Más de una vez al día",
      "durel_ir_stem": "¿Cuán verdadera es cada una de las siguientes declaraciones en describirle a usted?",
      "durel_ir1": "En mi vida, yo experimento la presencia de lo Divino.",
      "durel_ir2": "Mis creencias religiosas son lo que realmente esta tras mi punto de vista en la vida.",
      "durel_ir3": "Trato completamente de llevar mi religión hacia todas las otras partes de mi vida.",
      "durel_ir_1": "Definitivamente Falso",
      "durel_ir_2": "Un poco falso",
      "durel_ir_3": "Ni verdadero ni falso",
      "durel_ir_4": "Algo verdadero",
      "durel_ir_5": "Definitivamente verdadero"
    },
    "es-419": {
      "durel_ora": "¿Con qué frecuencia asiste a la iglesia, la mezquita, el templo u otra reunión religiosa?",
      "durel_ora_0": "Nunca",
