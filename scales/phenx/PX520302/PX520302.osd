        "items": {
          "want_cocaine_almost_taste": 1,
          "urge_for_cocaine": 1,
          "use_cocaine_soon_as_possible": 1,
          "could_resist_using_coke": -1,
          "crave_coke": 1,
          "want_to_use_cocaine": 1,
          "no_desire_for_cocaine": -1,
