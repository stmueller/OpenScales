      "cb_r2": "Piekrītu",
      "cb_r3": "Ne piekrītu, ne nepiekrītu",
      "cb_r4": "Nepiekrītu",
      "cb_r5": "Pilnībā nepiekrītu",
      "debrief": "Paldies par dalību."
