{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "5DCR",
      "name": "Five-dimensional curiosity-scale (5DCR)",
      "abbreviation": "5DCR",
      "description": "24-item Five-Dimensional Curiosity Scale Revised measuring six facets of curiosity (four items each): joyous exploration, deprivation sensitivity, stress tolerance, social curiosity (general), social curiosity (covert), and thrill seeking. 7-point describes-me scale. Each subscale score is the mean of its four items; stress tolerance items are reverse-coded. No total is computed.",
      "citation": "Grüning, D. J., & Lechner, C. M. (2022). Five-dimensional curiosity-scale (5DCR). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis319_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis319_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Five-dimensional-curiosity-scale-(5DCR)",
      "version": "1.0",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Five-Dimensional Curiosity Scale Revised (Kashdan et al., 2018/2020). CC BY 4.0 via ZIS; ALSO cite the original publications (https://doi.org/10.1080/00223891.2022.2057318 and https://doi.org/10.1016/j.paid.2020.109836). 7-point describes-me scale (all points labeled). Six 4-item subscales; the four stress-tolerance items are reverse-coded so higher = greater tolerance. Subscale score = mean of its four items; no total score."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "5dcr_r1",
