    "hu": {
      "bfi2xs_r1": "Egyáltalán nem ért egyet",
      "bfi2xs_r2": "Nem ért egyet",
      "bfi2xs_r3": "Egyet is ért, meg nem is",
      "bfi2xs_r4": "Egyetért",
      "bfi2xs_r5": "Teljesen egyetért",
      "bfi2xs1": "Jellemzően csendes vagyok.",
      "bfi2xs2": "Együttérző, jószívű vagyok.",
      "bfi2xs3": "Hajlamos vagyok a szétszórtságra.",
      "bfi2xs4": "Sokat aggódom.",
      "bfi2xs5": "Lenyűgöz a művészet, a zene, vagy az irodalom.",
      "bfi2xs6": "Domináns vagyok, vezetőként viselkedem.",
      "bfi2xs7": "Néha goromba vagyok másokkal.",
      "bfi2xs8": "Nehezen állok neki a feladatoknak.",
      "bfi2xs9": "Sokszor lehangolt, szomorú vagyok.",
      "bfi2xs10": "Nem nagyon érdekelnek az elvont gondolatok.",
