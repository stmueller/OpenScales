{
  "scale_info": {
    "name": "Depressive Symptoms - Geriatric",
    "code": "PX121704",
    "abbreviation": "PX121704",
    "description": "An interviewer- or self-administered questionnaire of 15 yes/no questions to screen for depression in older adults.",
    "domain": "Psychiatric",
    "citation": "Sheikh, J. I., Yesavage, J. A. (1986). Geriatric Depression Scale (GDS): Recent evidence and development of a shorter version. Clinical Gerontology: A Guide to Assessment and Intervention 165-173, NY: The Haworth Press, 1986. Sheikh, J. I., Yesavage, J. A., Brooks, J. O., III, Friedman, L. F., Gratzinger, P., Hill, R. D., ... Crook, T. (1991). Proposed factor structure of the Geriatric Depression Scale. International Psychogeriatrics, 3, 23-28. Yesavage, J. A., Brink, T. L., Rose, T. L., Lum, O., Huang, V., Adey, M. B., & Leirer, V. O. (1983). Development and validation of a geriatric depression screening scale: A preliminary report. Journal of Psychiatric Research, 17, 37-49. [PhenX: https://www.phenxtoolkit.org/protocols/view/121704]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/121704"
  },
