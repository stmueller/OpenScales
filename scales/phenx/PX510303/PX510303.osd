{
  "scale_info": {
    "name": "Patterns of Substance Use - Adolescents",
    "code": "PX510303",
    "abbreviation": "PX510303",
    "description": "The Monitoring the Future (MTF) questions from this module address whether the respondent has ever smoked, drunk alcohol, or used various drugs and assesses the frequency of substance use in the last 30 days and last 12 months.",
    "domain": "Substance Use - Screening & Family History",
    "citation": "There are many peer-reviewed publications about results from the Monitoring the Future (MTF) Study. A list of publications can be found on the MTF website ( http://www.monitoringthefuture.org ). [PhenX: https://www.phenxtoolkit.org/protocols/view/510303]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/510303"
  },
