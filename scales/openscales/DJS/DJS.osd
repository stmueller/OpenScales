{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "DJS",
      "name": "Digital Jealousy Scale",
      "abbreviation": "DJS",
      "description": "9-item scale measuring digital jealousy within romantic relationships — feelings of jealousy, hurt, and surveillance behaviors triggered by a partner's digital interactions with others on social media and messaging platforms. Developed and validated in German and English by Daspe et al. (2022); French validation by Haag & Poirier (2025). Rated on a 6-point scale (1=Strongly disagree to 6=Strongly agree).",
      "citation": "Daspe, M.-È., Arbel, R., Vaillancourt-Morel, M.-P., Lussier, Y., & Bhatt, M. (2022). The Digital Jealousy Scale: Development and validation of a new measure. Psychological Test Adaptation and Development, 3(1), 1–12. https://doi.org/10.1027/2698-1866/a000033",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1027/2698-1866/a000033",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-10",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 6,
      "min": 1,
      "max": 6,
      "labels": ["DJS_r1", "DJS_r2", "DJS_r3", "DJS_r4", "DJS_r5", "DJS_r6"],
      "question_head": "DJS_head"
    },
    "dimensions": [
      {
        "id": "DigitalJealousy",
        "name": "Digital Jealousy",
        "description": "Jealousy, hurt, and monitoring behaviors triggered by a romantic partner's digital interactions with others"
      }
    ],
    "items": [
      { "id": "DJS001", "type": "likert", "text_key": "DJS001", "dimension": "DigitalJealousy" },
      { "id": "DJS002", "type": "likert", "text_key": "DJS002", "dimension": "DigitalJealousy" },
      { "id": "DJS003", "type": "likert", "text_key": "DJS003", "dimension": "DigitalJealousy" },
      { "id": "DJS004", "type": "likert", "text_key": "DJS004", "dimension": "DigitalJealousy" },
      { "id": "DJS005", "type": "likert", "text_key": "DJS005", "dimension": "DigitalJealousy" },
      { "id": "DJS006", "type": "likert", "text_key": "DJS006", "dimension": "DigitalJealousy" },
      { "id": "DJS007", "type": "likert", "text_key": "DJS007", "dimension": "DigitalJealousy" },
      { "id": "DJS008", "type": "likert", "text_key": "DJS008", "dimension": "DigitalJealousy" },
      { "id": "DJS009", "type": "likert", "text_key": "DJS009", "dimension": "DigitalJealousy" }
    ],
    "scoring": {
      "DigitalJealousy": {
        "method": "mean_coded",
        "description": "Mean of all 9 items; higher scores indicate greater digital jealousy in the relationship.",
        "items": {
          "DJS001": 1, "DJS002": 1, "DJS003": 1, "DJS004": 1, "DJS005": 1,
          "DJS006": 1, "DJS007": 1, "DJS008": 1, "DJS009": 1
        }
      }
    }
  },
  "translations": {
    "en": {
      "_translator": "Daspe, M.-È. et al. (2022). https://doi.org/10.1027/2698-1866/a000033",
      "DJS_head": "While carefully reading through the following statements, please think about them in the context of your current relationship or your last steady relationship. Please rate the extent to which you agree with the statements. Note: \"liking\" refers to clicking a button on a social media website to give something a positive rating. Please read each statement so that it corresponds to your partner's sexually preferred gender.",
      "DJS_r1": "Strongly disagree",
      "DJS_r2": "2",
      "DJS_r3": "3",
      "DJS_r4": "4",
      "DJS_r5": "5",
      "DJS_r6": "Strongly agree",
      "DJS001": "It makes me nervous when my partner \"likes\" or leaves a comment on another woman's/man's photograph.",
      "DJS002": "It bothers me when I notice that my partner is texting with other women/men.",
      "DJS003": "It worries me when a new woman/man appears on my partner's friends list.",
      "DJS004": "It is important to me that my partner makes a point of showcasing our relationship on social media (through photos, comments, etc.) so that everyone knows that we are in a relationship.",
      "DJS005": "I feel offended when my partner doesn't \"like\" or leave a comment on a photograph of me.",
      "DJS006": "I feel hurt when my partner texts with other people more than with me.",
      "DJS007": "I feel offended when my partner prevents me from seeing chats, texts etc. that they received from other women/men.",
      "DJS008": "I look over my partner's shoulder when I know they are texting with someone else.",
      "DJS009": "I feel the need to look through my partner's phone for possible chat threads with other women/men."
    },
    "de": {
      "_translator": "Daspe, M.-È. et al. (2022). https://doi.org/10.1027/2698-1866/a000033",
      "DJS_head": "Bitte lesen Sie sich die folgenden Aussagen aufmerksam durch und denken Sie dabei an Ihre aktuelle Partnerschaft bzw. an Ihre letzte feste Partnerschaft. Bitte schätzen Sie ein, inwieweit Sie den Aussagen zustimmen. Wählen Sie zwischen 1 = \"Stimmt überhaupt nicht\" und 6 = \"Stimmt genau\". Bitte beachten Sie, in diesem Fragebogen bezeichnet \"Liken\" den Vorgang, in den sozialen Medien eine Schaltfläche anzuklicken, um eine positive Bewertung abzugeben. Bitte lesen Sie jede Aussage so, dass sie dem sexuell bevorzugten Geschlecht Ihres Partners/Ihrer Partnerin entspricht.",
      "DJS_r1": "Stimmt überhaupt nicht",
      "DJS_r2": "2",
      "DJS_r3": "3",
      "DJS_r4": "4",
      "DJS_r5": "5",
      "DJS_r6": "Stimmt genau",
      "DJS001": "Es macht mich unruhig, wenn mein Partner/meine Partnerin das Foto einer Frau/eines Mannes liked oder kommentiert.",
      "DJS002": "Es macht mir etwas aus, wenn ich merke, dass mein Partner/meine Partnerin mit anderen Frauen/Männern schreibt.",
      "DJS003": "Mich verunsichert es, wenn eine neue Frau/ein neuer Mann als Kontakt in der Freundesliste meines Partners/meiner Partnerin auftaucht.",
      "DJS004": "Es ist mir wichtig, dass mein Partner/meine Partnerin unsere Beziehung in sozialen Netzwerken zur Schau stellt (durch Fotos, Kommentare, etc.), damit jede:r unseren Beziehungsstatus kennt.",
      "DJS005": "Ich fühle mich gekränkt, wenn mein Partner/meine Partnerin ein Foto von mir nicht liked oder kommentiert.",
      "DJS006": "Ich fühle mich verletzt, wenn mein Partner/meine Partnerin mehr mit Anderen schreibt als mit mir.",
      "DJS007": "Ich fühle mich gekränkt, wenn mein Partner/meine Partnerin Chats, Nachrichten etc. mit anderen Frauen/Männern von mir fernhält.",
      "DJS008": "Ich schaue meinem Partner/meiner Partnerin über die Schulter, wenn ich weiß, dass er/sie mit einer anderen Person schreibt.",
      "DJS009": "Ich habe das Bedürfnis, das Handy meines Partners/meiner Partnerin nach möglichen Chatverläufen mit anderen Frauen/Männern zu durchsuchen."
    },
    "fr": {
      "_translator": "Haag, C., & Poirier, C. (2025). https://doi.org/10.1027/2698-1866/a000108",
      "DJS_head": "Lisez attentivement les affirmations suivantes. Considérez-les dans le contexte de votre relation actuelle ou de votre dernière relation stable. Veuillez indiquer pour chaque proposition dans quelle mesure vous êtes d'accord ou non avec celle-ci. NB : \"liker\" fait référence au fait de cliquer sur le bouton \"Like\"/\"j'aime\" (pouce levé) sur les réseaux sociaux pour donner une évaluation positive à quelque chose (vidéos, photos, etc.).",
      "DJS_r1": "Pas du tout d'accord",
      "DJS_r2": "2",
      "DJS_r3": "3",
      "DJS_r4": "4",
      "DJS_r5": "5",
      "DJS_r6": "Tout à fait d'accord",
      "DJS001": "Cela me rend nerveux/se lorsque mon/ma partenaire « like » ou laisse un commentaire sur la photo d'un(e) autre femme/homme que moi.",
      "DJS002": "Cela me dérange quand je remarque que mon/ma partenaire envoie des SMS à d'autres femmes/hommes.",
      "DJS003": "Cela m'inquiète lorsqu'une nouvelle femme/homme apparaît dans la liste d'amis/contacts de mon partenaire.",
      "DJS004": "Il est important pour moi que mon/ma partenaire mette en valeur notre relation sur les réseaux sociaux (à travers des photos, des commentaires, etc.) afin que tout le monde sache que nous sommes en couple.",
      "DJS005": "Je me sens offensé(e) lorsque mon/ma partenaire ne « like » pas ou ne laisse pas de commentaire sur une photo de moi.",
      "DJS006": "Je me sens blessé(e) lorsque mon/ma partenaire envoie plus de SMS à d'autres personnes qu'à moi.",
      "DJS007": "Je me sens offensé(e) lorsque mon/ma partenaire m'empêche de voir les échanges SMS, mails, ou autres qu'il/elle entretient avec d'autres femmes/hommes.",
      "DJS008": "Je jette discrètement un œil par-dessus l'épaule de mon/ma partenaire quand je sais qu'il/elle envoie des SMS à quelqu'un d'autre.",
      "DJS009": "Je ressens le besoin de fouiller dans le téléphone de mon/ma partenaire pour voir s'il/elle échange avec d'autres femmes/hommes."
    }
  }
}
