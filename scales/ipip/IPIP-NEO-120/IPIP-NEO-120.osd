    "da": {
      "ipip_likert_1": "Meget Unøjagtigt",
      "ipip_likert_5": "Meget Nøjagtigt",
      "ipip_likert_2": "Lidt Unøjagtigt",
      "ipip_debrief": "Tak fordi du udfyldte dette spørgeskema.",
      "ipip_likert_3": "Hverken Nøjagtigt Eller Unøjagtigt",
      "ipip_likert_4": "Lidt Nøjagtigt",
      "ipip_question_head": "<h3>Beskriv dig selv</h3><p>Beskriv dig selv, som du generelt er nu; ikke som du ønsker at være fremover. Beskriv dig selv, sådan som du ærligt ser dig selv, i forhold til andre du kender af samme køn og på nogenlunde samme alder. For at du kan beskrive dig selv på en ærlig måde, vil dine svar være fuldstændigt fortrolige. Angiv nøjagtigheden af hvert udsagn, som det gælder for dig, ved hjælp af følgende skala:</p>",
      "ipip_H416": "Bruger andre til at opnå mine egne mål.",
      "ipip_H954": "Føler, at jeg har svært ved at håndtere mange ting.",
      "ipip_X227": "Er ikke interesseret i andres problemer.",
      "ipip_X129": "Har det godt med mig selv.",
      "ipip_X167": "Bruger mindst muligt tid og energi på opgaver.",
      "ipip_X107": "Bliver let stresset.",
      "ipip_X274": "Har let ved at modstå fristelser.",
      "ipip_H1354": "Håndterer opgaver med lethed.",
      "ipip_X87": "Er altid velforberedt.",
      "ipip_X74": "Er ofte nedtrykt.",
      "ipip_H32": "Udstråler glæde.",
      "ipip_H809": "Råber ad folk.",
      "ipip_H42": "Fokuserer på de positive ting i tilværelsen.",
      "ipip_H648": "Undgår kontakt med andre.",
      "ipip_X238": "Nyder at fortabe mig i vilde fantasier.",
      "ipip_X211": "Elsker at læse svære tekster.",
      "ipip_H54": "Er altid i gang m ed noget.",
      "ipip_E156": "Forstår ikke dem, der bliver følelsesladede.",
      "ipip_H549": "Tror generelt, andre vil mig det bedste.",
      "ipip_H1100": "Bekymrer mig om andre.",
      "ipip_H446": "Søger eventyr.",
      "ipip_X14": "Har en livlig fantasi.",
      "ipip_H438": "Elsker spænding.",
      "ipip_text_trust_what_people_say": "Stoler på, hvad andre siger.",
      "ipip_H524": "Forsøger at lede andre.",
      "ipip_E113": "Kan godt lide at slappe af.",
      "ipip_X218": "Ser mig selv som mest venstreorienteret.",
      "ipip_E163": "Kan godt lide at fortabe mig i mine tanker.",
      "ipip_X203": "Er ligeglad med andres følelser.",
      "ipip_H494": "Stiller hindringer i vejen for andre.",
      "ipip_H853": "Tager forhastede beslutninger.",
      "ipip_H755": "Mister let besindelsen.",
      "ipip_H1018": "Bryder mine løfter.",
      "ipip_X83": "Taler med mange forskellige mennesker til fester.",
      "ipip_X15": "Bryder mig ikke om mig selv.",
      "ipip_H79": "Laver en masse i min fritid.",
      "ipip_X112": "Har det godt sammen med andre.",
      "ipip_E35": "Nyder at tage vilde chancer.",
      "ipip_X198": "Snyder for at få et forspring.",
      "ipip_text_break_rules": "Bryder reglerne.",
      "ipip_H640": "Er ofte nede i kulkælderen",
      "ipip_H959": "Bliver let overvældet af begivenheder.",
      "ipip_X115": "Arbejder kun så meget, at jeg lige kan klare mig.",
      "ipip_H312": "Holder mig til traditionerne.",
      "ipip_X79": "Bevarer roen i pressede situationer.",
      "ipip_H453": "Elsker en god fight.",
      "ipip_H656": "Har det kun rart med mine venner.",
      "ipip_H1206": "Arbejder hårdt.",
      "ipip_X184": "Mener ikke, der er noget absolut rigtigt eller forkert.",
      "ipip_text_love_life": "Elsker livet.",
      "ipip_X10": "Lægger sjældent mærke til mine følelsesmæssige reaktioner.",
      "ipip_H2014": "Gør mere, end hvad der forventes af mig.",
      "ipip_X126": "Ser mig selv som mest højreorienteret.",
      "ipip_H862": "Kaster mig ud i ting.",
      "ipip_H1157": "Bekymrer mig om mange ting.",
      "ipip_H948": "Går let i panik.",
      "ipip_H871": "Opfører mig vildt.",
      "ipip_H1103": "Fornærmer folk.",
      "ipip_text_feel_sympathy_for_those_who_are_worse_of": "Føler sympati for dem, der har det værre end mig selv.",
      "ipip_text_leave_my_belongings_around": "Efterlader mine ting rundt omkring.",
      "ipip_H78": "Elsker store fester.",
      "ipip_H334": "Tager føringen.",
      "ipip_H822": "Roder derhjemme.",
      "ipip_H999": "Frygter det værste.",
      "ipip_X251": "Kan styre mine behov",
      "ipip_X259": "Har sympati for de hjemløse.",
      "ipip_H592": "Har svært ved at indlede en samtale.",
      "ipip_H1094": "Har det ofte sjovt.",
      "ipip_X82": "Glemmer tit at sætte tingene på plads igen.",
      "ipip_H650": "Undgår folkemængder.",
      "ipip_H699": "Tager hævn over andre.",
      "ipip_X235": "Bryder mig ikke om at gå på kunstmuseer.",
      "ipip_E105": "Ser det smukke i ting, andre måske ikke lægger mærke til.",
      "ipip_X181": "Spiser og drikker sjældent for meget.",
      "ipip_text_excel_in_what_i_do": "Udmærker mig i de ting, jeg laver.",
      "ipip_X157": "Synes, vi skal slå hårdt ned på kriminalitet.",
      "ipip_X123": "Tror på betydningen af kunst.",
      "ipip_H621": "Har svært ved at gå i gang med opgaver.",
      "ipip_H587": "Foretrækker at være alene.",
      "ipip_X204": "Foretrækker afveksling frem for rutine.",
      "ipip_X23": "Bliver sjældent irriteret.",
      "ipip_H58": "Har altid travlt.",
      "ipip_H761": "Bliver let irriteret.",
      "ipip_H244": "Kan godt lide at rydde op.",
      "ipip_H704": "Holder andre på afstand.",
      "ipip_H976": "Venter på, at andre viser vejen frem.",
      "ipip_X248": "Undgår filosofiske diskussioner.",
      "ipip_text_take_control_of_things": "Tager kontrollen.",
      "ipip_H846": "Handler uden at tænke.",
      "ipip_H746": "Praler med mine gode sider.",
      "ipip_H736": "Mener, jeg er bedre end andre.",
      "ipip_E136": "Fornemmer andres følelser.",
      "ipip_X30": "Foretrækker at holde mig til det, jeg kender.",
      "ipip_H2043": "Har høje tanker om mig selv.",
      "ipip_H427": "Udnytter andre.",
      "ipip_H1333": "Ved, hvordan man får tingene gjort.",
      "ipip_H145": "Fortæller sandheden.",
      "ipip_X92": "Oplever mine følelser intenst.",
      "ipip_H149": "Holder mine løfter.",
      "ipip_H754": "Bliver let vred.",
      "ipip_H113": "Har tillid til andre.",
      "ipip_H1285": "Fuldfører opgaver med success.",
      "ipip_X45": "Bryder mig ikke om poesi.",
      "ipip_H258": "Fører mine planer ud i livet.",
      "ipip_H738": "Er meget glad for mig selv.",
      "ipip_H1186": "Spilder min tid.",
      "ipip_H1195": "Nærer mistillid til andre.",
      "ipip_E166": "Forsøger at lade være med at tænke på de fattige.",
      "ipip_E46": "Springer ud i ting uden at tænke mig om.",
      "ipip_H918": "Bruger ikke tid på andres problemer.",
      "ipip_X71": "Elsker at dagdrømme.",
      "ipip_X209": "Har ikke noget imod komplekse sociale situationer.",
      "ipip_X133": "Går amok med mad og drikke.",
      "ipip_H655": "Er bange for at gøre opmærksom på mig selv.",
      "ipip_X176": "Har svært ved at forstå abstrakte ideer.",
      "ipip_H1108": "Elsker at hjælpe andre.",
      "ipip_H1063": "Bryder mig ikke om forandringer.",
      "ipip_X239": "Er ikke interesseret i teoretiske diskussioner.",
      "ipip_H968": "Er bange for mange ting.",
      "ipip_H29": "Har let ved at få venner."
