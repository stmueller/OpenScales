  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H34": "Am the life of the party.",
      "ipip_X244": "Feel little concern for others.",
      "ipip_X87": "Am always prepared.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_H1276": "Have a rich vocabulary.",
      "ipip_X56": "Don't talk a lot.",
      "ipip_H21": "Am interested in people.",
      "ipip_E141": "Am relaxed most of the time.",
      "ipip_X176": "Have difficulty understanding abstract ideas.",
      "ipip_X112": "Feel comfortable around people.",
      "ipip_H1103": "Insult people.",
      "ipip_H1362": "Pay attention to details.",
      "ipip_H1157": "Worry about things.",
      "ipip_X14": "Have a vivid imagination.",
      "ipip_H154": "Keep in the background.",
      "ipip_H1130": "Sympathize with others' feelings.",
      "ipip_H1467": "Make a mess of things.",
      "ipip_X156": "Seldom feel blue.",
      "ipip_X228": "Am not interested in abstract ideas.",
      "ipip_H16": "Start conversations.",
      "ipip_X227": "Am not interested in other people's problems.",
      "ipip_E119": "Get chores done right away.",
      "ipip_H1313": "Have excellent ideas.",
      "ipip_H1039": "Have little to say.",
      "ipip_X177": "Have a soft heart.",
      "ipip_X82": "Often forget to put things back in their proper place.",
      "ipip_X95": "Get upset easily.",
      "ipip_X272": "Do not have a good imagination.",
      "ipip_X83": "Talk to a lot of different people at parties.",
      "ipip_X165": "Am not really interested in others.",
      "ipip_X118": "Like order.",
      "ipip_H926": "Change my mood a lot.",
      "ipip_X100": "Am quick to understand things.",
      "ipip_X68": "Don't like to draw attention to myself.",
      "ipip_H160": "Take time out for others.",
      "ipip_H1140": "Shirk my duties.",
      "ipip_E92": "Have frequent mood swings.",
      "ipip_H1272": "Use difficult words.",
      "ipip_X78": "Don't mind being the center of attention.",
      "ipip_E136": "Feel others' emotions.",
      "ipip_X179": "Follow a schedule.",
      "ipip_H761": "Get irritated easily.",
      "ipip_X114": "Spend time reflecting on things.",
      "ipip_H661": "Am quiet around strangers.",
      "ipip_H107": "Make people feel at ease.",
      "ipip_X163": "Am exacting in my work.",
      "ipip_X74": "Often feel blue.",
      "ipip_H53": "Am full of ideas.",
      "ipip_H823": "Leave my belongings around.",
      "ipip_H927": "Am easily disturbed."
    },
    "hr": {
      "_translator": "Zvjezdan Penezić (University of Zadar, Croatia); machine translation",
      "ipip_likert_4": "Uglavnom točno",
      "ipip_likert_1": "Posve netočno",
      "ipip_likert_2": "Uglavnom netočno",
      "ipip_debrief": "Hvala vam na sudjelovanju.",
      "ipip_question_head": "<h3>Koliko točno možete opisati sebe?</h3><p>Na sljedećim stranicama nalaze se tvrdnje koje opisuju uobičajeno ponašanje ljudi. Molimo vas da, koristeći se priloženom ljestvicom, procijenite koliko pojedini iskaz vjerno opisuje baš vas.</p>",
      "ipip_likert_5": "Posve točno",
      "ipip_likert_3": "Ni točno ni netočno",
      "ipip_X176": "Teško razumijem apstraktne ideje.",
      "ipip_H16": "Prvi započinjem razgovore.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H926": "Često mijenjam raspoloženja.",
      "ipip_H1467": "Unosim zbrku.",
      "ipip_H1276": "Imam bogat rječnik.",
      "ipip_H1272": "Koristim učene izraze.",
      "ipip_X114": "Provodim vrijeme razmišljajući o stvarima.",
      "ipip_H1313": "Imam izvrsne ideje.",
      "ipip_H661": "Šutljiv(a) sam s nepoznatima.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_H1140": "Izbjegavam obaveze.",
      "ipip_X163": "Posao obavljam točno i precizno.",
      "ipip_X112": "Ugodno se osjećam među ljudima.",
      "ipip_X272": "Nisam maštovit.",
      "ipip_H1103": "Vrijeđam ljude.",
      "ipip_X107": "Lako se uznemirim.",
      "ipip_X14": "Imam živu maštu.",
      "ipip_H53": "Pun(a) sam ideja.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_X83": "Na zabavama razgovaram s mnogo različitih ljudi.",
      "ipip_X68": "Ne volim privlačiti pažnju.",
      "ipip_E92": "Često mijenjam raspoloženja.",
      "ipip_H1039": "Imam malo toga reći.",
      "ipip_X74": "Često sam potišten.",
      "ipip_X165": "Drugi me zapravo i ne zanimaju.",
      "ipip_X100": "Brzo shvaćam različite stvari.",
      "ipip_X179": "Slijedim zacrtani plan.",
      "ipip_E141": "Uglavnom sam opušten.",
      "ipip_H761": "Lako se uzrujam.",
      "ipip_H1130": "Suosjećam s drugima.",
      "ipip_X87": "Uvijek sam pripravan.",
      "ipip_H927": "Lako me zasmetati.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_X82": "Često zaboravljam vratiti stvari na njihovo mjesto.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_X244": "Ne brinem se puno za druge ljude.",
      "ipip_X118": "Volim red.",
      "ipip_X78": "Ne smeta me biti u središtu pažnje.",
      "ipip_E136": "Osjećam tuđe emocije.",
      "ipip_H107": "Nastojim da se drugi osjećaju ugodno.",
      "ipip_H21": "Zanimaju me drugi ljudi.",
      "ipip_H34": "Unosim živost u svaku zabavu.",
      "ipip_H160": "Posvećujem vrijeme drugim ljudima.",
      "ipip_H823": "Ostavljam stvari uokolo.",
      "ipip_X156": "Rijetko sam tužan.",
      "ipip_E119": "Odmah obavljam svakodnevne poslove.",
      "ipip_H154": "Držim se po strani.",
      "ipip_X177": "Imam meko srce.",
      "ipip_H1157": "Zabrinut sam."
    },
    "sl": {
      "_translator": "Boele De Raad & Marko Mlacic (Slovenia); machine translation",
      "ipip_likert_4": "Dokaj točno",
      "ipip_likert_1": "Zelo netočno",
      "ipip_likert_2": "Dokaj netočno",
      "ipip_debrief": "Hvala, ker ste izpolnili ta vprašalnik.",
      "ipip_question_head": "<h3>Kako natančno se lahko opišete?</h3><p>Na naslednjih straneh so trditve, ki opisujejo vedenje ljudi. S pomočjo spodnje lestvice ocenite, kako natančno vsaka trditev opisuje vas. Opišite se, kakršni ste na splošno zdaj, ne kakršni bi želeli biti v prihodnosti. Vaši odgovori bodo ostali zaupni.</p>",
      "ipip_likert_5": "Zelo točno",
      "ipip_likert_3": "Niti točno niti netočno",
      "ipip_X176": "Težko razumem abstraktne pojme.",
      "ipip_H16": "Rad začnem pogovor.",
      "ipip_X95": "Zlahka se razburim.",
      "ipip_H926": "Pogosto spreminjam svoje razpoloženje.",
      "ipip_H1467": "Povzročam zmešnjavo.",
      "ipip_H1276": "Imam bogat besedni zaklad.",
      "ipip_H1272": "Uporabljam zahtevne besede.",
      "ipip_X114": "Veliko časa porabim za razmišljanje.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_H661": "V prisotnosti tujcev sem tih.",
      "ipip_X228": "Ne zanimam se za abstraktne ideje.",
      "ipip_H1140": "Izmikam se dolžnostim.",
      "ipip_X163": "Pri svojem delu sem natančen.",
      "ipip_X112": "V družbi se prijetno počutim.",
      "ipip_X272": "Nimam bujne domišljije.",
      "ipip_H1103": "Žalim ljudi.",
      "ipip_X107": "Hitro postanem preobremenjen.",
      "ipip_X14": "Imam bogato domišljijo.",
      "ipip_H53": "Imam polno idej.",
      "ipip_X227": "Ne zanimam se za probleme drugih ljudi.",
      "ipip_X83": "Na zabavi se rad pogovarjam z veliko različnimi ljudmi.",
      "ipip_X68": "Nerad zbujam pozornost.",
      "ipip_E92": "Moje razpoloženje pogosto niha.",
      "ipip_H1039": "Imam malo za povedati.",
      "ipip_X74": "Pogosto sem otožen.",
      "ipip_X165": "Nisem ravno zainteresiran za druge.",
      "ipip_X100": "Stvari hitro dojemam.",
      "ipip_X179": "Držim se svojega urnika.",
      "ipip_E141": "Večino časa sem sproščen.",
      "ipip_H761": "Zapravljam čas.",
      "ipip_H1130": "Sočustvujem z drugimi.",
      "ipip_X87": "Vedno sem pripravljen.",
      "ipip_H927": "Hitro se zmedem.",
      "ipip_X56": "Ne govorim veliko.",
      "ipip_X82": "Pogosto pozabim pospraviti stvari na svoje mesto.",
      "ipip_H1362": "Pozoren sem na podrobnosti.",
      "ipip_X244": "Ne skrbi me za druge.",
      "ipip_X118": "Rad imam red.",
      "ipip_X78": "Nič nimam proti, če sem v središču pozornosti.",
      "ipip_E136": "Čutim, kaj doživljajo drugi ljudje.",
      "ipip_H107": "Ob meni se ljudje počutijo sproščeni.",
      "ipip_H21": "Zanimam se za druge.",
      "ipip_H34": "Sem gonilna sila zabav.",
      "ipip_H160": "Vzamem si čas za druge.",
      "ipip_H823": "Svoje stvari puščam naokoli.",
      "ipip_X156": "Redko sem potrt.",
      "ipip_E119": "Obveznosti opravim takoj.",
      "ipip_H154": "Držim se v ozadju.",
      "ipip_X177": "Sem »mehkega srca«.",
      "ipip_H1157": "Skrbi me za različne stvari."
    },
    "ru": {
      "_translator": "Valery Chirkov (University of Saskatchewan, Canada); machine translation",
      "ipip_likert_4": "Скорее да, чем нет",
      "ipip_likert_1": "Совсем нет",
      "ipip_likert_2": "Скорее нет, чем да",
      "ipip_debrief": "Благодарим вас за заполнение этого опросника.",
      "ipip_question_head": "<h3>Насколько точно вы можете описать себя?</h3><p>Следующие фразы описывают поведение людей. Пожалуйста, оцените, насколько точно каждое утверждение описывает вас. Описывайте себя так, какие вы есть сейчас, а не какими хотели бы быть. Ваши ответы останутся строго конфиденциальными.</p>",
      "ipip_likert_5": "Да",
      "ipip_likert_3": "Ни да, ни нет",
      "ipip_X176": "Вам сложо понимать абстрактные идеи.",
      "ipip_H16": "Вы часто начинаете разговор сами.",
      "ipip_X95": "Легко расстраиваетесь.",
      "ipip_H926": "Часто меняете настроение.",
      "ipip_H1467": "Создаете беспорядок.",
      "ipip_H1276": "У вас богатый словарный запас.",
      "ipip_H1272": "Используете сложные слова.",
      "ipip_X114": "Останавливаетесь, чтобы обдумать происходяшее.",
      "ipip_H1313": "У вас часто возникают превосходные идеи.",
      "ipip_H661": "Вы мало говорите в кругу незнакомых Вам людей.",
      "ipip_X228": "Вы не интересуетесь абстрактными идеями.",
      "ipip_H1140": "Уклоняетесь от обязанностей.",
      "ipip_X163": "Вы аккуратны в работе.",
      "ipip_X112": "Вы чувствуeте себя комфортно в кругу людей.",
      "ipip_X272": "У вас не очень хорошее воображение.",
      "ipip_H1103": "Вы можете оскорбить.",
      "ipip_X107": "Легко подвергаетесь стрессу.",
      "ipip_X14": "У вас богатое воображение.",
      "ipip_H53": "Полны идей.",
      "ipip_X227": "Вам не интересны проблемы окружающих.",
      "ipip_X83": "Говорите с большим количеством различных людей на вечеринках.",
      "ipip_X68": "Не любите привлекать к себе внимание.",
      "ipip_E92": "Подвержены частым колебаниям настроения.",
      "ipip_H1039": "Вы немногословны.",
      "ipip_X74": "Часто бываете грустны.",
      "ipip_X165": "На самом деле люди вам не интересны.",
      "ipip_X100": "Легко вникаете в суть вещей.",
      "ipip_X179": "Следуете распорядку/плану.",
      "ipip_E141": "Обычно спокойны.",
      "ipip_H761": "Легко раздражитесь.",
      "ipip_H1130": "Сочувствуете чувствам других.",
      "ipip_X87": "Жизнь редко застает Вас врасплох.",
      "ipip_H927": "Вас легко вывести из равновесия.",
      "ipip_X56": "Не говорите много.",
      "ipip_X82": "Часто забываете положить вещи на место.",
      "ipip_H1362": "Обращаете внимание на детали.",
      "ipip_X244": "Вы редко беспокоитесь за других.",
      "ipip_X118": "Любите порядок.",
      "ipip_X78": "Не возражаете быть центром внимания.",
      "ipip_E136": "Чувствуете настроения/ эмоции окружающих.",
      "ipip_H107": "С вами люди чувствуют себя непринужденно.",
      "ipip_H21": "Люди Вам интересны.",
      "ipip_H34": "Вы - душа любой вечеринки.",
      "ipip_H160": "Вы уделяете время другим.",
      "ipip_H823": "Часто разбрасываете вещи.",
      "ipip_X156": "Редко грустите.",
      "ipip_E119": "Работаете эффективно.",
      "ipip_H154": "Держитесь на заднем плане.",
      "ipip_X177": "У вас мягкое сердце.",
      "ipip_H1157": "Часто беспокоитесь."
    },
    "el": {
      "_translator": "Vassilis Pavlopoulos (Athens University, Greece); machine translation",
      "ipip_likert_4": "Κάπως αντιπροσωπευτικό",
      "ipip_likert_1": "Καθόλου αντιπροσωπευτικό",
      "ipip_likert_2": "Λίγο αντιπροσωπευτικό",
      "ipip_debrief": "Σας ευχαριστούμε για τη συμπλήρωση αυτού του ερωτηματολογίου.",
      "ipip_question_head": "<h3>Πώς θα περιγράφατε τον εαυτό σας;</h3><p>Στις σελίδες που ακολουθούν υπάρχουν φράσεις που περιγράφουν συμπεριφορές ανθρώπων. Παρακαλώ χρησιμοποιήστε την παρακάτω κλίμακα για να αξιολογήσετε πόσο αντιπροσωπευτική είναι κάθε πρόταση για εσάς. Περιγράψτε τον εαυτό σας όπως είστε γενικά τώρα, όχι όπως θα θέλατε να είστε στο μέλλον. Οι απαντήσεις σας θα παραμείνουν απολύτως εμπιστευτικές.</p>",
      "ipip_likert_5": "Πολύ αντιπροσωπευτικό",
      "ipip_likert_3": "Δεν μπορώ να αποφασίσω",
      "ipip_X176": "Δυσκολεύομαι να κατανοήσω αφηρημένες ιδέες.",
      "ipip_H16": "Αρχίζω συζητήσεις.",
      "ipip_X95": "Αναστατώνομαι εύκολα.",
      "ipip_H926": "Η διάθεσή μου αλλάζει διαρκώς.",
      "ipip_H1467": "Τα κάνω άνω κάτω.",
      "ipip_H1276": "Έχω ένα πλούσιο λεξιλόγιο.",
      "ipip_H1272": "Χρησιμοποιώ δύσκολες λέξεις.",
      "ipip_X114": "Αφιερώνω χρόνο για να αξιολογώ τα πράγματα (που κάνω).",
      "ipip_H1313": "Έχω εξαιρετικές ιδέες.",
      "ipip_H661": "Είμαι ήσυχος/η όταν βρίσκομαι ανάμεσα σε ξένους.",
      "ipip_X228": "Δεν ενδιαφέρομαι για αφηρημένες ιδέες.",
      "ipip_H1140": "Αποφεύγω αυτά που πρέπει να κάνω (τα καθήκοντά μου).",
      "ipip_X163": "Είμαι ακριβής στη δουλειά μου.",
      "ipip_X112": "Αισθάνομαι άνετα όταν βρίσκομαι ανάμεσα σε ανθρώπους.",
      "ipip_X272": "Δεν έχω καλή φαντασία.",
      "ipip_H1103": "Προσβάλλω τους άλλους.",
      "ipip_X107": "Αγχώνομαι εύκολα.",
      "ipip_X14": "Έχω ζωηρή (ζωντανή) φαντασία.",
      "ipip_H53": "Είμαι γεμάτος/η ιδέες.",
      "ipip_X227": "Δεν ενδιαφέρομαι για τα προβλήματα των άλλων.",
      "ipip_X83": "Μιλώ με πολλούς διαφορετικούς ανθρώπους στα πάρτι.",
      "ipip_X68": "Δεν μου αρέσει να προσελκύω την προσοχή πάνω μου.",
      "ipip_E92": "Έχω συχνές εναλλαγές στη διάθεσή μου.",
      "ipip_H1039": "Έχω ελάχιστα πράγματα να πω.",
      "ipip_X74": "Συχνά αισθάνομαι μελαγχολικά.",
      "ipip_X165": "Δεν ενδιαφέρομαι πραγματικά για τους άλλους ανθρώπους.",
      "ipip_X100": "Είμαι γρήγορος/η στο να καταλαβαίνω πράγματα.",
      "ipip_X179": "Ακολουθώ ένα πρόγραμμα.",
      "ipip_E141": "Είμαι χαλαρός/ή τις περισσότερες φορές.",
      "ipip_H761": "Εκνευρίζομαι εύκολα.",
      "ipip_H1130": "Συμπάσχω με τα συναισθήματα των άλλων.",
      "ipip_X87": "Είμαι πάντοτε προετοιμασμένος.",
      "ipip_H927": "Ενοχλούμαι εύκολα.",
      "ipip_X56": "Δεν μιλώ πολύ.",
      "ipip_X82": "Συχνά ξεχνώ να βάζω τα πράγματα πίσω στη σωστή τους θέση.",
      "ipip_H1362": "Δίνω προσοχή στις λεπτομέρειες .",
      "ipip_X244": "Αισθάνομαι μικρό ενδιαφέρον για τους άλλους.",
      "ipip_X118": "Μου αρέσει η τάξη.",
      "ipip_X78": "Δεν με ενοχλεί να είμαι το επίκεντρο της προσοχής.",
      "ipip_E136": "Αισθάνομαι τα συναισθήματα των άλλων.",
      "ipip_H107": "Κάνω τους ανθρώπους να αισθάνονται άνετα.",
      "ipip_H21": "Ενδιαφέρομαι για τους ανθρώπους.",
      "ipip_H34": "Είμαι η ζωή σε ένα πάρτι.",
      "ipip_H160": "Βρίσκω χρόνο για τους άλλους.",
      "ipip_H823": "Αφήνω τα πράγματά μου ολόγυρα.",
      "ipip_X156": "Σπάνια νοιώθω μελαγχολία.",
      "ipip_E119": "Κάνω τις «αγγαρείες» αμέσως.",
      "ipip_H154": "Προτιμώ να μένω στο παρασκήνιο.",
      "ipip_X177": "Έχω μαλακή καρδιά.",
      "ipip_H1157": "Ανησυχώ για διάφορα πράγματα."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_X176": "Imam poteškoća u razumevanju apstraktnih ideja.",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H926": "Često menjam raspolozenja.",
      "ipip_H1467": "Često pravim nered.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H1272": "Često koristim komplikovane reči.",
      "ipip_X114": "Provodim vreme razmišljajući o stvarima.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_H1140": "Izbegavam svoje obaveze.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_X272": "Nemam bujnu maštu.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_H53": "Pun sam ideja.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_X165": "Nisam preterano zainteresovan za druge.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_H1130": "Saosećam sa drugima.",
      "ipip_X87": "Uvek sam spreman na sve.",
      "ipip_H927": "Lako me je uznemiriti.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_X82": "Često zaboravim da vratim stvari na svoje mesto.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_X244": "Vrlo malo brinem za druge.",
      "ipip_X118": "Volim red.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_E136": "Osećam emocije drugih ljudi.",
      "ipip_H107": "Činim da se ljudi osećaju spokojno.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_H34": "Uvek sam glavni na žurci.",
      "ipip_H160": "Odvajam vreme za druge.",
      "ipip_H823": "Često ostavljam svoje stvari svuda unaokolo.",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_E119": "Svoje obaveze obavljam odmah.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_X177": "Mekog sam srca.",
      "ipip_H1157": "Često sam zabrinut."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_X176": "Har svårt att förstå abstrakta idéer",
      "ipip_H16": "Sätter igång konversationer",
      "ipip_X95": "Blir lätt upprörd",
      "ipip_H926": "Har ett humör som svänger mycket",
      "ipip_H1467": "Skapar oreda omkring mig",
      "ipip_H1276": "Har ett rikt ordförråd",
      "ipip_H1272": "Använder svåra ord",
      "ipip_X114": "Ägnar tid åt att fundera på saker",
      "ipip_H1313": "Har utmärkta idéer",
      "ipip_H661": "Är tyst tillsammans med främlingar",
      "ipip_X228": "Är inte intresserad av abstrakta idéer",
      "ipip_H1140": "Smiter undan mina plikter",
      "ipip_X163": "Är grundlig i mitt arbete",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_X272": "Är fantasilös",
      "ipip_H1103": "Förolämpar folk",
      "ipip_X107": "Blir lätt stressad",
      "ipip_X14": "Har en livlig fantasi",
      "ipip_H53": "Är full av idéer",
      "ipip_X227": "Är inte intresserad av andra människors problem",
      "ipip_X83": "Pratar med en massa olika människor på fester",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_E92": "Har ofta förekommande humörsvängningar",
      "ipip_H1039": "Har lite att säga",
      "ipip_X74": "Känner mig ofta nere",
      "ipip_X165": "Är egentligen inte intresserad av andra",
      "ipip_X100": "Förstår saker snabbt",
      "ipip_X179": "Följer ett schema",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_H761": "Blir lätt irriterad",
      "ipip_H1130": "Sympatiserar med andras känslor",
      "ipip_X87": "Är alltid förberedd",
      "ipip_H927": "Blir lätt störd",
      "ipip_X56": "Pratar inte mycket",
      "ipip_X82": "Glömmer ofta att lägga tillbaka saker på sin plats",
      "ipip_H1362": "Uppmärksammar detaljer",
      "ipip_X244": "Känner mig inte speciellt bekymrad om andra",
      "ipip_X118": "Tycker om ordning",
      "ipip_X78": "Har inte något emot att vara centrum för uppmärksamheten",
      "ipip_E136": "Känner andra människors känslor",
      "ipip_H107": "Får människor att känna sig väl till mods",
      "ipip_H21": "Är intresserad av människor",
      "ipip_H34": "Är den som håller igång på ett party",
      "ipip_H160": "Tar mig tid för andra människor",
      "ipip_H823": "Lämnar mina saker liggande överallt",
      "ipip_X156": "Känner mig sällan nere",
      "ipip_E119": "Gör hushållsarbete genast",
      "ipip_H154": "Håller mig i bakgrunden",
      "ipip_X177": "Har ett gott hjärta",
      "ipip_H1157": "Oroar mig över saker"
    },
    "de": {
      "_translator": "Alois Angleitner, Fritz Ostendorf & Lothar Laux (Germany); machine translation",
      "ipip_likert_4": "Mäßig zutreffend",
      "ipip_likert_1": "Sehr unzutreffend",
      "ipip_likert_2": "Mäßig unzutreffend",
      "ipip_debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens.",
      "ipip_question_head": "<h3>Wie genau können Sie sich selbst beschreiben?</h3><p>Beschreiben Sie sich so, wie Sie im Allgemeinen jetzt sind, nicht wie Sie in Zukunft sein möchten. Beschreiben Sie sich ehrlich, in Bezug auf andere Personen des gleichen Geschlechts und ungefähr Ihres Alters, die Sie kennen. Damit Sie sich ehrlich beschreiben können, werden Ihre Antworten streng vertraulich behandelt. Geben Sie mit der folgenden Bewertungsskala an, wie zutreffend jede Aussage auf Sie zutrifft:</p>",
      "ipip_likert_5": "Sehr zutreffend",
      "ipip_likert_3": "Weder zutreffend noch unzutreffend",
      "ipip_X176": "Ich habe Schwierigkeiten abstrakte Ideen zu verstehen.",
      "ipip_H16": "Ich beginne Unterhaltungen.",
