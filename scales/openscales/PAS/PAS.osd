{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Proactive Attitude Scale",
      "code": "PAS",
      "abbreviation": "PAS",
      "description": "Proactive attitude (Schwarzer). Language variant: the English (8-item, all-positive) and German (8-item, original 1999) versions differ in items and keying; the appropriate version is administered by language. 4-point; mean.",
      "citation": "Schmitz, G. S., & Schwarzer, R. (1999). Proaktive Einstellung von Lehrern. Zeitschrift für Empirische Pädagogik, 13(1), 3-27; English Proactive Attitude Scale (Schwarzer, 1999), http://userpage.fu-berlin.de/~health/",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~gesund/skalen/Proaktive_Einstellung/proaktive_einstellung.htm",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "LANGUAGE VARIANT (variants.sets): English and German are DIFFERENT versions, not 1:1 translations. English = revised 8-item all-positive form (no reverse). German = original 1999 form with reverse items 3,5,8 ('Mein Leben wird... durch Sachzwänge bestimmt', 'Ich fühle mich... bevormundet', 'Ich warte lieber darauf...'). Each language administers its own validated item set; scoring recodes the German reverse items. Single dimension. Added Brazilian Portuguese variant (Atitude Proativa, Schwarzer & Bellico da Costa 1999): a 15-item longer form (the 8 core positive items plus 7 reverse-keyed items); reverse pt-BR items 2,5,8,9,11,14. Distinct item set from en/de, administered by language via variants.sets. Added Spanish (Actitud Proactiva, Schwarzer & Gutiérrez 1999 — 8-item all-positive, shares the English set) and European Portuguese (Atitude Proactiva, Nunes & Schwarzer 1999 — 15-item, shares the pt-BR set; reverse 2,5,8,9,11,14)."
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "max": 4,
      "labels": [
        "r1",
        "r2",
        "r3",
        "r4"
      ],
      "question_head": "qh"
    },
