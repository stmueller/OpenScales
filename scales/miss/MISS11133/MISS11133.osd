    "fa": {
      "durel_ora": "چند وقت يكبار به مسجد، كليسا، عبادتگاه، يا جلسات ديگر مذهبي مي‌رويد؟",
      "durel_ora_0": "هرگز",
      "durel_ora_1": "سالي يكبار يا كمتر",
      "durel_ora_2": "چند بار در سال",
      "durel_ora_3": "چند بار در ماه",
      "durel_ora_4": "هفته اي يك بار",
      "durel_ora_5": "بيشتر از يك بار در هفته",
      "durel_nora": "چند وقت يك بار زماني را با فعاليت هاي مذهبي خصوصي، از قبيل نماز، عبادت وتعمق، يا مطالعه كتب مقدسه مي گذرانيد؟",
      "durel_nora_0": "هرگز يا بندرت",
      "durel_nora_1": "چند بار در سال",
      "durel_nora_2": "چند بار در ماه",
      "durel_nora_3": "چند بار در هفته",
      "durel_nora_4": "روزي يكبار",
      "durel_nora_5": "بيش از يكبار در روز",
      "durel_ir_stem": "هر كدام از سه جمله زير تا چه اندازه در توصيف شما صحيح است؟",
      "durel_ir1": "من در زندگيم حضور الهیات را تجربه مي كنم.",
      "durel_ir2": "چيزي كه واقعاً در پشت مسير و تلقي كامل من از زندگي است باورهاي مذهبي من است.",
      "durel_ir3": "در بكارگيري مذهب خود در همه جنبه هاي ديگر زندگي من به سختي تلاش مي كنم.",
      "durel_ir_1": "قطعاً نادرست",
      "durel_ir_2": "تا اندازه اي نادرست",
      "durel_ir_3": "نه درست نه نادرست",
      "durel_ir_4": "تا اندازه‌اي درست",
      "durel_ir_5": "قطعاً درست"
    },
    "fil": {
      "durel_ora": "Gaano ka kadalas na dumalo sa simbahan, moske, templo, o ano pa mang mga pagtitipon na may kinalaman sa relihiyon?",
      "durel_ora_0": "Hindi kailanman",
      "durel_ora_1": "Isang beses sa isang taon o mas mababa",
      "durel_ora_2": "Ilang beses sa isang taon",
      "durel_ora_3": "Ilang beses sa isang buwan",
      "durel_ora_4": "Isang beses sa isang linggo",
      "durel_ora_5": "Higit sa isang beses sa isang linggo",
      "durel_nora": "Gaano kadalas kang gumugugol ng oras sa mga pribadong gawain na may kinalaman sa relihiyon, katulad ng pagdarasal, pagninilay-nilay, o ang pag-aaral ng mga banal na kasulatan?",
      "durel_nora_0": "Hindi kailanman o bihira",
      "durel_nora_1": "Ilang beses sa isang taon",
      "durel_nora_2": "Ilang beses sa isang buwan",
      "durel_nora_3": "Ilang beses sa isang linggo",
      "durel_nora_4": "Isang beses sa isang araw",
      "durel_nora_5": "Higit sa isang beses sa isang araw",
      "durel_ir_stem": "Gaano katotoo ang bawat isa sa tatlong pangungusap, sa pagsasalarawan sa iyo?",
      "durel_ir1": "Sa aking buhay, aking nararanasan ang presensya ng kabanalan.",
      "durel_ir2": "Ang mga paniniwala na may kinalaman sa relihiyon ang totoong dahilan ng aking kabuuang pamamaraan sa buhay.",
      "durel_ir3": "Pinagsisikapan ko ng mabuti ang madala ang aking relihiyon sa lahat ng aking pakikitungo sa buhay.",
      "durel_ir_1": "Sadyang di-totoo",
      "durel_ir_2": "Medyo di-totoo",
      "durel_ir_3": "Wala alin man sa totoo o di-totoo",
      "durel_ir_4": "Medyo totoo",
      "durel_ir_5": "Sadyang totoo"
    },
    "hi": {
      "durel_ora": "आप कितनी बार चर्च, मस्जिद, मंदिर जाते हैं या कोई धार्मिक कार्यों में शरीक होते हैं?",
      "durel_ora_0": "कभी नहीं",
      "durel_ora_1": "साल में एक बार या कम",
      "durel_ora_2": "साल में कुछ बार",
      "durel_ora_3": "महीने में कुछ बार",
      "durel_ora_4": "हफ्ते में एक बार",
      "durel_ora_5": "हफ्ते में एक बार से अधिक",
      "durel_nora": "आप कितनी बार खुद कोई धर्मी गतिविधि करते हैं, जैसे की प्रार्थना, ध्यान या किसी धार्मिक ग्रन्थ का अध्ययन?",
      "durel_nora_0": "कभी नहीं या बहुत कम",
      "durel_nora_1": "साल में कुछ बार",
      "durel_nora_2": "महीने में कुछ बार",
      "durel_nora_3": "हफ्ते में कुछ बार",
      "durel_nora_4": "दिन में एक बार",
      "durel_nora_5": "दिन में एक बार से अधिक",
      "durel_ir_stem": "निम्न तीन में से हरेक वाक्य आपके बारे में कितना सत्य है?",
      "durel_ir1": "मेरी ज़िन्दगी में मुझे परमात्मा का अनुभव हुआ है।",
      "durel_ir2": "मेरे धार्मिक विचार मेरी ज़िन्दगी के रुख के पीछे में सही में हैं।",
      "durel_ir3": "मुझे अपने धर्म को मेरे ज़िन्दगी के हर पहलु में लाने के लिए प्रयास करना पड़ता है।",
      "durel_ir_1": "बिलकूल गलत",
      "durel_ir_2": "थोडा गलत",
      "durel_ir_3": "ना सही ना गलत",
      "durel_ir_4": "थोडा सही",
      "durel_ir_5": "बिलकूल सही"
    },
    "id": {
      "durel_ora": "Berapa sering Anda datang ke gereja, mesjid, candi, atau pertemuan-pertemuan agama lainnya?",
      "durel_ora_0": "Tidak pernah",
      "durel_ora_1": "Setahun sekali atau kurang",
      "durel_ora_2": "Beberapa kali setahun",
      "durel_ora_3": "Beberapa kali sebulan",
      "durel_ora_4": "Seminggu sekali",
      "durel_ora_5": "Lebih dari satu kali seminggu",
      "durel_nora": "Berapa sering Anda meluangkan waktu untuk kegiatan pribadi untuk keagamaan, seperti sembahyang, meditasi, atau belajar kitab Allah?",
      "durel_nora_0": "Tidak pernah atau jarang",
      "durel_nora_1": "Beberapa kali setahun",
      "durel_nora_2": "Beberapa kali sebulan",
      "durel_nora_3": "Beberapa kali seminggu",
      "durel_nora_4": "Sehari sekali",
      "durel_nora_5": "Lebih dari satu kali sehari",
      "durel_ir_stem": "Bagaimana benarnya setiap tiga pernyataan berikut, yang menggambarkan tentang Anda?",
      "durel_ir1": "Dalam kehidupan saya, saya mengalami hubungan KeTuhanan.",
      "durel_ir2": "Kepercayaan-kepercayaan agama saya adalah apa yang benar-benar ada di belakang seluruh jalan kehidupan saya.",
      "durel_ir3": "Saya mencoba membawa agama saya untuk semua penyelesaian lain dalam kehidupan.",
      "durel_ir_1": "Benar-benar tidak benar",
      "durel_ir_2": "Sedikit tidak benar",
      "durel_ir_3": "Benar atau tidak benar",
      "durel_ir_4": "Kemungkinan benar",
      "durel_ir_5": "Sungguh-sungguh benar"
