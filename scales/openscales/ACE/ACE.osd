    "scoring": {
      "commitment": {
        "method": "mean_coded",
        "items": ["ace1","ace2","ace3","ace4","ace5","ace6"],
        "transform": [{ "op": "multiply", "value": 6.25 }]
      },
      "informed_choice": {
        "method": "mean_coded",
        "items": ["ace7","ace8","ace9","ace10","ace11"],
        "transform": [{ "op": "multiply", "value": 6.25 }]
      },
      "navigation": {
        "method": "mean_coded",
        "items": ["ace12","ace13","ace14","ace15","ace16"],
        "transform": [{ "op": "multiply", "value": 6.25 }]
      },
      "ownership": {
        "method": "mean_coded",
        "items": ["ace17","ace18","ace19","ace20","ace21"],
        "transform": [{ "op": "multiply", "value": 6.25 }]
      },
      "ace_total": {
        "method": "sum_coded",
        "scores": ["commitment","informed_choice","navigation","ownership"]
      }
    }
  },
  "translations": {
    "en": {
      "ace_inst": "Please indicate how much you agree or disagree with each of the following statements.",
      "ace_r0": "Strongly disagree",
      "ace_r1": "Disagree",
      "ace_r2": "Neither agree nor disagree",
      "ace_r3": "Agree",
      "ace_r4": "Strongly agree",
      "ace1": "I can stick with plans to exercise and eat a healthy diet",
      "ace2": "Even when life is stressful, I know I can continue healthy activities",
      "ace3": "When I work to improve my health, I succeed",
      "ace4": "I handle my health well",
      "ace5": "I take responsibility for managing my health",
      "ace6": "I take an active role in my own health care",
      "ace7": "When choosing a new doctor, I look for official ratings based on patient health",
      "ace8": "I compare doctors using official ratings about patient outcomes",
      "ace9": "When choosing a new doctor, I look for information online",
      "ace10": "I spend a lot of time learning about health",
      "ace11": "I often read special health or medical magazines for information",
      "ace12": "I have lots of experience using the healthcare system",
      "ace13": "I feel comfortable talking to my doctor about my health",
      "ace14": "I am confident about handling health problems",
      "ace15": "I have brought my own health information to show my doctor",
      "ace16": "Different doctors give different advice; it's up to me to choose what's right for me",
      "ace17": "My health is my responsibility, not someone else's",
      "ace18": "The most important thing that affects my health is my own actions",
      "ace19": "I can help prevent or reduce health problems",
      "ace20": "I can follow through on home medical treatments",
      "ace21": "When I have a question about my health, I find the answer"
    }
  }
}
