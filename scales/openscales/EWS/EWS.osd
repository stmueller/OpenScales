  "translations": {
    "en": {
      "r1": "not at all true",
      "r2": "barely true",
      "r3": "moderately true",
      "r4": "exactly true",
      "qh": "Please indicate how true each of the following statements is for you.",
      "LANGUAGE": "English",
      "ews_en1": "I get easily upset when thinking about poisons in my environment.",
      "ews_en2": "I experience bodily symptoms that may be related to chemicals in my environment at home or at school.",
      "ews_en3": "I don't worry about being hurt by chemicals.",
      "ews_en4": "The image of being poisoned often pops into my mind.",
      "ews_en5": "I don't mind living in polluted environments because I am confident that I won't get hurt.",
      "ews_en6": "I feel worried about toxic effects on my body which might result in losing some of my intellectual abilities.",
      "ews_en7": "I have never really worried about water pollution.",
      "ews_en8": "I wonder whether there is radon or other dangerous substances in my house.",
      "ews_en9": "I feel frightened when I think of all the toxic waste dumps in the world.",
      "ews_en10": "I fear there will be a major nuclear accident or nuclear war in the near future.",
      "ews_en11": "Many people tend to overreact to the threat of environmental toxins.",
      "ews_en12": "I would not mind working in an office or plant built with asbestos or other possibly dangerous materials.",
      "ews_en13": "I have relaxed about environmental poisons because science always seems to succeed in providing remedies.",
      "ews_en14": "Poor memory can be a direct result of too much exposure to chemicals.",
      "ews_en15": "Toxic waste is a smaller problem than the media make it out to be.",
      "ews_en16": "Being exposed to most chemicals for a long time does not cause serious diseases.",
      "ews_en17": "People who handle chemicals are not at an increased health risk."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "LANGUAGE": "Deutsch",
      "ews_de1": "Mich regt es auf, wenn ich an all die Schadstoffe um mich herum denke.",
      "ews_de2": "Ich denke oft darüber nach, daß ich Schadstoffe in meinen Körper aufnehme.",
      "ews_de3": "Ich mache mir Sorgen, daß Umweltgifte meine geistigen Fähigkeiten beeinträchtigen.",
      "ews_de4": "Ich frage mich, ob in meiner Wohnung oder in meinem Haus Asbest oder andere gesundheitsgefährdende Stoffe verwendet wurden.",
      "ews_de5": "Es macht mir Angst, wenn ich daran denke, wie überall Giftmüll gelagert wird.",
      "ews_de6": "Ich befürchte, daß es in absehbarer Zeit zu einem schweren Atomreaktorunfall kommen könnte.",
      "ews_de7": "Ein schlechtes Gedächtnis könnte auch von zu viel Chemikalien in unserer Umwelt herrühren.",
      "ews_de8": "Die meisten Chemikalien führen bei längerer Berührung mit dem Organismus zu schweren Erkrankungen.",
      "ews_de9": "Menschen, die viel mit Chemikalien zu tun haben, sind einem erhöhten Gesundheitsrisiko ausgesetzt.",
      "ews_de10": "Wenn ich daran denke, wie belastet unsere Nahrung ist, verliere ich den Appetit.",
      "ews_de11": "Ich fürchte, mein Organismus ist bereits durch gefährliche Umweltstoffe geschädigt.",
      "ews_de12": "Wenn ich verreise, überlege ich mir vorher, wo ich am wenigsten den Schadstoffen im Wasser oder in der Luft ausgesetzt bin.",
      "ews_de13": "Je mehr Informationen ich über Umweltbelastungen bekomme, desto unsicherer fühle ich mich.",
      "ews_de14": "Unsere Nachkommen werden für die Folgen der Umweltbelastung büßen müssen.",
      "ews_de15": "Ich habe Angst vor der Zukunft, wenn ich an unsere Umwelt denke.",
      "ews_de16": "Die Menschen haben die Kontrolle über die Auswirkungen der Technik auf die Umwelt verloren."
    }
  }
}