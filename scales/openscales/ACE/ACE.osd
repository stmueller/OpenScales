{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Altarum Consumer Engagement Measure",
      "code": "ACE",
      "abbreviation": "ACE",
      "version": "1.0",
      "description": "21-item self-report measure of patient engagement across four dimensions: Commitment to health, Informed Choice, Navigation of the healthcare system, and Ownership of health. All items use a 5-point Likert scale (0–4). Each subscale is scored as mean × 6.25 (range 0–25); total ACE score is the sum of the four subscales (range 0–100). Higher scores indicate greater consumer engagement. ACE Measure™ is a trademark of Altarum Institute.",
      "citation": "Duke, C. C., Lynch, W. D., Smith, B., & Winstanley, J. (2015). Validity of a new patient engagement measure: The Altarum Consumer Engagement (ACE) Measure™. The Patient, 8(6), 559–568. https://doi.org/10.1007/s40271-015-0131-2",
      "license": "CC BY 4.0",
      "license_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4662956/",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4662956/",
      "domain": "Health"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-18",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "likert_options": {
      "points": 5,
      "min": 0,
      "max": 4,
      "labels": [
        "ace_r0",
        "ace_r1",
        "ace_r2",
        "ace_r3",
        "ace_r4"
      ],
      "question_head": "ace_inst"
    },
    "dimensions": [
      {
        "id": "commitment",
        "name": "Commitment",
        "abbreviation": "COM",
        "description": "Commitment to healthy behaviors and active health management. Score 0–25."
      },
      {
        "id": "informed_choice",
        "name": "Informed Choice",
        "abbreviation": "IC",
        "description": "Seeking and using health information to make informed decisions. Score 0–25."
      },
      {
        "id": "navigation",
        "name": "Navigation",
        "abbreviation": "NAV",
        "description": "Confidence and experience navigating the healthcare system. Score 0–25."
      },
      {
        "id": "ownership",
        "name": "Ownership",
        "abbreviation": "OWN",
        "description": "Taking personal responsibility for one's health. Score 0–25."
      },
      {
        "id": "ace_total",
        "name": "Total ACE Score",
        "abbreviation": "ACE",
        "description": "Sum of the four subscale scores. Range 0–100."
      }
    ],
