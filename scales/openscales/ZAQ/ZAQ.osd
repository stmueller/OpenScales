{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ZAQ",
      "name": "schiZotypy Autism Questionnaire",
      "abbreviation": "ZAQ",
      "description": "121-item screening questionnaire for discriminating autism spectrum disorder from schizotypal disorder in adults, using a 4-point agree/disagree scale. The cited paper is a pre-registration protocol; full validation results may appear in a subsequent publication. The original protocol also included demographic questions, 3 Cognitive Reflection Test items (59, 77, 115), and 3 multiple-choice social cognition vignette items (41, 49, 84), all of which are excluded from this implementation.",
      "citation": "Parvaiz, R., Vindbjerg, E., Crespi, B., Happe, F., Schalbroeck, R., AlSayegh, Z., Danielsen, I. M., Tonge, B., Videbech, P., & AbuAkel, A. (2023). Protocol for the development and testing of the schiZotypy Autism Questionnaire (ZAQ) in adults: A new screening tool to discriminate autism spectrum disorder from schizotypal disorder. BMC Psychiatry, 23(1). https://doi.org/10.1186/s12888-023-04690-3",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1186/s12888-023-04690-3",
      "version": "1.0",
      "domain": "Clinical"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 0,
        "description": "Show scale title to respondents (default off: title reveals schizotypy/autism framing and may prompt malingering)"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "labels": [
        "ZAQ_r1",
        "ZAQ_r2",
        "ZAQ_r3",
        "ZAQ_r4"
      ],
      "question_head": "ZAQ_head"
    },
    "dimensions": [
      {
        "id": "Autism",
        "name": "Autism",
        "description": "Items characteristic of autism spectrum disorder traits"
      },
      {
        "id": "Schizotypy",
        "name": "Schizotypy",
        "description": "Items characteristic of schizotypal traits"
      }
    ],
