{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Porto Saudade Scale",
      "code": "MISS11049",
      "abbreviation": "PSS",
      "description": "A 5-item unidimensional scale measuring saudade proneness — the frequency with which an individual experiences saudade (a Portuguese emotional concept of longing for absent people, places, or things). Items 1–3 and 5 use a 7-point frequency scale; item 4 uses a 7-category ordered frequency format. Developed and validated in Portuguese adolescents and Brazilian international students. Higher scores indicate greater saudade proneness.",
      "citation": "Neto, F. (2021). Psychometric properties of the Porto Saudade Scale. Measurement Instruments for the Social Sciences, 3, Article e11049. https://doi.org/10.1186/s42409-021-00022-x",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/11049",
      "domain": "Social / Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Portuguese original and English translations verbatim from paper. Items 1/2/3/5 use 7-point Likert (1=Very rarely to 7=Very frequently). Item 4 uses a 7-category ordered frequency format (1=Once or twice a year through 7=At least once a day) encoded as multi type. No reverse-coded items. Validated in Portuguese-speaking populations; English translation provided in paper but not independently validated."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": ["pss_r1", "pss_r2", "pss_r3", "pss_r4", "pss_r5", "pss_r6", "pss_r7"]
    },
    "dimensions": [
      {
        "id": "saudade",
        "name": "Saudade Proneness",
        "abbreviation": "SAU",
        "description": "Frequency of experiencing saudade. Mean of all 5 items (after rescaling item 4 to 1–7), range 1–7; higher = greater saudade proneness."
      }
    ],
    "items": [
      {"id": "pss1", "type": "likert", "text_key": "pss1", "dimension": "saudade"},
      {"id": "pss2", "type": "likert", "text_key": "pss2", "dimension": "saudade"},
      {"id": "pss3", "type": "likert", "text_key": "pss3", "dimension": "saudade"},
      {"id": "pss4", "type": "multi", "text_key": "pss4", "dimension": "saudade",
        "options": [
          {"value": 1, "text_key": "pss4_r1"},
          {"value": 2, "text_key": "pss4_r2"},
          {"value": 3, "text_key": "pss4_r3"},
          {"value": 4, "text_key": "pss4_r4"},
          {"value": 5, "text_key": "pss4_r5"},
          {"value": 6, "text_key": "pss4_r6"},
          {"value": 7, "text_key": "pss4_r7"}
        ]},
      {"id": "pss5", "type": "likert", "text_key": "pss5", "dimension": "saudade"}
    ],
    "scoring": {
      "saudade": {
        "description": "Mean of all 5 items. Item 4 values are already on the 1–7 scale. Range 1–7; higher = greater saudade proneness.",
        "method": "mean_coded",
        "items": ["pss1", "pss2", "pss3", "pss4", "pss5"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "Porto Saudade Scale (PSS) Report",
      "footer_refs": [
        "Neto, F. (2021). Psychometric properties of the Porto Saudade Scale. Measurement Instruments for the Social Sciences, 3, Article e11049. https://doi.org/10.1186/s42409-021-00022-x",
        "Higher scores indicate greater saudade proneness. Item 4 uses an ordered frequency format; all items contribute equally to the mean score."
      ]
    }
  },
  "translations": {
    "pt": {
      "pss_r1": "Muito raramente",
      "pss_r2": "Raramente",
      "pss_r3": "Às vezes",
      "pss_r4": "Frequentemente",
      "pss_r5": "Muito frequentemente",
      "pss_r6": "Quase sempre",
      "pss_r7": "Sempre",
      "pss1": "Quantas vezes sente saudade?",
      "pss2": "Quantas vezes se recorda de ter sentido saudade?",
      "pss3": "Até que ponto fala sobre o que o(a) faz sentir saudade?",
      "pss4": "Até que ponto sente saudade?",
      "pss4_r1": "Uma ou duas vezes por ano",
      "pss4_r2": "Uma vez a cada dois meses",
      "pss4_r3": "Uma ou duas vezes por mês",
      "pss4_r4": "Aproximadamente uma vez por semana",
      "pss4_r5": "Aproximadamente duas vezes por semana",
      "pss4_r6": "Três a quatro vezes por semana",
      "pss4_r7": "Pelo menos uma vez por dia",
      "pss5": "Com que frequência sente saudade em comparação com outras pessoas?",
      "debrief": "Obrigado por completar este questionário."
    },
    "en": {
      "pss_r1": "Very rarely",
      "pss_r2": "Rarely",
      "pss_r3": "Sometimes",
      "pss_r4": "Often",
      "pss_r5": "Very often",
      "pss_r6": "Almost always",
      "pss_r7": "Always",
      "pss1": "How often do you feel saudade?",
      "pss2": "How often do you remember feeling saudade?",
      "pss3": "To what extent do you talk about what makes you feel saudade?",
      "pss4": "To what extent do you feel saudade?",
      "pss4_r1": "Once or twice a year",
      "pss4_r2": "Once every couple of months",
      "pss4_r3": "Once or twice a month",
      "pss4_r4": "Approximately once a week",
      "pss4_r5": "Approximately twice a week",
      "pss4_r6": "Three to four times a week",
      "pss4_r7": "At least once a day",
      "pss5": "How often do you feel saudade in comparison with other people?",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}
