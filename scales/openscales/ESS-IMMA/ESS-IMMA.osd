  "translations": {
    "en": {
      "imma_inst": "Now some questions about people coming to live in [country] from other countries.",
      "imsmetn": "To what extent do you think [country] should allow people of the same race or ethnic group as most [country] people to come and live here?",
      "imdfetn": "How about people of a different race or ethnic group from most [country] people?",
      "impcntr": "How about people from the poorer countries outside Europe?",
      "imma_allow1": "Allow many to come and live here",
      "imma_allow2": "Allow some",
      "imma_allow3": "Allow a few",
      "imma_allow4": "Allow none",
      "imbgeco": "Is it generally bad or good for [country]'s economy that people come to live here from other countries?",
      "imma_eco_lo": "Bad for the economy",
      "imma_eco_hi": "Good for the economy",
      "imueclt": "And what about [country]'s cultural life? Is it generally undermined or enriched by people coming to live here from other countries?",
      "imma_clt_lo": "Cultural life undermined",
      "imma_clt_hi": "Cultural life enriched",
      "imwbcnt": "Is [country] made a worse or better place to live by people coming to live here from other countries?",
      "imma_wb_lo": "Worse place to live",
      "imma_wb_hi": "Better place to live",
      "debrief": "Thank you for completing this questionnaire.",
      "imma_head2": "Would you say it is generally bad or good for [country]'s economy that people come to live here from other countries? And what about [country]'s cultural life? Is [country] made a worse or better place to live by people coming to live here from other countries?"
    },
    "ar": {
      "imma_inst": "الأسئلة التالية هي عن أشخاص، من دول أخرى، الذين يأتون للعيش في [country].",
      "imsmetn": "إلى أي مدى، حسب رأيك، يجب أن تسمح [country] لأشخاص ينتمون إلى نفس العرق أو المجموعة الاثنية مثل تلك التي ينتمي إليها غالبية مواطنيها، القدوم للعيش هنا؟",
      "imdfetn": "ماذا بالنسبة لأشخاص ينتمون إلى مجموعة عرقية أو مجموعة اثنيه مختلفة عن تلك التي ينتمي إليها غالبية المواطنين في [country]؟",
      "impcntr": "ماذا عن أشخاص من دول فقيرة من خارج أوروبا؟",
      "imma_allow1": "السماح لكثيرون القدوم للعيش هنا",
      "imma_allow2": "السماح لعدد معين",
      "imma_allow3": "السماح لعدد قليل",
      "imma_allow4": "عدم السماح لأي شخص",
      "imbgeco": "هل كنت تقول/ين، بشكل عام، بأنه جيد أو سيئ لاقتصاد [country] بأن يأتي للعيش هنا أشخاص من دول أخرى؟",
      "imma_eco_lo": "سيء للاقتصاد",
      "imma_eco_hi": "جيد للاقتصاد",
      "imueclt": "هل كنت تقول/ين بأن الحياة الثقافية في [country]، بشكل عام، تصبح فقيرة أكثر أو غنية أكثر بسبب الأشخاص الذين يأتون للعيش هنا من دول أخرى؟",
      "imma_clt_lo": "حياة ثقافية فقيرة أكثر",
      "imma_clt_hi": "حياة ثقافية غنية أكثر",
      "imwbcnt": "هل أصبحت [country] مكان أفضل أكثر أم أسوء أكثر للعيش فيه بسبب الأشخاص الذين يأتون من دول أخرى للعيش هنا؟",
      "imma_wb_lo": "مكان أسوء أكثر للعيش به",
      "imma_wb_hi": "مكان أفضل أكثر للعيش به",
      "imma_head2": "هل كنت تقول/ين، بشكل عام، بأنه جيد أو سيئ لاقتصاد [country] بأن يأتي للعيش هنا أشخاص من دول أخرى؟",
      "debrief": ""
    },
    "at": {
      "imma_inst": "Die folgenden Fragen beziehen sich auf Menschen aus anderen Ländern, die nach [country] kommen, um hier zu leben.",
      "imsmetn": "Zunächst geht es um Zuwanderer, die derselben Volksgruppe oder ethnischen Gruppe wie die meisten [country] angehören. Wie vielen von ihnen sollte es [country] erlauben, sich hier niederzulassen?",
      "imdfetn": "Wie ist das mit Zuwanderern, die einer anderen Volksgruppe oder ethnischen Gruppe angehören als die Mehrheit der [country]?",
      "impcntr": "Wie ist das mit Zuwanderern aus den ärmeren Ländern außerhalb Europas?",
      "imma_allow1": "Es vielen erlauben, zu kommen und hier zu leben",
      "imma_allow2": "Es einigen erlauben",
      "imma_allow3": "Es wenigen erlauben",
      "imma_allow4": "Es keinem erlauben",
      "imbgeco": "Würden Sie sagen, dass es generell schlecht oder gut für die österreichische Wirtschaft ist, dass Zuwanderer nach [country] kommen, um hier zu leben?",
      "imma_eco_lo": "Schlecht für die Wirtschaft",
      "imma_eco_hi": "Gut für die Wirtschaft",
      "imueclt": "Würden Sie sagen, dass das kulturelle Leben in [country] im Allgemeinen durch Zuwanderer untergraben oder bereichert wird?",
      "imma_clt_lo": "Kulturelles Leben wird untergraben",
      "imma_clt_hi": "Kulturelles Leben wird bereichert",
      "imwbcnt": "Wird [country] durch Zuwanderer zu einem schlechteren oder besseren Ort zum Leben?",
      "imma_wb_lo": "Wird zu einem schlechteren Ort zum Leben",
      "imma_wb_hi": "Wird zu einem besseren Ort zum Leben",
      "imma_head2": "Würden Sie sagen, dass es generell schlecht oder gut für die österreichische Wirtschaft ist, dass Zuwanderer nach [country] kommen, um hier zu leben?",
      "debrief": "Vielen Dank, dass Sie diese Umfrage ausgefüllt haben - wir wissen es wirklich zu schätzen, dass Sie sich die Zeit dafür nehmen."
    },
    "bg": {
      "imma_inst": "Сега няколко въпроса за хората, които идват да живеят в [country] от други държави.",
      "imsmetn": "СПОРЕД ВАС, ДОКОЛКО [country] БИ ТРЯБВАЛО ДА РАЗРЕШАВА НА ХОРА ОТ СЪЩАТА РАСА ИЛИ ЕТНИЧЕСКА ГРУПА КАТО ПОВЕЧЕТО ХОРА В [country] ДА ИДВАТ И ДА ЖИВЕЯТ ТУК? ПОЛЗВАЙТЕ ТАЗИ КАРТА.",
      "imdfetn": "А НА ХОРА ОТ РАСА ИЛИ ЕТНИЧЕСКА ГРУПА, РАЗЛИЧНИ ОТ ПОВЕЧЕТО ХОРА В [country]? Ползвайте същата карта.",
      "impcntr": "А НА ХОРА ОТ ПО-БЕДНИ ДЪРЖАВИ ИЗВЪН ЕВРОПА? Ползвайте същата карта.",
      "imma_allow1": "Да разрешава на много от тях да идват и да живеят у нас.",
      "imma_allow2": "Да разрешава само на някои.",
      "imma_allow3": "Да разрешава на много малко.",
      "imma_allow4": "Да не разрешава на никого.",
      "imbgeco": "КАК МИСЛИТЕ – ДОБРЕ ЛИ Е ИЛИ НЕ ЗА БЪЛГАРСКАТА ИКОНОМИКА ЧУЖДЕНЦИ ДА СЕ ПРЕСЕЛВАТ ДА ЖИВЕЯТ У НАС? Ползвайте тази карта, за да отговорите.",
      "imma_eco_lo": "Не е добре за икономиката ни",
      "imma_eco_hi": "Добре е за икономиката ни",
      "imueclt": "СПОРЕД ВАС, ЧУЖДЕНЦИТЕ, КОИТО СЕ ПРЕСЕЛВАТ У НАС, ОЩЕТЯВАТ ИЛИ ОБОГАТЯВАТ КУЛТУРНИЯ НИ ЖИВОТ? Ползвайте тази карта, за да отговорите.",
      "imma_clt_lo": "Културният ни живот се ощетява",
      "imma_clt_hi": "Културният ни живот се обогатява",
      "imwbcnt": "ДОКОЛКО ЧУЖДЕНЦИТЕ, КОИТО СЕ ПРЕСЕЛВАТ У НАС, ПРАВЯТ [country] ПО-ЛОШО ИЛИ ПО-ДОБРО МЯСТО ЗА ЖИВЕЕНЕ? Ползвайте тази карта, за да отговорите.",
      "imma_wb_lo": "По-лошо място за живеене",
      "imma_wb_hi": "По-добро място за живеене",
      "imma_head2": "КАК МИСЛИТЕ – ДОБРЕ ЛИ Е ИЛИ НЕ ЗА БЪЛГАРСКАТА ИКОНОМИКА ЧУЖДЕНЦИ ДА СЕ ПРЕСЕЛВАТ ДА ЖИВЕЯТ У НАС? Ползвайте тази карта, за да отговорите.",
      "debrief": "БЛАГОДАРЯ ВИ!"
    },
    "cnr": {
      "imma_inst": "Slijedi nekoliko pitanja u vezi sa ljudima koji dolaze iz drugih zemalja da žive u [country].",
      "imsmetn": "Sada, koristeći ovu karticu, odgovorite u kojoj mjeri, po Vašem mišljenju [country] treba da dozvoli ljudima koji pripadaju istoj rasi ili etničkoj grupi kao i većina stanovnika [country] da se dosele i žive ovdje?",
      "imdfetn": "A kada je riječ o ljudima različite rase ili etničke pripadnosti u odnosu na većinu stanovništva [country]? I dalje koristite ovu karticu.",
      "impcntr": "A kada je riječ o stanovnicima siromašnijih zemalja izvan Evrope? I dalje koristite ovu karticu.",
      "imma_allow1": "Treba da dozvoli mnogima da dođu i žive ovdje",
      "imma_allow2": "Treba da dozvoli nekima",
      "imma_allow3": "Treba da dozvoli manjem broju",
      "imma_allow4": "Ne treba da dozvoli nikome",
      "imbgeco": "Da li biste rekli da je za ekonomiju [country] generalno loše ili dobro da se ovdje dosele ljudi iz drugih zemalja? Molim Vas da koristite ovu karticu.",
      "imma_eco_lo": "Loše za ekonomiju",
      "imma_eco_hi": "Dobro za ekonomiju",
      "imueclt": "A, koristeći ovu karticu, da li biste rekli da ljudi iz drugih država koji dolaze ovdje da žive generalno unazađuju ili obogaćuju kulturni život u [country]?",
      "imma_clt_lo": "Unazađuju kulturni život",
      "imma_clt_hi": "Obogaćuju kulturni život",
      "imwbcnt": "Da li je [country] postala bolje ili gore mjesto za život usljed dolaska ljudi iz drugih zemalja da žive u njoj? Molimo Vas da koristite ovu karticu.",
      "imma_wb_lo": "Gore mjesto za život",
      "imma_wb_hi": "Bolje mjesto za život",
      "imma_head2": "Da li biste rekli da je za ekonomiju [country] generalno loše ili dobro da se ovdje dosele ljudi iz drugih zemalja? Molim Vas da koristite ovu karticu.",
      "debrief": ""
    },
    "cs": {
      "imma_inst": "Nyní několik otázek o lidech, kteří přicházejí žít do [country] z jiných zemí.",
      "imsmetn": "Nyní s použitím této karty řekněte, do jaké míry by podle Vás měla [country] dovolit, aby sem přicházeli a žili zde lidé stejné rasy nebo stejného etnika jako je většina českých lidí? Měla by…",
      "imdfetn": "A co lidem jiné rasy nebo etnické skupiny než je většina českých lidí? Měla by… Opět použijte tuto kartu.",
      "impcntr": "A co lidem z chudších mimoevropských zemí? Použijte stejnou kartu.",
      "imma_allow1": "Dovolit hodně lidem, aby sem přicházeli a žili tady",
      "imma_allow2": "Dovolit to některým",
      "imma_allow3": "Dovolit to malému počtu",
      "imma_allow4": "Nedovolit to nikomu",
      "imbgeco": "Řekl(a) byste, že pro českou ekonomiku je obecně špatné nebo dobré, že sem přicházejí žít lidé z jiných zemí? Použijte prosím tuto kartu.",
      "imma_eco_lo": "Špatné pro ekonomiku",
      "imma_eco_hi": "Dobré pro ekonomiku",
      "imueclt": "A s použitím této karty řekněte, zda lidé z jiných zemí, kteří sem přicházejí žít, většinou narušují nebo obohacují kulturu [country]?",
      "imma_clt_lo": "Narušují kulturu",
      "imma_clt_hi": "Obohacují kulturu",
      "imwbcnt": "Dělají lidé, kteří do [country] přicházejí žít z jiných zemí, z [country] lepší či horší místo pro život? Použijte prosím tuto kartu.",
      "imma_wb_lo": "Horší místo pro život",
      "imma_wb_hi": "Lepší místo pro život",
      "imma_head2": "Řekl(a) byste, že pro českou ekonomiku je obecně špatné nebo dobré, že sem přicházejí žít lidé z jiných zemí? Použijte prosím tuto kartu.",
      "debrief": ""
    },
    "de": {
      "imma_inst": "Bei den folgenden Fragen geht es um Menschen, die aus anderen Ländern nach [country] kommen, um hier zu leben.",
      "imsmetn": "Zunächst geht es um die Zuwanderer, die derselben Volksgruppe oder ethnischen Gruppe angehören wie die Mehrheit der Deutschen. Wie vielen von ihnen sollte [country] erlauben, hier zu leben? Sollte [country] es…",
      "imdfetn": "Wie ist das mit Zuwanderern, die einer anderen Volksgruppe oder ethnischen Gruppe angehören als die Mehrheit der Deutschen?",
      "impcntr": "Und wie ist das mit Zuwanderern, die aus den ärmeren Ländern außerhalb Europas kommen?",
      "imma_allow1": "Vielen erlauben, herzukommen und hier zu leben",
      "imma_allow2": "Einigen erlauben",
      "imma_allow3": "Ein paar wenigen erlauben",
      "imma_allow4": "Niemandem erlauben",
      "imbgeco": "Was würden Sie sagen, ist es im Allgemeinen gut oder schlecht für die deutsche Wirtschaft, dass Zuwanderer hierher kommen?",
      "imma_eco_lo": "Schlecht für die Wirtschaft",
      "imma_eco_hi": "Gut für die Wirtschaft",
      "imueclt": "Würden Sie sagen, dass das kulturelle Leben in [country] im Allgemeinen durch Zuwanderer untergraben oder bereichert wird?",
      "imma_clt_lo": "Kulturelles Leben wird untergraben",
      "imma_clt_hi": "Kulturelles Leben wird bereichert",
      "imwbcnt": "Wird [country] durch Zuwanderer zu einem schlechteren oder besseren Ort zum Leben?",
      "imma_wb_lo": "Wird zu einem schlechteren Ort zum Leben",
      "imma_wb_hi": "Wird zu einem besseren Ort zum Leben",
      "imma_head2": "Was würden Sie sagen, ist es im Allgemeinen gut oder schlecht für die deutsche Wirtschaft, dass Zuwanderer hierher kommen?",
      "debrief": "Vielen Dank für die Teilnahme an dieser Umfrage - wir danken Ihnen herzlich, dass Sie sich die Zeit dafür genommen haben."
    },
    "el": {
      "imma_inst": "Και τώρα κάποιες ερωτήσεις για άτομα από άλλες χώρες που έρχονται να ζήσουν στην [country].",
      "imsmetn": "Χρησιμοποιώντας αυτή την κάρτα, σε ποιο βαθμό πιστεύετε ότι η [country] θα έπρεπε να επιτρέπει σε άτομα που ανήκουν στην ίδια φυλή ή εθνοτική ομάδα στην οποία ανήκει και η πλειοψηφία των Ελλήνων να έρθουν και να ζήσουν εδώ;",
      "imdfetn": "Ποια η άποψή σας για τα άτομα από διαφορετική φυλή ή εθνοτική ομάδα από τα περισσότερα άτομα της χώρας μας; Η [country] θα έπρεπε … Χρησιμοποιήστε πάλι την ίδια κάρτα.",
      "impcntr": "Και τι πιστεύετε για τα άτομα που προέρχονται από τις φτωχότερες χώρες εκτός Ευρώπης; Η [country] θα έπρεπε… Χρησιμοποιήστε πάλι την ίδια κάρτα.",
      "imma_allow1": "Να επιτρέπει σε πολλούς να έρθουν να ζήσουν εδώ",
      "imma_allow2": "Να επιτρέπει σε αρκετούς",
      "imma_allow3": "Να επιτρέπει σε λίγους",
      "imma_allow4": "Να μην επιτρέπει σε κανέναν",
      "imbgeco": "Πιστεύετε πως είναι γενικά καλό ή κακό για την ελληνική οικονομία το γεγονός ότι έρχονται άτομα από άλλες χώρες για να ζήσουν εδώ; Παρακαλώ χρησιμοποιήστε αυτή την κάρτα.",
      "imma_eco_lo": "Κακό για την οικονομία",
      "imma_eco_hi": "Καλό για την οικονομία",
      "imueclt": "Χρησιμοποιώντας αυτή την κάρτα, θα λέγατε ότι η πολιτιστική ζωή και παράδοση της [country] γενικά υποβαθμίζεται ή εμπλουτίζεται από άτομα που έρχονται για να ζήσουν εδώ από άλλες χώρες;",
      "imma_clt_lo": "Η πολιτιστική ζωή και παράδοση υποβαθμίζεται",
      "imma_clt_hi": "Η πολιτιστική ζωή και παράδοση εμπλουτίζεται",
      "imwbcnt": "Η [country] γίνεται καλύτερο ή χειρότερο μέρος για να ζήσει κανείς με την άφιξη ατόμων από άλλες χώρες που έρχονται για να ζήσουν εδώ; Παρακαλώ χρησιμοποιήστε αυτή την κάρτα.",
      "imma_wb_lo": "Χειρότερο μέρος για να ζήσει κανείς",
      "imma_wb_hi": "Καλύτερο μέρος για να ζήσει κανείς",
      "imma_head2": "Πιστεύετε πως είναι γενικά καλό ή κακό για την ελληνική οικονομία το γεγονός ότι έρχονται άτομα από άλλες χώρες για να ζήσουν εδώ; Παρακαλώ χρησιμοποιήστε αυτή την κάρτα.",
      "debrief": ""
    },
    "es": {
      "imma_inst": "Las siguientes preguntas se refieren a las personas de otros países que vienen a vivir a [country].",
      "imsmetn": "¿Hasta qué punto cree usted que [country] debería permitir que personas de la misma raza o grupo étnico que la mayoría de los españoles vengan a vivir aquí?",
      "imdfetn": "¿Y qué piensa sobre las que son de una raza o grupo étnico distinto al de la mayoría de los españoles?",
      "impcntr": "¿Y qué piensa sobre las que proceden de los países pobres de fuera de Europa?",
      "imma_allow1": "Debería permitir que muchas vinieran a vivir aquí",
      "imma_allow2": "Debería permitir que vinieran unas cuantas",
      "imma_allow3": "Debería permitir que vinieran unas pocas",
      "imma_allow4": "No debería permitir que ninguna viniera a vivir aquí",
      "imbgeco": "¿Diría usted que, por lo general, para la economía española, es bueno o es malo que gente de otros países venga a vivir aquí?",
      "imma_eco_lo": "Malo para la economía",
      "imma_eco_hi": "Bueno para la economía",
      "imueclt": "¿Cree usted que la vida cultural española se empobrece o se enriquece con las personas de otros países que vienen a vivir aquí?",
      "imma_clt_lo": "La vida cultural española se empobrece",
      "imma_clt_hi": "La vida cultural española se enriquece",
      "imwbcnt": "La llegada de personas de otros países, ¿contribuye a que [country] sea un lugar peor o mejor para vivir?",
      "imma_wb_lo": "Peor lugar para vivir",
      "imma_wb_hi": "Mejor lugar para vivir",
      "imma_head2": "¿Diría usted que, por lo general, para la economía española, es bueno o es malo que gente de otros países venga a vivir aquí?",
      "debrief": "Gracias por su colaboración."
    },
    "et": {
      "imma_inst": "Nüüd mõned küsimused inimeste kohta, kes tulevad teistest riikidest [country] elama.",
      "imsmetn": "Mil määral peaks [country] riik lubama enamiku [country] elavate inimestega samast rassist või rahvusest inimestel siia elama tulla? Vastamiseks kasutage kaarti 18. Eesti riigi poliitika peaks…",
      "imdfetn": "Kuidas oleks aga nende inimestega, kes erinevad enamikust [country] elavatest inimestest oma rassi või rahvuse poolest? Vastamiseks kasutage kaarti 18. Eesti riigi poliitika peaks…",
      "impcntr": "Kuidas oleks aga väljaspool Euroopat asuvatest vaesematest riikidest pärit inimestega? Vastamiseks kasutage endiselt kaarti 18. Eesti riigi poliitika peaks…",
      "imma_allow1": "…lubama paljudel siia elama tulla",
      "imma_allow2": "…lubama mõnedel siia elama tulla",
      "imma_allow3": "…lubama väga vähestel siia elama tulla",
      "imma_allow4": "…üldse mitte lubama",
      "imbgeco": "Üldiselt hinnates, kas see mõjub [country] majandusele hästi või halvasti, kui teistest riikidest inimesed siia elama tulevad? Vastamiseks kasutage kaarti 19.",
      "imma_eco_lo": "Mõjub majandusele halvasti",
      "imma_eco_hi": "Mõjub majandusele hästi",
      "imueclt": "Mida Te arvate, kas teistest riikidest inimeste [country] elama asumine pigem kahjustab või rikastab [country] kultuurielu? Vastamiseks kasutage kaarti 20.",
      "imma_clt_lo": "Kahjustab kultuurielu",
      "imma_clt_hi": "Rikastab kultuurielu",
      "imwbcnt": "Kas [country] muutuks elukoha mõttes halvemaks või paremaks paigaks, kui teistest riikidest inimesed siia elama tulevad? Vastamiseks kasutage kaarti 21.",
      "imma_wb_lo": "Halvemaks elupaigaks",
      "imma_wb_hi": "Paremaks elupaigaks",
      "imma_head2": "Üldiselt hinnates, kas see mõjub [country] majandusele hästi või halvasti, kui teistest riikidest inimesed siia elama tulevad? Vastamiseks kasutage kaarti 19.",
      "debrief": ""
    },
    "fi": {
      "imma_inst": "Seuraavaksi kysyn muutamia kysymyksiä siitä, että [country] muuttaa ihmisiä muualta asumaan.",
      "imsmetn": "Kuinka paljon [country] tulisi sallia sellaisten ihmisten muuttaa maahan asumaan, jotka kuuluvat samaan etniseen ryhmään kuin useimmat suomalaiset?",
      "imdfetn": "Entä sellaisia ihmisiä, jotka edustavat eri etnistä alkuperää kuin useimmat suomalaiset?",
      "impcntr": "Entä köyhemmistä Euroopan ulkopuolisista maista olevien ihmisten muuttaa [country] asumaan?",
      "imma_allow1": "Pitäisi sallia paljon",
      "imma_allow2": "Pitäisi sallia melko paljon",
      "imma_allow3": "Pitäisi sallia vähän",
      "imma_allow4": "Ei pitäisi sallia lainkaan",
      "imbgeco": "Onko kaiken kaikkiaan mielestäsi haitaksi vai eduksi [country] taloudelle, että muista maista muuttaa ihmisiä [country]? Käytä tätä korttia.",
      "imma_eco_lo": "Haitaksi taloudelle",
      "imma_eco_hi": "Eduksi taloudelle",
      "imueclt": "Entä uskotko, että kulttuurielämä [country] heikentyy vai rikastuu, kun [country] muuttaa ihmisiä muista maista?",
      "imma_clt_lo": "Kulttuurielämä heikkenee",
      "imma_clt_hi": "Kulttuurielämä rikastuu",
      "imwbcnt": "Muuttuuko [country] paremmaksi vai huonommaksi paikaksi asua, kun muista maista muuttaa ihmisiä tänne? Käytä tätä korttia.",
      "imma_wb_lo": "Muuttuu huonommaksi paikaksi asua",
      "imma_wb_hi": "Muuttuu paremmaksi paikaksi asua",
      "imma_head2": "Onko kaiken kaikkiaan mielestäsi haitaksi vai eduksi [country] taloudelle, että muista maista muuttaa ihmisiä [country]? Käytä tätä korttia.",
      "debrief": "Kiitos vastauksestasi!"
    },
    "fr": {
      "imma_inst": "Et maintenant, quelques questions concernant les personnes d'autres pays qui viennent vivre en [country].",
      "imsmetn": "Maintenant, en utilisant cette liste de réponses, dans quelle mesure pensez-vous que la [country] doit autoriser des gens de même origine ethnique que la plupart des français à venir vivre ici ?",
      "imdfetn": "Et à propos des gens d'une origine ethnique différente de la plupart des Français ? Utilisez de nouveau cette liste de réponses.",
      "impcntr": "En ce qui concerne les gens venant des pays pauvres non européens ? Utilisez de nouveau cette liste de réponses.",
      "imma_allow1": "Elle doit autoriser un grand nombre d'entre eux à venir vivre ici",
      "imma_allow2": "Elle doit autoriser certains d'entre eux",
      "imma_allow3": "Elle ne doit autoriser que peu d'entre eux",
      "imma_allow4": "Elle ne doit autoriser aucun d'entre eux",
      "imbgeco": "Dans l'ensemble, diriez-vous que c'est mauvais ou bon pour l'économie française que des personnes d'autres pays viennent vivre en [country] ? Veuillez utiliser cette liste de réponses.",
      "imma_eco_lo": "Mauvais pour l'économie",
      "imma_eco_hi": "Bon pour l'économie",
      "imueclt": "Diriez-vous que, dans l'ensemble, la culture française est menacée ou enrichie par la présence de personnes d'autres pays venant vivre ici ?",
      "imma_clt_lo": "La culture est menacée",
      "imma_clt_hi": "La culture est enrichie",
      "imwbcnt": "Diriez-vous que la présence de personnes d'autres pays venant vivre en [country] rend la vie plus agréable ou moins agréable ? Veuillez utiliser cette liste de réponses.",
      "imma_wb_lo": "Moins agréable",
      "imma_wb_hi": "Plus agréable",
      "imma_head2": "Dans l'ensemble, diriez-vous que c'est mauvais ou bon pour l'économie française que des personnes d'autres pays viennent vivre en [country] ? Veuillez utiliser cette liste de réponses.",
      "debrief": "MERCI D'AVOIR PRIS LE TEMPS DE RÉPONDRE À CES QUESTIONS."
    },
    "he": {
      "imma_inst": "השאלות הבאות הן על אנשים מארצות אחרות הבאים לחיות ב[country].",
      "imsmetn": "באיזו מידה, לדעתך, [country] צריכה לאפשר לאנשים בני אותו גזע או אותה קבוצה אתנית כמו רוב תושביה, לבוא לחיות כאן?",
      "imdfetn": "מה לגבי אנשים מגזע או מקבוצה אתנית שונה מזו של רוב התושבים ב[country]?",
      "impcntr": "מה ביחס לאנשים מארצות עניות מחוץ לאירופה?",
      "imma_allow1": "לאפשר לרבים לבוא לחיות כאן",
      "imma_allow2": "לאפשר למספר מסוים",
      "imma_allow3": "לאפשר למעטים",
      "imma_allow4": "לא לאפשר לאף אחד",
      "imbgeco": "האם היית אומר/ת שבדרך כלל זה טוב או רע לכלכלת [country] שאנשים באים הנה מארצות אחרות?",
      "imma_eco_lo": "רע לכלכלה",
      "imma_eco_hi": "טוב לכלכלה",
      "imueclt": "האם היית אומר/ת שחיי התרבות ב[country] בדרך כלל נעשים דלים יותר או עשירים יותר על ידי האנשים שבאים מארצות אחרות לחיות כאן?",
      "imma_clt_lo": "חיי התרבות דלים יותר",
      "imma_clt_hi": "חיי התרבות עשירים יותר",
      "imwbcnt": "האם [country] נעשתה מקום טוב יותר או רע יותר לחיות בו על ידי האנשים שבאים מארצות אחרות לחיות כאן?",
      "imma_wb_lo": "מקום רע יותר לחיות",
      "imma_wb_hi": "מקום טוב יותר לחיות",
      "imma_head2": "האם היית אומר/ת שבדרך כלל זה טוב או רע לכלכלת [country] שאנשים באים הנה מארצות אחרות?",
      "debrief": ""
    },
    "hr": {
      "imma_inst": "Slijedi nekoliko pitanja u vezi sa ljudima koji dolaze iz drugih zemalja da žive u [country].",
      "imsmetn": "Sada, koristeći ovu karticu, što mislite, do koje mjere bi [country] trebala dopustiti ljudima iste rase ili etničkog podrijetla kao većina hrvatskog stanovništva da se dosele i žive ovdje?",
      "imdfetn": "A što je s ljudima drugačije rase ili etničkog podrijetla od većine hrvatskog stanovništva? I dalje koristite ovu karticu.",
      "impcntr": "A s ljudima iz siromašnijih zemalja izvan Europe? Koristite istu karticu.",
      "imma_allow1": "Dopustiti mnogima da se dosele i žive ovdje",
      "imma_allow2": "Dopustiti nekima",
      "imma_allow3": "Dopustiti tek manjem broju",
      "imma_allow4": "Ne dopustiti nikome",
      "imbgeco": "Što mislite, je li za hrvatsko gospodarstvo uglavnom loše ili dobro da se ljudi iz drugih zemalja doseljavaju i nastanjuju u [country]? Koristite ovu karticu.",
      "imma_eco_lo": "Loše za gospodarstvo",
      "imma_eco_hi": "Dobro za gospodarstvo",
      "imueclt": "Što mislite, koristeći ovu karticu, je li doseljavanje ljudi iz drugih zemalja ugrožava ili obogaćuje kulturni život [country]?",
      "imma_clt_lo": "To ugrožava kulturni život",
      "imma_clt_hi": "To obogaćuje kulturni život",
      "imwbcnt": "Postaje li [country] lošije ili bolje mjesto za život ako se u nju doseljavaju i nastanjuju ljudi iz drugih zemalja? Molim koristite ovu karticu.",
      "imma_wb_lo": "Lošije mjesto za život",
      "imma_wb_hi": "Bolje mjesto za život",
      "imma_head2": "Što mislite, je li za hrvatsko gospodarstvo uglavnom loše ili dobro da se ljudi iz drugih zemalja doseljavaju i nastanjuju u [country]? Koristite ovu karticu.",
      "debrief": ""
    },
    "hu": {
      "imma_inst": "Most néhány kérdést szeretnék feltenni a külföldről betelepülő emberekről.",
      "imsmetn": "Kérem mondja meg, hogy a magyarok többségével azonos etnikai és / vagy faji hátterű emberek mekkora részének engedné meg, hogy [country] jöjjön élni? Kérem, használja a 18. kártyalapot!",
      "imdfetn": "A magyarok többségétől eltérő etnikai és / vagy faji hátterű emberek mekkora részének engedné meg, hogy [country] jöjjön élni? Továbbra is használja a 18. kártyalapot!",
      "impcntr": "Az Európán kívüli szegényebb országokban élő emberek mekkora részének kellene megengedni, hogy [country] jöjjön élni? Továbbra is használja a 18. kártyalapot!",
      "imma_allow1": "sokuknak meg kellene engedni, hogy [country] jöjjenek élni",
      "imma_allow2": "jónéhányuknak meg kellene engedni",
      "imma_allow3": "keveseknek kellene megengedni",
      "imma_allow4": "senkinek nem kellene megengedni",
      "imbgeco": "Általában véve árt, vagy használ [country] gazdaságának, hogy más országokból idejönnek élni emberek? Kérem, használja a 19. kártyalapot!",
      "imma_eco_lo": "árt a gazdaságnak",
      "imma_eco_hi": "használ a gazdaságnak",
      "imueclt": "Mit mondana, [country] kulturális életének általában véve ártanak, vagy inkább gazdagítják, akik más országból idejönnek élni? Kérem, használja a 20. kártyalapot!",
      "imma_clt_lo": "ártanak a kulturális életnek",
      "imma_clt_hi": "gazdagítják a kulturális életet",
      "imwbcnt": "Rosszabb, vagy jobb hely lett-e [country] azzal, hogy más országból idejöttek emberek élni? Kérem, használja a 21. kártyalapot!",
      "imma_wb_lo": "rosszabb lett",
      "imma_wb_hi": "jobb lett",
      "imma_head2": "Általában véve árt, vagy használ [country] gazdaságának, hogy más országokból idejönnek élni emberek? Kérem, használja a 19. kártyalapot!",
      "debrief": "KÖSZÖNJÜK, HOGY IDŐT SZENTELT A KÉRDÉSEK MEGVÁLASZOLÁSÁRA!"
    },
    "is": {
      "imma_inst": "Nú koma nokkrar spurningar um fólk sem flust hefur frá öðrum löndum til búsetu á [country].",
      "imsmetn": "Ef þú notar þetta spjald til að svara, að hvaða marki ætti að leyfa fólki sem er af sama kynþætti eða hefur svipaðan menningarlegan uppruna og flestir Íslendingar að flytjast hingað til lands?",
      "imdfetn": "En hvað með fólk af öðrum kynþætti eða ólíkum menningarlegum uppruna en flestir Íslendingar? Notaðu enn þetta spjald.",
      "impcntr": "Hvað með fólk sem kemur frá fátækari löndum utan Evrópu? Notaðu enn sama spjaldið til að svara.",
      "imma_allow1": "Leyfa mörgum að flytjast hingað",
      "imma_allow2": "Leyfa nokkrum",
      "imma_allow3": "Leyfa fáeinum",
      "imma_allow4": "Ekki leyfa neinum",
      "imbgeco": "Almennt séð, telur þú að það sé gott eða slæmt fyrir efnahag [country] að fólk frá öðrum löndum flytjist hingað? Notaðu þetta spjald.",
      "imma_eco_lo": "Slæmt fyrir efnahaginn",
      "imma_eco_hi": "Gott fyrir efnahaginn",
      "imueclt": "Telur þú, almennt séð, að fólk frá öðrum löndum sem hingað flyst grafi undan eða auðgi íslenskt menningarlíf? Notaðu þetta spjald til að svara?",
      "imma_clt_lo": "Grefur undan menningarlífi",
      "imma_clt_hi": "Auðgar menningarlíf",
      "imwbcnt": "Gerir það [country] að verri eða betri stað til að búa á ef fólk frá öðrum löndum flyst hingað? Notaðu þetta spjald.",
      "imma_wb_lo": "Verri stað til að búa á",
      "imma_wb_hi": "Betri stað til að búa á",
      "imma_head2": "Almennt séð, telur þú að það sé gott eða slæmt fyrir efnahag [country] að fólk frá öðrum löndum flytjist hingað? Notaðu þetta spjald.",
      "debrief": ""
    },
    "it": {
      "imma_inst": "Ora le rivolgerò alcune domande sulle persone provenienti da altri Paesi che decidono di venire a vivere in [country].",
      "imsmetn": "Ora, usando questo cartellino, può indicare fino a che punto Lei pensa che l'[country] dovrebbe permettere alle persone etnicamente affini agli italiani di venire a vivere nel nostro Paese?",
      "imdfetn": "E riguardo alle persone di gruppi etnici differenti? Usi ancora questo cartellino.",
      "impcntr": "E riguardo alle persone provenienti dai Paesi extraeuropei più poveri? Usi ancora questo cartellino.",
      "imma_allow1": "Permettere a molti di venire a vivere qui",
      "imma_allow2": "Ad alcuni",
      "imma_allow3": "A pochi",
      "imma_allow4": "A nessuno",
      "imbgeco": "Secondo Lei, in generale, è un male o un bene per l'economia italiana che vi siano persone che vengono a vivere qui da altri Paesi? Usi questo cartellino.",
      "imma_eco_lo": "È un male per l'economia",
      "imma_eco_hi": "È un bene per l'economia",
      "imueclt": "Ritiene che la cultura italiana sia generalmente minacciata o arricchita dalla presenza di persone che vengono a vivere qui da altri Paesi?",
      "imma_clt_lo": "La cultura italiana è minacciata",
      "imma_clt_hi": "La cultura italiana è arricchita",
      "imwbcnt": "L'arrivo di persone provenienti da altri Paesi ha reso l'[country] un posto peggiore o migliore in cui vivere? Usi questo cartellino.",
      "imma_wb_lo": "Un posto peggiore",
      "imma_wb_hi": "Un posto migliore",
      "imma_head2": "Secondo Lei, in generale, è un male o un bene per l'economia italiana che vi siano persone che vengono a vivere qui da altri Paesi? Usi questo cartellino.",
      "debrief": ""
    },
    "lt": {
      "imma_inst": "O dabar užduosiu keletą klausimų apie žmones, atvažiuojančius gyventi į [country] iš kitų šalių.",
      "imsmetn": "Naudodamiesi šia kortele, atsakykite, ar reiktų, jūsų nuomone, leisti tos pačios rasės ar etninės grupės žmonėms, kokių dauguma gyvena [country], atvykti ir gyventi [country]?",
      "imdfetn": "O ką šiuo klausimu jūs manote apie žmones, kurių rasė ar etninė grupė yra kitokia, nei daugumos [country] gyventojų? Atsakykite naudodamiesi ta pačia kortele.",
      "impcntr": "O ką šiuo klausimu jūs manote apie žmones iš vargingesnių šalių, esančių už Europos ribų? Atsakykite naudodamiesi ta pačia kortele.",
      "imma_allow1": "Daugeliui reiktų leisti atvykti ir gyventi [country]",
      "imma_allow2": "Reiktų leisti ribotam kiekiui",
      "imma_allow3": "Reiktų leisti vienam kitam",
      "imma_allow4": "Neleisti nei vienam",
      "imbgeco": "Kaip jūs manote, ar apskritai [country] ekonomikai yra blogai ar gerai, kad žmonės iš kitų šalių atvyksta čia gyventi? Atsakykite naudodamiesi šia kortele.",
      "imma_eco_lo": "Ekonomikai yra blogai",
      "imma_eco_hi": "Ekonomikai yra gerai",
      "imueclt": "Toliau, naudodamiesi šia kortele, atsakykite, kaip jūs manote, ar žmonės, atvykstantys čia gyventi iš kitų šalių daugiau griauna [country] kultūrinį gyvenimą ar jį turtina?",
      "imma_clt_lo": "Griauna kultūrinį gyvenimą",
      "imma_clt_hi": "Turtina kultūrinį gyvenimą",
      "imwbcnt": "O [country] dėl žmonių, atvykstančių čia gyventi iš kitų šalių, tampa blogesne, ar geresne vieta gyventi? Atsakykite naudodamiesi šia kortele.",
      "imma_wb_lo": "Blogesnė vieta gyventi",
      "imma_wb_hi": "Geresnė vieta gyventi",
      "imma_head2": "Kaip jūs manote, ar apskritai [country] ekonomikai yra blogai ar gerai, kad žmonės iš kitų šalių atvyksta čia gyventi? Atsakykite naudodamiesi šia kortele.",
      "debrief": ""
    },
    "lv": {
      "imma_inst": "Nākamie jautājumi ir par citu valstu iedzīvotāju pārcelšanos dzīvot uz [country].",
      "imsmetn": "Cik lielā mērā [country] vajadzētu atļaut tās pašas rases vai etniskās grupas cilvēkiem, kāda ir lielākā daļa [country] iedzīvotāju, pārcelties uz dzīvi šeit?",
      "imdfetn": "Un kā būtu ar citas rases vai etniskās grupas (nekā lielākā daļa [country] iedzīvotāju) cilvēkiem?",
      "impcntr": "Un cilvēkiem no nabadzīgākām valstīm ārpus Eiropas?",
      "imma_allow1": "Jāatļauj daudziem pārcelties uz dzīvi šeit",
      "imma_allow2": "Jāatļauj nedaudziem",
      "imma_allow3": "Jāatļauj tikai dažiem",
      "imma_allow4": "Nav jāatļauj nevienam",
      "imbgeco": "Kā jūs teiktu, vai tas, ka citu valstu iedzīvotāji pārceļas uz dzīvi šeit, ir labi vai slikti [country] ekonomikai?",
      "imma_eco_lo": "Tas ir slikti ekonomikai",
      "imma_eco_hi": "Tas ir labi ekonomikai",
      "imueclt": "Vai, jūsuprāt, cilvēki, kas pārceļas uz dzīvi šeit no citām valstīm, grauj vai bagātina [country] kultūras dzīvi?",
      "imma_clt_lo": "Grauj kultūras dzīvi",
      "imma_clt_hi": "Bagātina kultūras dzīvi",
      "imwbcnt": "Vai tas, ka uz šejieni pārceļas dzīvot cilvēki no citām valstīm, padara [country] par sliktāku vai labāku vietu dzīvošanai?",
      "imma_wb_lo": "Sliktāka vieta dzīvošanai",
      "imma_wb_hi": "Labāka vieta dzīvošanai",
      "imma_head2": "Kā jūs teiktu, vai tas, ka citu valstu iedzīvotāji pārceļas uz dzīvi šeit, ir labi vai slikti [country] ekonomikai?",
      "debrief": ""
    },
    "mk": {
      "imma_inst": "Сега следуваат неколку прашања во врска со луѓе од други земји кои доаѓаат да живеат во [country].",
      "imsmetn": "Сега, користејќи ја оваа показна карта, наведете во која мера сметате дека [country] би требало да дозволи луѓе од истата раса или етничка група како повеќето луѓе во [country] да дојдат и да живеат овде?",
      "imdfetn": "А дали би требало да дозволи на луѓе од различна раса или етничка група од повеќето луѓе во [country]? Сè уште користете ја оваа показна карта.",
      "impcntr": "А, дали би требало да им дозволи на луѓе од посиромашните земји надвор од Европа? Користете ја истата показна карта.",
      "imma_allow1": "Треба да дозволи на многу такви луѓе да дојдат и да живеат овде",
      "imma_allow2": "Треба да им дозволи на некои од нив",
      "imma_allow3": "Треба да дозволи на многу мал број",
      "imma_allow4": "Воопшто не треба да дозволи",
      "imbgeco": "Дали сметате дека во целина е лошо или добро за економијата на [country] кога луѓе од други земји доаѓаат да живеат овде? Ве молам користете ја оваа показна карта.",
      "imma_eco_lo": "Лошо за економијата",
      "imma_eco_hi": "Добро за економијата",
      "imueclt": "Користејќи ја оваа показна карта, одговорете дали во целина културниот живот во [country] се нарушува или се збогатува кога луѓе од други земји доаѓаат да живеат овде?",
      "imma_clt_lo": "Културниот живот се нарушува",
      "imma_clt_hi": "Културниот живот се збогатува",
      "imwbcnt": "Дали [country] станала полошо или подобро место за живеење поради луѓето од други земји кои доаѓаат да живеат овде? Ве молам користете ја оваа показна карта.",
      "imma_wb_lo": "Полошо место за живеење",
      "imma_wb_hi": "Подобро место за живеење",
      "imma_head2": "Дали сметате дека во целина е лошо или добро за економијата на [country] кога луѓе од други земји доаѓаат да живеат овде? Ве молам користете ја оваа показна карта.",
      "debrief": ""
    },
    "nl": {
      "imma_inst": "Nu volgen enkele vragen over mensen uit andere landen die in [country] komen wonen.",
      "imsmetn": "Gebruik deze kaart. In welke mate vindt u dat [country] mensen van dezelfde huidskleur of dezelfde etnische groep als de meeste [country] zou moeten toelaten om hier te komen wonen en leven? Het [country] beleid moet...?",
      "imdfetn": "En wat is uw mening met betrekking tot mensen van een andere huidskleur of etnische groep dan de meeste [country]? Het [country] beleid moet... Gebruik nog steeds deze kaart.",
      "impcntr": "En wat is uw mening met betrekking tot mensen uit de armere landen buiten Europa? Gebruik dezelfde kaart.",
      "imma_allow1": "Velen toelaten om hier te komen wonen en leven",
      "imma_allow2": "Een aantal toelaten",
      "imma_allow3": "Enkelen toelaten",
      "imma_allow4": "Niemand toelaten",
      "imbgeco": "Is het volgens u over het algemeen slecht of goed voor de [country] economie dat mensen uit andere landen hier komen wonen? Gebruik deze kaart.",
      "imma_eco_lo": "Slecht voor de economie",
      "imma_eco_hi": "Goed voor de economie",
      "imueclt": "Vindt u dat het culturele leven in [country] over het algemeen ondermijnd of verrijkt is door mensen uit andere landen die hier zijn komen wonen? Gebruik deze kaart.",
      "imma_clt_lo": "Culturele leven is ondermijnd",
      "imma_clt_hi": "Culturele leven is verrijkt",
      "imwbcnt": "Is [country], door mensen uit andere landen die hier zijn komen wonen, een slechtere of een betere plek geworden om te wonen? Gebruik deze kaart.",
      "imma_wb_lo": "Slechtere plek om te wonen",
      "imma_wb_hi": "Betere plek om te wonen",
      "imma_head2": "Is het volgens u over het algemeen slecht of goed voor de [country] economie dat mensen uit andere landen hier komen wonen? Gebruik deze kaart.",
      "debrief": ""
    },
    "no": {
      "imma_inst": "Her er noen spørsmål om folk som kommer til [country] for å bosette seg her.",
      "imsmetn": "Bruk dette kortet. I hvilken utstrekning synes du at [country] bør la folk med samme hudfarge eller etniske tilhørighet som de fleste i [country], få bosette seg her?",
      "imdfetn": "Hva med folk med en annen hudfarge eller etnisk tilhørighet enn de fleste i [country]? Bruk det samme kortet.",
      "impcntr": "Hva med folk fra fattige land utenfor Europa? Bruk det samme kortet.",
      "imma_allow1": "La mange bosette seg her",
      "imma_allow2": "La noen bosette seg her",
      "imma_allow3": "La enkelte bosette seg her",
      "imma_allow4": "Ikke la noen bosette seg her",
      "imbgeco": "Vil du si at det, alt i alt, er bra eller dårlig for den norske økonomien at folk kommer fra andre land for å bosette seg her? Bruk kortet til å svare.",
      "imma_eco_lo": "Dårlig for økonomien",
      "imma_eco_hi": "Bra for økonomien",
      "imueclt": "Vil du si at norsk kultur stort sett blir undergravet eller beriket av folk som kommer fra andre land for å bosette seg her? Bruk kortet til å svare.",
      "imma_clt_lo": "Norsk kultur blir undergravet",
      "imma_clt_hi": "Norsk kultur blir beriket",
      "imwbcnt": "Er det blitt verre eller bedre å bo i [country] på grunn av at folk kommer fra andre land for å bosette seg her? Bruk kortet til å svare.",
      "imma_wb_lo": "Et verre sted å bo",
      "imma_wb_hi": "Et bedre sted å bo",
      "imma_head2": "Vil du si at det, alt i alt, er bra eller dårlig for den norske økonomien at folk kommer fra andre land for å bosette seg her? Bruk kortet til å svare.",
      "debrief": "TAKK FOR AT DU TOK DEG TID TIL Å SVARE PÅ DISSE SPØRSMÅLENE"
    },
    "pl": {
      "imma_inst": "Kolejne pytania będą dotyczyć ludzi z innych krajów, którzy przyjeżdżają, aby żyć w [country].",
      "imsmetn": "W jakim zakresie, Pana zdaniem, państwo polskie powinno zezwalać ludziom należącym do tej samej rasy lub grupy etnicznej, co większość mieszkańców [country], na przyjazd i zamieszkanie w [country]?",
      "imdfetn": "A jeśli chodzi o ludzi należących do innej rasy lub grupy etnicznej niż większość mieszkańców [country]?",
      "impcntr": "A jeśli chodzi o ludzi z biedniejszych krajów spoza Europy?",
      "imma_allow1": "Zezwalać dużej liczbie osób na przyjazd i zamieszkanie w [country]",
      "imma_allow2": "Zezwalać pewnej liczbie osób",
      "imma_allow3": "Zezwalać tylko nielicznym",
      "imma_allow4": "Nie zezwalać nikomu",
      "imbgeco": "Czy Pana zdaniem to, że ludzie z innych krajów przyjeżdżają, aby żyć w [country], jest ogólnie biorąc korzystne, czy też niekorzystne dla polskiej gospodarki?",
      "imma_eco_lo": "Niekorzystne dla gospodarki",
      "imma_eco_hi": "Korzystne dla gospodarki",
      "imueclt": "Czy Pana zdaniem to, że ludzie z innych krajów przyjeżdżają, aby żyć w [country], ogólnie biorąc, szkodzi życiu kulturalnemu w [country], czy też je wzbogaca?",
      "imma_clt_lo": "Szkodzi życiu kulturalnemu",
      "imma_clt_hi": "Wzbogaca życie kulturalne",
      "imwbcnt": "Czy w wyniku tego, że ludzie z innych krajów przyjeżdżają do [country] i żyją tutaj, [country] stała się gorszym czy lepszym miejscem do życia?",
      "imma_wb_lo": "Gorszym miejscem do życia",
      "imma_wb_hi": "Lepszym miejscem do życia",
      "imma_head2": "Czy Pana zdaniem to, że ludzie z innych krajów przyjeżdżają, aby żyć w [country], jest ogólnie biorąc korzystne, czy też niekorzystne dla polskiej gospodarki?",
      "debrief": "Dziękujemy za udział w badaniu."
    },
    "pt": {
      "imma_inst": "VOU AGORA FAZER-LHE ALGUMAS PERGUNTAS SOBRE MIGRAÇÕES",
      "imsmetn": "Em que medida acha que [country] deve deixar que pessoas da mesma raça ou grupo étnico do que a maioria portuguesa venham e fiquem a viver cá?",
      "imdfetn": "E em que medida acha que [country] deve deixar que pessoas de raça ou grupo étnico diferente do que a maioria portuguesa venham e fiquem a viver cá? Utilizando ainda este cartão.",
      "impcntr": "E em que medida [country] deve deixar que pessoas dos países mais pobres fora da Europa venham e fiquem a viver cá? Use o mesmo cartão.",
      "imma_allow1": "Deve deixar vir muitas pessoas",
      "imma_allow2": "Deve deixar vir algumas pessoas",
      "imma_allow3": "Deve deixar vir poucas pessoas",
      "imma_allow4": "Não deve deixar vir ninguém",
      "imbgeco": "Continuando a pensar nas pessoas que vêm viver e trabalhar para [country], acha que isso é mau ou bom para a economia portuguesa? Por favor use este cartão.",
      "imma_eco_lo": "Mau para a economia",
      "imma_eco_hi": "Bom para a economia",
      "imueclt": "E acha que essas pessoas empobrecem ou enriquecem os costumes, as tradições e a vida cultural em [country]?",
      "imma_clt_lo": "Empobrecem a vida cultural",
      "imma_clt_hi": "Enriquecem a vida cultural",
      "imwbcnt": "[country] tornou-se um lugar pior ou melhor para se viver com a vinda de pessoas de outros países para cá?",
      "imma_wb_lo": "Tornou-se um lugar pior para viver",
      "imma_wb_hi": "Tornou-se um lugar melhor para viver",
      "imma_head2": "Continuando a pensar nas pessoas que vêm viver e trabalhar para [country], acha que isso é mau ou bom para a economia portuguesa? Por favor use este cartão.",
      "debrief": ""
    },
    "ru": {
      "imma_inst": "Теперь несколько вопросов о людях из других стран, которые приезжают жить в [country].",
      "imsmetn": "Ответьте насколько, по вашему мнению, [country] государство должно позволять людям той же расы или национальности, что и большинство населения [country], приезжать сюда жить. Для ответа используйте карточку 18. Политика [country] государства должна…",
      "imdfetn": "Как насчет людей, которые по расовой или национальной принадлежности отличаются от большинства населения [country]? Для ответа используйте карточку 18. Политика [country] государства должна…",
      "impcntr": "Как насчет людей из более бедных стран за пределами Европы? Для ответа используйте карточку 18. Политика [country] государства должна…",
      "imma_allow1": "... разрешить многим приехать сюда жить",
      "imma_allow2": "... разрешить некоторым приехать сюда жить",
      "imma_allow3": "... разрешить очень немногим приехать сюда жить",
      "imma_allow4": "... не разрешать никому",
      "imbgeco": "Как Вы считаете, в целом то что люди из других стран приезжают сюда жить, это хорошо или плохо для экономики [country]? Для ответа используйте карточку 19.",
      "imma_eco_lo": "Плохо для экономики",
      "imma_eco_hi": "Хорошо для экономики",
      "imueclt": "Используя эту карточку, скажите, считаете ли Вы, что люди, приезжающие из других стран, в общем разрушают культурную жизнь [country], или что они ее обогащают? Для ответа используйте карточку 20.",
      "imma_clt_lo": "Культурная жизнь разрушается",
      "imma_clt_hi": "Культурная жизнь обогащается",
      "imwbcnt": "Делают ли люди, приезжающие жить в [country] из других стран, ее лучшим или худшим местом для жизни? Для ответа используйте карточку 21.",
      "imma_wb_lo": "Хуже место для жизни",
      "imma_wb_hi": "Лучше место для жизни",
      "imma_head2": "Как Вы считаете, в целом то что люди из других стран приезжают сюда жить, это хорошо или плохо для экономики [country]? Для ответа используйте карточку 19.",
      "debrief": ""
    },
    "sk": {
      "imma_inst": "Teraz tu je niekoľko otázok o ľuďoch z iných krajín, ktorí prichádzajú žiť na [country].",
      "imsmetn": "Teraz, použitím tejto karty, do akej miery si myslíte, že by politika [country] mala dovoliť ľuďom rovnakej rasy alebo etnika ako je väčšina Slovákov, aby prišli na [country] a žili tu?",
      "imdfetn": "A čo ľudia inej rasy alebo etnickej skupiny ako je väčšina Slovákov? Používajte stále túto kartu.",
      "impcntr": "A čo ľudia z chudobnejších krajín mimo Európy? Použite tú istú kartu.",
      "imma_allow1": "Dovoliť mnohým, aby sem prišli a žili tu",
      "imma_allow2": "Dovoliť to niekoľkým",
      "imma_allow3": "Dovoliť to máloktorým",
      "imma_allow4": "Nedovoliť to žiadnym",
      "imbgeco": "Povedali by ste, že je vo všeobecnosti zlé alebo dobré pre slovenskú ekonomiku, keď sem prichádzajú žiť ľudia z iných krajín? Prosím, použite túto kartu.",
      "imma_eco_lo": "Zlé pre ekonomiku",
      "imma_eco_hi": "Dobré pre ekonomiku",
      "imueclt": "A, použitím tejto karty, povedali by ste, že kultúrny život na [country] je vo všeobecnosti ohrozovaný alebo obohacovaný ľuďmi, ktorí sem prídu žiť z iných krajín?",
      "imma_clt_lo": "Kultúrny život je ohrozovaný",
      "imma_clt_hi": "Kultúrny život je obohacovaný",
      "imwbcnt": "Žije sa na [country] horšie alebo lepšie preto, že sem prichádzajú ľudia z iných krajín? Prosím, použite túto kartu.",
      "imma_wb_lo": "Žije sa horšie",
      "imma_wb_hi": "Žije sa lepšie",
      "imma_head2": "Povedali by ste, že je vo všeobecnosti zlé alebo dobré pre slovenskú ekonomiku, keď sem prichádzajú žiť ľudia z iných krajín? Prosím, použite túto kartu.",
      "debrief": ""
    },
    "sl": {
      "imma_inst": "Sedaj pa sledi nekaj vprašanj o ljudeh iz drugih držav, ki prihajajo živet v [country]...",
      "imsmetn": "Kaj menite, v kolikšnem obsegu naj [country] dovoli priseljevanje ljudi s podobnim narodnostnim izvorom, kot ga ima večina prebivalcev [country]?",
      "imdfetn": "Kaj pa ljudem z drugačnim narodnostnim izvorom, kot ga ima večina prebivalcev [country]?",
      "impcntr": "V kolikšnem obsegu naj [country] dovoli priseljevanje ljudi iz revnejših držav zunaj Evrope?",
      "imma_allow1": "mnogim naj dovoli priselitev",
      "imma_allow2": "nekaterim naj dovoli",
      "imma_allow3": "zelo redkim naj dovoli",
      "imma_allow4": "nikomur naj ne dovoli priselitve",
      "imbgeco": "Ali menite, da je na splošno dobro ali slabo za slovensko gospodarstvo, da prihajajo živet k nam priseljenci iz drugih držav?",
      "imma_eco_lo": "slabo za gospodarstvo",
      "imma_eco_hi": "dobro za gospodarstvo",
      "imueclt": "Ali menite, da je kulturno življenje v [country] zaradi priseljencev na splošno ogroženo ali obogateno?",
      "imma_clt_lo": "kulturno življenje je ogroženo",
      "imma_clt_hi": "kulturno življenje je obogateno",
      "imwbcnt": "Ali menite, da je [country] zaradi priseljencev iz drugih držav postala slabša ali boljša dežela za bivanje?",
      "imma_wb_lo": "slabša dežela za bivanje",
      "imma_wb_hi": "boljša dežela za bivanje",
      "imma_head2": "Ali menite, da je na splošno dobro ali slabo za slovensko gospodarstvo, da prihajajo živet k nam priseljenci iz drugih držav?",
      "debrief": ""
    },
