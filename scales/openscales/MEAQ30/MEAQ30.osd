{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "MEAQ30",
      "name": "Multidimensional Experiential Avoidance Questionnaire – 30",
      "abbreviation": "MEAQ-30",
      "description": "30-item scale measuring six facets of experiential avoidance: behavioral avoidance, distress aversion, procrastination, distraction/suppression, repression/denial, and distress endurance (scored inversely — high scores indicate low avoidance).",
      "citation": "Sahdra, B. K., Ciarrochi, J., Parker, P., & Scrucca, L. (2016). Using genetic algorithms in a large nationally representative American sample to abbreviate the Multidimensional Experiential Avoidance Questionnaire. Frontiers in Psychology, 7. https://doi.org/10.3389/fpsyg.2016.00189",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2016.00189",
      "version": "1.0",
      "domain": "Self & Coping"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default":  0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 6,
      "min": 1,
      "labels": [
        "MEAQ30_r1", "MEAQ30_r2", "MEAQ30_r3",
        "MEAQ30_r4", "MEAQ30_r5", "MEAQ30_r6"
      ],
      "question_head": "MEAQ30_head"
    },
    "dimensions": [
      {
        "id": "BA",
        "name": "Behavioral Avoidance",
        "description": "Avoiding activities or situations to prevent discomfort"
      },
      {
        "id": "DA",
        "name": "Distress Aversion",
        "description": "Desire to eliminate or escape painful emotions"
      },
      {
        "id": "PR",
        "name": "Procrastination",
        "description": "Putting off unpleasant tasks or responsibilities"
      },
      {
        "id": "DS",
        "name": "Distraction and Suppression",
        "description": "Distracting from or suppressing negative thoughts and feelings"
      },
      {
        "id": "RD",
        "name": "Repression/Denial",
        "description": "Lack of awareness of one's emotions and problems"
      },
      {
        "id": "DE",
        "name": "Distress Endurance",
        "description": "Ability to persist despite discomfort (high scores = low avoidance)"
      }
    ],
    "items": [
      { "id": "MEAQ30001", "type": "likert", "text_key": "MEAQ30001", "dimension": "BA" },
      { "id": "MEAQ30002", "type": "likert", "text_key": "MEAQ30002", "dimension": "BA" },
      { "id": "MEAQ30003", "type": "likert", "text_key": "MEAQ30003", "dimension": "BA" },
