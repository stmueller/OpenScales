      "ipip_H365": "Je vais droit au but.",
      "ipip_X167": "Je mets peu de temps et d'efforts dans mon travail.",
      "ipip_X71": "J'adore rêvasser.",
      "ipip_H871": "J'agis de façon téméraire.",
      "ipip_H1438": "Je ne comprends pas les choses.",
      "ipip_H1205": "Je cherche mes mots",
      "ipip_X113": "Je fais semblant de me préoccuper des autres.",
      "ipip_X133": "Je fais des excès.",
      "ipip_H631": "Je réagis lentement.",
      "ipip_H145": "Je dis la vérité.",
      "ipip_E105": "Je vois une beauté dans les choses que d'autres pourraient ne pas remarquer.",
      "ipip_X202": "Je ne suis pas facilement affecté par mes émotions.",
      "ipip_H679": "Je retiens mes opinions.",
      "ipip_X15": "Je ne m'aime pas.",
      "ipip_X86": "Je n'aime pas l'art.",
