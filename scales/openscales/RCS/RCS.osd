      },
      {
        "id": "RCS010",
        "type": "likert",
        "text_key": "RCS010",
        "dimension": "RecyclingCost"
      }
    ],
    "scoring": {
      "CostlessSaving": {
        "method": "mean_coded",
        "description": "Mean of items 1–4 (costless saving behaviors)",
        "items": {
          "RCS001": 1,
          "RCS002": 1,
          "RCS003": 1,
          "RCS004": 1
        }
      },
      "CostlySaving": {
        "method": "mean_coded",
        "description": "Mean of items 5–6 (costly saving behaviors)",
        "items": {
          "RCS005": 1,
          "RCS006": 1
        }
      },
      "RecyclingCost": {
        "method": "mean_coded",
        "description": "Mean of items 7–10; item 10 reverse-scored. Higher scores indicate higher perceived recycling cost.",
        "items": {
          "RCS007": 1,
          "RCS008": 1,
          "RCS009": 1,
          "RCS010": -1
        }
      }
    }
  },
  "translations": {
    "en": {
      "RCS_head": "To what extent are the following statements consistent with your actual situation?",
      "RCS_r1": "Very inconsistent",
      "RCS_r7": "Very consistent",
      "RCS001": "Retain printed papers with a clean side.",
      "RCS002": "Turn off the lights after use.",
      "RCS003": "Shut off water while applying bath foam.",
      "RCS004": "Use toothpaste to completely squeeze out.",
      "RCS005": "Take shopping bags with you.",
      "RCS006": "Wear worn-out socks.",
      "RCS007": "I spend time on recycling.",
      "RCS008": "I paid mental efforts for recycling.",
      "RCS009": "I paid extra money for recycling.",
      "RCS010": "Recycling is easy for me."
    }
  }
}