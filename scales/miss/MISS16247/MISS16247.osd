{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Democratic Values Scale for Children",
      "code": "MISS16247",
      "abbreviation": "DVS-C",
      "description": "A 22-item instrument measuring five democratic values in primary school children (grades 3–4, ages ~8–9): Participation (10 items), Equality (4 items), Following Rules (2 items), Renunciation of Violence (2 items), and Freedom of Opinion (4 items). Each subscale uses a distinct categorical response format; all items are dummy-coded (0/1) with the democratic response scored as 1. Validated in Germany (N=429). Equality, Following Rules, and Renunciation of Violence show strongest psychometric properties; Participation and Freedom of Opinion require further revision. Administered orally to children. German is the original language; English translations are provided in the paper.",
      "citation": "Monstadt, F. C. (2025). Measuring democratic values in primary school children: Development and confirmatory factor analysis of a new survey instrument. Measurement Instruments for the Social Sciences, 7, Article e16247. https://doi.org/10.5964/miss.16247",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/16247",
      "domain": "Social",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "German original; English item text translated by Monstadt (2025) and reproduced here. German equality subscale question head (equ_stem) and item texts sourced from supplementary materials of Monstadt (2025), Zeitschrift für Politikwissenschaft, https://doi.org/10.1007/s41358-025-00414-z (open access). All items use categorical response formats with binary (0/1) democratic scoring. Participation and Freedom of Opinion subscales showed weaker reliability and validity in the validation study; authors recommend prioritizing Equality, Following Rules, and Renunciation of Violence subscales. Items free_gen and free_man have severe ceiling effects (98% and 89% agreement respectively). Designed for administration to children ages 8–9; not validated for other populations."
    },
    "dimensions": [
      {
        "id": "participation",
        "name": "Participation",
        "abbreviation": "PAR",
        "description": "Endorsement of democratic (majority vote) decision-making in school scenarios. Sum of 10 items (0/1); range 0–10; higher = stronger democratic participation orientation. Weaker reliability in validation (KR-20 = .42)."
      },
      {
        "id": "equality",
        "name": "Equality",
        "abbreviation": "EQU",
        "description": "Endorsement of gender-equal access to activities and roles. Sum of 4 items (0/1); range 0–4; higher = stronger equality orientation. (KR-20 = .42)"
      },
      {
        "id": "following_rules",
        "name": "Following Rules",
        "abbreviation": "RUL",
        "description": "Perceived importance of having and following school rules. Sum of 2 items (0/1); range 0–2; higher = stronger rule-following orientation. (r = .36)"
      },
      {
        "id": "renunciation_violence",
        "name": "Renunciation of Violence",
        "abbreviation": "VIO",
        "description": "Rejection of physical violence as acceptable. Sum of 2 items (0/1); range 0–2; higher = stronger rejection of violence. (r = .21)"
      },
      {
        "id": "freedom_opinion",
        "name": "Freedom of Opinion",
        "abbreviation": "FREE",
        "description": "Support for freedom of expression and dissent. Sum of 4 items (0/1); range 0–4; higher = stronger support for freedom of opinion. Weakest reliability in validation; items free_gen and free_man have ceiling effects."
      }
    ],
