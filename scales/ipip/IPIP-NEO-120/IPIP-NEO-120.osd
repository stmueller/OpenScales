      "ipip_H655": "Am afraid to draw attention to myself.",
      "ipip_H656": "Only feel comfortable with friends.",
      "ipip_X209": "Am not bothered by difficult social situations.",
      "ipip_X133": "Go on binges.",
      "ipip_X274": "Easily resist temptations.",
      "ipip_X181": "Rarely Overindulge",
      "ipip_X251": "Am able to control my cravings.",
      "ipip_H948": "Panic easily.",
      "ipip_H959": "Become overwhelmed by events.",
      "ipip_H954": "Feel that I'm unable to deal with things.",
      "ipip_X79": "Remain calm under pressure.",
      "ipip_H29": "Make friends easily.",
      "ipip_H648": "Avoid contacts with others.",
      "ipip_H704": "Keep others at a distance.",
      "ipip_H587": "Prefer to be alone.",
      "ipip_H650": "Avoid crowds.",
