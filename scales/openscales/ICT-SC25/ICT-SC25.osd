{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ICT-SC25",
      "name": "ICT Self-Concept Scale (ICT-SC25)",
      "abbreviation": "ICT-SC25",
      "description": "25-item ICT Self-Concept Scale measuring self-concept in using digital systems across six subscales (general ICT self-concept plus five domain-specific facets: communicate, process and store, generate content, safe application, solve problems). 6-point fully-labeled agreement scale. All items positively keyed; subscale score is the mean of its items.",
      "citation": "Schauffel, N., Schmidt, I., Peiffer, H., & Ellwart, T. (2021). ICT Self-Concept Scale (ICT-SC25). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis308_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis308_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Schauffel-et-al.-ICT-Self-Concept-Scale-(ICT-SC25)",
      "version": "1.0",
      "domain": "Technology"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "ICT Self-Concept Scale (Schauffel et al., 2021). CC BY 4.0. 6-point fully-labeled agreement scale; the ZIS documentation quotes only the endpoints (strongly disagree 1 - strongly agree 6), so middle points are left to the runner's numbering. All 25 items positively keyed. One general subscale (items 1-5) plus five domain-specific subscales (4 items each). Score each subscale as the mean of its items; either the whole scale or single subscales may be used (first-order-correlated-factor or bi-factor models). No reverse coding. German item wordings and instruction from the same CC-BY ZIS document; German 6-point endpoint anchors use the standard agreement labels (Stimme überhaupt nicht zu / Stimme voll und ganz zu)."
    },
