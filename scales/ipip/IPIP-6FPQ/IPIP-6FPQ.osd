    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_P431": "Ne prihvatam krivicu za nešto što nisam uradio.",
      "ipip_H755": "Često gubim živce.",
      "ipip_H1047": "Često dozvoljavam da me drugi usmeravaju.",
      "ipip_P374": "Imam slobodnog vremena.",
      "ipip_P491": "Ponašam se upadljivo da bih impresionirao druge.",
      "ipip_H896": "Često nešto zabrljam.",
      "ipip_H1356": "Imam oko za detalje.",
      "ipip_H965": "Ne mogu bez društva drugih ljudi.",
      "ipip_H1265": "Volim da učim nešto novo.",
      "ipip_E172": "Nikada ne mogu ništa da pronađem.",
      "ipip_X239": "Ne zanimaju me teorijske rasprave.",
      "ipip_H871": "Često se ponašam divlje i razuzdano.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_H1052": "Sklon sam da pristanem na bilo šta.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_P432": "Imam prirodni talenat da utičem na druge ljude.",
      "ipip_X264": "Ne volim da putujem.",
      "ipip_P420": "Brinem o tome šta drugi misle o meni.",
      "ipip_H974": "Potrebno mi je odobravanje drugih.",
      "ipip_H969": "Potreban mi je podsticaj da bih nešto započeo.",
      "ipip_P486": "Nije mi važno da li me smatraju posebnim.",
      "ipip_P441": "Praviću se važan ako mi se ukaže prilika za to.",
      "ipip_X104": "Volim da posećujem nova mesta.",
      "ipip_H627": "Provodim vreme ne radeći ništa.",
      "ipip_P468": "Nisam dobar u pričanju viceva.",
      "ipip_E158": "Stalno gubim stvari.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_H507": "Volim da moja reč bude poslednja.",
      "ipip_P444": "Mogao bih da budem dobar glumac.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_H62": "Pričam o onome što me brine.",
      "ipip_H1185": "Umem da uživam.",
      "ipip_H446": "Tragam za pustolovinama.",
      "ipip_P341": "Ne volim da budem autoritet drugima",
      "ipip_H2027": "Volim da čitam.",
      "ipip_X243": "Ne volim da gledam plesne nastupe.",
      "ipip_H356": "Mogu da podnesem kritiku.",
      "ipip_H366": "Mnoge stvari radim po svome.",
      "ipip_H1068": "Prihvatam savete.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_H1170": "Mogu puno toga da tolerišem drugima.",
      "ipip_X88": "Uživam da provodim vreme sam.",
      "ipip_H439": "Efikasno obavim svaki posao.",
      "ipip_X159": "Mislim da posao nije važan deo mog života.",
      "ipip_H961": "Tražim podršku od drugih ljudi.",
      "ipip_H1213": "Želim da uvećam svoje znanje.",
      "ipip_H498": "Suprotstavljam se autoritetu.",
      "ipip_H1246": "Dobar sam u mnogim stvarima.",
      "ipip_H1285": "Obavljam zadatke uspešno.",
      "ipip_P346": "Nemam talenat da utičem na druge.",
      "ipip_H1171": "Teško mi je da prionem na posao.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_P472": "Konstantno sam pod pritiskom.",
      "ipip_H1063": "Ne volim promene.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_H992": "Lako se rasplačem.",
      "ipip_P448": "Imam previše posla.",
      "ipip_H400": "Idem svojim putem.",
      "ipip_H1366": "Vešt sam u socijalnim situacijama.",
      "ipip_H244": "Volim da spremam.",
      "ipip_P430": "Nisam dobar u sticanju naklonosti drugih.",
      "ipip_H1093": "Zabavljam svoje prijatelje.",
      "ipip_H747": "Trudim se da steknem visok društveni položaj.",
      "ipip_X231": "Retko se naljutim.",
      "ipip_P409": "Verujem da događaji u mom životu zavise samo od mene.",
      "ipip_H5": "Uzbuđuju me nove ideje.",
      "ipip_H1087": "Često razočaram druge ljude.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_H762": "Lako se uvredim.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_P401": "Volim da dobijam komplimente.",
      "ipip_E144": "Prihvatam stvari onakve kakve su.",
      "ipip_H862": "Nepromišljeno se upuštam u razne stvari.",
      "ipip_X147": "Moja iskustva nisu baš zanimljiva.",
      "ipip_H793": "Želim da budem glavni.",
      "ipip_H404": "Držim se svog puta.",
      "ipip_H1460": "Većinu stvari radim po navici.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_X79": "Ostajem smiren/a kada sam pod pritiskom.",
      "ipip_H673": "Biram reči sa oprezom.",
      "ipip_P416": "Stalno imam modernu frizuru.",
      "ipip_X118": "Volim red.",
      "ipip_H648": "Izbegavam kontakte sa drugima.",
      "ipip_H575": "Ne marim za pravila.",
      "ipip_X144": "Ne volim koncerte.",
