      "ipip_H1174": "Ističem se u onome što radim.",
      "ipip_H69": "Prionem na zadatak svim srcem.",
      "ipip_P384": "Ne volim da budem daleko od civilizacije.",
      "ipip_H1144": "Lako odustajem.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_P455": "Već sam dobio više nego što sam zaslužio.",
      "ipip_H659": "Živim u svom svetu.",
      "ipip_H296": "Poštujem autoritete.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_E82": "Iritira me kada drugi greše.",
      "ipip_E122": "Volim da radim stvari iz hira.",
      "ipip_H1458": "Ne volim nepoznato.",
      "ipip_P436": "Želim da me drugi ljudi smatraju posebnim.",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_P402": "Volim da imam autoritet nad drugima.",
      "ipip_X81": "Volim muziku.",
      "ipip_H1057": "Želim da se dopadnem drugima.",
      "ipip_H1150": "Volim da privlačim pažnju.",
      "ipip_P410": "Ne volim kada me hvale.",
      "ipip_E99": "Retko se dešava da izgubim prisebnost.",
      "ipip_E77": "Retko tragam za nekim dubljim smislom.",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_P439": "Sebe vidim kao dobrog vođu.",
      "ipip_H1140": "Izbegavam svoje obaveze.",
      "ipip_H314": "Trudim se da uvek budem doteran.",
      "ipip_H1423": "Ne obraćam pažnju.",
      "ipip_P419": "Radim stvari tipične za muškarce.",
      "ipip_H1085": "Često se brecam na druge ljude.",
      "ipip_X250": "Nikada ne bih išao na paraglajding ili bandži- džamping.",
      "ipip_E85": "Nije mi stalo do lepog oblačenja.",
      "ipip_X204": "Više volim raznolikost od rutine.",
      "ipip_P354": "Osećam da je u redu to što se nekima ne dopadam.",
      "ipip_E134": "Nije mi stalo do mišljenja drugih ljudi.",
      "ipip_X174": "Političke diskusije su mi zanimljive.",
      "ipip_H34": "Uvek sam glavni na žurci.",
      "ipip_H245": "Posao stavljam ispred zadovoljstva.",
      "ipip_X215": "Ne volim glasnu muziku.",
      "ipip_X235": "Ne prijaju mi odlasci u muzeje.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X158": "Voleo/la bih da neko vreme živim u inostranstvu.",
      "ipip_H704": "Držim druge ljude na distanci.",
      "ipip_X274": "Lako odolevam iskušenjima.",
      "ipip_P445": "Imam snažnu potrebu za moći.",
      "ipip_E7": "Ne smeta mi nered.",
      "ipip_P364": "Dobar sam u spontanim govorima.",
      "ipip_H709": "Ne podnosim kritike.",
      "ipip_H1137": "Mogu da nagovorim druge da nešto urade.",
      "ipip_H2039": "Provodim dosta vremena čitajući.",
      "ipip_H1206": "Vredno radim.",
      "ipip_H397": "Brzo donosim odluke.",
      "ipip_H754": "Lako pobesnim.",
      "ipip_X115": "Radim tek toliko koliko je potrebno.",
      "ipip_H554": "Obavljam dosta posla.",
      "ipip_P359": "Ne volim da preuzimam odgovornost za donošenje odluka.",
      "ipip_X3": "Hoću sve da probam.",
      "ipip_H312": "Konzervativna sam osoba.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_H106": "Prihvatam ljude onakve kakvi jesu.",
      "ipip_P361": "Ne dozvoljavam da drugi preuzimaju zasluge za moj rad.",
      "ipip_H492": "Mogu da obavljam širok spektar zadataka.",
      "ipip_H1311": "Dovoljno mi je stvari objasniti samo jednom.",
      "ipip_H784": "Često nešto uradim a da se prethodno ne posavetujem s drugima.",
      "ipip_H292": "Ne mogu da podnesem da mi neko protivreči.",
      "ipip_H303": "Volim da se stvari odvijaju po planu.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_H976": "Prepuštam vođstvo drugima.",
      "ipip_P399": "Dopuštam ljudima da mi pomognu kako bi se osećali važnima.",
      "ipip_P421": "Dozvoljavam drugima da preuzmu zasluge za moj rad.",
      "ipip_H52": "Brzo se zbližim sa drugim ljudima.",
      "ipip_P485": "Ne bih bio dobar komičar.",
      "ipip_H1227": "Podižem razgovor na viši nivo.",
      "ipip_X166": "Volim da čujem nove ideje.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_X201": "Volim da rešavam složene probleme.",
      "ipip_H524": "Pokušavam da predvodim druge.",
      "ipip_H1033": "Svašta mogu da podnesem.",
      "ipip_E147": "Menjam se da bih odgovarao drugima.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H1322": "Mogu izaći na kraj sa velikom količinom informacija.",
      "ipip_H995": "Potrebna mi je zastita.",
      "ipip_P450": "Imam vremena za zabavu i opuštanje.",
      "ipip_H81": "Često se \"otkačim.\"",
      "ipip_X87": "Uvek sam spreman na sve.",
      "ipip_H899": "Trudim se da budem uspešan u teškim zadacima.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H58": "Uvek sam zauzet.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_E169": "Ne saosećam sa kriminalcima.",
      "ipip_E11": "Želim da sve bude \"baš kako treba\".",
      "ipip_E109": "Odmah obavim neprijatne zadatke.",
      "ipip_H980": "Potrebno mi je ohrabrenje od strane drugih.",
      "ipip_H17": "Izražavam se s lakoćom.",
      "ipip_P397": "Nije mi stalo da ostavim dobar utisak.",
      "ipip_H682": "Najviše volim da radim sam.",
      "ipip_H744": "Trudim se da zadivim druge.",
      "ipip_H966": "Često mi je potrebna pomoć",
      "ipip_H79": "U slobodno vreme radim mnoge stvari.",
      "ipip_H391": "Dobro radim pod pritiskom.",
      "ipip_X62": "Otvoren sam za promene.",
      "ipip_H301": "Volim da se držim predviđenog rasporeda.",
      "ipip_H1082": "Sklon sam da odbijam tuđe predloge.",
      "ipip_H699": "Vraćam drugima \"milo za drago\".",
      "ipip_H412": "Staram se o svojim obavezama.",
      "ipip_X110": "Nisam mnogo motivisan da uspem.",
      "ipip_H1284": "Dobro vladam jezikom.",
      "ipip_H2000": "Lako se prilagođavam novim situacijama.",
      "ipip_H853": "Često donosim ishitrene odluke.",
      "ipip_X82": "Često zaboravim da vratim stvari na svoje mesto.",
      "ipip_H1030": "Dopuštam da me drugi iskoriste.",
      "ipip_E35": "Uživam da se ponašam bahato.",
      "ipip_E57": "Često mi nije jasno zašto radim neke stvari.",
      "ipip_H2014": "Radim više nego što se od mene očekuje.",
      "ipip_H763": "Ne umem da gubim.",
      "ipip_H2021": "Interesuju me mnoge stvari.",
      "ipip_H848": "Često nešto radim bez prethodnog planiranja.",
      "ipip_H438": "Volim uzbuđenje.",
      "ipip_P407": "Lako mi je da manipulišem drugima.",
      "ipip_P477": "Živim laganim životom.",
      "ipip_E47": "Volim da diskutujem o filmovima i knjigama sa drugim ljudima.",
      "ipip_H598": "Izbegavam društvo.",
      "ipip_H137": "Sklon sam praštanju.",
      "ipip_X20": "Verujem da se previše državnog novca troši na ulaganje u umetnike.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_E120": "Retko se žalim.",
      "ipip_E46": "U mnoge stvari se upuštam bez razmišljanja.",
      "ipip_H1467": "Često pravim nered.",
      "ipip_X248": "Izbegavam filozofske diskusije.",
      "ipip_H386": "Ne uznemiravaju me (svakodnevni) događaji.",
      "ipip_H66": "Umem da se radujem kao dete.",
      "ipip_X23": "Nije me lako iznervirati",
      "ipip_E28": "Mislim da je spoljašnji izgled važan.",
      "ipip_H457": "Mogu da obavljam više stvari istovremeno.",
      "ipip_H1092": "Volim da budem sam/a.",
      "ipip_X30": "Radije se držim stvari koje znam.",
      "ipip_H866": "Često reagujem brzo i bez razmišljanja.",
      "ipip_H928": "Često ostavljam stvari nedovršene.",
      "ipip_X217": "Umem da budem zlopamtilo.",
      "ipip_X28": "Imam siromašan rečnik.",
      "ipip_X265": "Retko se iznerviram."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_P431": "Tar inte på mig skulden för något som inte är mitt fel",
      "ipip_H755": "Tappar humöret",
      "ipip_H1047": "Låter mig ledas av andra",
      "ipip_P374": "Har tid över",
      "ipip_P491": "Anstränger mig för att imponera på människor",
      "ipip_H896": "Konstrar till saker",
      "ipip_H1356": "Har ett öga för detaljer",
      "ipip_H965": "Klarar mig inte utan andras sällskap",
      "ipip_H1265": "Älskar att lära mig nya saker",
      "ipip_E172": "Hittar aldrig något",
      "ipip_X239": "Är inte intresserad av teoretiska diskussioner",
      "ipip_H871": "Agerar vilt och galet",
      "ipip_X78": "Har inte något emot att vara centrum för uppmärksamheten",
      "ipip_H1052": "Kommer att hålla med om allt",
      "ipip_H761": "Blir lätt irriterad",
      "ipip_P432": "Har en naturligt talang för att påverka människor",
      "ipip_X264": "Gillar inte att resa",
      "ipip_P420": "Oroar mig över vad människor tänker om mig",
      "ipip_H974": "Behöver andras godkännande",
      "ipip_H969": "Behöver en knuff för att komma igång",
      "ipip_P486": "Bryr mig inte ifall andra tycker att jag är speciell",
      "ipip_P441": "Kommer troligen att visa mig på styva linan om jag får chansen",
      "ipip_X104": "Tycker om att besöka nya platser",
      "ipip_H627": "Står bara och hänger och gör inget",
      "ipip_P468": "Är dålig på att dra vitsar",
      "ipip_E158": "Tappar ständigt bort saker",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_H507": "Vill ha sista ordet",
      "ipip_P444": "Skulle bli en bra skådespelare",
      "ipip_E126": "Försöker glömma och förlåta",
      "ipip_H62": "Pratar om mina bekymmer",
      "ipip_H1185": "Vet hur man roar sig",
      "ipip_H446": "Söker äventyret",
      "ipip_P341": "Tycker illa om att ha makt över andra",
      "ipip_H2027": "Tycker om att läsa",
      "ipip_X243": "Gillar inte att se på dansframträdande",
      "ipip_H356": "Kan ta kritik",
      "ipip_H366": "Gör saker på mitt eget sätt",
      "ipip_H1068": "Är bra på att ta emot råd",
      "ipip_H596": "Är svår att lära känna",
      "ipip_X211": "Älskar att läsa tankeväckande skrifter",
      "ipip_H1170": "Står ut med mycket från andra",
      "ipip_X88": "Uppskattar att tillbringa tid för mig själv",
      "ipip_H439": "Tackar allt",
      "ipip_X159": "Tycker inte att arbete är en viktigt del av mitt liv",
      "ipip_H961": "Söker stöd",
      "ipip_H1213": "Vill öka mina kunskaper",
      "ipip_H498": "Går emot auktoriteter",
      "ipip_H1246": "Är bra på många saker",
      "ipip_H1285": "Fullföljer mina uppgifter framgångsrikt",
      "ipip_P346": "Saknar talangen att påverka andra",
      "ipip_H1171": "Tycker det är svårt att få saker gjort",
      "ipip_X163": "Är grundlig i mitt arbete",
      "ipip_P472": "Är under konstant press",
      "ipip_H1063": "Tycker illa om förändringar",
      "ipip_H909": "Känner mig ofta obehaglig till mods bland andra",
      "ipip_H992": "Rörs lätt till tårar",
      "ipip_P448": "Har alldeles för mycket att göra",
      "ipip_H400": "Går min egen väg",
      "ipip_H1366": "Är skicklig på att handskas med sociala situationer",
      "ipip_H244": "Tycker om att städa upp",
      "ipip_P430": "Är dålig på att få människor att gilla mig",
      "ipip_H1093": "Underhåller mina vänner",
      "ipip_H747": "Söker status",
      "ipip_X231": "Blir sällan förbannad",
      "ipip_P409": "Tror på att händelser i mitt liv orsakas bara av mig själv",
      "ipip_H5": "Blir upphetsad av nya idéer",
      "ipip_H1087": "Gör andra besvikna",
      "ipip_H154": "Håller mig i bakgrunden",
      "ipip_H762": "Är lättkränkt",
      "ipip_X45": "Gillar inte poesi",
      "ipip_P401": "Älskar att få komplimanger",
      "ipip_E144": "Tar saker som de kommer",
      "ipip_H862": "Kastar mig över saker",
      "ipip_X147": "Skulle beskriva mina erfarenheter som lite tråkiga",
      "ipip_H793": "Vill vara den som bestämmer",
      "ipip_H404": "Går min egen väg",
      "ipip_H1460": "Är en vanemänniska",
      "ipip_H1362": "Uppmärksammar detaljer",
      "ipip_X79": "Håller mig lugn under stress och tidspress",
      "ipip_H673": "Väljer mina ord med omsorg",
      "ipip_P416": "Ser till att min frisyr är moderiktigt",
      "ipip_X118": "Tycker om ordning",
      "ipip_H648": "Undviker kontakten med andra",
      "ipip_H575": "Bryr mig inte om regler",
      "ipip_X144": "Gillar inte konserter",
      "ipip_E69": "Dömer folk efter deras yttre",
      "ipip_H1094": "Gör en massa roliga saker",
      "ipip_X167": "Lägger lite tid och kraft i mitt arbete",
      "ipip_H1174": "Är bäst på det jag gör",
      "ipip_H69": "Kastar mig in i en uppgift med hela mitt hjärta",
      "ipip_P384": "Gillar inte att vara iväg från civilisationen",
      "ipip_H1144": "Ger upp lätt",
      "ipip_X109": "Undviker svårlästa artiklar och böcker",
      "ipip_P455": "Har redan fått mer än jag förtjänar",
      "ipip_H659": "Lever i en värld för mig själv",
      "ipip_H296": "Respekterar auktoriteter",
      "ipip_H29": "Har lätt för att få vänner",
      "ipip_E82": "Blir irriterad på andras misstag",
      "ipip_E122": "Tycker om att följa ett infall",
      "ipip_H1458": "Känner olust inför det okända",
      "ipip_P436": "Vill att andra skall uppfatta mig som något speciellt",
      "ipip_H16": "Sätter igång konversationer",
      "ipip_P402": "Tycker om att ha makt över andra",
      "ipip_X81": "Gillar musik",
      "ipip_H1057": "Vill vara omtyckt",
      "ipip_H1150": "Tycker om att dra uppmärksamhet till mig",
      "ipip_P410": "Tycker illa om att få komplimanger",
      "ipip_E99": "Tappar sällan min hållning",
      "ipip_E77": "Ser sällan efter en djupare mening i saker",
      "ipip_X123": "Tror på betydelsen av konst",
      "ipip_P439": "Ser mig själv som en god ledare",
      "ipip_H1140": "Smiter undan mina plikter",
      "ipip_H314": "Ser till att jag snygg och ren",
      "ipip_H1423": "Är inte uppmärksam",
      "ipip_P419": "Gör sådan som män traditionellt brukar göra",
      "ipip_H1085": "Fräser åt folk",
      "ipip_X250": "Skulle aldrig ägna mig åt hängflygning eller bungee-jumping",
      "ipip_E85": "Bryr mig inte om att klä mig snyggt",
      "ipip_X204": "Föredrar variation framför rutin",
      "ipip_P354": "Tycker det är OK att vissa inte gillar mig",
      "ipip_E134": "Bryr mig inte om vad andra tänker",
      "ipip_X174": "Tycker att politiska diskussioner är intressanta",
      "ipip_H34": "Är den som håller igång på ett party",
      "ipip_H245": "Sätter arbete framför nöje",
      "ipip_X215": "Tycker illa om hög musik",
      "ipip_X235": "Gillar inte att gå på konstmuseum",
      "ipip_X228": "Är inte intresserad av abstrakta idéer",
      "ipip_X158": "Skulle vilja leva ett tag i ett annat land",
      "ipip_H704": "Håller andra på avstånd",
      "ipip_X274": "Står emot frestelser utan problem",
      "ipip_P445": "Har ett starkt behov av makt",
      "ipip_E7": "Störs inte av oordning",
      "ipip_P364": "Är bra på att hålla oförberedda tal",
      "ipip_H709": "Tål inte kritiker",
      "ipip_H1137": "Kan övertala andra att göra saker",
      "ipip_H2039": "Spenderar mycket tid på att läsa",
      "ipip_H1206": "Arbetar hårt",
      "ipip_H397": "Tar beslut snabbt",
      "ipip_H754": "Blir lätt arg",
      "ipip_X115": "Gör bara så mycket som jag måste",
      "ipip_H554": "Får en massa arbete gjort",
