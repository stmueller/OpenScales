    "scoring": {
      "participation": {
        "description": "Sum of 10 Participation items (Majority=1, other=0). Range 0–10; higher = stronger democratic participation orientation.",
        "method": "sum_coded",
        "items": ["dem_Emilia", "dem_Noah", "dem_Elif", "dem_Yusuf", "dem_Zofia", "dem_Viktor", "dem_Mia", "dem_Matteo", "dem_Amira", "dem_Paul"]
      },
      "equality": {
        "description": "Sum of 4 Equality items (Both=1, gender-specific=0). Range 0–4; higher = stronger equality orientation.",
        "method": "sum_coded",
        "items": ["equ_rep", "equ_sco", "equ_swe", "equ_foo"]
      },
      "following_rules": {
        "description": "Sum of 2 Following Rules items (Important=1, other=0). Range 0–2; higher = stronger rule-following orientation.",
        "method": "sum_coded",
        "items": ["rul_gen", "rul_sel"]
      },
      "renunciation_violence": {
        "description": "Sum of 2 Renunciation of Violence items (No=1, Yes or It depends=0). Range 0–2; higher = stronger rejection of violence.",
        "method": "sum_coded",
        "items": ["vio_chi", "vio_par"]
      },
      "freedom_opinion": {
        "description": "Sum of 4 Freedom of Opinion items (democratic response=1, other=0; free_man is reverse-keyed: No=1). Range 0–4; higher = stronger support for freedom of opinion. Note: items free_gen and free_man have severe ceiling effects.",
        "method": "sum_coded",
        "items": ["free_gen", "free_Tom", "free_toy", "free_man"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "Democratic Values Scale for Children (DVS-C) Report",
      "footer_refs": [
        "Monstadt, F. C. (2025). Measuring democratic values in primary school children: Development and confirmatory factor analysis of a new survey instrument. Measurement Instruments for the Social Sciences, 7, Article e16247. https://doi.org/10.5964/miss.16247",
        "Scoring: democratic response = 1 per item; subscale scores are sums. Equality, Following Rules, and Renunciation of Violence show strongest psychometric support. Participation and Freedom of Opinion require further validation."
      ]
    }
  },
  "translations": {
    "en": {
      "dem_Emilia": "In Emilia's class, the children decide to make a class newspaper. Someone suggests that there should be a deadline by which everyone should have their part of the newspaper ready. How should the class decide?",
      "dem_Noah": "Noah's class is planning a class party. Someone suggests that the children should decide for themselves what each of them should prepare for the party. How should the class decide?",
      "dem_Elif": "Someone in Elif's class suggests that the children should stop running around in the playground because that would mean bumping into other children. How should the class decide?",
      "dem_Yusuf": "Someone in Yusuf's class suggests that all children should brush their teeth thoroughly in future to protect themselves from tooth decay. How should the class decide?",
      "dem_Zofia": "Zofia's class recently had the flu. Someone in her class suggests that all the children should wear a mask to protect themselves from infection. How should the class decide?",
      "dem_Viktor": "Someone in Viktor's class suggests that all the children should play outside at break time when the weather is good because it's healthy. How should the class decide?",
      "dem_Mia": "Someone in Mia's class suggests that all the children should bring bread for lunch because it's healthy. How should the class decide?",
      "dem_Matteo": "Someone in Matteo's class suggests that all children should stop drinking lemonade because it's not good for their teeth. How should the class decide?",
      "dem_Amira": "Someone in Amira's class suggests that no children should be allowed to read comics during the break. How should the class decide?",
      "dem_Paul": "Paul and Mila sit next to each other and fight every lesson. Mohammed suggests that the two of them should get away from each other to avoid disturbing the other children. How should the class decide?",
      "equ_stem": "What do you think, should rather boys, rather girls or both be allowed to do these things? Who should be allowed to…",
      "equ_rep": "…become class representative?",
      "equ_sco": "…borrow a scooter for the break?",
      "equ_swe": "…do the sweeping duty?",
      "equ_foo": "…play football during the break?",
      "rul_gen": "If you think about the school rules, e.g. put your hand up if you want to say something — how important do you think it is that there are such rules?",
      "rul_sel": "And how important do you think it is that you stick to these rules yourself?",
      "vio_chi": "If another child annoys you, do you think it's okay to hit them to make them stop?",
      "vio_par": "Imagine watching a parent slapping their child in the face. Do you think that's okay?",
      "free_gen": "Everyone should be allowed to express their own opinion!",
      "free_Tom": "In a class, the children are allowed to decide together where to go on the next class trip. All the children want to go to the nearest zoo, but Tom is against it because he doesn't like zoos. Do you think it's okay if Tom disagrees with the other children?",
      "free_toy": "Imagine the children at your school are allowed to help decide which new toys should be bought for the breaks. Do you think it's okay for the first graders to have a say?",
      "free_man": "Imagine the school management decides that they don't want anyone to contradict them. So they decide on a rule that forbids saying anything they don't like. Would it be okay for the school management to set such a rule?",
      "opt_majority": "By majority vote",
      "opt_consensus": "By consensus (everyone agrees)",
      "opt_teacher": "The teacher decides",
      "opt_boys": "Rather boys",
      "opt_girls": "Rather girls",
      "opt_both": "Both",
      "opt_important": "Important",
      "opt_rather_important": "Rather important",
      "opt_unimportant": "Unimportant",
      "opt_yes": "Yes",
      "opt_no": "No",
      "opt_depends": "It depends",
      "debrief": "Thank you for completing this questionnaire."
    },
    "de": {
      "dem_Emilia": "In Emilias Klasse beschließen die Kinder, eine Klassenzeitung zu machen. Jemand schlägt vor, dass es einen Termin geben soll, bis zu dem alle ihren Teil der Zeitung fertig haben sollen. Wie soll die Klasse entscheiden?",
      "dem_Noah": "Noahs Klasse plant eine Klassenfeier. Jemand schlägt vor, dass die Kinder selbst entscheiden sollen, was jeder von ihnen zur Feier mitbringt. Wie soll die Klasse entscheiden?",
      "dem_Elif": "Jemand in Elifs Klasse schlägt vor, dass die Kinder aufhören sollen, auf dem Schulhof herumzurennen, weil man dabei mit anderen Kindern zusammenstoßen würde. Wie soll die Klasse entscheiden?",
      "dem_Yusuf": "Jemand in Yusufs Klasse schlägt vor, dass alle Kinder in Zukunft gründlich die Zähne putzen sollen, um sich vor Karies zu schützen. Wie soll die Klasse entscheiden?",
      "dem_Zofia": "In Zofias Klasse hatten alle die Grippe. Jemand in ihrer Klasse schlägt vor, dass alle Kinder eine Maske tragen sollen, um sich vor Ansteckung zu schützen. Wie soll die Klasse entscheiden?",
      "dem_Viktor": "Jemand in Viktors Klasse schlägt vor, dass alle Kinder bei gutem Wetter in der Pause draußen spielen sollen, weil das gesund ist. Wie soll die Klasse entscheiden?",
      "dem_Mia": "Jemand in Mias Klasse schlägt vor, dass alle Kinder zum Mittagessen Brot mitbringen sollen, weil das gesund ist. Wie soll die Klasse entscheiden?",
      "dem_Matteo": "Jemand in Matteos Klasse schlägt vor, dass alle Kinder aufhören sollen, Limonade zu trinken, weil das nicht gut für die Zähne ist. Wie soll die Klasse entscheiden?",
      "dem_Amira": "Jemand in Amiras Klasse schlägt vor, dass keine Kinder in der Pause Comics lesen dürfen sollen. Wie soll die Klasse entscheiden?",
      "dem_Paul": "Paul und Mila sitzen nebeneinander und streiten sich jede Stunde. Mohammed schlägt vor, dass die beiden voneinander weggesetzt werden sollen, damit sie die anderen Kinder nicht stören. Wie soll die Klasse entscheiden?",
      "equ_stem": "Was denkst du, sollten diese Dinge eher Jungen, eher Mädchen oder beide machen dürfen? Wer darf eher…",
      "equ_rep": "…Klassensprecher werden",
      "equ_sco": "…in der Pause einen Roller leihen",
      "equ_swe": "…den Kehrdienst machen",
      "equ_foo": "…in der Pause Fußball spielen",
      "rul_gen": "Wenn du an die Schulregeln denkst, z.B. melde dich, wenn du etwas sagen möchtest – wie wichtig findest du es, dass es solche Regeln gibt?",
      "rul_sel": "Und wie wichtig findest du es, dass du dich selbst an diese Regeln hältst?",
      "vio_chi": "Wenn dich ein anderes Kind ärgert, findest du es okay, es zu schlagen, damit es aufhört?",
      "vio_par": "Stell dir vor, du siehst, wie ein Elternteil seinem Kind eine Ohrfeige gibt. Findest du das okay?",
      "free_gen": "Jeder sollte seine eigene Meinung äußern dürfen!",
      "free_Tom": "In einer Klasse dürfen die Kinder gemeinsam entscheiden, wohin sie auf dem nächsten Klassenausflug fahren. Alle Kinder wollen in den nächsten Zoo fahren, aber Tom ist dagegen, weil er Zoos nicht mag. Findest du es okay, wenn Tom anderer Meinung als die anderen Kinder ist?",
      "free_toy": "Stell dir vor, die Kinder an deiner Schule dürfen mitentscheiden, welches neue Spielzeug für die Pausen angeschafft werden soll. Findest du es okay, wenn auch die Erstklässler mitreden dürfen?",
      "free_man": "Stell dir vor, die Schulleitung entscheidet, dass sie nicht möchte, dass ihr jemand widerspricht. Deshalb legt sie eine Regel fest, die es verbietet, etwas zu sagen, das ihr nicht gefällt. Wäre es okay, wenn die Schulleitung eine solche Regel aufstellt?",
      "opt_majority": "Per Mehrheitsentscheid",
      "opt_consensus": "Per Konsens (alle sind einverstanden)",
      "opt_teacher": "Die Lehrkraft entscheidet",
      "opt_boys": "Eher Jungen",
      "opt_girls": "Eher Mädchen",
      "opt_both": "Beide",
      "opt_important": "Wichtig",
      "opt_rather_important": "Eher wichtig",
      "opt_unimportant": "Unwichtig",
      "opt_yes": "Ja",
      "opt_no": "Nein",
      "opt_depends": "Es kommt darauf an",
      "debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens."
    }
  }
}
