      "ipip_X23": "Är svår att förarga",
      "ipip_E28": "Tror att utseendet är viktigt",
      "ipip_H457": "Kan hantera många saker på en gång",
      "ipip_H1092": "Gillar att vara ensam",
      "ipip_X30": "Föredrar att hålla mig till saker jag känner till",
      "ipip_H866": "Agerar snabbt utan att tänka",
      "ipip_H928": "Lämnar saker ofärdiga",
      "ipip_X217": "Klagar inte på andra",
      "ipip_X28": "Har ett dåligt ordförråd",
      "ipip_X265": "Blir sällan irriterad"
    }
  }
}
