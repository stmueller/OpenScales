      },
      {
        "id": "emotional_stability_sum",
        "name": "Emotional Stability (sum)"
      },
      {
        "id": "emotional_stability_mean",
        "name": "Emotional Stability (mean)"
      },
      {
        "id": "intellect_sum",
        "name": "Intellect/Imagination (sum)"
      },
      {
        "id": "intellect_mean",
        "name": "Intellect/Imagination (mean)"
      }
    ],
