  "scale_info": {
    "name": "Media Use During COVID-19",
    "code": "PX950101",
    "abbreviation": "PX950101",
    "description": "This protocol uses four questions from the COVID-19 Experiences (COVEX) questionnaire Media Use module. The questions assess an individual’s sources of news and information for COVID-19 related information during the pandemic, and their mental health impact.",
