    "pl": {
      "ppltrst": "Czy, ogólnie biorąc, uważa Pan, że większości ludzi można ufać, czy też, że w kontaktach z ludźmi ostrożności nigdy za wiele?",
      "bsts_trst_lo": "Ostrożności nigdy za wiele",
      "bsts_trst_hi": "Większości ludzi można ufać",
      "pplfair": "Czy uważa Pan, że gdyby nadarzyła się okazja, większość ludzi starałaby się Pana wykorzystać, czy też starałaby się postępować uczciwie?",
      "bsts_fair_lo": "Większość ludzi starałaby się mnie wykorzystać",
      "bsts_fair_hi": "Większość ludzi starałaby się postępować uczciwie",
      "pplhlp": "Czy uważa Pan, że ludzie przede wszystkim starają się służyć pomocą innym, czy też, że przede wszystkim dbają o własny interes?",
      "bsts_hlp_lo": "Ludzie przede wszystkim dbają o własny interes",
      "bsts_hlp_hi": "Ludzie przede wszystkim starają się służyć pomocą innym",
      "debrief": "Dziękujemy za wypełnienie kwestionariusza.",
      "bsts_head": "Proszę odpowiedzieć na poniższe pytania, używając oceny od 0 do 10."
    },
    "pt": {
      "ppltrst": "De uma forma geral, acha que todo o cuidado é pouco quando se lida com as pessoas ou acha que se pode confiar na maioria das pessoas?",
      "bsts_trst_lo": "Todo o cuidado é pouco",
      "bsts_trst_hi": "A maioria das pessoas é de confiança",
      "pplfair": "Acha que a maior parte das pessoas tenta aproveitar-se de si sempre que pode, ou pensa que a maior parte das pessoas é honesta?",
      "bsts_fair_lo": "Tentam aproveitar-se de mim",
      "bsts_fair_hi": "A maior parte das pessoas é honesta",
      "pplhlp": "Acha que, na maior parte das vezes, as pessoas estão preocupadas com elas próprias ou acha que tentam ajudar os outros?",
      "bsts_hlp_lo": "As pessoas estão preocupadas com elas próprias",
      "bsts_hlp_hi": "As pessoas tentam ajudar os outros",
      "debrief": "Obrigado por completar este questionário.",
      "bsts_head": "Por favor responda às seguintes perguntas usando uma pontuação de 0 a 10."
