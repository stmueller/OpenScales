      "ipip_X138": "Am not easily bothered by things.",
      "ipip_H640": "Am often down in the dumps.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_E144": "Take things as they come.",
      "ipip_X148": "Am open about my feelings.",
      "ipip_X56": "Don't talk a lot.",
      "ipip_X97": "Have difficulty expressing my feelings.",
      "ipip_H679": "Hold back my opinions.",
      "ipip_H29": "Make friends easily.",
      "ipip_H548": "Speak softly.",
      "ipip_H334": "Take charge.",
      "ipip_X83": "Talk to a lot of different people at parties.",
      "ipip_H1302": "Never at a loss for words.",
      "ipip_X228": "Am not interested in abstract ideas.",
      "ipip_X109": "Avoid difficult reading material.",
      "ipip_H1227": "Carry the conversation to a higher level.",
      "ipip_H1276": "Have a rich vocabulary.",
      "ipip_X176": "Have difficulty understanding abstract ideas.",
      "ipip_H1313": "Have excellent ideas.",
      "ipip_E171": "Try to avoid complex people.",
      "ipip_H1392": "Will not probe deeply into a subject.",
      "ipip_X100": "Quick to understand things.",
      "ipip_E147": "Change myself to suit others.",
      "ipip_H1056": "Conform to others' opinions.",
      "ipip_H1041": "Copy others.",
      "ipip_H525": "Demand attention.",
      "ipip_H725": "Interfere in other people's business.",
      "ipip_H974": "Need the approval of others.",
