      "hip_location_fall_trauma_specify": "LOCATION OF FALL OR TRAUMA: Other, specify",
      "time_hip_fracture_occurred": "TIME OF DAY FRACTURE OCCURRED:",
      "time_hip_fracture_occurred_opt_1": "Daytime (6am-6pm)",
      "time_hip_fracture_occurred_opt_2": "Night (6:01pm to 5:59am)",
      "time_hip_fracture_occurred_opt_3": "Other",
      "time_hip_fracture_occurred_opt_9": "Unknown",
      "time_hip_fracture_occurred_specify": "TIME OF DAY FRACTURE OCCURRED:  Other, specify",
      "hip_fracture_death_during_hospitalization": "DEATH OCCURED DURING HIP FRACTURE HOSPITALIZATION:",
      "hip_fracture_death_during_hospitalization_opt_0": "No",
      "hip_fracture_death_during_hospitalization_opt_1": "Yes",
      "hip_fracture_death_during_hospitalization_opt_8": "n/a (no hospitalization)",
      "hip_fracture_death_during_hospitalization_opt_9": "Unknown",
      "detailed_circumstances_of_hip_fracture": "DETAILED CIRCUMSTANCES OF HIP FRACTURE:",
      "detailed_circumstances_of_hip_fracture_opt_1": "Fall from standing height or less-includes most injuries due to tripping over something, slips in the shower or bathtub, or falling out of a chair or bed (unless standing on it), in which the participant lands on the surface at the same height as the surface he/she was standing on",
      "detailed_circumstances_of_hip_fracture_opt_2": "Falls on stairs, steps or curbs-includes all falls during change of level, such as stepping up or down stairs, steps, or curbs",
      "detailed_circumstances_of_hip_fracture_opt_3": "Fall from more than standing height, but NOT on stairs-includes falls from heights such as off a ladder or while standing on a table or chair, off a porch, out of a window, etc.",
      "detailed_circumstances_of_hip_fracture_opt_4": "Minimal trauma other than a fall-includes vertebral fractures associated with coughing, stepping down a step, etc., and rib or other fractures associated with turning over in bed, etc.",
      "detailed_circumstances_of_hip_fracture_opt_5": "Moderate trauma other than a fall-includes collisions with objects during normal activities (e.g. stub toe, hit hand against door frame, walking into door), twisting or turning ankle (or ankle fractures).",
      "detailed_circumstances_of_hip_fracture_opt_6": "Severe trauma other than a fall-includes motor vehicle accidents, struck by a car, hit by rapidly moving projectile (golf ball, golf club), assault",
      "detailed_circumstances_of_hip_fracture_opt_7": "Pathologic fracture-usually associated with cancer in bone",
      "detailed_circumstances_of_hip_fracture_opt_8": "Unknown/Don't know",
