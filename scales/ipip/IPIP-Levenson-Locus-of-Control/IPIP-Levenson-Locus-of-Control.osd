  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H41": "Act comfortably with others.",
      "ipip_P388": "Am less capable than most people.",
      "ipip_text_believe_some_people_are_born_lucky": "Believe some people are born lucky.",
      "ipip_P435": "Believe that my success depends on ability rather than luck.",
      "ipip_P369": "Believe that the world is controlled by a few powerful people.",
      "ipip_P394": "Believe that unfortunate events occur because of bad luck.",
      "ipip_H2009": "Come up with good solutions.",
      "ipip_X15": "Dislike myself.",
      "ipip_P359": "Dislike taking responsibility for making decisions.",
      "ipip_X129": "Feel comfortable with myself.",
      "ipip_H954": "Feel that I'm unable to deal with things.",
      "ipip_X205": "Feel that my life lacks direction.",
      "ipip_H1116": "Feel up to any task.",
      "ipip_H1183": "Habitually blow my chances.",
      "ipip_P379": "Just know that I will be a success.",
      "ipip_P473": "Like to take responsibility for making decisions.",
      "ipip_text_love_life": "Love life.",
      "ipip_E135": "Make a decision and move on.",
      "ipip_H633": "See difficulties everywhere.",
      "ipip_H64": "Take the initiative."
    }
  }
