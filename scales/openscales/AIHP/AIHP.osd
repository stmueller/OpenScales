{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "AI in Healthcare Perceptions",
      "code": "AIHP",
      "abbreviation": "AIHP",
      "description": "Measurement model of patients' motivations for and concerns about using AI medical-diagnosis applications. 34 Likert items across 11 constructs — five motivations (ubiquitous service, expedited diagnosis, corroborative diagnosis, affordable services, health information seeking), five concerns (erroneous diagnosis, depersonalised experience, dehumanised interaction, medical data privacy, opaque process), and willingness to use — plus a single open-ended willingness-to-pay item. Likert items are rated 1-7.",
      "citation": "Hajiheydari, N., Delgosha, M. S., & Saheb, T. (2025). AI in medical diagnosis: A contextualised study of patient motivations and concerns. Social Science & Medicine, 371, 117850. https://doi.org/10.1016/j.socscimed.2025.117850",
      "license": "CC BY 4.0",
      "license_explanation": "© 2025 The Author(s). Items reproduced from Hajiheydari, Delgosha, & Saheb (2025), Social Science & Medicine, published open access under a Creative Commons Attribution 4.0 International License (confirmed CC BY via Unpaywall).",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1016/j.socscimed.2025.117850",
      "version": "1.0",
      "domain": "Technology"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-16",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "11 Likert subscales scored as means (1-7). Two reverse-coded items per the source: 'afford3' (Using mobile apps for medical services is costly) and 'willuse3' (I do NOT use this application for diagnosis purposes). The single open-ended 'willingness to pay' item is included as a short text item ('willpay1') and is not scored. The two section stems ('reasons you would use' / 'reasons you would NOT use') are carried as item-level question_head. No overall total is computed (motivation and concern constructs are distinct latent factors in the source measurement model). Scoring rule (mean) follows standard latent-construct practice; confirm against the source if needed."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "likert_1",
        null,
        null,
        null,
        null,
        null,
        "likert_7"
      ]
    },
    "dimensions": [
      {
        "id": "ubiquitous",
        "name": "Ubiquitous Medical Service",
        "description": "AI apps provide convenient, anytime/anywhere access (motivation; items ubiq1-4)."
      },
      {
        "id": "expedited",
        "name": "Expedited Diagnosis",
        "description": "AI apps enable earlier symptom checking and detection (motivation; exped1-3)."
      },
      {
        "id": "corroborative",
        "name": "Corroborative Diagnosis",
        "description": "AI apps allow cross-checking a doctor's diagnosis (motivation; corrob1-3)."
      },
      {
        "id": "affordable",
        "name": "Affordable Services",
        "description": "AI apps are reasonably priced / good value (motivation; afford1-3, afford3 reverse)."
      },
      {
        "id": "health_info",
        "name": "Health Information Seeking",
        "description": "AI apps provide access to valuable health information (motivation; healthinfo1-3)."
      },
      {
        "id": "erroneous",
        "name": "Erroneous Diagnosis",
        "description": "Concern that AI apps may diagnose incorrectly (concern; err1-3)."
      },
      {
        "id": "depersonalised",
        "name": "Depersonalised Experience",
        "description": "Concern that AI apps cannot consider personal needs (concern; depers1-3)."
      },
      {
        "id": "dehumanised",
        "name": "Dehumanised Interaction",
        "description": "Concern about loss of human/doctor interaction (concern; dehum1-3)."
      },
      {
        "id": "privacy",
        "name": "Medical Data Privacy Concerns",
        "description": "Concern about data breaches and misuse of health data (concern; privacy1-3)."
      },
      {
        "id": "opaque",
        "name": "Opaque Diagnosis Process",
        "description": "Concern that the app's reasoning is not understandable (concern; opaque1-3)."
      },
      {
        "id": "willingness_use",
        "name": "Willingness to Use",
        "description": "Intention to use AI diagnosis apps (outcome; willuse1-3, willuse3 reverse)."
      }
    ],
