  "translations": {
    "en": {
      "qls_r1": "Strongly disagree",
      "qls_r7": "Strongly agree",
      "qls_qhead": "Please rate how much you agree or disagree with each of the following statements about your romantic partner or relationship.",
      "qls1": "I would console this person in times of need.",
      "qls2": "I would protect this person in times of need.",
      "qls3": "I accept this person for whom he/she is.",
      "qls4": "I care about this person's well-being.",
      "qls5": "I tend not to judge this person.",
      "qls6": "I can feel for this person's emotions.",
      "qls7": "I would support this person in times of need.",
      "qls8": "I would give advice to this person if he/she asks.",
      "qls9": "I would be concerned if this person were distressed.",
      "qls10": "I tolerate this person's shortcomings.",
      "qls11": "I like to physically embrace this person.",
      "qls12": "I appreciate having this person in my life.",
      "qls13": "I am considerate of this person's feelings.",
      "qls14": "I respect this person.",
      "qls15": "The appearance of this person is attractive to me.",
      "qls16": "I feel strong emotional enthusiasm in the presence of this person.",
      "qls17": "I have tender feelings toward this person.",
      "qls18": "I enjoy giving this person compliments.",
      "qls19": "I admire this person.",
      "qls20": "The personality of this person is attractive to me.",
      "qls21": "I am comfortable asking this person for help.",
      "qls22": "I feel that this person and I have a lot in common.",
      "qls23": "I feel compatible to this person.",
      "qls24": "I feel emotionally bonded to this person.",
      "qls25": "With this person, I can be myself.",
      "qls26": "I feel accepted by this person.",
      "qls27": "I feel that I am understood by this person.",
      "qls28": "I can count on this person in this relationship.",
      "qls29": "I feel comfortable sharing my feelings with this person.",
      "qls30": "I trust this person's good intentions.",
      "qls31": "I want to be in this relationship.",
      "qls32": "I can forgive this person's transgressions.",
      "qls33": "I feel this relationship will last for a long time.",
      "qls34": "I want to manage difficulties fairly in this relationship.",
      "qls35": "I feel devoted to this relationship.",
      "qls36": "I can set aside my interests for this relationship.",
      "qls37": "I feel that this relationship is very special to me.",
      "qls38": "I am willing to cooperate with this person.",
      "qls39": "I feel that this relationship is stable.",
      "qls40": "I am ready to invest a great amount in this relationship.",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}