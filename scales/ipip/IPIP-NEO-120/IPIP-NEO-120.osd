{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "IPIP-NEO-120 Personality Inventory",
      "code": "IPIP-NEO-120",
      "abbreviation": "NEO-120",
      "description": "120-item IPIP measure of the 30 NEO PI-R facets (4 items per facet). Provides domain scores for Neuroticism, Extraversion, Openness, Agreeableness, and Conscientiousness, plus scores for all 30 facets. Shorter alternative to the IPIP-NEO-300.",
      "citation": "Johnson, J. A. (2014). Measuring thirty facets of the Five Factor Model with a 120-item measure: The IPIP-NEO-120. Journal of Research in Personality, 51, 78-89. https://doi.org/10.1016/j.jrp.2014.05.003",
      "license": "Public Domain",
      "version": "1.0",
      "url": "https://ipip.ori.org/30FacetNEO-PI-RItems.htm",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-05-02",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "ipip_likert_1",
        "ipip_likert_2",
        "ipip_likert_3",
        "ipip_likert_4",
        "ipip_likert_5"
      ],
      "question_head": "ipip_question_head"
    },
    "parameters": {
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order. Default off: items follow facet order."
      }
    },
