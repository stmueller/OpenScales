{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Motivational Regulatory Strategy Scale",
      "code": "MRSS",
      "abbreviation": "MRSS",
      "description": "23-item measure of the strategies language learners use to regulate their own motivation, developed for Indonesian learners of Japanese. Six subscales: self-talk, time management, opportunity control, efficacy enhancement, environmental structuring, and interest enhancement. Items are rated 1 (strongly disagree) to 7 (strongly agree). Item wording is specific to studying Japanese as a foreign language.",
      "citation": "Yamashita, J. (2023). Development of a motivational regulatory strategy scale for Indonesian learners of Japanese. Frontiers in Psychology, 14, 1245500. https://doi.org/10.3389/fpsyg.2023.1245500",
      "license": "CC BY 4.0",
      "license_explanation": "© 2023 by the author. Items reproduced from Yamashita (2023), Frontiers in Psychology, under a Creative Commons Attribution 4.0 International Deed.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2023.1245500",
      "version": "1.0",
      "domain": "Education"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-16",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Six subscales scored as means (1-7); all items forward-coded. The scale was developed and validated for Indonesian learners of Japanese (Yamashita, 2023); the subject/language is parameterized via the {topic} substitution (default blank for a generic version). Set the 'topic' parameter to 'Japanese' to reproduce the validated instrument verbatim. Item 12 was lightly reworded ('When I meet Japanese' -> 'When I meet {topic} speakers') so the substitution is grammatical for any topic. A stray leading '. ' on source item 21 was removed."
    },
    "parameters": {
      "topic": {
        "type": "string",
        "default": "",
        "description": "Subject or language being studied, inserted into the item wording (e.g. 'Japanese', 'Spanish', 'mathematics'). Defaults to blank for a generic version; set to 'Japanese' to reproduce the validated instrument from Yamashita (2023)."
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": ["likert_1", null, null, null, null, null, "likert_7"],
      "question_head": "question_head",
      "suppress_likert_numbers": true
    },
    "dimensions": [
      { "id": "self_talk", "name": "Self-Talk", "description": "Using internal dialogue to enhance motivation (items 1-5)." },
      { "id": "time_management", "name": "Time Management", "description": "Planning and scheduling study time (items 6-9)." },
      { "id": "opportunity_control", "name": "Opportunity Control", "description": "Creating opportunities to use the target language (items 10-13)." },
      { "id": "efficacy", "name": "Efficacy Enhancement", "description": "Bolstering one's own sense of capability (items 14-17)." },
      { "id": "env_structuring", "name": "Environmental Structuring", "description": "Arranging the physical study environment (items 18-20)." },
      { "id": "interest", "name": "Interest Enhancement", "description": "Making studying more enjoyable (items 21-23)." }
    ],
    "items": [
      { "id": "mrss1", "type": "likert", "text_key": "mrss1", "dimension": "self_talk" },
      { "id": "mrss2", "type": "likert", "text_key": "mrss2", "dimension": "self_talk" },
      { "id": "mrss3", "type": "likert", "text_key": "mrss3", "dimension": "self_talk" },
      { "id": "mrss4", "type": "likert", "text_key": "mrss4", "dimension": "self_talk" },
      { "id": "mrss5", "type": "likert", "text_key": "mrss5", "dimension": "self_talk" },
      { "id": "mrss6", "type": "likert", "text_key": "mrss6", "dimension": "time_management" },
      { "id": "mrss7", "type": "likert", "text_key": "mrss7", "dimension": "time_management" },
      { "id": "mrss8", "type": "likert", "text_key": "mrss8", "dimension": "time_management" },
      { "id": "mrss9", "type": "likert", "text_key": "mrss9", "dimension": "time_management" },
      { "id": "mrss10", "type": "likert", "text_key": "mrss10", "dimension": "opportunity_control" },
      { "id": "mrss11", "type": "likert", "text_key": "mrss11", "dimension": "opportunity_control" },
      { "id": "mrss12", "type": "likert", "text_key": "mrss12", "dimension": "opportunity_control" },
      { "id": "mrss13", "type": "likert", "text_key": "mrss13", "dimension": "opportunity_control" },
      { "id": "mrss14", "type": "likert", "text_key": "mrss14", "dimension": "efficacy" },
      { "id": "mrss15", "type": "likert", "text_key": "mrss15", "dimension": "efficacy" },
      { "id": "mrss16", "type": "likert", "text_key": "mrss16", "dimension": "efficacy" },
      { "id": "mrss17", "type": "likert", "text_key": "mrss17", "dimension": "efficacy" },
      { "id": "mrss18", "type": "likert", "text_key": "mrss18", "dimension": "env_structuring" },
      { "id": "mrss19", "type": "likert", "text_key": "mrss19", "dimension": "env_structuring" },
      { "id": "mrss20", "type": "likert", "text_key": "mrss20", "dimension": "env_structuring" },
      { "id": "mrss21", "type": "likert", "text_key": "mrss21", "dimension": "interest" },
      { "id": "mrss22", "type": "likert", "text_key": "mrss22", "dimension": "interest" },
      { "id": "mrss23", "type": "likert", "text_key": "mrss23", "dimension": "interest" }
    ],
    "scoring": {
      "self_talk": { "method": "mean_coded", "description": "Mean of items 1-5 (1-7).", "items": { "mrss1": 1, "mrss2": 1, "mrss3": 1, "mrss4": 1, "mrss5": 1 } },
      "time_management": { "method": "mean_coded", "description": "Mean of items 6-9 (1-7).", "items": { "mrss6": 1, "mrss7": 1, "mrss8": 1, "mrss9": 1 } },
      "opportunity_control": { "method": "mean_coded", "description": "Mean of items 10-13 (1-7).", "items": { "mrss10": 1, "mrss11": 1, "mrss12": 1, "mrss13": 1 } },
      "efficacy": { "method": "mean_coded", "description": "Mean of items 14-17 (1-7).", "items": { "mrss14": 1, "mrss15": 1, "mrss16": 1, "mrss17": 1 } },
      "env_structuring": { "method": "mean_coded", "description": "Mean of items 18-20 (1-7).", "items": { "mrss18": 1, "mrss19": 1, "mrss20": 1 } },
      "interest": { "method": "mean_coded", "description": "Mean of items 21-23 (1-7).", "items": { "mrss21": 1, "mrss22": 1, "mrss23": 1 } }
    }
  },
  "translations": {
    "en": {
      "question_head": "Please indicate how much you agree with each statement.",
      "likert_1": "Strongly disagree",
      "likert_7": "Strongly agree",
      "mrss1": "I imagine the sense of accomplishment after completing assignments.",
      "mrss2": "I think about how great I'll feel when I get this assignment finished.",
      "mrss3": "I remind myself that I will get a good grade if I follow my study plan.",
      "mrss4": "I think that my classmates will study harder and get better grades than me.",
      "mrss5": "I think of times when I have procrastinated and failed on past exams.",
      "mrss6": "I set short- and long-term goals for {topic} language study.",
      "mrss7": "I allocate time to study on my own outside of class.",
      "mrss8": "I establish a daily schedule so that I have time to study {topic}.",
      "mrss9": "I set realistic deadlines for my goals and make sure I achieve them by then.",
      "mrss10": "I try to make time to use {topic} voluntarily.",
      "mrss11": "I actively use the grammar and vocabulary I learned in daily conversation.",
      "mrss12": "When I meet {topic} speakers, I try to speak in {topic} as much as possible.",
      "mrss13": "I try to voluntarily increase my exposure to the {topic} language.",
      "mrss14": "I will tackle hard tasks with the confidence that I can do them.",
      "mrss15": "I gained more confidence that I can achieve the goals I have set for myself.",
      "mrss16": "When I do not make any progress in my studies, I tell myself I can do it.",
      "mrss17": "I tell myself that I can understand what I learn in class.",
      "mrss18": "I choose a place with few distractions for studying {topic}.",
      "mrss19": "I change the place where I study to change my mood.",
      "mrss20": "I take a break so that it is easy to concentrate on my {topic} study.",
      "mrss21": "I think of a way to make studying more interesting.",
      "mrss22": "I make my {topic} learning enjoyable by incorporating fun elements.",
      "mrss23": "I devise ways to make studying {topic} more enjoyable.",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}
