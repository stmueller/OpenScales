  "definition": {
    "scale_info": {
      "code": "MESx",
      "name": "Moral Expansiveness Scale – Short Form",
      "abbreviation": "MESx",
      "description": "10-item short form of the Moral Expansiveness Scale (MES). One entity exemplar is selected from each of the 10 original MES categories (family & friends, ingroup, outgroup, revered, marginalized, villains, high-sentience animals, low-sentience animals, plants, environment) based on highest factor loading within each category. Respondents place each entity into one of four nested moral circles scored 0–3. A single total score (range 0–30) indexes the breadth of moral concern. Psychometrically valid alternative to the full MES; unrelated to political conservatism unlike the full scale.",
      "citation": "Crimston, C. R., Hornsey, M. J., Bain, P. G., & Bastian, B. (2018). Moral expansiveness short form: Validity and reliability of the MESx. PLoS ONE, 13(10), e0205373. https://doi.org/10.1371/journal.pone.0205373",
      "license": "CC BY 4.0",
      "license_url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0205373",
      "license_explanation": "Published as open access under CC BY 4.0 in Crimston et al. (2018) PLoS ONE. Item texts are factual entity labels (common nouns).",
      "url": "https://doi.org/10.1371/journal.pone.0205373",
      "version": "1.0",
      "domain": "Morality & Ethics"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-11",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items selected by highest factor loading within each of the 10 original MES categories (Table 1, Crimston et al. 2018). Original task uses drag-and-drop circles; implemented here as 4-point ordered Likert scored 0–3 matching original scale values. Single total score only; no subscales defined for the short form."
    },
    "likert_options": {
      "points": 4,
      "min": 0,
