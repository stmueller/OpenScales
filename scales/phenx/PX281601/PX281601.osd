      "religious_behaviors_congregational_support_unpleasant_people_critical_opt_1": "Very often",
      "religious_behaviors_congregational_support_unpleasant_people_critical_opt_2": "Fairly often",
      "religious_behaviors_congregational_support_unpleasant_people_critical_opt_3": "Once in a while",
