        "name": "Stress Sensitivity",
        "description": "Tendency to become overwhelmed or distressed by demanding situations and change"
      },
      {
        "id": "SensorySensitivity",
        "name": "Sensory Sensitivity",
        "description": "Sensitivity to external sensory stimuli such as light, sounds, textures"
      },
