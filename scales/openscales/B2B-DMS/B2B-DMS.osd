  "translations": {
    "en": {
      "b2b_dms_inst": "The following statements are about how your company makes purchasing decisions. Please indicate how much you disagree or agree with each statement.",
      "b2b_dms01": "Procuring very good quality is very important for my company.",
      "b2b_dms02": "When purchasing products or services, my company attempts to get the very best or perfect choice.",
      "b2b_dms03": "My company normally attempts to buy the best overall quality.",
      "b2b_dms04": "My company puts special efforts into choosing the very best quality products or services.",
      "b2b_dms05": "My company's standards and expectations for product or service purchases are very high.",
      "b2b_dms06": "My company takes the time to carefully purchase the best option.",
      "b2b_dms07": "Suppliers that do the most advertising are usually very good choices for my company.",
      "b2b_dms08": "There are so many suppliers to choose from that the buying agents in my company get often confused.",
      "b2b_dms09": "Sometimes it is hard for my company to choose which suppliers to buy from.",
      "b2b_dms10": "The more information my company receives about products or services, the harder it is for the buying agent to choose the best option.",
      "b2b_dms11": "All the information my company gets on different products or services confuses the buying agents.",
      "b2b_dms12": "When purchasing products or services, my company does not give so much thought or care.",
      "b2b_dms13": "In my company, procurement is done very quickly, buying the first product or service or from the first supplier that seems good enough.",
      "b2b_dms14": "My company should plan its procurement more carefully than it usually does.",
      "b2b_dms15": "My company buys impulsively.",
      "b2b_dms16": "My company makes thoughtless purchases that it later regrets.",
      "b2b_dms17": "My company usually has the very newest products or services available.",
      "b2b_dms18": "My company keeps its inventories up-to-date with the upcoming product or service novelties.",
      "b2b_dms19": "My company is keen on buying novelty products or services.",
      "b2b_dms20": "My company has favourite suppliers it buys from over and over.",
      "b2b_dms21": "Once my company finds a suitable supplier, it holds on to it.",
      "b2b_dms22": "My company buys from the same suppliers each time it undergoes purchasing activities.",
      "b2b_dms23": "My company searches carefully to find the best value for the money it spends.",
      "b2b_dms24": "My company carefully monitors how much it spends.",
      "b2b_dms25": "My company considers that the well-known national and international suppliers are the best to buy from.",
      "b2b_dms26": "My company prefers to buy from the best-selling suppliers.",
      "b2b_dms_r1": "Completely disagree",
      "b2b_dms_r6": "Completely agree",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
