{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "SSS",
      "name": "Spirituality of Science Scale",
      "abbreviation": "SSS",
      "description": "10-item unidimensional scale measuring the extent to which individuals experience science as a source of spiritual or transcendent meaning, including peak experiences, deep connection, awe, and purpose derived from scientific engagement.",
      "citation": "Preston, J. L., Coleman, T. J., III, & Shin, F. (2025). Spirituality of science: Implications for meaning, well-being, and learning. Personality and Social Psychology Bulletin, 51(4), 632–643. https://doi.org/10.1177/01461672231191356",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1177/01461672231191356",
      "version": "1.0",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
