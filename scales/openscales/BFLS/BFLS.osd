  "translations": {
    "en": {
      "LANGUAGE": "English",
      "bfls_head": "Read the following statement and indicate how often it describes you",
      "bfls_lbl0": "Never",
      "bfls_lbl1": "Rarely",
      "bfls_lbl2": "Sometimes",
      "bfls_lbl3": "Almost always",
      "bfls_lbl4": "Always",
      "bfls_1": "I am afraid that someone might abandon me",
      "bfls_2": "The idea of being alone worries me",
      "bfls_3": "I am afraid of being alone",
      "bfls_4": "When I am alone, I seek out someone's company",
      "bfls_5": "I worry that someone might distance themselves from me"
    },
    "es": {
      "LANGUAGE": "Español",
      "bfls_head": "Lea la siguiente afirmación e indique con qué frecuencia le describe",
      "bfls_lbl0": "Nunca",
      "bfls_lbl1": "Raramente",
      "bfls_lbl2": "Algunas veces",
      "bfls_lbl3": "Casi siempre",
      "bfls_lbl4": "Siempre",
      "bfls_1": "Temo que alguien pueda abandonarme",
      "bfls_2": "La idea de estar solo me preocupa",
      "bfls_3": "Tengo miedo a estar solo",
      "bfls_4": "Cuando estoy solo, busco la compañía de alguien",
      "bfls_5": "Me preocupa que alguien se aleje de mi lado"
    }
  }
