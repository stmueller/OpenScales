  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_X185": "Don't fall for sob-stories.",
      "ipip_E179": "Don't put a lot of thought into things.",
      "ipip_H422": "Cut others to pieces.",
      "ipip_H769": "Demand to be the center of interest.",
      "ipip_H4": "Do most of the talking.",
      "ipip_H527": "Speak loudly.",
      "ipip_H162": "Let others finish what they are saying.",
      "ipip_X247": "Seldom toot my own horn.",
      "ipip_H548": "Speak softly.",
      "ipip_H1170": "Tolerate a lot from others.",
      "ipip_X112": "Feel comfortable around people",
      "ipip_H78": "Love large parties",
      "ipip_X83": "Talk to a lot of different people at parties",
      "ipip_H589": "Am a very private person",
      "ipip_H661": "Am quiet around strangers",
      "ipip_X56": "Don't talk a lot",
      "ipip_H1039": "Have little to say",
      "ipip_H21": "Am interested in people",
      "ipip_H31": "Get along well with others",
      "ipip_H225": "Inquire about others' well-being.",
      "ipip_H1120": "Reassure others",
      "ipip_X227": "Am not interested in other people’s problems.",
      "ipip_H808": "Contradict others",
      "ipip_H917": "Have a sharp tongue",
      "ipip_H1085": "Snap at people",
      "ipip_H525": "Demand attention",
      "ipip_X169": "Dislike being the center of attention",
      "ipip_H16": "Start conversations",
      "ipip_X195": "Seldom stretch the truth",
      "ipip_E144": "Take things as they come",
      "ipip_H126": "Think of others first",
      "ipip_X70": "Believe people should fend for themselves."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_H162": "Dopuštam drugima da dovrše ono što govore.",
      "ipip_H525": "Zahtevam da se na mene obrati pažnja.",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_H917": "Imam oštar jezik.",
      "ipip_H1170": "Mogu puno toga da tolerišem drugima.",
      "ipip_X247": "Retko se hvališem.",
      "ipip_H126": "Drugi su mi na prvom mestu.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H422": "Nemilosrdan sam prema drugima.",
      "ipip_H589": "Volim da svoje privatne stvari zadržim za sebe.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_H769": "Zahtevam da budem u centru interesovanja.",
      "ipip_X195": "Retko iskrivljujem istinu.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_H527": "Govorim glasno.",
      "ipip_H31": "Slažem se dobro sa drugima.",
      "ipip_H548": "Pričam odmerenim tonom.",
      "ipip_H78": "Volim velike žurke.",
      "ipip_H1085": "Često se brecam na druge ljude.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_H808": "Protivrečim drugima.",
      "ipip_X70": "Verujem da ljudi treba sami da se zauzmu za sebe.",
      "ipip_H225": "Raspitujem se kako su drugi ljudi.",
      "ipip_X169": "Ne volim biti u centru pažnje.",
      "ipip_H1120": "Često hrabrim druge.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_E144": "Prihvatam stvari onakve kakve su.",
      "ipip_X185": "Ne padam na sentimentalne priče.",
      "ipip_E179": "Ne razmišljam mnogo o stvarima.",
      "ipip_H4": "Uglavnom sam ja taj koji priča."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_H16": "Sätter igång konversationer",
      "ipip_H162": "Låter andra avsluta vad de håller på att säga",
      "ipip_H525": "Kräver uppmärksamhet",
      "ipip_H661": "Är tyst tillsammans med främlingar",
      "ipip_H917": "Har en skarp tunga",
      "ipip_H1170": "Står ut med mycket från andra",
      "ipip_X247": "Låter sällan min egen röst höras",
      "ipip_H126": "Tänker först på andra",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_H422": "Knäcker andra personer",
      "ipip_H589": "Är mycket privat som person",
      "ipip_X227": "Är inte intresserad av andra människors problem",
      "ipip_X83": "Pratar med en massa olika människor på fester",
      "ipip_H769": "Kräver att vara centrum för intresset?",
      "ipip_X195": "Tänjer sällan på sanningen",
      "ipip_H1039": "Har lite att säga",
      "ipip_H527": "Talar högt",
      "ipip_H31": "Kommer bra överens med andra",
      "ipip_H548": "Talar tyst",
      "ipip_H78": "Älskar stora fester",
      "ipip_H1085": "Fräser åt folk",
      "ipip_X56": "Pratar inte mycket",
      "ipip_H808": "Motsäger andra",
      "ipip_X70": "Tror på att människor skall försörja sig själv",
      "ipip_H225": "Hör mig för om andras välbefinnande",
      "ipip_X169": "Tycker illa om att vara i centrum för andras uppmärksamhet",
      "ipip_H1120": "Uppmuntrar andra",
      "ipip_H21": "Är intresserad av människor",
      "ipip_E144": "Tar saker som de kommer",
      "ipip_X185": "Faller inte för gråthistorier",
      "ipip_E179": "Tänker inte över saker speciellt mycket",
      "ipip_H4": "Är den som talar mest"
    }
  }
}
