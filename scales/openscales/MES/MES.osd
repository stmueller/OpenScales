      { "id": "mes30", "type": "likert", "text_key": "mes30", "dimension": "nature" }
    ],
    "scoring": {
      "humans": {
        "method": "sum_coded",
        "description": "Sum of Human target items (1–18). Range 0–54; higher = broader moral concern for humans.",
        "items": {"mes01":1,"mes02":1,"mes03":1,"mes04":1,"mes05":1,"mes06":1,
                  "mes07":1,"mes08":1,"mes09":1,"mes10":1,"mes11":1,"mes12":1,
                  "mes13":1,"mes14":1,"mes15":1,"mes16":1,"mes17":1,"mes18":1}
      },
      "animals": {
        "method": "sum_coded",
        "description": "Sum of Animal target items (19–24). Range 0–18; higher = broader moral concern for animals.",
        "items": {"mes19":1,"mes20":1,"mes21":1,"mes22":1,"mes23":1,"mes24":1}
      },
      "nature": {
        "method": "sum_coded",
        "description": "Sum of Nature target items (25–30). Range 0–18; higher = broader moral concern for nature.",
        "items": {"mes25":1,"mes26":1,"mes27":1,"mes28":1,"mes29":1,"mes30":1}
      },
      "total": {
        "method": "sum_coded",
        "description": "Sum of all 30 items. Range 0–90; higher = more expansive moral circle.",
        "items": {"mes01":1,"mes02":1,"mes03":1,"mes04":1,"mes05":1,"mes06":1,
                  "mes07":1,"mes08":1,"mes09":1,"mes10":1,"mes11":1,"mes12":1,
                  "mes13":1,"mes14":1,"mes15":1,"mes16":1,"mes17":1,"mes18":1,
