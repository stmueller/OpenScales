{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "DBS",
      "name": "Digital Burnout Scale",
      "abbreviation": "DBS",
      "description": "37-item scale measuring digital burnout across five dimensions relevant to the AI era: Behavior Addictions (5 items) — compulsive digital device use; Cognitive Dissonance (4 items) — value conflicts driven by digital media; Cognitive Overload (9 items, items X10–X13, X29–X37 span both Cognitive Overload and Emotion Exhaustion per PDF layout) — information and comparison overload leading to anxiety; Digital Aging (11 items) — physical and social deterioration from digital device use; Digital Deprivation (8 items) — anxiety and withdrawal when disconnected from digital devices. Rated on a 7-point Likert scale.",
      "citation": "Zhao, L., Zhao, J., Cao, E. Y., Li, K. K., Pan, L., Zou, Y., & Sun, X. (2026). Development and validation of a Digital Burnout Scale in artificial intelligence era. Frontiers in Psychology, 16. https://doi.org/10.3389/fpsyg.2025.1580422",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2025.1580422",
      "version": "1.0",
      "domain": "Technology"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": ["DBS_r1", "DBS_r2", "DBS_r3", "DBS_r4", "DBS_r5", "DBS_r6", "DBS_r7"],
      "question_head": "DBS_head"
    },
    "dimensions": [
      {
        "id": "BehaviorAddictions",
        "name": "Behavior Addictions",
        "description": "Compulsive use of digital devices and entertainment software that undermines learning and engagement with the physical world"
      },
      {
        "id": "CognitiveDissonance",
        "name": "Cognitive Dissonance",
        "description": "Value conflicts and internal contradictions driven by exposure to digital media and AI-driven information"
      },
      {
        "id": "CognitiveOverload",
        "name": "Cognitive Overload",
        "description": "Anxiety, inferiority, and distress from information overload and upward social comparisons in digital environments"
      },
      {
        "id": "DigitalAging",
        "name": "Digital Aging",
        "description": "Physical deterioration and social withdrawal associated with prolonged digital device use"
      },
      {
        "id": "DigitalDeprivation",
        "name": "Digital Deprivation",
        "description": "Anxiety, restlessness, and isolation experienced when disconnected from digital devices or the internet"
      },
      {
        "id": "EmotionExhaustion",
        "name": "Emotion Exhaustion",
        "description": "Emotional depletion, irritability, and overwhelm from excessive digital content and notifications"
      }
    ],
    "items": [
