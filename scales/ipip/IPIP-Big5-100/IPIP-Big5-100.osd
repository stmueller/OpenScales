    "hr": {
      "ipip_question_head": "<h3>Koliko točno možete opisati sebe?</h3><p>Na sljedećim stranicama nalaze se tvrdnje koje opisuju uobičajeno ponašanje ljudi. Molimo vas da, koristeći se priloženom ljestvicom, procijenite koliko pojedini iskaz vjerno opisuje baš vas.</p>",
      "ipip_likert_3": "Ni točno ni netočno",
      "ipip_likert_1": "Posve netočno",
      "ipip_debrief": "Hvala vam na sudjelovanju.",
      "ipip_likert_4": "Uglavnom točno",
      "ipip_likert_2": "Uglavnom netočno",
      "ipip_likert_5": "Posve točno",
      "ipip_H761": "Lako se uzrujam.",
      "ipip_H244": "Volim pospremati.",
      "ipip_H154": "Držim se po strani.",
      "ipip_X231": "Rijetko se razbjesnim.",
      "ipip_H1130": "Suosjećam s drugima.",
      "ipip_H612": "Lako se osjetim ugroženim.",
      "ipip_H1351": "Sve radim prema planu.",
      "ipip_H1227": "Podižem raspravu na višu razinu.",
      "ipip_H107": "Nastojim da se drugi osjećaju ugodno.",
      "ipip_H589": "Vrlo sam povučena osoba.",
      "ipip_H21": "Zanimaju me drugi ljudi.",
      "ipip_X74": "Često sam potišten.",
      "ipip_X272": "Nisam maštovit.",
      "ipip_X163": "Posao obavljam točno i precizno.",
      "ipip_X73": "Volim djecu.",
      "ipip_H1246": "Dobar (dobra) sam u nizu područja.",
      "ipip_H1146": "Prikrivam svoje osjećaje.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_E92": "Često mijenjam raspoloženja.",
      "ipip_X203": "Ravnodušan sam prema tuđim osjećajima.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H1276": "Imam bogat rječnik.",
      "ipip_H286": "Nastavljam s poslom dok sve nije savršeno.",
      "ipip_H948": "Lako se uspaničim.",
      "ipip_H1140": "Izbjegavam obaveze.",
      "ipip_H1413": "Poslove obavljam polovično.",
      "ipip_H976": "Čekam da drugi preuzmu vodstvo.",
      "ipip_H16": "Prvi započinjem razgovore.",
      "ipip_H1103": "Vrijeđam ljude.",
      "ipip_X114": "Provodim vrijeme razmišljajući o stvarima.",
      "ipip_H592": "Teško pristupam drugima.",
      "ipip_H126": "Prvo mislim na druge.",
      "ipip_X109": "Izbjegavam čitanje složenih sadržaja.",
      "ipip_H1186": "Tratim svoje vrijeme.",
      "ipip_X211": "Volim čitati izazovne sadržaje.",
      "ipip_H22": "Za svakoga imam lijepu riječ.",
      "ipip_H1322": "Mogu baratati mnoštvom informacija.",
      "ipip_H34": "Unosim živost u svaku zabavu.",
      "ipip_H1133": "Gunđam.",
      "ipip_E171": "Trudim se izbjeći intelektualne tipove.",
      "ipip_H37": "U dobrim sam odnosima s gotovo svima.",
      "ipip_X179": "Slijedim zacrtani plan.",
      "ipip_H754": "Lako se razljutim.",
      "ipip_text_take_offense_easily": "Lako se uvrijedim.",
      "ipip_H53": "Pun(a) sam ideja.",
      "ipip_H822": "Ostavljam nered u svojoj sobi.",
      "ipip_X156": "Rijetko sam tužan.",
      "ipip_X275": "Brzo shvaćam.",
      "ipip_X244": "Ne brinem se puno za druge ljude.",
      "ipip_H1189": "Zanemarujem svoje dužnosti.",
      "ipip_X165": "Drugi me zapravo i ne zanimaju.",
      "ipip_X138": "Malo što mi smeta.",
      "ipip_X120": "Zaokupe me moji problemi.",
      "ipip_X177": "Imam meko srce.",
      "ipip_H1171": "Teško mi je prihvatiti se posla.",
      "ipip_H926": "Često mijenjam raspoloženja.",
      "ipip_X87": "Uvijek sam pripravan.",
      "ipip_H173": "Znam kako utješiti druge.",
      "ipip_H950": "Preplavljuju me osjećaji.",
      "ipip_X265": "Rijetko se iznerviram.",
      "ipip_X14": "Imam živu maštu.",
      "ipip_X100": "Brzo shvaćam različite stvari.",
      "ipip_E119": "Odmah obavljam svakodnevne poslove.",
      "ipip_H1039": "Imam malo toga reći.",
      "ipip_X118": "Volim red.",
      "ipip_X263": "Držim se planova koje sam zacrtao.",
      "ipip_H909": "Često se osjećam neugodno kada sam u društvu.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_text_leave_my_belongings_around": "Ostavljam stvari uokolo.",
      "ipip_text_show_my_gratitude": "Pokazujem svoju zahvalnost.",
      "ipip_X82": "Često zaboravljam vratiti stvari na njihovo mjesto.",
      "ipip_E141": "Uglavnom sam opušten.",
      "ipip_H1366": "Vješto se snalazim u društvenim situacijama.",
      "ipip_X176": "Teško razumijem apstraktne ideje.",
      "ipip_H1108": "Volim pomagati drugima.",
      "ipip_H334": "Preuzimam odgovornost.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_X107": "Lako se uznemirim.",
      "ipip_H1382": "Teško zamišljam stvari.",
      "ipip_H1110": "Znam kako osvojiti ljude.",
      "ipip_X83": "Na zabavama razgovaram s mnogo različitih ljudi.",
      "ipip_H1157": "Zabrinut sam.",
      "ipip_X78": "Ne smeta me biti u središtu pažnje.",
      "ipip_H1313": "Imam izvrsne ideje.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_E136": "Osjećam tuđe emocije.",
      "ipip_text_am_easily_disturbed": "Lako me zasmetati.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_H661": "Šutljiv(a) sam s nepoznatima.",
      "ipip_H160": "Posvećujem vrijeme drugim ljudima.",
      "ipip_X112": "Ugodno se osjećam među ljudima.",
      "ipip_text_inquire_about_others_well_being": "Zanimam se za dobrobit drugih ljudi.",
      "ipip_H1272": "Koristim učene izraze.",
      "ipip_H1392": "Ni u što se previše ne zadubljujem.",
      "ipip_X225": "Volim domišljati nove načine kako nešto učiniti.",
      "ipip_X68": "Ne volim privlačiti pažnju.",
      "ipip_H1467": "Unosim zbrku.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H309": "Volim red i točnost.",
      "ipip_H1": "Osjećam se opušteno s ljudima."
    },
    "sl": {
      "ipip_likert_3": "Niti točno niti netočno",
      "ipip_likert_5": "Zelo točno",
      "ipip_likert_4": "Dokaj točno",
      "ipip_likert_1": "Zelo netočno",
      "ipip_question_head": "<h3>Kako natančno se lahko opišete?</h3><p>Na naslednjih straneh so trditve, ki opisujejo vedenje ljudi. S pomočjo spodnje lestvice ocenite, kako natančno vsaka trditev opisuje vas. Opišite se, kakršni ste na splošno zdaj, ne kakršni bi želeli biti v prihodnosti. Vaši odgovori bodo ostali zaupni.</p>",
      "ipip_debrief": "Hvala, ker ste izpolnili ta vprašalnik.",
      "ipip_likert_2": "Dokaj netočno",
      "ipip_H1": "V družbi sem sproščen.",
      "ipip_E136": "Čutim, kaj doživljajo drugi ljudje.",
      "ipip_H1351": "Stvari delam načrtno.",
      "ipip_H1322": "Lahko delam z veliko podatki.",
      "ipip_H16": "Rad začnem pogovor.",
      "ipip_H1110": "Znam pridobiti ljudi.",
      "ipip_H950": "Čustva me prevzamejo.",
      "ipip_H1382": "Težko si predstavljam stvari.",
      "ipip_X156": "Redko sem potrt.",
      "ipip_H1103": "Žalim ljudi.",
      "ipip_H754": "Hitro se razjezim.",
      "ipip_H926": "Pogosto spreminjam svoje razpoloženje.",
      "ipip_H160": "Vzamem si čas za druge.",
      "ipip_X228": "Ne zanimam se za abstraktne ideje.",
      "ipip_H107": "Ob meni se ljudje počutijo sproščeni.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_X107": "Hitro postanem preobremenjen.",
      "ipip_H589": "Sem zadržan.",
      "ipip_H173": "Znam potolažiti druge.",
      "ipip_X68": "Nerad zbujam pozornost.",
      "ipip_H1413": "Stvari naredim na pol.",
      "ipip_H976": "Čakam na druge, da prevzamejo vodstvo.",
      "ipip_H309": "Rad imam točnost in red.",
      "ipip_H244": "Rad pospravljam.",
      "ipip_X179": "Držim se svojega urnika.",
      "ipip_X231": "Redko pobesnim.",
      "ipip_H37": "Skoraj z vsemi sem v dobrih odnosih.",
      "ipip_E171": "Poskušam se izogibati zapletenim ljudem.",
      "ipip_X265": "Redko sem razdražen.",
      "ipip_X120": "Utapljam se v težavah.",
      "ipip_X263": "Delam načrte in se jih tudi držim.",
      "ipip_X74": "Pogosto sem otožen.",
      "ipip_X78": "Nič nimam proti, če sem v središču pozornosti.",
      "ipip_H1108": "Rad pomagam drugim.",
      "ipip_X211": "Rad berem tekste, ki so mi v izziv.",
      "ipip_X165": "Nisem ravno zainteresiran za druge.",
      "ipip_H126": "Najprej pomislim na druge.",
      "ipip_H596": "Drugi me težko spoznajo.",
      "ipip_H1392": "Ne poglabljam se v stvari.",
      "ipip_X100": "Stvari hitro dojemam.",
      "ipip_text_am_easily_disturbed": "Hitro se zmedem.",
      "ipip_H1146": "Potlačujem svoja čustva.",
      "ipip_H761": "Zapravljam čas.",
      "ipip_X275": "Stvari hitro dojemam.",
      "ipip_H21": "Zanimam se za druge.",
      "ipip_X176": "Težko razumem abstraktne pojme.",
      "ipip_H909": "Pogosto se počutim nelagodno v družbi.",
      "ipip_X225": "Rad se domislim novih načinov, kako delati stvari.",
      "ipip_X177": "Sem »mehkega srca«.",
      "ipip_H612": "Hitro se počutim ogroženega.",
      "ipip_X203": "Brezbrižen sem do čustev drugih.",
      "ipip_H286": "Ne končam, preden ni vse popolno.",
      "ipip_X82": "Pogosto pozabim pospraviti stvari na svoje mesto.",
      "ipip_E141": "Večino časa sem sproščen.",
      "ipip_text_inquire_about_others_well_being": "Zanimam se za dobrobit drugih.",
      "ipip_X272": "Nimam bujne domišljije.",
      "ipip_X73": "Rad imam otroke.",
      "ipip_X14": "Imam bogato domišljijo.",
      "ipip_H34": "Sem gonilna sila zabav.",
      "ipip_H53": "Imam polno idej.",
      "ipip_X138": "Stvari me ne zmotijo zlahka.",
      "ipip_X87": "Vedno sem pripravljen.",
      "ipip_H334": "Zavzamem se za stvari.",
      "ipip_H1140": "Izmikam se dolžnostim.",
      "ipip_X114": "Veliko časa porabim za razmišljanje.",
      "ipip_X112": "V družbi se prijetno počutim.",
      "ipip_H29": "Zlahka se spoprijateljim.",
      "ipip_H592": "Težko pristopim k drugim.",
      "ipip_H1171": "Težko se spravim k delu.",
      "ipip_X56": "Ne govorim veliko.",
      "ipip_H154": "Držim se v ozadju.",
      "ipip_E92": "Moje razpoloženje pogosto niha.",
      "ipip_X244": "Ne skrbi me za druge.",
      "ipip_H1189": "Zanemarjam svoje dolžnosti.",
      "ipip_H1276": "Imam bogat besedni zaklad.",
      "ipip_H1366": "Dobro se znajdem med ljudmi.",
      "ipip_text_take_offense_easily": "Hitro sem užaljen.",
      "ipip_H822": "V svoji sobi imam nered.",
      "ipip_H661": "V prisotnosti tujcev sem tih.",
      "ipip_H1467": "Povzročam zmešnjavo.",
      "ipip_H1227": "Rad preusmerim pogovor na zahtevnejšo raven.",
      "ipip_H1246": "Dober sem v mnogih stvareh.",
      "ipip_X109": "Izogibam se zahtevnemu branju.",
      "ipip_H1130": "Sočustvujem z drugimi.",
      "ipip_X163": "Pri svojem delu sem natančen.",
      "ipip_X83": "Na zabavi se rad pogovarjam z veliko različnimi ljudmi.",
      "ipip_H1133": "Pritožujem se nad stvarmi.",
      "ipip_X227": "Ne zanimam se za probleme drugih ljudi.",
      "ipip_H1039": "Imam malo za povedati.",
      "ipip_H1157": "Skrbi me za različne stvari.",
      "ipip_H1272": "Uporabljam zahtevne besede.",
      "ipip_text_leave_my_belongings_around": "Svoje stvari puščam naokoli.",
      "ipip_E119": "Obveznosti opravim takoj.",
      "ipip_H1362": "Pozoren sem na podrobnosti.",
      "ipip_H22": "Za vsakogar imam dobro besedo.",
      "ipip_X95": "Zlahka se razburim.",
      "ipip_text_show_my_gratitude": "Pokažem hvaležnost.",
      "ipip_X118": "Rad imam red.",
      "ipip_H1186": "Zlahka se razburim.",
      "ipip_H948": "Zlahka me zgrabi panika."
    },
    "sr": {
      "ipip_likert_1": "Potpuno netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_H107": "Činim da se ljudi osećaju spokojno.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_H1133": "Često u gunđam u vezi nekih stvari.",
      "ipip_H1130": "Saosećam sa drugima.",
      "ipip_X272": "Nemam bujnu maštu.",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_H173": "Umem da utešim druge.",
      "ipip_H1392": "Nisam sklon da se previše udubljujem u problem.",
      "ipip_X165": "Nisam preterano zainteresovan za druge.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_H1140": "Izbegavam svoje obaveze.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_H1246": "Dobar sam u mnogim stvarima.",
      "ipip_H1157": "Često sam zabrinut.",
      "ipip_H926": "Često menjam raspolozenja.",
      "ipip_H1322": "Mogu izaći na kraj sa velikom količinom informacija.",
      "ipip_H1186": "Često traćim svoje vreme.",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_X138": "Ne potresam se lako zbog stvari.",
      "ipip_H1413": "Mnoge stvari radim polovično.",
      "ipip_H948": "Lako se uspaničim",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H1382": "Teško mi je da zamislim neke stvari.",
      "ipip_H754": "Lako pobesnim.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H286": "Ono što radim, dovodim do savršenstva.",
      "ipip_H612": "Lako se osetim ugroženim.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_X82": "Često zaboravim da vratim stvari na svoje mesto.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H22": "Za svakog imam lepu reč.",
      "ipip_X118": "Volim red.",
      "ipip_X176": "Imam poteškoća u razumevanju apstraktnih ideja.",
      "ipip_H53": "Pun sam ideja.",
      "ipip_E119": "Svoje obaveze obavljam odmah.",
      "ipip_text_take_offense_easily": "Lako se uvredim.",
      "ipip_H37": "U dobrim sam odnosima skoro sa svima.",
      "ipip_X203": "Ravnodušan sam prema tuđim emocijama.",
      "ipip_X73": "Volim decu.",
      "ipip_H1189": "Često zanemarujem svoje obaveze.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_H334": "Često preuzimam stvari na sebe.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_H1366": "Vešt sam u socijalnim situacijama.",
      "ipip_X265": "Retko se iznerviram.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_X263": "Pravim planove i pridržavam ih se.",
      "ipip_text_show_my_gratitude": "Kada sam zahvalan, to i pokažem.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_X177": "Mekog sam srca.",
      "ipip_H1351": "Kad nešto radim, obično se pridržavam plana.",
      "ipip_H34": "Uvek sam glavni na žurci.",
      "ipip_X231": "Retko se naljutim.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_H1227": "Podižem razgovor na viši nivo.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_H1467": "Često pravim nered.",
      "ipip_text_inquire_about_others_well_being": "Raspitujem se kako su drugi ljudi.",
      "ipip_H1171": "Teško mi je da prionem na posao.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_X244": "Vrlo malo brinem za druge.",
      "ipip_X87": "Uvek sam spreman na sve.",
      "ipip_X275": "Brzo shvatam stvari.",
      "ipip_H1": "Osećam se opušteno u društvu drugih.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_H1108": "Volim da pomažem drugima.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H309": "Volim red i pravila.",
      "ipip_H976": "Prepuštam vođstvo drugima.",
      "ipip_H126": "Drugi su mi na prvom mestu.",
      "ipip_text_leave_my_belongings_around": "Često ostavljam svoje stvari svuda unaokolo.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_H1146": "Svoja osećanja zadržavam za sebe..",
      "ipip_X120": "Lako se \"zapetljam\" u probleme.",
      "ipip_E136": "Osećam emocije drugih ljudi.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_H589": "Volim da svoje privatne stvari zadržim za sebe.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H160": "Odvajam vreme za druge.",
      "ipip_X114": "Provodim vreme razmišljajući o stvarima.",
      "ipip_H1110": "Umem da oduševim druge ljude.",
      "ipip_H244": "Volim da spremam.",
      "ipip_X225": "Volim da smišljam nove načine kako da uradim nesto.",
      "ipip_text_am_easily_disturbed": "Lako me je uznemiriti.",
      "ipip_H1272": "Često koristim komplikovane reči.",
      "ipip_H950": "Često me preplave emocije.",
      "ipip_H822": "Ostavljam nered u svojoj sobi."
    },
    "sv": {
      "ipip_likert_1": "Mycket inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_H21": "Är intresserad av människor",
      "ipip_X211": "Älskar att läsa tankeväckande skrifter",
      "ipip_H107": "Får människor att känna sig väl till mods",
      "ipip_X179": "Följer ett schema",
      "ipip_H29": "Har lätt för att få vänner",
      "ipip_H1133": "Muttrar om saker",
      "ipip_H1130": "Sympatiserar med andras känslor",
      "ipip_X272": "Är fantasilös",
      "ipip_H661": "Är tyst tillsammans med främlingar",
      "ipip_H173": "Vet hur man tröstar andra",
      "ipip_H1392": "Kommer inte att tränga djupt in i ett område",
      "ipip_X165": "Är egentligen inte intresserad av andra",
      "ipip_X163": "Är grundlig i mitt arbete",
      "ipip_X83": "Pratar med en massa olika människor på fester",
      "ipip_E171": "Försöker undvika komplicerade personer",
      "ipip_H1140": "Smiter undan mina plikter",
      "ipip_E92": "Har ofta förekommande humörsvängningar",
      "ipip_H592": "Tycker det är svårt att ta kontakt med andra",
      "ipip_X156": "Känner mig sällan nere",
      "ipip_H1246": "Är bra på många saker",
      "ipip_H1157": "Oroar mig över saker",
      "ipip_H926": "Har ett humör som svänger mycket",
      "ipip_H1322": "Kan hantera mycket information",
      "ipip_H1186": "Slösar bort min tid",
      "ipip_H16": "Sätter igång konversationer",
      "ipip_X138": "Blir sällan störd av saker",
      "ipip_H1413": "Gör saker på ett halvdant sätt",
      "ipip_H948": "Blir lätt panikslagen",
      "ipip_X228": "Är inte intresserad av abstrakta idéer",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_H1382": "Har svårt att föreställa mig saker",
      "ipip_H754": "Blir lätt arg",
      "ipip_X100": "Förstår saker snabbt",
      "ipip_H1276": "Har ett rikt ordförråd",
      "ipip_H286": "Fortsätter tills allt är perfekt",
      "ipip_H612": "Känner mig ofta rädd",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_X82": "Glömmer ofta att lägga tillbaka saker på sin plats",
      "ipip_X95": "Blir lätt upprörd",
      "ipip_H22": "Har något gott att säga om alla",
      "ipip_X118": "Tycker om ordning",
      "ipip_X176": "Har svårt att förstå abstrakta idéer",
      "ipip_H53": "Är full av idéer",
      "ipip_E119": "Gör hushållsarbete genast",
      "ipip_text_take_offense_easily": "Tar lätt illa upp",
      "ipip_H37": "Är på god fot med nästan alla",
      "ipip_X203": "Är likgiltig inför andras känslor",
      "ipip_X73": "Älskar barn",
      "ipip_H1189": "Struntar i mina plikter",
      "ipip_H154": "Håller mig i bakgrunden",
      "ipip_H334": "Tar kommandot",
      "ipip_X78": "Har inte något emot att vara centrum för uppmärksamheten",
      "ipip_H1366": "Är skicklig på att handskas med sociala situationer",
      "ipip_X265": "Blir sällan irriterad",
      "ipip_X14": "Har en livlig fantasi",
      "ipip_X263": "Gör upp planer och håller mig till dem",
      "ipip_text_show_my_gratitude": "Visar min tacksamhet",
      "ipip_H1362": "Uppmärksammar detaljer",
      "ipip_X177": "Har ett gott hjärta",
      "ipip_H1351": "Gör saker enligt planen",
      "ipip_H34": "Är den som håller igång på ett party",
      "ipip_X231": "Blir sällan förbannad",
      "ipip_X109": "Undviker svårlästa artiklar och böcker",
      "ipip_H1227": "För konversationen till en högre nivå",
      "ipip_H761": "Blir lätt irriterad",
      "ipip_X56": "Pratar inte mycket",
      "ipip_H1467": "Skapar oreda omkring mig",
      "ipip_text_inquire_about_others_well_being": "Hör mig för om andras välbefinnande",
      "ipip_H1171": "Tycker det är svårt att få saker gjort",
      "ipip_H1039": "Har lite att säga",
      "ipip_X244": "Känner mig inte speciellt bekymrad om andra",
      "ipip_X87": "Är alltid förberedd",
      "ipip_X275": "Fattar saker snabbt",
      "ipip_H1": "Känner mig obesvärad med människor",
      "ipip_H1103": "Förolämpar folk",
      "ipip_H1108": "Älskar att hjälpa andra",
      "ipip_H909": "Känner mig ofta obehaglig till mods bland andra",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_H309": "Älskar ordning och regelbundenhet",
      "ipip_H976": "Väntar på att andra ska visa vägen",
      "ipip_H126": "Tänker först på andra",
      "ipip_text_leave_my_belongings_around": "Lämnar mina saker liggande överallt",
      "ipip_X74": "Känner mig ofta nere",
      "ipip_X107": "Blir lätt stressad",
      "ipip_H1146": "Håller tillbaka mina känslor",
      "ipip_X120": "Fastnar i mina problem",
      "ipip_E136": "Känner andra människors känslor",
      "ipip_H1313": "Har utmärkta idéer",
      "ipip_H589": "Är mycket privat som person",
      "ipip_H596": "Är svår att lära känna",
      "ipip_X227": "Är inte intresserad av andra människors problem",
      "ipip_H160": "Tar mig tid för andra människor",
      "ipip_X114": "Ägnar tid åt att fundera på saker",
      "ipip_H1110": "Vet hur man håller folk uppmärksamma och fängslade",
      "ipip_H244": "Tycker om att städa upp",
      "ipip_X225": "Älskar att tänka fram nya sätt att göra saker",
      "ipip_text_am_easily_disturbed": "Blir lätt störd",
      "ipip_H1272": "Använder svåra ord",
      "ipip_H950": "Blir överväldigad av känslor",
      "ipip_H822": "Lämnar mitt rum i en enda röra"
    },
    "de": {
      "ipip_likert_5": "Sehr zutreffend",
      "ipip_likert_4": "Mäßig zutreffend",
      "ipip_question_head": "<h3>Wie genau können Sie sich selbst beschreiben?</h3><p>Beschreiben Sie sich so, wie Sie im Allgemeinen jetzt sind, nicht wie Sie in Zukunft sein möchten. Beschreiben Sie sich ehrlich, in Bezug auf andere Personen des gleichen Geschlechts und ungefähr Ihres Alters, die Sie kennen. Damit Sie sich ehrlich beschreiben können, werden Ihre Antworten streng vertraulich behandelt. Geben Sie mit der folgenden Bewertungsskala an, wie zutreffend jede Aussage auf Sie zutrifft:</p>",
      "ipip_likert_3": "Weder zutreffend noch unzutreffend",
      "ipip_likert_1": "Sehr unzutreffend",
      "ipip_debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens.",
      "ipip_likert_2": "Mäßig unzutreffend",
      "ipip_H1322": "Ich kann mit eine Menge von Information umgehen.",
      "ipip_H1413": "Ich erledige Dinge halbherzig.",
      "ipip_H596": "Mich kennenzulernen ist schwer.",
      "ipip_X78": "Es stört mich nicht im Mittelpunkt der Aufmerksamkeit zu stehen.",
      "ipip_H1": "Ich fühle mich ungezwungen unter Leuten.",
      "ipip_H661": "Ich bin still unter Fremden.",
      "ipip_X227": "Ich interessiere mich nicht für die Probleme anderer Leute.",
      "ipip_H1392": "Ich werde nie eine Sache gründlich untersuchen.",
      "ipip_X203": "Ich bin den Gefühlen anderer gegenüber gleichgültig.",
      "ipip_X14": "Ich habe eine lebhafte Vorstellungskraft.",
      "ipip_X179": "Ich folge einem Plan.",
      "ipip_X95": "Ich gerate leicht aus der Fassung.",
      "ipip_H1227": "Ich bringe die Unterhaltung auf ein höheres Niveau.",
      "ipip_H592": "Ich finde es schwierig andere zu erreichen.",
      "ipip_X275": "Ich kapiere Dinge schnell.",
      "ipip_H1366": "Ich bin geschickt darin, mit sozialen Situationen umzugehen.",
      "ipip_H1382": "Ich habe Schwierigkeiten mir Dinge vorzustellen.",
      "ipip_X165": "Ich interessiere mich nicht wirklich für andere.",
      "ipip_H1133": "Ich nörgle über Dinge.",
      "ipip_H53": "Ich bin voller Ideen.",
      "ipip_H1103": "Ich beleidige Leute.",
      "ipip_H1130": "Ich kann die Gefühle anderer nachempfinden.",
      "ipip_X107": "Ich bin schnell stressgeplagt.",
      "ipip_H1039": "Ich habe wenig zu sagen.",
      "ipip_H334": "Ich übernehme Verantwortung.",
      "ipip_E141": "Ich bin die meiste Zeit entspannt.",
      "ipip_H1157": "Ich bin mache mir Sorgen über Dinge.",
      "ipip_H1467": "Ich verpfusche die Dinge.",
      "ipip_H909": "Ich fühle mich oft unbehaglich in der Gegenwart anderer.",
      "ipip_X73": "Ich liebe Kinder.",
