    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_H128": "Mogu da prihvatim puno toga od drugih.",
      "ipip_H791": "Druge ljude vidim kao konkurenciju.",
      "ipip_E119": "Svoje obaveze obavljam odmah.",
      "ipip_H991": "Lako me je zastrašiti.",
      "ipip_H1356": "Imam oko za detalje.",
      "ipip_E25": "Ponekad sam neobjašnjivo srećan.",
      "ipip_H153": "Slušam svoju savest.",
      "ipip_H854": "Površno radim zadatke.",
      "ipip_H1273": "Neprestano se usavršavam.",
      "ipip_H892": "Oprezan sam.",
      "ipip_X256": "Ne volim filmove sa holivudskim srećnim krajem.",
      "ipip_X91": "Dešava mi se da se služim laskanjem kako bih napredovao.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_H435": "S visine gledam na tuđe slabosti.",
      "ipip_E45": "Suprotstavljam se autoritetu.",
      "ipip_X237": "Ne opterećujem se potrebama drugih.",
      "ipip_H473": "Kad nešto radim, razmatram sve mogućnosti.",
      "ipip_H969": "Potreban mi je podsticaj da bih nešto započeo.",
      "ipip_E140": "Očekujem puno od sebe i drugih.",
      "ipip_H617": "Osećam se uskraćeno u životu.",
      "ipip_H251": "Brzo obavim zadatke.",
      "ipip_X104": "Volim da posećujem nova mesta.",
      "ipip_X207": "Verujem da je tradicija važna.",
      "ipip_H515": "Rado prihvatam izazovne zadatke.",
      "ipip_X2": "Volim dečije filmove.",
      "ipip_X161": "Volim da zbližavam ljude.",
      "ipip_H62": "Pričam o onome što me brine.",
      "ipip_H885": "Cesto ne razumem poentu stvari.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_H470": "Mogu da izađem na kraj sa složenim problemima.",
      "ipip_H1185": "Umem da uživam.",
      "ipip_H782": "Često postavljam pravila drugim ljudima.",
      "ipip_X136": "Nikada ne bih utajio porez.",
      "ipip_H785": "Često zloupotrebljavam moć.",
      "ipip_H556": "Nikada ne odustajem.",
      "ipip_H1193": "Trudim se da nadmašim tuđi uspeh.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H954": "Imam osećaj da nisam u stanju da se nosim sa stvarima.",
      "ipip_H325": "Preuzimam kontrolu nad stvarima.",
      "ipip_H60": "Brzo prepoznam dobru priliku.",
      "ipip_H41": "Opušten sam u društvu drugih ljudi.",
      "ipip_H315": "Pratim naređenja.",
      "ipip_X210": "Teško opraštam drugima.",
      "ipip_H517": "Odmah prionem na posao.",
      "ipip_H439": "Efikasno obavim svaki posao.",
      "ipip_H1183": "Obično prokockam svoje šanse.",
      "ipip_H410": "Stojim iza svojih postupaka.",
      "ipip_H424": "Ne dajem se nikome.",
      "ipip_H213": "Pre nego što nešto uradim dobro razmislim.",
      "ipip_X193": "Volim da gledam umetničko klizanje.",
      "ipip_X196": "Držim se onog što isplaniram unapred.",
      "ipip_H1171": "Teško mi je da prionem na posao.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_H1063": "Ne volim promene.",
      "ipip_H1285": "Obavljam zadatke uspešno.",
      "ipip_X198": "Varam da bih napredovao.",
      "ipip_X222": "Verujem da je deci potrebna čvrsta ruka.",
      "ipip_E115": "Saosećam sa ljudima kojima je gore nego meni.",
      "ipip_H317": "Izbegavam opasne situacije.",
      "ipip_X97": "Imam poteškoća u iskazivanju osećanja.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_H992": "Lako se rasplačem.",
      "ipip_X209": "Ne uznemiravaju me teška društvena pitanja.",
      "ipip_X140": "Volim cveće.",
      "ipip_E143": "Nisam naročito osećajan.",
      "ipip_X73": "Volim decu.",
      "ipip_H747": "Trudim se da steknem visok društveni položaj.",
      "ipip_H1120": "Često hrabrim druge.",
