{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "B2B-DMS",
      "name": "B2B Decision-making Styles Scale",
      "abbreviation": "B2B-DMS",
      "description": "26-item scale measuring seven business-to-business (B2B) decision-making styles: perfectionistic/quality-conscious, confused/poorly-informed, fast/careless, novelty/innovation-seeking, habitual/loyal, price-conscious, and brand/reputation-conscious buyer. Each style is a separate subscale scored as the mean of its items; no overall total is meaningful.",
      "citation": "Godbersen, H., & Gully, V. (2022). B2B Decision-making Styles Scale. Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis326",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "license_explanation": "Licensed CC BY-SA 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis326) and the original publication.",
      "url": "https://zis.gesis.org/skala/Godbersen-Gully-B2B-Decision-making-Styles-Scale",
      "version": "1.0",
      "domain": "Other"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "B2B Decision-making Styles (Godbersen & Gully). CC BY-SA 4.0. Recommended response format is a 6-step (or continuous 0-100) scale with poles 'completely disagree'/'completely agree'; a 6-point endpoint-labeled version is used here. All items positively keyed toward their style. Each of the seven styles is its own subscale (mean of items); a general total across all 26 items is explicitly NOT meaningful. Forced ratings advised to avoid missing values (esp. PCB/BRCB with 2 items)."
    },
    "likert_options": {
      "points": 6,
      "min": 1,
      "labels": [
