{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Sport Motivation Scale",
      "code": "SMS",
      "abbreviation": "SMS",
      "description": "28-item measure of motivation toward sport based on self-determination theory, with seven subscales: three forms of intrinsic motivation (to know, to accomplish, to experience stimulation), identified regulation, introjected regulation, external regulation, and amotivation. Items are rated 1-7 for how well each reason corresponds to why the respondent practices their sport.",
      "citation": "Pelletier, L. G., Tuson, K. M., Fortier, M. S., Vallerand, R. J., Brière, N. M., & Blais, M. R. (1995). Toward a new measure of intrinsic motivation, extrinsic motivation, and amotivation in sports: The Sport Motivation Scale (SMS). Journal of Sport and Exercise Psychology, 17(1), 35-53. https://doi.org/10.1123/jsep.17.1.35",
      "license": "CC BY 4.0",
      "license_explanation": "The English-language items were reprinted from Pelletier et al. (1995) under a Creative Commons Attribution license, with permission from Luc Pelletier, in Komarc, Harbichová, & Scheier (2020), 'Psychometric validation of Czech version of the Sport Motivation Scale,' PLoS ONE 15(1), e0227277 (open access, CC BY 4.0).",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1371/journal.pone.0227277",
      "version": "1.0",
      "domain": "Work"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-16",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items keyed to the original Pelletier et al. (1995) item numbers. Seven 4-item subscales scored as means (1-7); all items forward-coded. Item 21 (introjected regulation) and item 22 (external regulation) follow the canonical Pelletier (1995) wording: the English column of the Komarc et al. (2020) reprint contained two transcription errors at these positions (item 21's English duplicated item 22's text; item 22 read 'how good I am good at'). The Czech translation in that document confirms the canonical wording used here. A self-determination index (SDI) composite is intentionally omitted (multiple weighting conventions exist). Czech (cs) item text and the instruction are verbatim from the bilingual figure in Komarc et al. (2020); the 7-point Czech anchor labels and debrief were translated by the implementer (the source figure showed only English anchor labels) and should be verified by a native speaker."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "likert_1", "likert_2", "likert_3", "likert_4", "likert_5", "likert_6", "likert_7"
      ],
      "question_head": "question_head"
    },
    "dimensions": [
      { "id": "im_know", "name": "Intrinsic Motivation – To Know", "abbreviation": "IM-K", "description": "Engaging in sport for the pleasure of learning and understanding (items 2, 4, 23, 27)." },
      { "id": "im_accomplish", "name": "Intrinsic Motivation – To Accomplish", "abbreviation": "IM-A", "description": "Engaging in sport for the satisfaction of mastering or accomplishing difficult tasks (items 8, 12, 15, 20)." },
      { "id": "im_stimulation", "name": "Intrinsic Motivation – To Experience Stimulation", "abbreviation": "IM-E", "description": "Engaging in sport for the sensory and aesthetic pleasure it provides (items 1, 13, 18, 25)." },
      { "id": "identified", "name": "Identified Regulation", "abbreviation": "IDE", "description": "Engaging in sport because it is valued and personally important (items 7, 11, 17, 24)." },
      { "id": "introjected", "name": "Introjected Regulation", "abbreviation": "INTRO", "description": "Engaging in sport out of internal pressure such as guilt or obligation (items 9, 14, 21, 26)." },
      { "id": "external", "name": "External Regulation", "abbreviation": "EXT", "description": "Engaging in sport for external rewards or social recognition (items 6, 10, 16, 22)." },
      { "id": "amotivation", "name": "Amotivation", "abbreviation": "AMO", "description": "Absence of motivation or perceived contingency between actions and outcomes (items 3, 5, 19, 28)." }
    ],
    "items": [
      { "id": "sms1", "type": "likert", "text_key": "sms1", "dimension": "im_stimulation" },
      { "id": "sms2", "type": "likert", "text_key": "sms2", "dimension": "im_know" },
      { "id": "sms3", "type": "likert", "text_key": "sms3", "dimension": "amotivation" },
      { "id": "sms4", "type": "likert", "text_key": "sms4", "dimension": "im_know" },
      { "id": "sms5", "type": "likert", "text_key": "sms5", "dimension": "amotivation" },
      { "id": "sms6", "type": "likert", "text_key": "sms6", "dimension": "external" },
      { "id": "sms7", "type": "likert", "text_key": "sms7", "dimension": "identified" },
      { "id": "sms8", "type": "likert", "text_key": "sms8", "dimension": "im_accomplish" },
      { "id": "sms9", "type": "likert", "text_key": "sms9", "dimension": "introjected" },
      { "id": "sms10", "type": "likert", "text_key": "sms10", "dimension": "external" },
      { "id": "sms11", "type": "likert", "text_key": "sms11", "dimension": "identified" },
      { "id": "sms12", "type": "likert", "text_key": "sms12", "dimension": "im_accomplish" },
      { "id": "sms13", "type": "likert", "text_key": "sms13", "dimension": "im_stimulation" },
      { "id": "sms14", "type": "likert", "text_key": "sms14", "dimension": "introjected" },
      { "id": "sms15", "type": "likert", "text_key": "sms15", "dimension": "im_accomplish" },
      { "id": "sms16", "type": "likert", "text_key": "sms16", "dimension": "external" },
      { "id": "sms17", "type": "likert", "text_key": "sms17", "dimension": "identified" },
      { "id": "sms18", "type": "likert", "text_key": "sms18", "dimension": "im_stimulation" },
      { "id": "sms19", "type": "likert", "text_key": "sms19", "dimension": "amotivation" },
      { "id": "sms20", "type": "likert", "text_key": "sms20", "dimension": "im_accomplish" },
      { "id": "sms21", "type": "likert", "text_key": "sms21", "dimension": "introjected" },
      { "id": "sms22", "type": "likert", "text_key": "sms22", "dimension": "external" },
      { "id": "sms23", "type": "likert", "text_key": "sms23", "dimension": "im_know" },
      { "id": "sms24", "type": "likert", "text_key": "sms24", "dimension": "identified" },
      { "id": "sms25", "type": "likert", "text_key": "sms25", "dimension": "im_stimulation" },
      { "id": "sms26", "type": "likert", "text_key": "sms26", "dimension": "introjected" },
      { "id": "sms27", "type": "likert", "text_key": "sms27", "dimension": "im_know" },
      { "id": "sms28", "type": "likert", "text_key": "sms28", "dimension": "amotivation" }
    ],
    "scoring": {
      "im_know": { "method": "mean_coded", "description": "Mean of items 2, 4, 23, 27 (1-7).", "items": { "sms2": 1, "sms4": 1, "sms23": 1, "sms27": 1 } },
      "im_accomplish": { "method": "mean_coded", "description": "Mean of items 8, 12, 15, 20 (1-7).", "items": { "sms8": 1, "sms12": 1, "sms15": 1, "sms20": 1 } },
      "im_stimulation": { "method": "mean_coded", "description": "Mean of items 1, 13, 18, 25 (1-7).", "items": { "sms1": 1, "sms13": 1, "sms18": 1, "sms25": 1 } },
      "identified": { "method": "mean_coded", "description": "Mean of items 7, 11, 17, 24 (1-7).", "items": { "sms7": 1, "sms11": 1, "sms17": 1, "sms24": 1 } },
      "introjected": { "method": "mean_coded", "description": "Mean of items 9, 14, 21, 26 (1-7).", "items": { "sms9": 1, "sms14": 1, "sms21": 1, "sms26": 1 } },
      "external": { "method": "mean_coded", "description": "Mean of items 6, 10, 16, 22 (1-7).", "items": { "sms6": 1, "sms10": 1, "sms16": 1, "sms22": 1 } },
      "amotivation": { "method": "mean_coded", "description": "Mean of items 3, 5, 19, 28 (1-7).", "items": { "sms3": 1, "sms5": 1, "sms19": 1, "sms28": 1 } }
    }
  },
  "translations": {
    "en": {
      "question_head": "Using the scale below, please indicate to what extent each of the following items corresponds to one of the reasons for which you are presently practicing your sport. <b>WHY DO YOU PRACTICE YOUR SPORT?</b>",
      "likert_1": "Does not correspond at all",
      "likert_2": "Corresponds a little",
      "likert_3": "Corresponds a little",
      "likert_4": "Corresponds moderately",
      "likert_5": "Corresponds a lot",
      "likert_6": "Corresponds a lot",
      "likert_7": "Corresponds exactly",
      "sms1": "For the pleasure I feel in living exciting experiences.",
      "sms2": "For the pleasure it gives me to know more about the sport that I practice.",
      "sms3": "I used to have good reasons for doing sport, but now I am asking myself if I should continue doing it.",
      "sms4": "For the pleasure of discovering new training techniques.",
      "sms5": "I don't know anymore; I have the impression of being incapable of succeeding in this sport.",
      "sms6": "Because it allows me to be well regarded by people that I know.",
      "sms7": "Because, in my opinion, it is one of the best ways to meet people.",
      "sms8": "Because I feel a lot of personal satisfaction while mastering certain difficult training techniques.",
      "sms9": "Because it is absolutely necessary to do sports if one wants to be in shape.",
      "sms10": "For the prestige of being an athlete.",
      "sms11": "Because it is one of the best ways I have chosen to develop other aspects of myself.",
      "sms12": "For the pleasure I feel while improving some of my weak points.",
      "sms13": "For the excitement I feel when I am really involved in the activity.",
      "sms14": "Because I must do sports to feel good myself.",
      "sms15": "For the satisfaction I experience while I am perfecting my abilities.",
      "sms16": "Because people around me think it is important to be in shape.",
      "sms17": "Because it is a good way to learn lots of things which could be useful to me in other areas of my life.",
      "sms18": "For the intense emotions I feel doing a sport that I like.",
      "sms19": "It is not clear to me anymore; I don't really think my place is in sport.",
      "sms20": "For the pleasure that I feel while executing certain difficult movements.",
      "sms21": "Because I would feel bad if I was not taking time to do it.",
      "sms22": "To show others how good I am at my sport.",
      "sms23": "For the pleasure that I feel while learning training techniques that I have never tried before.",
      "sms24": "Because it is one of the best ways to maintain good relationships with my friends.",
      "sms25": "Because I like the feeling of being totally immersed in the activity.",
      "sms26": "Because I must do sports regularly.",
      "sms27": "For the pleasure of discovering new performance strategies.",
      "sms28": "I often ask myself; I can't seem to achieve the goals that I set for myself.",
      "debrief": "Thank you for completing this questionnaire."
    },
    "cs": {
      "LANGUAGE": "Čeština",
      "question_head": "Na škále 1 – 7 označte, jak moc se ztotožňujete s odpovědí na otázku: „Proč sportuješ?“",
      "likert_1": "Vůbec neodpovídá",
      "likert_2": "Odpovídá trochu",
      "likert_3": "Odpovídá trochu",
      "likert_4": "Odpovídá středně",
      "likert_5": "Odpovídá hodně",
      "likert_6": "Odpovídá hodně",
      "likert_7": "Naprosto odpovídá",
      "sms1": "Pro potěšení, cítím vzrušující zážitky.",
      "sms2": "Pro potěšení z toho, že vím víc o sportu, který provozuji.",
      "sms3": "Kdysi jsem sportoval z dobrých důvodů, ale nyní se ptám sám sebe, jestli v tom mám dále pokračovat.",
      "sms4": "Pro potěšení z objevování nových tréninkových technik.",
      "sms5": "Už ani nevím, mám pocit, že ve sportu už nejsem schopný uspět.",
      "sms6": "Protože mě kvůli tomu kladně hodnotí lidé, které znám.",
      "sms7": "Protože je to podle mého názoru jeden z nejlepších způsobů, jak potkávat nové lidi.",
      "sms8": "Protože cítím uspokojení při zvládání obtížných tréninkových úkolů.",
      "sms9": "Protože je to absolutně nezbytné, když chce být člověk fit.",
      "sms10": "Pro prestiž být sportovcem.",
      "sms11": "Protože je to jedna z nejlepších cest, kterou jsem si vybral, abych rozvíjel i další stránky své osobnosti.",
      "sms12": "Protože cítím potěšení, když zlepšuji svá slabá místa.",
      "sms13": "Pro ten skvělý pocit, který zažívám, když jsem zcela pohlcen danou aktivitou.",
      "sms14": "Protože musím sportovat, abych se cítil dobře.",
      "sms15": "Protože cítím uspokojení, když se v mém sportu zdokonaluji.",
      "sms16": "Protože lidé kolem mě si myslí, že je důležité sportovat, aby byl člověk ve formě.",
      "sms17": "Protože je to dobrý způsob, jak se naučit spoustu věcí, které mohou být užitečné i v jiných oblastech.",
      "sms18": "Pro intenzivní pocity a vzrušení, které mi sport přináší.",
      "sms19": "Nejsem si jistý, nemyslím si, že sport je pro mě to pravé.",
      "sms20": "Protože cítím potěšení při provádění těžkých pohybových úkonů.",
      "sms21": "Protože vím, že bych se cítil špatně, kdybych si na sport neudělal čas.",
      "sms22": "Abych ukázal ostatním, jak dobrý jsem ve svém sportu.",
      "sms23": "Protože mám radost z toho, když se učím nové techniky či pohyby, které jsem nikdy předtím nezkoušel.",
      "sms24": "Protože je to jeden z nejlepších způsobů, jak si udržet dobré vztahy s mými kamarády.",
      "sms25": "Protože mám rád pocit, kdy jsem zcela ponořen do dané aktivity.",
      "sms26": "Protože já musím sportovat pravidelně.",
      "sms27": "Pro potěšení z objevování nových soutěžních strategií a taktiky.",
      "sms28": "Ani nevím, často mi připadá, že nedosahuji cílů, které jsem si stanovil.",
      "debrief": "Děkujeme za vyplnění dotazníku."
    }
  }
}
