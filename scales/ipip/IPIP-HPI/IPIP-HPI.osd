  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "section_title_ipip_hpi_clm": "IPIP HPI: Calmness",
      "section_title_ipip_hpi_cmp": "IPIP HPI: Competence",
      "section_title_ipip_hpi_coo": "IPIP HPI: Cooperation",
      "section_title_ipip_hpi_crt": "IPIP HPI: Creativity/Originality",
      "section_title_ipip_hpi_dut": "IPIP HPI: Dutifulness",
      "section_title_ipip_hpi_frl": "IPIP HPI: Friendliness",
      "section_title_ipip_hpi_grg": "IPIP HPI: Gregariousness",
      "section_title_ipip_hpi_hap": "IPIP HPI: Happiness",
      "section_title_ipip_hpi_ldr": "IPIP HPI: Leadership",
      "section_title_ipip_hpi_qck": "IPIP HPI: Quickness",
      "section_title_ipip_hpi_soc": "IPIP HPI: Sociability",
      "section_title_ipip_hpi_stb": "IPIP HPI: Stability",
      "section_title_ipip_hpi_tgh": "IPIP HPI: Toughness",
      "ipip_H882": "Am easy to satisfy.",
      "ipip_H37": "Am on good terms with nearly everyone.",
      "ipip_E65": "Am quick to judge others.",
      "ipip_X217": "Hold a grudge.",
      "ipip_X90": "Seldom take offense.",
      "ipip_H1124": "Speak ill of others.",
      "ipip_H917": "Have a sharp tongue.",
      "ipip_H554": "Accomplish a lot of work.",
      "ipip_X105": "Am not sure where my life is going.",
      "ipip_H258": "Carry out my plans.",
      "ipip_H1285": "Complete tasks successfully.",
      "ipip_X115": "Do just enough work to get by.",
      "ipip_X205": "Feel that my life lacks direction.",
      "ipip_H555": "Get things done quickly.",
      "ipip_H627": "Hang around doing nothing.",
      "ipip_H896": "Mess things up.",
      "ipip_H871": "Act wild and crazy.",
      "ipip_X238": "Enjoy wild flights of fantasy.",
      "ipip_E159": "Feel that people have a hard time understanding me.",
