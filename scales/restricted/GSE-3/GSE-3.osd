      ],
      "header": "General Self-Efficacy Short Scale-3 (GSE-3) Report",
      "footer_refs": [
        "Doll, E. S., Nießen, D., Schmidt, I., Rammstedt, B., & Lechner, C. M. (2021). General Self-Efficacy Short Scale-3 (GSE-3). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis294",
        "ZIS Documentation: https://doi.org/10.6102/zis294"
      ]
    }
  },
  "translations": {
    "en": {
      "gse_3_inst": "The following statements may apply more or less to you. To what extent do you think each statement applies to you personally?",
      "gse_301": "I can rely on my own abilities in difficult situations.",
      "gse_302": "I am able to solve most problems on my own.",
      "gse_303": "I can usually solve even challenging and complex tasks well.",
      "gse_3_r1": "Does not apply at all",
      "gse_3_r2": "Applies a bit",
      "gse_3_r3": "Applies somewhat",
      "gse_3_r4": "Applies mostly",
      "gse_3_r5": "Applies completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}
