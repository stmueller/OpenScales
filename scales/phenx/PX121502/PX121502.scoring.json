{
  "_note": "SWAN (Strengths and Weaknesses of ADHD-Symptoms and Normal Behavior). 7-point scale: Far Below Average=1 … Far Above Average=7 in OSD. value_map recodes to 3,2,1,0,−1,−2,−3 (Far Below=3, Below=2, Somewhat Below=1, Average=0, Somewhat Above=−1, Above=−2, Far Above=−3). Score = mean per subscale; lower = more ADHD symptoms.",
  "dimensions": [
    {"id": "inattention",   "name": "Inattention"},
    {"id": "hyperactivity", "name": "Hyperactivity/Impulsivity"}
  ],
  "scoring": {
    "inattention": {
      "method": "mean_coded",
      "value_map": {"default": [3, 2, 1, 0, -1, -2, -3]},
      "items": [
        "close_attention_to_detail",
        "sustain_attention",
        "listen_when_spoken_to",
        "follow_through_chores",
        "organize_tasks_activities",
        "engage_mental_effort",
        "keep_track_of_activity_items",
        "ignore_extraneous_stimuli",
        "remember_daily_activities"
      ]
    },
    "hyperactivity": {
      "method": "mean_coded",
      "value_map": {"default": [3, 2, 1, 0, -1, -2, -3]},
      "items": [
        "sit_still",
        "stay_seated",
        "modulate_motor_activity",
        "play_quietly",
        "settle_down",
        "control_excess_talking",
        "control_blurting_out",
        "await_turns",
        "control_interrupting"
      ]
    }
  }
}
