{
  "scale_info": {
    "name": "Migraine - Adult",
    "code": "PX130501",
    "abbreviation": "PX130501",
    "description": "The Self-Administered Questionnaire for Migraine is a 20-item questionnaire that assesses the frequency of severe headaches, the level of pain, whether the person is taking medications, and associated complications such as nausea.",
    "domain": "Neurology",
    "citation": "Headache Classification Committee of the International Headache Society. (1998). Classification and diagnostic criteria for headache disorders, cranial neuralgias and facial pain. Cephalalgia, 8 (Suppl. 7), 1-96. Headache Classification Subcommittee of the International Headache Society. (2004). The International Classification of Headache Disorders. Part one: The primary headaches. Cephalalgia , 24 (Suppl. 1), 23-136. [PhenX: https://www.phenxtoolkit.org/protocols/view/130501]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/130501"
  },
  "option_sets": {
