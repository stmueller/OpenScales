{
  "scale_info": {
    "name": "Sickle Cell Disease Self-Management - Caregiver Skills Checklist",
    "code": "PX870802",
    "abbreviation": "PX870802",
    "description": "A 22-question caregiver-administered checklist to determine how well adolescents manage their sickle cell disease. Items are grouped to measure two domains: Transition Skills (answer choices from 1 to 5), and Disease Knowledge (answer choices from 1 to 3). The final item asks caregivers to rate on a",
    "domain": "Sickle Cell Disease - Stigma",
    "citation": "Multiple Chronic Conditions Resource Center. (2022). Self-Management in Chronic Conditions. https://www.multiplechronicconditions.org/self-management-guidelines. [PhenX: https://www.phenxtoolkit.org/protocols/view/870802]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/870802"
  },
