    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_E85": "Nije mi stalo do lepog oblačenja.",
      "ipip_X97": "Imam poteškoća u iskazivanju osećanja.",
      "ipip_H525": "Zahtevam da se na mene obrati pažnja.",
      "ipip_H244": "Volim da spremam.",
      "ipip_H427": "Često iskorišćavam druge ljude.",
      "ipip_H250": "Radim stvari \"po PS-u\".",
      "ipip_X148": "Otvoreno pokazujem svoja osećanja.",
      "ipip_H744": "Trudim se da zadivim druge.",
      "ipip_H1273": "Neprestano se usavršavam.",
      "ipip_H725": "Često se mešam u tuđa posla.",
      "ipip_H1100": "Brinem za druge ljude.",
      "ipip_H871": "Često se ponašam divlje i razuzdano.",
      "ipip_H1302": "Nikad ne ostajem \"bez teksta\".",
      "ipip_H555": "Brzo obavljam stvari.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_H974": "Potrebno mi je odobravanje drugih.",
      "ipip_E144": "Prihvatam stvari onakve kakve su.",
      "ipip_X110": "Nisam mnogo motivisan da uspem.",
      "ipip_H1107": "Želim da se dokažem drugima.",
      "ipip_H1130": "Saosećam sa drugima.",
      "ipip_X150": "Trudim se da se pridržavam pravila.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_X138": "Ne potresam se lako zbog stvari.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_X176": "Imam poteškoća u razumevanju apstraktnih ideja.",
      "ipip_E53": "Ne volim da se doterujem.",
      "ipip_X118": "Volim red.",
      "ipip_H834": "Ne obraćam pažnju na svoj izgled.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_H1392": "Nisam sklon da se previše udubljujem u problem.",
      "ipip_X234": "Znam da nisam poseban.",
      "ipip_E136": "Osećam emocije drugih ljudi.",
      "ipip_H107": "Činim da se ljudi osećaju spokojno.",
      "ipip_H730": "Volim kada mi drugi kažu da sam u pravu.",
      "ipip_H774": "Vršim pritisak na druge ljude.",
      "ipip_H870": "Često radim nešto ludo.",
      "ipip_X178": "Mislim da se zakoni trebaju strogo primenjivati.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_H1041": "Kopiram druge",
      "ipip_X177": "Mekog sam srca.",
      "ipip_H1067": "Svemu nađem manu.",
      "ipip_E46": "U mnoge stvari se upuštam bez razmišljanja.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_H679": "Retko izražavam svoje mišljenje.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_H548": "Pričam odmerenim tonom.",
      "ipip_H740": "Smatram da sam važna osoba.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_H1227": "Podižem razgovor na viši nivo.",
      "ipip_H640": "Često sam snužden.",
      "ipip_H1413": "Mnoge stvari radim polovično.",
      "ipip_H334": "Često preuzimam stvari na sebe.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H1056": "Prilagođavam se tuđem mišljenju",
      "ipip_H1346": "Često prekršim pravila..",
      "ipip_E147": "Menjam se da bih odgovarao drugima.",
      "ipip_H718": "Uglavnom pričam o sebi.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H314": "Trudim se da uvek budem doteran."
