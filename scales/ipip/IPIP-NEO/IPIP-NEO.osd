      "ipip_H592": "Teško pristupam drugima.",
      "ipip_H334": "Preuzimam odgovornost.",
      "ipip_H312": "Privržen sam uhodanom načinu života.",
      "ipip_H1322": "Mogu baratati mnoštvom informacija.",
      "ipip_H1032": "Moj doprinos je skroman.",
      "ipip_H1197": "Sposoban sam izboriti se za sebe.",
      "ipip_H1351": "Sve radim prema planu.",
      "ipip_H959": "Neki me događaji shrvaju.",
      "ipip_H1195": "Nemam povjerenja u ljude.",
      "ipip_X247": "Rijetko se hvalim.",
      "ipip_H660": "Želim da me drugi ostave na miru.",
      "ipip_E100": "Ne smetaju me neuredni ljudi.",
