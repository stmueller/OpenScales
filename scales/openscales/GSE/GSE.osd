{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "General Self-Efficacy Scale",
      "code": "GSE",
      "abbreviation": "GSE",
      "description": "10-item unidimensional self-report measure of general self-efficacy — the belief in one's overall competence to cope with challenging demands and difficult situations. Uses a 4-point Likert scale (1=Not at all true to 4=Exactly true). Scored as the sum of all 10 items (range 10–40); higher scores indicate greater self-efficacy. No reverse-coded items. Validated in over 30 countries with consistent unidimensional structure and high internal consistency. Available in 32 languages from the author's website.",
      "citation": "Schwarzer, R., & Jerusalem, M. (1995). Generalized Self-Efficacy scale. In J. Weinman, S. Wright, & M. Johnston (Eds.), Measures in health psychology: A user's portfolio. Causal and control beliefs (pp. 35–37). Windsor, UK: NFER-NELSON.",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~health/selfscal.htm",
      "domain": "Self & Coping",
      "version": "1.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of the General Self-Efficacy Scale (Schwarzer & Jerusalem, 1995) and his other scales. Multilingual items are reproduced from the authors' official translation pages (userpage.fu-berlin.de/~health/selfscal.htm) and aligned BY MEANING to the canonical English item order (built from GSE_translations.csv)."
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items and translations from Schwarzer's official multilingual page at http://userpage.fu-berlin.de/~health/selfscal.htm. Scale is freely available for research use with attribution to Schwarzer & Jerusalem (1995); no formal open license declared. German translation uses a different item order from English (both orderings reflect the same items). Languages included: en, de, fr, es, pt, nl, it, ja, pl. Languages with items stored as images on source page and not yet extracted: ar, zh, ru, ko. Scoring: sum of all 10 items, range 10–40, no reverse-coded items. MISS article 13651 is a psychometric evaluation in Indian adolescents."
    },
