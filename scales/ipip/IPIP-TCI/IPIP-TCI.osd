      "ipip_H892": "Uppställer försiktighetsåtgärder",
      "ipip_X256": "Ogillar filmer med lyckliga Hollywoodslut",
      "ipip_X91": "Använder smicker för att komma fram",
      "ipip_H761": "Blir lätt irriterad",
      "ipip_H435": "Ser ner på mina svagheter",
      "ipip_E45": "Gör motstånd mot auktoriteter",
      "ipip_X237": "Kan inte låta mig störas av andras behov",
      "ipip_H473": "Undersöker alla möjligheter",
      "ipip_H969": "Behöver en knuff för att komma igång",
      "ipip_E140": "Sätter upp höga mål för mig själv och andra",
      "ipip_H617": "Känner mig olyckligt lottad",
      "ipip_H251": "Avslutar saker snabbt",
      "ipip_X104": "Tycker om att besöka nya platser",
