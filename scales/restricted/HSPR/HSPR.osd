    "dimensions": [
      {
        "id": "Overstimulation",
        "name": "Overstimulation",
        "description": "Tendency to become unpleasantly aroused by intense or overwhelming stimuli"
      },
      {
        "id": "SensitivityPositive",
        "name": "Sensitivity to Positive Experiences",
        "description": "Noticing and enjoying subtle positive sensory and aesthetic experiences"
      },
      {
        "id": "SocialSensitivity",
        "name": "Social Sensitivity",
        "description": "Awareness of and responsiveness to others' emotions and social cues"
      },
      {
        "id": "DepthOfProcessing",
        "name": "Depth of Processing",
        "description": "Tendency to reflect deeply and engage in philosophical or complex thinking"
      },
      {
        "id": "EmotionalReactivity",
        "name": "Emotional Reactivity",
        "description": "Strong emotional reactions to experiences and others' moods"
      },
      {
        "id": "SensitivityDetails",
        "name": "Sensitivity to Details",
        "description": "Noticing subtle environmental changes and details"
      }
