      "ipip_H29": "Hago amigos fácilmente.",
      "ipip_X198": "Hago trampa para avanzar.",
      "ipip_X176": "Se me dificulta entender las ideas abstractas.",
      "ipip_H704": "Mantengo a los demás a distancia.",
      "ipip_X248": "Evito discusiones filosóficas.",
      "ipip_H416": "Uso a otros para mi propio interés.",
      "ipip_E115": "Siento empatía por aquellos que están más necesitados que yo.",
      "ipip_X181": "Rara vez cedo a los excesos.",
      "ipip_H1186": "Pierdo mi tiempo.",
      "ipip_E35": "Disfruto ser imprudente.",
      "ipip_H1108": "Me gusta ayudar a otros.",
      "ipip_X157": "Creo que se debe de ser fuertes contra el crimen.",
      "ipip_X71": "Me gusta soñar despierto.",
      "ipip_H871": "Me comporto de manera desenfrenada y descontrolada.",
      "ipip_X133": "Tiendo a excederme.",
      "ipip_H145": "Digo la verdad.",
      "ipip_E105": "Veo la belleza en las cosas que otros no notan.",
      "ipip_X15": "No me agrado.",
      "ipip_X251": "Soy capaz de controlar mis antojos.",
      "ipip_H149": "Mantengo mis promesas.",
      "ipip_E46": "Me aviento a hacer cosas sin pensar.",
      "ipip_E113": "Me gusta tomar las cosas con calma.",
      "ipip_H736": "Creo que soy mejor que otros.",
      "ipip_H948": "Me asusto fácilmente.",
      "ipip_H823": "Dejo mis pertenecías regadas.",
      "ipip_X92": "Experimento mis emociones intensamente.",
      "ipip_E136": "Siento las emociones de los otros",
      "ipip_X30": "Prefiero apegarme a las cosas que sé.",
      "ipip_H650": "Evito las multitudes.",
      "ipip_H1157": "Me preocupo por las cosas.",
      "ipip_H846": "Actúo sin pensar."
    },
    "da": {
      "_translator": "Jens Asbjørn Bohni Nielsen (Roskilde University, Denmark); machine translation",
      "ipip_likert_4": "Lidt Nøjagtigt",
      "ipip_likert_1": "Meget Unøjagtigt",
      "ipip_likert_2": "Lidt Unøjagtigt",
      "ipip_debrief": "Tak fordi du udfyldte dette spørgeskema.",
      "ipip_question_head": "<h3>Beskriv dig selv</h3><p>Beskriv dig selv, som du generelt er nu; ikke som du ønsker at være fremover. Beskriv dig selv, sådan som du ærligt ser dig selv, i forhold til andre du kender af samme køn og på nogenlunde samme alder. For at du kan beskrive dig selv på en ærlig måde, vil dine svar være fuldstændigt fortrolige. Angiv nøjagtigheden af hvert udsagn, som det gælder for dig, ved hjælp af følgende skala:</p>",
      "ipip_likert_5": "Meget Nøjagtigt",
      "ipip_likert_3": "Hverken Nøjagtigt Eller Unøjagtigt",
      "ipip_X259": "Har sympati for de hjemløse.",
      "ipip_X209": "Har ikke noget imod komplekse sociale situationer.",
      "ipip_X10": "Lægger sjældent mærke til mine følelsesmæssige reaktioner.",
      "ipip_E157": "Stoler på, hvad andre siger.",
      "ipip_H1206": "Arbejder hårdt.",
      "ipip_H592": "Har svært ved at indlede en samtale.",
      "ipip_H334": "Tager føringen.",
      "ipip_H312": "Holder mig til traditionerne.",
      "ipip_H959": "Bliver let overvældet af begivenheder.",
      "ipip_H1195": "Nærer mistillid til andre.",
      "ipip_X45": "Bryder mig ikke om poesi.",
      "ipip_H1285": "Fuldfører opgaver med success.",
      "ipip_X14": "Har en livlig fantasi.",
      "ipip_H587": "Foretrækker at være alene.",
      "ipip_H918": "Bruger ikke tid på andres problemer.",
      "ipip_X74": "Er ofte nedtrykt.",
      "ipip_H1063": "Bryder mig ikke om forandringer.",
      "ipip_X235": "Bryder mig ikke om at gå på kunstmuseer.",
      "ipip_H1333": "Ved, hvordan man får tingene gjort.",
      "ipip_H999": "Frygter det værste.",
      "ipip_H822": "Roder derhjemme.",
      "ipip_X211": "Elsker at læse svære tekster.",
      "ipip_X129": "Har det godt med mig selv.",
      "ipip_H2043": "Har høje tanker om mig selv.",
      "ipip_X203": "Er ligeglad med andres følelser.",
      "ipip_H1346": "Bryder reglerne.",
      "ipip_H79": "Laver en masse i min fritid.",
      "ipip_E163": "Kan godt lide at fortabe mig i mine tanker.",
      "ipip_H1354": "Håndterer opgaver med lethed.",
      "ipip_H113": "Har tillid til andre.",
      "ipip_X238": "Nyder at fortabe mig i vilde fantasier.",
      "ipip_X126": "Ser mig selv som mest højreorienteret.",
      "ipip_H976": "Venter på, at andre viser vejen frem.",
      "ipip_H655": "Er bange for at gøre opmærksom på mig selv.",
      "ipip_E166": "Forsøger at lade være med at tænke på de fattige.",
      "ipip_H446": "Søger eventyr.",
      "ipip_X115": "Arbejder kun så meget, at jeg lige kan klare mig.",
      "ipip_H755": "Mister let besindelsen.",
      "ipip_H549": "Tror generelt, andre vil mig det bedste.",
      "ipip_H453": "Elsker en god fight.",
      "ipip_H1018": "Bryder mine løfter.",
      "ipip_H33": "Elsker livet.",
      "ipip_H427": "Udnytter andre.",
      "ipip_X107": "Bliver let stresset.",
      "ipip_H699": "Tager hævn over andre.",
      "ipip_X227": "Er ikke interesseret i andres problemer.",
      "ipip_H1100": "Bekymrer mig om andre.",
      "ipip_X23": "Bliver sjældent irriteret.",
      "ipip_X123": "Tror på betydningen af kunst.",
      "ipip_H809": "Råber ad folk.",
      "ipip_E156": "Forstår ikke dem, der bliver følelsesladede.",
      "ipip_X87": "Er altid velforberedt.",
      "ipip_X79": "Bevarer roen i pressede situationer.",
      "ipip_H244": "Kan godt lide at rydde op.",
      "ipip_H2014": "Gør mere, end hvad der forventes af mig.",
      "ipip_X82": "Glemmer tit at sætte tingene på plads igen.",
      "ipip_H621": "Har svært ved at gå i gang med opgaver.",
      "ipip_X218": "Ser mig selv som mest venstreorienteret.",
      "ipip_H438": "Elsker spænding.",
      "ipip_H258": "Fører mine planer ud i livet.",
      "ipip_H754": "Bliver let vred.",
      "ipip_H1174": "Udmærker mig i de ting, jeg laver.",
      "ipip_H738": "Er meget glad for mig selv.",
      "ipip_X204": "Foretrækker afveksling frem for rutine.",
      "ipip_X184": "Mener ikke, der er noget absolut rigtigt eller forkert.",
      "ipip_X274": "Har let ved at modstå fristelser.",
      "ipip_H862": "Kaster mig ud i ting.",
      "ipip_H42": "Fokuserer på de positive ting i tilværelsen.",
      "ipip_H325": "Tager kontrollen.",
      "ipip_H640": "Er ofte nede i kulkælderen",
      "ipip_X167": "Bruger mindst muligt tid og energi på opgaver.",
      "ipip_X112": "Har det godt sammen med andre.",
      "ipip_H648": "Undgår kontakt med andre.",
      "ipip_H58": "Har altid travlt.",
      "ipip_H1103": "Fornærmer folk.",
      "ipip_X83": "Taler med mange forskellige mennesker til fester.",
      "ipip_H954": "Føler, at jeg har svært ved at håndtere mange ting.",
      "ipip_X239": "Er ikke interesseret i teoretiske diskussioner.",
      "ipip_H746": "Praler med mine gode sider.",
      "ipip_H656": "Har det kun rart med mine venner.",
      "ipip_H524": "Forsøger at lede andre.",
      "ipip_H761": "Bliver let irriteret.",
      "ipip_H32": "Udstråler glæde.",
      "ipip_H78": "Elsker store fester.",
      "ipip_H54": "Er altid i gang m ed noget.",
      "ipip_H853": "Tager forhastede beslutninger.",
      "ipip_H1094": "Har det ofte sjovt.",
      "ipip_H968": "Er bange for mange ting.",
      "ipip_H494": "Stiller hindringer i vejen for andre.",
      "ipip_H29": "Har let ved at få venner.",
      "ipip_X198": "Snyder for at få et forspring.",
      "ipip_X176": "Har svært ved at forstå abstrakte ideer.",
      "ipip_H704": "Holder andre på afstand.",
      "ipip_X248": "Undgår filosofiske diskussioner.",
      "ipip_H416": "Bruger andre til at opnå mine egne mål.",
      "ipip_E115": "Føler sympati for dem, der har det værre end mig selv.",
      "ipip_X181": "Spiser og drikker sjældent for meget.",
      "ipip_H1186": "Spilder min tid.",
      "ipip_E35": "Nyder at tage vilde chancer.",
      "ipip_H1108": "Elsker at hjælpe andre.",
      "ipip_X157": "Synes, vi skal slå hårdt ned på kriminalitet.",
      "ipip_X71": "Elsker at dagdrømme.",
      "ipip_H871": "Opfører mig vildt.",
      "ipip_X133": "Går amok med mad og drikke.",
      "ipip_H145": "Fortæller sandheden.",
      "ipip_E105": "Ser det smukke i ting, andre måske ikke lægger mærke til.",
      "ipip_X15": "Bryder mig ikke om mig selv.",
      "ipip_X251": "Kan styre mine behov",
      "ipip_H149": "Holder mine løfter.",
      "ipip_E46": "Springer ud i ting uden at tænke mig om.",
      "ipip_E113": "Kan godt lide at slappe af.",
      "ipip_H736": "Mener, jeg er bedre end andre.",
      "ipip_H948": "Går let i panik.",
      "ipip_H823": "Efterlader mine ting rundt omkring.",
      "ipip_X92": "Oplever mine følelser intenst.",
      "ipip_E136": "Fornemmer andres følelser.",
      "ipip_X30": "Foretrækker at holde mig til det, jeg kender.",
      "ipip_H650": "Undgår folkemængder.",
      "ipip_H1157": "Bekymrer mig om mange ting.",
      "ipip_H846": "Handler uden at tænke."
    },
    "et": {
      "_translator": "Jüri Allik & René Mõttus (University of Tartu, Estonia); machine translation",
      "ipip_likert_4": "Mõõdukalt täpne",
      "ipip_likert_1": "Väga ebatäpne",
      "ipip_likert_2": "Mõõdukalt ebatäpne",
      "ipip_debrief": "Tänan teid küsimustiku täitmise eest.",
      "ipip_question_head": "<h3>Kui täpselt saate ennast kirjeldada?</h3><p>Kirjeldage ennast sellisena, nagu te üldiselt praegu olete, mitte sellisena, nagu te tulevikus sooviksite olla. Kirjeldage ennast nii, nagu te ennast ausalt näete, võrreldes teiste inimestega, kes on teie sugupoolega ja ligikaudu teie vanuses. Et saaksid ennast ausalt kirjeldada, hoitakse sinu vastuseid täielikult konfidentsiaalsena. Näita punkti abil, kui täpselt see väide sinu kohta kehtib, kasutades järgmist hindamisskaala:</p>",
      "ipip_likert_5": "Väga täpne",
      "ipip_likert_3": "Ei ole täpne ega ebatäpne",
      "ipip_X259": "Ma tunnen kodututele kaasa",
      "ipip_X209": "Mind ei häiri suhtlemisel keerulised olukorrad",
      "ipip_X10": "Ma panen harva oma tundeid tähele",
      "ipip_E157": "Ma usun teiste juttu",
      "ipip_H1206": "Ma töötan kõvasti",
      "ipip_H592": "Ma kardan suhtlemist alustada",
      "ipip_H334": "Ma võtan juhtimise enda peale",
      "ipip_H312": "Ma teen asju harjumuspärasel viisil",
      "ipip_H959": "Ma olen keerulistes olukordades võimetu tegutsema",
      "ipip_H1195": "Ma ei usalda inimesi",
      "ipip_X45": "Mulle ei meeldi luuletused",
      "ipip_H1285": "Ma viin alustatud tööd edukalt lõpule",
      "ipip_X14": "Mul on elav kujutlusvõime",
      "ipip_H587": "Ma eelistan olla üksi",
      "ipip_H918": "Mul ei ole teiste jaoks aega",
      "ipip_X74": "Ma olen sageli rusutud ja kurb",
      "ipip_H1063": "Ma ei armasta muutusi",
      "ipip_X235": "Ma ei armasta käia kunstimuuseumides",
      "ipip_H1333": "Ma tean, kuidas asjad tehtud saab",
      "ipip_H999": "Ma kardan kõige halvemat",
      "ipip_H822": "Ma jätan oma toa segamini",
      "ipip_X211": "Ma armastan lugeda mõtlema panevaid raamatuid",
      "ipip_X129": "Ma tunnen ennast mõnusalt",
      "ipip_H2043": "Ma olen enda üle uhke",
      "ipip_X203": "Mind ei huvita teiste soovid",
      "ipip_H1346": "Ma rikun reegleid",
      "ipip_H79": "Minu vaba aeg on sisustatud",
      "ipip_E163": "Mulle meeldib olla oma mõttemaailmas",
      "ipip_H1354": "Ma tulen ülesannetega hästi toime",
      "ipip_H113": "Ma usaldan teisi",
      "ipip_X238": "Ma armastan endale tavatuid asju ette kujutada",
      "ipip_X126": "Ma pean traditsioone oluliseks",
      "ipip_H976": "Ma ootan, et teised otsustaksid",
      "ipip_H655": "Ma kardan endale tähelepanu tõmmata",
      "ipip_E166": "Ma ei mõtle nendele, kes on hädas",
      "ipip_H446": "Ma otsin seiklusi",
      "ipip_X115": "Ma teen just nii palju kui hädapärast vaja",
      "ipip_H755": "Ma kaotan tihti enesevalitsuse",
      "ipip_H549": "Ma usun, et inimestel on head kavatsused",
      "ipip_H453": "Mulle meeldib korralikult tülitseda",
      "ipip_H1018": "Ma jätan lubadusi täitmata",
      "ipip_H33": "Ma armastan elu",
      "ipip_H427": "Ma kasutan teisi ära",
      "ipip_X107": "Ma lähen kergesti pingesse",
      "ipip_H699": "Ma maksan kätte",
      "ipip_X227": "Mind ei huvita teiste inimeste probleemid",
      "ipip_H1100": "Ma muretsen eelkõige teiste pärast",
      "ipip_X23": "Mind on raske pahandada",
      "ipip_X123": "Ma pean kunsti tähtsaks",
      "ipip_H809": "Ma karjun teiste peale",
      "ipip_E156": "Ma ei mõista tundelisi inimesi",
      "ipip_X87": "Ma olen alati ette valmistunud",
      "ipip_X79": "Ma jään rasketes olukordades rahulikuks",
      "ipip_H244": "Mulle meeldib asju korda seada",
      "ipip_H2014": "Ma teen rohkem, kui minult oodatakse",
      "ipip_X82": "Ma unustan asjad õigele kohale tagasi panna",
      "ipip_H621": "Ma lükkan tüütuid töid üha edasi",
      "ipip_X218": "Ma usun, et inimestele tuleks anda rohkem vabadusi",
      "ipip_H438": "Ma naudin põnevust",
      "ipip_H258": "Ma viin alustatud tegemised lõpuni",
      "ipip_H754": "Ma vihastun kergesti",
      "ipip_H1174": "Ma teen kõike suurepäraselt",
      "ipip_H738": "Ma olen endast väga heal arvamusel",
      "ipip_X204": "Ma tahan vaheldust",
      "ipip_X184": "Minu arvates pole olemas ainuõiget tõde või valet",
      "ipip_X274": "Ma suudan kiusatustele vastu panna",
      "ipip_H862": "Ma tegutsen liigselt kiirustades",
      "ipip_H42": "Ma näen igas asjas midagi head",
      "ipip_H325": "Ma kontrollin suhtlemisel olukorda",
      "ipip_H640": "Ma langen tihti masendusse",
      "ipip_X167": "Ma kulutan tööle vähe aega ja jõudu",
      "ipip_X112": "Ma tunnen ennast inimeste keskel hästi",
      "ipip_H648": "Ma väldin kokkupuuteid teistega",
      "ipip_H58": "Ma olen alati hõivatud",
      "ipip_H1103": "Ma solvan inimesi",
      "ipip_X83": "Ma räägin peol väga paljude inimestega",
      "ipip_H954": "Ma tunnen, et ei saa hakkama",
      "ipip_X239": "Mind ei huvita arutlused elu mõtte või maailma asjade üle",
      "ipip_H746": "Ma kiitlen oma oskuste ja võimetega",
      "ipip_H656": "Ma tunnen ennast mugavalt vaid lähedaste seas",
      "ipip_H524": "Ma proovin teisi juhtida",
      "ipip_H761": "Ma ärritun kergesti",
      "ipip_H32": "Minust kiirgab rõõmu",
      "ipip_H78": "Mulle meeldivad suured peod",
      "ipip_H54": "Mul on alati midagi teoksil",
      "ipip_H853": "Ma teen otsuseid ilma asju läbi mõtlemata",
      "ipip_H1094": "Mul on alati väga lõbus",
      "ipip_H968": "Ma kardan paljusid asju",
      "ipip_H494": "Ma rikun teiste plaane, kui see on mulle kasulik",
      "ipip_H29": "Ma leian kergesti sõpru",
      "ipip_X198": "Ma olen valmis valetama, et saada oma tahtmist",
      "ipip_X176": "Mul on raske mõista keerulisi ideid",
      "ipip_H704": "Ma ei lase teisi endale lähedale",
      "ipip_X248": "Ma väldin sügavamõttelisi arutelusid",
      "ipip_H416": "Ma kasutan teisi inimesi oma huvides",
      "ipip_E115": "Mul on kahju nendest, kes elavad minust halvemini",
      "ipip_X181": "Ma luban endale harva liiga palju",
      "ipip_H1186": "Ma raiskan aega",
      "ipip_E35": "Mulle meeldib tegutseda kiiresti ja järelemõtlematult",
      "ipip_H1108": "Mulle meeldib teisi aidata",
      "ipip_X157": "Ma usun, et me peaksime kuritegevuse suhtes olema karmid",
      "ipip_X71": "Mulle meeldib unistada",
      "ipip_H871": "Ma teen pööraseid ja hulljulgeid asju",
      "ipip_X133": "Mul on raske piiri pidada",
      "ipip_H145": "Ma räägin tõtt",
      "ipip_E105": "Ma näen ilu seal, kus teised ei pruugi seda märgata",
      "ipip_X15": "Ma ei meeldi iseendale",
      "ipip_X251": "Ma olen võimeline oma tahtmisi kontrollima",
      "ipip_H149": "Ma pean oma lubadustest kinni",
      "ipip_E46": "Ma hakkan tegutsema ilma tagajärgedele mõtlemata",
      "ipip_E113": "Mulle meeldib asju rahulikult võtta",
      "ipip_H736": "Ma pean ennast teistest paremaks",
      "ipip_H948": "Ma satun kergesti paanikasse",
      "ipip_H823": "Ma jätan oma asjad ripakile",
      "ipip_X92": "Mul on tugevad tunded",
      "ipip_E136": "Ma tajun teiste inimeste tundeid",
      "ipip_X30": "Mulle meeldib jääda nende asjade juurde, mida ma hästi tunnen",
      "ipip_H650": "Ma väldin rahvarohkeid kohti",
      "ipip_H1157": "Ma olen tihti mures",
      "ipip_H846": "Ma tegutsen mõtlematult"
    },
    "fr_be": {
      "_translator": "Benjamin Thiry & Maëva Piolti (University of Mons, Belgium); Mathew Gravel (Université du Québec à Chicoutimi, Canada); Kerri Gibson & Caroline Boucher (Bishop's University, Canada); machine translation",
      "ipip_likert_4": "En accord",
      "ipip_likert_1": "Tout à fait en désaccord",
      "ipip_likert_2": "En désaccord",
      "ipip_debrief": "Merci d'avoir complété ce questionnaire.",
      "ipip_question_head": "<h3>Comment vous décririez-vous ?</h3><p>Décrivez-vous tel(le) que vous êtes généralement maintenant, et non tel(le) que vous souhaiteriez être à l'avenir. Décrivez-vous honnêtement, par rapport aux autres personnes du même sexe et à peu près du même âge que vous. Vos réponses resteront strictement confidentielles. Indiquez votre niveau d'accord avec chaque énoncé à l'aide de l'échelle suivante :</p>",
      "ipip_likert_5": "Tout à fait en accord",
      "ipip_likert_3": "Neutre / Indifférent(e)",
      "ipip_X259": "Je sympathise avec les sans-abri.",
      "ipip_X209": "Je ne suis pas dérangé par les situations sociales difficiles.",
      "ipip_X10": "Je remarque rarement mes réactions émotionnelles",
      "ipip_E157": "J'ai confiance en ce que les gens disent.",
      "ipip_H1206": "Je travaille dur",
      "ipip_H592": "J'éprouve de la difficulté à aborder les autres.",
      "ipip_H334": "Je prends les choses en main",
      "ipip_H312": "Je suis attaché aux méthodes conventionnelles.",
      "ipip_H959": "Je me sens dépassé par les événements.",
      "ipip_H1195": "Je ne fais pas confiance aux autres.",
      "ipip_X45": "Je n'aime pas la poésie.",
      "ipip_H1285": "Je complète les tâches avec succès.",
      "ipip_X14": "J'ai une imagination débordante.",
      "ipip_H587": "Je préfère être seul.",
      "ipip_H918": "Je ne prends pas de temps pour les autres.",
      "ipip_X74": "Je me sens souvent triste.",
      "ipip_H1063": "Je n'aime pas les changements.",
      "ipip_X235": "Je n'apprécie pas aller à des musées d'art.",
      "ipip_H1333": "Je sais comment faire avancer les choses.",
      "ipip_H999": "Je crains le pire.",
      "ipip_H822": "Je laisse ma chambre en désordre.",
      "ipip_X211": "J'adore lire des documents stimulants.",
      "ipip_X129": "Je suis à l'aise avec moi-même.",
      "ipip_H2043": "J'ai une haute estime de moi-même",
      "ipip_X203": "Je suis indifférent aux sentiments des autres.",
      "ipip_H1346": "J'enfreins les règles.",
      "ipip_H79": "Je fais beaucoup de choses dans mes temps libres.",
      "ipip_E163": "J'aime me perdre dans mes pensées.",
      "ipip_H1354": "Je gère les tâches facilement.",
      "ipip_H113": "Je fais confiance aux autres.",
      "ipip_X238": "J'aime me perdre dans mes idées.",
      "ipip_X126": "J'ai tendance à voter pour des candidats conservateurs",
      "ipip_H976": "J'attends que les autres prennent les devants.",
      "ipip_H655": "J'ai peur d'attirer l'attention vers moi.",
      "ipip_E166": "Je tente de ne pas penser aux gens dans le besoin.",
      "ipip_H446": "Je recherche l'aventure.",
      "ipip_X115": "Je fais juste assez de travail pour m'en sortir.",
      "ipip_H755": "Je perds patience.",
      "ipip_H549": "Je crois que les autres ont de bonnes intentions.",
      "ipip_H453": "J'adore une bonne bagarre.",
      "ipip_H1018": "Je ne tiens pas mes promesses.",
      "ipip_H33": "J'adore la vie.",
      "ipip_H427": "Je profite des autres.",
      "ipip_X107": "Je deviens stressé facilement.",
      "ipip_H699": "Je m'en prends aux autres.",
      "ipip_X227": "Je ne suis pas intéressé par les problèmes des autres.",
      "ipip_H1100": "Je me préoccupe des autres.",
      "ipip_X23": "Je ne suis pas facilement agacé.",
      "ipip_X123": "Je crois en l'importance de l'art.",
      "ipip_H809": "Je crie sur les gens",
      "ipip_E156": "Je ne comprends pas les gens émotifs.",
      "ipip_X87": "Je suis toujours préparé.",
      "ipip_X79": "Je demeure calme sous pression.",
      "ipip_H244": "J'aime faire du rangement.",
      "ipip_H2014": "Je fais plus que ce que l'on attend de moi.",
      "ipip_X82": "J'oublie souvent de remettre les choses à leur place.",
      "ipip_H621": "J'ai de la difficulté à commencer les tâches.",
      "ipip_X218": "J'ai tendance à voter pour des candidats libéraux",
      "ipip_H438": "J'adore les sensations fortes.",
      "ipip_H258": "Je réalise mes objectifs.",
      "ipip_H754": "Je me mets en colère facilement.",
      "ipip_H1174": "J'excelle dans ce que je fais.",
      "ipip_H738": "J'ai une très bonne opinion de moi-même.",
      "ipip_X204": "Je préfère la variété à la routine.",
      "ipip_X184": "Je crois qu'il n'y a pas de bon ou de mauvais absolu.",
      "ipip_X274": "Je résiste facilement à la tentation.",
      "ipip_H862": "Je me précipite dans l'action.",
      "ipip_H42": "Je regarde le bon côté de la vie.",
      "ipip_H325": "Je prends le contrôle des choses.",
      "ipip_H640": "Il m'arrive souvent de broyer du noir.",
      "ipip_X167": "Je mets peu de temps et d'efforts dans mon travail.",
      "ipip_X112": "Je me sens confortable avec les gens.",
      "ipip_H648": "J'évite le contact avec les autres.",
      "ipip_H58": "Je suis toujours occupé.",
      "ipip_H1103": "J'insulte les gens.",
      "ipip_X83": "Je parle à plusieurs personnes en soirée",
      "ipip_H954": "Je me sens incapable de gérer les choses.",
      "ipip_X239": "Je ne suis pas intéressé par les discussions théoriques.",
      "ipip_H746": "Je me vante de mes vertus.",
      "ipip_H656": "Je me sens seulement à l'aise avec mes amis.",
      "ipip_H524": "J'essaie de diriger les autres.",
      "ipip_H761": "Je suis facilement irrité",
      "ipip_H32": "Je respire la joie.",
      "ipip_H78": "J'adore les grandes fêtes.",
      "ipip_H54": "Je suis toujours en mouvement.",
      "ipip_H853": "Je prends des décisions impulsives.",
      "ipip_H1094": "Je m'amuse beaucoup",
      "ipip_H968": "J'ai peur de plusieurs choses.",
      "ipip_H494": "J'entrave les plans des autres.",
      "ipip_H29": "Je me fais des amis facilement.",
      "ipip_X198": "Je triche pour avancer.",
      "ipip_X176": "J'ai de la difficulté à comprendre les idées abstraites.",
      "ipip_H704": "Je garde les autres à distance.",
      "ipip_X248": "J'évite les discussions philosophiques.",
      "ipip_H416": "J'utilise les autres pour mes propres fins.",
      "ipip_E115": "J'ai de la sympathie pour les gens plus démunis que moi.",
      "ipip_X181": "Je fais rarement des excès.",
      "ipip_H1186": "Je perds mon temps.",
      "ipip_E35": "J'agis de manière effrénée.",
      "ipip_H1108": "J'adore aider les autres.",
      "ipip_X157": "Je crois que nous devrions être sévères à propos des crimes.",
      "ipip_X71": "J'adore rêvasser.",
      "ipip_H871": "J'agis de façon téméraire.",
      "ipip_X133": "Je fais des excès.",
      "ipip_H145": "Je dis la vérité.",
      "ipip_E105": "Je vois une beauté dans les choses que d'autres pourraient ne pas remarquer.",
      "ipip_X15": "Je ne m'aime pas.",
      "ipip_X251": "Je suis capable de contrôler mes envies.",
      "ipip_H149": "Je tiens mes promesses.",
      "ipip_E46": "Je me lance dans les choses sans réfléchir.",
      "ipip_E113": "J'aime prendre ça mollo.",
      "ipip_H736": "Je crois être meilleur que les autres.",
      "ipip_H948": "Je panique facilement.",
      "ipip_H823": "Je laisse traîner mes choses.",
      "ipip_X92": "Je vis mes émotions intensément.",
      "ipip_E136": "Je ressens les émotions des autres.",
      "ipip_X30": "Je préfère m'en tenir aux choses connues.",
      "ipip_H650": "J'évite les foules.",
      "ipip_H1157": "Je m'inquiète à propos de choses.",
      "ipip_H846": "J'agis sans réfléchir"
    },
    "he": {
      "_translator": "Anat Bardi (Royal Holloway, University of London); machine translation",
      "ipip_likert_4": "מדויק במידה מתונה",
      "ipip_likert_1": "לא מדויק בכלל",
      "ipip_likert_2": "לא מדויק במידה מתונה",
      "ipip_debrief": "תודה על מילוי השאלון.",
      "ipip_question_head": "<h3>עד כמה תוכל לתאר את עצמך?</h3><p>תאר את עצמך כפי שאתה בדרך כלל עכשיו, לא כפי שתרצה להיות בעתיד. תאר את עצמך כפי שאתה רואה את עצמך בכנות, ביחס לאנשים אחרים שאתה מכיר מאותו המין שלך ובגילך. כדי שתוכל לתאר את עצמך בצורה כנה, תגובותיך ישמרו בסודיות מוחלטת. ציין עד כמה הפריט מדויק עבורך, תוך שימוש בסולם הדירוג הבא:</p>",
      "ipip_likert_5": "מדויק מאוד",
      "ipip_likert_3": "לא מדויק ולא לא מדויק",
      "ipip_X259": "חש סימפתיה כלפי חסרי הבית",
      "ipip_X209": "לא מרגיש טרוד במצבים חברתיים מורכבים",
      "ipip_X10": "לעיתים רחוקות שם לב לתגובות הרגשיות שלי",
      "ipip_E157": "נותן אמון במה שאנשים אומרים",
      "ipip_H1206": "עובד קשה",
      "ipip_H592": "מתקשה להתקרב לאחרים",
      "ipip_H334": "לוקח פיקוד",
      "ipip_H312": "אוהב להתנהג בדרכים שגרתיות",
      "ipip_H959": "נהיה המום מדברים שקורים לי",
      "ipip_H1195": "לא בוטח באנשים",
      "ipip_X45": "לא אוהב שירה",
      "ipip_H1285": "משלים משימות בהצלחה",
      "ipip_X14": "יש לי דמיון פורה",
      "ipip_H587": "מעדיף להיות לבד",
      "ipip_H918": "לא מקדיש זמן לזולת",
      "ipip_X74": "לעיתים קרובות מרגיש מדוכדך",
      "ipip_H1063": "סולד משינויים",
      "ipip_X235": "לא נהנה ללכת למוזאונים לאומנות",
      "ipip_H1333": "יודע איך להשלים את המשימה",
      "ipip_H999": "חושש מן הנורא ביותר",
      "ipip_H822": "משאיר את החדר שלי מבולגן",
      "ipip_X211": "מאוד אוהב לקרוא חומר מאתגר",
      "ipip_X129": "מרגיש נח עם עצמי",
      "ipip_H2043": "מאוד מחשיב את עצמי",
      "ipip_X203": "אדיש לרגשותייהם של אחרים",
      "ipip_H1346": "עוקף את הכללים",
      "ipip_H79": "עושה הרבה דברים בזמן הפנוי שלי",
      "ipip_E163": "אוהב \"ללכת לאיבוד\" במחשבות",
      "ipip_H1354": "מתמודד עם משימות באופן חלק",
      "ipip_H113": "בוטח באחרים",
      "ipip_X238": "נהנה לברוח לעולם של פנטזיות",
      "ipip_X126": "נוטה לבחור במועמדים פוליטיים בעלי ערכים שמרניים",
      "ipip_H976": "מחכה שאחרים יובילו את הדרך",
      "ipip_H655": "חושש למשוך תשומת לב לעצמי",
      "ipip_E166": "משתדל שלא לחשוב על הנזקקים",
      "ipip_H446": "מחפש הרפתקאות",
      "ipip_X115": "עושה את המינימום שנדרש כדי להסתדר",
      "ipip_H755": "נוטה להתפרץ בכעס",
      "ipip_H549": "מאמין שיש לאחרים כוונות טובות",
      "ipip_H453": "נהנה ממאבק טוב",
      "ipip_H1018": "לא מקיים הבטחות",
      "ipip_H33": "נורא אוהב את החיים",
      "ipip_H427": "נוטה לנצל אחרים",
      "ipip_X107": "נלחץ בקלות",
      "ipip_H699": "נוטה לנקום",
      "ipip_X227": "לא מתעניין בבעיות של אנשים אחרים",
      "ipip_H1100": "אכפת לי מאחרים",
      "ipip_X23": "קשה לעצבן אותי",
      "ipip_X123": "מאמין בחשיבות של אומנות",
      "ipip_H809": "לפעמים צועק על אנשים",
      "ipip_E156": "לא מבין אנשים שמגיבים באופן רגשי",
      "ipip_X87": "תמיד ערוך ומוכן",
      "ipip_X79": "שומר על קור רוח במצבי לחץ",
      "ipip_H244": "אוהב לסדר אחרי",
      "ipip_H2014": "עושה יותר משמצפים ממני",
      "ipip_X82": "לעיתים קרובות שוכח לשים דברים במקום",
      "ipip_H621": "מתקשה להתחיל משימות",
      "ipip_X218": "נוטה לבחור במועמדים פוליטיים בעלי ערכים ליברליים",
      "ipip_H438": "נורא אוהב ריגושים",
      "ipip_H258": "מממש את התכניות שלי",
      "ipip_H754": "נעשה כועס בקלות",
      "ipip_H1174": "מצטיין במה שאני עושה",
      "ipip_H738": "מחזיק בעמדה מאוד חיובית כלפי עצמי",
      "ipip_X204": "מעדיף גיוון על פני שגרה",
      "ipip_X184": "מאמין שאין \"נכון\" ו\"לא נכון\" אבסולוטיים (מוחלטים)",
      "ipip_X274": "נמנע מפיתויים בקלות",
      "ipip_H862": "נחפז בפעולותיי",
      "ipip_H42": "נוטה לראות את הדברים הטובים שבחיים",
      "ipip_H325": "לוקח שליטה על דברים",
      "ipip_H640": "לעיתים קרובות מרגיש \"על הפנים\"",
      "ipip_X167": "מקדיש יחסית מעט מחשבה ומאמץ בעבודה שלי",
      "ipip_X112": "מרגיש נוח בחברה של אנשים",
      "ipip_H648": "נמנע מליצור קשרים עם אחרים",
