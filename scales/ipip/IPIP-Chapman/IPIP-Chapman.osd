  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_R1": "Am a person whose moods go up and down easily.",
      "ipip_R35": "Am considered to be kind of eccentric.",
      "ipip_R73": "Am often so restless that it is impossible for me to sit still.",
      "ipip_R25": "Am usually in an average sort of mood, not too high and not too low.",
      "ipip_R51": "Can slow myself down when I want to.",
      "ipip_R29": "Feel emotions with extreme intensity.",
      "ipip_R21": "Find that my thoughts are racing.",
      "ipip_R8": "Get into moods where I feel very speeded up and irritable.",
      "ipip_R43": "Get so happy or energetic that I am almost giddy.",
      "ipip_R36": "Tend to feel happy and irritable at the same time.",
      "ipip_R27": "Think that my moods don't change more than most people's do.",
      "ipip_R62": "Understand the reasons when I feel very excited or happy.",
      "ipip_R18": "Am often so assertive or sociable that I surprise myself.",
      "ipip_R76": "Am so good at controlling others that it sometimes scares me.",
      "ipip_R78": "Can play many roles convincingly.",
      "ipip_R57": "Could be a success in many fields.",
      "ipip_R63": "Have an uncommon ability to persuade or inspire others.",
      "ipip_R58": "Have persuaded others to do something really adventurous or crazy.",
      "ipip_R6": "Like to be thought of as a normal kind of person.",
      "ipip_R17": "Prefer to let others be the center of attention.",
      "ipip_R60": "Think I would make a good actor.",
      "ipip_R30": "Would be nervous playing the clown in front of other people.",
      "ipip_R9": "Would enjoy campaigning for political office.",
      "ipip_R26": "Would make a good night-club comedian."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_R30": "Bio bih nervozan kada bih morao da se glupiram pred drugim ljudima.",
      "ipip_R78": "Mogu da ,,glumim\" ubedljivo.",
      "ipip_R6": "Volim da me drugi doživljavaju kao normalnu osobu.",
      "ipip_R43": "Nekad sam toliko srećan i energičan da ne mogu normalno da funkcionišem.",
      "ipip_R8": "Često se osetim ubrzano i nervozno.",
      "ipip_R29": "Često osećam snažne emocije.",
      "ipip_R1": "Lako menjam raspoloženja.",
      "ipip_R18": "Često se iznenadim koliko sam asertivan i društven.",
      "ipip_R73": "Često sam toliko nemiran da ne mogu mirno da sedim.",
      "ipip_R35": "Drugi smatraju da sam pomalo ekscentričan.",
      "ipip_R76": "Ponekad me plaši koliko dobro umem da kontrolišem druge ljude.",
      "ipip_R25": "Obično sam prosečnog raspoloženja, ni previse srećan, ni previše tužan.",
      "ipip_R9": "Uživao bih u vođenju političke kampanje.",
      "ipip_R26": "Mogao bih da budem dobar stend-ap komičar.",
      "ipip_R27": "Mislim da ne menjam raspoloženja češće nego drugi.",
      "ipip_R17": "Najradije prepuštam drugima da budu u centru pažnje.",
      "ipip_R60": "Mislim da bih bio dobar glumac.",
      "ipip_R63": "Imam nesvakidašnju sposobnost da ubedim ili inspirišem druge.",
      "ipip_R51": "Mogu da se obuzdam, kad to poželim.",
      "ipip_R62": "Kada se osećam uzbuđeno ili srećno, obično razumem zašto.",
      "ipip_R36": "Često se osećam srećno i nervozno u isto vreme.",
      "ipip_R21": "Moje misli brzaju i lete.",
      "ipip_R57": "Mogu biti uspešan u mnogim poljima.",
      "ipip_R58": "Nagovarao sam druge da se upuste u avanturu ili ludost."
    }
  }
}
