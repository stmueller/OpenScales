    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H905": "Plaši me da ću učiniti nešto pogrešno.",
      "ipip_H991": "Lako me je zastrašiti.",
      "ipip_H896": "Često nešto zabrljam.",
      "ipip_H1309": "Razumem kako stvari funkcionišu.",
      "ipip_H871": "Često se ponašam divlje i razuzdano.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_E45": "Suprotstavljam se autoritetu.",
      "ipip_H1": "Osećam se opušteno u društvu drugih.",
      "ipip_H627": "Provodim vreme ne radeći ništa.",
      "ipip_H67": "Volim akciju.",
      "ipip_H870": "Često radim nešto ludo.",
      "ipip_H446": "Tragam za pustolovinama.",
      "ipip_H2027": "Volim da čitam.",
      "ipip_X90": "Retko se uvredim.",
      "ipip_H535": "Često dovodim sebe u centar pažnje.",
      "ipip_H893": "Radim neočekivane stvari.",
      "ipip_H954": "Imam osećaj da nisam u stanju da se nosim sa stvarima.",
      "ipip_H60": "Brzo prepoznam dobru priliku.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_H1439": "Preskačem komplikovane reči dok čitam.",
      "ipip_H1124": "Nekad pričam loše o drugima.",
      "ipip_H498": "Suprotstavljam se autoritetu.",
      "ipip_H1285": "Obavljam zadatke uspešno.",
      "ipip_H691": "Radim stvari koje drugima deluju čudno.",
      "ipip_H2023": "Volim da uveseljavam druge.",
      "ipip_H37": "U dobrim sam odnosima skoro sa svima.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_H1093": "Zabavljam svoje prijatelje.",
      "ipip_X105": "Nisam siguran u kom pravcu ide moj život.",
      "ipip_H690": "Često biram teži put.",
      "ipip_H604": "Često sumnjam da drugi ljudi imaju skrivene namere.",
      "ipip_X147": "Moja iskustva nisu baš zanimljiva.",
      "ipip_H793": "Želim da budem glavni.",
      "ipip_X79": "Ostajem smiren/a kada sam pod pritiskom.",
      "ipip_H646": "Imam nisko mišljenje o sebi.",
      "ipip_H737": "Veoma sam zadovoljan sobom.",
      "ipip_H647": "Lako se obeshrabrim.",
      "ipip_H78": "Volim velike žurke.",
      "ipip_H660": "Često želim da me ostave na miru.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_H1151": "Umem da razveselim ljude.",
      "ipip_E159": "Imam osećaj da je ljudima teško da me razumeju.",
      "ipip_X169": "Ne volim biti u centru pažnje.",
      "ipip_H1110": "Umem da oduševim druge ljude.",
      "ipip_H1150": "Volim da privlačim pažnju.",
      "ipip_X84": "Često sam neraspoložen.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_E1": "Smesta preuzimam kontrolu i odgovornost.",
      "ipip_X215": "Ne volim glasnu muziku.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_H947": "Često se osećam očajno.",
      "ipip_H258": "Ostvarujem svoje planove.",
      "ipip_X115": "Radim tek toliko koliko je potrebno.",
      "ipip_H554": "Obavljam dosta posla.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_X205": "Osećam da moj život nema usmerenje.",
      "ipip_X181": "Retko preterujem sa zadovoljstvima.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_H2043": "Imam visoko mišljenje o sebi.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H612": "Lako se osetim ugroženim.",
      "ipip_H2034": "Sporo čitam.",
      "ipip_H44": "Lako prevazilazim teškoće.",
      "ipip_X242": "Ne postidim se lako.",
      "ipip_H882": "Lako mi je udovoljiti.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_H555": "Brzo obavljam stvari.",
      "ipip_E65": "Brzo sudim o drugim ljudima.",
      "ipip_H64": "Preuzimam inicijativu.",
      "ipip_E81": "Ima dana kada sam ljut na ceo svet.",
      "ipip_E35": "Uživam da se ponašam bahato.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_X165": "Nisam preterano zainteresovan za druge.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_H917": "Imam oštar jezik.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_E175": "Tragam za skrivenim značenjima.",
      "ipip_H2033": "Brzo čitam.",
      "ipip_X23": "Nije me lako iznervirati",
      "ipip_H1346": "Često prekršim pravila..",
      "ipip_X238": "Uživam u neobuzdanim maštarijama.",
      "ipip_X217": "Umem da budem zlopamtilo.",
      "ipip_X28": "Imam siromašan rečnik.",
      "ipip_X265": "Retko se iznerviram."
