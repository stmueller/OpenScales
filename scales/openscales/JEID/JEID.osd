{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "JEID",
      "name": "Justice Evaluation of the Income Distribution (JEID) Scale",
      "abbreviation": "JEID",
      "description": "5-item scale measuring the subjective evaluation of the objective earnings distribution. Each item provides contextual information (average gross monthly income and typical occupations) for one income bracket — low, middle, upper-middle, high, top — and asks whether that income is unfairly low, fair, or unfairly high (7-point). Items are interpreted as a pattern across brackets; no total score is computed. Bilingual (English/UK and German). Income figures and occupations are country-specific and hardcoded per language.",
      "citation": "Nießen, D., Adriaans, J., Liebig, S., & Lechner, C. M. (2023). Justice Evaluation of the Income Distribution (JEID) Scale. Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis331_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis331_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Nießen-Adriaans-Liebig-Lechner-Justice-Evaluation-of-the-Income-Distribution-(JEID)-Scale",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Bilingual JEID (Nießen et al., 2023). 7-point scale: unfairly low (1) / fair (4) / unfairly high (7), with middle points (2,3,5,6) unlabeled. Five income brackets, each its own single-item dimension; NO total score (per the authors, items are analyzed together as a pattern, not aggregated). The country-specific income figures and example occupations are HARDCODED in each language's translation (English = UK / £; German = Germany / €) rather than parameterized — see SPECIFICATION.md R1. To update for inflation or to adapt to another country (e.g. a US version), edit the figures/occupations/country directly in the translation strings and add the corresponding language."
    },
