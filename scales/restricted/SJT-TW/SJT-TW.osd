{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "English Translation of the SJT-TW (Situational Judgment Test – Teamwork)",
      "code": "SJT-TW",
      "abbreviation": "SJT-TW",
      "description": "12-scenario Situational Judgment Test assessing knowledge about teamwork effectiveness. Each scenario describes a work-situation faced by a team or team member and presents four behavioural response options; the respondent selects the single best (most suitable) option. The original German version (Gatzka & Volmer, 2017) additionally asks for the worst option; this English translation pilot asked only for the best option to reduce duration. Scoring against a predefined best/worst key (restricted; available from the authors). Authors propose a single total score; a tentative two-factor structure was reported but the authors recommend computing only a total test score.",
      "citation": "Freudenstein, J.-P., Remmert, N., Reznik, N., & Krumm, S. (2020). English Translation of the SJT-TW. Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis285",
      "license": "CC BY-NC-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
      "license_explanation": "Licensed CC BY-NC-SA 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free for non-commercial use, sharing, and adaptation with attribution; derivative works must be shared under the same license (ShareAlike). Cite the ZIS documentation (https://doi.org/10.6102/zis285) and the original German instrument (Gatzka & Volmer, 2017). NOTE: The scoring key (the predefined best and worst response for each scenario) is NOT included in the public documentation and is restricted: it may be requested from ZIS (zis@gesis.org) or the original test authors (Thomas Gatzka and Judith Volmer) by submitting a signed Data Use Agreement. The 'correct_answers' fields in the scoring block are therefore left empty and must be filled in by the user once the key is obtained.",
      "url": "https://zis.gesis.org/skala/Freudenstein-Remmert-Reznik-Krumm-English-Translation-of-the-SJT-TW",
      "version": "1.0",
      "domain": "Work"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY-NC-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
      "notes": "Situational Judgment Test, NOT a Likert scale. Structure: 12 scenarios, each a single-select 'multi' item with four behavioural response options (a-d). The respondent picks the single best (most suitable) option for each scenario, matching the English-version task (the German version additionally asks for the worst option, which is omitted here). Each scenario is encoded as one 'multi' item with option values 'a','b','c','d'. SCORING: The official scoring key (which option is best, and which is worst, for each scenario) is RESTRICTED and is not contained in the public ZIS documentation; it must be requested from ZIS (zis@gesis.org) or the test authors (Thomas Gatzka & Judith Volmer) via a signed Data Use Agreement. Per the documentation, when only the best option is asked (as here), a correct best choice scores +1, choosing the documented WORST option scores -1, and all other choices score 0; the total test score then ranges from -12 to +12 across the 12 scenarios. When both best AND worst options are asked (full German format), each scenario ranges from -2 to +2 and the total from -24 to +24. OSD's 'sum_correct' method counts correct (best) choices (range 0-12) but cannot express the -1 penalty for choosing the worst option, nor the separate worst-option task, without an expression evaluator; this is a known limitation. Because the key itself is restricted, the 'correct_answers' arrays are left EMPTY: the structure and scoring method are faithful, but the key values must be supplied by the user. With empty keys the 'teamwork' score will be 0 for all respondents until the key is filled in. Authors recommend computing only a single total score; a tentative two-factor structure (Factor 1: items 2,3,5,6,7,9,10,12; Factor 2: items 1,4,8,11) was reported but is described as preliminary and not recommended for scoring. Item 11 showed a negative item-total correlation in the pilot (N=20) and may warrant exclusion in future use. This test is recommended for research settings only."
    },
    "parameters": {
      "shuffle_questions": {
        "type": "boolean",
        "default": false,
        "description": "Randomize the order of the 12 scenarios"
      }
    },
    "dimensions": [
      {
        "id": "teamwork",
        "name": "Teamwork Effectiveness Knowledge",
        "abbreviation": "SJT-TW",
        "description": "Total test score: number of scenarios for which the best response option was correctly identified (0-12). REQUIRES the restricted scoring key (best option per scenario) to be entered into the scoring block's 'correct_answers'. See implementation notes; the documented full scoring (best vs. worst, with -1 penalties, range -12 to +12 or -24 to +24) cannot be fully expressed by sum_correct."
      }
    ],
