      "cb_r4": "לא מסכים/ה",
      "cb_r5": "מאד לא מסכים/ה",
      "debrief": "תודה על השתתפותך."
    },
    "hr": {
      "cb_head": "U kojoj se mjeri slažete ili ne slažete sa sljedećim tvrdnjama?",
      "secgrdec": "Mala tajna grupa ljudi odgovorna je za donošenje svih važnih odluka u svjetskoj politici.",
      "scidecpb": "Grupe znanstvenika manipuliraju činjenicama, lažiraju ih ili prikrivaju kako bi zavarali javnost.",
      "gvconc19": "Koronavirus je rezultat namjernih i prikrivenih aktivnosti neke vlade ili organizacije.",
      "cb_r1": "U potpunosti se slažem",
      "cb_r2": "Slažem se",
      "cb_r3": "Niti se slažem niti ne slažem",
      "cb_r4": "Ne slažem se",
      "cb_r5": "Uopće se ne slažem",
      "debrief": "Hvala vam na sudjelovanju."
    },
    "hu": {
      "cb_head": "Mennyire ért vagy nem ért egyet az alábbi állításokkal?",
      "secgrdec": "A világpolitika összes fontos döntése mögött egy kis titkos csoport áll.",
      "scidecpb": "Tudósok egyes csoportjai manipulálják, meghamisítják vagy eltitkolják a kutatási eredményeiket, azért, hogy félrevezessék a nyilvánosságot.",
      "gvconc19": "A koronavírus valamely kormány vagy szervezet szándékos és titkos tevékenységének eredménye.",
      "cb_r1": "Nagyon egyetértek",
      "cb_r2": "Egyetértek",
      "cb_r3": "Egyet is értek meg nem is",
      "cb_r4": "Nem értek egyet",
      "cb_r5": "Nagyon nem értek egyet",
      "debrief": "Köszönjük részvételét."
