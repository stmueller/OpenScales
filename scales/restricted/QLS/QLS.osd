{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Quadrangular Love Scale",
      "code": "QLS",
      "abbreviation": "QLS",
      "description": "40-item self-report measure of love across four dimensions: Compassion (items 1–10), Affection (items 11–20), Closeness (items 21–30), and Commitment (items 31–40). Each subscale contains 10 items rated on a 7-point Likert scale. Compassion and Affection reflect feelings toward the partner; Closeness and Commitment reflect feelings about the relationship. Validated in US and UK samples with high internal consistency (α = .86–.93 per subscale). Items are presented in random order; researcher-only facet labels are not shown to participants.",
      "citation": "Karandashev, V., & Evans, N. D. (2019). Quadrangular love theory and scale: Validation and psychometric investigation. Journal of Methods and Measurement in the Social Sciences, 10(1), 1–35. https://doi.org/10.2458/v10i1.23520",
      "license": "CC BY-NC-ND 4.0",
      "license_url": "https://creativecommons.org/licenses/by-nc-nd/4.0/",
      "url": "https://doi.org/10.2458/v10i1.23520",
      "domain": "Relationships",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Item text verbatim from Appendix of Karandashev & Evans (2019), retrieved from open-access publication. Researcher-only facet labels (e.g., [Care], [Trust]) are included in item comments for reference but not shown to participants. Items should be presented in randomized order. No reverse-scored items in the final scale; item 5 (Nonjudgment) was revised in Study 2 to positive directionality and is treated as forward-scored. Scoring: mean of 10 items per subscale (range 1–7); higher = greater endorsement of that love dimension. No total composite score described by authors. Cross-cultural validation (Australia, China) in MISS article e11077."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "qls_r1",
        null,
        null,
        null,
        null,
        null,
        "qls_r7"
      ],
      "question_head": "qls_qhead"
    },
    "dimensions": [
      {
        "id": "compassion",
        "name": "Compassion",
        "abbreviation": "COM",
        "description": "Feelings of care, empathy, and support toward the partner. Mean of items 1–10; range 1–7; higher = greater compassion."
      },
      {
        "id": "affection",
        "name": "Affection",
        "abbreviation": "AFF",
        "description": "Feelings of attraction, appreciation, and tenderness toward the partner. Mean of items 11–20; range 1–7; higher = greater affection."
      },
      {
        "id": "closeness",
        "name": "Closeness",
        "abbreviation": "CLO",
        "description": "Feelings of emotional bonding, trust, and compatibility within the relationship. Mean of items 21–30; range 1–7; higher = greater closeness."
      },
      {
        "id": "commitment",
        "name": "Commitment",
        "abbreviation": "CMT",
        "description": "Feelings of devotion, stability, and investment in the relationship. Mean of items 31–40; range 1–7; higher = greater commitment."
      }
    ],
