      "ipip_H334": "Prendo il comando",
      "ipip_X23": "Non mi infastidisco facilmente",
      "ipip_H438": "Amo le sensazioni forti",
      "ipip_X203": "Le emozioni degli altri mi lasciano indifferente",
      "ipip_X107": "Mi stresso facilmente",
      "ipip_X74": "Mi sento spesso giù di morale",
      "ipip_H754": "Mi arrabbio facilmente",
      "ipip_H78": "Amo le grandi feste",
      "ipip_X176": "Faccio fatica a capire concetti astratti",
      "ipip_X157": "Credo che dovremmo andarci giù pesante con il crimine",
      "ipip_text_break_rules": "Violo le regole",
      "ipip_H1186": "Spreco il mio tempo",
      "ipip_H822": "Lascio la mia camera in disordine",
