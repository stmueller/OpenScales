        "name": "Partisan Identity (Full Scale)",
        "description": "Mean of all 8 items. Range 1-4. Higher values indicate stronger partisan identity."
      },
      {
        "id": "partisan_identity_short",
        "name": "Partisan Identity (Short Form)",
        "description": "Mean of the 4 short-form items (items 3, 6, 7, 8). Range 1-4. Used when survey space is limited."
      }
    ],
