            "sections": [
              "pvq_sec_m"
            ]
          },
          {
            "id": "f",
            "sections": [
              "pvq_sec_f"
            ]
          }
        ]
      }
    ]
  },
  "translations": {
    "en": {
      "pvq_gender_q": "Are you male or female?",
      "pvq_gender_m": "Male",
      "pvq_gender_f": "Female",
      "pvq_inst": "Now I will briefly describe some people. Please listen to each description and tell me how much each person is or is not like you.",
      "pvq_head": "How much like you is this person?",
      "pvq_r1": "Very much like me",
      "pvq_r2": "Like me",
      "pvq_r3": "Somewhat like me",
      "pvq_r4": "A little like me",
      "pvq_r5": "Not like me",
      "pvq_r6": "Not like me at all",
      "ipcrtiv_m": "Thinking up new ideas and being creative is important to him. He likes to do things in his own original way.",
      "ipcrtiv_f": "Thinking up new ideas and being creative is important to her. She likes to do things in her own original way.",
      "imprich_m": "It is important to him to be rich. He wants to have a lot of money and expensive things.",
      "imprich_f": "It is important to her to be rich. She wants to have a lot of money and expensive things.",
      "ipeqopt_m": "He thinks it is important that every person in the world should be treated equally. He believes everyone should have equal opportunities in life.",
      "ipeqopt_f": "She thinks it is important that every person in the world should be treated equally. She believes everyone should have equal opportunities in life.",
      "ipshabt_m": "It's important to him to show his abilities. He wants people to admire what he does.",
      "ipshabt_f": "It's important to her to show her abilities. She wants people to admire what she does.",
      "impsafe_m": "It is important to him to live in secure surroundings. He avoids anything that might endanger his safety.",
      "impsafe_f": "It is important to her to live in secure surroundings. She avoids anything that might endanger her safety.",
      "impdiff_m": "He likes surprises and is always looking for new things to do. He thinks it is important to do lots of different things in life.",
      "impdiff_f": "She likes surprises and is always looking for new things to do. She thinks it is important to do lots of different things in life.",
      "ipfrule_m": "He believes that people should do what they're told. He thinks people should follow rules at all times, even when no-one is watching.",
      "ipfrule_f": "She believes that people should do what they're told. She thinks people should follow rules at all times, even when no-one is watching.",
      "ipudrst_m": "It is important to him to listen to people who are different from him. Even when he disagrees with them, he still wants to understand them.",
      "ipudrst_f": "It is important to her to listen to people who are different from her. Even when she disagrees with them, she still wants to understand them.",
      "ipmodst_m": "It is important to him to be humble and modest. He tries not to draw attention to himself.",
      "ipmodst_f": "It is important to her to be humble and modest. She tries not to draw attention to herself.",
      "ipgdtim_m": "Having a good time is important to him. He likes to \"spoil\" himself.",
      "ipgdtim_f": "Having a good time is important to her. She likes to \"spoil\" herself.",
      "impfree_m": "It is important to him to make his own decisions about what he does. He likes to be free and not depend on others.",
      "impfree_f": "It is important to her to make her own decisions about what she does. She likes to be free and not depend on others.",
      "iphlppl_m": "It's very important to him to help the people around him. He wants to care for their well-being.",
      "iphlppl_f": "It's very important to her to help the people around her. She wants to care for their well-being.",
      "ipsuces_m": "Being very successful is important to him. He hopes people will recognise his achievements.",
      "ipsuces_f": "Being very successful is important to her. She hopes people will recognise her achievements.",
      "ipstrgv_m": "It is important to him that the government ensures his safety against all threats. He wants the state to be strong so it can defend its citizens.",
      "ipstrgv_f": "It is important to her that the government ensures her safety against all threats. She wants the state to be strong so it can defend its citizens.",
      "ipadvnt_m": "He looks for adventures and likes to take risks. He wants to have an exciting life.",
      "ipadvnt_f": "She looks for adventures and likes to take risks. She wants to have an exciting life.",
      "ipbhprp_m": "It is important to him always to behave properly. He wants to avoid doing anything people would say is wrong.",
      "ipbhprp_f": "It is important to her always to behave properly. She wants to avoid doing anything people would say is wrong.",
      "iprspot_m": "It is important to him to get respect from others. He wants people to do what he says.",
      "iprspot_f": "It is important to her to get respect from others. She wants people to do what she says.",
      "iplylfr_m": "It is important to him to be loyal to his friends. He wants to devote himself to people close to him.",
      "iplylfr_f": "It is important to her to be loyal to her friends. She wants to devote herself to people close to her.",
      "impenv_m": "He strongly believes that people should care for nature. Looking after the environment is important to him.",
      "impenv_f": "She strongly believes that people should care for nature. Looking after the environment is important to her.",
      "imptrad_m": "Tradition is important to him. He tries to follow the customs handed down by his religion or his family.",
      "imptrad_f": "Tradition is important to her. She tries to follow the customs handed down by her religion or her family.",
      "impfun_m": "He seeks every chance he can to have fun. It is important to him to do things that give him pleasure.",
      "impfun_f": "She seeks every chance she can to have fun. It is important to her to do things that give her pleasure.",
      "debrief": "Thank you for completing this questionnaire."
    },
    "ar": {
      "pvq_gender_q": "هل أنت ذكر أم أنثى؟",
      "pvq_gender_m": "ذكر",
      "pvq_gender_f": "أنثى",
      "pvq_head": "ما مدى تشابهك مع هذا الشخص؟",
      "pvq_r1": "تشبهني جدا",
      "pvq_r2": "تشبهني",
      "pvq_r3": "تشبهني نوعا ما",
      "pvq_r4": "تشبهني قليلا",
      "pvq_r5": "لا تشبهني",
      "pvq_r6": "لا تشبهني إطلاقا",
      "debrief": "شكرا جزيلا لك على تخصيصك وقتا للإجابة على هذه الأسئلة.",
      "pvq_inst": "سأصف لك الآن بإيجاز بعض الأشخاص. يُرجى الاستماع إلى كل وصف وإخباري بمقدار تشابه كل شخص معك أو اختلافه عنك. استخدم هذه البطاقة."
    },
    "at": {
      "pvq_gender_q": "Sind Sie männlich oder weiblich?",
      "pvq_gender_m": "Männlich",
      "pvq_gender_f": "Weiblich",
      "pvq_head": "Wie sehr ähnelt Ihnen diese Person?",
      "pvq_r1": "Ist sehr ähnlich wie ich",
      "pvq_r2": "Ist wie ich",
      "pvq_r3": "Ist etwas wie ich",
      "pvq_r4": "Ist ein wenig wie ich",
      "pvq_r5": "Ist nicht wie ich",
      "pvq_r6": "Ist überhaupt nicht wie ich",
      "debrief": "VIELEN DANK, DASS SIE SICH DIE ZEIT GENOMMEN HABEN, DIESE FRAGEN ZU BEANTWORTEN.",
      "pvq_inst": "Ich werde Ihnen nun kurz einige Personen beschreiben. Bitte hören Sie sich jede Beschreibung an und sagen Sie mir, wie sehr jede Person Ihnen ähnelt oder nicht ähnelt. Bitte verwenden Sie diese Karte."
    },
    "bg": {
      "pvq_inst": "Ще Ви опиша накратко някои хора. Моля, кажете ми до каква степен всеки от описаните прилича на Вас? Използвайте картата за Вашия отговор.",
      "pvq_gender_q": "Мъж ли сте или жена?",
      "pvq_gender_m": "Мъж",
      "pvq_gender_f": "Жена",
      "pvq_head": "До каква степен описаният прилича на Вас?",
      "debrief": "БЛАГОДАРИМ ВИ, ЧЕ НАМЕРИХТЕ ВРЕМЕ ДА ОТГОВОРИТЕ НА ТЕЗИ ВЪПРОСИ.",
      "ipcrtiv_m": "За него е важно да измисля нови идеи и да бъде новатор. Обича да прави нещата по свой оригинален начин.",
      "imprich_m": "За него е важно да е богат. Иска да има много пари, луксозни и скъпи неща.",
      "ipeqopt_m": "Той мисли, че е важно всички хора по света да се третират като равни. Смята, че всеки би трябвало да има равен шанс в живота.",
      "ipshabt_m": "За него е важно да показва своите способности. Иска хората да оценяват това, което прави.",
      "impsafe_m": "За него е важно да живее безопасно. Избягва всичко, което би могло да застраши неговата сигурност.",
      "impdiff_m": "Той обича изненадите и винаги търси да прави нещо ново. Счита за важно да се занимава с много и разнообразни неща.",
      "ipfrule_m": "Вярва, че всички би трябвало да правят онова, което им се казва. Според него, хората би трябвало винаги да спазват правилата, дори когато никой не ги наблюдава.",
      "ipudrst_m": "За него е важно да се вслушва в хората, които са различни от него. Дори когато не е съгласен с тях, той се опитва да ги разбере.",
      "ipmodst_m": "За него е важно да бъде скромен и тих. Опитва се да не привлича внимание върху себе си.",
      "ipgdtim_m": "За него е важно да се забавлява и да си прекарва добре. Обича да си доставя лични удоволствия.",
      "impfree_m": "За него е важно сам да взема решения какво да прави. Обича да е свободен и независим от другите.",
      "iphlppl_m": "За него е много важно да помага на хората около себе си. Иска да помогне за повишаване на благосъстоянието им.",
      "ipsuces_m": "За него е важно да успее в живота. Надява се хората да признаят постиженията му.",
      "ipstrgv_m": "За него е важно държавата да гарантира безопасността му от всичко, което го заплашва. Иска държавата да е силна, за да може да защитава гражданите си.",
      "ipadvnt_m": "Търси приключения и обича да поема риск. Иска да има вълнуващ живот.",
      "ipbhprp_m": "За него е важно винаги да се държи както трябва. Избягва да прави неща, които другите биха нарекли неправилни.",
      "iprspot_m": "За него е важно да кара хората да го уважават. Иска другите да правят онова, което той им казва.",
      "iplylfr_m": "За него е важно да бъде лоялен към приятелите си. Иска да се отдава на близките си хора.",
      "impenv_m": "Силно вярва, че хората трябва да опазват природата. За него е важно да се грижи за околната среда.",
      "imptrad_m": "Традициите са важни за него. Опитва се да спазва религиозните и семейните обичаи.",
      "impfun_m": "Търси всяка възможност, за да се забавлява. За него е важно да прави неща, които му доставят удоволствие.",
      "ipcrtiv_f": "За нея е важно да измисля нови идеи и да бъде новатор. Обича да прави нещата по свой оригинален начин.",
      "imprich_f": "За нея е важно да е богата. Иска да има много пари, луксозни и скъпи неща.",
      "ipeqopt_f": "Тя мисли, че е важно всички хора по света да се третират като равни. Смята, че всеки би трябвало да има равен шанс в живота.",
      "ipshabt_f": "За нея е важно да показва своите способности. Иска хората да оценяват това, което прави.",
      "impsafe_f": "За нея е важно да живее безопасно. Избягва всичко, което би могло да застраши нейната сигурност.",
      "impdiff_f": "Тя обича изненадите и винаги търси да прави нещо ново. Счита за важно да се занимава с много и разнообразни неща.",
      "ipfrule_f": "Вярва, че всички би трябвало да правят онова, което им се казва. Според нея, хората би трябвало винаги да спазват правилата, дори когато никой не ги наблюдава.",
      "ipudrst_f": "За нея е важно да се вслушва в хората, които са различни от нея. Дори когато не е съгласна с тях, тя се опитва да ги разбере.",
      "ipmodst_f": "За нея е важно да бъде скромна и тиха. Опитва се да не привлича внимание върху себе си.",
      "ipgdtim_f": "За нея е важно да се забавлява и да си прекарва добре. Обича да си доставя лични удоволствия.",
      "impfree_f": "За нея е важно сама да взема решения какво да прави. Обича да е свободна и независима от другите.",
      "iphlppl_f": "За нея е много важно да помага на хората около себе си. Иска да помогне за повишаване на благосъстоянието им.",
      "ipsuces_f": "За нея е важно да успее в живота. Надява се хората да признаят постиженията й.",
      "ipstrgv_f": "За нея е важно държавата да гарантира безопасността й от всичко, което я заплашва. Иска държавата да е силна, за да може да защитава гражданите си.",
      "ipadvnt_f": "Търси приключения и обича да поема риск. Иска да има вълнуващ живот.",
      "ipbhprp_f": "За нея е важно винаги да се държи както трябва. Избягва да прави неща, които другите биха нарекли неправилни.",
      "iprspot_f": "За нея е важно да кара хората да я уважават. Иска другите да правят онова, което тя им казва.",
      "iplylfr_f": "За нея е важно да бъде лоялна към приятелите си. Иска да се отдава на близките си хора.",
      "impenv_f": "Силно вярва, че хората трябва да опазват природата. За нея е важно да се грижи за околната среда.",
      "imptrad_f": "Традициите са важни за нея. Опитва се да спазва религиозните и семейните обичаи.",
      "impfun_f": "Търси всяка възможност, за да се забавлява. За нея е важно да прави неща, които й доставят удоволствие.",
      "pvq_r1": "Изцяло като мен",
      "pvq_r2": "Като мен",
      "pvq_r3": "Донякъде като мен",
      "pvq_r4": "Съвсем малко като мен",
      "pvq_r5": "Не е като мен",
      "pvq_r6": "Изобщо не е като мен"
    },
    "cnr": {
      "pvq_inst": "H1 KARTICA 85 Sada ću ukratko opisati neke ljude. Molim Vas da saslušate opis i da mi kažete koliko je svaka od opisanih osoba nalik Vama. Koristite ovu karticu za odgovor.",
      "pvq_r1": "Veoma nalik meni",
      "pvq_r2": "Nalik meni",
      "pvq_r3": "Donekle nalik meni",
      "pvq_r4": "Malo nalik meni",
      "pvq_r5": "Nije nalik meni",
      "pvq_r6": "Uopšte nije nalik meni",
      "ipcrtiv_m": "Važno mu je da smišlja nove ideje i da bude kreativan. Voli da stvari radi na svoj, originalan način.",
      "imprich_m": "Važno mu je da bude bogat. Želi da ima mnogo novca i da posjeduje skupe stvari.",
      "ipeqopt_m": "Misli da je važno da svaka osoba na svijetu bude jednako tretirana. Vjeruje da svako treba da ima jednake šanse u životu.",
      "ipshabt_m": "Važno mu je da pokaže svoje sposobnosti. Želi da se ljudi dive onome što radi.",
      "impsafe_m": "Važno mu je da živi u bezbjednom okruženju. Izbjegava sve što bi moglo da ugrozi njegovu bezbjednost.",
      "impdiff_m": "Voli iznenađenja i uvijek traga za nekim novim stvarima koje bi radio. Misli da je važno raditi mnogo različitih stvari u životu.",
      "ipfrule_m": "Vjeruje da ljudi treba da rade ono što im se kaže. Misli da ljudi treba stalno da poštuju pravila, čak i kada ih niko ne gleda.",
      "ipudrst_m": "Važno mu je da sasluša ljude koji su različiti od njega. Čak i kada se ne slaže sa njima, ipak želi da ih razumije.",
      "ipmodst_m": "Važno mu je da bude nenametljiv i skroman. Trudi se da ne skreće pažnju na sebe.",
      "ipgdtim_m": "Važno mu je da se dobro provodi. Voli da ugađa sebi.",
      "impfree_m": "Važno mu je da samostalno donosi odluke o onome što radi. Voli da bude slobodan i nezavisan od drugih.",
      "iphlppl_m": "Veoma mu je važno da pomaže ljudima oko sebe. Želi da brine o njihovoj dobrobiti.",
      "ipsuces_m": "Važno mu je da bude veoma uspješan. Nada se da će ljudi cijeniti njegova postignuća.",
      "ipstrgv_m": "Važno mu je da vlast garantuje njegovu bezbjednost od svih prijetnji. Želi da država bude snažna kako bi mogla da brani svoje građane.",
      "ipadvnt_m": "Traga za avanturama i voli da rizikuje. Želi da ima uzbudljiv život.",
      "ipbhprp_m": "Važno mu je da se uvijek ponaša ispravno. Želi da izbjegne da uradi bilo šta što bi drugi ljudi smatrali pogrešnim.",
      "iprspot_m": "Važno mu je da uživa poštovanje drugih. Želi da ljudi rade ono što im kaže.",
      "iplylfr_m": "Važno mu je da bude odan svojim prijateljima. Želi da se posveti ljudima koji su mu bliski.",
      "impenv_m": "Čvrsto vjeruje da ljudi treba da brinu o prirodi. Briga o životnoj sredini mu je važna.",
      "imptrad_m": "Tradicija mu je važna. Trudi se da slijedi vjerske običaje ili običaje svoje porodice.",
      "impfun_m": "Koristi svaku priliku da se zabavi. Važno mu je da radi stvari koje mu pričinjavaju zadovoljstvo.",
      "ipcrtiv_f": "Važno joj je da smišlja nove ideje i da bude kreativna. Voli da stvari radi na svoj, originalan način.",
      "imprich_f": "Važno joj je da bude bogata. Želi da ima mnogo novca i da posjeduje skupe stvari.",
      "ipeqopt_f": "Misli da je važno da svaka osoba na svijetu bude jednako tretirana. Vjeruje da svako treba da ima jednake šanse u životu.",
      "ipshabt_f": "Važno joj je da pokaže svoje sposobnosti. Želi da se ljudi dive onome što radi.",
      "impsafe_f": "Važno joj je da živi u bezbjednom okruženju. Izbjegava sve što bi moglo da ugrozi njenu bezbjednost.",
      "impdiff_f": "Voli iznenađenja i uvijek traga za nekim novim stvarima koje bi radila. Misli da je važno raditi mnogo različitih stvari u životu.",
      "ipfrule_f": "Vjeruje da ljudi treba da rade ono što im se kaže. Misli da ljudi treba stalno da poštuju pravila, čak i kada ih niko ne gleda.",
      "ipudrst_f": "Važno joj je da sasluša ljude koji su različiti od nje. Čak i kada se ne slaže sa njima, ipak želi da ih razumije.",
      "ipmodst_f": "Važno joj je da bude nenametljiva i skromna. Trudi se da ne skreće pažnju na sebe.",
      "ipgdtim_f": "Važno joj je da se dobro provodi. Voli da ugađa sebi.",
      "impfree_f": "Važno joj je da samostalno donosi odluke o onome što radi. Voli da bude slobodna i nezavisna od drugih.",
      "iphlppl_f": "Veoma joj je važno da pomaže ljudima oko sebe. Želi da brine o njihovoj dobrobiti.",
      "ipsuces_f": "Važno joj je da bude veoma uspješna. Nada se da će ljudi cijeniti njena postignuća.",
      "ipstrgv_f": "Važno joj je da vlast garantuje njenu bezbjednost od svih prijetnji. Želi da država bude snažna kako bi mogla da brani svoje građane.",
      "ipadvnt_f": "Traga za avanturama i voli da rizikuje. Želi da ima uzbudljiv život.",
      "ipbhprp_f": "Važno joj je da se uvijek ponaša ispravno. Želi da izbjegne da uradi bilo šta što bi drugi ljudi smatrali pogrešnim.",
      "iprspot_f": "Važno joj je da uživa poštovanje drugih. Želi da ljudi rade ono što im kaže.",
      "iplylfr_f": "Važno joj je da bude odana svojim prijateljima. Želi da se posveti ljudima koji su joj bliski.",
      "impenv_f": "Čvrsto vjeruje da ljudi treba da brinu o prirodi. Briga o životnoj sredini joj je važna.",
      "imptrad_f": "Tradicija joj je važna. Trudi se da slijedi vjerske običaje ili običaje svoje porodice.",
      "impfun_f": "Koristi svaku priliku da se zabavi. Važno joj je da radi stvari koje joj pričinjavaju zadovoljstvo.",
      "pvq_gender_q": "Da li ste muškarac ili žena?",
      "pvq_gender_m": "Muškarac",
      "pvq_gender_f": "Žena",
      "pvq_head": "Koliko je svaka od ovih osoba slična Vama?",
      "debrief": "HVALA VAM NA VREMENU KOJE STE ODVOJILI ZA OVAJ UPITNIK."
    },
    "cs": {
      "pvq_inst": "H1 PŘEDLOŽTE KARTU 85 Nyní Vám stručně popíši určité lidi. Vyslechněte si prosím každý popis a",
      "pvq_r1": "Velmi se mi podobá",
      "pvq_r2": "Podobá se mi",
      "pvq_r3": "Podobá se mi trochu",
      "pvq_r4": "Podobá se mi málo",
      "pvq_r5": "Nepodobá se mi",
      "pvq_r6": "Vůbec se mi nepodobá",
      "ipcrtiv_m": "Promýšlení nových myšlenek a tvořivost jsou pro něho důležité. Rád dělá věci svým vlastním originálním způsobem.",
      "imprich_m": "Je pro něj důležité, aby byl bohatý. Chce mít hodně peněz a drahé věci.",
      "ipeqopt_m": "Myslí si, že je důležité, aby se s každým člověkem na světě zacházelo stejně. Věří, že každý by měl mít v životě stejné příležitosti.",
      "ipshabt_m": "Je pro něj důležité předvádět své schopnosti. Chce, aby lidé obdivovali, co dělá.",
      "impsafe_m": "Je pro něj důležité žít v bezpečném prostředí. Vyhýbá se všemu, co by mohlo ohrozit jeho bezpečnost.",
      "impdiff_m": "Má rád překvapení a vždy vyhledává nové aktivity. Myslí si, že je důležité v životě dělat mnoho různých věcí.",
      "ipfrule_m": "Věří, že lidé by měli dělat to, co se jim řekne. Myslí si, že lidé by měli dodržovat pravidla vždy, dokonce i když je nikdo nepozoruje.",
      "ipudrst_m": "Je pro něj důležité naslouchat lidem, kteří jsou jiní než on. I když s nimi nesouhlasí, chce jim porozumět.",
      "ipmodst_m": "Je pro něj důležité být pokorný a skromný. Nesnaží se přitahovat na sebe pozornost.",
      "ipgdtim_m": "Je pro něj důležité užívat si života. Rád si dopřává.",
      "impfree_m": "Je pro něj důležité, aby si sám rozhodoval o tom, co dělá. Má rád svobodu a nezávislost na druhých.",
      "iphlppl_m": "Je pro něj velmi důležité pomáhat lidem kolem sebe. Chce se starat o jejich blaho.",
      "ipsuces_m": "Je pro něj důležité být velmi úspěšný. Doufá, že lidé ocení, čeho dosáhl.",
      "ipstrgv_m": "Je pro něj důležité, aby mu vláda zajistila bezpečí před všemi hrozbami. Chce, aby byl stát silný tak, aby mohl chránit své občany.",
      "ipadvnt_m": "Vyhledává dobrodružství a rád riskuje. Chce mít vzrušující život.",
      "ipbhprp_m": "Je pro něj důležité, aby se vždy choval spořádaně. Chce se vyhnout všemu, o čem by lidé řekli, že je špatné.",
      "iprspot_m": "Je pro něj důležité, aby ho lidé respektovali. Chce, aby lidé dělali, co jim řekne.",
      "iplylfr_m": "Je pro něj důležité být loajální k přátelům. Chce se věnovat lidem, kteří jsou mu blízcí.",
      "impenv_m": "Pevně věří, že by se lidé měli starat o přírodu. Péče o životní prostředí je pro něj důležitá.",
      "imptrad_m": "Tradice je pro něj důležitá. Snaží se dodržovat zvyky, které se předávají v jeho náboženství nebo v jeho rodině.",
      "impfun_m": "Vyhledává každou příležitost, aby se pobavil. Je pro něj důležité dělat věci, které mu přinášejí potěšení.",
      "ipcrtiv_f": "konečně, všechna data budou ukládána v souladu s evropskými normami ochrany a zpracování dat (GDPR). Vaše odpovědi budou využity výhradně pro vědecké účely a nikdy pro účely marketingu, telefonního prodeje či jiné komerční účely.",
      "imprich_f": "Je pro ni důležité, aby byla bohatá. Chce mít hodně peněz a drahé věci.",
      "ipeqopt_f": "Myslí si, že je důležité, aby se s každým člověkem na světě zacházelo stejně. Věří, že každý by měl mít v životě stejné příležitosti.",
      "ipshabt_f": "Je pro ni důležité předvádět své schopnosti. Chce, aby lidé obdivovali, co dělá.",
      "impsafe_f": "Je pro ni důležité žít v bezpečném prostředí. Vyhýbá se všemu, co by mohlo ohrozit její bezpečnost.",
      "impdiff_f": "Má ráda překvapení a vždy vyhledává nové aktivity. Myslí si, že je důležité v životě dělat mnoho různých věcí.",
      "ipfrule_f": "Věří, že lidé by měli dělat to, co se jim řekne. Myslí si, že lidé by měli dodržovat pravidla vždy, dokonce i když je nikdo nepozoruje.",
      "ipudrst_f": "Je pro ni důležité naslouchat lidem, kteří jsou jiní než ona. I když s nimi nesouhlasí, chce jim porozumět.",
      "ipmodst_f": "Je pro ni důležité být pokorná a skromná. Nesnaží se přitahovat na sebe pozornost.",
      "ipgdtim_f": "Je pro ni důležité užívat si života. Ráda si dopřává.",
      "impfree_f": "Je pro ni důležité, aby si sama rozhodovala o tom, co dělá. Má ráda svobodu a nezávislost na druhých.",
      "iphlppl_f": "Je pro ni velmi důležité pomáhat lidem kolem sebe. Chce se starat o jejich blaho.",
      "ipsuces_f": "Je pro ni důležité být velmi úspěšnou. Doufá, že lidé ocení, čeho dosáhla.",
      "ipstrgv_f": "Je pro ni důležité, aby jí vláda zajistila bezpečí před všemi hrozbami. Chce, aby byl stát silný tak, aby mohl chránit své občany.",
      "ipadvnt_f": "Vyhledává dobrodružství a ráda riskuje. Chce mít vzrušující život.",
      "ipbhprp_f": "Je pro ni důležité, aby se vždy chovala spořádaně. Chce se vyhnout všemu, o čem by lidé řekli, že je špatné.",
      "iprspot_f": "Je pro ni důležité, aby ji lidé respektovali. Chce, aby lidé dělali, co jim řekne.",
      "iplylfr_f": "Je pro ni důležité být loajální k přátelům. Chce se věnovat lidem, kteří jsou jí blízcí.",
      "impenv_f": "Pevně věří, že by se lidé měli starat o přírodu. Péče o životní prostředí je pro ni důležitá.",
      "imptrad_f": "Tradice je pro ni důležitá. Snaží se dodržovat zvyky, které se předávají v jejím náboženství nebo v její rodině.",
      "impfun_f": "Vyhledává každou příležitost, aby se pobavila. Je pro ni důležité dělat věci, které jí přinášejí potěšení.",
      "pvq_gender_q": "Jste muž nebo žena?",
      "pvq_gender_m": "Muž",
      "pvq_gender_f": "Žena",
      "pvq_head": "Do jaké míry se Vám tato osoba podobá?",
      "debrief": "KONEC DOTAZNÍKU PRO TAZATELE"
    },
    "de": {
      "pvq_gender_q": "Sind Sie männlich oder weiblich?",
      "pvq_gender_m": "Männlich",
      "pvq_gender_f": "Weiblich",
      "pvq_head": "Wie sehr ähnelt Ihnen diese Person?",
      "debrief": "VIELEN DANK, DASS SIE SICH DIE ZEIT GENOMMEN HABEN, DIESE FRAGEN ZU BEANTWORTEN.",
      "pvq_r1": "Ist sehr ähnlich wie ich",
      "pvq_r2": "Ist wie ich",
      "pvq_r3": "Ist etwas wie ich",
      "pvq_r4": "Ist ein wenig wie ich",
      "pvq_r5": "Ist nicht wie ich",
      "pvq_r6": "Ist überhaupt nicht wie ich",
      "pvq_inst": "Ich werde Ihnen nun kurz einige Personen beschreiben. Bitte hören Sie sich jede Beschreibung an und sagen Sie mir, wie sehr jede Person Ihnen ähnelt oder nicht ähnelt. Bitte verwenden Sie diese Karte."
    },
    "el": {
      "ipcrtiv_m": "Είναι σημαντικό για αυτόν να έχει νέες ιδέες και να είναι δημιουργικός. Του αρέσει να κάνει πράγματα με τον δικό του πρωτότυπο τρόπο.",
      "imprich_m": "Είναι σημαντικό γι’ αυτόν να είναι πλούσιος. Θέλει να έχει πολλά λεφτά και ακριβά πράγματα.",
      "ipeqopt_m": "Πιστεύει πως είναι σημαντικό κάθε άνθρωπος στον κόσμο να αντιμετωπίζεται ισότιμα. Πιστεύει ότι όλοι πρέπει να έχουν ίσες ευκαιρίες στη ζωή.",
      "ipshabt_m": "Είναι σημαντικό γι’αυτόν να δείχνει τις ικανότητές του. Θέλει να τον θαυμάζουν για αυτό που κάνει.",
      "impsafe_m": "Είναι σημαντικό γι’αυτόν να ζει σε ένα μέρος που του παρέχει ασφάλεια. Αποφεύγει οτιδήποτε θα έθετε σε κίνδυνο την ασφάλειά του.",
      "impdiff_m": "Του αρέσουν οι εκπλήξεις και πάντα ψάχνει να κάνει καινούρια πράγματα. Νομίζει ότι είναι σημαντικό να κάνει πολλά διαφορετικά πράγματα στη ζωή.",
      "ipfrule_m": "Πιστεύει πως οι άνθρωποι πρέπει να κάνουν ό,τι τους λένε ότι πρέπει να κάνουν. Νομίζει ότι ο κόσμος πρέπει να ακολουθεί τους κανόνες ακόμα και όταν δεν τους παρακολουθεί κανένας.",
      "ipudrst_m": "Είναι σημαντικό γι’ αυτόν να ακούει ανθρώπους µε διαφορετικές απόψεις από τις δικές του. Ακόμα και όταν διαφωνεί μαζί τους, θέλει να τους κατανοήσει.",
      "ipmodst_m": "Είναι σημαντικό γι’αυτόν να είναι ταπεινός και μετριόφρων. Προσπαθεί να μην τραβά την προσοχή πάνω του.",
      "ipgdtim_m": "Το να περνά καλά είναι σημαντικό γι’ αυτόν. Του αρέσει να ’κακομαθαίνει’ τον εαυτό του.",
      "impfree_m": "Είναι σημαντικό γι’ αυτόν να παίρνει τις δικές του αποφάσεις για ό,τι κάνει. Του αρέσει να είναι ελεύθερος και να μην εξαρτάται από άλλους.",
      "iphlppl_m": "Είναι σημαντικό γι’ αυτόν να βοηθά τους άλλους γύρω του. Θέλει να φροντίζει για το καλό τους.",
      "ipsuces_m": "Είναι σημαντικό γι’ αυτόν να είναι πολύ πετυχημένος. Ελπίζει ο κόσμος να αναγνωρίσει τα επιτεύγματα του.",
      "ipstrgv_m": "Είναι σημαντικό γι’ αυτόν η κυβέρνηση να εγγυάται την ασφάλειά του έναντι όλων των απειλών. Θέλει το κράτος να είναι δυνατό ούτως ώστε να υπερασπίζεται τους πολίτες του.",
      "ipadvnt_m": "Ψάχνει για περιπέτειες κα του αρέσει να παίρνει ρίσκα. Θέλει να έχει μια συναρπαστική ζωή.",
      "ipbhprp_m": "Είναι σημαντικό γι’ αυτόν να συμπεριφέρεται πάντα σωστά. Θέλει να αποφεύγει να κάνει οτιδήποτε που ο κόσμος θα έλεγε ότι είναι λάθος.",
      "iprspot_m": "Είναι σημαντικό γι’ αυτόν να έχει το σεβασμό των άλλων. Θέλει οι άλλοι να κάνουν αυτό που τους λέει.",
      "iplylfr_m": "Είναι σημαντικό γι’ αυτόν να είναι πιστός στους φίλους του. Θέλει να αφοσιώνεται στους ανθρώπους που είναι κοντά του.",
      "impenv_m": "Πιστεύει έντονα ότι οι άνθρωποι πρέπει να νοιάζονται για τη φύση. Το να νοιάζεται για το περιβάλλον είναι σημαντικό γι’ αυτόν.",
      "imptrad_m": "Η παράδοση είναι σημαντική γι’ αυτόν. Προσπαθεί να τηρεί τα έθιμα που κληρονόμησε από τη θρησκεία ή την οικογένειά του.",
      "impfun_m": "Ψάχνει κάθε ευκαιρία για να περνά καλά/ψυχαγωγείται. Είναι σημαντικό γι’ αυτόν να κάνει πράγματα που του δίνουν ευχαρίστηση.",
      "pvq_inst": "ΡΩΤΗΣΤΕ ΑΝ ΤΟ ΕΡΩΤΩΜΕΝΟ ΑΤΟΜΟ ΕΙΝΑΙ ΑΝΤΡΑΣ (ΑΝ F2 = 1)",
      "ipcrtiv_f": "Είναι σημαντικό για αυτή να έχει νέες ιδέες και να είναι δημιουργική. Της αρέσει να κάνει πράγματα με τον δικό της πρωτότυπο τρόπο.",
      "imprich_f": "Είναι σημαντικό γι’ αυτήν να είναι πλούσια. Θέλει να έχει πολλά λεφτά και ακριβά πράγματα.",
      "ipeqopt_f": "Πιστεύει πως είναι σημαντικό κάθε άνθρωπος στον κόσμο να αντιμετωπίζεται ισότιμα. Πιστεύει ότι όλοι πρέπει να έχουν ίσες ευκαιρίες στη ζωή.",
      "ipshabt_f": "Είναι σημαντικό γι’αυτήν να δείχνει τις ικανότητές της. Θέλει να την θαυμάζουν για αυτό που κάνει.",
      "impsafe_f": "Είναι σημαντικό γι’αυτήν να ζει σε ένα μέρος που της παρέχει ασφάλεια. Αποφεύγει οτιδήποτε θα έθετε σε κίνδυνο την ασφάλεια της.",
      "impdiff_f": "Της αρέσουν οι εκπλήξεις και πάντα ψάχνει να κάνει καινούρια πράγματα. Νομίζει ότι είναι σημαντικό να κάνει πολλά διαφορετικά πράγματα στη ζωή.",
      "ipfrule_f": "Πιστεύει πως οι άνθρωποι πρέπει να κάνουν ό,τι τους λένε ότι πρέπει να κάνουν. Νομίζει ότι ο κόσμος πρέπει να ακολουθεί τους κανόνες ακόμα και όταν δεν παρακολουθεί κανένας.",
      "ipudrst_f": "Νομίζει ότι ο κόσμος πρέπει να ακολουθεί τους κανόνες ακόμα και όταν δεν παρακολουθεί κανένας. Ακόμα και όταν διαφωνεί μαζί τους, θέλει να τους κατανοήσει.",
      "ipmodst_f": "Είναι σημαντικό γι’αυτήν να είναι ταπεινή και μετριόφρων. Προσπαθεί να μην τραβά την προσοχή πάνω της.",
      "ipgdtim_f": "Το να περνά καλά είναι σημαντικό γι’ αυτήν. Της αρέσει να ’κακομαθαίνει’ τον εαυτό της.",
      "impfree_f": "Είναι σημαντικό γι’ αυτήν να παίρνει τις δικές της αποφάσεις για ό,τι κάνει. Της αρέσει να είναι ελεύθερη και να μην εξαρτάται από άλλους.",
      "iphlppl_f": "Είναι σημαντικό γι’ αυτήν να βοηθά τους άλλους γύρω της. Θέλει να φροντίζει για το καλό τους.",
      "ipsuces_f": "Το να είναι πολύ πετυχημένη είναι σημαντικό γι’ αυτήν. Ελπίζει ο κόσμος να αναγνωρίσει τα επιτεύγματα της.",
      "ipstrgv_f": "Είναι σημαντικό γι’ αυτήν η κυβέρνηση να εγγυάται την ασφάλεια της έναντι όλων των απειλών. Θέλει το κράτος να είναι δυνατό ούτως ώστε να υπερασπίζεται τους πολίτες του.",
      "ipadvnt_f": "Ψάχνει για περιπέτειες και της αρέσει να παίρνει ρίσκα. Θέλει να έχει μια συναρπαστική ζωή.",
      "ipbhprp_f": "Είναι σημαντικό γι’ αυτήν να συμπεριφέρεται πάντα σωστά. Θέλει να αποφεύγει να κάνει οτιδήποτε που ο κόσμος θα έλεγε ότι είναι λάθος.",
      "iprspot_f": "Είναι σημαντικό γι’ αυτήν να έχει το σεβασμό των άλλων. Θέλει οι άλλοι να κάνουν αυτό που τους λέει.",
      "iplylfr_f": "Είναι σημαντικό γι’ αυτήν να είναι πιστή στους φίλους της. Θέλει να αφοσιώνεται στους ανθρώπους που είναι κοντά της.",
      "impenv_f": "Πιστεύει έντονα ότι οι άνθρωποι πρέπει να νοιάζονται για τη φύση. Το να νοιάζεται για το περιβάλλον είναι σημαντικό γι’ αυτήν.",
      "imptrad_f": "Η παράδοση είναι σημαντική γι’ αυτήν. Προσπαθεί να τηρεί τα έθιμα που κληρονόμησε από τη θρησκεία ή την οικογένειά της.",
      "impfun_f": "Ψάχνει κάθε ευκαιρία για να περνά καλά/ψυχαγωγείται. Είναι σημαντικό γι’ αυτήν να κάνει πράγματα που της δίνουν ευχαρίστηση.",
      "pvq_r1": "Μου μοιάζει πολύ",
      "pvq_r2": "Μου μοιάζει",
      "pvq_r3": "Μου μοιάζει κάπως",
      "pvq_r4": "Μου μοιάζει λίγο",
      "pvq_r5": "Δεν μου μοιάζει",
      "pvq_r6": "Δεν μου μοιάζει καθόλου",
      "pvq_gender_q": "Είστε άνδρας ή γυναίκα;",
      "pvq_gender_m": "Άνδρας",
      "pvq_gender_f": "Γυναίκα",
      "pvq_head": "Πόσο σας μοιάζει αυτό το άτομο;",
      "debrief": "ΣΑΣ ΕΥΧΑΡΙΣΤΟΥΜΕ ΠΟΥ ΑΦΙΕΡΩΣΑΤΕ ΧΡΟΝΟ ΝΑ ΑΠΑΝΤΗΣΕΤΕ ΣΕ ΑΥΤΕΣ ΤΙΣ ΕΡΩΤΗΣΕΙΣ"
    },
    "es": {
      "pvq_gender_q": "¿Es usted hombre o mujer?",
      "pvq_gender_m": "Hombre",
      "pvq_gender_f": "Mujer",
      "pvq_head": "¿Cuánto se parece esta persona a usted?",
      "pvq_r1": "Se parece mucho a mí",
      "pvq_r2": "Se parece a mí",
      "pvq_r3": "Se parece algo a mí",
      "pvq_r4": "Se parece un poco a mí",
      "pvq_r5": "No se parece a mí",
      "pvq_r6": "No se parece nada a mí",
      "debrief": "MUCHAS GRACIAS POR TOMARSE EL TIEMPO DE RESPONDER ESTAS PREGUNTAS.",
      "pvq_inst": "Ahora le voy a describir brevemente a algunas personas. Por favor, escuche cada descripción y dígame en qué medida esa persona se parece a usted o no. Use esta tarjeta."
    },
    "et": {
      "pvq_inst": "H1 KAART 85 Järgnevalt kirjeldan lühidalt mõningaid inimesi. Palun kuulake iga kirjeldust ja öelge mulle, kuivõrd Teie moodi see inimene on. Vastamiseks kasutage kaarti 85.",
      "pvq_r1": "Väga minu moodi",
      "pvq_r2": "Minu moodi",
      "pvq_r3": "Mõnevõrra minu moodi",
      "pvq_r4": "Vaid pisut minu moodi",
      "pvq_r5": "Pole minu moodi",
      "pvq_r6": "Pole üldse minu moodi",
      "ipcrtiv_m": "Talle on oluline tulla välja uudsete ideedega ja olla loov. Talle meeldib teha asju omal, ainulaadsel viisil.",
      "imprich_m": "Tema jaoks on oluline olla rikas. Ta tahab, et tal oleks palju raha ja kalleid asju.",
      "ipeqopt_m": "Ta peab oluliseks, et kõiki inimesi maailmas koheldaks kui võrdseid. Tema arvates peaksid kõikidel inimestel olema elus võrdsed võimalused.",
      "ipshabt_m": "Tema jaoks on väga oluline näidata teistele oma oskusi ja võimeid. Ta tahab, et inimesed imetleksid seda, mida ta teeb.",
      "impsafe_m": "Talle on oluline elada turvalises ümbruses. Ta väldib kõike, mis võiks teda ohustada.",
      "impdiff_m": "Talle meeldivad üllatused ja ta otsib alati uusi tegevusi. Tema arvates on oluline tegeleda elu jooksul paljude erinevate asjadega.",
      "ipfrule_m": "Ta usub, et inimesed peaksid tegema seda, mida neil kästakse. Ta arvab, et inimesed peaksid reeglitest kinni pidama ka siis, kui keegi neid ei jälgi.",
      "ipudrst_m": "Tema jaoks on oluline ära kuulata endast erinevate inimeste arvamusi. Isegi kui ta nende inimestega nõus ei ole, tahab ta nendest siiski aru saada.",
      "ipmodst_m": "Tema jaoks on oluline olla tagasihoidlik ja vähenõudlik. Ta püüab endale mitte tähelepanu tõmmata.",
      "ipgdtim_m": "Talle on oluline mõnusalt aega veeta. Talle meeldib endale midagi erilist lubada.",
      "impfree_m": "Tema jaoks on oluline ise oma tegevuste üle otsustada. Talle meeldib olla vaba ja teistest mitte sõltuda.",
      "iphlppl_m": "Tema jaoks on väga oluline aidata inimesi enda ümber. Ta tahab hoolt kanda nende heaolu eest.",
      "ipsuces_m": "Talle on tähtis olla väga edukas. Ta loodab, et inimesed tunnustavad tema saavutusi.",
      "ipstrgv_m": "Talle on oluline, et valitsus tagab tema turvalisuse kõikide ohtude puhul. Ta tahab, et riik oleks tugev ja suudaks kaitsta oma kodanikke.",
      "ipadvnt_m": "Ta otsib seiklusi ja talle meeldib riskeerida. Ta tahab elada põnevat elu.",
      "ipbhprp_m": "Tema jaoks on oluline alati korralikult (kombekalt) käituda. Ta püüab vältida tegevusi, mida teised võiksid pidada sobimatuks.",
      "iprspot_m": "Talle on oluline, et teised inimesed kuuletuksid talle. Ta tahab, et inimesed teeksid seda, mida ta neile ütleb.",
      "iplylfr_m": "Tema jaoks on oluline olla ustav oma sõpradele. Ta tahab pühenduda oma lähedastele inimestele.",
      "impenv_m": "Ta on sügavalt veendunud, et inimesed peaksid loodust hoidma. Looduse eest hoolt kanda on tema jaoks väga oluline.",
      "imptrad_m": "Traditsioonid on tema jaoks olulised. Ta püüab järgida usulisi traditsioone ja kombeid, mis kanduvad peres edasi põlvest põlve.",
      "impfun_m": "Ta otsib mistahes võimalust, et lõbutseda. Talle on oluline teha asju, mis talle naudingut pakuvad.",
      "ipcrtiv_f": "Talle on oluline tulla välja uudsete ideedega ja olla loov. Talle meeldib teha asju omal, ainulaadsel viisil.",
      "imprich_f": "Tema jaoks on oluline olla rikas. Ta tahab, et tal oleks palju raha ja kalleid asju.",
      "ipeqopt_f": "Ta peab oluliseks, et kõiki inimesi maailmas koheldaks kui võrdseid. Tema arvates peaksid kõikidel inimestel olema elus võrdsed võimalused.",
      "ipshabt_f": "Tema jaoks on väga oluline näidata teistele oma oskusi ja võimeid. Ta tahab, et inimesed imetleksid seda, mida ta teeb.",
      "impsafe_f": "Talle on oluline elada turvalises ümbruses. Ta väldib kõike, mis võiks teda ohustada.",
      "impdiff_f": "Talle meeldivad üllatused ja ta otsib alati uusi tegevusi. Tema arvates on oluline tegeleda elu jooksul paljude erinevate asjadega.",
      "ipfrule_f": "Ta usub, et inimesed peaksid tegema seda, mida neil kästakse. Ta arvab, et inimesed peaksid reeglitest kinni pidama ka siis, kui keegi neid ei jälgi.",
      "ipudrst_f": "Tema jaoks on oluline ära kuulata endast erinevate inimeste arvamusi. Isegi kui ta nende inimestega nõus ei ole, tahab ta nendest siiski aru saada.",
      "ipmodst_f": "Tema jaoks on oluline olla tagasihoidlik ja vähenõudlik. Ta püüab endale mitte tähelepanu tõmmata.",
      "ipgdtim_f": "Talle on oluline mõnusalt aega veeta. Talle meeldib endale midagi erilist lubada.",
      "impfree_f": "Tema jaoks on oluline ise oma tegevuste üle otsustada. Talle meeldib olla vaba ja teistest mitte sõltuda.",
      "iphlppl_f": "Tema jaoks on väga oluline aidata inimesi enda ümber. Ta tahab hoolt kanda nende heaolu eest.",
      "ipsuces_f": "Talle on tähtis olla väga edukas. Ta loodab, et inimesed tunnustavad tema saavutusi.",
      "ipstrgv_f": "Talle on oluline, et valitsus tagab tema turvalisuse kõikide ohtude puhul. Ta tahab, et riik oleks tugev ja suudaks kaitsta oma kodanikke.",
      "ipadvnt_f": "Ta otsib seiklusi ja talle meeldib riskeerida. Ta tahab elada põnevat elu.",
      "ipbhprp_f": "Tema jaoks on oluline alati korralikult (kombekalt) käituda. Ta püüab vältida tegevusi, mida teised võiksid pidada sobimatuks.",
      "iprspot_f": "Talle on oluline, et teised inimesed kuuletuksid talle. Ta tahab, et inimesed teeksid seda, mida ta neile ütleb.",
      "iplylfr_f": "Tema jaoks on oluline olla ustav oma sõpradele. Ta tahab pühenduda oma lähedastele inimestele.",
      "impenv_f": "Ta on sügavalt veendunud, et inimesed peaksid loodust hoidma. Looduse eest hoolt kanda on tema jaoks väga oluline.",
      "imptrad_f": "Traditsioonid on tema jaoks olulised. Ta püüab järgida usulisi traditsioone ja kombeid, mis kanduvad peres edasi põlvest põlve.",
      "impfun_f": "Ta otsib mistahes võimalust, et lõbutseda. Talle on oluline teha asju, mis talle naudingut pakuvad.",
      "pvq_gender_q": "Kas olete mees või naine?",
      "pvq_gender_m": "Mees",
      "pvq_gender_f": "Naine",
      "pvq_head": "Kuivõrd Teie moodi see inimene on?",
      "debrief": "LÕPP."
    },
    "fi": {
      "pvq_inst": "Kuvailen lyhyesti ihmisten ominaisuuksia. 1 Erittäin paljon samanlainen kuin minä Käytä korttia 85 Kuuntele jokainen kuvaus ja kerro, kuinka paljon 2 Melko samanlainen kuin minä tai vähän kuvaus muistuttaa sinua itseäsi. 3 Jonkin verran samanlainen kuin minä A Ideoiden tuottaminen ja luovuus ovat hänelle 4 Vain hieman samanlainen kuin minä tärkeitä. Hän haluaa tehdä asiat omaperäisesti. 5 Ei juuri lainkaan samanlainen kuin minä",
      "pvq_r1": "Erittäin paljon samanlainen kuin minä",
      "pvq_r2": "Melko samanlainen kuin minä",
      "pvq_r3": "Jonkin verran samanlainen kuin minä",
      "pvq_r4": "Vain hieman samanlainen kuin minä",
      "pvq_r5": "Ei juuri lainkaan samanlainen kuin minä",
      "pvq_r6": "Ei lainkaan samanlainen kuin minä",
      "ipcrtiv_m": "Ideoiden tuottaminen ja luovuus ovat hänelle tärkeitä. Hän haluaa tehdä asiat omaperäisesti.",
      "ipcrtiv_f": "Ideoiden tuottaminen ja luovuus ovat hänelle tärkeitä. Hän haluaa tehdä asiat omaperäisesti.",
      "imprich_m": "Hänestä on tärkeää olla rikas. Hän haluaa, että hänellä on paljon rahaa ja kalliita tavaroita.",
      "imprich_f": "Hänestä on tärkeää olla rikas. Hän haluaa, että hänellä on paljon rahaa ja kalliita tavaroita.",
      "ipeqopt_m": "Hänestä on tärkeätä, että kaikkia maailman ihmisiä kohdellaan tasa-arvoisesti. Hän katsoo, että kaikilla pitäisi olla samat mahdollisuudet elämässä.",
      "ipeqopt_f": "Hänestä on tärkeätä, että kaikkia maailman ihmisiä kohdellaan tasa-arvoisesti. Hän katsoo, että kaikilla pitäisi olla samat mahdollisuudet elämässä.",
      "ipshabt_m": "Hänestä on tärkeää saada näyttää muille taitojaan. Hän haluaa, että hänen tekemisiään ihaillaan.",
      "ipshabt_f": "Hänestä on tärkeää saada näyttää muille taitojaan. Hän haluaa, että hänen tekemisiään ihaillaan.",
      "impsafe_m": "Hänelle on tärkeää elää turvallisessa ympäristössä. Hän välttää kaikkea, mikä voisi uhata hänen turvallisuuttaan.",
      "impsafe_f": "Hänelle on tärkeää elää turvallisessa ympäristössä. Hän välttää kaikkea, mikä voisi uhata hänen turvallisuuttaan.",
      "impdiff_m": "Hän pitää yllätyksistä ja etsii uusia asioita, joita voisi tehdä. Hänestä on tärkeätä tehdä erilaisia asioita elämässään.",
      "impdiff_f": "Hän pitää yllätyksistä ja etsii uusia asioita, joita voisi tehdä. Hänestä on tärkeätä tehdä erilaisia asioita elämässään.",
      "ipfrule_m": "Hänen mielestään ihmisten pitää tehdä, kuten käsketään. Hänen mielestään sääntöjä pitää noudattaa aina, vaikka kukaan ei ole näkemässä.",
      "ipfrule_f": "Hänen mielestään ihmisten pitää tehdä, kuten käsketään. Hänen mielestään sääntöjä pitää noudattaa aina, vaikka kukaan ei ole näkemässä.",
      "ipudrst_m": "Hänestä on tärkeätä kuunnella ihmisiä, jotka ovat erilaisia kuin hän itse. Vaikka hän olisi heidän kanssaan eri mieltä, hän haluaa silti ymmärtää heitä.",
      "ipudrst_f": "Hänestä on tärkeätä kuunnella ihmisiä, jotka ovat erilaisia kuin hän itse. Vaikka hän olisi heidän kanssaan eri mieltä, hän haluaa silti ymmärtää heitä.",
      "ipmodst_m": "Hänestä on tärkeätä olla nöyrä ja vaatimaton. Hän ei pyri keräämään huomiota osakseen.",
      "ipmodst_f": "Hänestä on tärkeätä olla nöyrä ja vaatimaton. Hän ei pyri keräämään huomiota osakseen.",
      "ipgdtim_m": "Hänestä on tärkeätä pitää hauskaa. Hän pitää itsensä hemmottelemisesta.",
      "ipgdtim_f": "Hänestä on tärkeätä pitää hauskaa. Hän pitää itsensä hemmottelemisesta.",
      "impfree_m": "Hänestä on tärkeätä päättää itse omista asioistaan. Hän haluaa olla vapaa ja riippumaton toisista.",
      "impfree_f": "Hänestä on tärkeätä päättää itse omista asioistaan. Hän haluaa olla vapaa ja riippumaton toisista.",
      "iphlppl_m": "Hänestä on tärkeätä auttaa ympärillään olevia ihmisiä. Hän haluaa huolehtia heidän hyvinvoinnistaan.",
      "iphlppl_f": "Hänestä on tärkeätä auttaa ympärillään olevia ihmisiä. Hän haluaa huolehtia heidän hyvinvoinnistaan.",
      "ipsuces_m": "Menestyminen on hänelle tärkeätä. Hän haluaa, että hänen saavutuksensa huomataan.",
      "ipsuces_f": "Menestyminen on hänelle tärkeätä. Hän haluaa, että hänen saavutuksensa huomataan.",
      "ipstrgv_m": "Hänelle on tärkeätä, että valtio takaa hänen turvallisuutensa kaikkia uhkia vastaan. Hän haluaa, että valtio on niin vahva, että se voi suojella kansalaisiaan.",
      "ipstrgv_f": "Hänelle on tärkeätä, että valtio takaa hänen turvallisuutensa kaikkia uhkia vastaan. Hän haluaa, että valtio on niin vahva, että se voi suojella kansalaisiaan.",
      "ipadvnt_m": "Hän etsii seikkailuja ja haluaa ottaa riskejä. Hän haluaa jännitystä elämäänsä.",
      "ipadvnt_f": "Hän etsii seikkailuja ja haluaa ottaa riskejä. Hän haluaa jännitystä elämäänsä.",
      "ipbhprp_m": "Hänestä on tärkeätä käyttäytyä moitteettomasti. Hän haluaa välttää tekemästä mitään, mikä toisen mielestä on väärin.",
      "ipbhprp_f": "Hänestä on tärkeätä käyttäytyä moitteettomasti. Hän haluaa välttää tekemästä mitään, mikä toisen mielestä on väärin.",
      "iprspot_m": "Hänestä on tärkeätä nauttia toisten ihmisten kunnioitusta. Hän haluaa ihmisten tekevän, kuten hän sanoo.",
      "iprspot_f": "Hänestä on tärkeätä nauttia toisten ihmisten kunnioitusta. Hän haluaa ihmisten tekevän, kuten hän sanoo.",
      "iplylfr_m": "Hänestä on tärkeätä olla uskollinen ystävilleen. Hän haluaa omistautua läheisilleen.",
      "iplylfr_f": "Hänestä on tärkeätä olla uskollinen ystävilleen. Hän haluaa omistautua läheisilleen.",
      "impenv_m": "Hän on voimakkaasti sitä mieltä, että ihmisten pitäisi välittää luonnosta. Ympäristöstä huolehtiminen on hänelle tärkeää.",
      "impenv_f": "Hän on voimakkaasti sitä mieltä, että ihmisten pitäisi välittää luonnosta. Ympäristöstä huolehtiminen on hänelle tärkeää.",
      "imptrad_m": "Perinteet ovat hänelle tärkeitä. Hän pyrkii noudattamaan uskonnollisia sekä sukunsa tapoja.",
      "imptrad_f": "Perinteet ovat hänelle tärkeitä. Hän pyrkii noudattamaan uskonnollisia sekä sukunsa tapoja.",
      "impfun_m": "Hän etsii mahdollisuuksia pitää hauskaa. Hänelle ovat tärkeitä asiat, jotka tuottavat iloa.",
      "impfun_f": "Hän etsii mahdollisuuksia pitää hauskaa. Hänelle ovat tärkeitä asiat, jotka tuottavat iloa.",
      "pvq_gender_q": "Oletteko mies vai nainen?",
      "pvq_gender_m": "Mies",
      "pvq_gender_f": "Nainen",
      "pvq_head": "Kuinka paljon tämä henkilö muistuttaa sinua?",
      "debrief": "Kiitos vastauksestasi!"
    },
    "fr": {
      "ipcrtiv_m": "Réfléchir à de nouvelles idées et être créatif c'est important pour lui. Il aime faire les choses à sa manière.",
      "imprich_m": "C'est important pour lui d'être riche. Il veut avoir beaucoup d'argent et des choses chères.",
      "ipeqopt_m": "Il pense que c'est important que tout être humain soit traité de manière égale. Il pense que tout le monde devrait avoir des chances égales dans la vie.",
      "ipshabt_m": "C'est important pour lui de montrer de quoi il est capable. Il veut que les gens admirent ce qu'il fait.",
      "impsafe_m": "Vivre dans un environnement sécurisant est important pour lui. Il évite tout ce qui peut mettre en danger sa sécurité.",
      "impdiff_m": "Il aime les surprises et recherche toujours de nouvelles choses à faire. Il pense que c'est important de faire beaucoup de choses différentes dans la vie.",
      "ipfrule_m": "Il pense que les gens devraient faire ce qu'on leur dit. Il pense que les gens devraient toujours suivre les règles établies, même si personne ne les surveille.",
      "ipudrst_m": "C'est important pour lui d'écouter les gens qui sont différents de lui. Même quand il n'est pas d'accord avec eux, il tient quand même à les comprendre.",
      "ipmodst_m": "Être humble et modeste est important pour lui. Il essaie de ne pas attirer l'attention sur lui.",
      "ipgdtim_m": "Avoir du bon temps est important pour lui. Il aime bien se faire plaisir.",
      "impfree_m": "C'est important pour lui de décider tout seul de ce qu'il va faire. Il aime être libre et ne pas dépendre des autres.",
      "iphlppl_m": "C'est très important pour lui d'aider les gens qui l'entourent. Il désire se préoccuper de leur bien-être.",
      "ipsuces_m": "Avoir beaucoup de succès est important pour lui. Il espère que les gens reconnaîtront ce qu'il a fait.",
      "ipstrgv_m": "C'est important pour lui que le gouvernement garantisse sa sécurité. Il veut un État fort qui défende les citoyens.",
      "ipadvnt_m": "Il recherche l'aventure et aime prendre des risques. Il désire une vie excitante.",
      "ipbhprp_m": "Se comporter toujours comme il faut est important pour lui. Il ne veut rien faire que les gens puissent lui reprocher.",
      "iprspot_m": "C'est important pour lui d'être respecté par les autres. Il veut que les autres fassent ce qu'il leur dit.",
      "iplylfr_m": "Être fidèle à ses amis est important pour lui. Il veut se dévouer pour les personnes qui lui sont proches.",
      "impenv_m": "Il pense que les gens doivent se soucier de la nature. S'occuper de l'environnement est important pour lui.",
      "imptrad_m": "Les traditions sont importantes pour lui. Il essaie de suivre les coutumes transmises par la religion et la famille.",
      "impfun_m": "Il recherche toutes les occasions de s'amuser. C'est important pour lui de faire des choses qui lui procurent du plaisir.",
      "ipcrtiv_f": "Réfléchir à de nouvelles idées et être créative c'est important pour elle. Elle aime faire les choses à sa manière.",
      "imprich_f": "C'est important pour elle d'être riche. Elle veut avoir beaucoup d'argent et des choses chères.",
      "ipeqopt_f": "Elle pense que c'est important que tout être humain soit traité de manière égale. Elle pense que tout le monde devrait avoir des chances égales dans la vie.",
      "ipshabt_f": "C'est important pour elle de montrer de quoi elle est capable. Elle veut que les gens admirent ce qu'elle fait.",
      "impsafe_f": "Vivre dans un environnement sécurisant est important pour elle. Elle évite tout ce qui peut mettre en danger sa sécurité.",
      "impdiff_f": "Elle aime les surprises et recherche toujours de nouvelles choses à faire. Elle pense que c'est important de faire beaucoup de choses différentes dans la vie.",
      "ipfrule_f": "Elle pense que les gens devraient faire ce qu'on leur dit. Elle pense que les gens devraient toujours suivre les règles établies, même si personne ne les surveille.",
      "ipudrst_f": "C'est important pour elle d'écouter les gens qui sont différents d'elle. Même quand elle n'est pas d'accord avec eux, elle tient quand même à les comprendre.",
      "ipmodst_f": "Être humble et modeste est important pour elle. Elle essaie de ne pas attirer l'attention sur elle.",
      "ipgdtim_f": "Avoir du bon temps est important pour elle. Elle aime bien se faire plaisir.",
      "impfree_f": "C'est important pour elle de décider toute seule de ce qu'elle va faire. Elle aime être libre et ne pas dépendre des autres.",
      "iphlppl_f": "C'est très important pour elle d'aider les gens qui l'entourent. Elle désire se préoccuper de leur bien-être.",
      "ipsuces_f": "Avoir beaucoup de succès est important pour elle. Elle espère que les gens reconnaîtront ce qu'elle a fait.",
      "ipstrgv_f": "C'est important pour elle que le gouvernement garantisse sa sécurité. Elle veut un État fort qui défende les citoyens.",
      "ipadvnt_f": "Elle recherche l'aventure et aime prendre des risques. Elle désire une vie excitante.",
      "ipbhprp_f": "Se comporter toujours comme il faut est important pour elle. Elle ne veut rien faire que les gens puissent lui reprocher.",
      "iprspot_f": "C'est important pour elle d'être respectée par les autres. Elle veut que les autres fassent ce qu'elle leur dit.",
      "iplylfr_f": "Être fidèle à ses amis est important pour elle. Elle veut se dévouer pour les personnes qui lui sont proches.",
      "impenv_f": "Elle pense que les gens doivent se soucier de la nature. S'occuper de l'environnement est important pour elle.",
      "imptrad_f": "Les traditions sont importantes pour elle. Elle essaie de suivre les coutumes transmises par la religion et la famille.",
      "impfun_f": "Elle recherche toutes les occasions de s'amuser. C'est important pour elle de faire des choses qui lui procurent du plaisir.",
      "pvq_inst": "H1 MONTRER LISTE 85 Je vais maintenant rapidement vous décrire quelques personnes. Écoutez s'il vous plaît chaque description et dites-moi dans quelle mesure cette personne vous ressemble ou pas. Utilisez cette liste de réponses pour me répondre. Tout à Pas du",
      "pvq_r1": "Tout à fait comme moi",
      "pvq_r2": "Comme moi",
      "pvq_r3": "Plutôt comme moi",
      "pvq_r4": "Un peu comme moi",
      "pvq_r5": "Pas comme moi",
      "pvq_r6": "Pas du tout comme moi",
      "pvq_gender_q": "Êtes-vous un homme ou une femme ?",
      "pvq_gender_m": "Homme",
      "pvq_gender_f": "Femme",
      "pvq_head": "Dans quelle mesure cette personne vous ressemble-t-elle?",
      "debrief": "MERCI D'AVOIR PRIS LE TEMPS DE RÉPONDRE À CES QUESTIONS."
    },
    "he": {
      "pvq_gender_q": "האם אתה זכר או נקבה?",
      "pvq_gender_m": "זכר",
      "pvq_gender_f": "נקבה",
      "pvq_head": "עד כמה האדם הזה דומה לך?",
      "pvq_r1": "דומה לי מאוד",
      "pvq_r2": "דומה לי",
      "pvq_r3": "דומה לי קצת",
      "pvq_r4": "דומה לי מעט",
      "pvq_r5": "לא דומה לי",
      "pvq_r6": "לא דומה לי בכלל",
      "debrief": "תודה רבה לך על הזמן שהקדשת לענות על השאלות הללו.",
      "pvq_inst": "כעת אתאר בקצרה כמה אנשים. אנא הקשיבו לכל תיאור ואמרו לי עד כמה כל אדם דומה לכם או לא דומה לכם. השתמשו בכרטיס זה."
    },
    "hr": {
      "pvq_inst": "H1 KARTICA 85 Sada ću vam kratko opisati neke osobe. Molim vas, poslušajte opis svake osobe i recite mi koliko je svaka od njih slična vama. Koristite sljedeću karticu za odgovaranje.",
      "pvq_r1": "Jako nalikuje meni",
      "pvq_r2": "Nalikuje meni",
      "pvq_r3": "Donekle nalikuje meni",
      "pvq_r4": "Malo nalikuje meni",
      "pvq_r5": "Ne nalikuje meni",
      "pvq_r6": "Uopće ne nalikuje meni",
      "ipcrtiv_m": "Važno mu je smišljati nove ideje i biti kreativan. On voli stvari raditi na svoj, originalan način.",
      "imprich_m": "Važno mu je biti bogat. Želi imati mnogo novaca i posjedovati skupe stvari.",
      "ipeqopt_m": "On smatra da je važno da se prema svim ljudima na svijetu postupa na jednak način. Vjeruje da bi svi ljudi trebali imati jednake mogućnosti u životu.",
      "ipshabt_m": "Vrlo mu je važno iskazivati vlastite sposobnosti. Želi da se ljudi dive onome što on radi.",
      "impsafe_m": "Važno mu je živjeti u sigurnom okruženju. Izbjegava sve što bi moglo ugroziti njegovu sigurnost.",
      "impdiff_m": "On voli iznenađenja i stalno je u potrazi za nekim novim aktivnostima. Smatra da je u životu važno isprobati puno različitih stvari.",
      "ipfrule_m": "On vjeruje da bi ljudi trebali činiti ono što im se kaže. Smatra da bi se ljudi uvijek trebali držati pravila, čak i kada ih nitko ne gleda.",
      "ipudrst_m": "Važno mu je saslušati ljude koji su drugačiji od njega. Čak i kada se ne slaže s njihovim mišljenjima, ipak ih nastoji razumjeti.",
      "ipmodst_m": "Važno mu je biti ponizan i skroman. Nastoji ne privlačiti pozornost na sebe.",
      "ipgdtim_m": "Važno mu je uživati u blagodatima života. Voli si ugađati.",
      "impfree_m": "Važno mu je da sam donosi odluke o onome što radi. Voli biti samostalan i ne oslanjati se na druge.",
      "iphlppl_m": "Vrlo mu je važno pomagati ljudima koji ga okružuju. Želi voditi brigu o njihovoj dobrobiti.",
      "ipsuces_m": "Važno mu je biti vrlo uspješan. Želio bi da drugi prepoznaju njegove uspjehe i postignuća.",
      "ipstrgv_m": "Važno mu je da državna vlast osigura njegovu sigurnost od svih prijetnji. Smatra da država treba biti snažna kako bi mogla obraniti svoje građane.",
      "ipadvnt_m": "On je stalno u potrazi za avanturama i voli se izlagati riziku. Želi voditi uzbudljiv život.",
      "ipbhprp_m": "Važno mu je da se uvijek ponaša pristojno. Nastoji izbjeći sve za što bi ljudi mogli reći da je loše.",
      "iprspot_m": "Važno mu je da ga drugi poštuju. Želi da ljudi čine ono što im on kaže.",
      "iplylfr_m": "Važno mu je biti odan svojim prijateljima. Želi se posvetiti ljudima koji su mu bliski.",
      "impenv_m": "On čvrsto vjeruje da bi ljudi trebali skrbiti za prirodu. Briga za okoliš mu je važna.",
      "imptrad_m": "Tradicija mu je važna. On nastoji održavati običaje koje propisuje njegova vjera ili štuje njegova obitelj.",
      "impfun_m": "On traži svaku priliku da se zabavi. Važno mu je raditi stvari koje mu pričinjaju zadovoljstvo.",
      "ipcrtiv_f": "Važno joj je smišljati nove ideje i biti kreativna. Ona voli stvari raditi na svoj, originalan način.",
      "imprich_f": "Važno joj je biti bogata. Želi imati mnogo novaca i posjedovati skupe stvari.",
      "ipeqopt_f": "Ona smatra da je važno da se prema svim ljudima na svijetu postupa na jednak način. Vjeruje da bi svi ljudi trebali imati jednake mogućnosti u životu.",
      "ipshabt_f": "Vrlo joj je važno iskazivati vlastite sposobnosti. Želi da se ljudi dive onome što ona radi.",
      "impsafe_f": "Važno joj je živjeti u sigurnom okruženju. Izbjegava sve što bi moglo ugroziti njezinu sigurnost.",
      "impdiff_f": "Ona voli iznenađenja i stalno je u potrazi za nekim novim aktivnostima. Smatra da je u životu važno isprobati puno različitih stvari.",
      "ipfrule_f": "Ona vjeruje da bi ljudi trebali činiti ono što im se kaže. Smatra da bi se ljudi uvijek trebali držati pravila, čak i kada ih nitko ne gleda.",
      "ipudrst_f": "Važno joj je saslušati ljude koji su drugačiji od nje. Čak i kada se ne slaže s njihovim mišljenjima, ipak ih nastoji razumjeti.",
      "ipmodst_f": "Važno joj je biti ponizna i skromna. Nastoji ne privlačiti pozornost na sebe.",
      "ipgdtim_f": "Važno joj je uživati u blagodatima života. Voli si ugađati.",
      "impfree_f": "Važno joj je da sama donosi odluke o onome što radi. Voli biti samostalna i ne oslanjati se na druge.",
      "iphlppl_f": "Vrlo joj je važno pomagati ljudima koji je okružuju. Želi voditi brigu o njihovoj dobrobiti.",
      "ipsuces_f": "Važno joj je biti vrlo uspješna. Željela bi da drugi prepoznaju njezine uspjehe i postignuća.",
      "ipstrgv_f": "Važno joj je da državna vlast osigura njezinu sigurnost od svih prijetnji. Smatra da država treba biti snažna kako bi mogla obraniti svoje građane.",
      "ipadvnt_f": "Ona je stalno u potrazi za avanturama i voli se izlagati riziku. Želi voditi uzbudljiv život.",
      "ipbhprp_f": "Važno joj je da se uvijek ponaša pristojno. Nastoji izbjeći sve za što bi ljudi mogli reći da je loše.",
