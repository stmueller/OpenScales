  "translations": {
    "en": {
      "opt_1": "Strongly Disagree",
      "opt_2": "Disagree",
      "opt_3": "Agree",
      "opt_4": "Strongly Agree",
      "sec_social_capital_title": "Social Capital",
      "multidimensional_assessment_recovery_capital_support_others": "I actively support other people who are in recovery.",
      "multidimensional_assessment_recovery_capital_family_difficult": "My family makes my recovery more difficult.",
      "multidimensional_assessment_recovery_capital_friend_support": "I have at least one friend who supports my recovery.",
      "multidimensional_assessment_recovery_capital_family_support": "My family supports my recovery.",
      "multidimensional_assessment_recovery_capital_people_not_recover": "Some people in my life do not think I'll make it in my recovery.",
      "multidimensional_assessment_recovery_capital_feel_alone": "I feel alone.",
      "multidimensional_assessment_recovery_capital_part_community": "I feel like I'm part of a recovery community.",
      "sec_physical_capital_title": "Physical Capital",
      "multidimensional_assessment_recovery_capital_helpful_housing": "My housing situation is helpful for my recovery.",
      "multidimensional_assessment_recovery_capital_difficult_transport": "I have difficulty getting transportation.",
      "multidimensional_assessment_recovery_capital_unstable_housing": "My housing situation is unstable.",
      "multidimensional_assessment_recovery_capital_enough_money": "I have enough money every week to buy the basic things I need.",
      "multidimensional_assessment_recovery_capital_not_enough_money": "Not having enough money makes my recovery more difficult.",
      "multidimensional_assessment_recovery_capital_afford_care": "I can afford the care I need for my health, mental health, and recovery.",
      "multidimensional_assessment_recovery_capital_access_communication": "I have reliable access to a phone and the internet.",
      "sec_human_capital_title": "Human Capital",
      "multidimensional_assessment_recovery_capital_hard_fun": "I find it hard to have fun.",
      "multidimensional_assessment_recovery_capital_physically_healthy": "I feel physically healthy most days.",
      "multidimensional_assessment_recovery_capital_guilt_shame": "I am struggling with guilt or shame.",
      "multidimensional_assessment_recovery_capital_stress": "I am experiencing a lot of stress.",
      "multidimensional_assessment_recovery_capital_education_training_prepare": "My education and training have prepared me to handle life's challenges.",
      "multidimensional_assessment_recovery_capital_mental_health": "I have problems with my mental health.",
      "multidimensional_assessment_recovery_capital_purpose_meaning": "I feel my life has purpose and meaning.",
      "sec_cultural_capital_title": "Cultural Capital",
      "multidimensional_assessment_recovery_capital_hard_trust": "It's hard for me to trust others.",
      "multidimensional_assessment_recovery_capital_fun_activities": "I have opportunities to participate in fun activities that do not involve drugs and alcohol.",
      "multidimensional_assessment_recovery_capital_disconnected_culture": "I feel disconnected from my culture or not part of any culture.",
      "multidimensional_assessment_recovery_capital_feel_outcast": "I feel like an outcast.",
      "multidimensional_assessment_recovery_capital_helpful_services_avail": "There are helpful services and resources accessible to me.",
      "multidimensional_assessment_recovery_capital_let_go_identity": "It's hard to let go of the part of my identity that was linked to my drinking or drug use.",
      "multidimensional_assessment_recovery_capital_neighborhood_safe": "My neighborhood or town feels safe.",
      "px590501_scoring_instructions": "<div class=\"rich-text-field-label\"><p>Scoring Instructions:<br><br>Please see the written instructions below. For a visual example, see the sample scoring chart and blank scoring chart included at: <a href=\"https://socialwork.buffalo.edu/resources/multidimensional-inventory-recovery-capital.html\">socialwork.buffalo.edu/resources/multidimensional-inventory-recovery-capital.html.</a><br><br>Step 1. Write the score for each survey item in the 'Starting Score' column.<br><br>Step 2. For the items highlighted in yellow (items 2, 5, 6, 9, 10, 12, 15, 17, 18, 20, 22, 24, 25, and 27), change the scores from 4 to 1, 3 to 2, 2 to 3, or 1 to 4. Write the new score in the 'Reverse Score' column.<br><br>Step 3. If the item has a 'Reverse Score' write that in the 'Final Score' column. If it does not, write the 'Starting Score' in the 'Final Score' column.<br><br>Step 4. Add the final scores in each section together. Write this in the light gray Social, Physical, Human, and Cultural Capital 'Total' boxes. The minimum score is 7, the middle score is 17-18, and the maximum score is 28.<br><br>Step 5. Add the 'Total' scores from each section and write this in the dark gray 'Overall Recovery Capital' 'Total' box. The minimum score is 28, the middle score is 70, and the maximum score is 112.</p></div>"
    }
  }
}