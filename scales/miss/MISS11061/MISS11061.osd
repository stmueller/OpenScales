  "definition": {
    "scale_info": {
      "name": "Multidimensional Scale of Perceived Social Support – Igbo Translation",
      "code": "MISS11061",
      "abbreviation": "MSPSS-ig",
      "description": "Igbo translation and psychometric evaluation of the 12-item Multidimensional Scale of Perceived Social Support (MSPSS; Zimet et al., 1988). Validated in a sample of 504 Igbo-speaking Nigerian undergraduate students. Confirmatory factor analysis supported a three-factor structure (Significant Other, Family, Friends) with adequate fit indices and acceptable reliability (alphas .71–.82). Full MSPSS OSD with English and Igbo translations is in restricted/MSPSS/MSPSS.osd.",
      "citation": "Iorfa, S. K., Ottu, I. F. A., Oguntayo, R., Ayandele, O., Kolawole, S. O., Gandi, J. C., Dangiwa, A. L., & Olapegba, P. O. (2020). COVID-19 knowledge, risk perception and precautionary behavior among Nigerians: A moderated mediation approach. Frontiers in Psychology, 11, 566773. https://doi.org/10.3389/fpsyg.2020.566773",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/11061",
      "domain": "Social Support",
      "version": "1.0",
      "see_also": "restricted/MSPSS/MSPSS.osd"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "This MISS article provides the Igbo translation (CC BY 4.0). The original MSPSS English items (Zimet et al., 1988) are freely available for research use from the author's website (https://gzimet.wixsite.com/mspss) but are not open-licensed; they are housed in restricted/MSPSS/MSPSS.osd along with the Igbo translation. Igbo items from Supplementary Appendix 1 (42409_2021_26_MOESM1_ESM.docx). Additional translations reviewed in Patel et al. (2018) https://doi.org/10.1186/s12955-018-0912-0."
    }
  },
  "translations": {
