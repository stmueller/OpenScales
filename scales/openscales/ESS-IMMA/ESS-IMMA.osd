{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-IMMA",
      "name": "Immigration Attitudes Battery (ESS)",
      "abbreviation": "ESS-IMMA",
      "description": "6-item battery measuring attitudes toward immigration from the European Social Survey Round 10 core module. Items B40–B42 tap admission preferences (how many immigrants to allow, by ethnic/racial similarity and country of origin) using a 4-point categorical scale. Items B43–B45 tap perceived impact of immigration on the economy, cultural life, and quality of life using 0–10 scales. Two subscales: admission restrictiveness and impact evaluation.",
      "citation": "Sides, J., & Citrin, J. (2007). European opinion about immigration: The role of identities, interests and information. British Journal of Political Science, 37(3), 477–504. https://doi.org/10.1017/S0007123407000257\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items B40–B45 from ESS10 GB source questionnaire. ESS variable names used as item IDs. Admission items (imsmetn, imdfetn, impcntr) use an incompatible 4-point categorical format (1=Allow many, 2=Allow some, 3=Allow a few, 4=Allow none) — lower raw score = more permissive. For an intuitive admission restrictiveness score (higher=more restrictive), items are used with code=1 and mean reported as-is (1–4 range). Impact items (imbgeco, imueclt, imwbcnt) use 0–10 bipolar scales with distinct anchors — higher score = more positive impact evaluation. The two subscales use incompatible metrics and should not be combined into a single composite without standardization."
    },
    "dimensions": [
      {
        "id": "admission",
        "name": "Admission Restrictiveness",
        "description": "Preference for restricting immigration by ethnicity and origin. Items: imsmetn, imdfetn, impcntr. Range 1–4; higher = more restrictive (Allow none=4)."
      },
      {
        "id": "impact",
        "name": "Impact Evaluation",
        "description": "Perceived effects of immigration on economy, culture, and quality of life. Items: imbgeco, imueclt, imwbcnt. Range 0–10; higher = more positive impact evaluation."
      }
    ],
    "items": [
