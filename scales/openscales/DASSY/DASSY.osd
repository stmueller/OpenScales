{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "DASSY",
      "name": "Depression Anxiety Stress Scales for Youth",
      "abbreviation": "DASS-Y",
      "description": "21-item scale measuring depression, anxiety, and stress symptoms in adolescents and children, adapted from the adult DASS. Respondents rate how true each statement was for them during the past week.",
      "citation": "Szabo, M., & Lovibond, P. F. (2022). Development and psychometric properties of the DASS-Youth (DASS-Y): An extension of the Depression Anxiety Stress Scales (DASS) to adolescents and children. Frontiers in Psychology, 13. https://doi.org/10.3389/fpsyg.2022.766890",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2022.766890",
      "version": "1.0",
      "domain": "Mental Health",
      "license_explanation": "Published under CC BY 4.0 by Szabo & Lovibond (2022). Translations reproduced from the UNSW DASS-Y translations page (www2.psy.unsw.edu.au/groups/dass/DASS-Y%20Translations.htm); DASS-Y is public domain per the UNSW DASS FAQ."
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 4,
      "min": 0,
      "max": 3,
      "labels": [
        "DASSY_r0",
        "DASSY_r1",
        "DASSY_r2",
        "DASSY_r3"
      ],
      "question_head": "DASSY_head"
    },
    "dimensions": [
      {
        "id": "Depression",
        "name": "Depression",
        "description": "Dysphoria, hopelessness, anhedonia, and low self-worth"
      },
      {
        "id": "Anxiety",
        "name": "Anxiety",
        "description": "Autonomic arousal, fear, and physical anxiety symptoms"
      },
      {
        "id": "Stress",
        "name": "Stress",
        "description": "Tension, irritability, and difficulty relaxing"
      }
    ],
