  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "section_title_ipip_mpq_ab": "IPIP MPQ: Imagination",
      "section_title_ipip_mpq_ac": "IPIP MPQ: Achievement-striving",
      "section_title_ipip_mpq_ag": "IPIP MPQ: Belligerence",
      "section_title_ipip_mpq_al": "IPIP MPQ: Distrust",
      "section_title_ipip_mpq_co": "IPIP MPQ: Planfulness",
      "section_title_ipip_mpq_ha": "IPIP MPQ: Risk-avoidance",
      "section_title_ipip_mpq_sc": "IPIP MPQ: Friendliness",
      "section_title_ipip_mpq_sp": "IPIP MPQ: Assertiveness",
      "section_title_ipip_mpq_sr": "IPIP MPQ: Neuroticism",
      "section_title_ipip_mpq_tr": "IPIP MPQ: Conservatism",
      "section_title_ipip_mpq_uv": "IPIP MPQ: Unlikely Virtues",
      "section_title_ipip_mpq_wb": "IPIP MPQ: Joyfulness",
      "ipip_H1210": "Love to reflect on things.",
      "ipip_E77": "Rarely look for a deeper meaning in things.",
      "ipip_E105": "See beauty in things that others might not notice.",
      "ipip_H286": "Continue until everything is perfect.",
      "ipip_P385": "Do too little work.",
      "ipip_P477": "Have a slow pace to my life.",
      "ipip_H1206": "Work hard.",
      "ipip_P484": "Work too much.",
      "ipip_X198": "Cheat to get ahead.",
      "ipip_H710": "Do things out of revenge.",
      "ipip_H699": "Get back at others.",
      "ipip_X217": "Hold a grudge.",
      "ipip_E120": "Rarely complain.",
      "ipip_X265": "Rarely get irritated.",
      "ipip_X231": "Seldom get mad.",
      "ipip_E126": "Try to forgive and forget.",
      "ipip_P367": "Would never take things that aren't mine.",
      "ipip_H917": "Have a sharp tongue.",
      "ipip_H41": "Act comfortably with others.",
      "ipip_X15": "Dislike myself.",
      "ipip_H914": "Feel attacked by others.",
      "ipip_H617": "Feel short-changed in life.",
      "ipip_E159": "Feel that people have a hard time understanding me.",
      "ipip_X163": "Am exacting in my work.",
      "ipip_H250": "Do things by the book.",
      "ipip_E46": "Jump into things without thinking.",
      "ipip_E122": "Like to act on a whim.",
      "ipip_H1467": "Make a mess of things.",
      "ipip_X263": "Make plans and stick to them.",
      "ipip_H853": "Make rash decisions.",
      "ipip_E66": "Often make last-minute plans.",
      "ipip_H1362": "Pay attention to details.",
      "ipip_X171": "Like to plan ahead.",
      "ipip_X3": "Am willing to try anything once.",
      "ipip_H870": "Do crazy things.",
      "ipip_H876": "Do dangerous things.",
      "ipip_E35": "Enjoy being reckless.",
      "ipip_H446": "Seek adventure.",
      "ipip_H894": "Seek danger.",
      "ipip_H864": "Take risks.",
      "ipip_E71": "Would never make a high-risk investment.",
      "ipip_H317": "Avoid dangerous situations.",
      "ipip_X250": "Would never go hang gliding or bungee jumping.",
      "ipip_H598": "Avoid company.",
      "ipip_H2016": "Enjoy being part of a group.",
      "ipip_H1095": "Love to chat.",
      "ipip_P364": "Am good at making impromptu speeches.",
      "ipip_X68": "Don't like to draw attention to myself.",
      "ipip_P461": "Find it difficult to manipulate others.",
      "ipip_P432": "Have a natural talent for influencing people.",
      "ipip_H1039": "Have little to say.",
      "ipip_H154": "Keep in the background.",
      "ipip_X138": "Am not easily bothered by things.",
      "ipip_E141": "Am relaxed most of the time.",
      "ipip_E150": "Don't worry about things that have already happened.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_E92": "Have frequent mood swings.",
      "ipip_H948": "Panic easily.",
      "ipip_X35": "Believe in one true religion.",
      "ipip_X123": "Believe in the importance of art.",
      "ipip_X219": "Believe that criminals should receive help rather than punishment.",
      "ipip_X184": "Believe that there is no absolute right and wrong.",
      "ipip_X157": "Believe that we should be tough on crime.",
      "ipip_P488": "Don't consider myself religious.",
      "ipip_X254": "Like to stand during the national anthem.",
      "ipip_X126": "Tend to vote for conservative political candidates.",
      "ipip_X218": "Tend to vote for liberal political candidates.",
      "ipip_X178": "Believe laws should be strictly enforced.",
      "ipip_P454": "Always admit it when I make a mistake.",
      "ipip_P427": "Always know what I am doing.",
      "ipip_P433": "Always know why I do things.",
      "ipip_X87": "Am always prepared.",
      "ipip_H440": "Am always ready to start afresh.",
      "ipip_P490": "Am not always honest with myself.",
      "ipip_P447": "Am not always what I appear to be.",
      "ipip_P481": "Don't always practice what I preach.",
      "ipip_P413": "Have never engaged in gossip.",
      "ipip_P478": "Have some bad habits.",
      "ipip_P356": "Have sometimes had to tell a lie.",
      "ipip_H403": "Know immediately what to do.",
      "ipip_X182": "Know that anyone who tries can get a job.",
      "ipip_X102": "Never give up hope.",
      "ipip_H556": "Never give up.",
      "ipip_H198": "Will do anything for others.",
      "ipip_P383": "Believe there is never an excuse for lying.",
      "ipip_X84": "Am often in a bad mood.",
      "ipip_H2020": "Feel lucky most of the time.",
      "ipip_X205": "Feel that my life lacks direction.",
      "ipip_H639": "Have a dark outlook on the future.",
      "ipip_H1094": "Have a lot of fun.",
      "ipip_H646": "Have a low opinion of myself.",
      "ipip_P379": "Just know that I will be a success.",
      "ipip_X74": "Often feel blue.",
      "ipip_H32": "Radiate joy.",
      "ipip_H33": "Love life."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_X182": "Znam da svako ko pokuša može da dobije posao.",
      "ipip_H250": "Radim stvari \"po PS-u\".",
      "ipip_P432": "Imam prirodni talenat da utičem na druge ljude.",
      "ipip_H617": "Osećam se uskraćeno u životu.",
      "ipip_P356": "Ponekad sam morao da lažem.",
      "ipip_X263": "Pravim planove i pridržavam ih se.",
      "ipip_P385": "Premalo radim.",
      "ipip_X254": "Volim da stojim za vreme nacionalne himne.",
      "ipip_X138": "Ne potresam se lako zbog stvari.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_H870": "Često radim nešto ludo.",
      "ipip_P383": "Verujem da nikad ne postoji izgovor za laganje.",
      "ipip_H446": "Tragam za pustolovinama.",
      "ipip_H556": "Nikada ne odustajem.",
      "ipip_H41": "Opušten sam u društvu drugih ljudi.",
      "ipip_X219": "Verujem da je kriminalcima potrebna pomoć više nego kazna.",
      "ipip_P478": "Imam neke loše navike.",
      "ipip_H1095": "Volim da ćaskam.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_H639": "Imam tmuran pogled na budućnost.",
      "ipip_X198": "Varam da bih napredovao.",
      "ipip_H317": "Izbegavam opasne situacije.",
      "ipip_H1210": "Volim da promišljam o raznim stvarima.",
      "ipip_X231": "Retko se naljutim.",
      "ipip_E150": "Ne brinem o onome što se već dogodilo.",
      "ipip_H2020": "Uglavnom osećam da imam sreće.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_P484": "Previše radim.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H646": "Imam nisko mišljenje o sebi.",
      "ipip_E105": "Vidim lepotu u stvarima koje drugi možda ne primećuju.",
      "ipip_H1094": "Umem dobro da se zabavljam.",
      "ipip_P433": "Uvek znam zašto nešto radim.",
      "ipip_X178": "Mislim da se zakoni trebaju strogo primenjivati.",
      "ipip_E66": "Često pravim planove u poslednjem trenutku.",
      "ipip_X218": "Sklon sam da glasam za liberalne političare.",
      "ipip_X157": "Verujem da treba da budemo nepopustljivi prema kriminalu.",
      "ipip_E159": "Imam osećaj da je ljudima teško da me razumeju.",
      "ipip_E122": "Volim da radim stvari iz hira.",
      "ipip_H33": "Volim život.",
      "ipip_H876": "Često radim opasne stvari.",
      "ipip_E71": "Nikada se ne bih upuštao u rizične investicije.",
      "ipip_H948": "Lako se uspaničim",
      "ipip_E77": "Retko tragam za nekim dubljim smislom.",
      "ipip_X84": "Često sam neraspoložen.",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_X15": "Ne sviđam se sam sebi.",
      "ipip_X250": "Nikada ne bih išao na paraglajding ili bandži- džamping.",
      "ipip_P379": "Jednostavno znam da ću biti uspešan/na.",
      "ipip_X126": "Sklon sam da glasam za konzervativne političare.",
      "ipip_P447": "Nisam uvek onakav kakvim se činim.",
      "ipip_H403": "Odmah znam šta treba činiti.",
      "ipip_P364": "Dobar sam u spontanim govorima.",
      "ipip_H440": "Uvek sam spreman da počnem iznova.",
      "ipip_H286": "Ono što radim, dovodim do savršenstva.",
      "ipip_H1206": "Vredno radim.",
      "ipip_X3": "Hoću sve da probam.",
      "ipip_H894": "Tragam za opasnošću.",
      "ipip_P490": "Nisam uvek iskren prema sebi.",
      "ipip_X205": "Osećam da moj život nema usmerenje.",
      "ipip_P413": "Nikada nisam ogovarao druge.",
      "ipip_P481": "Ne radim uvek onako kako govorim.",
      "ipip_H710": "Mnoge stvari radim iz osvete.",
      "ipip_P454": "Uvek priznam kad napravim grešku.",
      "ipip_P367": "Nikada ne bih uzeo nešto što nije moje.",
      "ipip_X87": "Uvek sam spreman na sve.",
      "ipip_H864": "Često rizikujem.",
      "ipip_H32": "Zračim radošću.",
      "ipip_X184": "Verujem da ne postoji apsolutno dobro i zlo.",
      "ipip_X171": "Volim da planiram unapred",
      "ipip_P427": "Uvek znam šta radim.",
      "ipip_H699": "Vraćam drugima \"milo za drago\".",
      "ipip_H914": "Često se osećam napadnuto od strane drugih.",
      "ipip_H198": "Spreman sam da uradim sve za druge.",
      "ipip_H2016": "Uživam da budem deo grupe.",
      "ipip_H853": "Često donosim ishitrene odluke.",
      "ipip_E35": "Uživam da se ponašam bahato.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_P477": "Živim laganim životom.",
      "ipip_H917": "Imam oštar jezik.",
      "ipip_H598": "Izbegavam društvo.",
      "ipip_X35": "Veujem da postoji samo jedna prava religija.",
      "ipip_P461": "Teško mi je da manipulišem drugima.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_E120": "Retko se žalim.",
      "ipip_E46": "U mnoge stvari se upuštam bez razmišljanja.",
      "ipip_H1467": "Često pravim nered.",
      "ipip_X102": "Nikada ne gubim nadu.",
      "ipip_P488": "Ne smatram sebe religioznom osobom.",
      "ipip_X217": "Umem da budem zlopamtilo.",
      "ipip_X265": "Retko se iznerviram."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_X182": "Vet att alla som försöker kan få ett jobb",
      "ipip_H250": "Gör saker som man ska göra (efter reglerna)",
      "ipip_P432": "Har en naturligt talang för att påverka människor",
      "ipip_H617": "Känner mig olyckligt lottad",
      "ipip_P356": "Har ibland blivit tvungen att ljuga",
      "ipip_X263": "Gör upp planer och håller mig till dem",
      "ipip_P385": "Gör lite arbete",
      "ipip_X254": "Får en positiv känsla när nationalsången spelas",
      "ipip_X138": "Blir sällan störd av saker",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_E126": "Försöker glömma och förlåta",
      "ipip_H870": "Gör galna saker",
      "ipip_P383": "Tycker aldrig det finns en ursäkt för att ljuga",
      "ipip_H446": "Söker äventyret",
      "ipip_H556": "Ger aldrig upp",
      "ipip_H41": "Agerar bekvämt tillsammans med andra",
      "ipip_X219": "Tror att kriminella borde få hjälp hellre än straff",
      "ipip_P478": "Har en del dåliga vanor",
      "ipip_H1095": "Älskar att småprata",
      "ipip_X163": "Är grundlig i mitt arbete",
      "ipip_H639": "Har en mörk syn på framtiden",
      "ipip_X198": "Fuskar för att bli bäst",
      "ipip_H317": "Undviker farliga situationer",
      "ipip_H1210": "Älskar att reflektera över saker och ting",
      "ipip_X231": "Blir sällan förbannad",
      "ipip_E150": "Oroar mig inte för sådant som redan inträffat",
      "ipip_H2020": "Känner mig tursam för det mesta",
      "ipip_H154": "Håller mig i bakgrunden",
      "ipip_X107": "Blir lätt stressad",
      "ipip_P484": "Arbetar för mycket",
      "ipip_H1362": "Uppmärksammar detaljer",
      "ipip_H646": "Har låga tankar om mig själv",
      "ipip_E105": "Ser skönhet i sådant andra inte märker",
      "ipip_H1094": "Gör en massa roliga saker",
      "ipip_P433": "Vet alltid varför jag gör saker",
      "ipip_X178": "Tror på att lagar skall upprätthållas strikt med maktmedel",
      "ipip_E66": "Planerar ofta i sista minuten",
      "ipip_X218": "Brukar rösta på partier som bryr sig om människor",
      "ipip_X157": "Tycker att vi skall vara tuffa mot brottslighet",
      "ipip_E159": "Känns som andra människor har svårt att förstå mig",
      "ipip_E122": "Tycker om att följa ett infall",
      "ipip_H33": "Älskar livet",
      "ipip_H876": "Gör farliga saker",
      "ipip_E71": "Skulle aldrig göra en chansartad investering",
      "ipip_H948": "Blir lätt panikslagen",
      "ipip_E77": "Ser sällan efter en djupare mening i saker",
      "ipip_X84": "Är ofta på dåligt humör",
      "ipip_X123": "Tror på betydelsen av konst",
      "ipip_E92": "Har ofta förekommande humörsvängningar",
      "ipip_X15": "Tycker illa om mig själv",
      "ipip_X250": "Skulle aldrig ägna mig åt hängflygning eller bungee-jumping",
      "ipip_P379": "Vet bara att jag kommer att lyckas",
      "ipip_X126": "Brukar rösta på de konservativa partierna",
      "ipip_P447": "Är inte alltid den som jag verkar vara",
      "ipip_H403": "Vet genast vad som behöver göras",
      "ipip_P364": "Är bra på att hålla oförberedda tal",
      "ipip_H440": "Är alltid beredd att börja på nytt",
      "ipip_H286": "Fortsätter tills allt är perfekt",
      "ipip_H1206": "Arbetar hårt",
      "ipip_X3": "Är villig att pröva vad som helst en gång",
      "ipip_H894": "Söker faran",
      "ipip_P490": "Är ibland oärlig mot mig själv",
      "ipip_X205": "Känns som om mitt liv saknar inriktning",
      "ipip_P413": "Har aldrig deltagit i sladder",
      "ipip_P481": "Praktiserar inte alltid vad jag predikar",
      "ipip_H710": "Gör saker för att hämnas",
      "ipip_P454": "Erkänner alltid när jag gör misstag",
      "ipip_P367": "Skulle aldrig ta något som inte var mitt",
      "ipip_X87": "Är alltid förberedd",
      "ipip_H864": "Tar risker",
      "ipip_H32": "Sprider glädje",
      "ipip_X184": "Tror inte att det finns något som är absolut rätt och fel",
      "ipip_X171": "Tycker om att planera i förväg",
      "ipip_P427": "Vet alltid vad jag gör",
      "ipip_H699": "Tar revansch på andra",
      "ipip_H914": "Känner mig attackerad av andra",
      "ipip_H198": "Gör vad som helst för andra",
      "ipip_H2016": "Gillar att vara en del av en grupp",
      "ipip_H853": "Tar överilade beslut",
      "ipip_E35": "Tycker om att vara obetänksam",
      "ipip_X74": "Känner mig ofta nere",
      "ipip_P477": "Har ett långsamt tempo i livet",
      "ipip_H917": "Har en skarp tunga",
      "ipip_H598": "Undviker sällskap",
      "ipip_X35": "Tror på en sann religion",
      "ipip_P461": "Tycker det är svårt att manipulera andra",
      "ipip_H1039": "Har lite att säga",
      "ipip_E120": "Klagar sällan",
      "ipip_E46": "Kastar mig över saker utan att tänka efter",
      "ipip_H1467": "Skapar oreda omkring mig",
      "ipip_X102": "Ger aldrig upp hoppet",
      "ipip_P488": "Betraktar mig inte som religiös",
      "ipip_X217": "Klagar inte på andra",
      "ipip_X265": "Blir sällan irriterad"
    }
  }
