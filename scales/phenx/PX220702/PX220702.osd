{
  "scale_info": {
    "name": "Disease Progression and Regression - 2-11 Years",
    "code": "PX220702",
    "abbreviation": "PX220702",
    "description": "The Newcastle Paediatric Mitochondrial Disease Scale (NPMDS) and the Newcastle Mitochondrial Disease Adult Scale (NMDAS) can be used to evaluate the progression of mitochondrial disease. There are three versions of the NPMDS, each for a specific age range (0-24 months, 2-11 years, and 12-18 years). ",
    "domain": "Child Development",
    "citation": "Enns, G. M., Moore, T., Le, A., Atkuri, K., Shah, M. K., Cusmano-Ozog, K., Niemi, A. K., & Cowan, T. M. (2014). Degree of glutathione deficiency and redox imbalance depend on subtype of mitochondrial disease and clinical status. PLoS One , 9 (6), e100001. doi:10.1371/journal.pone.0100001 Phoenix, C., Schaefer, A. M., Elson, J. L., Morava, E., Bugiani, M., Uziel, G., Smeitink, J. A., Turnbull, D. M., & McFarland, R. (2006). A scale to monitor progression and treatment of mitochondrial disease in children. Neuromuscular disorders: NMD , 16 (12), 814-820. [PhenX: https://www.phenxtoolkit.org/protocols/view/220702]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/220702"
  },
  "likert_options": {
    "points": 5,
    "min": 1,
    "max": 5,
    "labels": [
      "lk_opt_1",
      "lk_opt_2",
      "lk_opt_3",
      "lk_opt_4",
      "lk_opt_5"
    ]
  },
  "option_sets": {
