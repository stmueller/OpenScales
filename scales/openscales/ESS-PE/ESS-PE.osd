{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-PE",
      "name": "Political Efficacy Battery (ESS)",
      "abbreviation": "ESS-PE",
      "description": "4-item measure of political efficacy from the European Social Survey core module (since Round 1). Two items tap external efficacy (perceived responsiveness of the political system) and two tap internal efficacy (perceived personal ability and confidence to participate). All items use 5-point scales.",
      "citation": "Balch, G. I. (1974). Multiple indicators in survey research: The concept 'sense of political efficacy'. Political Methodology, 1(2), 1–43.\nVetter, A. (1997). Political efficacy: Reliability and validity of old and new measures. Westdeutscher Verlag.\nPrats, M., & Meunier, A. (2021). Political efficacy and participation: An empirical analysis in European countries. OECD Working Papers on Public Governance, (46), 0_1–23.\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.1",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items B2–B5 from ESS10 GB source questionnaire (self-completion booklets number them A13–A16). ESS variable names used as item IDs. psppsgv and psppipla share response labels (pe_r_sys); actrolga has distinct ability labels (pe_r_abl); cptppola has distinct confidence labels (pe_r_con). Higher scores = greater efficacy on all items. Translations extracted from ESS10 national questionnaires (CC BY-SA 4.0). Russian translation from EE_rus (ESS10 Estonia Russian-language version); item texts reference Estonia — adapt country name for deployment outside Estonia."
    },
    "dimensions": [
      {
        "id": "external",
        "name": "External Efficacy",
        "description": "Perceived responsiveness of the political system. Items: psppsgv, psppipla."
      },
      {
        "id": "internal",
        "name": "Internal Efficacy",
        "description": "Perceived personal ability and confidence to participate in politics. Items: actrolga, cptppola."
      },
      {
        "id": "total",
        "name": "Political Efficacy",
        "description": "Mean of all 4 items. Range 1–5; higher = greater efficacy."
      }
    ],
    "items": [
      {
        "id": "pe_inst",
        "type": "inst",
        "text_key": "pe_inst"
      },
      {
        "id": "psppsgv",
        "type": "likert",
        "text_key": "psppsgv",
        "dimension": "external",
        "likert_options": {
          "points": 5,
          "min": 1,
          "labels": [
            "pe_r1_sys",
            "pe_r2_sys",
            "pe_r3_sys",
            "pe_r4_sys",
            "pe_r5_sys"
          ]
        }
      },
      {
        "id": "actrolga",
        "type": "likert",
        "text_key": "actrolga",
        "dimension": "internal",
        "likert_options": {
          "points": 5,
          "min": 1,
          "labels": [
            "pe_r1_abl",
            "pe_r2_abl",
            "pe_r3_abl",
            "pe_r4_abl",
            "pe_r5_abl"
          ]
        }
      },
      {
        "id": "psppipla",
        "type": "likert",
        "text_key": "psppipla",
        "dimension": "external",
        "likert_options": {
          "points": 5,
          "min": 1,
          "labels": [
            "pe_r1_sys",
            "pe_r2_sys",
            "pe_r3_sys",
            "pe_r4_sys",
            "pe_r5_sys"
          ]
        }
      },
      {
        "id": "cptppola",
        "type": "likert",
        "text_key": "cptppola",
        "dimension": "internal",
        "likert_options": {
          "points": 5,
          "min": 1,
          "labels": [
            "pe_r1_con",
            "pe_r2_con",
            "pe_r3_con",
            "pe_r4_con",
            "pe_r5_con"
          ]
        }
      }
    ],
    "scoring": {
      "external": {
        "method": "mean_coded",
        "description": "Mean of psppsgv and psppipla. Range 1–5; higher = greater external efficacy.",
        "items": {
          "psppsgv": 1,
          "psppipla": 1
        }
      },
      "internal": {
        "method": "mean_coded",
        "description": "Mean of actrolga and cptppola. Range 1–5; higher = greater internal efficacy.",
        "items": {
          "actrolga": 1,
          "cptppola": 1
        }
      },
      "total": {
        "method": "mean_coded",
        "description": "Mean of all 4 items. Range 1–5; higher = greater political efficacy.",
        "items": {
          "psppsgv": 1,
          "actrolga": 1,
          "psppipla": 1,
          "cptppola": 1
        }
      }
    },
    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Political Efficacy Battery (ESS) Report",
      "footer_refs": [
        "ESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no. License: CC BY-SA 4.0.",
        "Scoring: mean of items per subscale. Range 1–5; higher = greater efficacy."
      ]
    }
  },
  "translations": {
    "en": {
      "pe_inst": "The following questions ask about your views on politics.",
      "psppsgv": "How much would you say the political system allows people like you to have a say in what the government does?",
      "actrolga": "How able do you think you are to take an active role in a group involved with political issues?",
      "psppipla": "How much would you say that the political system allows people like you to have an influence on politics?",
      "cptppola": "How confident are you in your own ability to participate in politics?",
      "pe_r1_sys": "Not at all",
      "pe_r2_sys": "Very little",
      "pe_r3_sys": "Some",
      "pe_r4_sys": "A lot",
      "pe_r5_sys": "A great deal",
      "pe_r1_abl": "Not at all able",
      "pe_r2_abl": "A little able",
      "pe_r3_abl": "Quite able",
      "pe_r4_abl": "Very able",
      "pe_r5_abl": "Completely able",
      "pe_r1_con": "Not at all confident",
      "pe_r2_con": "A little confident",
      "pe_r3_con": "Quite confident",
      "pe_r4_con": "Very confident",
      "pe_r5_con": "Completely confident",
      "debrief": "Thank you for completing this questionnaire."
    },
    "ar": {
