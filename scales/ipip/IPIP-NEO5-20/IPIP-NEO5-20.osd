  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "section_title_ipip_neo5_20_agreeableness": "IPIP NEO5-20: Agreeableness",
      "section_title_ipip_neo5_20_conscientiousness": "IPIP NEO5-20: Conscientiousness",
      "section_title_ipip_neo5_20_extraversion": "IPIP NEO5-20: Extraversion",
      "section_title_ipip_neo5_20_neuroticism": "IPIP NEO5-20: Neuroticism",
      "section_title_ipip_neo5_20_openness_to_experience": "IPIP NEO5-20: Openness To Experience",
      "ipip_H882": "Am easy to satisfy.",
      "ipip_H1325": "Am out for my own personal gain.",
      "ipip_H736": "Believe that I am better than others.",
      "ipip_H549": "Believe that others have good intentions.",
      "ipip_H808": "Contradict others.",
      "ipip_H422": "Cut others to pieces.",
      "ipip_H2030": "Make demands on others.",
      "ipip_H105": "Respect others.",
      "ipip_H604": "Suspect hidden motives in others.",
      "ipip_H186": "Treat all people equally.",
      "ipip_H917": "Have a sharp tongue.",
      "ipip_E157": "Trust what people say.",
      "ipip_H258": "Carry out my plans.",
      "ipip_H1285": "Complete tasks successfully.",
      "ipip_X115": "Do just enough work to get by.",
      "ipip_H854": "Don't put my mind on the task at hand.",
      "ipip_H885": "Don't see things through.",
      "ipip_H254": "Finish what I start.",
      "ipip_X196": "Follow through with my plans.",
      "ipip_H928": "Leave things unfinished.",
      "ipip_H896": "Mess things up.",
      "ipip_H969": "Need a push to get started.",
      "ipip_H596": "Am hard to get to know.",
      "ipip_H648": "Avoid contacts with others.",
      "ipip_H1151": "Cheer people up.",
      "ipip_H704": "Keep others at a distance.",
      "ipip_H649": "Retreat from others.",
      "ipip_H52": "Warm up quickly to others.",
      "ipip_X59": "Am not easily frustrated.",
      "ipip_H640": "Am often down in the dumps.",
