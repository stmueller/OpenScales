  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H41": "Act comfortably with others.",
      "ipip_P388": "Am less capable than most people.",
      "ipip_P435": "Believe that my success depends on ability rather than luck.",
      "ipip_P369": "Believe that the world is controlled by a few powerful people.",
      "ipip_P394": "Believe that unfortunate events occur because of bad luck.",
      "ipip_H2009": "Come up with good solutions.",
      "ipip_X15": "Dislike myself.",
      "ipip_P359": "Dislike taking responsibility for making decisions.",
      "ipip_X129": "Feel comfortable with myself.",
      "ipip_H954": "Feel that I'm unable to deal with things.",
      "ipip_X205": "Feel that my life lacks direction.",
      "ipip_H1116": "Feel up to any task.",
      "ipip_H1183": "Habitually blow my chances.",
      "ipip_P379": "Just know that I will be a success.",
      "ipip_P473": "Like to take responsibility for making decisions.",
      "ipip_E135": "Make a decision and move on.",
      "ipip_H633": "See difficulties everywhere.",
      "ipip_H64": "Take the initiative.",
      "ipip_P433": "Always know why I do things.",
      "ipip_P442": "Believe that by working hard a person can achieve anything.",
      "ipip_P409": "Believe that events in my life are determined only by me.",
      "ipip_H973": "Can't stand on my own.",
      "ipip_X105": "Am not sure where my life is going.",
      "ipip_H1166": "Am resigned to my fate.",
      "ipip_P360": "Believe in the power of fate.",
      "ipip_X112": "Feel comfortable around people.",
      "ipip_H617": "Feel short-changed in life.",
      "ipip_H1185": "Know how to enjoy myself.",
      "ipip_P357": "Remember my failures more easily than my successes.",
      "ipip_H33": "Love life.",
      "ipip_P404": "Believe some people are born lucky."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_H2009": "Dolazim do dobrih resenja.",
      "ipip_P394": "Verujem da se nesrećni slučajevi dešavaju zbog malera.",
      "ipip_P388": "Manje sam sposoban od većine ljudi.",
      "ipip_P442": "Verujem da se napornim radom može sve postići.",
      "ipip_H973": "Nisam samostalan.",
      "ipip_P433": "Uvek znam zašto nešto radim.",
      "ipip_H1185": "Umem da uživam.",
      "ipip_H1116": "Osećam da sam dorastao svakom zadatku.",
      "ipip_H33": "Volim život.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H64": "Preuzimam inicijativu.",
      "ipip_P404": "Verujem da su neki ljudi rođeni pod srećnom zvezdom.",
      "ipip_H954": "Imam osećaj da nisam u stanju da se nosim sa stvarima.",
      "ipip_H1183": "Obično prokockam svoje šanse.",
      "ipip_P369": "Verujem da svetom upravlja nekoliko moćnih ljudi.",
      "ipip_P360": "Verujem u moć vere.",
      "ipip_H1166": "Pomirio sam se sa svojom sudbinom.",
      "ipip_X129": "Osećam se prijatno kad provodim vreme sam.",
      "ipip_X205": "Osećam da moj život nema usmerenje.",
      "ipip_X105": "Nisam siguran u kom pravcu ide moj život.",
      "ipip_P379": "Jednostavno znam da ću biti uspešan/na.",
      "ipip_P435": "Verujem da moj uspeh više zavisi od mojih sposobnosti nego od sreće.",
      "ipip_X15": "Ne sviđam se sam sebi.",
      "ipip_H617": "Osećam se uskraćeno u životu.",
      "ipip_E135": "Kada donesem odluku, ne preispitujem se.",
      "ipip_P473": "Volim da preuzmem odgovornost za donošenje odluka.",
      "ipip_H41": "Opušten sam u društvu drugih ljudi.",
      "ipip_P359": "Ne volim da preuzimam odgovornost za donošenje odluka.",
      "ipip_H633": "Svuda vidim potešokće.",
      "ipip_P357": "Neuspehe pamtim bolje nego uspehe.",
      "ipip_P409": "Verujem da događaji u mom životu zavise samo od mene."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
