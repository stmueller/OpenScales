  "translations": {
    "en": {
      "lk_0": "Never True",
      "lk_1": "Very rarely true",
      "lk_2": "Seldom true",
      "lk_3": "Sometimes true",
      "lk_4": "Often true",
      "lk_5": "Almost always true",
      "lk_6": "Always true",
      "question_head": "In this questionnaire, we use the term 'frustration' to describe negative thoughts and feelings about hearing loss. Please replace the word 'frustration' with thoughts and feelings about your hearing loss that bother you the most.",
      "aaq_ahl_1": "I am leading a full life, despite my frustration with hearing loss.",
      "aaq_ahl_2": "My life is going well, despite negative thoughts and feelings about my hearing loss.",
      "aaq_ahl_3": "My frustration with hearing loss has made me less involved in activities I enjoy.",
      "aaq_ahl_4": "I wish I could control negative thoughts and feelings about my hearing loss.",
      "aaq_ahl_5": "Frustration with hearing loss does not interfere with my goals.",
      "aaq_ahl_6": "Despite negative thoughts and feelings about my hearing loss, I can still take care of my responsibilities.",
      "aaq_ahl_7": "I struggle to get things done because of my frustration with hearing loss.",
      "aaq_ahl_8": "I need to manage negative thoughts about my hearing loss to have control over my life.",
      "aaq_ahl_9": "My negative thoughts and feelings about my hearing loss lead me to avoid situations.",
      "aaq_ahl_10": "I worry about what others think of my hearing loss.",
      "aaq_ahl_11": "I spend a lot of time thinking how things would be for me without hearing loss.",
      "aaq_ahl_12": "Frustration with my hearing loss keeps me from effectively treating and managing it."
    }
  }
