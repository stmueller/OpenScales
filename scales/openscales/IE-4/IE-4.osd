{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "IE-4",
      "name": "Internal–External Locus of Control Short Scale–4 (IE-4)",
      "abbreviation": "IE-4",
      "description": "4-item English-language adaptation measuring locus of control via two 2-item subscales: internal locus of control and external locus of control. All items positively keyed. Subscale score is the mean of its two items; a total across subscales is not recommended.",
      "citation": "Nießen, D., Schmidt, I., Groskurth, K., Rammstedt, B., & Lechner, C. M. (2022). Internal–External Locus of Control Short Scale–4 (IE-4). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis323_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis323_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Kovaleva-Beierlein-Kemper-Rammstedt-Internal-External-Locus-of-Control-Short-Scale-4-(IE-4)",
      "version": "1.0",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English-language adaptation (Nießen et al.) of the German IE-4 (Kovaleva et al., 2014). 5-point apply scale. All items positively keyed within their subscale. Score each subscale as the mean of its two items; a TOTAL across subscales is explicitly not recommended. Metrically invariant UK-Germany."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "question_head": "ie_4_inst",
