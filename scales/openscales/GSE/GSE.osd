    "ar": {
      "gse1": "أستطيع دائماً حل المشاكل الصعبة إذا أجهدت نفسي بما فيه الكفاية.",
      "gse2": "إذا عارضني شخص ما، أستطيع إيجاد طرق ووسائل لتحقيق ما أبتغيه.",
      "gse3": "يسهل عليّ تحقيق أهدافي ونواياي.",
      "gse4": "إذا واجهت مواقف غير متوقعة، أعرف دائماً كيف أتصرف فيها.",
      "gse5": "أعتقد بأنني قادر على معالجة المشاكل بشكل جيد حتى ولو كانت مفاجئة.",
      "gse6": "عندما أُحبس أمام مشكلة ما، أعرف كيف أتخلص منها بسهولة، لأنني أملك أفكاراً عديدة تساعدني على حلها.",
      "gse7": "أنظر إلى المصاعب بنفس هادئة برباطة جأش، وذلك لاعتمادي الدائم على قدراتي الذاتية.",
      "gse8": "أجد حلاً لكل مشكلة تواجهني.",
      "gse9": "عندما أواجه مشكلة جديدة، أعرف كيف أتعامل معها.",
      "gse10": "لا يعنين ما يحدث لي من مشاكل على الإطلاق لأنني أستطيع التخلص منها بكل بساطة.",
