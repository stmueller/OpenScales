{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Warwick-Edinburgh Mental Well-being Scale",
      "code": "WEMWBS",
      "abbreviation": "WEMWBS",
      "version": "1.0",
      "description": "Unidimensional scale measuring mental well-being across hedonic and eudaimonic dimensions. All items are positively worded, covering positive affect, satisfying interpersonal relationships, and positive functioning. Respondents rate each statement over the past 2 weeks. Full version (WEMWBS): 14 items, score 14–70. Short version (SWEMWBS): 7 items, score 7–35. Higher scores indicate greater well-being. Select version via the 'version' parameter.",
      "citation": "Tennant, R., Hiller, L., Fishwick, R., Platt, S., Joseph, S., Weich, S., Parkinson, J., Secker, J., & Stewart-Brown, S. (2007). The Warwick-Edinburgh Mental Well-being Scale (WEMWBS): Development and UK validation. Health and Quality of Life Outcomes, 5, 63. https://doi.org/10.1186/1477-7525-5-63",
      "license": "CC BY 2.0",
      "license_url": "https://link.springer.com/article/10.1186/1477-7525-5-63",
      "url": "https://warwick.ac.uk/services/innovations/wemwbs",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-18",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": [
      {
        "id": "version",
        "type": "choice",
        "default": "full",
        "choices": ["full", "short"],
        "label": "Version",
        "description": "full = WEMWBS (14 items); short = SWEMWBS (7 items)"
      }
    ],
    "variants": {
      "axes": [
        {
          "id": "version",
          "parameter": "version",
          "sets": ["full", "short"]
        }
      ],
      "sets": {
        "full": {
          "name": "WEMWBS (14-item)",
          "items": ["wemwbs1","wemwbs2","wemwbs3","wemwbs4","wemwbs5","wemwbs6","wemwbs7","wemwbs8","wemwbs9","wemwbs10","wemwbs11","wemwbs12","wemwbs13","wemwbs14"]
        },
        "short": {
          "name": "SWEMWBS (7-item)",
          "items": ["wemwbs1","wemwbs2","wemwbs3","wemwbs6","wemwbs7","wemwbs9","wemwbs11"]
        }
      },
      "default": "full"
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "wemwbs_r1",
        "wemwbs_r2",
        "wemwbs_r3",
        "wemwbs_r4",
        "wemwbs_r5"
      ],
      "question_head": "wemwbs_inst"
    },
    "dimensions": [
      {
        "id": "wemwbs",
        "name": "Mental Well-being",
        "abbreviation": "MWB",
        "description": "Sum of all administered items. WEMWBS: range 14–70; SWEMWBS: range 7–35. Higher scores indicate greater mental well-being."
      }
    ],
    "items": [
      {
        "id": "wemwbs1",
        "text_key": "wemwbs1",
        "type": "likert",
        "dimension": "wemwbs"
      },
