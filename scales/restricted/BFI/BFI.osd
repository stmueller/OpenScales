{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Big Five Inventory-2",
      "code": "BFI",
      "abbreviation": "BFI-2",
      "description": "A 44-item measure of the Big Five personality traits (Extraversion, Agreeableness, Conscientiousness, Neuroticism, Openness) using short trait-descriptive phrases. Items use a 5-point scale (1=disagree strongly to 5=agree strongly). Several items are reverse-scored. Widely used in personality research across cultures. Originally developed in English; Swahili translation from Garrashi et al. (2023).",
      "citation": "John, O. P., Donahue, E. M., & Kentle, R. L. (1991). The Big Five Inventory—Versions 4a and 54. University of California, Berkeley, Institute of Personality and Social Research.",
      "license": "Non-commercial research use; freely available from Berkeley Personality Lab",
      "license_url": "https://www.ocf.berkeley.edu/~johnlab/bfi.html",
      "url": "https://www.ocf.berkeley.edu/~johnlab/bfi.html",
      "domain": "Personality",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English items from John et al. (1991), freely available for non-commercial research use from Berkeley Personality Lab. Swahili translation (sw) from Garrashi, H. H., Barelds, D. P. H., & De Raad, B. (2023), published CC BY 4.0 in Measurement Instruments for the Social Sciences, https://doi.org/10.5964/miss.11207. Reverse-scored items: E2R(2), E5R(5), E7R(7); A1R(6), A3R(8), A6R(23); C2R(13), C4R(25), C5R(35); N2R(12), N4R(22), N8R(40); O3R(20), O6R(33), O8R(44). Standard BFI item numbering 1-44. Swahili item order in Garrashi et al. (2023) appendix differs from standard English order; items here are in standard English order (1-44) with Swahili matched by English content."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": ["bfi_r1", "bfi_r2", "bfi_r3", "bfi_r4", "bfi_r5"],
      "question_head": "bfi_qhead"
    },
    "dimensions": [
      {
        "id": "extraversion",
        "name": "Extraversion",
        "abbreviation": "E",
        "description": "Tendency toward sociability, assertiveness, and positive emotionality. Mean of 8 items (items 1,6,11,16,21,26,31,36; items 2,5,7 reverse-scored within set). Range 1–5."
      },
      {
        "id": "agreeableness",
        "name": "Agreeableness",
        "abbreviation": "A",
        "description": "Tendency toward cooperativeness, trust, and altruism. Mean of 9 items (items 2,7,12,17,22,27,32,37,42; items 6,8,23 reverse-scored within set). Range 1–5."
      },
      {
        "id": "conscientiousness",
        "name": "Conscientiousness",
        "abbreviation": "C",
        "description": "Tendency toward organization, dependability, and self-discipline. Mean of 9 items (items 3,8,13,18,23,28,33,38,43; items 13,25,35 reverse-scored within set). Range 1–5."
      },
      {
        "id": "neuroticism",
        "name": "Neuroticism",
        "abbreviation": "N",
        "description": "Tendency toward negative emotionality, anxiety, and moodiness. Mean of 8 items (items 4,9,14,19,24,29,34,39; items 12,22,40 reverse-scored within set). Range 1–5."
      },
      {
        "id": "openness",
        "name": "Openness",
        "abbreviation": "O",
        "description": "Tendency toward intellectual curiosity, creativity, and aesthetic sensitivity. Mean of 10 items (items 5,10,15,20,25,30,35,40,41,44; items 20,33,44 reverse-scored within set). Range 1–5."
      }
    ],
    "items": [
      {"id": "bfi1",  "type": "likert", "text_key": "bfi1",  "dimension": "extraversion"},
      {"id": "bfi2",  "type": "likert", "text_key": "bfi2",  "dimension": "agreeableness",    "reverse": true},
      {"id": "bfi3",  "type": "likert", "text_key": "bfi3",  "dimension": "conscientiousness"},
      {"id": "bfi4",  "type": "likert", "text_key": "bfi4",  "dimension": "neuroticism"},
