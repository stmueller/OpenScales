{
  "scale_info": {
    "name": "Self-reported Craving - Specific - Marijuana",
    "code": "PX520304",
    "abbreviation": "PX520304",
    "description": "The Marijuana Craving Questionnaire - Short Form (MCQ-SF) consists of 12 statements about the respondent’s feelings and thoughts about smoking marijuana as he or she is completing the questionnaire (i.e., right now).",
    "domain": "Substance Use - Acute Response",
    "citation": "Rosenberg, H. (2009) Clinical and laboratory assessment of the subjective experience of drug craving. Clinical Psychology Review, 29 (6), 519-534. [PhenX: https://www.phenxtoolkit.org/protocols/view/520304]",
