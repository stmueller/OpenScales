  "translations": {
    "en": {
      "pis_inst": "How frequently do you experience the following thoughts, feelings, and behaviors?",
      "pis_01": "When I speak about [PARTY], I usually say \"we\" instead of \"they\".",
      "pis_02": "I am interested in what other people think about [PARTY].",
      "pis_03": "When people criticize [PARTY], it feels like a personal insult.",
      "pis_04": "I have a lot in common with other supporters of [PARTY].",
      "pis_05": "If [PARTY] does badly in opinion polls, my day is ruined.",
      "pis_06": "When I meet someone who supports [PARTY], I feel connected.",
      "pis_07": "When I speak about [PARTY], I refer to them as \"my party\".",
      "pis_08": "When people praise [PARTY], it makes me feel good.",
      "pis_r1": "Never/Rarely",
      "pis_r2": "Sometimes",
      "pis_r3": "Often",
      "pis_r4": "Always",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
