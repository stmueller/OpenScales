  "translations": {
    "en": {
      "proc_qhead": "Please indicate how true each of the following statements is for you.",
      "proc_r1": "not at all true",
      "proc_r2": "barely true",
      "proc_r3": "moderately true",
      "proc_r4": "exactly true",
      "proc1": "It is often days before I get around to doing things that I wanted to do right away.",
      "proc2": "I begin each day with a clear picture of what I want to achieve for that day.",
      "proc3": "I frequently complete tasks earlier than is required.",
      "proc4": "I often take on things which I then end up not doing.",
      "proc5": "When it comes to putting my plans into action I am disciplined.",
      "proc6": "Tasks that still have not been completed worry me.",
      "proc7": "I manage to organize my day in such a way that by evening I feel I have carried out the most important jobs.",
      "proc8": "I don't allow the most important things in my life to become \"buried\" in everyday stress.",
      "proc9": "I often have a guilty conscience because I know that I put things off.",
      "proc10": "If I have written a letter, it can sometimes be lying around for days before I mail it.",
      "LANGUAGE": "English"
    },
    "de": {
      "proc_qhead": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "proc_r1": "stimmt nicht",
      "proc_r2": "stimmt kaum",
      "proc_r3": "stimmt eher",
      "proc_r4": "stimmt genau",
      "proc1": "Ich komme oft erst nach Tagen dazu, Dinge zu tun, die ich eigentlich sofort erledigen wollte.",
      "proc2": "Ich beginne jeden Tag mit einer klaren Vorstellung davon, was ich schaffen will.",
      "proc3": "Oft erledige ich Aufgaben früher als nötig.",
      "proc4": "Ich nehme mir oft Dinge vor, die ich dann doch nicht tue.",
      "proc5": "Wenn es darum geht, meine Pläne in die Tat umzusetzen, bin ich diszipliniert.",
      "proc6": "Mir wachsen all die Dinge, die noch unerledigt sind, über den Kopf.",
      "proc7": "Es gelingt mir, meinen Tag so zu organisieren, daß ich abends das Gefühl habe, alles Wichtige erledigt zu haben.",
      "proc8": "Ich lasse die für mein Leben wirklich bedeutsamen Tätigkeiten nicht im Alltagsstress untergehen.",
      "proc9": "Ich habe oft ein schlechtes Gewissen, weil ich wichtige Dinge vor mir herschiebe.",
      "proc10": "Wenn ich einen Brief geschrieben habe, kommt es vor, daß er tagelang herumliegt, bevor ich ihn einstecke.",
      "LANGUAGE": "Deutsch"
    }
  }
}