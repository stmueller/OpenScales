  "translations": {
    "en": {
      "5dcr_inst": "Below you will find statements that people often use to describe themselves. Please use the scale below to indicate the extent to which these statements accurately describe you. There are no right or wrong answers.",
      "5dcr01": "I view challenging situations as an opportunity to grow and learn.",
      "5dcr02": "I seek out situations where it is likely that I will have to think in depth about something.",
      "5dcr03": "I enjoy learning about subjects that are unfamiliar to me.",
      "5dcr04": "I find it fascinating to learn new information.",
      "5dcr05": "Thinking about solutions of difficult conceptual problems can keep me awake at night.",
      "5dcr06": "I can spend hours on a single problem because I just can't rest without knowing the answer.",
      "5dcr07": "I feel frustrated if I can't figure out the solution to a problem, so I work even harder to solve it.",
      "5dcr08": "I work relentlessly at problems that I feel must be solved.",
      "5dcr09": "The smallest doubt can stop me from seeking out new experiences.",
      "5dcr10": "I cannot handle the stress that comes from entering uncertain situations.",
      "5dcr11": "I find it hard to explore new places when I lack confidence in my abilities.",
      "5dcr12": "It is difficult to concentrate when there is a possibility that I will be taken by surprise.",
      "5dcr13": "I like finding out why people behave the way they do.",
      "5dcr14": "I ask a lot of questions to figure out what interests other people.",
      "5dcr15": "When talking to someone who is excited, I am curious to find out why.",
      "5dcr16": "When talking to someone, I try to discover interesting details about them.",
      "5dcr17": "When other people are having a conversation, I like to find out what it's about.",
      "5dcr18": "When around other people, I like listening to their conversations.",
      "5dcr19": "When people quarrel, I like to know what's going on.",
      "5dcr20": "I seek out information about the private lives of people in my life.",
      "5dcr21": "Risk-taking is exciting to me.",
      "5dcr22": "When I have free time, I want to do things that are a little scary.",
      "5dcr23": "Creating an adventure as I go is much more appealing than a planned adventure.",
      "5dcr24": "I prefer friends who are excitingly unpredictable.",
      "5dcr_r1": "Does not describe me at all",
      "5dcr_r2": "Barely describes me",
      "5dcr_r3": "Somewhat describes me",
      "5dcr_r4": "Neutral",
      "5dcr_r5": "Generally describes me",
      "5dcr_r6": "Mostly describes me",
      "5dcr_r7": "Completely describes me",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}