    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_V13": "Ne delim lako svoja osećanja s drugim ljudima.",
      "ipip_V68": "Volim da se ističem u društvu.",
      "ipip_V206": "Nemam nikakvih planova za narednih pet godina.",
      "ipip_V236": "Članovi mog tima ili grupe imaju moju podršku.",
      "ipip_V211": "Nemam mnogo energije.",
      "ipip_V161": "Smatram da sam marljiva osoba.",
      "ipip_V42": "Verujem da se drugim ljudima sviđam zato što sam skroman.",
      "ipip_V17": "Spreman sam da preuzmem rizik kako bih uspostavio vezu sa nekim.",
      "ipip_V103": "Ponašam se čudno i neuobičajno.",
      "ipip_V245": "Osećam zahvalnost za ono što sam u životu dobio.",
      "ipip_V75": "Oduševim se kada naučim nešto novo.",
      "ipip_V340": "Teško mi je da prihvatim ljubav od bilo koga.",
      "ipip_V182": "Radujem se svakom novom danu.",
      "ipip_V54": "Teško mi je da navedem druge da sarađuju.",
      "ipip_V20": "Priznajem kad nisam u pravu.",
      "ipip_V262": "Ljudi retko trraže savete od mene.",
      "ipip_V177": "U toku poslednjih 24 sata proveo sam bar 30 minuta u molitvi ili meditaciji.",
      "ipip_V252": "Nestrpljiv sam kada treba da počnem neki posao.",
      "ipip_V192": "Nisam dobar u shvatanju šta je zaista važno.",
      "ipip_V342": "Imam samo nekoliko interesovanja.",
      "ipip_V35": "Trudim se da se svi u mojoj grupi osećaju prihvaćeno.",
      "ipip_V95": "Umem da saslušam druge.",
      "ipip_V62": "Verujem u izreku \"bolje sprečiti nego lečiti\".",
      "ipip_V67": "Uvek se zanimam nečim interesantnim.",
      "ipip_V11": "Često sam ostajao pri svome uprkos snažnom protivljenju.",
      "ipip_V29": "Izbegavam neprijatne emocije.",
      "ipip_V130": "Ne izražavam svoje mišljenje kada nije poželjno.",
      "ipip_V12": "Ne odustajem od zadatka dok ga ne završim do kraja.",
      "ipip_V76": "Nije zabavno družiti se sa mnom.",
      "ipip_V33": "Imam puno sreće u životu.",
      "ipip_V59": "Ne mogu da odolim slatkišima kada su mi pri ruci.",
      "ipip_V72": "Nikada ne zaboravljam loše stvari koje su mi drugi učinili.",
      "ipip_V126": "Završim stvari bez obzira na prepreke na putu.",
      "ipip_V8": "Imam širok pogled na stvari koje se dešavaju.",
      "ipip_V240": "Mogu uvek da kažem ,,E sad je dosta\".",
      "ipip_V48": "Trudim se da razveselim svoje prijatelje kada su loše raspoloženi.",
      "ipip_V257": "Šta god da radim, odmeravam razloge za i protiv.",
      "ipip_H2016": "Uživam da budem deo grupe.",
      "ipip_V298": "Usprotivim se kada čujem da neko priča ružne stvari.",
      "ipip_V275": "Ispunjavam svoje obaveze u poslednjem trenutku.",
      "ipip_V38": "Ne volim da učim nove stvari.",
      "ipip_V288": "Smatram sebe mudrom osobom.",
      "ipip_V299": "Mislim da nije bitno družiti se s drugima.",
      "ipip_V60": "Umem se rastužiti razmišljanjem o dobrobiti drugih.",
      "ipip_V238": "Osećam se kao uljez.",
      "ipip_V132": "Najbolje radim sam.",
      "ipip_V155": "Lako smišljam nove načine za obavljanje nečega.",
      "ipip_V28": "Gledam na stvari s vedrije strane.",
      "ipip_H186": "Prema svima se ophodim na isti način.",
      "ipip_V239": "Kažu mi da sam strog, ali pravedan kao vođa.",
      "ipip_V248": "Ima malo stvari na kojima treba da budem zahvalan.",
      "ipip_V157": "Znam šta može da pokrene druge ljude.",
      "ipip_V307": "Verujem da svako treba da ima pravo da izrazi svoje mišljenje.",
      "ipip_V64": "Ne ide mi dobro završavanje započetog.",
      "ipip_V234": "Umem da pokažem ljubav prema drugoj osobi.",
      "ipip_H1144": "Lako odustajem.",
      "ipip_V49": "Često ne završim ono što započnem.",
      "ipip_V228": "Mogu da se suočim sa svojim strahovima.",
      "ipip_V44": "Često izgubim iz vida šta je najvažnije u životu.",
      "ipip_V37": "Nikada mi nije dosadno.",
      "ipip_V289": "Mislim da je moj život jako zanimljiv.",
      "ipip_V304": "Poznajem nekoga do koga mi je lično veoma stalo.",
      "ipip_V292": "Trudim se da nađem dobro opravdanje za važne odluke koje donesem.",
      "ipip_V253": "Ne verujem u izreku \"oko za oko, zub za zub\".",
      "ipip_V223": "Čvrsto verujem u to da stvari treba promisliti.",
      "ipip_V133": "Ne pristupam stvarima polovično.",
      "ipip_V272": "Telefoniram prijateljima kad su bolesni.",
      "ipip_V2": "Uložim veliki trud kako bih prisustvovao obrazovnim događajima.",
      "ipip_V311": "Pažljiv sam kad nešto biram.",
      "ipip_V5": "Sposoban sam da smislim nove i drugačije ideje.",
      "ipip_V21": "Slažem se sa izrekom: \"Što je bilo, bilo je\".",
      "ipip_V259": "Imam bujniju maštu od svojih prijatelja.",
      "ipip_H427": "Često iskorišćavam druge ljude.",
      "ipip_V27": "Ne izostajem sa grupnih sastanaka ili timskih vežbi.",
      "ipip_V291": "Čitam raznovrsnu literaturu.",
      "ipip_V286": "Jedva čekam da vidim šta će mi se desiti u budućnosti.",
      "ipip_V180": "Gledam da sve što radim ''začinim'' humorom.",
      "ipip_V40": "Trudim se da ne činim usluge drugima.",
      "ipip_V108": "Usmeren sam ka ciljevima.",
