      "ipip_X109": "Avoid difficult reading material.",
      "ipip_H1392": "Will not probe deeply into a subject.",
      "ipip_H225": "Inquire about others' well-being.",
      "ipip_H557": "Show my gratitude.",
      "ipip_H823": "Leave my belongings around.",
      "ipip_H927": "Am easily disturbed.",
      "ipip_H920": "Take offense easily."
    },
    "hr": {
      "_translator": "Zvjezdan Penezić (University of Zadar, Croatia); machine translation",
      "ipip_likert_4": "Uglavnom točno",
      "ipip_likert_1": "Posve netočno",
      "ipip_likert_2": "Uglavnom netočno",
      "ipip_debrief": "Hvala vam na sudjelovanju.",
      "ipip_question_head": "<h3>Koliko točno možete opisati sebe?</h3><p>Na sljedećim stranicama nalaze se tvrdnje koje opisuju uobičajeno ponašanje ljudi. Molimo vas da, koristeći se priloženom ljestvicom, procijenite koliko pojedini iskaz vjerno opisuje baš vas.</p>",
      "ipip_likert_5": "Posve točno",
      "ipip_likert_3": "Ni točno ni netočno",
      "ipip_H592": "Teško pristupam drugima.",
      "ipip_H334": "Preuzimam odgovornost.",
      "ipip_H1322": "Mogu baratati mnoštvom informacija.",
      "ipip_H1351": "Sve radim prema planu.",
      "ipip_H126": "Prvo mislim na druge.",
      "ipip_H1227": "Podižem raspravu na višu razinu.",
      "ipip_X14": "Imam živu maštu.",
      "ipip_X68": "Ne volim privlačiti pažnju.",
      "ipip_X74": "Često sam potišten.",
      "ipip_X165": "Drugi me zapravo i ne zanimaju.",
      "ipip_E141": "Uglavnom sam opušten.",
      "ipip_H822": "Ostavljam nered u svojoj sobi.",
      "ipip_X211": "Volim čitati izazovne sadržaje.",
      "ipip_X275": "Brzo shvaćam.",
      "ipip_H1146": "Prikrivam svoje osjećaje.",
      "ipip_X203": "Ravnodušan sam prema tuđim osjećajima.",
      "ipip_X244": "Ne brinem se puno za druge ljude.",
      "ipip_X118": "Volim red.",
      "ipip_H107": "Nastojim da se drugi osjećaju ugodno.",
      "ipip_H286": "Nastavljam s poslom dok sve nije savršeno.",
      "ipip_X73": "Volim djecu.",
      "ipip_X225": "Volim domišljati nove načine kako nešto učiniti.",
      "ipip_H976": "Čekam da drugi preuzmu vodstvo.",
      "ipip_X177": "Imam meko srce.",
      "ipip_H1110": "Znam kako osvojiti ljude.",
      "ipip_H909": "Često se osjećam neugodno kada sam u društvu.",
      "ipip_H1467": "Unosim zbrku.",
      "ipip_H1189": "Zanemarujem svoje dužnosti.",
      "ipip_H1171": "Teško mi je prihvatiti se posla.",
      "ipip_H1246": "Dobar (dobra) sam u nizu područja.",
      "ipip_H1140": "Izbjegavam obaveze.",
      "ipip_E171": "Trudim se izbjeći intelektualne tipove.",
      "ipip_X107": "Lako se uznemirim.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_X179": "Slijedim zacrtani plan.",
      "ipip_X87": "Uvijek sam pripravan.",
      "ipip_H244": "Volim pospremati.",
      "ipip_H927": "Lako me zasmetati.",
      "ipip_X82": "Često zaboravljam vratiti stvari na njihovo mjesto.",
      "ipip_X78": "Ne smeta me biti u središtu pažnje.",
      "ipip_X231": "Rijetko se razbjesnim.",
      "ipip_H34": "Unosim živost u svaku zabavu.",
      "ipip_H754": "Lako se razljutim.",
      "ipip_X156": "Rijetko sam tužan.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_H612": "Lako se osjetim ugroženim.",
      "ipip_X138": "Malo što mi smeta.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H22": "Za svakoga imam lijepu riječ.",
      "ipip_X265": "Rijetko se iznerviram.",
      "ipip_H661": "Šutljiv(a) sam s nepoznatima.",
      "ipip_H1276": "Imam bogat rječnik.",
      "ipip_H1272": "Koristim učene izraze.",
      "ipip_X114": "Provodim vrijeme razmišljajući o stvarima.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X163": "Posao obavljam točno i precizno.",
      "ipip_X112": "Ugodno se osjećam među ljudima.",
      "ipip_H1103": "Vrijeđam ljude.",
      "ipip_H1392": "Ni u što se previše ne zadubljujem.",
      "ipip_H37": "U dobrim sam odnosima s gotovo svima.",
      "ipip_H950": "Preplavljuju me osjećaji.",
      "ipip_X83": "Na zabavama razgovaram s mnogo različitih ljudi.",
      "ipip_X100": "Brzo shvaćam različite stvari.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_H761": "Lako se uzrujam.",
      "ipip_X263": "Držim se planova koje sam zacrtao.",
      "ipip_H1130": "Suosjećam s drugima.",
      "ipip_H309": "Volim red i točnost.",
      "ipip_H173": "Znam kako utješiti druge.",
      "ipip_H920": "Lako se uvrijedim.",
      "ipip_H1": "Osjećam se opušteno s ljudima.",
      "ipip_H1366": "Vješto se snalazim u društvenim situacijama.",
      "ipip_H21": "Zanimaju me drugi ljudi.",
      "ipip_H1382": "Teško zamišljam stvari.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_H160": "Posvećujem vrijeme drugim ljudima.",
      "ipip_E119": "Odmah obavljam svakodnevne poslove.",
      "ipip_H16": "Prvi započinjem razgovore.",
      "ipip_X176": "Teško razumijem apstraktne ideje.",
      "ipip_H926": "Često mijenjam raspoloženja.",
      "ipip_H1313": "Imam izvrsne ideje.",
      "ipip_X120": "Zaokupe me moji problemi.",
      "ipip_X272": "Nisam maštovit.",
      "ipip_H589": "Vrlo sam povučena osoba.",
      "ipip_H53": "Pun(a) sam ideja.",
      "ipip_H1186": "Tratim svoje vrijeme.",
      "ipip_X109": "Izbjegavam čitanje složenih sadržaja.",
      "ipip_H1108": "Volim pomagati drugima.",
      "ipip_E92": "Često mijenjam raspoloženja.",
      "ipip_H1039": "Imam malo toga reći.",
      "ipip_H1133": "Gunđam.",
      "ipip_H1413": "Poslove obavljam polovično.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H225": "Zanimam se za dobrobit drugih ljudi.",
      "ipip_H557": "Pokazujem svoju zahvalnost.",
      "ipip_H948": "Lako se uspaničim.",
      "ipip_H823": "Ostavljam stvari uokolo.",
      "ipip_E136": "Osjećam tuđe emocije.",
      "ipip_H154": "Držim se po strani.",
      "ipip_H1157": "Zabrinut sam."
    },
    "sl": {
      "_translator": "Boele De Raad & Marko Mlacic (Slovenia); machine translation",
      "ipip_likert_4": "Dokaj točno",
      "ipip_likert_1": "Zelo netočno",
      "ipip_likert_2": "Dokaj netočno",
      "ipip_debrief": "Hvala, ker ste izpolnili ta vprašalnik.",
      "ipip_question_head": "<h3>Kako natančno se lahko opišete?</h3><p>Na naslednjih straneh so trditve, ki opisujejo vedenje ljudi. S pomočjo spodnje lestvice ocenite, kako natančno vsaka trditev opisuje vas. Opišite se, kakršni ste na splošno zdaj, ne kakršni bi želeli biti v prihodnosti. Vaši odgovori bodo ostali zaupni.</p>",
      "ipip_likert_5": "Zelo točno",
      "ipip_likert_3": "Niti točno niti netočno",
      "ipip_H592": "Težko pristopim k drugim.",
      "ipip_H334": "Zavzamem se za stvari.",
      "ipip_H1322": "Lahko delam z veliko podatki.",
      "ipip_H1351": "Stvari delam načrtno.",
      "ipip_H126": "Najprej pomislim na druge.",
      "ipip_H1227": "Rad preusmerim pogovor na zahtevnejšo raven.",
      "ipip_X14": "Imam bogato domišljijo.",
      "ipip_X68": "Nerad zbujam pozornost.",
      "ipip_X74": "Pogosto sem otožen.",
      "ipip_X165": "Nisem ravno zainteresiran za druge.",
      "ipip_E141": "Večino časa sem sproščen.",
      "ipip_H822": "V svoji sobi imam nered.",
      "ipip_X211": "Rad berem tekste, ki so mi v izziv.",
      "ipip_X275": "Stvari hitro dojemam.",
      "ipip_H1146": "Potlačujem svoja čustva.",
      "ipip_X203": "Brezbrižen sem do čustev drugih.",
      "ipip_X244": "Ne skrbi me za druge.",
      "ipip_X118": "Rad imam red.",
      "ipip_H107": "Ob meni se ljudje počutijo sproščeni.",
      "ipip_H286": "Ne končam, preden ni vse popolno.",
      "ipip_X73": "Rad imam otroke.",
      "ipip_X225": "Rad se domislim novih načinov, kako delati stvari.",
      "ipip_H976": "Čakam na druge, da prevzamejo vodstvo.",
      "ipip_X177": "Sem »mehkega srca«.",
      "ipip_H1110": "Znam pridobiti ljudi.",
      "ipip_H909": "Pogosto se počutim nelagodno v družbi.",
      "ipip_H1467": "Povzročam zmešnjavo.",
      "ipip_H1189": "Zanemarjam svoje dolžnosti.",
      "ipip_H1171": "Težko se spravim k delu.",
      "ipip_H1246": "Dober sem v mnogih stvareh.",
      "ipip_H1140": "Izmikam se dolžnostim.",
