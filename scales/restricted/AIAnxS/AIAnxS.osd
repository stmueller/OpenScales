{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Artificial Intelligence Anxiety Scale",
      "code": "AIAnxS",
      "abbreviation": "AIAnxS",
      "description": "21-item measure of anxiety toward artificial intelligence (Wang & Wang), with four factors: Learning (8 items), Job Replacement (6 items), Sociotechnical Blindness (4 items), and AI Configuration (3 items). Items are rated 1-7; subscales are averaged and the total is summed (21-147), with higher scores indicating greater AI anxiety. Includes the original English and a validated German translation.",
      "citation": "Wang, Y.-Y., & Wang, Y.-S. (2022). Development and validation of an artificial intelligence anxiety scale: An initial application in predicting motivated learning behavior. Interactive Learning Environments, 30(4), 619-634. https://doi.org/10.1080/10494820.2019.1674887",
      "license": "CC BY-NC-ND 4.0",
      "license_explanation": "The original English AIAS (Wang & Wang, 2019/2022, Interactive Learning Environments) is Open Access under the Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 License (CC BY-NC-ND 4.0): it permits non-commercial re-use, distribution, and reproduction in any medium, provided the original work is properly cited and is not altered, transformed, or built upon. Because of the NonCommercial-NoDerivatives terms, this scale is held in the restricted collection (free for non-commercial research use). The German translation (de) is from Hajek et al. (2025), PLoS ONE, which is CC BY 4.0. Item text is reproduced verbatim and properly cited.",
      "license_url": "http://creativecommons.org/licenses/by-nc-nd/4.0/",
      "url": "https://doi.org/10.1080/10494820.2019.1674887",
      "version": "1.0",
      "domain": "Technology"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-16",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English items are the final 21-item set drawn from the original 57-item AIAS pool (Wang & Wang). Item IDs preserve the original pool's Q-codes; items are presented in factor order. Factor assignment per the published loadings: Learning = Q3,Q2,Q5,Q4,Q6,Q1,Q8,Q7; Job Replacement = Q16,Q17,Q18,Q15,Q11,Q9; Sociotechnical Blindness = Q45,Q46,Q44,Q47; AI Configuration = Q29,Q30,Q32. Subscales scored as means (1-7); total scored as the sum of all 21 items (21-147), matching the published total range. No reverse-coded items. Bilingual: English (en) from Wang & Wang (CC BY-NC-ND 4.0); German (de) from Hajek et al. (2025), PLoS ONE (CC BY 4.0), mapped 1:1 to the same items by factor order. Merged into a single restricted scale (NC-ND on the English items). Response numbers suppressed; endpoint anchors carry their value (1 / 7)."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "likert_1",
        null,
        null,
        null,
        null,
        null,
        "likert_7"
      ],
      "question_head": "question_head"
    },
    "dimensions": [
      {
        "id": "learning",
        "name": "Learning",
        "description": "Anxiety about learning to use and understand AI techniques/products (items Q1-Q8)."
      },
      {
        "id": "job_replacement",
        "name": "Job Replacement",
        "description": "Anxiety that AI will replace humans, jobs, or autonomy (items Q9, Q11, Q15-Q18)."
      },
      {
        "id": "sociotechnical_blindness",
        "name": "Sociotechnical Blindness",
        "description": "Anxiety about AI misuse, malfunction, and loss of control (items Q44-Q47)."
      },
      {
        "id": "ai_configuration",
        "name": "AI Configuration",
        "description": "Anxiety toward humanoid AI/robots (items Q29, Q30, Q32)."
      }
    ],
