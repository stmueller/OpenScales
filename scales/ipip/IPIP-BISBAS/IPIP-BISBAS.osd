  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H905": "Am afraid that I will do the wrong thing.",
      "ipip_D96": "Am always worried about something.",
      "ipip_H987": "Am easily hurt.",
      "ipip_H959": "Become overwhelmed by events.",
      "ipip_Q50": "Begin to panic when there is danger.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_D71": "Often worry about things that turn out to be unimportant.",
      "ipip_D79": "Rarely worry.",
      "ipip_Q117": "Am eager to soothe hurt feelings.",
      "ipip_H572": "Don't get excited about things.",
      "ipip_R33": "Feel excited or happy for no apparent reason.",
      "ipip_A71": "Get caught up in the excitement when others are celebrating.",
      "ipip_R43": "Get so happy or energetic that I am almost giddy.",
      "ipip_A13": "Rarely get caught up in the excitement.",
      "ipip_P462": "Am not an extraordinary person.",
      "ipip_X110": "Am not highly motivated to succeed.",
      "ipip_P434": "Hate being the center of attention.",
      "ipip_P445": "Have a strong need for power.",
      "ipip_H1327": "Know how to get around the rules.",
      "ipip_P474": "Like to show off my body.",
      "ipip_Q204": "Push myself very hard to succeed.",
      "ipip_H334": "Take charge.",
      "ipip_H1193": "Try to surpass others' accomplishments.",
      "ipip_H793": "Want to be in charge.",
      "ipip_X3": "Am willing to try anything once.",
      "ipip_H870": "Do crazy things.",
      "ipip_E35": "Enjoy being reckless.",
      "ipip_R58": "Have persuaded others to do something really adventurous or crazy.",
      "ipip_E122": "Like to act on a whim.",
      "ipip_R5": "Prefer friends who are excitingly unpredictable.",
      "ipip_D75": "Rarely enjoy behaving in a silly manner.",
      "ipip_X242": "Am not embarrassed easily.",
      "ipip_P420": "Worry about what people think of me.",
      "ipip_H317": "Avoid dangerous situations.",
      "ipip_D58": "Like to behave spontaneously.",
      "ipip_X250": "Would never go hang gliding or bungee jumping."
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_P462": "Nisam izvanredna osoba.",
      "ipip_Q50": "Poćinjem da paničim kad sam u opasnosti.",
      "ipip_D96": "Uvek sam zabrinut oko nečega.",
      "ipip_P420": "Brinem o tome šta drugi misle o meni.",
      "ipip_H334": "Često preuzimam stvari na sebe.",
      "ipip_A13": "Retko me ponese uzbuđenje.",
      "ipip_X250": "Nikada ne bih išao na paraglajding ili bandži- džamping.",
      "ipip_D75": "Retko kad mi prija da se ponašam blesavo.",
      "ipip_H1327": "Znam kako da zaobiđem pravila.",
      "ipip_Q117": "Rado tešim druge kada su povređeni i pate.",
      "ipip_R43": "Nekad sam toliko srećan i energičan da ne mogu normalno da funkcionišem.",
      "ipip_H959": "Neki događaji me preopterete.",
      "ipip_D79": "Retko brinem.",
      "ipip_R5": "Preferiram prijatelje koji su uzbudljivo nepredvidivi.",
      "ipip_P445": "Imam snažnu potrebu za moći.",
      "ipip_A71": "Kada drugi nešto slave i mene ponese uzbuđenje.",
      "ipip_X110": "Nisam mnogo motivisan da uspem.",
      "ipip_X3": "Hoću sve da probam.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_E35": "Uživam da se ponašam bahato.",
      "ipip_H572": "Teško se oduševim.",
      "ipip_H317": "Izbegavam opasne situacije.",
      "ipip_D71": "Često brinem zbog stvari za koje se kasnije ispostavi da su nevažne",
      "ipip_E122": "Volim da radim stvari iz hira.",
      "ipip_Q204": "Mnogo se forsiram da bih postigao/la uspeh.",
      "ipip_H905": "Plaši me da ću učiniti nešto pogrešno.",
      "ipip_P474": "Volim da se ponosim lepotom svog tela.",
      "ipip_P434": "Mrzim da budem u centru pažnje.",
      "ipip_H793": "Želim da budem glavni.",
      "ipip_X242": "Ne postidim se lako.",
      "ipip_H1193": "Trudim se da nadmašim tuđi uspeh.",
      "ipip_H987": "Lako me je povrediti.",
      "ipip_D58": "Volim da se ponašam spontano.",
      "ipip_R33": "Osećam se uzbuđeno ili srećno bez nekog naročitog razloga.",
      "ipip_H870": "Često radim nešto ludo.",
      "ipip_R58": "Nagovarao sam druge da se upuste u avanturu ili ludost."
    }
  }
}
