  "translations": {
    "de": {
      "bfi10_inst": "Inwieweit treffen die folgenden Aussagen auf Sie zu?",
      "bfi10_01": "Ich bin eher zurückhaltend, reserviert.",
      "bfi10_02": "Ich schenke anderen leicht Vertrauen, glaube an das Gute im Menschen.",
      "bfi10_03": "Ich bin bequem, neige zur Faulheit.",
      "bfi10_04": "Ich bin entspannt, lasse mich durch Stress nicht aus der Ruhe bringen.",
      "bfi10_05": "Ich habe nur wenig künstlerisches Interesse.",
      "bfi10_06": "Ich gehe aus mir heraus, bin gesellig.",
      "bfi10_07": "Ich neige dazu, andere zu kritisieren.",
      "bfi10_08": "Ich erledige Aufgaben gründlich.",
      "bfi10_09": "Ich werde leicht nervös und unsicher.",
      "bfi10_10": "Ich habe eine aktive Vorstellungskraft, bin fantasievoll.",
      "bfi10_r1": "trifft überhaupt nicht zu",
      "bfi10_r2": null,
      "bfi10_r3": null,
      "bfi10_r4": null,
      "bfi10_r5": "trifft voll und ganz zu"
    },
    "en": {
      "bfi10_inst": "How well do the following statements describe your personality?",
      "bfi10_01": "I see myself as someone who is reserved.",
      "bfi10_02": "I see myself as someone who is generally trusting.",
      "bfi10_03": "I see myself as someone who tends to be lazy.",
      "bfi10_04": "I see myself as someone who is relaxed, handles stress well.",
      "bfi10_05": "I see myself as someone who has few artistic interests.",
      "bfi10_06": "I see myself as someone who is outgoing, sociable.",
      "bfi10_07": "I see myself as someone who tends to find fault with others.",
      "bfi10_08": "I see myself as someone who does a thorough job.",
      "bfi10_09": "I see myself as someone who gets nervous easily.",
      "bfi10_10": "I see myself as someone who has an active imagination.",
      "bfi10_r1": "disagree strongly",
      "bfi10_r2": null,
      "bfi10_r3": null,
      "bfi10_r4": null,
      "bfi10_r5": "agree strongly"
    }
