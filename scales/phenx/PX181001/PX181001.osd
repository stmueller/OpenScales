{
  "scale_info": {
    "name": "Social Isolation",
    "code": "PX181001",
    "abbreviation": "PX181001",
    "description": "The UCLA Loneliness Scale includes 20 questions used to assess how lonely the respondent feels. Each question begins with the statement \"How often do you feel . . . ,\" followed by a positive or negative description of social interactions with others. The respondent is asked to indicate the frequency",
    "domain": "Mental Health & Quality of Life",
    "citation": "Doane, L. D., & Adam, E. K. (2010). Loneliness and cortisol: Momentary, day-to-day, and trait associations. Psychoneuroendocrinology, 35, 430-441. Fox, C., Harper, A., Hyner, G., & Lyle, R. (1994). Loneliness, emotional repression, marital quality, and major life events in women who develop breast cancer. Journal of Community Health, 19, 467-482. Pressman, S. D., Cohen, S., Miller, G. E., Barkin, A., Rabin, B. S., & Treanor, J. J. (2005). Loneliness, social network size, and immune response to influenza vaccination in college freshmen. Health Psychology, 24, 297-306. Seeman, T. E. (2000). Health promoting effects of friends and family on health outcomes in older adults. American Journal of Health Promotion, 14, 362-370. [PhenX: https://www.phenxtoolkit.org/protocols/view/181001]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/181001"
  },
