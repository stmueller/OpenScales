  "translations": {
    "en": {
      "lk_1": "Never true",
      "lk_2": "Very seldom true",
      "lk_3": "Seldom true",
      "lk_4": "Sometimes true",
      "lk_5": "Frequently true",
      "lk_6": "Almost always true",
      "lk_7": "Always true",
      "question_head": "Below you will find a list of statements regarding experiences university students might have. Please rate how true each statement is for you.",
      "aaq_us_1": "I put off schoolwork when I feel bad.",
      "aaq_us_2": "It seems like I'm just 'going through the motions' at school.",
      "aaq_us_3": "I struggle with my thoughts about school.",
      "aaq_us_4": "I find myself avoiding going to classes when I feel anxious or depressed.",
      "aaq_us_5": "When I think an assignment is too hard or confusing, I give up.",
      "aaq_us_6": "It's hard for me to focus on what my professors are saying in classes.",
      "aaq_us_7": "I get so worried about upcoming exams that I feel paralyzed and can't study.",
      "aaq_us_8": "Worries get in the way of my success at school.",
      "aaq_us_9": "My thoughts and feelings get in the way of studying.",
      "aaq_us_10": "I don't get anything out of a class when I'm having negative thoughts.",
      "aaq_us_11": "I often believe that I'm not smart enough to be in college or in this major.",
      "aaq_us_12": "I get so caught up in my worries during tests that I have trouble focusing on the test itself."
    }
  }
