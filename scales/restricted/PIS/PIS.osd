{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "PIS",
      "name": "Partisan Identity Scale (PIS)",
      "abbreviation": "PIS",
      "description": "8-item English-language scale measuring partisan identity strength: the degree to which a voter identifies with a political party. Adapted from the Identification with a Psychological Group (IDPG) scale (Mael & Tetrick, 1992), it captures a subjective sense of group belonging, the affective importance of party membership, and the affective consequences of lowered group status. The party the respondent identifies with is inserted into each item. All items are positively keyed (no reverse items). A 4-item short form (items 3, 6, 7, 8) is available. The scale targets partisans only and is not meaningful for respondents with no party attachment.",
      "citation": "Bankert, A. & Huddy, L. (2019). Partisan Identity Scale (PIS). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis270",
      "license": "CC BY-NC-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
      "license_explanation": "Licensed CC BY-NC-SA 4.0 (Attribution-NonCommercial-ShareAlike 4.0 International) via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt for NON-COMMERCIAL purposes with attribution and under the same ShareAlike terms. Cite the ZIS documentation (https://doi.org/10.6102/zis270) and the original publication (Bankert & Huddy, 2019).",
      "url": "https://zis.gesis.org/skala/Bankert-Huddy-Partisan-Identity-Scale-(PIS)",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY-NC-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
      "notes": "Items transcribed from the ZIS documentation of the Partisan Identity Scale (Bankert & Huddy, 2019; zis270). Eight items presented in a randomized grid; the name of the party the respondent identifies with is inserted in place of 'this party' in each item. Response scale is 4 points: 1 = Never/Rarely, 2 = Sometimes, 3 = Often, 4 = Always (all anchors labeled; no unlabeled middle points). Scoring: the full-scale score is the unweighted mean of all 8 items; higher values indicate stronger partisan identity. A 4-item short form uses items 3, 6, 7, and 8 (also scored as their mean). All items are positively keyed; there are NO reverse-coded items. The scale is administered only to partisans (voters who feel attached or close to a party). Language coverage: English only (the source instrument provides item wordings in English only; otherLanguage is null in the ZIS record). The party reference is the [PARTY] parameter (default 'my political party'); set it per study to a specific party name. Items use [PARTY] in place of the original 'this party'."
    },
    "parameters": {
      "PARTY": {
        "type": "string",
        "default": "my political party",
        "description": "The political party the respondent identifies with. Substituted into the [PARTY] placeholders in the items; defaults to 'my political party'. Set it per study to a specific party name (e.g. 'the Labour Party')."
      }
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "labels": [
        "pis_r1",
        "pis_r2",
        "pis_r3",
        "pis_r4"
      ],
      "question_head": "pis_inst"
    },
    "dimensions": [
