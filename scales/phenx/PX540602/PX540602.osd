  "translations": {
    "en": {
      "opt_0": "Not true",
      "opt_1": "Somewhat true",
      "opt_2": "True",
      "opt_3": "Very true",
      "not_fearful_when_bad_happens": "I do not become fearful or nervous, even when something bad happens to me.",
      "do_everything_to_get_things": "I do everything to get the things that I want.",
      "like_to_keep_doing": "When I am doing well at something, I like to keep doing this.",
      "pxt540602_willing_to_try_something_new": "I am always willing to try something new, when I think it will be fun.",
      "excited_and_full_of_energy": "I feel excited and full of energy when I get something that I want.",
      "hurt_when_scolded": "I am hurt when people scold me or tell me that I do something wrong.",
      "go_all_the_way": "When I want something, I usually go all the way to get it.",
      "do_things_for_fun": "I often do things for no other reason than that they might be fun.",
      "go_for_opportunities_right_away": "When I see an opportunity to get something that I want, I go for it right away.",
      "upset_when_someone_is_angry": "I feel pretty upset when I think that someone is angry with me.",
      "excited_about_opportunity": "I get really excited when I see an opportunity to get something I like.",
      "spur_of_the_moment": "I often do things on the spur of the moment.",
      "tense_when_something_unpleasant_happens": "I usually get very tense when I think something unpleasant is going to happen.",
      "thrilled_when_good_things_happen": "I get thrilled when good things happen to me.",
      "worried_when_do_poorly": "I feel worried when I think I have done poorly at something.",
      "crave_for_excitement": "I crave for excitement and new sensations.",
      "nobody_can_stop_me": "Nobody can stop me when I want something.",
      "fearful_compared_to_my_friends": "I am very fearful compared to my friends.",
      "excited_about_winning_contest": "I get very excited when I would win a contest.",
      "pxt540602_worry_about_making_mistakes": "I worry about making mistakes.",
      "scoring_540602": "Scoring\n\n\n\nItems 1 and 18 are reverse-scored.\n\n\n\nAdd up the scores associated with each answer response to obtain scores for the individual subscales listed below.\n\n\n\n0= not true\n\n1= somewhat true\n\n2= true\n\n3= very true\n\n\n\nBAS Drive: 2, 7, 9, 17\n\n\n\nBAS Fun Seeking: 4, 8, 12, 16\n\n\n\nBAS Reward Responsiveness: 3, 5, 11, 14, 19\n\n\n\nBIS: 1, 6, 10, 13, 15, 18, 20"
    }
  }
}