      "ipip_X114": "Provodim vreme razmišljajući o stvarima.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_H1392": "Nisam sklon da se previše udubljujem u problem.",
      "ipip_H37": "U dobrim sam odnosima skoro sa svima.",
      "ipip_H950": "Često me preplave emocije.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_H761": "Lako se iznerviram.",
