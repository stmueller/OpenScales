{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "IPIP Big Five (20 items per domain)",
      "code": "IPIP-Big5-100",
      "abbreviation": "IPIP-100",
      "description": "100-item IPIP measure of the Big Five personality domains (20 items per domain). Domain-level scoring only. Follows Goldberg (1992) labels: Factor 4 is Emotional Stability (not Neuroticism), Factor 5 is Intellect/Imagination (not Openness to Experience). Higher scores on Emotional Stability indicate greater emotional stability.",
      "citation": "Goldberg, L. R. (1992). The development of markers for the Big-Five factor structure. Psychological Assessment, 4(1), 26-42. https://doi.org/10.1037/1040-3590.4.1.26",
      "license": "Public Domain",
      "version": "1.0",
      "url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-04-01",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "ipip_likert_1",
        "ipip_likert_2",
        "ipip_likert_3",
        "ipip_likert_4",
        "ipip_likert_5"
      ],
      "question_head": "ipip_question_head"
    },
    "parameters": {
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order within the scale."
      }
    },
