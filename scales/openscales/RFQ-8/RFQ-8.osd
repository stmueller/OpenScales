{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Reflective Functioning Questionnaire – 8 items",
      "code": "RFQ-8",
      "abbreviation": "RFQ-8",
      "description": "8-item self-report measure of mentalizing capacity, yielding two subscales: Certainty about Mental States (RFQ_C) and Uncertainty about Mental States (RFQ_U)",
      "citation": "Fonagy P, Luyten P, Moulton-Perkins A, Lee YW, Warren F, Howard S, et al. Development and validation of a self-report measure of mentalizing: The Reflective Functioning Questionnaire. PLOS ONE. 2016;11(7):e0158678. doi: 10.1371/journal.pone.0158678 ; https://doi.org/10.1371/journal.pone.0259030",
      "domain": "Personality",
      "license": "CC BY 4.0",
      "license_explanation": "RFQ items are published in open-access PLoS ONE articles under CC BY 4.0 and reproduced here with attribution: the RFQ validity study with supplemental item materials (https://doi.org/10.1371/journal.pone.0259030, PLOS figshare 'RFQ54 with self and other subscales') and the RFQ-8 short form (Fonagy et al., 2016, PLoS ONE 11(7): e0158678).",
      "license_url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0259030",
      "url": "https://www.ucl.ac.uk/psychoanalysis/research/reflective-functioning-questionnaire-rfq",
      "version": "1.0"
    },
    "items": [
      {
        "id": "q1",
        "type": "inst",
        "text_key": "instructions"
      },
      {
