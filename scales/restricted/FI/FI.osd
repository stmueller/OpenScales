  "translations": {
    "af": {
      "fi_01": "Algehele, hoe tevrede is jy met die lewe as 'n geheel deesdae?",
      "fi_rs_satisfied_r10": "Heeltemal tevrede met jou lewe",
      "fi_rs_satisfied_r0": "Glad nie tevrede met jou lewe nie",
      "fi_02": "Oor die algemeen, hoe gelukkig of ongelukkig voel jy gewoonlik?",
      "fi_rs_happy_r10": "Uiters gelukkig",
      "fi_rs_happy_r0": "Uiters ongelukkig",
      "fi_03": "Oor die algemeen, hoe sal jy jou fisiese gesondheid beoordeel?",
      "fi_rs_physical_r10": "Uitstekende fisiese gesondheid",
      "fi_rs_physical_r0": "Swak fisiese gesondheid",
      "fi_04": "Hoe sal jy jou algemene geestesgesondheid beoordeel?",
      "fi_rs_mental_r10": "Uitstekende geestesgesondheid",
      "fi_rs_mental_r0": "Swak geestesgesondheid",
      "fi_05": "In watter mate voel jy dat die dinge wat jy in jou lewe doen, die moeite werd is?",
      "fi_rs_worthwhile_r10": "Heeltemal die moeite werd",
      "fi_rs_worthwhile_r0": "Glad nie die moeite werd nie",
      "fi_06": "Ek verstaan my doel in die lewe.",
      "fi_rs_agree_r10": "Stem sterk saam",
      "fi_rs_agree_r0": "Sterk verskil",
      "fi_07": "Ek tree altyd op om goed in alle omstandighede te bevorder, selfs in moeilike en uitdagende situasies.",
      "fi_rs_trueme_r10": "Heeltemal waar van my",
      "fi_rs_trueme_r0": "Glad nie waar van my nie",
      "fi_08": "Ek is altyd in staat om nou 'n bietjie geluk prys te gee vir groter geluk later.",
      "fi_09": "Ek is tevrede met my vriendskappe en verhoudings.",
      "fi_10": "My verhoudings is so bevredigend as wat ek wil hê dit moet wees.",
      "fi_11": "Hoe dikwels is jy bekommerd dat jy in staat is om normale maandelikse lewenskoste te ontmoet?",
      "fi_rs_worry_r10": "Moenie bekommerd wees nie",
      "fi_rs_worry_r0": "Bekommer jou die hele tyd",
      "fi_12": "Hoe dikwels is jy bekommerd oor veiligheid, kos of behuising?"
    },
    "ar-EG": {
      "fi_01": "بشكل عام, الى أي مدى أنت راضي للحياة بكاملها في هذه الأيام ؟",
      "fi_rs_satisfied_r10": "تشعر بالرضا بشكل كامل (ممتن للغاية)",
      "fi_rs_satisfied_r0": "لا تشعر برضا ابدا",
      "fi_02": "بشكل عام ، ما مدى شعورك بالسعادة أو التعاسة؟",
      "fi_rs_happy_r10": "سعيد للغاية",
      "fi_rs_happy_r0": "تعيس للغاية",
      "fi_03": "بشكل عام، كيف كنت تقيّم صحتك الجسدية؟",
      "fi_rs_physical_r10": "صحة الجسدية ممتازة",
      "fi_rs_physical_r0": "صحة الجسدية سيئة جدا",
      "fi_04": "بشكل عام، كيف كنت تقيّم صحتك النفسية؟",
      "fi_rs_mental_r10": "صحتك النفسية ممتازة",
      "fi_rs_mental_r0": "صحتك النفسية سيئة جدا",
      "fi_05": "إجمالاً ، إلى أي مدى تشعر أن الأشياء التي تفعلها في حياتك جديرة بالاهتمام ذو اهمية؟",
      "fi_rs_worthwhile_r10": "ذو أهمية مطلقة",
      "fi_rs_worthwhile_r0": "لا تساوي شيء",
      "fi_06": "انا اعرف اهدافي في الحياة.",
      "fi_rs_agree_r10": "موافق بشدة",
      "fi_rs_agree_r0": "رافض بشدة",
      "fi_07": "انا احاول دائمًا تعزيز الخير في جميع الاحوال ، حتى في المواقف الصعبة وذو التحديات.",
      "fi_rs_trueme_r10": "صحيح بشكل مطلق بالنسبة لي",
      "fi_rs_trueme_r0": "ليس صحيحا ابدا بالنسبة لي",
      "fi_08": "انا دائمًا مستعد الى التخلي عن القليل من السعادة الآن من أجل الحصول على سعادة أكبر لاحقًا.",
      "fi_09": "انا اشعر برضا من صداقاتي وعلاقاتي.",
      "fi_10": "علاقاتي مرضية مثلما أريدها أن تكون.",
      "fi_11": "الى أي مدى انت قلق ان لاتستطيع ان تتحمل مصاريف معيشية يومية عادية؟",
      "fi_rs_worry_r10": "غير قلق ابدا",
      "fi_rs_worry_r0": "قلق كل الوقت",
      "fi_12": "الى أي مدى انت قلق حول امانك الشخصي, طعام, او مسكن؟"
    },
    "ar-IL": {
      "fi_01": "بشكل عام، إلى أي مدى تشعر بالرضا عن حياتك ككل هذه الأيام؟",
      "fi_rs_satisfied_r10": "راضٍ تمامًا عن حياتك",
      "fi_rs_satisfied_r0": "غير راضٍ أبدًا عن حياتك",
      "fi_02": "بشكل عام، إلى أي مدى تشعر عادةً بالسعادة أو عدم السعادة؟",
      "fi_rs_happy_r10": "سعيد جدًا",
      "fi_rs_happy_r0": "غير سعيد أبدًا",
      "fi_03": "بشكل عام كيف تقيَم وضعك الصحي؟",
      "fi_rs_physical_r10": "وضع صحي ممتاز",
      "fi_rs_physical_r0": "وضع صحي سيَء",
      "fi_04": "كيف تقيَم صحتك العقلية؟",
      "fi_rs_mental_r10": "صحتي العقلية \"ممتازة\"",
      "fi_rs_mental_r0": "صحتي العقلية \"سيئة\"",
      "fi_05": "بشكل عام، إلى أي مدى تشعر أن الأشياء التي تقوم بها في حياتك مهمة؟",
      "fi_rs_worthwhile_r10": "مهمة جدًا",
      "fi_rs_worthwhile_r0": "غير مهمة أبدًا",
      "fi_06": "أنا أفهم هدفي في الحياة.",
      "fi_rs_agree_r10": "أوافق بشدة",
      "fi_rs_agree_r0": "لا أوافق أبدًا",
      "fi_07": "أنا أعمل دائمًا لتقديم الخير في جميع الظروف، حتى في المواقف الصعبة والتي بها تحديات.",
      "fi_rs_trueme_r10": "تنطبق علي تمامًا",
      "fi_rs_trueme_r0": "لا تنطبق علي أبدا",
      "fi_08": "يمكنني دائمًا التخلي عن بعض من السعادة الآن من أجل مزيد من السعادة لاحقًا.",
      "fi_09": "أنا راضٍ عن صداقاتي وعلاقاتي",
      "fi_10": "علاقتي بالآخرين مُرْضيةً كما أريدها أن تكون",
      "fi_11": "ما مدى شعورك بالقلق بشأن قدرتك على تغطية نفقات المعيشة الشهرية العادية؟",
      "fi_rs_worry_r10": "لا أقلق أبدًا",
      "fi_rs_worry_r0": "أقلق طوال الوقت",
      "fi_12": "ما مدى تكرار قلقك بشأن الأمان أو الطعام أو السكن؟"
    },
    "as": {
      "fi_01": "সামগ্ৰিকভাৱে, বৰ্তমানে আপুনি সামগ্ৰিকভাৱে নিজৰ জীৱনটোক লৈ কিমান সন্তুষ্ট হয়?",
      "fi_rs_satisfied_r10": "আপোনাৰ জীৱনক লৈ সম্পূৰ্ণৰূপে সন্তুষ্ট হয়",
      "fi_rs_satisfied_r0": "আপোনাৰ জীৱনক লৈ একেবাৰেই সন্তুষ্ট নহয়",
      "fi_02": "সাধাৰণভাৱে, আপুনি সাধাৰণতে কিমান সুখী বা অসুখী বুলি অনুভৱ কৰে?",
      "fi_rs_happy_r10": "অত্যধিক সুখী",
      "fi_rs_happy_r0": "অত্যধিক অসুখী",
      "fi_03": "সাধাৰণভাৱে, আপুনি নিজৰ শাৰীৰিক স্বাস্থ্যক কেনেদৰে মূল্যাংকন কৰিব?",
      "fi_rs_physical_r10": "উৎকৃষ্ট শাৰীৰিক স্বাস্থ্য",
      "fi_rs_physical_r0": "বেয়া শাৰীৰিক স্বাস্থ্য",
      "fi_04": "আপুনি নিজৰ সামগ্ৰিক মানসিক স্বাস্থ্যক কেনেদৰে মূল্যাংকন কৰিব?",
      "fi_rs_mental_r10": "উৎকৃষ্ট মানসিক স্বাস্থ্য",
      "fi_rs_mental_r0": "বেয়া মানসিক স্বাস্থ্য",
      "fi_05": "সামগ্ৰিকভাৱে, আপুনি নিজৰ জীৱনত কৰা কামবোৰ কিমান দূৰলৈকে সাৰ্থক হয় বুলি আপুনি অনুভৱ কৰে?",
      "fi_rs_worthwhile_r10": "সম্পূৰ্ণৰূপে সাৰ্থক হয়",
      "fi_rs_worthwhile_r0": "একেবাৰেই সাৰ্থক নহয়",
      "fi_06": "মোৰ জীৱনৰ উদ্দেশ্য কি হয় সেয়া মই বুজি পাওঁ।",
      "fi_rs_agree_r10": "দৃঢ়ভাৱে সন্মত",
      "fi_rs_agree_r0": "দৃঢ়ভাৱে অসন্মত",
      "fi_07": "মই সদায়েই সকলোবোৰ পৰিস্থিতিতে ভাল কথাক উদগণি যোগাবলৈ কাম কৰোঁ, আনকি কঠিন আৰু প্ৰত্যাহ্বানজনক পৰিস্থিতিটো।",
      "fi_rs_trueme_r10": "মোৰ ক্ষেত্ৰত সম্পূৰ্ণ সঁচা হয়",
      "fi_rs_trueme_r0": "মোৰ ক্ষেত্ৰত একেবাৰেই সঁচা নহয়",
      "fi_08": "মই ভৱিষ্যতৰ বেছি সুখৰ বাবে সদায়েই বৰ্তমানৰ কিছু সুখ ত্যাগ কৰিব পাৰোঁ।",
      "fi_09": "মই মোৰ বন্ধুত্ব আৰু সম্পৰ্কবোৰক লৈ সন্তুষ্ট হয়।",
      "fi_10": "মোৰ সম্পৰ্কবোৰ সিমানেই সন্তুষ্টিজনক হয় যিমান মই এইবোৰ হোৱাটো বিচাৰোঁ।",
      "fi_11": "সাধাৰণ মাহিলী জীৱন নিৰ্বাহৰ খৰচ পূৰণ কৰিবলৈ সক্ষম হোৱাৰ বিষয়ে আপুনি কিমান সঘনাই চিন্তা কৰে?",
      "fi_rs_worry_r10": "কেতিয়াও চিন্তা কৰিব নালাগে",
      "fi_rs_worry_r0": "সকলো সময়তে চিন্তা কৰি থাকে",
      "fi_12": "আপুনি কিমান সঘনাই সুৰক্ষা, খাদ্য বা ঘৰৰ বিষয়ে চিন্তা কৰে?"
    },
    "id": {
      "fi_01": "Secara keseluruhan, seberapa puaskah Anda dengan kehidupan Anda akhir-akhir ini?",
      "fi_rs_satisfied_r10": "Sangat puas dengan hidup Anda",
      "fi_rs_satisfied_r0": "Sama sekali tidak puas dengan hidup Anda",
      "fi_02": "Secara umum, biasanya Anda merasa seberapa bahagia atau tidak Bahagia?",
      "fi_rs_happy_r10": "Sangat bahagia",
      "fi_rs_happy_r0": "Sangat tidak bahagia",
      "fi_03": "Secara umum, bagaimana Anda menilai kesehatan fisik Anda?",
      "fi_rs_physical_r10": "Kesehatan fisik yang sangat baik",
      "fi_rs_physical_r0": "Kesehatan fisik yang bur",
      "fi_04": "Bagaimana Anda menilai kesehatan mental Anda?",
      "fi_rs_mental_r10": "Kesehatan mental yang sangat baik",
      "fi_rs_mental_r0": "Kesehatan mental yang buruk",
      "fi_05": "Secara keseluruhan, sejauh mana Anda merasa hal-hal yang Anda lakukan dalam hidup Anda berharga?",
      "fi_rs_worthwhile_r10": "Sangat berharga",
      "fi_rs_worthwhile_r0": "Sama sekali tidak berharga",
      "fi_06": "Saya memahami tujuan hidup saya",
      "fi_rs_agree_r10": "Sangat setuju",
      "fi_rs_agree_r0": "Sangat tidak setuju",
      "fi_07": "Saya selalu berusaha melakukan kebaikan di setiap kesempatan, bahkan di situasi sulit dan menantang.",
      "fi_rs_trueme_r10": "Benar-benar mencerminkan diri Anda",
      "fi_rs_trueme_r0": "Tidak mencerminkan diri Anda sama sekali",
      "fi_08": "Saya selalu dapat menunda beberapa kebahagiaan saat ini untuk kebahagiaan yang lebih besar di masa mendatang.",
      "fi_09": "Saya merasa puas dengan persahabatan dan hubungan saya",
      "fi_10": "Hubungan saya memuaskan seperti yang saya harapkan.",
      "fi_11": "Seberapa sering Anda khawatir tidak dapat memenuhi biaya hidup standard bulanan?",
      "fi_rs_worry_r10": "Tidak pernah khawatir",
      "fi_rs_worry_r0": "Selalu khawatir",
      "fi_12": "Seberapa sering Anda khawatir dengan keselamatan, makanan, atau tempat tinggal?"
    },
    "bn": {
      "fi_01": "সামগ্রিকভাবে, আপনি আজকালকার দিনগুলোতে সামগ্রিক জীবন নিয়ে কতটা সন্তুষ্ট?",
      "fi_rs_satisfied_r10": "আপনার জীবনের সাথে সম্পূর্ণরূপে সন্তুষ্ট",
      "fi_rs_satisfied_r0": "আপনার জীবন নিয়ে মোটেও সন্তুষ্ট নন",
      "fi_02": "সাধারণভাবে, আপনি সাধারণত কতটা খুশি বা অখুশি বোধ করেন?",
      "fi_rs_happy_r10": "অত্যন্ত খুশি",
      "fi_rs_happy_r0": "অত্যন্ত অখুশি",
      "fi_03": "সাধারণভাবে, আপনি আপনার শারীরিক স্বাস্থ্যকে কীভাবে মূল্যায়ন করবেন?",
      "fi_rs_physical_r10": "শারীরিক স্বাস্থ্য চমৎকার",
      "fi_rs_physical_r0": "শারীরিক স্বাস্থ্য খারাপ",
      "fi_04": "আপনি আপনার সামগ্রিক মানসিক স্বাস্থ্যকে কীভাবে মূল্যায়ন করবেন?",
      "fi_rs_mental_r10": "মানসিক স্বাস্থ্য চমৎকার",
      "fi_rs_mental_r0": "মানসিক স্বাস্থ্য খারাপ",
      "fi_05": "সামগ্রিকভাবে, আপনি আপনার জীবনে যে জিনিসগুলো করেন তাতে কতটা সার্থক বলে মনে করেন?",
      "fi_rs_worthwhile_r10": "সম্পূর্ণরূপে সার্থক",
      "fi_rs_worthwhile_r0": "মোটেও সার্থক নয়",
      "fi_06": "আমি বুঝতে পারি আমার জীবনের উদ্দেশ্য।",
      "fi_rs_agree_r10": "পুরোপুরি একমত",
      "fi_rs_agree_r0": "পুরোপুরি ভিন্নমত",
      "fi_07": "আমি সবসময় সব পরিস্থিতিতে ভাল প্রচার করার জন্য কাজ করি, এমনকি কঠিন এবং চ্যালেঞ্জিং পরিস্থিতিতেও।",
      "fi_rs_trueme_r10": "আমার সম্পর্কে সম্পূর্ণ সত্য",
      "fi_rs_trueme_r0": "আমার সম্পর্কে মোটেও সত্য নয়",
      "fi_08": "পরে আরও সুখের জন্য আমি সবসময় কিছু সুখ এখন ছেড়ে দিতে পারি।",
      "fi_09": "আমি আমার বন্ধুত্ব এবং সম্পর্ক নিয়ে সন্তুষ্ট।",
      "fi_10": "আমার সম্পর্কগুলো ততটাই সন্তোষজনক যতটা আমি চাই।",
      "fi_11": "কত ঘন ঘন আপনি স্বাভাবিক মাসিক জীবনযাত্রার ব্যয় মেটাতে সক্ষম হওয়ার বিষয়ে চিন্তা করেন?",
      "fi_rs_worry_r10": "কখনো চিন্তা করেন না",
      "fi_rs_worry_r0": "সব সময় চিন্তা করেন",
      "fi_12": "আপনি কত ঘন ঘন নিরাপত্তা, খাদ্য, বা বাসস্থান সম্পর্কে চিন্তা করেন?"
    },
    "bcl": {
      "fi_01": "Sa kagabsan, gurano ka kuntento sa saimong buhay sa kabilugan sa mga aldaw na iniyu?",
      "fi_rs_satisfied_r10": "Talagang dai ka kuntento sa saimong buhay",
      "fi_rs_satisfied_r0": "Talagang dai ka kuntento sa saimong buhay",
      "fi_02": "Sa kabilugan, gurano ka kaugma o kamundo an pirmi mong namamatian?",
      "fi_rs_happy_r10": "Maugmahon na maray",
      "fi_rs_happy_r0": "Mamunduon na maray",
      "fi_03": "Sa kabilugan, pano mo irate an saimong salud pisikal?",
      "fi_rs_physical_r10": "Marhay na salud pisikal",
      "fi_rs_physical_r0": "Maluyang salud pisikal",
      "fi_04": "Paano mo i-rate an saimong pang kagabsan na salud pangkaisipan?",
      "fi_rs_mental_r10": "Pinakamarhay na salud pangkaisipan",
      "fi_rs_mental_r0": "Maluyang salud pangkaisipan",
      "fi_05": "Sa kagabsan, gurano kalawak an namatean mo sa mga bagay na piggigibo mo sa saimong buhay na sulit naman?",
      "fi_rs_worthwhile_r10": "Talagang sulit naman",
      "fi_rs_worthwhile_r0": "Bako talagang sulit",
      "fi_06": "Naiintindihan ko an sakuyang plano sa buhay.",
      "fi_rs_agree_r10": "Makusog na minauyon",
      "fi_rs_agree_r0": "Makusog na minakontra",
      "fi_07": "Pirmi ako nag-iiro para isulong an karahayan sa gabos na sirkumstansya, maski dipisil asin mapaghamon an sitwasyon",
      "fi_rs_trueme_r10": "Talagang totoo sakuya",
      "fi_rs_trueme_r0": "Bako talaga totoo sakuya",
      "fi_08": "Pirmi ko pigsusuko an ibang kaugmahan ko ngonyan para sa mas marhay na kaugmahan ko atchan.",
      "fi_09": "Kuntentado ako sa sakuyang amigo asin ka-relasyon.",
      "fi_10": "An gusto ko magiging kuntento ako sa ka-relasyon ko.",
      "fi_11": "Pirang beses ka po naghahadit para maipnuan manungod sa bulanan na normal na gastos?",
      "fi_rs_worry_r10": "Dai lamang naghahadit",
      "fi_rs_worry_r0": "Naghahadit sa gabos na oras",
      "fi_12": "Pirang beses ka naghahadit manungod sa saimong kaligtasan, pagkaon o harong?"
    },
    "ceb": {
      "fi_01": "Sa kinatibuk-an, unsa ka kontento sa kinatibuk-an nimong kinabuhi karong mga adlawa?",
      "fi_rs_satisfied_r10": "Hingpit nga nakontento sa imong kinabuhi",
      "fi_rs_satisfied_r0": "Wala gyud makontento sa imong kinabuhi",
      "fi_02": "Sa kinatibuk-an, unsa ka malipayon o dili malipayon ang kasagaran nimong bation?",
      "fi_rs_happy_r10": "Malipayon gyud kaayo",
      "fi_rs_happy_r0": "Dili gyud kaayo malipayon",
      "fi_03": "Sa kinatibuk-an, unsaon nimo pag-grado sa imong pisikal nga kahimsog?",
      "fi_rs_physical_r10": "Maayo kaayo ang pisikal nga kahimsog",
      "fi_rs_physical_r0": "Dili maayo ang pisikal nga kahimsog",
      "fi_04": "Unsaon nimo pag-grado ang imong kinatibuk-ang kahimsog sa pangisip?",
      "fi_rs_mental_r10": "Maayo kaayo nga kahimsog sa pangisip",
      "fi_rs_mental_r0": "Dili maayo nga kahimsog sa pangisip",
      "fi_05": "Sa kinatibuk-an, sa unsa ka dako ang imong gibati nga ang mga butang nga imong gibuhat sa imong kinabuhi mapuslanon?",
      "fi_rs_worthwhile_r10": "Hingpit nga mapuslanon",
      "fi_rs_worthwhile_r0": "Dili gyud mapuslanon",
      "fi_06": "Nakasabot ko sa akong katuyoan sa kinabuhi.",
      "fi_rs_agree_r10": "Uyon gyud",
      "fi_rs_agree_r0": "Dili gyud uyon",
      "fi_07": "Kanunay kong molihok aron mopatigbabaw ang kaayuhan sa tanang higayon, bisan sa lisud ug mahagiton nga mga sitwasyon",
      "fi_rs_trueme_r10": "Tinuod gyud kanako",
      "fi_rs_trueme_r0": "Dili tinuod gyud kanako",
      "fi_08": "Kanunay kong nga ipadaplin ang pipila ka kalipay karon alang sa mas dakong kalipay sa umaabot.",
      "fi_09": "Kontento na ko sa akong kahigalaan ug karelasyon.",
      "fi_10": "Ang akong mga relasyon makakontento sama sa akong gusto.",
      "fi_11": "Unsa kapirmi ka na nga nabalaka nga mapasiguan ang binulan nga gastos sa panimuyo?",
      "fi_rs_worry_r10": "Wala gyud mabalaka",
      "fi_rs_worry_r0": "Nabalaka sa tanang panahon",
      "fi_12": "Unsa kapirmi ka mabalaka bahin sa kaluwasan, pagkaon, o balay?"
    },
    "zh-HK": {
      "fi_01": "整體而言，您近來對整體生活的滿意度為何？",
      "fi_rs_satisfied_r10": "完全滿意",
      "fi_rs_satisfied_r0": "一點都不滿意",
      "fi_02": "整體而言，您通常覺得開心的程度為何？",
      "fi_rs_happy_r10": "極度開心",
      "fi_rs_happy_r0": "極度不開心",
      "fi_03": "整體而言，您會為您的身體健康打幾分（生理健康)?",
      "fi_rs_physical_r10": "非常好",
      "fi_rs_physical_r0": "很差",
      "fi_04": "整體而言，您會給您的心理健康打幾分（精神健康)?",
      "fi_rs_mental_r10": "非常好",
      "fi_rs_mental_r0": "很差",
      "fi_05": "整體而言，您有多大程度覺得自己在生活中所做的事是值得的？",
      "fi_rs_worthwhile_r10": "完全值得",
      "fi_rs_worthwhile_r0": "一點都不值得",
      "fi_06": "我了解我的人生目標",
      "fi_rs_agree_r10": "強烈同意",
      "fi_rs_agree_r0": "強烈不同意",
      "fi_07": "無論在任何境況下，儘管在困難和富挑戰性的情況下，我總是能採取行動去促進正面效果.",
      "fi_rs_trueme_r10": "完全是我",
      "fi_rs_trueme_r0": "完全不是我",
      "fi_08": "我總可以放棄一些目前的快樂去換取以後更大的快樂。",
      "fi_09": "我對自己的友誼以及跟別人的關係感到滿意。",
      "fi_10": "我的人際關係正如我所渴望的使我滿意。",
      "fi_11": "您有多常會擔心無法應付每個月的正常生活開支？",
      "fi_rs_worry_r10": "從不擔心",
      "fi_rs_worry_r0": "每時每刻都擔心",
      "fi_12": "您有多常會擔心安全、食物或住屋問題？"
    },
    "zh": {
      "fi_01": "整体而言，您近来对整体生活的满意度如何？",
      "fi_rs_satisfied_r10": "完全满意",
      "fi_rs_satisfied_r0": "一点都不满意",
      "fi_02": "整体而言，您通常觉得开心或不开心的程度如何？",
      "fi_rs_happy_r10": "及其开心",
      "fi_rs_happy_r0": "及其不开心",
      "fi_03": "整体而言，您会为您的身体健康打几分？（生理健康）",
      "fi_rs_physical_r10": "非常好",
      "fi_rs_physical_r0": "很差",
      "fi_04": "整体而言，您会给您的心理健康打几分（精神健康）？",
      "fi_rs_mental_r10": "非常好",
      "fi_rs_mental_r0": "很差",
      "fi_05": "整体而言，您有多大程度觉得自己在生活中所做的事是值得的？",
      "fi_rs_worthwhile_r10": "完全值得",
      "fi_rs_worthwhile_r0": "一点都不值得",
      "fi_06": "我了解我的人生目標",
      "fi_rs_agree_r10": "强烈同意",
      "fi_rs_agree_r0": "强烈不同意",
      "fi_07": "无论在任何境况中，甚至面临困难和挑战性的情况下，我总是能采取行动促进好的方面",
      "fi_rs_trueme_r10": "完全是我",
      "fi_rs_trueme_r0": "完全不是我",
      "fi_08": "我总是能放弃一些目前的快乐去换取以后更大的快乐。",
      "fi_09": "我对自己的朋友和人际关系感到满意",
      "fi_10": "我的人际关系正如我所希望的那样让我满意。",
      "fi_11": "您担心无法应付每个月正常生活开支的频繁程度如何？",
      "fi_rs_worry_r10": "从不担心",
      "fi_rs_worry_r0": "每时每刻都担心",
      "fi_12": "您担心安全、食物或住房的频繁程度如何？"
    },
    "fil": {
      "fi_01": "Sa pangkalahatan, gaano ka kasaya sa buhay mo sa panahong ito?",
      "fi_rs_satisfied_r10": "Lubos na masaya",
      "fi_rs_satisfied_r0": "Lubos na hindi masaya",
      "fi_02": "Sa pangkalahatan, gaano ka kasaya o kalungkot/hindi masaya?",
      "fi_rs_happy_r10": "Pinakamasaya",
      "fi_rs_happy_r0": "Pinakamalungkot",
      "fi_03": "Sa pangkalahatan, paano mo tatayahin ang iyong pisikal na kalusugan?",
      "fi_rs_physical_r10": "Pinakamahusay na pisikal na kalusugan",
      "fi_rs_physical_r0": "Pinakamalubhang pisikal na kalusugan",
      "fi_04": "Sa pangkalahatan, paano mo tatayahin ang iyong pangkaisipan na kalusugan?",
      "fi_rs_mental_r10": "Pinakamahusay na pangkaisipan na kalusugan",
      "fi_rs_mental_r0": "Pinakamalubhang pangkaisipan na kalusugan",
      "fi_05": "Sa pangkalahatan, sa tingin mo ba na ang ginagawa mo sa iyong buhay ay makabuluhan?",
      "fi_rs_worthwhile_r10": "Lubos na makabuluhan",
      "fi_rs_worthwhile_r0": "Lubos na hindi makabuluhan",
      "fi_06": "Naiintindihan ko ang aking layunin sa buhay",
      "fi_rs_agree_r10": "Lubos na sumasang-ayon",
      "fi_rs_agree_r0": "Lubos na hindi sumasang-ayon",
      "fi_07": "Lagi akong kumikilos para isulong ang kabutihan sa lahat ng pagkakataon, kahit sa mahihirap at mapagsubok na sitwasyon.",
      "fi_rs_trueme_r10": "Lubos na totoo para sa akin",
      "fi_rs_trueme_r0": "Lubos na hindi totoo para sa akin",
      "fi_08": "Lagi kong kayang magsakripisyo ng kasayahan ngayon para sa mas higit na kasayahan sa hinaharap.",
      "fi_09": "Masaya ako sa aking mga pagkakaibigan at mga relasyon",
      "fi_10": "Ang mga relasyon ko ay kasing kasiya-siya ng gusto ko.",
      "fi_11": "Gaano kadalas mong ikinababahala ang pagkakaroon ng pambayad sa mga bayarin kada buwan?",
      "fi_rs_worry_r10": "Hindi kailanman nababahala",
      "fi_rs_worry_r0": "Palaging nababahala",
      "fi_12": "Gaano kadalas mong ikinababahala ang kaligtasan, pagkain, o matitirhan?"
    },
    "de": {
      "fi_01": "Wie zufrieden sind Sie aktuell mit Ihrem Leben insgesamt?",
      "fi_rs_satisfied_r10": "Vollkommen zufrieden mit Ihrem Leben",
      "fi_rs_satisfied_r0": "Überhaupt nicht zufrieden mit Ihrem Leben",
      "fi_02": "Wie glücklich oder unglücklich fühlen Sie sich im Allgemeinen?",
      "fi_rs_happy_r10": "Äußerst glücklich",
      "fi_rs_happy_r0": "Äußerst unglücklich",
      "fi_03": "Wie würden Sie Ihre körperliche Gesundheit im Allgemeinen einschätzen?",
      "fi_rs_physical_r10": "Ausgezeichnete körperliche Gesundheit",
      "fi_rs_physical_r0": "Schlechte körperliche Gesundheit",
      "fi_04": "Wie würden Sie Ihre allgemeine psychische Gesundheit einschätzen?",
      "fi_rs_mental_r10": "Ausgezeichnete psychische Gesundheit",
      "fi_rs_mental_r0": "Schlechte psychische Gesundheit",
      "fi_05": "Inwieweit halten Sie die Dinge, die Sie in Ihrem Leben tun, insgesamt für sinnvoll?",
      "fi_rs_worthwhile_r10": "Vollkommen sinnvoll",
      "fi_rs_worthwhile_r0": "Überhaupt nicht sinnvoll",
      "fi_06": "Ich verstehe meinen Sinn im Leben.",
      "fi_rs_agree_r10": "Stimme voll und ganz zu",
      "fi_rs_agree_r0": "Stimme überhaupt nicht zu",
      "fi_07": "Ich setze mich unter allen Umständen für das Gute ein, auch in schwierigen und herausfordernden Situationen.",
      "fi_rs_trueme_r10": "Trifft vollkommen auf mich zu",
      "fi_rs_trueme_r0": "Trifft überhaupt nicht auf mich zu",
      "fi_08": "Ich bin immer in der Lage, jetzt auf ein gewisses Maß an Glück zu verzichten, um dafür später größeres Glück zu erlangen.",
      "fi_09": "Ich bin zufrieden mit meinen Freundschaften und Beziehungen.",
      "fi_10": "Meine Beziehungen sind so befriedigend, wie ich es mir wünschen würde.",
      "fi_11": "Wie oft machen Sie sich Sorgen, ob Sie Ihre normalen monatlichen Lebenshaltungskosten bestreiten können?",
      "fi_rs_worry_r10": "Nie besorgt",
      "fi_rs_worry_r0": "Ständig besorgt",
      "fi_12": "Wie oft machen Sie sich Sorgen um Ihre Sicherheit, Nahrung oder Unterkunft?"
    },
    "gu": {
      "fi_01": "એકંદરે, આ દિવસોમાં સમગ્રપણે તમે જીવનથી કેટલા સંતુષ્ટ છો?",
      "fi_rs_satisfied_r10": "તમારા જીવનથી સંપૂર્ણપણે સંતુષ્ટ",
      "fi_rs_satisfied_r0": "તમારા જીવનથી બિલકુલ સંતુષ્ટ નથી",
      "fi_02": "સામાન્ય સંદર્ભમાં, તમે સામાન્ય રીતે કેટલા ખુશ અથવા નાખુશ હોવાનો અહેસાસ કરો છો?",
      "fi_rs_happy_r10": "અત્યંત ખુશ",
      "fi_rs_happy_r0": "અત્યંત નાખુશ",
      "fi_03": "સામાન્ય સંદર્ભમાં, તમારા શારીરિક સ્વાસ્થ્યને તમે કેવી રીતે મૂલવશો?",
      "fi_rs_physical_r10": "ઉત્તમ શારીરિક સ્વાસ્થ્ય",
      "fi_rs_physical_r0": "ખરાબ શારીરિક સ્વાસ્થ્ય",
      "fi_04": "તમારા એકંદર માનસિક સ્વાસ્થ્યને તમે કેવી રીતે મૂલવશો?",
      "fi_rs_mental_r10": "ઉત્તમ માનસિક સ્વાસ્થ્ય",
      "fi_rs_mental_r0": "ખરાબ માનસિક સ્વાસ્થ્ય",
      "fi_05": "એકંદરે, તમે તમારા જીવનમાં કરો છો તે બાબતો કરવાનું સાર્થક છે તેવું તમને કેટલા પ્રમાણમાં લાગે છે?",
      "fi_rs_worthwhile_r10": "સંપૂર્ણપણે સાર્થક",
      "fi_rs_worthwhile_r0": "બિલકુલ સાર્થક નથી",
      "fi_06": "હું જીવનમાં મારો હેતુ સમજું છું.",
      "fi_rs_agree_r10": "સંપૂર્ણપણે સહમત",
      "fi_rs_agree_r0": "સંપૂર્ણપણે અસહમત",
      "fi_07": "હું તમામ સંજોગોમાં હંમેશા સારી બાબતને પ્રોત્સાહન આપવા કામ કરું છું, મુશ્કેલ અને પડકારજનસ પરિસ્થિતિઓમાં પણ.",
      "fi_rs_trueme_r10": "મારા વિશે સંપૂર્ણપણે સાચું છે",
      "fi_rs_trueme_r0": "મારા વિશે બિલકુલ સાચું નથી",
      "fi_08": "પછીથી વધુ મોટી ખુશી માટે હું અત્યારે થોડીક ખુશીને જતી કરવા માટે હંમેશા સક્ષમ છું.",
      "fi_09": "હું મારી મિત્રતાઓ અને સંબંધોથી સંતુષ્ટ છું.",
      "fi_10": "મારા સંબંધો એટલા સંતોષકારક છે જેટલા હું તે હોવાનું ઈચ્છતો હતો.",
      "fi_11": "મહિનાના સામાન્ય જીવન ખર્ચાઓને પૂરા કરવા સક્ષમ હોવા વિશે તમે કેટલી વખત ચિંતા અનુભવો છો?",
      "fi_rs_worry_r10": "ક્યારેય ચિંતા નથી કરતો",
      "fi_rs_worry_r0": "કાયમ ચિંતા કરું છું",
      "fi_12": "સુરક્ષા, ખોરાક, અથવા ઘર વિશે તમે કેટલી વખત ચિંતા અનુભવો છો?"
    },
    "ha": {
      "fi_01": "Gabaɗaya, yaya gamsuwa da rayuwa gaba ɗaya a kwanakin nan?",
      "fi_rs_satisfied_r10": "Cikakken gamsuwa da rayuwar ku",
      "fi_rs_satisfied_r0": "Ko kadan ba gamsu da rayuwar ku ba",
      "fi_02": "Gabaɗaya, yaya farin ciki ko rashin jin daɗi kuke yawan ji?",
      "fi_rs_happy_r10": "Matukar farin ciki",
      "fi_rs_happy_r0": "Matukar rashin jin dadi",
      "fi_03": "Gabaɗaya, yaya za ku kimanta lafiyar jikin ku?",
      "fi_rs_physical_r10": "Kyakkyawan lafiyar jiki",
      "fi_rs_physical_r0": "Rashin lafiyar jiki",
      "fi_04": "Yaya za ku kimanta lafiyar HANKALI gaba ɗaya?",
      "fi_rs_mental_r10": "Kyakkyawan lafiyar kwakwalwa",
      "fi_rs_mental_r0": "Rashin lafiyar hankali",
      "fi_05": "Gabaɗaya, har yaya kuke jin abubuwan da kuke yi a rayuwarku suna da amfani?",
      "fi_rs_worthwhile_r10": "Cikakken daraja",
      "fi_rs_worthwhile_r0": "Ko kadan bai dace ba",
      "fi_06": "Na fahimci manufa ta a rayuwa",
      "fi_rs_agree_r10": "Yarda da ƙarfi sosai",
      "fi_rs_agree_r0": "Ba ya yarda sosai",
      "fi_07": "Kullum ina yin aiki don haɓaka nagarta a kowane yanayi, koda a cikin yanayi mai wahala da ƙalubale.",
      "fi_rs_trueme_r10": "Gaskiyar ku gaba ɗaya",
      "fi_rs_trueme_r0": "Wannan ba gaskiya bane game dani gaba ɗaya",
      "fi_08": "Kullum ina iya barin wani farin ciki yanzu don ƙarin farin ciki daga baya.",
      "fi_09": "Na gamsu da abokantaka na da alaƙata",
      "fi_10": "Alaƙata gamsashshiyace kamar yadda nake so ta zama",
      "fi_11": "Sau nawa kuke damuwa game da samun damar biyan kuɗin rayuwa na wata-wata?",
      "fi_rs_worry_r10": "Kada ku damu",
      "fi_rs_worry_r0": "Damuwa koyaushe",
      "fi_12": "Sau nawa kuke damuwa game da aminci, abinci, ko gidaje?"
    },
    "he": {
      "fi_01": "בסך הכל, עד כמה את/ה מרוצה מהחיים בכללותם בימים אלו?",
      "fi_rs_satisfied_r10": "מרוצה לחלוטין",
      "fi_rs_satisfied_r0": "בכלל לא מרוצה",
      "fi_02": "באופן כללי, כמה מאושר/ת או אומלל/ה את/ה בדרך כלל מרגיש/ה?",
      "fi_rs_happy_r10": "מאושר/ת מאוד",
      "fi_rs_happy_r0": "אומלל/ה מאוד",
      "fi_03": "באופן כללי, איך היית מדרג/ת את הבריאות הגופנית שלך?",
      "fi_rs_physical_r10": "בריאות גופנית מעולה",
      "fi_rs_physical_r0": "בריאות גופנית גרועה מאוד",
      "fi_04": "באופן כללי, איך היית מדרג/ת את הבריאות הנפשית שלך?",
      "fi_rs_mental_r10": "בריאות נפשית מעולה",
      "fi_rs_mental_r0": "בריאות נפשית גרועה מאוד",
      "fi_05": "בסך הכל, באיזו מידה את/ה מרגיש/ה שהדברים שאת/ה עושה בחיים שלך שווים משהו?",
      "fi_rs_worthwhile_r10": "לגמרי שווים משהו",
      "fi_rs_worthwhile_r0": "לא שווים כלום",
      "fi_06": "אני מבין/ה את המטרה שלי בחיים.",
      "fi_rs_agree_r10": "מסכים/ה מאוד",
      "fi_rs_agree_r0": "מתנגד/ת מאוד",
      "fi_07": "אני תמיד פועל/ת לקידום הטוב בכל הנסיבות, גם במצבים קשים ומאתגרים.",
      "fi_rs_trueme_r10": "לגמרי נכון לגבי",
      "fi_rs_trueme_r0": "בכלל לא נכון לגבי",
      "fi_08": "אני תמיד מסוגל/ת לוותר על קצת אושר עכשיו על מנת שיהיה אושר גדול יותר מאוחר יותר.",
      "fi_09": "אני מרוצה מהחברויות ומערכות היחסים שלי.",
      "fi_10": "מערכות היחסים שלי מספקות בדיוק במידה שהייתי רוצה שיהיו.",
      "fi_11": "באיזו תדירות את/ה חושש/ת שלא תוכל/י לעמוד בהוצאות מחיה חודשיות רגילות?",
      "fi_rs_worry_r10": "אף פעם לא חושש/ת",
      "fi_rs_worry_r0": "חושש/ת כל הזמן",
      "fi_12": "באיזו תדירות את/ה חושש/ת לגבי בטחון אישי, מזון, או דיור?"
    },
    "hil": {
      "fi_01": "Sa kabug-osan, sa subong nga mga inadlaw daw ano ikaw kakontento sa imo nga pangabuhi?",
      "fi_rs_satisfied_r10": "Kontento gid ako ka tama",
      "fi_rs_satisfied_r0": "Hindi kontento sa akon pangabuhi",
      "fi_02": "Sa kabilogan, daw ano kasadya ukon kasubo ang masami nimo nga mabatyagan?",
      "fi_rs_happy_r10": "Pwerte kasadya",
      "fi_rs_happy_r0": "Pwerte masubo",
      "fi_03": "Sa kabug-osan, ano ang kahimtangan sang imo pisikal na panglawason?",
      "fi_rs_physical_r10": "Maayo ang panglawason",
      "fi_rs_physical_r0": "Mapigaw ang panglawason",
      "fi_04": "Ano ang kahimtangan sang imo panghunahuna?",
      "fi_rs_mental_r10": "Maayo ang panghunahuna",
      "fi_rs_mental_r0": "Hindi maayo ang panghunahuna",
      "fi_05": "Sa kabilogan, tubtob sa anong kasangkaron ang nabatyagan mo nga ang mga butang nga ginahimo mo samtang ikaw nagakabuhi mapuslanon?",
      "fi_rs_worthwhile_r10": "Mapuslanon gid",
      "fi_rs_worthwhile_r0": "Hindi gid mapinuslanon",
      "fi_06": "Naintindihan ko ang katuyuan sang akon kabuhi.",
      "fi_rs_agree_r10": "Nagakompormi gid",
      "fi_rs_agree_r0": "Wala nagakompormi",
      "fi_07": "Pirme ako nagabuhat sing maayo sa tanan nga kahigayunan, bisan sa mabudlay kag puno sing pagpanghangkat nga sitwasyon.",
      "fi_rs_trueme_r10": "Matuod gid sang akon",
      "fi_rs_trueme_r0": "Indi gid matuod sang akon",
      "fi_08": "Mahimo ako nga mabayaan ang mga gamay na kalipayan para sa mas daku nga kalipayan sa ulihi.",
      "fi_09": "Kontento ako sa akon mga abyan kag kaangtanan sa iban nga tawo.",
      "fi_10": "Malipayon ang akon kaangtanan sa iban suno gid sa akon naluyagan.",
      "fi_11": "Daw ano ka masami ka nga nagabatyag sing kabalaka tuhoy sa paglab-ot sang mga galastuhan mo kada bulan?",
      "fi_rs_worry_r10": "Wala gid gakabalaka",
      "fi_rs_worry_r0": "Pirme nagakabalaka",
      "fi_12": "Daw ano ka masami nga nagabatyag ka sing kabalaka tuhoy sa seguridad, pagkaon, ukon sang imo panimalay?"
    },
    "hi": {
      "fi_01": "कुलमिलाकर, आजकल आप संपूर्ण रूप से जीवन से कितना संतुष्‍ट हैं?",
      "fi_rs_satisfied_r10": "अपने जीवन से पूरी तरह से संतुष्‍ट",
      "fi_rs_satisfied_r0": "अपने जीवन से बिल्‍कुल भी संतुष्‍ट नहीं",
      "fi_02": "आमतौर पर, आप कितना खुश या नाखुश महसूस करते हैं?",
      "fi_rs_happy_r10": "अत्‍यधिक खुश",
      "fi_rs_happy_r0": "अत्‍यधिक नाखुश",
      "fi_03": "सामान्‍यत:, आप अपने शारीरिक स्‍वास्‍थ्‍य को कैसा रेट करेंगे?",
      "fi_rs_physical_r10": "सर्वोत्‍तम शारीरिक स्‍वास्‍थ्‍य",
      "fi_rs_physical_r0": "खराब शारीरिक स्‍वास्‍थ्‍य",
      "fi_04": "आप अपने कुलमिलाकर मानसिक स्‍वास्‍थ्‍य को कैसा रेट करेंगे?",
      "fi_rs_mental_r10": "सर्वोत्‍तम मानसिक स्‍वास्‍थ्‍य",
      "fi_rs_mental_r0": "खराब मानसिक स्‍वास्‍थ्‍य",
      "fi_05": "कुलमिलाकर, आपको किस हद तक यह लगता है कि आप अपने जीवन में जो चीजें करते हैं वह उचित/सार्थक हैं?",
      "fi_rs_worthwhile_r10": "पूरी तरह से उचित/सार्थक",
      "fi_rs_worthwhile_r0": "बिल्‍कुल भी उचित/सार्थक नहीं",
      "fi_06": "मैं अपने जीवन के उद्देश्‍य को समझता हूँ।",
      "fi_rs_agree_r10": "पूरी तरह से सहमत",
      "fi_rs_agree_r0": "पूरी तरह से असहमत",
      "fi_07": "मैं हमेशा सभी स्थितियों में अच्‍छाई/भलाई को बढावा देने के लिए कार्य करता हूँ, मुश्किल और चुनौतिपूर्ण स्थितियों में भी।",
      "fi_rs_trueme_r10": "मेरे लिए पूरी तरह से सही",
      "fi_rs_trueme_r0": "मेरे लिए बिल्‍कुल भी सही नहीं",
      "fi_08": "मैं हमेशा बाद में अधिक खुशी के लिए अभी अपनी कुछ खुशी का बलिदान/त्‍याग कर पाता हूँ।",
      "fi_09": "मैं अपनी दोस्‍ती और संबंधों से संतुष्‍ट हूँ।",
      "fi_10": "मेरे संबंध उतने ही संतोषजनक हैं जितना मैं चाहुंगा कि वे हों।",
      "fi_11": "आप कितनी बार जीवनयापन के सामान्‍य मासिक खर्चों को पूरा करने में सक्षम होने के बारे में चिंता करते हैं?",
      "fi_rs_worry_r10": "कभी चिंता नहीं करते",
      "fi_rs_worry_r0": "हर समय चिंता करते हैं",
      "fi_12": "आप कितनी बार सुरक्षा,भोजन, या घर(रहने की जगह) के बारे में चिंता करते हैं?"
    },
    "ig": {
      "fi_01": "Gburugburu, ndụ gị o juru gị afọ n'ụbọchị ugbua?",
      "fi_rs_satisfied_r10": "Ndụ gị juru gị afọ nke ukwuu",
      "fi_rs_satisfied_r0": "Ndụ gị ejughị gị afọ nke ukwuu",
      "fi_02": "N'ozùzù oke, ị na-enwekarị obi ụtọ ka ọ bụ ịnaghị enwe?",
      "fi_rs_happy_r10": "Ezigbo enweghị obi ụtọ",
      "fi_rs_happy_r0": "Ezigbo obi ụtọ",
      "fi_03": "N'ozùzù oke, olee ogo ị ga-enye ahụike ANỤAHỤ gị?",
      "fi_rs_physical_r10": "Ahụike anụahụ bụ ịgba",
      "fi_rs_physical_r0": "Ahụike anụahụ dị njọ",
      "fi_04": "Olee ogo ị ga-enye ahụike ỌGỤGỤISI gị?",
      "fi_rs_mental_r10": "Ahụike ọgụgụisi bụ ịgba",
      "fi_rs_mental_r0": "Ahụike ọgụgụisi dị njọ",
      "fi_05": "Gburugburu, n'ogo gịnị ka ị na-eche ndụ ị na-ebi ugbua na-abara gị uru?",
      "fi_rs_worthwhile_r10": "O juru gị afọ nke ukwuu",
      "fi_rs_worthwhile_r0": "O jughị gị afọ nke ukwuu",
      "fi_06": "Aghọtara m ebumnobi m na ndụ.",
      "fi_rs_agree_r10": "Nkwenye siri ike",
      "fi_rs_agree_r0": "Ekwenyeghị siri ike",
      "fi_07": "Ana m akpa agwa iji kwalite ihe dị mma n'ọnọdụ niile, ọbụladị n'ọnọdụ siri ike ma na-ama aka.",
      "fi_rs_trueme_r10": "Nke bụ eziokwu zuru oke banyere m.",
      "fi_rs_trueme_r0": "Nke a abụghị eziokwu banyere m ma ọlị",
      "fi_08": "Ana m agba mbọ ikesa aṅụrị ugbua maka aṅụrị kachanụ n'ọdịnihu.",
      "fi_09": "Ndị enyi m na mmekọrịta m juru m afọ.",
      "fi_10": "Mmekọrịta mụ na mmadụ ibe m na-enye m afọ ojuju ka m siri chọọ.",
      "fi_11": "Ugboro ole ka ị na-echekasị ahụ banyere mmefu obibi ndụ dị mma kwa ọnwa?",
      "fi_rs_worry_r10": "Ị naghị echekasị ahụ ma ọlị",
      "fi_rs_worry_r0": "Ị na-echekasị ahụ mgbe ọbụla",
      "fi_12": "Ugboro ole ka ị na-echekasị ahụ banyere nchekwa, ihe oriri, maọbụ ebe obibi?"
    },
    "ilo": {
      "fi_01": "Iti kadagupan, kasano ti pannakapnekmo iti buo a biagmo kadagitoy nga al-aldaw?",
      "fi_rs_satisfied_r10": "Permi a napnek ka iti biagmo",
      "fi_rs_satisfied_r0": "Saan ka a pulos a mapnek iti biagmo",
      "fi_02": "Iti sapasap, kasano ti karagsak wenno kalidaymo?",
      "fi_rs_happy_r10": "Permi a naragsak",
      "fi_rs_happy_r0": "Permi a naliday",
      "fi_03": "Iti sapasap, kasanom a rukuden ti pisikal a salun-atmo?",
      "fi_rs_physical_r10": "Permi a nagmayat a pisikal a salun-at",
      "fi_rs_physical_r0": "Permi a nagalas a pisikal a slaun-at",
      "fi_04": "Kasano a rukudem ti kadagupan a salun-at ti panunutmo?",
      "fi_rs_mental_r10": "Permi a nagmayat a salun-at ti panunot",
      "fi_rs_mental_r0": "Permi a nagalas a salun-at ti panunot",
      "fi_05": "Iti kadagupan, kasanom a marikrikna a dagiti banag ti biagmo ket maipapasmo?",
      "fi_rs_worthwhile_r10": "Permi a maipapas",
      "fi_rs_worthwhile_r0": "Saan uray kaanuman a maipapas",
      "fi_06": "Maawatak ti panggepko iti biagko.",
      "fi_rs_agree_r10": "Permi nga umanamong",
      "fi_rs_agree_r0": "Permi a saan nga umanamong",
      "fi_07": "Kanayunko nga allukoyen ti mayat iti amin a kasasaad, uray kadagiti naririgat ken mangpadpadas a sitwasyon.",
      "fi_rs_trueme_r10": "Permi nga agpaypayso para kaniak",
      "fi_rs_trueme_r0": "Permi saan nga agpaypayso para kaniak",
      "fi_08": "Siak ket kanayun a makaaliwaksay iti dadduma a ragsak itattan para iti dakdakkel a ragsak damdama.",
      "fi_09": "Kuntento nak iti adda nga gagayyem ken relasyon ko.",
      "fi_10": "Dagiti relasyonko ket makapnek kas iti kayatko.",
      "fi_11": "Kasano kadaras nga agdandanag ka maipapan ti panagsabat kadagiti kadawyan a binulan a gastos ti panagbiag?",
      "fi_rs_worry_r10": "Saan a pulos a madanagan",
      "fi_rs_worry_r0": "Kanayun nga agdandanag",
      "fi_12": "Kasatnu kadaras nga agdandanag ka maipapan ti kinatalged, makan, wenno iti balay?"
    },
    "ja": {
      "fi_01": "全体的に見て、あなたは最近の生活にどの程度満足していますか。",
      "fi_rs_satisfied_r10": "完全に満足している",
      "fi_rs_satisfied_r0": "全く満足していない",
      "fi_02": "一般的に、あなたは通常、どの程度幸せ、または不幸せを感じていますか。",
      "fi_rs_happy_r10": "完全に幸せ",
      "fi_rs_happy_r0": "完全に不幸せ",
      "fi_03": "一般的に、あなたの身体的な健康状態はどれくらいですか。",
      "fi_rs_physical_r10": "身体的に素晴らしい健康状態",
      "fi_rs_physical_r0": "身体的にひどい健康状態",
      "fi_04": "全体的なあなたの精神的健康状態はどれくらいですか。",
      "fi_rs_mental_r10": "精神的に素晴らしい健康状態",
      "fi_rs_mental_r0": "精神的にひどい健康状態",
      "fi_05": "全体的に見て、あなたがあなたの人生で行うことは、どの程度価値のあることだと思いますか。",
      "fi_rs_worthwhile_r10": "十分に価値がある",
      "fi_rs_worthwhile_r0": "全く価値がない",
      "fi_06": "私は人生の目的を理解している。",
      "fi_rs_agree_r10": "強く同意する",
      "fi_rs_agree_r0": "全く同意しない",
      "fi_07": "たとえどんなに困難でも、私は全ての状況で、常に良いことを進めるように行動する。",
      "fi_rs_trueme_r10": "完全に私にあてはまる",
      "fi_rs_trueme_r0": "全く私にあてはまらない",
      "fi_08": "私はいつでも、将来の大きな幸せのために、今の幸せをある程度諦めることができる。",
      "fi_09": "私は友情や人間関係に満足している。",
      "fi_10": "自分が望む程度に、私は人間関係に満足している。",
      "fi_11": "通常の月の生活費が足りるかどうか心配する頻度はどれくらいありますか。",
      "fi_rs_worry_r10": "心配したことがない",
      "fi_rs_worry_r0": "いつも心配している",
      "fi_12": "あなたはどのくらいの頻度で安全や食事、または住居について心配していますか。"
    },
    "kn": {
      "fi_01": "ಒಟ್ಟಾರೆಯಾಗಿ, ಇತ್ತೀಚಿನ ದಿನಗಳಲ್ಲಿ ನೀವು ಸಂಪೂರ್ಣವಾಗಿ ಜೀವನದಲ್ಲಿ ಎಷ್ಟು ತೃಪ್ತಿಯಾಗಿದ್ದೀರಿ?",
      "fi_rs_satisfied_r10": "ನಿಮ್ಮ ಜೀವನದೊಂದಿಗೆ ಸಂಪೂರ್ಣವಾಗಿ ತೃಪ್ತಿಯಾಗಿದೆ",
      "fi_rs_satisfied_r0": "ನಿಮ್ಮ ಜೀವನದೊಂದಿಗೆ ತೃಪ್ತಿಯಾಗಿಲ್ಲವೇ ಇಲ್ಲ",
      "fi_02": "ಸಾಮಾನ್ಯದಲ್ಲಿ, ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಸಂತೋಷವಾಗಿ ಅಥವಾ ಅಸಂತೋಷವಾಗಿ ಭಾವಿಸುವಿರಿ?",
      "fi_rs_happy_r10": "ಅತ್ಯಂತ ಸಂತೋಷ",
      "fi_rs_happy_r0": "ಅತ್ಯಂತ ಅಸಂತೋಷ (ಅತೃಪ್ತಿ)",
      "fi_03": "ಸಾಮಾನ್ಯದಲ್ಲಿ, ನಿಮ್ಮ ದೈಹಿಕ ಆರೋಗ್ಯವನ್ನು ನೀವು ಹೇಗೆ ರೇಟ್‌ ಮಾಡುವಿರಿ?",
      "fi_rs_physical_r10": "ಅತ್ಯುತ್ತಮ ದೈಹಿಕ ಆರೋಗ್ಯ",
      "fi_rs_physical_r0": "ಕಳಪೆ ದೈಹಿಕ ಆರೋಗ್ಯ",
      "fi_04": "ನಿಮ್ಮ ಒಟ್ಟಾರೆ ಮಾನಸಿಕ ಆರೋಗ್ಯವನ್ನು ನೀವು ಹೇಗೆ ರೇಟ್‌ ಮಾಡುವಿರಿ?",
      "fi_rs_mental_r10": "ಅತ್ಯುತ್ತಮ ಮಾನಸಿಕ ಆರೋಗ್ಯ",
      "fi_rs_mental_r0": "ಕಳಪೆ ಮಾನಸಿಕ ಆರೋಗ್ಯ",
      "fi_05": "ಒಟ್ಟಾರೆಯಾಗಿ, ನಿಮ್ಮ ಜೀವನದಲ್ಲಿ ನೀವು ಮಾಡುವ ಕೆಲಸ(ಸಂಗತಿ)ಗಳು ಎಷ್ಟರ ಮಟ್ಟಿಗೆ ಸಾರ್ಥಕವೆಂದು ನೀವು ಭಾವಿಸುವಿರಿ?",
      "fi_rs_worthwhile_r10": "ಸಂಪೂರ್ಣವಾಗಿ ಸಾರ್ಥಕ",
      "fi_rs_worthwhile_r0": "ಸಾರ್ಥಕ ಅಲ್ಲವೇ ಅಲ್ಲ",
      "fi_06": "ಜೀವನದಲ್ಲಿ ನನ್ನ ಉದ್ದೇಶವನ್ನು ನಾನು ಅರ್ಥಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.",
      "fi_rs_agree_r10": "ಬಲವಾಗಿ ಒಪ್ಪುತ್ತೇನೆ",
      "fi_rs_agree_r0": "ಬಲವಾಗಿ ಒಪ್ಪುವುದಿಲ್ಲ",
      "fi_07": "ಕಠಿಣ ಮತ್ತು ಸವಾಲಿನ ಸಂದರ್ಭಗಳಲ್ಲಿಯೂ ಸಹ, ಎಲ್ಲಾ ಸನ್ನಿವೇಶಗಳಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಉತ್ತೇಜಿಸಲು ನಾನು ಯಾವಾಗಲೂ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತೇನೆ",
      "fi_rs_trueme_r10": "ನನಗೆ ಸಂಪೂರ್ಣವಾಗಿ ನಿಜವಾಗಿದೆ",
      "fi_rs_trueme_r0": "ನನಗೆ ನಿಜ ಅಲ್ಲವೇ ಅಲ್ಲ",
      "fi_08": "ಅನಂತರದಲ್ಲಿ ಹೆಚ್ಚಿನ ಸಂತೋಷಕ್ಕಾಗಿ ಈಗ ಸ್ವಲ್ಪ ಸಂತೋಷವನ್ನು ತ್ಯಜಿಸಲು ನನಗೆ ಯಾವಾಗಲೂ ಸಾಧ್ಯವಾಗುತ್ತದೆ.",
      "fi_09": "ನನ್ನ ಸ್ನೇಹಗಳು ಮತ್ತು ಸಂಬಂಧಗಳೊಂದಿಗೆ ನನಗೆ ತೃಪ್ತಿಯಾಗಿದೆ.",
      "fi_10": "ನನ್ನ ಸಂಬಂಧಗಳು ನಾನು ಬಯಸಿದ ಹಾಗೆಯೇ ಅಷ್ಟೇ ತೃಪ್ತಿಕರವಾಗಿವೆ.",
      "fi_11": "ಸಾಮಾನ್ಯ ಮಾಸಿಕ ಜೀವನ ವೆಚ್ಚವನ್ನು ಪೂರೈಸಲು (ಭರಿಸಲು) ಸಾಧ್ಯವಾಗಿರುವುದರ ಬಗ್ಗೆ ಎಷ್ಟು ಸಮಯಕ್ಕೊಮ್ಮೆ ನೀವು ಚಿಂತಿಸುವಿರಿ?",
      "fi_rs_worry_r10": "ಎಂದಿಗೂ ಚಿಂತಿಸುವುದಿಲ್ಲ",
      "fi_rs_worry_r0": "ಎಲ್ಲಾ ಸಮಯದಲ್ಲಿ ಚಿಂತಿಸುತ್ತೇನೆ",
      "fi_12": "ನೀವು ಎಷ್ಟು ಸಮಯಕ್ಕೊಮ್ಮೆ ಸುರಕ್ಷತೆ, ಆಹಾರ, ಅಥವಾ ವಸತಿ ಬಗ್ಗೆ ಚಿಂತಿಸುವಿರಿ?"
    },
    "ml": {
      "fi_01": "മൊത്തത്തില്‍ , ഈ ദിവസങ്ങളില്‍ താങ്കള്‍ താങ്കളുടെ ജീവിതവുമായി ആകെ മൊത്തത്തില്‍ എത്രത്തോളം സംതൃപ്തനാണ് ?",
      "fi_rs_satisfied_r10": "താങ്കളുടെ ജീവിതവുമായി പൂര്‍ണ്ണ സംതൃപ്തി",
      "fi_rs_satisfied_r0": "താങ്കളുടെ ജീവിതവുമായി ഒട്ടും തന്നെ സംതൃപ്തി ഇല്ല",
      "fi_02": "പൊതുവേ , സാധാരണയായി എത്രത്തോളം സന്തുഷ്ടി അല്ലെങ്കില്‍ അസന്തുഷ്ടി തനകള്‍ക്ക് തോന്നാറുണ്ട് ?",
      "fi_rs_happy_r10": "അങ്ങേയറ്റം സന്തുഷ്ടന്‍",
      "fi_rs_happy_r0": "അങ്ങേയറ്റം അസന്തുഷ്ടന്‍",
      "fi_03": "പൊതുവേ, താങ്കളുടെ ശാരീരിക ആരോഗ്യത്തെ താങ്കള്‍ എങ്ങനെ വിലയിരുത്തും?",
      "fi_rs_physical_r10": "മികച്ച ശാരീരിക ആരോഗ്യം",
      "fi_rs_physical_r0": "മോശം ശാരീരിക ആരോഗ്യം",
      "fi_04": "താങ്കളുടെ മാനസിക ആരോഗ്യത്തെ താങ്കള്‍ എങ്ങനെ വിലയിരുത്തുന്നു?",
      "fi_rs_mental_r10": "മികച്ച മാനസിക ആരോഗ്യം",
      "fi_rs_mental_r0": "മോശം മാനസിക ആരോഗ്യം",
      "fi_05": "മൊത്തത്തില്‍, താങ്കളുടെ ജീവിതത്തില്‍ താങ്കള്‍ ചെയ്യുന്ന കാര്യങ്ങള്‍ എല്ലാം എത്രത്തോളം മൂല്യം ഉള്ളതാണെന്നാണ് താങ്കള്‍ കരുതുന്നത്?",
      "fi_rs_worthwhile_r10": "പൂര്‍ണ്ണമായും മൂല്യമുള്ളത്",
      "fi_rs_worthwhile_r0": "ഒട്ടും തന്നെ മൂല്യമുള്ളതല്ല",
      "fi_06": "ജീവിതത്തില്‍ എന്‍റെ ആവശ്യം എന്താണെന്ന് ഞാന്‍ മനസ്സിലാക്കുന്നു.",
      "fi_rs_agree_r10": "ശക്തമായി യോജിക്കുന്നു",
      "fi_rs_agree_r0": "ശക്തമായി വിയോജിക്കുന്നു",
      "fi_07": "എല്ലാ സന്ദര്‍ഭങ്ങളിലും, ബുദ്ധിമുട്ടുള്ളതും വെല്ലുവിളി നിറഞ്ഞ സന്ദര്‍ഭങ്ങളിലും ഞാന്‍ എല്ലായിപ്പോഴും നല്ലതിനെ പ്രോത്സാഹിപ്പിക്കുവാന്‍ ശ്രമിക്കുന്നു.",
      "fi_rs_trueme_r10": "എന്നെ സംബന്ധിച്ച് പൂര്‍ണ്ണമായും ശരിയാണ്",
      "fi_rs_trueme_r0": "എന്നെ സംബന്ധിച്ച് ഒട്ടും ശരിയല്ല",
      "fi_08": "പിന്നീടുള്ള വലിയ സന്തോഷത്തിന് വേണ്ടി ഇപ്പോള്‍ ചില സന്തോഷങ്ങള്‍ വേണ്ടാന്ന് വെയ്ക്കുവാന്‍ എനിക്കു എല്ലായിപ്പോഴും കഴിയാറുണ്ട്.",
      "fi_09": "എന്‍റെ സൌഹൃദങ്ങളിലും ബന്ധങ്ങളിലും ഞാന്‍ സംതൃപ്തനാണ്.",
      "fi_10": "എന്‍റെ ബന്ധങ്ങള്‍ എല്ലാം ഞാന്‍ ആഗ്രഹിക്കുന്നത് പോലെ തന്നെ സംതൃപ്തി നല്‍കുന്നതാണ്.",
      "fi_11": "സാധാരണ പ്രതിമാസ ജീവിതചെലവുകള്‍ നടത്തുവാന്‍ കഴിയുന്നതിനെ കുറിച്ച് താങ്കള്‍ എത്ര ഇടവിട്ട് വിഷമിക്കാറുണ്ട്?",
      "fi_rs_worry_r10": "ഒരിയ്ക്കലും വിഷമിച്ചിട്ടില്ല",
      "fi_rs_worry_r0": "എല്ലായിപ്പോഴും വിഷമിക്കുന്നു",
      "fi_12": "സുരക്ഷിതത്വം, ഭക്ഷണം, പാര്‍പ്പിടം എന്നിവയെ കുറിച്ച് താങ്കള്‍ എത്ര ഇടവിട്ടാണ് വിഷമിക്കാറുള്ളത്?"
    },
    "mr": {
      "fi_01": "एकंदरीत, ह्या दिवसांत तुम्ही संपूर्ण जीवनात कितपत संतुष्ट आहात?",
      "fi_rs_satisfied_r10": "तुमच्या जीवनासोबत पूर्णपणे संतुष्ट",
      "fi_rs_satisfied_r0": "तुमच्या जीवनासोबत अजिबात संतुष्ट नाही",
      "fi_02": "सर्वसाधारणपणे, सहसा तुम्हाला किती आनंदी किंवा दुखी वाटते?",
      "fi_rs_happy_r10": "अत्य़ंत आनंदी",
      "fi_rs_happy_r0": "अत्यंत दुखी",
      "fi_03": "सर्वसाधारणपणे, तुम्ही तुमच्या शारीरिक आरोग्यला कसे रेट कराल?",
      "fi_rs_physical_r10": "सर्वात चांगले शारीरिक आरोग्य",
      "fi_rs_physical_r0": "खराब शारीरिक आरोग्य",
      "fi_04": "तुम्ही तुमच्या एकंदरीत मानसिक आरोग्याला कसे रेट कराल?",
      "fi_rs_mental_r10": "सर्वात चांगले मानसिक आरोग्य",
      "fi_rs_mental_r0": "खराब मानसिक आरोग्य",
      "fi_05": "एकंदरीत, तुम्ही तुमच्या आयुष्यात करत असलेल्या गोष्टी कितपत योग्य वाटतात?",
      "fi_rs_worthwhile_r10": "पूर्णपणे योग्य",
      "fi_rs_worthwhile_r0": "अजिबात योग्य नाहीत",
      "fi_06": "मला माझा जीवनाचा उद्देश समजला आहे.",
      "fi_rs_agree_r10": "पूर्णपणे सहमत",
      "fi_rs_agree_r0": "पूर्णपणे असहमत",
      "fi_07": "मी नेहमी सर्व परिस्थितींमध्ये, कठीण आणि आव्हानात्मक परिस्थितींमध्येही चांगल्या गोष्टींना प्रोत्साहन देण्यासाठी कार्य करतो/करते.",
      "fi_rs_trueme_r10": "माझ्यासाठी संपूर्ण योग्य आहे.",
      "fi_rs_trueme_r0": "माझ्यासाठी अजिबात योग्य नाही.",
      "fi_08": "नंतरच्या मोठ्या आनंदासाठी मी नेहमीच थोडासा आनंद सोडू शकतो/शकते.",
      "fi_09": "मी माझ्या मैत्री आणि नातेसंबंधांसोबत संतुष्ट आहे.",
      "fi_10": "माझे नातेसंबंध जितके समाधानकारक आहेत तितकेच मला ते असावेत असे वाटते.",
      "fi_11": "सामान्य मासिक राहणीमानाचा खर्च पूर्ण करणे शक्य असण्याबद्दल तुम्हाला किती वेळा काळजी वाटते?",
      "fi_rs_worry_r10": "कधीच काळजी करत नाही",
      "fi_rs_worry_r0": "सर्व वेळ काळजी करतो/करते",
      "fi_12": "तुम्ही किती वेळा सुरक्षितता, अन्न किंवा घराबद्दल काळजी करता?"
    },
    "or": {
      "fi_01": "ମୋଟାମୋଟି ଭାବେ, ଆଜିକାଲି ଆପଣ ସାମଗ୍ରିକ ଭାବରେ ଜୀବନରେ କେତେ ସନ୍ତୁଷ୍ଟ?",
      "fi_rs_satisfied_r10": "ଆପଣଙ୍କ ଜୀବନରେ ସମ୍ପୂର୍ଣ୍ଣ ସନ୍ତୁଷ୍ଟ",
      "fi_rs_satisfied_r0": "ଆପଣଙ୍କ ଜୀବନରେ ଆଦୌ ସନ୍ତୁଷ୍ଟ ନୁହଁନ୍ତି",
      "fi_02": "ସାଧାରଣତଃ, ଆପଣ ସାଧାରଣତଃ କେତେ ସନ୍ତୁଷ୍ଟ କିମ୍ବା ଅସନ୍ତୁଷ୍ଟ ଅନୁଭବ କରନ୍ତି?",
      "fi_rs_happy_r10": "ଅତ୍ୟନ୍ତ ସନ୍ତୁଷ୍ଟ",
      "fi_rs_happy_r0": "ଅତ୍ୟନ୍ତ ଅସନ୍ତୁଷ୍ଟ",
      "fi_03": "ସାଧାରଣତଃ, ଆପଣ ଆପଣଙ୍କ ଶାରୀରିକ ସ୍ୱାସ୍ଥ୍ୟକୁ କିପରି ମୂଲ୍ୟାଙ୍କନ କରିବେ?",
      "fi_rs_physical_r10": "ଉତ୍କୃଷ୍ଟ ଶାରୀରିକ ସ୍ୱାସ୍ଥ୍ୟ",
      "fi_rs_physical_r0": "ଖରାପ ଶାରୀରିକ ସ୍ୱାସ୍ଥ୍ୟ",
      "fi_04": "ଆପଣ ଆପଣଙ୍କ ସାମଗ୍ରିକ ମାନସିକ ସ୍ୱାସ୍ଥ୍ୟକୁ କିପରି ମୂଲ୍ୟାଙ୍କନ କରିବେ?",
      "fi_rs_mental_r10": "ଉତ୍କୃଷ୍ଟ ମାନସିକ ସ୍ୱାସ୍ଥ୍ୟ",
      "fi_rs_mental_r0": "ଖରାପ ମାନସିକ ସ୍ୱାସ୍ଥ୍ୟ",
      "fi_05": "ମୋଟାମୋଟି ଭାବରେ, ଆପଣ ଆପଣଙ୍କ ଜୀବନରେ କରୁଥିବା ଜିନିଷଗୁଡ଼ିକ କେତେ ପରିମାଣରେ ମୂଲ୍ୟବାନ ବୋଲି ଅନୁଭବ କରୁଛ?",
      "fi_rs_worthwhile_r10": "ସମ୍ପୂର୍ଣ୍ଣ ମୂଲ୍ୟବାନ",
      "fi_rs_worthwhile_r0": "ଆଦୌ ମୂଲ୍ୟବାନ ନୁହେଁ",
      "fi_06": "ମୁଁ ଜୀବନରେ ମୋର ଉଦ୍ଦେଶ୍ୟ ବୁଝିପାରୁଛି।",
      "fi_rs_agree_r10": "ଦୃଢ ଭାବରେ ସହମତ",
      "fi_rs_agree_r0": "ଦୃଢ ଭାବରେ ଅସହମତ",
      "fi_07": "କଠିନ ଏବଂ ଅସୁବିଧାପୂର୍ଣ୍ଣ ପରିସ୍ଥିତିରେ ମଧ୍ୟ ମୁଁ ସବୁବେଳେ ସମସ୍ତ ପରିସ୍ଥିତିରେ ଭଲକୁ ପ୍ରୋତ୍ସାହିତ କରିବା ପାଇଁ କାର୍ଯ୍ୟ କରେ|",
      "fi_rs_trueme_r10": "ମୋ ବିଷୟରେ ସମ୍ପୂର୍ଣ୍ଣ ସତ୍ୟ",
      "fi_rs_trueme_r0": "ମୋ ବିଷୟରେ ଆଦୌ ସତ୍ୟ ନୁହେଁ",
      "fi_08": "ପରେ ଅଧିକ ଖୁସି ପାଇଁ ମୁଁ ବର୍ତ୍ତମାନ କିଛି ଖୁସି ଛାଡିବାକୁ ସକ୍ଷମ|",
      "fi_09": "ମୁଁ ମୋର ବନ୍ଧୁତା ଏବଂ ସମ୍ପର୍କରେ ସନ୍ତୁଷ୍ଟ|",
      "fi_10": "ମୋର ସମ୍ପର୍କ ଯେତିକି ସନ୍ତୋଷଜନକ, ମୁଁ ଚାହିଁବି ଯେ ସେମାନେ ହୁଅନ୍ତୁ|",
      "fi_11": "ସାଧାରଣ ମାସିକ ଜୀବନ ଯାପନ ଖର୍ଚ୍ଚ ପୂରଣ କରିବାରେ ସକ୍ଷମ ହେବା ବିଷୟରେ ଆପଣ କେତେ ଥର ଚିନ୍ତା କରନ୍ତି?",
      "fi_rs_worry_r10": "କେବେ ଚିନ୍ତା କରନ୍ତୁ ନାହିଁ",
      "fi_rs_worry_r0": "ସବୁବେଳେ ଚିନ୍ତା କର |",
      "fi_12": "ଆପଣ କେତେ ଥର ନିରାପତ୍ତା, ଖାଦ୍ୟ, କିମ୍ବା ଗୃହ ବିଷୟରେ ଚିନ୍ତା କରନ୍ତି?"
    },
    "pcm": {
