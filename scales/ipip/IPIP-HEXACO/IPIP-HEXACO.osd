      "ipip_X86": "Gillar inte konst",
      "ipip_Q5": "Darrar i farliga situationer",
      "ipip_D102": "Skulle känna mig mycket dålig en lång tid om jag stal från någon",
      "ipip_C8": "Känner mig frisk och livfull för det mesta",
      "ipip_Q222": "Försöker inte oroa mig för politiska och samhälleliga problem",
      "ipip_H1293": "Upptäcker misstag",
      "ipip_X123": "Tror på betydelsen av konst",
      "ipip_E120": "Klagar sällan",
