  "translations": {
    "en": {
      "bsjo_inst": "There are many different views as to what makes a society fair or unfair. How much do you agree or disagree with each statement?",
      "bsjo01": "A society is fair when income and wealth are equally distributed among all people.",
      "bsjo02": "A society is fair when it takes care of those who are poor and in need regardless of what they give back to society.",
      "bsjo03": "A society is fair when hard-working people earn more than others.",
      "bsjo04": "A society is fair when people from families with high social status enjoy privileges in their lives.",
      "bsjo_r1": "Agree completely",
      "bsjo_r2": "Agree",
      "bsjo_r3": "Neither agree nor disagree",
      "bsjo_r4": "Disagree",
      "bsjo_r5": "Disagree completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
