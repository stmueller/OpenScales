      "ipip_H893": "Do unexpected things.",
      "ipip_E35": "Enjoy being reckless.",
      "ipip_H21": "Am interested in people.",
      "ipip_X165": "Am not really interested in others.",
      "ipip_H1151": "Cheer people up.",
      "ipip_H1": "Feel at ease with people.",
      "ipip_H660": "Want to be left alone.",
      "ipip_X169": "Dislike being the center of attention.",
      "ipip_X78": "Don't mind being the center of attention.",
      "ipip_H1039": "Have little to say.",
      "ipip_H1110": "Know how to captivate people.",
