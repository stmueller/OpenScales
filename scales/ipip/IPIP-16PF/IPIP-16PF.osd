    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_X10": "Retko obraćam pažnju na svoje emocionalne reakcije.",
      "ipip_E157": "Verujem u ono što drugi kažu.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_H334": "Često preuzimam stvari na sebe.",
      "ipip_H1278": "Brzo učim.",
      "ipip_E100": "Ne smetaju mi neuredni ljudi.",
      "ipip_H1195": "Ne verujem ljudima.",
      "ipip_H660": "Često želim da me ostave na miru.",
      "ipip_H2027": "Volim da čitam.",
      "ipip_E150": "Ne brinem o onome što se već dogodilo.",
      "ipip_E56": "Uživam kada sam deo glasnog društva.",
      "ipip_X80": "Verujem da su ljudi u suštini zli.",
      "ipip_H1227": "Podižem razgovor na viši nivo.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_X210": "Teško opraštam drugima.",
      "ipip_H368": "Ne dozvoljavam drugima da me obeshrabre.",
      "ipip_H1360": "Suprotstavljam se mišljenju drugih.",
      "ipip_X189": "Verujem da su ljudi u suštini moralni.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_X165": "Nisam preterano zainteresovan za druge.",
      "ipip_X119": "Ne volim akcione filmove.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H822": "Ostavljam nered u svojoj sobi.",
      "ipip_X129": "Osećam se prijatno kad provodim vreme sam.",
      "ipip_E125": "Sklon sam analiziranju stvari.",
      "ipip_H250": "Radim stvari \"po PS-u\".",
      "ipip_H1146": "Svoja osećanja zadržavam za sebe..",
      "ipip_E45": "Suprotstavljam se autoritetu.",
      "ipip_H893": "Radim neočekivane stvari.",
      "ipip_H604": "Često sumnjam da drugi ljudi imaju skrivene namere.",
      "ipip_H2016": "Uživam da budem deo grupe.",
      "ipip_H1346": "Često prekršim pravila..",
      "ipip_E168": "Osećam se krivim kada nekome kažem \"Ne.\".",
      "ipip_X118": "Volim red.",
      "ipip_E82": "Iritira me kada drugi greše.",
      "ipip_H107": "Činim da se ljudi osećaju spokojno.",
      "ipip_H286": "Ono što radim, dovodim do savršenstva.",
      "ipip_E163": "Volim da odlutam u mislima.",
      "ipip_H113": "Verujem drugim ljudima.",
      "ipip_H1218": "Promislim pre nego što nešto uradim.",
      "ipip_X238": "Uživam u neobuzdanim maštarijama.",
      "ipip_H1026": "Dopuštam da me drugi maltretiraju.",
      "ipip_H947": "Često se osećam očajno.",
      "ipip_X225": "Volim da smišljam nove načine kako da uradim nesto.",
      "ipip_H976": "Prepuštam vođstvo drugima.",
      "ipip_X85": "Otvoreno pokazujem drugima kakav sam.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_E166": "Trudim se da ne razmišljam o siromašnima.",
      "ipip_H1042": "Nikada ne preispitujem stvari.",
      "ipip_X88": "Uživam da provodim vreme sam.",
      "ipip_H549": "Verujem da drugi ljudi imaju dobre namere.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_X254": "Volim da stojim za vreme nacionalne himne.",
      "ipip_H691": "Radim stvari koje drugima deluju čudno.",
      "ipip_H1093": "Zabavljam svoje prijatelje.",
      "ipip_H2013": "Iskazujem svoje intimne misli.",
      "ipip_X139": "Verujem da ljudi retko ispričaju celu priču.",
      "ipip_X23": "Nije me lako iznervirati",
      "ipip_H3": "Pokazujem svoja osećanja.",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_H682": "Najviše volim da radim sam.",
      "ipip_E94": "Uživam u tišini.",
      "ipip_H905": "Plaši me da ću učiniti nešto pogrešno.",
      "ipip_H1090": "Zauzimam neuobičajene stavove.",
      "ipip_H643": "Osećam se slomljeno zbog raznih neuspeha.",
      "ipip_H601": "Ne otkrivam puno o sebi.",
      "ipip_H1001": "Oprezan sam u odnosu sa drugima.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_H9": "Voljan sam da pričam o sebi.",
      "ipip_X59": "Ne iznerviram se lako.",
      "ipip_H34": "Uvek sam glavni na žurci.",
      "ipip_X230": "Ne volim fantastiku.",
      "ipip_H754": "Lako pobesnim.",
      "ipip_X215": "Ne volim glasnu muziku.",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_X204": "Više volim raznolikost od rutine.",
      "ipip_X138": "Ne potresam se lako zbog stvari.",
      "ipip_H612": "Lako se osetim ugroženim.",
      "ipip_H1151": "Umem da razveselim ljude.",
      "ipip_H22": "Za svakog imam lepu reč.",
      "ipip_X135": "Retko sanjarim.",
      "ipip_H964": "Prepuštam drugima da donose odluke.",
      "ipip_X35": "Veujem da postoji samo jedna prava religija.",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_E111": "Ponekad opsujem.",
      "ipip_H965": "Ne mogu bez društva drugih ljudi.",
      "ipip_H325": "Preuzimam kontrolu nad stvarima.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X161": "Volim da zbližavam ljude.",
      "ipip_X178": "Mislim da se zakoni trebaju strogo primenjivati.",
      "ipip_X150": "Trudim se da se pridržavam pravila.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_X125": "Smatram sebe prosečnom osobom.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_E47": "Volim da diskutujem o filmovima i knjigama sa drugim ljudima.",
      "ipip_H2032": "Mnogo čitam.",
      "ipip_H353": "Šta god da radim, odmeravam prednosti i nedostatke.",
      "ipip_E114": "Provodim dosta vremena razmišljajući o greškama iz prošlosti.",
      "ipip_H86": "Često zbijam šale.",
      "ipip_H498": "Suprotstavljam se autoritetu.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_E83": "Volim svoju privatnost.",
      "ipip_X239": "Ne zanimaju me teorijske rasprave.",
      "ipip_H602": "Potrebna mi je tišina.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_E132": "Sklon sam da odlažem neprijatne zadatke.",
      "ipip_X28": "Imam siromašan rečnik.",
      "ipip_H1215": "Mislim svojm glavom.",
      "ipip_E72": "Ne smeta mi da jedem sam.",
      "ipip_X99": "Ne volim događaje na kojima je gužva.",
      "ipip_H78": "Volim velike žurke.",
      "ipip_H173": "Umem da utešim druge.",
      "ipip_X175": "Retko se izgubim u mislima.",
      "ipip_H1358": "Imam pronicljiva zapažanja.",
      "ipip_H641": "Lako me je izbaciti iz takta.",
      "ipip_H2011": "Plačem dok gledam filmove.",
      "ipip_H292": "Ne mogu da podnesem da mi neko protivreči.",
      "ipip_H409": "Umem primeniti drastične mere.",
      "ipip_H987": "Lako me je povrediti.",
      "ipip_H459": "Ne plašim se da uputim kritiku.",
      "ipip_H1267": "Znam odgovore na mnoga pitanja.",
      "ipip_H160": "Odvajam vreme za druge.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_E119": "Svoje obaveze obavljam odmah.",
      "ipip_E11": "Želim da sve bude \"baš kako treba\".",
      "ipip_H1129": "Interesujem se za živote drugih ljudi.",
      "ipip_E69": "Sudim o drugima na osnovu njihovog izgleda.",
      "ipip_H44": "Lako prevazilazim teškoće.",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_E77": "Retko tragam za nekim dubljim smislom.",
      "ipip_H1447": "Poslednji se smejem šali.",
      "ipip_X243": "Ne volim da gledam plesne nastupe.",
      "ipip_X248": "Izbegavam filozofske diskusije.",
      "ipip_X103": "Ne volim da se uključujem u probleme drugih ljudi.",
      "ipip_H690": "Često biram teži put.",
      "ipip_H1327": "Znam kako da zaobiđem pravila.",
      "ipip_X137": "Retko zbijam šalu.",
      "ipip_X271": "Uživam u timskom radu.",
      "ipip_E7": "Ne smeta mi nered.",
      "ipip_H296": "Poštujem autoritete.",
      "ipip_H336": "Uvek kažem ono što mislim.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_H855": "Lako se zbunim.",
      "ipip_H588": "Svoje misli zadržavam za sebe.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_X71": "Volim da sanjarim.",
      "ipip_H871": "Često se ponašam divlje i razuzdano.",
      "ipip_H1439": "Preskačem komplikovane reči dok čitam.",
      "ipip_H793": "Želim da budem glavni.",
      "ipip_X15": "Ne sviđam se sam sebi.",
      "ipip_X148": "Otvoreno pokazujem svoja osećanja.",
      "ipip_X140": "Volim cveće.",
      "ipip_E65": "Brzo sudim o drugim ljudima.",
      "ipip_X166": "Volim da čujem nove ideje.",
      "ipip_X234": "Znam da nisam poseban.",
      "ipip_H823": "Često ostavljam svoje stvari svuda unaokolo.",
