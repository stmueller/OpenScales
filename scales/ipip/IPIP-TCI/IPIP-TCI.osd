      "ipip_E111": "Ponekad opsujem.",
      "ipip_H328": "Znam šta želim.",
      "ipip_H524": "Pokušavam da predvodim druge.",
      "ipip_E170": "Radim na sopstvenom usavršavanju.",
      "ipip_E174": "Strastven sam u kada su u pitanju izazovi.",
      "ipip_H1327": "Znam kako da zaobiđem pravila.",
