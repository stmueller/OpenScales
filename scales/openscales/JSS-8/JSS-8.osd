  "translations": {
    "en": {
      "jss_8_inst": "People react to unfair situations in very different ways. In the following, we would like to know how you would react in unfair situations. Please read the statements below and indicate to what extent each of these statements applies to you. If you have never experienced such a situation yourself, try to imagine how you would react if you were in such a situation.",
      "jss_801": "It makes me angry when others are undeservingly better off than me.",
      "jss_802": "It worries me when I have to work hard for things that come easily to others.",
      "jss_803": "I am upset when someone is undeservingly worse off than others.",
      "jss_804": "It worries me when someone has to work hard for things that come easily to others.",
      "jss_805": "I feel guilty when I am better off than others for no reason.",
      "jss_806": "It bothers me when things come easily to me that others have to work hard for.",
      "jss_807": "I feel guilty when I enrich myself at the cost of others.",
      "jss_808": "It bothers me when I use tricks to achieve something while others have to struggle for it.",
      "jss_8_r1": "Does not apply at all",
      "jss_8_r6": "Applies completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}