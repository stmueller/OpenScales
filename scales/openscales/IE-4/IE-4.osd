  "translations": {
    "en": {
      "ie_4_inst": "The following statements may apply more or less to you. To what extent do you think each statement applies to you personally?",
      "ie_401": "I'm my own boss.",
      "ie_402": "If I work hard, I will succeed.",
      "ie_403": "Whether at work or in my private life: What I do is mainly determined by others.",
      "ie_404": "Fate often gets in the way of my plans.",
      "ie_4_r1": "Does not apply at all",
      "ie_4_r5": "Applies completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
