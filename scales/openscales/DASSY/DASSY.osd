    "scoring": {
      "Depression": {
        "method": "sum_coded",
        "description": "Depression subscale — sum of items 1–7",
        "items": {
          "DASSY001": 1,
          "DASSY002": 1,
          "DASSY003": 1,
          "DASSY004": 1,
          "DASSY005": 1,
          "DASSY006": 1,
          "DASSY007": 1
