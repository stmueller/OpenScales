    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H1265": "Volim da učim nešto novo.",
      "ipip_X239": "Ne zanimaju me teorijske rasprave.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_P432": "Imam prirodni talenat da utičem na druge ljude.",
      "ipip_P464": "Verujem da treba biti umeren u seksu.",
      "ipip_P420": "Brinem o tome šta drugi misle o meni.",
      "ipip_E173": "Pokušavam da budem objektivan prema sebi.",
      "ipip_H969": "Potreban mi je podsticaj da bih nešto započeo.",
      "ipip_X263": "Pravim planove i pridržavam ih se.",
      "ipip_P385": "Premalo radim.",
      "ipip_X254": "Volim da stojim za vreme nacionalne himne.",
      "ipip_H627": "Provodim vreme ne radeći ništa.",
      "ipip_X161": "Volim da zbližavam ljude.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_E126": "Trudim se da oprostim i zaboravim.",
      "ipip_X136": "Nikada ne bih utajio porez.",
      "ipip_E55": "Volim žurke iznenađenja.",
      "ipip_P479": "Posvećen sam religiji.",
      "ipip_H175": "Razumem ljude koji razmišljaju drugačije od mene.",
      "ipip_H126": "Drugi su mi na prvom mestu.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_X59": "Ne iznerviram se lako.",
      "ipip_H1049": "Radim ono što i drugi.",
      "ipip_H1056": "Prilagođavam se tuđem mišljenju",
      "ipip_H1213": "Želim da uvećam svoje znanje.",
      "ipip_X253": "Duboko me potresaju tuđe nesreće.",
      "ipip_P346": "Nemam talenat da utičem na druge.",
      "ipip_P458": "U životu se vodim religijskim pravilima.",
      "ipip_X198": "Varam da bih napredovao.",
      "ipip_H579": "Mislim da zakoni ne važe za mene.",
      "ipip_H910": "Ne volim promene.",
      "ipip_H992": "Lako se rasplačem.",
      "ipip_H909": "Često mi je neprijatno u prisustvu drugih ljudi.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_H54": "Uvek sam u pokretu.",
      "ipip_H589": "Volim da svoje privatne stvari zadržim za sebe.",
      "ipip_H988": "Žao mi je kada vidim da je drugima teško.",
      "ipip_H587": "Najviše volim da budem sam.",
      "ipip_H2012": "Lako se rasplačem.",
      "ipip_X29": "Retko reagujem emotivno.",
      "ipip_H510": "Želim da se razlikujem od drugih ljudi.",
      "ipip_H647": "Lako se obeshrabrim.",
      "ipip_X86": "Ne volim umetnost.",
      "ipip_X144": "Ne volim koncerte.",
      "ipip_X92": "Intenzivno doživljavam svoje emocije.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_P392": "Sumnjam u vrednost religije.",
      "ipip_X218": "Sklon sam da glasam za liberalne političare.",
      "ipip_X157": "Verujem da treba da budemo nepopustljivi prema kriminalu.",
      "ipip_E71": "Nikada se ne bih upuštao u rizične investicije.",
      "ipip_P436": "Želim da me drugi ljudi smatraju posebnim.",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_E132": "Sklon sam da odlažem neprijatne zadatke.",
      "ipip_X250": "Nikada ne bih išao na paraglajding ili bandži- džamping.",
      "ipip_E91": "Održavam kontakte sa starim poznanicima.",
      "ipip_P354": "Osećam da je u redu to što se nekima ne dopadam.",
      "ipip_X126": "Sklon sam da glasam za konzervativne političare.",
      "ipip_X174": "Političke diskusije su mi zanimljive.",
      "ipip_X235": "Ne prijaju mi odlasci u muzeje.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_H1125": "Često povređujem druge ljude.",
      "ipip_P364": "Dobar sam u spontanim govorima.",
      "ipip_H1137": "Mogu da nagovorim druge da nešto urade.",
      "ipip_H1186": "Često traćim svoje vreme.",
      "ipip_H894": "Tragam za opasnošću.",
      "ipip_H554": "Obavljam dosta posla.",
      "ipip_E171": "Nastojim da izbegavam \"teške\" ljude.",
      "ipip_P434": "Mrzim da budem u centru pažnje.",
      "ipip_P365": "Osećam duhovnu povezanost s drugim ljudima.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H1221": "Želim da formiram sopstveno mišljenje.",
      "ipip_H1327": "Znam kako da zaobiđem pravila.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_P367": "Nikada ne bih uzeo nešto što nije moje.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_H58": "Uvek sam zauzet.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_P397": "Nije mi stalo da ostavim dobar utisak.",
      "ipip_X225": "Volim da smišljam nove načine kako da uradim nesto.",
      "ipip_H79": "U slobodno vreme radim mnoge stvari.",
      "ipip_X62": "Otvoren sam za promene.",
      "ipip_P353": "Verujem u jednakost svih rasa.",
      "ipip_E133": "Uživam u preispitivanju sebe i svog života.",
      "ipip_H88": "Ne poštujem pravila.",
      "ipip_H2021": "Interesuju me mnoge stvari.",
      "ipip_H1392": "Nisam sklon da se previše udubljujem u problem.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_H294": "Držim se pravila.",
      "ipip_P407": "Lako mi je da manipulišem drugima.",
      "ipip_E47": "Volim da diskutujem o filmovima i knjigama sa drugim ljudima.",
      "ipip_P477": "Živim laganim životom.",
      "ipip_X35": "Veujem da postoji samo jedna prava religija.",
      "ipip_P461": "Teško mi je da manipulišem drugima.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_X248": "Izbegavam filozofske diskusije.",
      "ipip_H457": "Mogu da obavljam više stvari istovremeno.",
      "ipip_X30": "Radije se držim stvari koje znam.",
      "ipip_E156": "Ne razumem ljude koji su osetljivi.",
      "ipip_P488": "Ne smatram sebe religioznom osobom.",
      "ipip_X217": "Umem da budem zlopamtilo.",
      "ipip_X265": "Retko se iznerviram.",
      "ipip_H736": "Mislim da sam bolji od drugih."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_H1265": "Älskar att lära mig nya saker",
      "ipip_X239": "Är inte intresserad av teoretiska diskussioner",
      "ipip_X78": "Har inte något emot att vara centrum för uppmärksamheten",
      "ipip_P432": "Har en naturligt talang för att påverka människor",
      "ipip_P464": "Tror på sexuell anständighet",
      "ipip_P420": "Oroar mig över vad människor tänker om mig",
      "ipip_E173": "Försöker att undersöka mig själv objektivt",
      "ipip_H969": "Behöver en knuff för att komma igång",
      "ipip_X263": "Gör upp planer och håller mig till dem",
      "ipip_P385": "Gör lite arbete",
      "ipip_X254": "Får en positiv känsla när nationalsången spelas",
      "ipip_H627": "Står bara och hänger och gör inget",
      "ipip_X161": "Tycker om att föra samman människor",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_E126": "Försöker glömma och förlåta",
      "ipip_X136": "Skulle aldrig fuska med skatten",
      "ipip_E55": "Älskar överraskningspartyn",
      "ipip_P479": "Är hängiven religion",
      "ipip_H175": "Förstår människor som tänker annorlunda",
      "ipip_H126": "Tänker först på andra",
      "ipip_X179": "Följer ett schema",
      "ipip_X211": "Älskar att läsa tankeväckande skrifter",
      "ipip_X59": "Är svår att frustrera",
      "ipip_H1049": "Gör som andra gör",
      "ipip_H1056": "Rättar mig efter andras åsikter",
      "ipip_H1213": "Vill öka mina kunskaper",
      "ipip_X253": "Blir djupt berörd av andras olyckor",
      "ipip_P346": "Saknar talangen att påverka andra",
      "ipip_P458": "Tar vägledning i livet från religiösa skrifter",
      "ipip_X198": "Fuskar för att bli bäst",
      "ipip_H579": "Anser inte att lagar gäller mig",
      "ipip_H910": "Gillar inte tanken på förändring",
      "ipip_H992": "Rörs lätt till tårar",
      "ipip_H909": "Känner mig ofta obehaglig till mods bland andra",
      "ipip_X45": "Gillar inte poesi",
      "ipip_H54": "Är alltid på gång",
      "ipip_H589": "Är mycket privat som person",
      "ipip_H988": "Lider under andras sorger",
      "ipip_H587": "Föredrar att vara ensam",
      "ipip_H2012": "Gråter lätt",
      "ipip_X29": "Blir sällan emotionell",
      "ipip_H510": "Vill vara olika andra",
      "ipip_H647": "Blir lätt modfälld",
      "ipip_X86": "Gillar inte konst",
      "ipip_X144": "Gillar inte konserter",
      "ipip_X92": "Upplever mina känslor intensivt",
      "ipip_X109": "Undviker svårlästa artiklar och böcker",
      "ipip_P392": "Tvivlar på värdet av religion",
      "ipip_X218": "Brukar rösta på partier som bryr sig om människor",
      "ipip_X157": "Tycker att vi skall vara tuffa mot brottslighet",
      "ipip_E71": "Skulle aldrig göra en chansartad investering",
      "ipip_P436": "Vill att andra skall uppfatta mig som något speciellt",
      "ipip_X123": "Tror på betydelsen av konst",
      "ipip_E92": "Har ofta förekommande humörsvängningar",
      "ipip_E132": "Lägger obehagliga uppgifter åt sidan",
      "ipip_X250": "Skulle aldrig ägna mig åt hängflygning eller bungee-jumping",
      "ipip_E91": "Håller kontakt med gamla bekanta",
      "ipip_P354": "Tycker det är OK att vissa inte gillar mig",
      "ipip_X126": "Brukar rösta på de konservativa partierna",
      "ipip_X174": "Tycker att politiska diskussioner är intressanta",
      "ipip_X235": "Gillar inte att gå på konstmuseum",
      "ipip_X228": "Är inte intresserad av abstrakta idéer",
      "ipip_H1125": "Gör människor illa",
      "ipip_P364": "Är bra på att hålla oförberedda tal",
      "ipip_H1137": "Kan övertala andra att göra saker",
      "ipip_H1186": "Slösar bort min tid",
      "ipip_H894": "Söker faran",
      "ipip_H554": "Får en massa arbete gjort",
      "ipip_E171": "Försöker undvika komplicerade personer",
      "ipip_P434": "Ogillar att stå i centrum för uppmärksamheten",
      "ipip_P365": "Känner mig andligen besläktad med andra människor",
      "ipip_H1276": "Har ett rikt ordförråd",
      "ipip_H1221": "Vill forma mina egna åsikter",
      "ipip_H1327": "Vet hur man kommer runt reglerna",
      "ipip_X95": "Blir lätt upprörd",
      "ipip_P367": "Skulle aldrig ta något som inte var mitt",
      "ipip_X14": "Har en livlig fantasi",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_H58": "Är alltid upptagen",
      "ipip_H21": "Är intresserad av människor",
      "ipip_P397": "Att göra gott intryck är oväsentligt",
      "ipip_X225": "Älskar att tänka fram nya sätt att göra saker",
      "ipip_H79": "Gör massor på min fritid",
      "ipip_X62": "Är öppen för förändring",
      "ipip_P353": "Tror på likaberättigande för alla raser",
      "ipip_E133": "Tycker om att undersöka mig själv och mitt liv",
      "ipip_H88": "Struntar i regler",
      "ipip_H2021": "Är intresserad av många olika saker",
      "ipip_H1392": "Kommer inte att tränga djupt in i ett område",
      "ipip_X74": "Känner mig ofta nere",
      "ipip_H294": "Håller mig till reglerna",
      "ipip_P407": "Tycker det är lätt att manipulera andra",
      "ipip_E47": "Uppskattar att diskutera filmer och böcker med andra",
      "ipip_P477": "Har ett långsamt tempo i livet",
      "ipip_X35": "Tror på en sann religion",
      "ipip_P461": "Tycker det är svårt att manipulera andra",
      "ipip_H1039": "Har lite att säga",
      "ipip_X248": "Undviker filosofiska diskussioner",
      "ipip_H457": "Kan hantera många saker på en gång",
      "ipip_X30": "Föredrar att hålla mig till saker jag känner till",
      "ipip_E156": "Förstår inte människor som blir känslosamma",
