{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Big Five Inventory – Swahili Translation",
      "code": "MISS11207",
      "abbreviation": "BFI-sw",
      "description": "Swahili translation of the 44-item Big Five Inventory (BFI; John et al., 1991), validated in a sample of 200 Kenyan university students at Pwani University. The translation covers all five Big Five dimensions: Extraversion, Agreeableness, Conscientiousness, Neuroticism, and Openness. Psychometric evaluation found low-to-moderate reliability (alpha .49–.73) and only partial replication of the five-factor structure; Conscientiousness and Neuroticism were best replicated. Full BFI with Swahili translation available in restricted/BFI/BFI.osd.",
      "citation": "Garrashi, H. H., Barelds, D. P. H., & De Raad, B. (2023). A psychometric evaluation of the Big Five Inventory (BFI) in an Eastern Africa population. Measurement Instruments for the Social Sciences, 5, Article e11207. https://doi.org/10.5964/miss.11207",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/11207",
      "domain": "Personality",
      "version": "1.0",
      "see_also": "restricted/BFI/BFI.osd"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "This OSD contains only the Swahili translation from Garrashi et al. (2023) Appendix Table A. English item text and full OSD with both en and sw translations are in restricted/BFI/BFI.osd, as the original John et al. (1991) BFI items are restricted to non-commercial research use. Item order follows standard BFI numbering 1–44. Swahili response labels are not provided in the source; standard Swahili Likert labels used."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": ["bfi_r1", "bfi_r2", "bfi_r3", "bfi_r4", "bfi_r5"],
      "question_head": "bfi_qhead"
    },
    "dimensions": [
      {
        "id": "extraversion",
        "name": "Extraversion",
        "abbreviation": "E",
        "description": "8 items. Range 1–5; higher = more extraverted."
      },
      {
        "id": "agreeableness",
        "name": "Agreeableness",
        "abbreviation": "A",
        "description": "9 items. Range 1–5; higher = more agreeable."
      },
      {
        "id": "conscientiousness",
        "name": "Conscientiousness",
        "abbreviation": "C",
        "description": "9 items. Range 1–5; higher = more conscientious."
      },
      {
        "id": "neuroticism",
        "name": "Neuroticism",
        "abbreviation": "N",
        "description": "8 items (plus 3 shared reverse-scored). Range 1–5; higher = more neurotic."
      },
      {
        "id": "openness",
        "name": "Openness",
        "abbreviation": "O",
        "description": "10 items. Range 1–5; higher = more open."
      }
    ],
    "items": [
