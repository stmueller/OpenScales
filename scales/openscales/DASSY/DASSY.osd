    "zh-TW": {
      "DASSY015": "我為小事而煩惱",
      "DASSY014": "我感到頭暈眼花，就好像我快要暈倒",
      "DASSY006": "我對任何事都不感到興趣",
      "DASSY012": "我有呼吸困難（例如呼吸急促），即使我不是正在做運動及沒有生病",
      "DASSY001": "我討厭自己的生活",
      "DASSY017": "我覺得自己對事情反應過大",
      "DASSY013": "我感到手震",
      "DASSY019": "我對很多事情感到有壓力",
      "DASSY009": "我感到恐懼",
      "DASSY007": "沒有什麼好事情是我可以期待的",
      "DASSY016": "我很容易煩燥不安",
      "DASSY021": "我覺得很難放鬆下來",
      "DASSY005": "我無法停止感到傷心難過",
      "DASSY020": "當別人打擾我時，我很生氣",
      "DASSY008": "我感到自己快要恐慌了",
      "DASSY002": "我討厭自己",
      "DASSY004": "我覺得自己一無是處",
      "DASSY018": "我很容易生氣",
      "DASSY011": "我能感覺到我的心跳得非常快，即使我沒有做任何劇烈運動",
      "DASSY010": "我無緣無故感到害怕",
      "DASSY003": "我覺得生活很痛苦",
      "DASSY_head": "請閱讀每個句子，並圈出最能表示你在過去一星期狀況的數字。",
      "DASSY_r0": "不真確",
      "DASSY_r1": "有少少真確",
      "DASSY_r2": "頗為真確",
      "DASSY_r3": "十分真確"
    },
    "zh": {
      "DASSY015": "因为一些小事，我感到烦恼。",
      "DASSY014": "我感觉头晕，好像要晕倒了。",
      "DASSY006": "我什么都没有享受（到）。",
      "DASSY012": "我不做运动、也没有生病的时候，我也呼吸困难。",
      "DASSY001": "我讨厌我的生活。",
      "DASSY017": "我发现自己对事情会反应过度。",
      "DASSY013": "我感觉手发抖。",
      "DASSY019": "我对很多事情都感到有压力。",
      "DASSY009": "我感到恐惧。",
      "DASSY007": "我没有什么期待的（好事）。",
      "DASSY016": "我很容易被激怒。",
      "DASSY021": "我发现很难放松。",
      "DASSY005": "我一直感觉伤心。",
      "DASSY020": "当有人打断我，我觉得难以忍受。",
      "DASSY008": "我感到快恐慌了。",
      "DASSY002": "我讨厌我自己。",
      "DASSY004": "我觉得我没用。",
      "DASSY018": "我很容易感觉烦躁。",
      "DASSY011": "即使没有做任何剧烈运动，我也能感觉到我的心跳非常快。",
      "DASSY010": "没有什么原因，（但）我感到害怕。",
      "DASSY003": "我觉得生活很糟糕。",
      "DASSY_head": "请阅读每个句子，并圈出最符合你在过去一周感受的数字。",
      "DASSY_r0": "不符合",
      "DASSY_r1": "有时符合",
      "DASSY_r2": "常常符合",
      "DASSY_r3": "总是符合"
    },
    "id": {
      "DASSY015": "Saya merasa kesal dengan hal-hal kecil",
      "DASSY014": "Saya merasa pusing, seperti akan pingsan",
      "DASSY006": "Saya tidak menikmati apapun",
