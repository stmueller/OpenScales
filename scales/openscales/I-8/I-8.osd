{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "I-8",
      "name": "Impulsive Behavior Short Scale–8 (I-8)",
      "abbreviation": "I-8",
      "description": "8-item English-language adaptation measuring four facets of impulsive behavior with two items each: urgency, lack of premeditation, lack of perseverance, and sensation seeking. Subscale score is the mean of its two items (with the premeditation and perseverance items reverse-scored). A total across facets is not used.",
      "citation": "Groskurth, K., Nießen, D., Rammstedt, B., & Lechner, C. M (2022). Impulsive Behavior Short Scale–8 (I-8). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis324_exz",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Licensed CC BY 4.0 via ZIS (GESIS Leibniz Institute for the Social Sciences). Free to use, share, and adapt with attribution. Cite the ZIS documentation (https://doi.org/10.6102/zis324_exz) and the original publication.",
      "url": "https://zis.gesis.org/skala/Kovaleva-Beierlein-Kemper-Rammstedt-Impulsive-Behavior-Short-Scale-8-(I-8)",
      "version": "1.0",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English-language adaptation of the German I-8 (Kovaleva et al., 2014). 5-point apply scale. Items 3,4 (premeditation) and 5,6 (perseverance) are reverse-scored so higher = more LACK of premeditation/perseverance. Score each facet as the mean of its two items; no total. Partial scalar invariance UK-Germany."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "question_head": "i_8_inst",
      "labels": [
        "i_8_r1",
        null,
        null,
        null,
        "i_8_r5"
      ]
    },
    "dimensions": [
      {
        "id": "urgency",
        "name": "Urgency",
        "description": "Mean of items 1 and 2. Range 1-5."
      },
      {
        "id": "premeditation",
        "name": "Lack of Premeditation",
        "description": "Mean of items 3 and 4, reverse-scored. Range 1-5."
      },
      {
        "id": "perseverance",
        "name": "Lack of Perseverance",
        "description": "Mean of items 5 and 6, reverse-scored. Range 1-5."
      },
      {
        "id": "sensation",
        "name": "Sensation Seeking",
        "description": "Mean of items 7 and 8. Range 1-5."
      }
    ],
