  "translations": {
    "en": {
      "mprf_r1": "does not apply at all",
      "mprf_r7": "applies fully",
      "instructions": "Please rate how well each of the following statements applies to you in general. A rating of 1 signifies that a statement doesn't apply to you in the least, whereas a rating of 7 signifies that it describes you perfectly. Use the ratings in between to denote more precisely intermediate degrees of correspondence.",
      "stem": "My thoughts and actions are mainly directed toward:",
      "mprf_id1": "... my personal growth.",
      "mprf_id2": "... making my wishes come true.",
      "mprf_id3": "... pursuing my hopes.",
      "mprf_id4": "... following my dreams.",
      "mprf_ou1": "... carrying out my obligations.",
      "mprf_ou2": "... fulfilling my responsibilities.",
      "mprf_ou3": "... meeting the expectations of others.",
      "mprf_ou4": "... observing guidelines.",
      "mprf_g1": "... working toward success.",
      "mprf_g2": "... accomplishing what I set out to do.",
      "mprf_g3": "... getting the most out it.",
      "mprf_g4": "... reaching goals.",
      "mprf_nl1": "... averting losses.",
      "mprf_nl2": "... avoiding setbacks.",
      "mprf_nl3": "... preventing mistakes.",
      "mprf_nl4": "... forestalling undesirable occurrences.",
      "debrief": "Thank you for completing this questionnaire."
    },
    "de": {
      "mprf_r1": "trifft überhaupt nicht zu",
      "mprf_r7": "trifft vollständig zu",
      "instructions": "Bitte schätzen Sie ein, wie stark die folgenden Aussagen im Allgemeinen auf Sie zutreffen. Mit der Zahl 1 geben Sie an, dass die entsprechende Aussage überhaupt nicht auf Sie zutrifft, mit der Zahl 7 geben Sie an, dass die Aussage vollkommen auf Sie zutrifft. Die Zahlen 2 bis 6 ermöglichen Ihnen die Abstufung Ihrer Antworten zwischen „trifft überhaupt nicht zu“ und „trifft vollkommen zu“.",
      "stem": "Mein Denken und Handeln sind hauptsächlich dadurch geleitet:",
      "mprf_id1": "... mich selbst zu verwirklichen.",
      "mprf_id2": "… meine Wünsche zu realisieren.",
      "mprf_id3": "… meinen Hoffnungen nachzugehen.",
      "mprf_id4": "… meinen Träumen näher zu kommen.",
      "mprf_ou1": "… meine Pflichten zu erfüllen.",
      "mprf_ou2": "… meiner Verantwortung gerecht zu werden.",
      "mprf_ou3": "… an mich gestellten Erwartungen nachzukommen.",
      "mprf_ou4": "… Richtlinien einzuhalten.",
      "mprf_g1": "… auf Erfolge hinzuarbeiten.",
      "mprf_g2": "… Angestrebtes auch zu erreichen.",
      "mprf_g3": "… das Maximum für die Sache herauszuholen.",
      "mprf_g4": "… Ziele zu erreichen.",
      "mprf_nl1": "… Verluste zu vermeiden.",
      "mprf_nl2": "… Misserfolge zu vermeiden.",
      "mprf_nl3": "… Fehler zu verhindern.",
      "mprf_nl4": "… unerwünschte Ereignisse abzuwenden.",
      "debrief": "Vielen Dank für die Teilnahme."
    }
  }
}