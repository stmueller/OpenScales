{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "GQ6",
      "name": "Gratitude Questionnaire-6",
      "abbreviation": "GQ-6",
      "description": "6-item scale measuring dispositional gratitude — the tendency to notice and appreciate the positive in life. One of the most widely used gratitude measures.",
      "citation": "McCullough, M. E., Emmons, R. A., & Tsang, J. A. (2002). The grateful disposition: A conceptual and empirical topography. Journal of Personality and Social Psychology, 82(1), 112–127. https://doi.org/10.1037/0022-3514.82.1.112",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1037/0022-3514.82.1.112",
      "version": "1.0",
      "domain": "Well-being"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Original scale by McCullough et al. (2002). CC BY 4.0 license via German validation: Hudecek et al. (2020), Frontiers in Psychology. https://doi.org/10.3389/fpsyg.2020.590108"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "GQ6_r1",
        null,
        null,
        null,
        null,
        null,
        "GQ6_r7"
      ],
      "question_head": "GQ6_head"
    },
    "dimensions": [
      {
        "id": "Gratitude",
        "name": "Gratitude",
        "description": "Dispositional tendency to feel and express gratitude"
      }
    ],
    "items": [
      {
        "id": "GQ6001",
        "type": "likert",
        "text_key": "GQ6001",
        "dimension": "Gratitude"
      },
      {
        "id": "GQ6002",
        "type": "likert",
        "text_key": "GQ6002",
        "dimension": "Gratitude"
      },
      {
        "id": "GQ6003",
        "type": "likert",
        "text_key": "GQ6003",
        "dimension": "Gratitude"
      },
      {
        "id": "GQ6004",
        "type": "likert",
