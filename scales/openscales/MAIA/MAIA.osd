      {"id": "MAIA011", "type": "likert", "text_key": "MAIA011", "dimension": "attention_regulation"},
      {"id": "MAIA012", "type": "likert", "text_key": "MAIA012", "dimension": "attention_regulation"},
      {"id": "MAIA013", "type": "likert", "text_key": "MAIA013", "dimension": "attention_regulation"},
      {"id": "MAIA014", "type": "likert", "text_key": "MAIA014", "dimension": "attention_regulation"},
      {"id": "MAIA015", "type": "likert", "text_key": "MAIA015", "dimension": "attention_regulation"},
