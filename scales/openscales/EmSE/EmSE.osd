  "translations": {
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "LANGUAGE": "Deutsch",
      "emse1": "Ich bin mir sicher, dass ich mich mit meinen unangenehmen Gefühlen auseinandersetzen kann, auch wenn mich das belastet.",
      "emse2": "Ich weiß genau, dass ich es schaffe, mir auch bei sehr schmerzhaften Themen nicht in die eigene Tasche zu lügen.",
      "emse3": "Ich bin mir sicher, dass ich mir auch meine unangenehmen Gefühle eingestehen kann, selbst wenn dies für mich zunächst eine größere Belastung bedeutet als sie zu ignorieren.",
      "emse4": "Ich bin mir sicher, dass ich auch bei schwierigen Problemen meinen eigenen Empfindungen ins Gesicht sehen kann.",
      "emse5": "Wenn ich in einer Situation widersprüchliche Gefühle empfinde, kann ich mich hinsetzen und diese Empfindungen sortieren, um mir darüber klar zu werden, was in mir vorgeht.",
      "emse6": "Ich bin mir sicher, dass ich herausfinden kann, was andere Menschen fühlen, selbst wenn sie ihre Gefühle verbergen wollen.",
      "emse7": "Wenn ich eine Gruppe von fremden Leuten in der Öffentlichkeit beobachte, kann ich feststellen, ob es zwischen ihnen emotionale Spannungen gibt.",
      "emse8": "Ich kann erkennen, ob hinter dem Lächeln eines Mitmenschen Freude steckt oder es nur höflich gemeint ist.",
      "emse9": "Ich kann spüren, was andere Menschen fühlen, auch wenn sie versuchen, es nicht offen zu zeigen.",
      "emse10": "Ich bin mir sicher, dass ich meine Gefühle so ausdrücken kann, dass sie bei anderen so ankommen, wie ich sie empfinde.",
      "emse11": "Ich weiß genau, dass ich auch diffuse Empfindungen anderen gegenüber ausdrücken kann.",
      "emse12": "Ich bin mir sicher, dass die Gefühle, die ich ausdrücke, beim anderen auch richtig ankommen.",
      "emse13": "Ich weiß, dass es mir gelingt, andere mit meiner Freude anzustecken.",
      "emse14": "Ich bin mir sicher, dass ich mich auch bei ungewohnten Problemen in einen anderen Menschen einfühlen kann.",
      "emse15": "Ich weiß, unter welchen Umständen ich die Gefühle eines anderen nicht oder nur schlecht einschätzen kann.",
      "emse16": "Ich bin mir sicher, dass ich mich so verhalten kann, dass die Unsicherheit des anderen nicht zu einer peinlichen Situation führt.",
      "emse17": "Ich kann meine starken Gefühle auch in brenzligen Situationen so regulieren, dass sie meine Absichten und Pläne nicht behindern.",
      "emse18": "Ich kann meinen Ärger so ausdrücken, dass ich mit dem anderen die Situation klären kann, anstatt durch einen Wutanfall eine neue stressreiche Auseinandersetzung heraufzubeschwören.",
      "emse19": "Ich bin mir sicher, dass ich meine Wut im Zaume halten kann, um ein Gespräch nicht entgleisen zu lassen.",
      "emse20": "Ich bin mir sicher, dass ich mich emotional aus Situationen lösen kann, in denen ich versagt habe.",
      "emse21": "Auch aus sehr schmerzlichen Erfahrungen kann ich für mich etwas Positives ziehen, wenn ich mir genügend Zeit nehme, mich damit auseinanderzusetzen.",
      "emse22": "Ich bin mir sicher, dass ich in emotional belastenden Situationen andere um Hilfe bitten kann, auch wenn es mir schwer fällt.",
      "emse23": "Wenn ich bei einer Aufgabe scheitere, kann ich mich von lähmenden Gefühlen befreien und wieder an neue Aufgaben oder an einen neuen Lösungsversuch herangehen.",
      "emse24": "Ich bin überzeugt, dass ich in engen Beziehungen meine Gefühle ehrlich zeigen kann, auch wenn es mir schwer fällt.",
      "emse25": "Ich kann in engen Beziehungen offen meine Gefühle ausdrücken, auch wenn die Gefahr besteht, den andern damit zu kränken.",
      "emse26": "Gegenüber Menschen, mit denen ich in einer engen Beziehung stehe, kann ich negative Gefühle so äußern, dass unsere Beziehung darunter nicht leidet.",
      "emse27": "Ich bin mir sicher, ich kann auch bei einer extremen emotionalen Erfahrung handlungsfähig bleiben.",
      "emse28": "Ich bin gewiss, dass ich auch nach einem emotionalen Tief wieder ausgeglichen und fröhlich werden kann.",
      "emse29": "Ich kann auch dann noch handlungsfähig bleiben, wenn meine Gefühle einmal mit mir durchgehen."
    }
  }
}