    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Democracy Battery (ESS) Report",
      "footer_refs": [
        "ESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no. License: CC BY-SA 4.0.",
        "Scoring: normative items D1–D12 (0–10, how important for democracy); evaluative items D13–D24 (0–10, how well applies to [country]). Gap = eval − norm; negative gap = democratic deficit."
      ]
    },
    "parameters": {
      "country": {
        "type": "string",
        "default": "my country",
        "description": "Country name to substitute in item texts where [country] appears"
      }
    }
  },
  "translations": {
    "en": {
      "dem_norm_lo": "Not at all important for democracy",
      "dem_norm_hi": "Extremely important for democracy",
      "fairelc": "Elections are free and fair.",
      "dfprtal": "Different political parties offer clear alternatives to one another.",
      "medcrgv": "The media are free to criticise the government.",
      "rghmgpr": "The rights of minority groups are protected.",
      "votedir": "Citizens have the final say on political issues by voting directly in referendums.",
      "cttresa": "The courts treat everyone the same.",
      "gptpelc": "Governing parties are punished in elections when they have done a bad job.",
      "gvctzpv": "The government protects all citizens against poverty.",
      "grdfinc": "The government takes measures to reduce differences in income levels.",
      "viepol": "The views of ordinary people prevail over those of political elites.",
      "wpestop": "When the will of the people conflicts with what politicians want to do, nothing can stop the will of the people.",
      "keydec": "Key decisions in [country] are made by national governments rather than the European Union.",
