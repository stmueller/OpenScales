    "pl": {
      "fi_01": "Na ile w ostatnich dniach czuł(a) się Pan(i) zadowolony(-a) z życia?",
      "fi_rs_satisfied_r10": "Całkowicie zadowolony(-a) z życia",
      "fi_rs_satisfied_r0": "Wcale niezadowolony(-a) z życia",
      "fi_02": "Ogólnie rzecz biorąc, jak szczęśliwy(-a) lub nieszczęśliwy(-a) czuje się Pan(i) zazwyczaj?",
      "fi_rs_happy_r10": "Bardzo szczęśliwy(-a)",
      "fi_rs_happy_r0": "Bardzo nieszczęśliwy(-a)",
      "fi_03": "Jak ogólnie ocenia Pan(i) swoje zdrowie pod względem fizycznym?",
      "fi_rs_physical_r10": "Doskonały stan zdrowia fizycznego",
      "fi_rs_physical_r0": "Zły stan zdrowia fizycznego",
      "fi_04": "Jak ogólnie ocenia Pan(i) swoje zdrowie pod względem psychicznym?",
      "fi_rs_mental_r10": "Doskonały stan zdrowia fizycznego",
      "fi_rs_mental_r0": "Zły stan zdrowia psychicznego",
      "fi_05": "Ogólnie rzecz biorąc, w jakim stopniu uważa Pan(i), że to, co Pan(i) robi w swoim życiu jest wartościowe?",
      "fi_rs_worthwhile_r10": "Całkowicie wartościowe",
      "fi_rs_worthwhile_r0": "Zupełnie nie wartościowe",
      "fi_06": "Rozumiem swój cel w życiu.",
      "fi_rs_agree_r10": "Zdecydowanie się zgadzam",
      "fi_rs_agree_r0": "Zdecydowanie się nie zgadzam",
      "fi_07": "Zawsze działam na rzecz dobra w każdych okolicznościach, nawet w sytuacjach trudnych i wymagających.",
      "fi_rs_trueme_r10": "Całkowita prawda o mnie",
      "fi_rs_trueme_r0": "Zupełna nieprawda o mnie",
      "fi_08": "Zawsze jestem w stanie zrezygnować z części szczęścia teraz dla większego szczęścia później.",
      "fi_09": "Jestem zadowolony(-a) z moich przyjaźni i związków.",
      "fi_10": "Moje relacje są tak satysfakcjonujące, jakbym chciał(-a), żeby były.",
      "fi_11": "Jak często martwi się Pan(i), że nie będzie w stanie pokryć zwykłych miesięcznych wydatków na życie?",
