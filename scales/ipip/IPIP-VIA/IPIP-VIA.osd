    "scale_info": {
      "name": "IPIP Character Strengths",
      "code": "IPIP-VIA",
      "abbreviation": "IPIP-VIA",
      "description": "IPIP representation of the Values in Action character strengths inventory measuring 24 character strengths.",
      "citation": "Peterson, C., & Seligman, M. E. P. (2004). Character Strengths and Virtues: A Handbook and Classification. Oxford University Press.",
      "license": "Public Domain",
      "version": "1.0",
      "url": "https://ipip.ori.org/newVIAKey.htm",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-04-01",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
