  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H754": "Get angry easily.",
      "ipip_X95": "Get upset easily.",
      "ipip_H926": "Change my mood a lot.",
      "ipip_R1": "Am a person whose moods go up and down easily.",
      "ipip_Q77": "Get easily agitated.",
      "ipip_H921": "Can be stirred up easily.",
      "ipip_X265": "Rarely get irritated.",
      "ipip_H381": "Keep my emotions under control.",
      "ipip_E99": "Rarely lose my composure.",
      "ipip_X23": "Am not easily annoyed.",
      "ipip_H683": "Am filled with doubts about things.",
      "ipip_H612": "Feel threatened easily.",
      "ipip_H1157": "Worry about things.",
      "ipip_H647": "Am easily discouraged.",
      "ipip_H959": "Become overwhelmed by events.",
      "ipip_H968": "Am afraid of many things.",
      "ipip_X156": "Seldom feel blue.",
      "ipip_X129": "Feel comfortable with myself.",
      "ipip_D87": "Rarely feel depressed.",
      "ipip_E136": "Feel others' emotions.",
      "ipip_H1130": "Sympathize with others' feelings.",
      "ipip_H109": "Like to do things for others.",
      "ipip_X227": "Am not interested in other people's problems.",
      "ipip_X237": "Can't be bothered with other's needs.",
      "ipip_X203": "Am indifferent to the feelings of others.",
      "ipip_H918": "Take no time for others.",
      "ipip_E143": "Don't have a soft side.",
      "ipip_H296": "Respect authority.",
      "ipip_E31": "Hate to seem pushy.",
      "ipip_Q178": "Avoid imposing my will on others.",
      "ipip_text_rarely_put_people_under_pressure": "Rarely put people under pressure.",
      "ipip_H1103": "Insult people.",
      "ipip_H736": "Believe that I am better than others.",
      "ipip_H427": "Take advantage of others.",
      "ipip_H720": "Seek conflict.",
      "ipip_H453": "Love a good fight.",
      "ipip_H1325": "Am out for my own personal gain.",
      "ipip_H258": "Carry out my plans.",
      "ipip_H254": "Finish what I start.",
      "ipip_H555": "Get things done quickly.",
      "ipip_P427": "Always know what I am doing.",
      "ipip_H1186": "Waste my time.",
      "ipip_H1171": "Find it difficult to get down to work.",
      "ipip_H896": "Mess things up.",
      "ipip_H854": "Don't put my mind on the task at hand.",
      "ipip_H1180": "Postpone decisions.",
      "ipip_H843": "Am easily distracted.",
      "ipip_X118": "Like order.",
      "ipip_Q104": "Keep things tidy.",
      "ipip_X179": "Follow a schedule.",
      "ipip_H215": "See that rules are observed.",
      "ipip_H1002": "Want every detail taken care of.",
      "ipip_E100": "Am not bothered by messy people.",
      "ipip_E7": "Am not bothered by disorder.",
      "ipip_X122": "Dislike routine.",
      "ipip_H29": "Make friends easily.",
      "ipip_H52": "Warm up quickly to others.",
      "ipip_A139": "Show my feelings when I'm happy.",
      "ipip_H1094": "Have a lot of fun.",
      "ipip_Q138": "Laugh a lot.",
      "ipip_H596": "Am hard to get to know.",
      "ipip_H704": "Keep others at a distance.",
      "ipip_H601": "Reveal little about myself.",
      "ipip_A13": "Rarely get caught up in the excitement.",
      "ipip_Y1": "Am not a very enthusiastic person.",
      "ipip_H334": "Take charge.",
      "ipip_Q14": "Have a strong personality.",
      "ipip_H1110": "Know how to captivate people.",
      "ipip_P439": "See myself as a good leader.",
      "ipip_H1137": "Can talk others into doing things.",
      "ipip_H518": "Am the first to act.",
      "ipip_text_do_not_have_an_assertive_personality": "Do not have an assertive personality.",
      "ipip_P346": "Lack the talent for influencing people.",
      "ipip_H976": "Wait for others to lead the way.",
      "ipip_H679": "Hold back my opinions.",
      "ipip_X100": "Am quick to understand things.",
      "ipip_H1322": "Can handle a lot of information.",
      "ipip_X201": "Like to solve complex problems.",
      "ipip_H1276": "Have a rich vocabulary.",
      "ipip_H1287": "Think quickly.",
      "ipip_H1219": "Formulate ideas clearly.",
      "ipip_X176": "Have difficulty understanding abstract ideas.",
      "ipip_X248": "Avoid philosophical discussions.",
      "ipip_X109": "Avoid difficult reading material.",
      "ipip_Q67": "Learn things slowly.",
      "ipip_W15": "Enjoy the beauty of nature.",
      "ipip_X123": "Believe in the importance of art.",
      "ipip_H1210": "Love to reflect on things.",
      "ipip_Q51": "Get deeply immersed in music.",
      "ipip_E105": "See beauty in things that others might not notice.",
      "ipip_E87": "Need a creative outlet.",
      "ipip_X45": "Do not like poetry.",
      "ipip_X175": "Seldom get lost in thought.",
      "ipip_X135": "Seldom daydream.",
      "ipip_D4": "Seldom notice the emotional aspects of paintings and pictures.",
      "ipip_X242": "Am not embarrassed easily.",
      "ipip_H225": "Inquire about others' well-being.",
      "ipip_H1129": "Take an interest in other people's lives.",
      "ipip_H823": "Leave my belongings around.",
      "ipip_E11": "Want everything to be 'just right.'"
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_P439": "Sebe vidim kao dobrog vođu.",
      "ipip_H334": "Često preuzimam stvari na sebe.",
      "ipip_text_do_not_have_an_assertive_personality": "Nemam asertivnu ličnost.",
      "ipip_H1322": "Mogu izaći na kraj sa velikom količinom informacija.",
      "ipip_E87": "Potreban mi je kreativan odušak.",
      "ipip_X237": "Ne opterećujem se potrebama drugih.",
      "ipip_H959": "Neki događaji me preopterete.",
      "ipip_E100": "Ne smetaju mi neuredni ljudi.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_H1180": "Sklon sam da odlažem svoje odluke.",
      "ipip_H918": "Ne trošim vreme na druge.",
      "ipip_X129": "Osećam se prijatno kad provodim vreme sam.",
      "ipip_H896": "Često nešto zabrljam.",
      "ipip_H555": "Brzo obavljam stvari.",
      "ipip_H1210": "Volim da promišljam o raznim stvarima.",
      "ipip_P427": "Uvek znam šta radim.",
      "ipip_X203": "Ravnodušan sam prema tuđim emocijama.",
      "ipip_X118": "Volim red.",
      "ipip_H109": "Volim da učinim nešto za druge ljude.",
      "ipip_Q67": "Sporo učim.",
      "ipip_H1325": "Činim sve da ostvarim ličnu korist.",
      "ipip_E31": "Ne volim da delujem nametljivo.",
      "ipip_H921": "Mogu se lako pokrenuti.",
      "ipip_H52": "Brzo se zbližim sa drugim ljudima.",
      "ipip_H976": "Prepuštam vođstvo drugima.",
      "ipip_H1110": "Umem da oduševim druge ljude.",
      "ipip_E143": "Nisam naročito osećajan.",
      "ipip_D4": "Retko primećujem emocije koje sa sobom nose fotografije i slike.",
      "ipip_H1171": "Teško mi je da prionem na posao.",
      "ipip_H854": "Površno radim zadatke.",
      "ipip_A13": "Retko me ponese uzbuđenje.",
      "ipip_Q14": "Imam snažnu ličnost.",
      "ipip_H453": "Volim dobru svađu.",
      "ipip_H427": "Često iskorišćavam druge ljude.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H1287": "Brzo razmišljam.",
      "ipip_X23": "Nije me lako iznervirati",
      "ipip_X123": "Verujem da je umetnost važna.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_D87": "Retko se osećam depresivno.",
      "ipip_H601": "Ne otkrivam puno o sebi.",
      "ipip_A139": "Kada sam srećan, to i pokažem.",
      "ipip_P346": "Nemam talenat da utičem na druge.",
      "ipip_H258": "Ostvarujem svoje planove.",
      "ipip_H518": "Preuzimam inicijativu.",
      "ipip_H754": "Lako pobesnim.",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_H612": "Lako se osetim ugroženim.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H843": "Lako me je omesti.",
      "ipip_Y1": "Nisam naročito entuzijastična osoba.",
      "ipip_X135": "Retko sanjarim.",
      "ipip_X265": "Retko se iznerviram.",
      "ipip_H254": "Završim započeto.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_H774": "Vršim pritisak na druge ljude.",
      "ipip_Q51": "Lako se udubim u muziku.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_Q104": "Održavam stvari urednim.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_H596": "Teško me je upoznati.",
      "ipip_E99": "Retko se dešava da izgubim prisebnost.",
      "ipip_W15": "Uživam u lepoti prirode.",
      "ipip_H1130": "Saosećam sa drugima.",
      "ipip_H215": "Vodim računa da se pravila poštuju.",
      "ipip_H1137": "Mogu da nagovorim druge da nešto urade.",
      "ipip_X175": "Retko se izgubim u mislima.",
      "ipip_H1219": "Precizno formulišem ideje.",
      "ipip_X242": "Ne postidim se lako.",
      "ipip_H1094": "Umem dobro da se zabavljam.",
      "ipip_H968": "Plašim se mnogih stvari.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_E11": "Želim da sve bude \"baš kako treba\".",
      "ipip_H1129": "Interesujem se za živote drugih ljudi.",
      "ipip_X176": "Imam poteškoća u razumevanju apstraktnih ideja.",
      "ipip_H926": "Često menjam raspolozenja.",
      "ipip_H720": "Tražim sukobe.",
      "ipip_H704": "Držim druge ljude na distanci.",
      "ipip_Q178": "Ne namećem svoju volju drugima.",
      "ipip_X248": "Izbegavam filozofske diskusije.",
      "ipip_R1": "Lako menjam raspoloženja.",
      "ipip_X201": "Volim da rešavam složene probleme.",
      "ipip_H1002": "Želim da svaki detalj bude na svom mestu.",
      "ipip_H381": "Držim svoja osećanja pod kontrolom.",
      "ipip_Q77": "Lako se uznemirim.",
      "ipip_E7": "Ne smeta mi nered.",
      "ipip_H296": "Poštujem autoritete.",
      "ipip_Q138": "Mnogo se smejem.",
      "ipip_H1186": "Često traćim svoje vreme.",
      "ipip_X109": "Izbegavam teško štivo.",
      "ipip_X122": "Ne volim rutinu.",
      "ipip_E105": "Vidim lepotu u stvarima koje drugi možda ne primećuju.",
      "ipip_H679": "Retko izražavam svoje mišljenje.",
      "ipip_H225": "Raspitujem se kako su drugi ljudi.",
      "ipip_H736": "Mislim da sam bolji od drugih.",
      "ipip_H683": "Pun sam nedoumica u vezi raznih stvari.",
      "ipip_H823": "Često ostavljam svoje stvari svuda unaokolo.",
      "ipip_H647": "Lako se obeshrabrim.",
      "ipip_E136": "Osećam emocije drugih ljudi.",
      "ipip_H1157": "Često sam zabrinut."
    },
    "sv": {
      "_translator": "Tommy Gärling (Göteborg University, Sweden); machine translation",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_likert_1": "Mycket inexakt",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_P439": "Ser mig själv som en god ledare",
      "ipip_H334": "Tar kommandot",
      "ipip_text_do_not_have_an_assertive_personality": "Har inte en bestämd personlighet",
      "ipip_H1322": "Kan hantera mycket information",
      "ipip_E87": "Behöver få utlopp för min kreativitet",
      "ipip_X237": "Kan inte låta mig störas av andras behov",
      "ipip_H959": "Blir överväldigad av händelser",
      "ipip_E100": "Störs inte av stökiga personer",
      "ipip_X45": "Gillar inte poesi",
      "ipip_H1180": "Skjuter upp beslut",
      "ipip_H918": "Tar mig inte tid för andra",
      "ipip_X129": "Känner mig trygg med mig själv",
      "ipip_H896": "Konstrar till saker",
      "ipip_H555": "Får saker snabbt gjort",
      "ipip_H1210": "Älskar att reflektera över saker och ting",
      "ipip_P427": "Vet alltid vad jag gör",
      "ipip_X203": "Är likgiltig inför andras känslor",
      "ipip_X118": "Tycker om ordning",
