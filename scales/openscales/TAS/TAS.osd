  "translations": {
    "en": {
      "_translator": "Retranslated from Turkish by OpenScales Project (2026); original Turkish by Karasu, M., Cesur, S., & Gurluk, Y. O. (2025). https://doi.org/10.1007/s12144-025-07601-9. Formal back-translation recommended before use in English-language research.",
      "TAS_head": "Think about times when you feel truly yourself and your time feels your own. Rate how much each statement describes you during those times.",
      "TAS_r1": "Strongly disagree",
      "TAS_r5": "Strongly agree",
      "TAS001": "I feel in control.",
      "TAS002": "This time helps me grow.",
      "TAS003": "I feel deeply connected to this time.",
      "TAS004": "I take ownership of this time.",
      "TAS005": "This time is special to me.",
      "TAS006": "I cannot do without time set aside for myself.",
      "TAS007": "I am more disciplined.",
      "TAS008": "I feel freer.",
      "TAS009": "I actively protect this time.",
      "TAS010": "I feel at peace.",
      "TAS011": "I do whatever I feel like doing.",
      "TAS012": "I am better able to fulfill my expectations of life.",
      "TAS013": "I know myself better.",
      "TAS014": "I feel more like my true self.",
      "TAS015": "I am more aware of what I want.",
      "TAS016": "I feel calmer.",
      "TAS017": "I savor the present moment.",
      "TAS018": "I seek meaning in what I do.",
      "TAS019": "I feel more spiritual.",
      "TAS020": "I feel more strong-willed.",
      "TAS021": "I feel more content.",
      "TAS022": "My life satisfies me more.",
      "TAS023": "I feel the meaning of my life more deeply.",
      "TAS024": "I feel more compassionate toward others.",
      "TAS025": "I feel as though I have taken the reins of my life.",
      "TAS026": "I feel in contact with my true self.",
      "TAS027": "I live more in accordance with my worldview.",
      "TAS028": "I feel more at peace with myself.",
      "TAS029": "I better understand why I am living this life."
    },
    "tr": {
      "_translator": "Karasu, M., Cesur, S., & Gurluk, Y. O. (2025). https://doi.org/10.1007/s12144-025-07601-9",
      "TAS_head": "Zamanla ilişki kuruş biçimimize ilişkin ifadeler aşağıda yer almaktadır. Her bir ifade için deneyimlerinizi en iyi tanımlayan yanıtı seçiniz.",
      "TAS_r1": "Kesinlikle katılmıyorum",
      "TAS_r5": "Kesinlikle katılıyorum",
      "TAS001": "Kendimden bir parça hissettiğim zamanlarda kontrol genellikle bendedir.",
      "TAS002": "Kendime ait hissettiğim zamanların beni büyüttüğünü hissederim.",
      "TAS003": "Kendimden bir parça hissettiğim zamanlara bağlı hissediyorum.",
      "TAS004": "Kendimden bir parça hissettiğim zamanları sahiplenirim.",
      "TAS005": "Kendime ait hissettiğim zamanlar benim için özeldir.",
      "TAS006": "Kendime ayırdığım zamanlar olmazsa olmazımdır.",
      "TAS007": "Kendime ait hissettiğim zamanlarda daha disiplinli olurum.",
      "TAS008": "Kendimden bir parça hissettiğim zamanlarda genellikle daha özgür hissederim.",
      "TAS009": "Kendimden bir parça hissettiğim zamanları korumaya dikkat ederim.",
      "TAS010": "Kendime ait hissettiğim zamanlarda genellikle dingin hissederim.",
      "TAS011": "Kendime ait hissettiğim zamanlarda canım ne isterse onu yaparım.",
      "TAS012": "Kendime ayırdığım zamanlarda hayattan beklentilerimi daha çok gerçekleştirebiliyorum.",
      "TAS013": "Kendimden bir parça hissettiğim zamanlarda kendimi daha iyi tanıyabildiğimi fark ediyorum.",
      "TAS014": "Kendimden bir parça hissettiğim zamanlarda daha çok kendim gibi hissediyorum.",
      "TAS015": "Kendime ait hissettiğim zamanlarda ne istediğimin daha çok farkında olurum.",
      "TAS016": "Kendime ait hissettiğim zamanlarda kendimi daha sakin hissederim.",
      "TAS017": "Kendimden bir parça hissettiğim zamanlarda içinde bulunduğum anın tadına varabildiğimi hissederim.",
      "TAS018": "Kendimden bir parça hissettiğim zamanlarda yaptıklarımın anlamını ararım.",
      "TAS019": "Kendime ait hissettiğim zamanlarda genellikle daha manevi duygular hissederim.",
      "TAS020": "Kendimden bir parça hissettiğim zamanlarda kendimi daha iradeli hissederim.",
      "TAS021": "Kendime ait hissettiğim zamanlarda genellikle daha memnun hissederim.",
      "TAS022": "Kendime ait hissettiğim zamanlarda yaşamım beni daha çok tatmin eder.",
      "TAS023": "Kendimden bir parça hissettiğim zamanlarda yaşamımın anlamını daha çok hissederim.",
      "TAS024": "Kendime ait hissettiğim zamanlarda başkalarına karşı daha şefkatli hissederim.",
      "TAS025": "Kendime ait hissettiğim zamanlarda hayatımın iplerini elime almış gibi hissederim.",
      "TAS026": "Kendimden bir parça hissettiğim zamanlarda \"gerçek ben\" ile temas ettiğimi hissediyorum.",
      "TAS027": "Kendime ait hissettiğim zamanlarda dünya görüşüme daha uygun yaşadığımı fark ediyorum.",
      "TAS028": "Kendime ait hissettiğim zamanlarda kendimle daha barışık olduğumu hissederim.",
      "TAS029": "Kendime ait hissettiğim zamanlarda bu hayatta niçin yaşadığımı daha iyi anlarım."
    }
  }
}