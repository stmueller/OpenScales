{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "4D-Scale on Group Privileges (German)",
      "code": "MISS16079",
      "abbreviation": "4D-DE",
      "description": "German adaptation of the 20-item 4D-Scale (Shuman et al., 2024) measuring strategies used by White-identified individuals to manage awareness of racial privilege. Five subscales of 4 items each: Defend (justifying inequality), Deny (minimizing discrimination), Distance from Inequality (denying personal benefit), Distance from Identity (de-emphasizing White identity), and Dismantle (supporting systemic change). Validated across three German samples. Item 1 of Distance from Identity showed low factor loading in German and is not recommended for use in the German context.",
      "citation": "Schröder, A.-C., & Asbrock, F. (2025). Managing a privileged group identity – Adaption and validation of a German 4D-Scale. Measurement Instruments for the Social Sciences, 7, Article e16079. https://doi.org/10.5964/miss.16079\n\nOriginal scale: Shuman, E., Hasan-Aslih, S., van Zomeren, M., Saguy, T., & Halperin, E. (2024). The 4D-Scale: Measuring four orientations toward acknowledging group privileges. Journal of Personality and Social Psychology. https://doi.org/10.1037/pspi0000449",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/16079",
      "domain": "Social",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-07",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "German items verbatim from Table 1 of Schröder & Asbrock (2025). German items use 'People of Color / Weiße'. Scale targets White-identified respondents. Item 4D_DI1 (Distance from Identity, item 1) has a low factor loading (.35) in the German validation and is explicitly flagged as not recommended for German-context studies; it is included here for completeness. No reverse-coded items. Response anchors: 1 = strongly disagree, 7 = strongly agree; midpoint (4) = neither agree nor disagree. English items from Shuman et al. (2024) are NOT included — the original English 4D-Scale is not CC-licensed."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": ["4d_r1", "4d_r2", "4d_r3", "4d_r4", "4d_r5", "4d_r6", "4d_r7"]
    },
    "dimensions": [
      {
        "id": "defend",
        "name": "Defend",
        "abbreviation": "DEF",
        "description": "Justifying racial inequality as a natural or fair outcome. Mean of 4 items, range 1–7; higher = stronger endorsement of defending privilege."
      },
      {
        "id": "deny",
        "name": "Deny",
        "abbreviation": "DEN",
        "description": "Minimizing or denying the existence of racial discrimination and inequality. Mean of 4 items, range 1–7; higher = stronger denial."
      },
      {
        "id": "dist_inequality",
        "name": "Distance from Inequality",
        "abbreviation": "DIN",
        "description": "Distancing oneself from personal benefit from racial privilege. Mean of 4 items, range 1–7; higher = stronger distancing from inequality."
      },
      {
        "id": "dist_identity",
        "name": "Distance from Identity",
        "abbreviation": "DID",
        "description": "De-emphasizing White identity in favor of individual characteristics. Mean of 4 items (item 1 not recommended in German context), range 1–7; higher = stronger distancing from identity."
      },
      {
        "id": "dismantle",
        "name": "Dismantle",
        "abbreviation": "DIS",
        "description": "Supporting active efforts to reduce racial inequality and give up privilege. Mean of 4 items, range 1–7; higher = stronger dismantling orientation."
      }
    ],
    "items": [
      {"id": "4D_DE1", "type": "likert", "text_key": "4D_DE1", "dimension": "defend"},
      {"id": "4D_DE2", "type": "likert", "text_key": "4D_DE2", "dimension": "defend"},
      {"id": "4D_DE3", "type": "likert", "text_key": "4D_DE3", "dimension": "defend"},
      {"id": "4D_DE4", "type": "likert", "text_key": "4D_DE4", "dimension": "defend"},
      {"id": "4D_DN1", "type": "likert", "text_key": "4D_DN1", "dimension": "deny"},
      {"id": "4D_DN2", "type": "likert", "text_key": "4D_DN2", "dimension": "deny"},
      {"id": "4D_DN3", "type": "likert", "text_key": "4D_DN3", "dimension": "deny"},
      {"id": "4D_DN4", "type": "likert", "text_key": "4D_DN4", "dimension": "deny"},
      {"id": "4D_DI1", "type": "likert", "text_key": "4D_DI1", "dimension": "dist_inequality"},
      {"id": "4D_DI2", "type": "likert", "text_key": "4D_DI2", "dimension": "dist_inequality"},
      {"id": "4D_DI3", "type": "likert", "text_key": "4D_DI3", "dimension": "dist_inequality"},
      {"id": "4D_DI4", "type": "likert", "text_key": "4D_DI4", "dimension": "dist_inequality"},
      {"id": "4D_DD1", "type": "likert", "text_key": "4D_DD1", "dimension": "dist_identity"},
      {"id": "4D_DD2", "type": "likert", "text_key": "4D_DD2", "dimension": "dist_identity"},
      {"id": "4D_DD3", "type": "likert", "text_key": "4D_DD3", "dimension": "dist_identity"},
      {"id": "4D_DD4", "type": "likert", "text_key": "4D_DD4", "dimension": "dist_identity"},
      {"id": "4D_DM1", "type": "likert", "text_key": "4D_DM1", "dimension": "dismantle"},
      {"id": "4D_DM2", "type": "likert", "text_key": "4D_DM2", "dimension": "dismantle"},
      {"id": "4D_DM3", "type": "likert", "text_key": "4D_DM3", "dimension": "dismantle"},
      {"id": "4D_DM4", "type": "likert", "text_key": "4D_DM4", "dimension": "dismantle"}
    ],
    "scoring": {
      "defend": {
        "description": "Mean of 4 Defend items. Range 1–7; higher = stronger justification of inequality.",
        "method": "mean_coded",
        "items": ["4D_DE1", "4D_DE2", "4D_DE3", "4D_DE4"]
      },
      "deny": {
        "description": "Mean of 4 Deny items. Range 1–7; higher = stronger denial of discrimination.",
        "method": "mean_coded",
        "items": ["4D_DN1", "4D_DN2", "4D_DN3", "4D_DN4"]
      },
      "dist_inequality": {
        "description": "Mean of 4 Distance from Inequality items. Range 1–7; higher = stronger distancing from personal benefit.",
        "method": "mean_coded",
        "items": ["4D_DI1", "4D_DI2", "4D_DI3", "4D_DI4"]
      },
      "dist_identity": {
        "description": "Mean of 4 Distance from Identity items (item 4D_DD1 not recommended in German context). Range 1–7; higher = stronger de-emphasis of White identity.",
        "method": "mean_coded",
        "items": ["4D_DD1", "4D_DD2", "4D_DD3", "4D_DD4"]
      },
      "dismantle": {
        "description": "Mean of 4 Dismantle items. Range 1–7; higher = stronger support for dismantling privilege.",
        "method": "mean_coded",
        "items": ["4D_DM1", "4D_DM2", "4D_DM3", "4D_DM4"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "4D-Scale on Group Privileges – German Version (4D-DE) Report",
      "footer_refs": [
        "Schröder, A.-C., & Asbrock, F. (2025). Managing a privileged group identity – Adaption and validation of a German 4D-Scale. Measurement Instruments for the Social Sciences, 7, Article e16079. https://doi.org/10.5964/miss.16079",
        "Item 4D_DD1 (Distance from Identity, item 1) is not recommended for use in German-context studies (low factor loading). Scale intended for White-identified respondents."
      ]
    }
  },
  "translations": {
    "de": {
      "4d_r1": "Stimme überhaupt nicht zu",
      "4d_r2": "Stimme nicht zu",
      "4d_r3": "Stimme eher nicht zu",
      "4d_r4": "Weder noch",
      "4d_r5": "Stimme eher zu",
      "4d_r6": "Stimme zu",
      "4d_r7": "Stimme vollständig zu",
      "4D_DE1": "Die Ungleichheiten, die zwischen People of Color und Weißen bestehen, sind ein gerechtfertigtes Ergebnis der realen Unterschiede zwischen den Gruppen.",
      "4D_DE2": "Aufgrund der grundlegenden kulturellen Unterschiede zwischen People of Color und Weißen ist es fair, dass es Ungleichheiten zwischen den Gruppen gibt.",
      "4D_DE3": "Die Ungleichheit, die zwischen People of Color und Weißen besteht, spiegelt einfach die natürliche Ordnung der Dinge wider.",
      "4D_DE4": "Die Kluft zwischen People of Color und Weißen spiegelt die natürlichen Unterschiede zwischen den Gruppen wider.",
      "4D_DN1": "Das Ausmaß der Diskriminierung, der People of Color ausgesetzt sind, wird oft übertrieben.",
      "4D_DN2": "Das Ausmaß der Ungleichheit zwischen People of Color und Weißen ist eigentlich recht gering.",
      "4D_DN3": "People of Color wurden früher ungleich behandelt, aber heute sind sie nicht mehr viel Diskriminierung ausgesetzt.",
      "4D_DN4": "Weiße und People of Color werden heutzutage in der Gesellschaft im Allgemeinen gleich behandelt.",
      "4D_DI1": "Ich habe nie persönlich von der Ungleichheit profitiert, die zwischen People of Color und Weißen besteht, aber andere vielleicht schon.",
      "4D_DI2": "Obwohl es einem normalerweise echte Vorteile im Leben gibt, weiß zu sein, habe ich nicht viele dieser Vorteile genossen.",
      "4D_DI3": "Nur einige Weiße genießen Privilegien, die sich aus der Ungleichheit aufgrund von Rassismus ergeben.",
      "4D_DI4": "Die derzeitigen Ungleichheiten, die zwischen People of Color und Weißen bestehen, haben nur für einige wenige Weiße Vorteile.",
      "4D_DD1": "Ich definiere mich lieber über meine individuellen Eigenschaften als über die Tatsache, dass ich weiß bin.",
      "4D_DD2": "Es stört mich, wenn sich die Leute darauf fokussieren, dass ich weiß bin und nicht auf die Dinge, die mich als Individuum definieren.",
      "4D_DD3": "Ich wünschte, dass wenn die Leute mit mir interagieren, sie nicht so sehr betonen würden, dass ich weiß bin.",
      "4D_DD4": "Es stört mich, wenn andere Menschen hervorheben, dass ich weiß bin.",
      "4D_DM1": "Um Gleichberechtigung für People of Color zu erreichen, sollten Weiße bereit sein, einen Teil der Vorteile, die sie genießen, aufzugeben.",
      "4D_DM2": "Ich denke, Weiße müssen einige ihrer Privilegien aufgeben, um eine gleichberechtigtere Gesellschaft zu erschaffen.",
      "4D_DM3": "Wenn ich an meine Privilegien als Weiße:r denke, habe ich das Gefühl, dass ich etwas tun muss, um die Ungleichheit anzugehen, mit der People of Color konfrontiert sind.",
      "4D_DM4": "Ich würde einige meiner Privilegien als Weiße:r aufgeben, um die Ungleichheit zu verringern.",
      "debrief": "Vielen Dank für das Ausfüllen dieses Fragebogens."
    }
  }
}
