      {"id": "bfi23", "type": "likert", "text_key": "bfi23", "dimension": "conscientiousness"},
      {"id": "bfi24", "type": "likert", "text_key": "bfi24", "dimension": "neuroticism"},
      {"id": "bfi25", "type": "likert", "text_key": "bfi25", "dimension": "openness"},
