    "sk": {
      "cb_head": "Nakoľko súhlasíte alebo nesúhlasíte s nasledujúcimi tvrdeniami?",
      "secgrdec": "Za všetky zásadné rozhodnutia vo svetovej politike je zodpovedná malá tajná skupina ľudí.",
      "scidecpb": "Skupiny vedcov manipulujú, vymýšľajú alebo potláčajú dôkazy s cieľom oklamať verejnosť.",
