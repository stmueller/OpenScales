  "translations": {
    "en": {
      "likert_1": "Strongly agree",
      "likert_2": "Agree",
      "likert_3": "Slightly agree",
      "likert_4": "Neither agree nor disagree",
      "likert_5": "Slightly disagree",
      "likert_6": "Disagree",
      "likert_7": "Strongly disagree",
      "question_head": "Below are 8 statements with which you may agree or disagree. Using scale below, indicate your agreement with each item by indicating that response for each statement.",
      "fs1": "I lead a purposeful and meaningful life",
      "fs2": "My social relationships are supportive and rewarding",
      "fs3": "I am engaged and interested in my daily activities",
      "fs4": "I actively contribute to the happiness and well-being of others",
      "fs5": "I am competent and capable in the activities that are important to me",
      "fs6": "I am a good person and live a good life",
      "fs7": "I am optimistic about my future",
      "fs8": "People respect me",
      "debrief": "Thank you for completing this questionnaire."
    },
    "ar": {
      "_translator": "AL-Dossary, S. A. (2021). https://doi.org/10.5539/ijps.v13n2p20",
      "likert_1": "غير موافق على الإطلاق",
      "likert_2": "غير موافق",
      "likert_3": "غير موافق إلى حد ما",
      "likert_4": "محايد أو لست موافق ولست معارض",
      "likert_5": "موافق إلى حد ما",
      "likert_6": "موافق",
      "likert_7": "موافق جداً",
      "question_head": "فيما يلي 8 عبارات قد توافق عليها أو تختلف معها. باستخدام المقياس أدناه، حدد مدى موافقتك على كل عبارة.",
      "fs1": "أعيش حياة هادفة وذات معنى.",
      "fs2": "علاقاتي الاجتماعية داعمة ومجزية.",
      "fs3": "أستمتع واهتم بأنشطتي اليومية.",
      "fs4": "أساهم بنشاط من أجل سعادة ورفاهية الاخرين.",
      "fs5": "أنا كفوء وقادر على أداء الأنشطة المهمة بالنسبة لي.",
      "fs6": "أنا شخص جيد وأعيش حياة جيدة.",
      "fs7": "أنا متفائل بمستقبلي.",
      "fs8": "الناس يحترمونني.",
      "debrief": "شكراً لإكمالك هذا الاستبيان."
    }
  }
}
