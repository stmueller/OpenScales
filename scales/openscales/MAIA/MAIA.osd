{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "MAIA",
      "name": "Multidimensional Assessment of Interoceptive Awareness",
      "abbreviation": "MAIA",
      "description": "32-item scale measuring eight dimensions of interoceptive awareness: Noticing (4 items), Not-Distracting (3 items, reverse-scored), Not-Worrying (3 items, 2 reverse-scored), Attention Regulation (7 items), Emotional Awareness (5 items), Self-Regulation (4 items), Body Listening (3 items), and Trusting (3 items). Rated on a 6-point frequency scale (0=Never to 5=Always).",
      "citation": "Mehling, W. E., Price, C., Daubenmier, J. J., Acree, M., Bartmess, E., & Stewart, A. (2012). The Multidimensional Assessment of Interoceptive Awareness (MAIA). PLoS ONE, 7(11). https://doi.org/10.1371/journal.pone.0048230",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1371/journal.pone.0048230",
      "version": "1.0",
      "domain": "Health"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 6,
      "min": 0,
      "max": 5,
      "labels": ["MAIA_r0", "MAIA_r1", "MAIA_r2", "MAIA_r3", "MAIA_r4", "MAIA_r5"],
      "question_head": "MAIA_head"
    },
    "dimensions": [
      {
        "id": "noticing",
        "name": "Noticing",
        "description": "Awareness of uncomfortable, comfortable, and neutral body sensations"
      },
      {
        "id": "not_distracting",
        "name": "Not-Distracting",
        "description": "Tendency not to ignore or distract oneself from sensations of pain or discomfort"
      },
      {
        "id": "not_worrying",
        "name": "Not-Worrying",
        "description": "Tendency not to worry or experience emotional distress with sensations of pain or discomfort"
      },
      {
        "id": "attention_regulation",
        "name": "Attention Regulation",
        "description": "Ability to sustain and control attention to body sensations"
      },
      {
        "id": "emotional_awareness",
        "name": "Emotional Awareness",
        "description": "Awareness of the connection between body sensations and emotional states"
      },
      {
        "id": "self_regulation",
        "name": "Self-Regulation",
        "description": "Ability to regulate distress by attention to body sensations"
      },
      {
        "id": "body_listening",
        "name": "Body Listening",
        "description": "Active listening to the body for insight"
      },
      {
        "id": "trusting",
        "name": "Trusting",
        "description": "Experience of one's body as safe and trustworthy"
      }
    ],
    "items": [
      {"id": "MAIA001", "type": "likert", "text_key": "MAIA001", "dimension": "noticing"},
      {"id": "MAIA002", "type": "likert", "text_key": "MAIA002", "dimension": "noticing"},
