{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "MES",
      "name": "Moral Expansiveness Scale",
      "abbreviation": "MES",
      "description": "30-item measure of the breadth of an individual's moral circle — i.e., which entities are considered deserving of moral care and consideration. Respondents place each entity into one of four nested moral circles: Inner Circle (score 3), Outer Circle (2), Fringes of Moral Concern (1), or Outside the Moral Boundary (0). Covers 18 human targets (close relations through stigmatized groups), 6 animals, and 6 nature entities. Higher scores indicate broader moral concern. Originally implemented as a drag-and-drop task; this implementation uses a 4-point ordered response format.",
      "citation": "Crimston, D., Bain, P. G., Hornsey, M. J., & Bastian, B. (2016). Moral expansiveness: Examining variability in the capacity to include others in the moral circle. Journal of Personality and Social Psychology, 111(4), 636–653. https://doi.org/10.1037/pspp0000086",
      "license": "CC BY 4.0",
      "license_url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0205373",
      "license_explanation": "CC BY 4.0 license confirmed by Crimston et al. (2018) PLoS ONE (https://doi.org/10.1371/journal.pone.0205373), which reproduces all 30 MES items under CC BY 4.0. Item texts are factual entity labels (common nouns).",
      "url": "https://doi.org/10.1037/pspp0000086",
      "version": "1.0",
      "domain": "Morality & Ethics"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-11",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Original task uses nested graphical circles (drag-and-drop). This implementation renders each entity as a 4-point ordered Likert item with the same four category labels scored 0–3 as in the original. Scoring: sum or mean of all 30 items (MES total), plus subscale sums for Humans (items 1–18), Animals (19–24), and Nature (25–30)."
    },
    "likert_options": {
      "points": 4,
      "min": 0,
      "labels": [
        "mes_r1",
        "mes_r2",
        "mes_r3",
        "mes_r4"
      ],
      "question_head": "mes_head",
      "show_numbers": "none",
      "max": 3
    },
    "dimensions": [
      {
        "id": "humans",
        "name": "Human Targets",
        "description": "Moral concern for 18 human entities ranging from close relations to stigmatized outgroups. Sum of items 1–18, range 0–54."
      },
      {
        "id": "animals",
        "name": "Animal Targets",
        "description": "Moral concern for 6 animal species. Sum of items 19–24, range 0–18."
      },
      {
        "id": "nature",
        "name": "Nature Targets",
        "description": "Moral concern for 6 nature entities. Sum of items 25–30, range 0–18."
      },
      {
        "id": "total",
        "name": "Total Moral Expansiveness",
        "description": "Sum of all 30 items. Range 0–90; higher = broader moral circle."
      }
    ],
