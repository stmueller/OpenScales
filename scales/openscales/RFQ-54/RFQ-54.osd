{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Reflective Functioning Questionnaire – 54 items",
      "code": "RFQ-54",
      "abbreviation": "RFQ-54",
      "description": "Full 54-item RFQ item pool (Fonagy, Luyten et al.). 7-point. Scored here on the validated RFQ-8 Certainty/Uncertainty subscales (the 8-item subset). The PLoS ONE supplemental (pone.0259030) documents additional Self/Other subscales — see notes.",
      "citation": "Reflective Functioning Questionnaire (RFQ-54). Supplemental to a PLoS ONE open-access (CC BY 4.0) article (https://doi.org/10.1371/journal.pone.0259030); see also Fonagy et al. (2016), PLoS ONE 11(7): e0158678.",
      "license": "CC BY 4.0",
      "license_explanation": "RFQ items are published in open-access PLoS ONE articles under CC BY 4.0 and reproduced here with attribution: the RFQ validity study with supplemental item materials (https://doi.org/10.1371/journal.pone.0259030, PLOS figshare 'RFQ54 with self and other subscales') and the RFQ-8 short form (Fonagy et al., 2016, PLoS ONE 11(7): e0158678).",
      "license_url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0259030",
      "url": "https://www.ucl.ac.uk/psychoanalysis/research/reflective-functioning-questionnaire-rfq",
      "domain": "Clinical",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Full 54-item RFQ. EN from RFQ_54.docx; KO from UCL Korean RFQ (54). Scored on the validated RFQ-8 Certainty/Uncertainty (8-item subset; recodes verified vs UCL SPSS syntax). TODO: incorporate the SELF / OTHER subscale scoring from the PLoS ONE pone.0259030 supplemental (PLOS figshare 'RFQ54 with self and other subscales'). LICENSE: CC BY via PLoS — now in openscales/. 'unscored' dimension holds pool items not in the RFQ-8."
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "max": 7,
      "labels": [
        "rfq54_r1",
        "rfq54_r2",
