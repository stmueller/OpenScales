    "hi": {
      "gse1": "यदि मैं कठिन प्रयत्न करूं तो मैं हमेशा कठिन समस्याओं का समाधान कर सकता/सकती हूं।",
      "gse2": "यदि कोई मेरा विरोध करता है तो भी मैं अपने उद्देश्य की प्राप्ति के लिए कई साधन और तरीके ढूंढ ही लेता/लेती हूं।",
      "gse3": "मेरे लिए अपने लक्ष्य पर टिके रहना और अपने उद्देश्य को पूरा करना आसान है।",
      "gse4": "मुझे अपने पर पूरा विश्वास है कि मैं अचानक होने वाली घटनाओं का कुशलता से सामना कर सकता/सकती हूं।",
      "gse5": "मुझे अपनी चातुर्य-सम्पन्नता पर गर्व है, मैं जानता/जानती हूं कि अनदेखी परिस्थितियों का सामना कैसे करना चाहिए।",
      "gse6": "अक्सर मैं ठीक प्रयत्न करूं तो मैं अधिकतर समस्याओं का समाधान कर सकता/सकती हूं।",
      "gse7": "कठिन परिस्थितियों में भी मैं शान्त रह सकता/सकती हूं क्योंकि मुझे अपनी योग्यता पर विश्वास है।",
      "gse8": "जब मेरे सामने कोई समस्या होती है तो मैं उसके कई हल निकाल सकता/सकती हूं।",
      "gse9": "यदि मैं मुश्किल में होऊं/होती हूं तो प्रायः कुछ न कुछ करने का सोच ही लेता/लेती हूं।",
      "gse10": "चाहे कुछ भी मेरे रास्ते में आ जाए मैं उसका सामना कर ही लेता/लेती हूं।",
