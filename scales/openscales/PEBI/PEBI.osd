{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "PEBI",
      "name": "Pro-Environmental Behavior Intention Scale",
      "abbreviation": "PEBI",
      "description": "12-item scale measuring intention to engage in pro-environmental behaviors in the near future, covering recycling, purchasing choices, water and energy conservation. Rated on an 11-point scale (0=0% chance, certainly will NOT do it; 10=100% chance, certainly will do it).",
      "citation": "Tam, K.-P. (2022). Gratitude to nature: Presenting a theory of its conceptualization, measurement, and effects on pro-environmental behavior. Journal of Environmental Psychology, 79, 1–14. https://doi.org/10.1016/j.jenvp.2021.101754",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1016/j.jenvp.2021.101754",
      "version": "1.0",
      "domain": "Environment"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-10",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
