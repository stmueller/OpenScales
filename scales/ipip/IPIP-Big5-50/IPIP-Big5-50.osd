    "el": {
      "ipip_likert_1": "Καθόλου αντιπροσωπευτικό",
      "ipip_likert_3": "Δεν μπορώ να αποφασίσω",
      "ipip_likert_5": "Πολύ αντιπροσωπευτικό",
      "ipip_likert_4": "Κάπως αντιπροσωπευτικό",
      "ipip_question_head": "<h3>Πώς θα περιγράφατε τον εαυτό σας;</h3><p>Στις σελίδες που ακολουθούν υπάρχουν φράσεις που περιγράφουν συμπεριφορές ανθρώπων. Παρακαλώ χρησιμοποιήστε την παρακάτω κλίμακα για να αξιολογήσετε πόσο αντιπροσωπευτική είναι κάθε πρόταση για εσάς. Περιγράψτε τον εαυτό σας όπως είστε γενικά τώρα, όχι όπως θα θέλατε να είστε στο μέλλον. Οι απαντήσεις σας θα παραμείνουν απολύτως εμπιστευτικές.</p>",
      "ipip_likert_2": "Λίγο αντιπροσωπευτικό",
      "ipip_debrief": "Σας ευχαριστούμε για τη συμπλήρωση αυτού του ερωτηματολογίου.",
      "ipip_H1130": "Συμπάσχω με τα συναισθήματα των άλλων.",
      "ipip_text_am_easily_disturbed": "Ενοχλούμαι εύκολα.",
      "ipip_X176": "Δυσκολεύομαι να κατανοήσω αφηρημένες ιδέες.",
      "ipip_X56": "Δεν μιλώ πολύ.",
      "ipip_X165": "Δεν ενδιαφέρομαι πραγματικά για τους άλλους ανθρώπους.",
      "ipip_E119": "Κάνω τις «αγγαρείες» αμέσως.",
      "ipip_X177": "Έχω μαλακή καρδιά.",
      "ipip_X68": "Δεν μου αρέσει να προσελκύω την προσοχή πάνω μου.",
      "ipip_X179": "Ακολουθώ ένα πρόγραμμα.",
      "ipip_X82": "Συχνά ξεχνώ να βάζω τα πράγματα πίσω στη σωστή τους θέση.",
      "ipip_X87": "Είμαι πάντοτε προετοιμασμένος.",
      "ipip_E141": "Είμαι χαλαρός/ή τις περισσότερες φορές.",
      "ipip_X114": "Αφιερώνω χρόνο για να αξιολογώ τα πράγματα (που κάνω).",
      "ipip_H761": "Εκνευρίζομαι εύκολα.",
      "ipip_text_leave_my_belongings_around": "Αφήνω τα πράγματά μου ολόγυρα.",
      "ipip_X156": "Σπάνια νοιώθω μελαγχολία.",
      "ipip_X227": "Δεν ενδιαφέρομαι για τα προβλήματα των άλλων.",
      "ipip_H1103": "Προσβάλλω τους άλλους.",
      "ipip_X244": "Αισθάνομαι μικρό ενδιαφέρον για τους άλλους.",
      "ipip_X14": "Έχω ζωηρή (ζωντανή) φαντασία.",
      "ipip_H1039": "Έχω ελάχιστα πράγματα να πω.",
      "ipip_H21": "Ενδιαφέρομαι για τους ανθρώπους.",
      "ipip_H1467": "Τα κάνω άνω κάτω.",
      "ipip_H107": "Κάνω τους ανθρώπους να αισθάνονται άνετα.",
      "ipip_H154": "Προτιμώ να μένω στο παρασκήνιο.",
      "ipip_X100": "Είμαι γρήγορος/η στο να καταλαβαίνω πράγματα.",
      "ipip_H160": "Βρίσκω χρόνο για τους άλλους.",
      "ipip_X118": "Μου αρέσει η τάξη.",
      "ipip_H1313": "Έχω εξαιρετικές ιδέες.",
      "ipip_X78": "Δεν με ενοχλεί να είμαι το επίκεντρο της προσοχής.",
      "ipip_E136": "Αισθάνομαι τα συναισθήματα των άλλων.",
      "ipip_H1276": "Έχω ένα πλούσιο λεξιλόγιο.",
      "ipip_X74": "Συχνά αισθάνομαι μελαγχολικά.",
      "ipip_H53": "Είμαι γεμάτος/η ιδέες.",
      "ipip_H1157": "Ανησυχώ για διάφορα πράγματα.",
      "ipip_H16": "Αρχίζω συζητήσεις.",
      "ipip_X83": "Μιλώ με πολλούς διαφορετικούς ανθρώπους στα πάρτι.",
      "ipip_H1272": "Χρησιμοποιώ δύσκολες λέξεις.",
      "ipip_E92": "Έχω συχνές εναλλαγές στη διάθεσή μου.",
      "ipip_H926": "Η διάθεσή μου αλλάζει διαρκώς.",
      "ipip_X272": "Δεν έχω καλή φαντασία.",
      "ipip_X228": "Δεν ενδιαφέρομαι για αφηρημένες ιδέες.",
      "ipip_X112": "Αισθάνομαι άνετα όταν βρίσκομαι ανάμεσα σε ανθρώπους.",
      "ipip_X107": "Αγχώνομαι εύκολα.",
      "ipip_X163": "Είμαι ακριβής στη δουλειά μου.",
      "ipip_H661": "Είμαι ήσυχος/η όταν βρίσκομαι ανάμεσα σε ξένους.",
      "ipip_H34": "Είμαι η ζωή σε ένα πάρτι.",
      "ipip_H1140": "Αποφεύγω αυτά που πρέπει να κάνω (τα καθήκοντά μου).",
      "ipip_X95": "Αναστατώνομαι εύκολα.",
      "ipip_H1362": "Δίνω προσοχή στις λεπτομέρειες ."
    },
    "sr": {
      "ipip_likert_1": "Potpuno netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_H1157": "Često sam zabrinut.",
      "ipip_H926": "Često menjam raspolozenja.",
      "ipip_H1103": "Često vređam druge ljude.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_X78": "Ne smeta mi da budem u centru pažnje.",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H107": "Činim da se ljudi osećaju spokojno.",
      "ipip_H16": "Često sam ja taj koji započinje razgovor.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_X112": "Osećam se prijatno kada sam u društvu drugih ljudi.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_text_leave_my_belongings_around": "Često ostavljam svoje stvari svuda unaokolo.",
      "ipip_H1130": "Saosećam sa drugima.",
      "ipip_X272": "Nemam bujnu maštu.",
      "ipip_X100": "Brzo shvatam stvari.",
      "ipip_H1276": "Smatram da imam bogat rečnik.",
      "ipip_X74": "Često se osećam potišteno.",
      "ipip_X107": "Lako se podlegnem stresu.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_X177": "Mekog sam srca.",
      "ipip_X82": "Često zaboravim da vratim stvari na svoje mesto.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_X68": "Ne volim da skrećem pažnju na sebe.",
      "ipip_X165": "Nisam preterano zainteresovan za druge.",
      "ipip_H34": "Uvek sam glavni na žurci.",
      "ipip_X176": "Imam poteškoća u razumevanju apstraktnih ideja.",
      "ipip_X83": "Na zabavama pričam sa puno različitih ljudi.",
      "ipip_X118": "Volim red.",
      "ipip_E136": "Osećam emocije drugih ljudi.",
      "ipip_X163": "Precizan sam u poslu koji radim.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_H53": "Pun sam ideja.",
      "ipip_E119": "Svoje obaveze obavljam odmah.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H160": "Odvajam vreme za druge.",
      "ipip_X114": "Provodim vreme razmišljajući o stvarima.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_H1140": "Izbegavam svoje obaveze.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_H1467": "Često pravim nered.",
      "ipip_text_am_easily_disturbed": "Lako me je uznemiriti.",
      "ipip_H1272": "Često koristim komplikovane reči.",
      "ipip_H1039": "Imam malo toga da kažem.",
      "ipip_X87": "Uvek sam spreman na sve.",
      "ipip_X244": "Vrlo malo brinem za druge.",
      "ipip_H154": "Držim se u pozadini."
    },
    "sv": {
      "ipip_likert_1": "Mycket inexakt",
      "ipip_debrief": "Tack för att du fyllde i denna enkät.",
      "ipip_question_head": "<h3>Hur exakt kan du beskriva dig själv?</h3><p>Beskriv dig själv som du i allmänhet är nu, inte som du önskar vara i framtiden. Beskriv dig själv så ärligt som du ser dig själv, i förhållande till andra människor du känner av samma kön och ungefär samma ålder. För att du ska kunna beskriva dig själv på ett ärligt sätt kommer dina svar att hållas i absolut sekretess. Ange hur exakt påståendet passar dig enligt följande skala:</p>",
      "ipip_likert_5": "Mycket exakt",
      "ipip_likert_2": "Måttligt inexakt",
      "ipip_likert_3": "Varken exakt eller inexakt",
      "ipip_likert_4": "Måttligt exakt",
      "ipip_H1157": "Oroar mig över saker",
      "ipip_H926": "Har ett humör som svänger mycket",
      "ipip_H1103": "Förolämpar folk",
      "ipip_H21": "Är intresserad av människor",
      "ipip_X78": "Har inte något emot att vara centrum för uppmärksamheten",
      "ipip_E141": "Är avslappnad för det mesta",
      "ipip_H107": "Får människor att känna sig väl till mods",
      "ipip_H16": "Sätter igång konversationer",
      "ipip_X179": "Följer ett schema",
      "ipip_X228": "Är inte intresserad av abstrakta idéer",
      "ipip_X112": "Trivs med människor omkring mig",
      "ipip_X14": "Har en livlig fantasi",
      "ipip_text_leave_my_belongings_around": "Lämnar mina saker liggande överallt",
      "ipip_H1130": "Sympatiserar med andras känslor",
      "ipip_X272": "Är fantasilös",
      "ipip_X100": "Förstår saker snabbt",
      "ipip_H1276": "Har ett rikt ordförråd",
      "ipip_X74": "Känner mig ofta nere",
      "ipip_X107": "Blir lätt stressad",
      "ipip_H1362": "Uppmärksammar detaljer",
      "ipip_H661": "Är tyst tillsammans med främlingar",
      "ipip_X177": "Har ett gott hjärta",
      "ipip_X82": "Glömmer ofta att lägga tillbaka saker på sin plats",
      "ipip_X95": "Blir lätt upprörd",
      "ipip_X68": "Tycker inte om att dra uppmärksamhet till mig",
      "ipip_X165": "Är egentligen inte intresserad av andra",
      "ipip_H34": "Är den som håller igång på ett party",
      "ipip_X176": "Har svårt att förstå abstrakta idéer",
      "ipip_X83": "Pratar med en massa olika människor på fester",
      "ipip_X118": "Tycker om ordning",
      "ipip_E136": "Känner andra människors känslor",
      "ipip_X163": "Är grundlig i mitt arbete",
      "ipip_H1313": "Har utmärkta idéer",
      "ipip_H53": "Är full av idéer",
      "ipip_E119": "Gör hushållsarbete genast",
      "ipip_X227": "Är inte intresserad av andra människors problem",
      "ipip_H160": "Tar mig tid för andra människor",
      "ipip_X114": "Ägnar tid åt att fundera på saker",
      "ipip_H761": "Blir lätt irriterad",
      "ipip_H1140": "Smiter undan mina plikter",
      "ipip_E92": "Har ofta förekommande humörsvängningar",
      "ipip_X56": "Pratar inte mycket",
      "ipip_X156": "Känner mig sällan nere",
      "ipip_H1467": "Skapar oreda omkring mig",
      "ipip_text_am_easily_disturbed": "Blir lätt störd",
      "ipip_H1272": "Använder svåra ord",
      "ipip_H1039": "Har lite att säga",
      "ipip_X87": "Är alltid förberedd",
      "ipip_X244": "Känner mig inte speciellt bekymrad om andra",
      "ipip_H154": "Håller mig i bakgrunden"
