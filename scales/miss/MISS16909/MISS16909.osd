{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Right-Wing Extremist Attitudes Scale",
      "code": "MISS16909",
      "abbreviation": "RWE-A",
      "description": "An 18-item scale measuring right-wing extremist attitudes across six theoretically grounded subdimensions: Support for a Right-Wing Dictatorship (F1; REX01, REX03, REX04), National Chauvinism (F2; REX08, REX12, REX14), Trivialization of National Socialism (F3; REX02, REX11, REX18), Xenophobia (F4; REX06, REX10, REX16), Antisemitism (F5; REX07, REX13, REX17), and Social Darwinism (F6; REX05, REX09, REX15). Items use a 5-point Likert scale (1=fully disagree to 5=fully agree). Validated across five repeated cross-sectional German population surveys (Mitte-survey, 2014–2023) confirming a stable second-order factor structure with measurement invariance over time and demographic subgroups. Originally developed in German; English translation from Heller et al. (2022). The scale has been in use in Germany for over 20 years.",
      "citation": "Küpper, B., Reinecke, J., Mokros, N., & Zick, A. (2025). Validation of a model of right-wing extremist attitudes based on a repeated cross-sectional survey in Germany. Measurement Instruments for the Social Sciences, 7, Article e16909. https://doi.org/10.5964/miss.16909",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/16909",
      "domain": "Social",
      "version": "1.0",
      "show_header": false
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Item text (English) verbatim from Figure 1 of Küpper et al. (2025) and Heller et al. (2022). Original scale was developed and validated in German; English translations follow Heller et al. (2022). German item text not reproduced here as it was not provided in the MISS article. Factor assignments: F1=REX01,03,04; F2=REX08,12,14; F3=REX02,11,18; F4=REX06,10,16; F5=REX07,13,17; F6=REX05,09,15. show_header set to false: the scale title should not be displayed to respondents, as awareness of the scale's construct may bias responding."
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": ["rwea_r1", "rwea_r2", "rwea_r3", "rwea_r4", "rwea_r5"]
    },
    "dimensions": [
      {
        "id": "dictatorship",
        "name": "Support for a Right-Wing Dictatorship",
        "abbreviation": "F1",
        "description": "Support for authoritarian, nationalist political leadership. Mean of 3 items (REX01, REX03, REX04), range 1–5; higher = stronger support."
      },
      {
        "id": "chauvinism",
        "name": "National Chauvinism",
        "abbreviation": "F2",
        "description": "Belief in national superiority and aggressive pursuit of national interests. Mean of 3 items (REX08, REX12, REX14), range 1–5; higher = stronger chauvinism."
      },
      {
        "id": "ns_trivialization",
        "name": "Trivialization of National Socialism",
        "abbreviation": "F3",
        "description": "Minimization or positive reframing of National Socialism and the Holocaust. Mean of 3 items (REX02, REX11, REX18), range 1–5; higher = greater trivialization."
      },
      {
        "id": "xenophobia",
        "name": "Xenophobia",
        "abbreviation": "F4",
        "description": "Negative attitudes toward foreigners and immigration. Mean of 3 items (REX06, REX10, REX16), range 1–5; higher = stronger xenophobia."
      },
      {
        "id": "antisemitism",
        "name": "Antisemitism",
        "abbreviation": "F5",
        "description": "Antisemitic beliefs and stereotypes. Mean of 3 items (REX07, REX13, REX17), range 1–5; higher = stronger antisemitism."
      },
      {
        "id": "social_darwinism",
        "name": "Social Darwinism",
        "abbreviation": "F6",
        "description": "Belief in social hierarchies based on strength, ethnicity, or inherent worth. Mean of 3 items (REX05, REX09, REX15), range 1–5; higher = stronger social Darwinism."
      }
    ],
    "items": [
      {"id": "rex01", "type": "likert", "text_key": "rex01", "dimension": "dictatorship"},
      {"id": "rex02", "type": "likert", "text_key": "rex02", "dimension": "ns_trivialization"},
      {"id": "rex03", "type": "likert", "text_key": "rex03", "dimension": "dictatorship"},
      {"id": "rex04", "type": "likert", "text_key": "rex04", "dimension": "dictatorship"},
      {"id": "rex05", "type": "likert", "text_key": "rex05", "dimension": "social_darwinism"},
      {"id": "rex06", "type": "likert", "text_key": "rex06", "dimension": "xenophobia"},
      {"id": "rex07", "type": "likert", "text_key": "rex07", "dimension": "antisemitism"},
      {"id": "rex08", "type": "likert", "text_key": "rex08", "dimension": "chauvinism"},
      {"id": "rex09", "type": "likert", "text_key": "rex09", "dimension": "social_darwinism"},
      {"id": "rex10", "type": "likert", "text_key": "rex10", "dimension": "xenophobia"},
      {"id": "rex11", "type": "likert", "text_key": "rex11", "dimension": "ns_trivialization"},
      {"id": "rex12", "type": "likert", "text_key": "rex12", "dimension": "chauvinism"},
      {"id": "rex13", "type": "likert", "text_key": "rex13", "dimension": "antisemitism"},
      {"id": "rex14", "type": "likert", "text_key": "rex14", "dimension": "chauvinism"},
      {"id": "rex15", "type": "likert", "text_key": "rex15", "dimension": "social_darwinism"},
      {"id": "rex16", "type": "likert", "text_key": "rex16", "dimension": "xenophobia"},
      {"id": "rex17", "type": "likert", "text_key": "rex17", "dimension": "antisemitism"},
      {"id": "rex18", "type": "likert", "text_key": "rex18", "dimension": "ns_trivialization"}
    ],
    "scoring": {
      "dictatorship": {
        "description": "Mean of REX01, REX03, REX04. Range 1–5; higher = stronger support for right-wing dictatorship.",
        "method": "mean_coded",
        "items": ["rex01", "rex03", "rex04"]
      },
      "chauvinism": {
        "description": "Mean of REX08, REX12, REX14. Range 1–5; higher = stronger national chauvinism.",
        "method": "mean_coded",
        "items": ["rex08", "rex12", "rex14"]
      },
      "ns_trivialization": {
        "description": "Mean of REX02, REX11, REX18. Range 1–5; higher = greater trivialization of National Socialism.",
        "method": "mean_coded",
        "items": ["rex02", "rex11", "rex18"]
      },
      "xenophobia": {
        "description": "Mean of REX06, REX10, REX16. Range 1–5; higher = stronger xenophobia.",
        "method": "mean_coded",
        "items": ["rex06", "rex10", "rex16"]
      },
      "antisemitism": {
        "description": "Mean of REX07, REX13, REX17. Range 1–5; higher = stronger antisemitism.",
        "method": "mean_coded",
        "items": ["rex07", "rex13", "rex17"]
      },
      "social_darwinism": {
        "description": "Mean of REX05, REX09, REX15. Range 1–5; higher = stronger social Darwinism.",
        "method": "mean_coded",
        "items": ["rex05", "rex09", "rex15"]
      },
      "total": {
        "description": "Mean of all 18 items. Range 1–5; higher = greater overall right-wing extremist attitudes. Reflects the second-order RWE-A factor.",
        "method": "mean_coded",
        "items": ["rex01", "rex02", "rex03", "rex04", "rex05", "rex06", "rex07", "rex08", "rex09", "rex10", "rex11", "rex12", "rex13", "rex14", "rex15", "rex16", "rex17", "rex18"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "Attitudes Survey Report",
      "footer_refs": [
        "Küpper, B., Reinecke, J., Mokros, N., & Zick, A. (2025). Validation of a model of right-wing extremist attitudes based on a repeated cross-sectional survey in Germany. Measurement Instruments for the Social Sciences, 7, e16909. https://doi.org/10.5964/miss.16909",
        "Heller, A., Wicke, F. S., Kasinger, C., Beutel, M. E., Decker, O., Schuler, J., & Brähler, E. (2022). On the association of interpersonal trust with right-wing extremist and authoritarian attitudes.",
        "Higher subscale scores indicate stronger endorsement of each right-wing extremist attitude dimension."
      ]
    }
  },
  "translations": {
    "en": {
      "rwea_r1": "fully disagree",
      "rwea_r2": "mostly disagree",
      "rwea_r3": "partly agree/partly disagree",
      "rwea_r4": "mostly agree",
      "rwea_r5": "fully agree",
      "rex01": "Under certain circumstances a dictatorship better serves the national interest.",
      "rex02": "Had it not been for the Holocaust, Hitler would be regarded as a great statesman today.",
      "rex03": "Germany needs a strong single party that represents the ethnic community as a whole.",
      "rex04": "We should have a leader that rules Germany with a firm hand to the benefit of all.",
      "rex05": "Just as in nature, the strongest in a society should always get their way.",
      "rex06": "Foreigners only come here to abuse the welfare system.",
      "rex07": "The influence of the Jews is still too strong.",
      "rex08": "We should dare to have strong nationalist feelings again.",
      "rex09": "The Germans are actually superior to other people by nature.",
      "rex10": "When jobs are scarce, foreigners should be sent home.",
      "rex11": "The crimes of National Socialism have been greatly exaggerated in historiography.",
      "rex12": "Today our country needs to firmly and energetically enforce its interests against other nations.",
      "rex13": "More than other people, the Jews use dirty tricks to achieve their goals.",
      "rex14": "The highest aim of German politicians should be to ensure that Germany has the power and recognition it deserves.",
      "rex15": "There is worthy and unworthy life.",
      "rex16": "Germany is losing its identity because of the large number of foreigners.",
      "rex17": "The Jews just have something peculiar about them and don't really fit in with us.",
      "rex18": "National Socialism also had positive aspects.",
      "debrief": "Thank you for completing this survey."
    },
    "de": {
      "rwea_r1": "stimme überhaupt nicht zu",
      "rwea_r2": "stimme eher nicht zu",
      "rwea_r3": "teils/teils",
      "rwea_r4": "stimme eher zu",
      "rwea_r5": "stimme voll und ganz zu",
      "rex01": "Im nationalen Interesse ist unter bestimmten Umständen eine Diktatur die bessere Staatsform.",
      "rex02": "Ohne Judenvernichtung würde man Hitler heute als großen Staatsmann ansehen.",
      "rex03": "Was Deutschland jetzt braucht ist eine einzige starke Partei, die die Volksgemeinschaft insgesamt verkörpert.",
      "rex04": "Wir sollten einen Führer haben, der Deutschland zum Wohle aller mit starker Hand regiert.",
      "rex05": "Wie in der Natur sollte sich in der Gesellschaft immer der Stärkere durchsetzen.",
      "rex06": "Die Ausländer kommen nur hierher, um unseren Sozialstaat auszunutzen.",
      "rex07": "Auch heute noch ist der Einfluss der Juden zu groß.",
      "rex08": "Wir sollten endlich wieder Mut zu einem starken Nationalgefühl haben.",
      "rex09": "Eigentlich sind die Deutschen anderen Völkern von Natur aus überlegen.",
      "rex10": "Wenn Arbeitsplätze knapp werden, sollte man die Ausländer wieder in ihre Heimat zurückschicken.",
      "rex11": "Die Verbrechen des Nationalsozialismus sind in der Geschichtsschreibung weit übertrieben worden.",
      "rex12": "Was unser Land heute braucht, ist ein hartes und energisches Durchsetzen deutscher Interessen gegenüber dem Ausland.",
      "rex13": "Die Juden arbeiten mehr als andere Menschen mit üblen Tricks, um das zu erreichen was sie wollen.",
      "rex14": "Das oberste Ziel der deutschen Politik sollte es sein, Deutschland die Macht und Geltung zu verschaffen, die ihm zusteht.",
      "rex15": "Es gibt wertvolles und unwertes Leben.",
      "rex16": "Die Bundesrepublik ist durch die vielen Ausländer in einem gefährlichem Maß überfremdet.",
      "rex17": "Die Juden haben einfach etwas Besonderes und Eigentümliches an sich und passen nicht so recht zu uns.",
      "rex18": "Der Nationalsozialismus hatte auch seine guten Seiten.",
      "debrief": "Vielen Dank für Ihre Teilnahme."
    }
  }
}
