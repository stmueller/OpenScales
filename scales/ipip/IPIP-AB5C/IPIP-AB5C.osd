    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_E141": "Većinu vremena sam opušten.",
      "ipip_H280": "Zahtevam mnogo od drugih.",
      "ipip_H288": "Zahtevam kvalitet.",
      "ipip_H1212": "Duboko promišljam o svemu.",
      "ipip_H920": "Lako se uvredim.",
      "ipip_H159": "Uvažavam tuđa osećanja.",
      "ipip_H964": "Prepuštam drugima da donose odluke.",
      "ipip_E104": "Nemam običaj da planiram unapred.",
      "ipip_E40": "Kupujem samo praktične stvari.",
      "ipip_E96": "Nisam onoliko strog koliko bi trebalo da budem.",
      "ipip_X237": "Ne opterećujem se potrebama drugih.",
      "ipip_H683": "Pun sam nedoumica u vezi raznih stvari.",
      "ipip_E157": "Verujem u ono što drugi kažu.",
      "ipip_E124": "Naslućujem potrebe drugih.",
      "ipip_H834": "Ne obraćam pažnju na svoj izgled.",
      "ipip_H774": "Vršim pritisak na druge ljude.",
      "ipip_H927": "Lako me je uznemiriti.",
      "ipip_H86": "Često zbijam šale.",
      "ipip_H277": "Teško me je zadovoljiti.",
      "ipip_H356": "Mogu da podnesem kritiku.",
      "ipip_X179": "Pratim određeni raspored.",
      "ipip_E51": "Kad se isplačem, osećam se bolje.",
      "ipip_H1138": "Previše pričam.",
      "ipip_H498": "Suprotstavljam se autoritetu.",
      "ipip_H743": "Sklon/a sam da precenjujem svoja postignuća.",
      "ipip_H1246": "Dobar sam u mnogim stvarima.",
      "ipip_H808": "Protivrečim drugima.",
      "ipip_H1074": "Mogu da naslutim tuđe želje.",
      "ipip_X93": "Često kasnim na posao.",
      "ipip_H2023": "Volim da uveseljavam druge.",
      "ipip_E63": "Ne zovem ljude samo radi ćaskanja.",
      "ipip_H2003": "Lako se zabavim.",
      "ipip_H37": "U dobrim sam odnosima skoro sa svima.",
      "ipip_H992": "Lako se rasplačem.",
      "ipip_H393": "Odmah pronađem rešenje.",
      "ipip_E143": "Nisam naročito osećajan.",
      "ipip_H154": "Držim se u pozadini.",
      "ipip_H1302": "Nikad ne ostajem \"bez teksta\".",
      "ipip_H661": "Tih sam u prisustvu nepoznatih ljudi.",
      "ipip_H762": "Lako se uvredim.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_H1351": "Kad nešto radim, obično se pridržavam plana.",
      "ipip_X29": "Retko reagujem emotivno.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H575": "Ne marim za pravila.",
      "ipip_H648": "Izbegavam kontakte sa drugima.",
      "ipip_X144": "Ne volim koncerte.",
      "ipip_H1256": "Obično mislim unapred.",
      "ipip_E105": "Vidim lepotu u stvarima koje drugi možda ne primećuju.",
      "ipip_H1336": "Znam kako da primenim svoje znanje.",
      "ipip_H1244": "Volim lepe stvari.",
      "ipip_E66": "Često pravim planove u poslednjem trenutku.",
      "ipip_X177": "Mekog sam srca.",
      "ipip_H769": "Zahtevam da budem u centru interesovanja.",
      "ipip_H296": "Poštujem autoritete.",
      "ipip_H794": "Često nešto radim na tuđi račun.",
      "ipip_H33": "Volim život.",
      "ipip_H195": "Volim da udovoljavam drugima.",
      "ipip_X81": "Volim muziku.",
      "ipip_H241": "Volim kada je sve u savršenom redu.",
      "ipip_H1380": "Ne umem da smišljam nove ideje.",
      "ipip_E92": "Imam česte promene raspoloženja.",
      "ipip_E100": "Ne smetaju mi neuredni ljudi.",
      "ipip_E1": "Smesta preuzimam kontrolu i odgovornost.",
      "ipip_H779": "Zahtevam poslušnost od drugih.",
      "ipip_X148": "Otvoreno pokazujem svoja osećanja.",
      "ipip_X235": "Ne prijaju mi odlasci u muzeje.",
      "ipip_H225": "Raspitujem se kako su drugi ljudi.",
      "ipip_H204": "Želim da značim nešto drugima.",
      "ipip_E7": "Ne smeta mi nered.",
      "ipip_H215": "Vodim računa da se pravila poštuju.",
      "ipip_X85": "Otvoreno pokazujem drugima kakav sam.",
      "ipip_H2026": "Volim glasno da se smejem.",
      "ipip_H106": "Prihvatam ljude onakve kakvi jesu.",
      "ipip_X156": "Retko se osećam tužno.",
      "ipip_H730": "Volim kada mi drugi kažu da sam u pravu.",
      "ipip_H188": "Volim da drugima budem na usluzi.",
      "ipip_H592": "Tesko mi je da pridjem drugim ljudima",
      "ipip_X146": "Istrajavam u onom čemu sam se posvetio.",
      "ipip_H52": "Brzo se zbližim sa drugim ljudima.",
      "ipip_X201": "Volim da rešavam složene probleme.",
      "ipip_H328": "Znam šta želim.",
      "ipip_H524": "Pokušavam da predvodim druge.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_H1322": "Mogu izaći na kraj sa velikom količinom informacija.",
      "ipip_H2015": "Uživam kada sam zauzet i aktivan.",
      "ipip_X14": "Imam bujnu maštu.",
      "ipip_E145": "Uživam u razmišljanju.",
      "ipip_H3": "Pokazujem svoja osećanja.",
      "ipip_H58": "Uvek sam zauzet.",
      "ipip_H882": "Lako mi je udovoljiti.",
      "ipip_H21": "Zanimaju me ljudi.",
      "ipip_H230": "Obavljam svoj posao na vreme.",
      "ipip_H17": "Izražavam se s lakoćom.",
      "ipip_X171": "Volim da planiram unapred",
      "ipip_H1100": "Brinem za druge ljude.",
      "ipip_H601": "Ne otkrivam puno o sebi.",
      "ipip_E65": "Brzo sudim o drugim ljudima.",
      "ipip_H1284": "Dobro vladam jezikom.",
      "ipip_X82": "Često zaboravim da vratim stvari na svoje mesto.",
      "ipip_H568": "Uvek sam istog raspoloženja.",
      "ipip_H621": "Imam poteskoća da započnem neki posao.",
      "ipip_X203": "Ravnodušan sam prema tuđim emocijama.",
      "ipip_E52": "Obično mi se ne sviđaju impulsivni ljudi.",
      "ipip_H2013": "Iskazujem svoje intimne misli.",
      "ipip_H1157": "Često sam zabrinut.",
      "ipip_X216": "Nikad ne trošim više nego što mogu da priuštim.",
      "ipip_H1267": "Znam odgovore na mnoga pitanja.",
