  "translations": {
    "en": {
      "HSPR_head": "Please answer each question below by selecting the number between 1 = \"Not at all\" to 7 = \"Extremely\" that describes you best as a person overall. If a question can't be answered, please just leave it out and move on.",
      "HSPR_r1": "Not at all",
      "HSPR_r4": "Moderately",
      "HSPR_r7": "Extremely",
      "HSPR001": "Do you notice when things have been moved around?",
      "HSPR002": "Are you easily affected by feedback (both negative and positive)?",
      "HSPR003": "Are you easily overwhelmed by things like bright lights, strong smells, coarse fabrics, or sirens close by?",
      "HSPR004": "Do you easily recognise what others are feeling?",
      "HSPR005": "Do you notice and enjoy delicate or fine scents, tastes, sounds, works of art?",
      "HSPR006": "Are you easily affected by the mood of people around you?",
      "HSPR007": "Do you tend to reflect on things deeply?",
      "HSPR008": "Are you good at anticipating how someone may feel about a situation?",
      "HSPR009": "Are you bothered by intense stimuli, like loud noises or chaotic scenes?",
      "HSPR010": "Do you generally react strongly to your experiences, whether you show it or not?",
      "HSPR011": "Do other people tell you that you are good at understanding what they are feeling or thinking?",
      "HSPR012": "Do you tend to get deeply immersed in music?",
      "HSPR013": "Do you find yourself thinking about philosophical questions?",
      "HSPR014": "Do you seem to notice changes in the weather more than others do?",
      "HSPR015": "Do you become unpleasantly aroused when a lot is going on around you?",
      "HSPR016": "Are you deeply moved by the arts or music?",
      "HSPR017": "Do you tend to notice subtle signs of changing seasons (winter/spring etc.)?",
      "HSPR018": "Do you like deep conversations?"
    }
  }
}