        {
          "text_key": "opt_2",
          "value": 2
        },
        {
          "text_key": "opt_3",
          "value": 3
        },
        {
          "text_key": "opt_4",
          "value": 4
        }
      ]
    },
    "items": [
      {
        "id": "shared_decision_making_understand_issues",
        "text_key": "shared_decision_making_understand_issues",
        "type": "multi",
        "option_set": "default"
      },
      {
        "id": "shared_decision_making_importance",
