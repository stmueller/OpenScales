  "translations": {
    "en": {
      "opt_1": "No, I do not do this",
      "opt_2": "No, but I am learning how to do this",
      "opt_3": "Yes, I have started doing this when I am reminded",
      "opt_4": "Yes, I always do this when I am reminded",
      "opt_5": "Yes, I always do this when I need to",
      "sec_directions_below_is_a_list_of_skills_tha_title": "Directions: Below is a list of skills that teens use to manage their sickle cell disease. Please circle the number that best describes you for each question.",
      "self_management_skills_checklist_adolescent_name_medicine": "Can you name all your medicines?",
      "self_management_skills_checklist_adolescent_find_sickle_cell_information": "Can you find information about sickle cell disease if you need it (like at the doctor's office, on the internet, or in the community)?",
      "self_management_skills_checklist_adolescent_find_educational_option": "Can you find information about your educational options if you need it?",
      "self_management_skills_checklist_adolescent_ask_doctor_medical_questions": "Do you ask your doctor or medical team questions during clinical appointments?",
      "self_management_skills_checklist_adolescent_other_pain_management_strategies": "Do you use strategies other than pain medicines to manage your pain (like deep breathing, distraction, imagery)?",
      "self_management_skills_checklist_adolescent_take_medicine": "Do you take your medicines when you are supposed to?",
      "self_management_skills_checklist_adolescent_refill_pain_medicine": "Do you refill your pain medicines on your own?",
      "self_management_skills_checklist_adolescent_complete_medical_history_form": "Do you complete a medical history form on your own?",
      "self_management_skills_checklist_adolescent_healthy_lifestyle": "Do you take part in activities to stay healthy like exercising and eating healthy foods?",
      "self_management_skills_checklist_adolescent_talk_when_sad": "Do you find someone to talk to if you feel sad, down, anxious, or angry?",
      "self_management_skills_checklist_adolescent_talk_school_future_education": "Do you talk to your school or medical team about your education and the future?",
      "self_management_skills_checklist_adolescent_sickle_cell_disease_type": "Do you know what type of sickle cell disease you have?",
      "self_management_skills_checklist_adolescent_sickle_cell_disease_type_opt_1": "No, I don't know",
