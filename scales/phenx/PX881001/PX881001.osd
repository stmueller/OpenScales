  "translations": {
    "en": {
      "opt_1": "Yes",
      "opt_2": "No",
      "scd_pain_menstruation_identify_triggersrecord_id": "Record ID",
      "scd_pain_menstruation_title": "Questions Regarding SCD Pain Associated with Menstruation, excerpted from Demographic Survey from Table 1 in Sharma et al. (2019).",
      "scd_pain_menstruation_desc": "The Sickle Cell Disease Genitourinary Working Group notes the term \"pain\" in the questions below refers to specifically to \"sickle cell pain.\"",
      "scd_pain_menstruation_identify_triggers": "Have you been able to identify any triggers for your pain?",
      "scd_pain_menstruation_identify_triggers_what": "If you answered yes to question 1, what triggers your pain? (Circle all that apply)",
      "scd_pain_menstruation_identify_triggers_what_opt_1": "Cold weather",
      "scd_pain_menstruation_identify_triggers_what_opt_2": "Seasons changing",
      "scd_pain_menstruation_identify_triggers_what_opt_3": "Dehydration in the summer time",
      "scd_pain_menstruation_identify_triggers_what_opt_4": "Exercise",
      "scd_pain_menstruation_identify_triggers_what_opt_5": "Menstrual periods",
      "scd_pain_menstruation_identify_triggers_what_opt_6": "Stress",
      "scd_pain_menstruation_identify_triggers_what_opt_7": "Illness",
      "scd_pain_menstruation_identify_triggers_what_opt_8": "Other",
      "scd_pain_menstruation_identify_triggers_what_opt_9": "Not applicable",
      "scd_pain_menstruation_identify_triggers_what_other": "If you answered yes to question 1, what triggers your pain? (Circle all that apply) Other",
      "scd_pain_menstruation_experience_pain_week_before_period": "Have you ever experienced \\sickle cell pain\\\" in the week before or during your period?\"",
      "scd_pain_menstruation_experience_pain_week_before_period_when_start": "If you answered \\Yes\\\" to the question above (question 3)",
      "scd_pain_menstruation_experience_pain_week_before_period_how_often": "If you answer \\Yes\\\" to question 3 above",
      "scd_pain_menstruation_scoring": "Scoring Instructions:Acute \"sickle cell\" pain associated with menstruation is defined as a \"Yes\" answer to all of the following:Do your menstrual periods trigger your \"sickle cell pain\"•\tAnswers \"Yes\" to question 1 and•\tSelects \"Menstrual periods\" in question 2. Do you start to have \"sickle cell pain\" 0-7 days before or during your periods?•\tAnswers \"Yes\" to question 3 and•\tSelects \"0-7 days before the start of your menstrual period\" or \"During your menstrual period\" in question 4. Does your \"sickle cell pain\" occur with either every or almost every menstrual period?•\tSelects \"Almost every period\" or \"With every period\" for question 5."
    }
  }
