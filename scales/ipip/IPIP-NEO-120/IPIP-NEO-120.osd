    "hr": {
      "ipip_likert_2": "Uglavnom netočno",
      "ipip_debrief": "Hvala vam na sudjelovanju.",
      "ipip_likert_5": "Posve točno",
      "ipip_likert_3": "Ni točno ni netočno",
      "ipip_likert_1": "Posve netočno",
      "ipip_question_head": "<h3>Koliko točno možete opisati sebe?</h3><p>Na sljedećim stranicama nalaze se tvrdnje koje opisuju uobičajeno ponašanje ljudi. Molimo vas da, koristeći se priloženom ljestvicom, procijenite koliko pojedini iskaz vjerno opisuje baš vas.</p>",
      "ipip_likert_4": "Uglavnom točno",
      "ipip_X274": "Lako odolijevam iskušenjima.",
      "ipip_text_take_control_of_things": "Preuzimam kontrolu nad događajima.",
      "ipip_H918": "Nemam vremena za druge.",
      "ipip_X133": "Volim tulumariti.",
      "ipip_H640": "Često sam turoban.",
      "ipip_H312": "Privržen sam uhodanom načinu života.",
      "ipip_H862": "Srljam u stvari.",
      "ipip_X14": "Imam živu maštu.",
      "ipip_X45": "Ne volim poeziju.",
      "ipip_H704": "Držim ljude na distanci.",
      "ipip_X211": "Volim čitati izazovne sadržaje.",
      "ipip_H648": "Izbjegavam susrete s drugima.",
      "ipip_H145": "Govorim istinu.",
      "ipip_E163": "Sviđa mi se kada se izgubim u mislima.",
      "ipip_H427": "Iskorištavam druge.",
      "ipip_H244": "Volim pospremati.",
      "ipip_X126": "Sklon sam glasovanju za konzervativne političke kandidate.",
      "ipip_H976": "Čekam da drugi preuzmu vodstvo.",
      "ipip_H549": "Vjerujem da drugi imaju dobre namjere.",
      "ipip_H954": "Osjećam da se ne mogu nositi s nekim stvarima.",
      "ipip_H453": "Volim se svađati.",
      "ipip_H592": "Teško pristupam drugima.",
      "ipip_H1195": "Nemam povjerenja u ljude.",
      "ipip_H809": "Vičem na ljude.",
      "ipip_H1100": "Brinem se za druge ljude.",
      "ipip_H1206": "Naporno radim.",
      "ipip_X129": "Osjećam se ugodno u vlastitoj koži.",
      "ipip_X259": "Suosjećam s beskućnicima.",
      "ipip_H1354": "S lakoćom obavljam zadatke.",
      "ipip_X248": "Izbjegavam filozofske rasprave.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_H650": "Izbjegavam gužvu.",
      "ipip_H948": "Lako se uspaničim.",
      "ipip_text_trust_what_people_say": "Vjerujem onome što ljudi govore.",
      "ipip_H1103": "Vrijeđam ljude.",
      "ipip_X30": "Volim se držati stvari koje poznajem.",
      "ipip_X198": "Varam kako bih napredovao.",
      "ipip_H846": "Djelujem bez razmišljanja.",
      "ipip_X82": "Često zaboravljam vratiti stvari na njihovo mjesto.",
      "ipip_H2014": "Radim više nego što se od mene očekuje.",
      "ipip_X10": "Rijetko primjećujem svoje emocionalne reakcije.",
      "ipip_H587": "Volim biti sam.",
      "ipip_E136": "Osjećam tuđe emocije.",
      "ipip_X204": "Više volim raznolikost nego rutinu.",
      "ipip_X83": "Na zabavama razgovaram s mnogo različitih ljudi.",
      "ipip_H1285": "Uspješno završavam zadatke.",
      "ipip_H1108": "Volim pomagati drugima.",
      "ipip_X123": "Smatram da je umjetnost važna.",
      "ipip_E35": "Volim biti nepromišljen.",
      "ipip_X15": "Ne volim sebe.",
      "ipip_X235": "Ne volim posjećivati muzeje umjetnosti.",
      "ipip_H113": "Imam povjerenja u druge.",
      "ipip_X112": "Ugodno se osjećam među ljudima.",
      "ipip_H968": "Bojim se mnogih stvari.",
      "ipip_X92": "Snažno doživljavam emocije.",
      "ipip_X87": "Uvijek sam pripravan.",
      "ipip_H446": "Tražim pustolovinu.",
      "ipip_H655": "Bojim se privući pažnju.",
      "ipip_X239": "Ne zanimaju me teorijske rasprave.",
      "ipip_E105": "Vidim ljepotu u stvarima koju drugi ne zamjećuju.",
      "ipip_H258": "Izvršavam svoje planove.",
      "ipip_X251": "Mogu kontrolirati svoje porive.",
      "ipip_text_leave_my_belongings_around": "Ostavljam stvari uokolo.",
      "ipip_H1333": "Znam kako obaviti stvari.",
      "ipip_H1018": "Ne pridržavam se obećanja.",
      "ipip_E166": "Trudim se ne razmišljati o ljudima u nevolji.",
      "ipip_text_excel_in_what_i_do": "Ističem se u onom što radim.",
      "ipip_X181": "Rijetko si previše ugađam.",
      "ipip_H79": "Mnogo toga radim u slobodno vrijeme.",
      "ipip_H334": "Preuzimam odgovornost.",
      "ipip_X23": "Ne gubim lako strpljenje.",
      "ipip_H438": "Volim uzbuđenje.",
      "ipip_X203": "Ravnodušan sam prema tuđim osjećajima.",
      "ipip_X107": "Lako se uznemirim.",
      "ipip_X74": "Često sam potišten.",
      "ipip_H754": "Lako se razljutim.",
      "ipip_H78": "Volim velike zabave.",
      "ipip_X176": "Teško razumijem apstraktne ideje.",
      "ipip_X157": "Smatram da zločin treba strogo kažnjavati.",
      "ipip_text_break_rules": "Kršim pravila.",
      "ipip_H1186": "Tratim svoje vrijeme.",
      "ipip_H822": "Ostavljam nered u svojoj sobi.",
      "ipip_H1157": "Zabrinut sam.",
      "ipip_E46": "Ulijećem u stvari bez razmišljanja.",
      "ipip_X218": "Sklon sam glasovanju za liberalne političke kandidate.",
      "ipip_H1063": "Ne volim promjene.",
      "ipip_H959": "Neki me događaji shrvaju.",
      "ipip_H738": "Imam visoko mišljenje o sebi.",
      "ipip_H755": "Lako izgubim živce.",
      "ipip_H871": "Ponašam se neobuzdano i luckasto.",
      "ipip_X79": "Smiren sam i pod pritiskom.",
      "ipip_X238": "Uživam u neobuzdanom maštanju.",
      "ipip_E156": "Ne razumijem ljude koji se prepuštaju osjećajima.",
      "ipip_text_feel_sympathy_for_those_who_are_worse_of": "Suosjećam s onima kojima je gore nego meni.",
      "ipip_H746": "Ističem svoje vrline.",
      "ipip_H621": "Teško mi je započeti zadatke.",
      "ipip_H761": "Lako se uzrujam.",
      "ipip_H42": "Gledam na život s optimizmom.",
      "ipip_H149": "Ispunjavam svoja obećanja.",
      "ipip_H32": "Zračim veseljem.",
      "ipip_X115": "Radim taman onoliko koliko je potrebno.",
      "ipip_H54": "Uvijek sam u pokretu.",
      "ipip_text_love_life": "Volim život.",
      "ipip_H699": "Osvećujem se.",
      "ipip_X184": "Vjerujem da ne postoji apsolutna istina.",
      "ipip_H416": "Iskorištavam druge za vlastiti probitak.",
      "ipip_H1094": "Puno se zabavljam.",
      "ipip_X167": "Ulažem malo vremena i truda u svoj posao.",
      "ipip_H29": "Lako sklapam prijateljstva.",
      "ipip_H853": "Donosim brzoplete odluke.",
      "ipip_H524": "Nastojim voditi druge.",
      "ipip_X71": "Volim sanjariti.",
      "ipip_H736": "Vjerujem da sam bolji od drugih.",
      "ipip_X209": "Ne opterećuju me teške socijalne situacije.",
      "ipip_H999": "Strah me najgoreg.",
      "ipip_H58": "Uvijek sam zaposlen.",
      "ipip_H656": "Osjećam se ugodno samo u krugu prijatelja.",
      "ipip_H2043": "Jako cijenim sebe.",
      "ipip_E113": "Ležerno pristupam stvarima.",
      "ipip_H494": "Ometam tuđe planove."
    },
    "hy": {
      "ipip_likert_2": "Չափավոր ճիշտ չէ",
      "ipip_debrief": "Շնորհակալություն հարցաշարը լրացնելու համար:",
      "ipip_likert_5": "Շատ ճիշտ է",
      "ipip_likert_3": "Ոչ ճիշտ, ոչ անճիշտ",
      "ipip_likert_1": "Բոլորովին ճիշտ չէ",
      "ipip_question_head": "<h3>Որքանո՞վ ճշգրիտ կարող եք նկարագրել ձեզ:</h3><p>Նկարագրեք ձեզ այնպիսին, ինչպիսին հիմա եք, ոչ թե այնպիսին, ինչպիսին ցանկանում եք լինել ապագայում: Նկարագրեք ձեզ ազնվորեն, ինչպես ձեզ եք տեսնում, ձեր հետ նույն սեռի և մոտ նույն տարիքի ծանոթ մարդկանց համեմատ: Որպեսզի կարողանաք ձեզ ազնվորեն նկարագրել, ձեր պատասխանները կպահվեն լիակատար գաղտնիության մեջ: Հետևյալ գնահատման սանդղակի օգնությամբ նշեք, որքանով է յուրաքանչյուր հայտարարությունը ճիշտ ձեր համար:</p>",
      "ipip_likert_4": "Չափավոր ճիշտ է",
      "ipip_X274": "Հեշտությամբ եմ դիմակայում գայթակղություններին:",
      "ipip_text_take_control_of_things": "Վերահսկողության տակ եմ վերցնում երևույթները։",
      "ipip_H918": "Ժամանակ չեմ տրամադրում ուրիշներին։",
      "ipip_X133": "Մի բանի չափն անցնում եմ։",
      "ipip_H640": "Հաճախ եմ վհատվում:",
      "ipip_H312": "Հավատարիմ եմ բոլորի կողմից ընդունված վարվելակերպին։",
      "ipip_H862": "Շտապում եմ գործել՝ առանց մտածելու:",
      "ipip_X14": "Ունեմ վառ երակայություն:",
      "ipip_X45": "Չեմ սիրում պոեզիան:",
      "ipip_H704": "Հեռավորության վրա եմ պահում այլ մարդկանց:",
      "ipip_X211": "Սիրում եմ կարդալ խրթին նյութեր:",
      "ipip_H648": "Խուսափում եմ ուրիշների հետ շփումից:",
      "ipip_H145": "Ասում եմ ճշմարտությունը:",
      "ipip_E163": "Սիրում եմ սուզվել մտքերի մեջ:",
      "ipip_H427": "Օգտվում եմ ուրիշ մարդկանցից։",
      "ipip_H244": "Սիրում եմ մաքրտել։",
      "ipip_X126": "Հակված եմ քվեարկել պահպանողական քաղաքական թեքնածուների օգտին:",
      "ipip_H976": "Սպասում եմ, որ մեկ ուրիշն առաջնորդի նախաձեռնությունները:",
      "ipip_H549": "Հավատում եմ, որ ուրիշները լավ մտադրություններ ունեն:",
      "ipip_H954": "Զգում եմ, որ անկարող եմ հաղթահարել դժվարությունները:",
      "ipip_H453": "Սիրում եմ մի լավ կռիվ տալ։",
      "ipip_H592": "Դժվարանում եմ ուրիշ մարդկանց մոտենալ։",
      "ipip_H1195": "Չեմ վստահում մարդկանց։",
      "ipip_H809": "Բղավում եմ մարդկանց վրա:",
      "ipip_H1100": "Մտահոգվում եմ այլոց մասին:",
      "ipip_H1206": "Տքնաջան աշխատում եմ:",
      "ipip_X129": "Հարմար եմ զգում ինքս իմ եսի հետ։",
      "ipip_X259": "Կարեկցում եմ անօթևան մարդկանց:",
      "ipip_H1354": "Առաջադրանքները սահուն կերպով եմ կատարում:",
      "ipip_X248": "Խուսափում եմ փիլիսոփայական քննարկումներից:",
      "ipip_X227": "Չեմ հետաքրքրվում այլ մարդկանց խնդիրներով:",
      "ipip_H650": "Խուսափում եմ ամբոխներից:",
      "ipip_H948": "Հեշտությամբ եմ խուճապի մատնվում:",
      "ipip_text_trust_what_people_say": "Վստահում եմ այլ մարդկանց խոսքերին:",
      "ipip_H1103": "Վիրավորում եմ մարդկանց:",
      "ipip_X30": "Նախընտրում եմ հավատարիմ մնալ ինձ ծանոթ բաներին:",
      "ipip_X198": "Խաբում եմ մարդկանց՝ առաջադիմելու համար:",
      "ipip_H846": "Գործում եմ՝ առանց մտածելու:",
      "ipip_X82": "Հաճախ մոռանում եմ իրերն իրենց ճիշտ տեղը դնել:",
      "ipip_H2014": "Անում եմ ավելին, քան ակնկալում են ինձանից:",
      "ipip_X10": "Հազվադեպ եմ նկատում իմ հուզական ռեակցիաները:",
      "ipip_H587": "Նախընտրում եմ լինել միայնակ:",
      "ipip_E136": "Զգում եմ այլոց հույզերը:",
      "ipip_X204": "Նախընտրում եմ զանազանություն, քան միապաղաղություն:",
      "ipip_X83": "Խնջույքների ժամանակ խոսում եմ մեծ քանակությամբ տարբեր մարդկանց հետ:",
      "ipip_H1285": "Հաջողությամբ եմ կատարում բոլոր առաջադրանքները:",
      "ipip_H1108": "Սիրում եմ օգնել ուրիշներին։",
      "ipip_X123": "Հավատում եմ արվեստի կարևորությանը:",
      "ipip_E35": "Վայելում եմ խենթ լինելը:",
      "ipip_X15": "Չեմ հավանում ինքս ինձ:",
      "ipip_X235": "Չեմ սիրում այցելել գեղարվեստական թանգարաններ:",
      "ipip_H113": "Մարդկանց վստահում եմ։",
      "ipip_X112": "Ինձ հարմարավետ եմ զգում մարդկանց շրջապատում:",
      "ipip_H968": "Վախենում եմ բազմաթիվ բաներից:",
      "ipip_X92": "Ուժեղ եմ ապրում իմ զգացմունքները։",
      "ipip_X87": "Միշտ պատրաստված եմ:",
      "ipip_H446": "Փնտրում եմ արկածներ:",
      "ipip_H655": "Վախենում եմ ինձ վրա ուշադրություն կենտրոնացնել։",
      "ipip_X239": "Հետաքրքրված չեմ տեսական քննարկումներով:",
      "ipip_E105": "Տեսնում եմ գեղեցկությունն այնտեղ, որտեղ այլ մարդիկ կարող են այն չնկատել:",
      "ipip_H258": "Իրականացնում եմ ծրագրերս:",
      "ipip_X251": "Կարողանում եմ տիրապետել ցանկություններս:",
      "ipip_text_leave_my_belongings_around": "Ամենուր թողնում եմ իրերս:",
      "ipip_H1333": "Գիտեմ, թե ինչպես է պետք հաջողությամբ ամեն բան իրականացնել:",
      "ipip_H1018": "Խախտում եմ խոստումներս:",
      "ipip_E166": "Փորձում եմ չմտածել կարիքավորների մասին:",
      "ipip_text_excel_in_what_i_do": "Գերազանցում այն ամենում, ինչ անում եմ:",
      "ipip_X181": "Հազվադեպ եմ դուրս գալիս հաճելի բաների ընդունելի օգտագործման սահմաններից:",
      "ipip_H79": "Ազատ ժամանակ ես շատ բան եմ անում:",
      "ipip_H334": "Վերցնում եմ կառավարման ղեկը:",
      "ipip_X23": "Ինձ հեշտ չէ հունից հանելը։",
      "ipip_H438": "Սիրում եմ ոգևորվածությունը:",
      "ipip_X203": "Անտարբեր եմ այլոց զգացմունքների հանդեպ։",
      "ipip_X107": "Հեշտությամբ եմ սթրեսի ենթարկվում:",
      "ipip_X74": "Հաճախ եմ տխրում։",
      "ipip_H754": "Հեշտությամբ եմ զայրանում:",
      "ipip_H78": "Սիրում եմ մեծ խնջույքներ։",
      "ipip_X176": "Դժվարություն եմ ունենում վերացական գաղափարները հասկանալիս:",
      "ipip_X157": "Համարում եմ, որ մենք պետք է ավելի խիստ վերաբերմունք ցուցաբերենք հանցագործությունների նկատմամբ:",
      "ipip_text_break_rules": "Խախտում եմ կանոնները:",
      "ipip_H1186": "Վատնում եմ ժամանակս:",
      "ipip_H822": "Անկարգ վիճակում եմ թողնում սենյակս:",
      "ipip_H1157": "Անհանգստանում եմ տարբեր բաների պատճառով։",
      "ipip_E46": "Առանց երկար մտածելու` խառնվում եմ ինչ-որ բանի մեջ:",
      "ipip_X218": "Հակված եմ քվեարկել լիբերալ քաղաքական թեքնածուների օգտին:",
      "ipip_H1063": "Չեմ սիրում փոփոխություններ:",
      "ipip_H959": "Հուզականորեն ծանրաբեռվում եմ իրադարձություններից։",
      "ipip_H738": "Բարձր կարծիք ունեմ սեփական անձիս մասին:",
      "ipip_H755": "Կորցնում եմ ինքնատիրապետումս:",
      "ipip_H871": "Ինձ պահում եմ խենթ ու խելահեղ կերպով։",
      "ipip_X79": "Ճնշման տակ պահմանում եմ հանգստություն։",
      "ipip_X238": "Վայելում եմ երևակայության խելահեղ թռիչքները:",
      "ipip_E156": "Չեմ հասկանում մարդկանց, ովքեր հուզվում են:",
      "ipip_text_feel_sympathy_for_those_who_are_worse_of": "Կարեկցում եմ մարդկանց, ովքեր ապրում են ավելի վատ, քան ես:",
      "ipip_H746": "Գլուխ եմ գովում իմ արժանիքների մասին։",
      "ipip_H621": "Դժվարությամբ եմ սկսում առաջադրանքի կատարումը:",
      "ipip_H761": "Հեշտությամբ եմ նյարդայնանում:",
      "ipip_H42": "Նայում եմ կյանքի լուսավոր կողմին:",
      "ipip_H149": "Պահում եմ խոստումներս:",
      "ipip_H32": "Զվարճություն եմ ճառագայթում:",
      "ipip_X115": "Կատարում եմ նվազագույնը՝ միայն թե աշխատանքն ավարտին հասցնելու համար:",
      "ipip_H54": "Միշտ ինչ-որ բան ունեմ անելու։",
      "ipip_text_love_life": "Սիրում եմ կյանքը:",
      "ipip_H699": "Վրեժ եմ լուծում ուրիշներից:",
      "ipip_X184": "Համարում եմ, որ գոյություն չունի բացարձակ ճիշտ և բացարձակ սխալ:",
      "ipip_H416": "Օգտագործում եմ մարդկանց իմ անձնական շահերի համար:",
      "ipip_H1094": "Ուրախ ժամանակ շատ եմ անցկացնում:",
      "ipip_X167": "Քիչ ժամանակ և ջանք եմ ներդնում իմ աշխատանքի մեջ:",
      "ipip_H29": "Հեշտությամբ եմ ընկերներ ձեռք բերում:",
      "ipip_H853": "Կայացնում եմ հապճեպ որոշումներ:",
      "ipip_H524": "Փորձում եմ առաջնորդել մարդկանց:",
      "ipip_X71": "Սիրում եմ երազել:",
      "ipip_H736": "Համարում եմ, որ ես մյուսներից ավելի լավն եմ:",
      "ipip_X209": "Բարդ սոցիալական իրավիճակները ինձ չեն անհանգստացնում։",
      "ipip_H999": "Ակնկալում եմ վատագույնը:",
      "ipip_H58": "Ես միշտ զբաղված եմ:",
      "ipip_H656": "Հարմարավետ եմ ինձ զգում միայն ընկերներիս հետ։",
      "ipip_H2043": "Լավ կարծիք ունեմ իմ մասին:",
      "ipip_E113": "Սիրում եմ թեթև տանել:",
      "ipip_H494": "Խոչընդոտում եմ մարդկանց ծրագրերին:"
    },
    "it": {
      "ipip_likert_2": "Moderatamente inaccurato",
      "ipip_debrief": "Grazie per aver completato questo questionario.",
      "ipip_likert_5": "Molto accurato",
      "ipip_likert_3": "Né accurato né inaccurato",
      "ipip_likert_1": "Molto inaccurato",
      "ipip_question_head": "<h3>Quanto accuratamente può descriversi?</h3><p>Si descriva com'è generalmente ora, non come vorrebbe essere in futuro. Si descriva onestamente, in relazione ad altre persone dello stesso sesso e all'incirca della stessa età. Per potersi descrivere in modo onesto, le risposte saranno mantenute in assoluta riservatezza. Indichi l'accuratezza di ciascuna affermazione nel descriverla, utilizzando la seguente scala:</p>",
      "ipip_likert_4": "Moderatamente accurato",
      "ipip_X274": "Resisto facilmente alle tentazioni",
      "ipip_text_take_control_of_things": "Prendo il controllo delle cose",
      "ipip_H918": "Non dedico tempo agli altri",
      "ipip_X133": "A volte mi abbuffo",
      "ipip_H640": "Sono spesso giù di corda",
      "ipip_H312": "Sono legato alle tradizioni",
      "ipip_H862": "Mi butto",
      "ipip_X14": "Ho una fervida immaginazione",
      "ipip_X45": "Non mi piace la poesia",
      "ipip_H704": "Tengo gli altri a distanza",
      "ipip_X211": "Mi piace leggere cose difficili",
      "ipip_H648": "Evito il contatto con gli altri",
      "ipip_H145": "Dico la verità",
      "ipip_E163": "Mi piace perdermi nei miei pensieri",
      "ipip_H427": "Approfitto degli altri",
      "ipip_H244": "Mi piace mettere in ordine",
      "ipip_X126": "Tendo a votare per la destra",
      "ipip_H976": "Aspetto che siano gli altri a guidare",
      "ipip_H549": "Creo che gli altri abbiano buone intenzioni",
      "ipip_H954": "Sento che non sono capace di affrontare le cose",
      "ipip_H453": "Amo un buon litigio",
      "ipip_H592": "Mi risulta difficile avvicinare gli altri",
      "ipip_H1195": "Non mi fido degli altri",
      "ipip_H809": "Urlo contro le persone",
      "ipip_H1100": "Mi preoccupo per gli altri",
      "ipip_H1206": "Lavoro sodo",
      "ipip_X129": "Mi sento a mio agio con me stesso",
      "ipip_X259": "Provo comprensione per i senzatetto",
      "ipip_H1354": "Gestisco le cose facilmente",
      "ipip_X248": "Evito discussioni filosofiche",
      "ipip_X227": "Non sono interessato ai problemi degli altri",
      "ipip_H650": "Evito la folla",
      "ipip_H948": "Vado facilmente nel panico",
      "ipip_text_trust_what_people_say": "Mi fido di ciò che le persone dicono",
      "ipip_H1103": "Offendo le persone",
      "ipip_X30": "Preferisco le cose che conosco bene",
      "ipip_X198": "Imbroglio per andare avanti",
      "ipip_H846": "Agisco senza pensarci",
      "ipip_X82": "A volte mi dimentico di rimettere le cose al loro posto",
      "ipip_H2014": "Faccio più di quanto ci si aspetta da me",
      "ipip_X10": "Raramente mi accorgo delle mie emozioni",
      "ipip_H587": "Preferisco stare solo",
      "ipip_E136": "Sento le emozioni degli altri",
      "ipip_X204": "Preferisco la varietà alla routine",
      "ipip_X83": "Alle feste parlo con molte persone diverse",
      "ipip_H1285": "Porto a termine i miei compiti con successo",
      "ipip_H1108": "Amo aiutare gli altri",
      "ipip_X123": "Credo nell'importanza dell'arte",
      "ipip_E35": "Mi piace essere spericolato",
      "ipip_X15": "Non mi piaccio",
      "ipip_X235": "Non mi piacciono i musei",
      "ipip_H113": "Mi fido degli altri",
      "ipip_X112": "Sono a mio agio con le altre persone",
      "ipip_H968": "Ho paura di molte cose",
      "ipip_X92": "Vivo le mie emozioni intensamente",
      "ipip_X87": "Sono sempre pronto",
      "ipip_H446": "Cerco l'avventura",
      "ipip_H655": "Ho paura di attirare l'attenzione",
      "ipip_X239": "Non mi piacciono le discussioni teoriche",
      "ipip_E105": "Vedo la bellezza dove gli altri potrebbero non vederla",
      "ipip_H258": "Porto a termine i miei piani",
      "ipip_X251": "So controllare i miei impulsi",
      "ipip_text_leave_my_belongings_around": "Lascio in giro le mie cose",
      "ipip_H1333": "So come fare le cose",
      "ipip_H1018": "Non mantengo le promesse",
      "ipip_E166": "Cerco di non pensare a chi ha più bisogno",
      "ipip_text_excel_in_what_i_do": "Sono bravo in ciò che faccio",
      "ipip_X181": "Esagero molto raramente",
