  "translations": {
    "en": {
      "r1": "not at all true",
      "r2": "barely true",
      "r3": "moderately true",
      "r4": "exactly true",
      "qh": "Please indicate how true each of the following statements is for you.",
      "LANGUAGE": "English",
      "pas_en1": "I spend time identifying long-range goals for myself.",
      "pas_en2": "I feel in charge of making things happen.",
      "pas_en3": "I feel responsible for my own life.",
      "pas_en4": "I feel driven by my personal values.",
      "pas_en5": "I am driven by a sense of purpose.",
      "pas_en6": "I am able to choose my own actions.",
      "pas_en7": "I focus my efforts on things that I can control.",
      "pas_en8": "There are abundant opportunities that await me."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "LANGUAGE": "Deutsch",
      "pas_de1": "Ich nehme mir Zeit, um über langfristige Ziele für mich selbst nachzudenken.",
      "pas_de2": "Es gibt im Leben unzählige Gelegenheiten, die man nur erkennen und ergreifen muß.",
      "pas_de3": "Mein Leben wird vor allem durch Sachzwänge bestimmt.",
      "pas_de4": "Ich gehe konstruktiv an meine Probleme heran, auch wenn sie von anderen Menschen oder äußeren Umständen erzeugt worden sind.",
      "pas_de5": "Ich fühle mich von anderen Leuten bevormundet.",
      "pas_de6": "Die Schätze der Welt warten nur darauf, daß man sie findet und ausgräbt.",
      "pas_de7": "Ich habe die Freiheit, meine Lebensentscheidungen selbst zu treffen.",
      "pas_de8": "Ich warte lieber darauf, bis die Dinge passieren, anstatt selbst die Initiative zu übernehmen."
    },
    "pt-BR": {
      "r1": "não verdadeiro",
      "r2": "pouco verdadeiro",
      "r3": "moderadamente verdadeiro",
      "r4": "totalmente verdadeiro",
      "qh": "Leia com atenção cada afirmativa e responda assinalando com um X a sua opção de resposta de acordo com a seguinte chave.",
      "LANGUAGE": "Português (Brasil)",
      "pas_pb1": "Gasto tempo identificando alvos de longo alcance para mim mesmo(a).",
      "pas_pb2": "Sinto-me pressionado(a) pelas outras pessoas.",
      "pas_pb3": "Sinto-me responsável por fazer as coisas acontecerem.",
      "pas_pb4": "Sinto-me responsável pela minha própria vida.",
      "pas_pb5": "Sinto-me impelido(a) a ser simulado (a) pelas circunstâncias.",
      "pas_pb6": "Sinto-me impelido(a) por meus valores pessoais.",
      "pas_pb7": "Meus problemas atuais são causados pelas escolhas erradas que fiz no passado.",
      "pas_pb8": "Geralmente espero que algo aconteça antes que eu tome a iniciativa por mim mesmo(a).",
      "pas_pb9": "Agrada-me saber que os outros sempre cuidam de mim.",
      "pas_pb10": "Sou impulsionado(a) ou movido(a) por um senso de propósitos.",
      "pas_pb11": "O comportamento das outras pessoas limita minha eficiência.",
      "pas_pb12": "Posso escolher minhas próprias ações.",
      "pas_pb13": "Centralizo meu esforço em coisas que posso controlar.",
      "pas_pb14": "Frequentemente sinto que estou sendo programado ao invés de me programar.",
      "pas_pb15": "Há inúmeras oportunidades me esperando."
    },
    "es": {
      "r1": "Totalmente en desacuerdo",
      "r2": "Poco de acuerdo",
      "r3": "Moderadamente de acuerdo",
      "r4": "Totalmente de acuerdo",
      "qh": "Indique en qué medida cada afirmación es cierta para usted.",
      "LANGUAGE": "Español",
      "pas_en1": "Me tomo el tiempo para identificar mis metas de largo plazo.",
      "pas_en2": "Me siento responsable de que las cosas funcionen.",
      "pas_en3": "Me siento responsable por mi propia vida.",
      "pas_en4": "Me oriento por valores personales.",
      "pas_en5": "Me oriento de acuerdo a mis metas y objetivos.",
      "pas_en6": "Soy capaz de elegir mis propias acciones.",
      "pas_en7": "Dirijo mis esfuerzos a situaciones que puedo controlar.",
      "pas_en8": "Hay tantas oportunidades por descubrir y aprovechar."
    },
    "pt": {
      "r1": "De modo nenhum é verdade",
      "r2": "Dificilmente é verdade",
      "r3": "Moderadamente verdade",
      "r4": "Exactamente verdade",
      "qh": "Leia cada afirmação e indique em que medida é verdadeira para si.",
      "LANGUAGE": "Português",
      "pas_pb1": "Eu dispendo tempo a identificar objectivos de longo prazo para mim.",
      "pas_pb2": "Eu sinto-me empurrado pelas pessoas.",
      "pas_pb3": "Eu sinto-me responsável para fazer as coisas acontecerem.",
      "pas_pb4": "Eu sinto-me responsável pela minha própria vida.",
      "pas_pb5": "Eu sinto-me impelido pelas circunstâncias que agem sobre mim.",
      "pas_pb6": "Eu sinto-me impelido pelos meus valores pessoais.",
      "pas_pb7": "Os meus actuais problemas são causados pelas escolhas erradas que eu fiz no passado.",
      "pas_pb8": "Eu geralmente espero que algo aconteça do que ser eu a tomar a iniciativa.",
      "pas_pb9": "Saber que outro cuida sempre de mim, faz-me sentir confortável.",
      "pas_pb10": "Eu sou impelido por um sentido de propósito.",
      "pas_pb11": "O comportamento dos outros indivíduos limita a minha eficiência.",
      "pas_pb12": "Eu posso escolher as minhas próprias acções.",
      "pas_pb13": "Eu centralizo os meus esforços em coisas que posso controlar.",
      "pas_pb14": "Frequentemente, sinto que estou a ser \"programado\" em vez de ser o \"programador\" de mim próprio.",
      "pas_pb15": "Há abundantes oportunidades que me esperam."
    }
  }
}