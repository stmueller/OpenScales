{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-AO",
      "name": "Authoritarian Orientation Battery (ESS)",
      "abbreviation": "ESS-AO",
      "description": "3-item measure of authoritarian political orientation from the European Social Survey Round 10 core module. Items tap acceptance of a strong leader above the law (0–10), endorsement of obedience and respect for authority as children's values (5-point), and belief that loyalty to leaders is what the country needs most (5-point). Higher scores indicate stronger authoritarian orientation.",
      "citation": "Stenner, K. (2005). The Authoritarian Dynamic. Cambridge University Press.\nAltemeyer, B. (1981). Right-Wing Authoritarianism. University of Manitoba Press.\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items B37a, B38, B39 from ESS10 GB source questionnaire. New in ESS10 core module — no prior-round data. accalaw uses 0–10 (11-point likert); imobed and loylead use 5-point Agree-Disagree. All items are pro-authoritarian direction: higher raw score = stronger authoritarianism on all three. Mixed formats make a simple composite questionable; subscale scores reported separately. Optional rescaling of imobed/loylead: multiply raw score by 2 then subtract 1 to produce a 1–9 range comparable to the 0–10 scale of accalaw — not done by default."
    },
    "dimensions": [
      {
        "id": "total",
        "name": "Authoritarian Orientation",
        "description": "Three items tapping acceptance of strong leadership above the law, obedience as a child-rearing value, and loyalty to leaders. Reported as separate item scores due to mixed response formats."
      }
    ],
