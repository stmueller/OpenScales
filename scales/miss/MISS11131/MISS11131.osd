{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "MISS11131",
      "name": "Basic Social Justice Orientations (BSJO) Scale",
      "abbreviation": "MISS11131",
      "description": "4-item scale measuring four basic social justice orientations with a single item each: equality, need, equity, and entitlement. Each item is a single-item indicator of its orientation; no total score is computed. Used in ESS Round 9 across 29 European countries.",
      "citation": "Adriaans, J., & Fourré, M. (2022). Basic Social Justice Orientations: Measuring Order-Related Justice in the European Social Survey Round 9. Measurement Instruments for the Social Sciences. https://doi.org/10.1186/s42409-022-00040-3",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "license_explanation": "Published in Measurement Instruments for the Social Sciences under CC BY 4.0.",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/11131",
      "version": "1.0",
      "domain": "Social"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "MISS article ID: 11131. DOI: 10.1186/s42409-022-00040-3. Also documented in GESIS-ZIS: https://doi.org/10.6102/zis338_exz. Each item is a SINGLE-item indicator of a distinct justice orientation (equality, need, equity, entitlement). No total score should be calculated. 5-point response scale runs from 1 'Agree completely' to 5 'Disagree completely' (descending agreement). Fielded in ESS Round 9 (2018/19) across 29 countries and CRONOS."
    },
    "likert_options": {
