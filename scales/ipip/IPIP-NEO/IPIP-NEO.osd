  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H1157": "Worry about things.",
      "ipip_H999": "Fear for the worst.",
      "ipip_H968": "Am afraid of many things.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_X120": "Get caught up in my problems.",
      "ipip_X138": "Am not easily bothered by things.",
      "ipip_E141": "Am relaxed most of the time.",
      "ipip_H1046": "Am not easily disturbed by events.",
      "ipip_E150": "Don't worry about things that have already happened.",
      "ipip_H2000": "Adapt easily to new situations.",
      "ipip_H754": "Get angry easily.",
      "ipip_H761": "Get irritated easily.",
      "ipip_X95": "Get upset easily.",
      "ipip_X84": "Am often in a bad mood.",
      "ipip_H755": "Lose my temper.",
      "ipip_X265": "Rarely get irritated.",
      "ipip_X231": "Seldom get mad.",
      "ipip_X23": "Am not easily annoyed.",
      "ipip_X191": "Keep my cool.",
      "ipip_E120": "Rarely complain.",
      "ipip_X74": "Often feel blue.",
      "ipip_X15": "Dislike myself.",
      "ipip_H640": "Am often down in the dumps.",
      "ipip_H646": "Have a low opinion of myself.",
      "ipip_E92": "Have frequent mood swings.",
      "ipip_H947": "Feel desperate.",
      "ipip_X205": "Feel that my life lacks direction.",
      "ipip_X156": "Seldom feel blue.",
      "ipip_X129": "Feel comfortable with myself.",
      "ipip_H737": "Am very pleased with myself.",
      "ipip_H991": "Am easily intimidated.",
      "ipip_H905": "Am afraid that I will do the wrong thing.",
      "ipip_H592": "Find it difficult to approach others.",
      "ipip_H655": "Am afraid to draw attention to myself.",
      "ipip_H656": "Only feel comfortable with friends.",
      "ipip_H1205": "Stumble over my words.",
      "ipip_text_am_not_embarrassed_easily": "Am not embarrassed easily.",
      "ipip_X197": "Am comfortable in unfamiliar situations.",
      "ipip_X209": "Am not bothered by difficult social situations.",
      "ipip_H1197": "Am able to stand up for myself.",
      "ipip_X145": "Often eat too much.",
      "ipip_E57": "Don't know why I do some of the things I do.",
      "ipip_text_do_things_i_later_regret": "Do things I later regret.",
      "ipip_X133": "Go on binges.",
      "ipip_H2029": "Love to eat.",
      "ipip_X181": "Rarely overindulge.",
      "ipip_X274": "Easily resist temptations.",
      "ipip_X251": "Am able to control my cravings.",
      "ipip_X216": "Never spend more than I can afford.",
      "ipip_E30": "Never splurge.",
      "ipip_H948": "Panic easily.",
      "ipip_H959": "Become overwhelmed by events.",
      "ipip_H954": "Feel that I'm unable to deal with things.",
      "ipip_H901": "Can't make up my mind.",
      "ipip_H950": "Get overwhelmed by emotions.",
      "ipip_X79": "Remain calm under pressure.",
      "ipip_H470": "Can handle complex problems.",
      "ipip_H1281": "Know how to cope.",
      "ipip_H44": "Readily overcome setbacks.",
      "ipip_E64": "Am calm even in tense situations.",
      "ipip_H29": "Make friends easily.",
      "ipip_H52": "Warm up quickly to others.",
      "ipip_X112": "Feel comfortable around people.",
      "ipip_H41": "Act comfortably with others.",
      "ipip_H1151": "Cheer people up.",
      "ipip_H596": "Am hard to get to know.",
      "ipip_H909": "Often feel uncomfortable around others.",
      "ipip_H648": "Avoid contacts with others.",
      "ipip_X165": "Am not really interested in others.",
      "ipip_H704": "Keep others at a distance.",
      "ipip_H78": "Love large parties.",
      "ipip_X83": "Talk to a lot of different people at parties.",
      "ipip_H2016": "Enjoy being part of a group.",
      "ipip_H1106": "Involve others in what I am doing.",
      "ipip_E55": "Love surprise parties.",
      "ipip_H587": "Prefer to be alone.",
      "ipip_H660": "Want to be left alone.",
      "ipip_X99": "Don't like crowded events.",
      "ipip_H650": "Avoid crowds.",
      "ipip_H602": "Seek quiet.",
      "ipip_H334": "Take charge.",
      "ipip_H524": "Try to lead others.",
