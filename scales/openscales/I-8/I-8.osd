  "translations": {
    "en": {
      "i_8_inst": "The following statements may apply more or less to you. To what extent do you think each statement applies to you personally?",
      "i_801": "Sometimes I do things impulsively that I should not do.",
      "i_802": "I sometimes do things to cheer myself up that I later regret.",
      "i_803": "I usually think carefully before I act.",
      "i_804": "I usually consider things carefully and logically before I make up my mind.",
      "i_805": "I always bring to an end what I have started.",
      "i_806": "I plan my schedule so that I get everything done on time.",
      "i_807": "I am willing to take risks.",
      "i_808": "I am happy to take chances.",
      "i_8_r1": "Does not apply at all",
      "i_8_r5": "Applies completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
