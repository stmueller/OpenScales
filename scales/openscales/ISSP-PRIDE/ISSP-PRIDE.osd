        "dimension": "cultural"
      },
      {
        "id": "issp_pride07",
        "type": "likert",
        "text_key": "issp_pride07",
        "dimension": "cultural"
      },
      {
        "id": "issp_pride08",
        "type": "likert",
        "text_key": "issp_pride08",
        "dimension": "cultural"
      },
      {
        "id": "issp_pride09",
        "type": "likert",
        "text_key": "issp_pride09",
        "dimension": "cultural"
      }
    ],
    "scoring": {
      "political": {
        "method": "mean_coded",
        "description": "Mean of the 4 political-pride items, reverse-coded so higher = more pride. Range 1-4.",
        "items": {
          "issp_pride01": -1,
          "issp_pride02": -1,
          "issp_pride03": -1,
          "issp_pride04": -1
        }
      },
      "cultural": {
        "method": "mean_coded",
        "description": "Mean of the 5 cultural-pride items, reverse-coded so higher = more pride. Range 1-4.",
        "items": {
          "issp_pride05": -1,
          "issp_pride06": -1,
          "issp_pride07": -1,
          "issp_pride08": -1,
          "issp_pride09": -1
        }
      }
    },
    "report": {
      "template": "standard",
      "include": [
        "timestamp",
        "completion_time",
        "dimension_scores"
      ],
      "header": "Cultural Pride and Political Pride (ISSP) Report",
      "footer_refs": [
        "Greer, Z., Urban, J., & Koc, P. (2025). Cultural Pride and Political Pride (ISSP). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis364",
        "ZIS Documentation: https://doi.org/10.6102/zis364"
      ]
    }
  },
  "translations": {
    "en": {
      "issp_pride_inst": "How proud are you of [COUNTRY] in each of the following? (Please check one box on each line.)",
      "issp_pride01": "the way democracy works",
      "issp_pride02": "its political influence in the world",
      "issp_pride03": "its social security system",
      "issp_pride04": "its fair treatment of groups in society",
      "issp_pride05": "its scientific and technological achievements",
      "issp_pride06": "its achievements in sports",
      "issp_pride07": "its achievements in arts and literature",
      "issp_pride08": "[COUNTRY]'s armed forces",
      "issp_pride09": "its history",
      "issp_pride_r1": "Very proud",
      "issp_pride_r2": "Somewhat proud",
      "issp_pride_r3": "Not very proud",
      "issp_pride_r4": "Not proud at all",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
