    "sw": {
      "durel_ora": "Mara ngapi huwa unaenda kanisani, msikitini, hekaluni, au katika mikutano mingine ya kidini?",
      "durel_ora_0": "Kamwe",
      "durel_ora_1": "Mara moja kwa mwaka au pungufu",
      "durel_ora_2": "Mara chache kwa mwaka",
      "durel_ora_3": "Mara chache kwa mwezi",
      "durel_ora_4": "Mara moja kwa wiki",
      "durel_ora_5": "Zaidi ya mara moja kwa wiki",
      "durel_nora": "Mara ngapi huwa unajihusisha binafsi na shughuli za kidini, kama vile kusali, kutafakari, au kusoma au kujifunza maandiko ya kidini?",
      "durel_nora_0": "Kamwe huwa sijihusishi",
      "durel_nora_1": "Mara chache kwa mwaka",
