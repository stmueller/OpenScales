    "scoring": {
      "teacher_self_efficacy": {
        "name": "Teacher Self-Efficacy",
        "method": "sum_coded",
        "description": "Sum of 10 items (range 10-40). Item 7 is a language variant: positive form (en/pt-BR, forward) or negative form (de/tr, reverse-coded).",
        "items": {
          "tse1": 1,
          "tse2": 1,
          "tse3": 1,
          "tse4": 1,
          "tse5": 1,
          "tse6": 1,
          "tse7_pos": 1,
          "tse7_neg": -1,
          "tse8": 1,
