    ],
    "scoring": {
      "ConspiracyBeliefs": {
        "method": "mean_coded",
        "description": "Mean of all 6 items. The first 3 items (COV19CON001–COV19CON003) can be used as a short-form score.",
        "items": {
          "COV19CON001": 1,
          "COV19CON002": 1,
          "COV19CON003": 1,
          "COV19CON004": 1,
          "COV19CON005": 1,
          "COV19CON006": 1
        }
      }
    }
  },
  "translations": {
    "en": {
      "COV19CON_head": "To what extent do you agree with the following statements regarding the coronavirus crisis?",
      "COV19CON_r1": "Do not agree at all",
      "COV19CON_r10": "Fully agree",
      "COV19CON001": "I believe that my government is hiding important information about the coronavirus.",
      "COV19CON002": "I believe that the pharmaceutical industry is involved in the spread of the coronavirus.",
      "COV19CON003": "I believe that the medication already exists to prevent or treat the coronavirus.",
      "COV19CON004": "I believe the coronavirus was made intentionally in a laboratory.",
      "COV19CON005": "I believe the coronavirus was made by mistake in a laboratory.",
      "COV19CON006": "I believe there is a link between 5G technology and the coronavirus."
    }
  }
}