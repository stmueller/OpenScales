  "definition": {
    "scale_info": {
      "code": "HSPS20H",
      "name": "Highly Sensitive Person Scale--Hungarian Version (HSPS-20-H)",
      "abbreviation": "HSPS-20-H",
      "description": "20-item scale measuring sensory processing sensitivity (high sensitivity), with three subscales: Stress Sensitivity, Sensory Sensitivity, and Aesthetic Sensitivity. Hungarian adaptation of the original HSPS by Aron & Aron (1997). Items rated on a 7-point scale (1 = not at all, 4 = moderately, 7 = completely).",
      "citation": "Reddington, K., Nagybányai Nagy, O., Baier, A., & Köteles, F. (2025). Highly Sensitive Person Scale--Hungarian Version [Database record]. APA PsycTests. https://dx.doi.org/10.1037/t9999-97334-000",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://dx.doi.org/10.1556/0406.2025.00089",
      "version": "1.0",
      "domain": "Personality"
    },
    "implementation": {
      "author": "Shane T. Mueller",
