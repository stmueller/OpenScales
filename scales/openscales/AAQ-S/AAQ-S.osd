  "translations": {
    "en": {
      "lk_1": "Never true",
      "lk_2": "Very seldom true",
      "lk_3": "Seldom true",
      "lk_4": "Sometimes true",
      "lk_5": "Frequently true",
      "lk_6": "Almost always true",
      "lk_7": "Always true",
      "question_head": "Below you will find a list of statements. Please rate how true each statement is for you.",
      "aaq_s_1": "My biases and prejudices affect how I interact with people from different backgrounds.",
      "aaq_s_2": "I feel that I am aware of my own biases.",
      "aaq_s_3": "My negative thoughts about others are never a problem in my life.",
      "aaq_s_4": "I need to reduce my negative thoughts about others in order to have good social interactions.",
      "aaq_s_5": "When I evaluate someone negatively, I am able to recognize that this is just a reaction, not an objective fact.",
      "aaq_s_6": "I stop doing things that are important to me when it involves someone I don't like.",
      "aaq_s_7": "I have trouble letting go of my judgments of others.",
      "aaq_s_8": "I feel that my prejudicial thoughts are a significant barrier to me being culturally sensitive.",
      "aaq_s_9": "I have trouble not acting on my negative thoughts about others.",
      "aaq_s_10": "I am aware when judgments about others are passing through my mind.",
      "aaq_s_11": "It's OK to have friends that I have negative thoughts about from time to time.",
      "aaq_s_12": "I don't struggle with controlling my evaluations about others.",
      "aaq_s_13": "When I am having negative thoughts about others, I withdraw from people.",
      "aaq_s_14": "When I'm talking with someone I don't like, I'm aware of my evaluations of them.",
      "aaq_s_15": "When I have judgments about others, they are very intense.",
      "aaq_s_16": "When talking with someone I believe I should act according to how I feel about him/her, even if it's negative.",
      "aaq_s_17": "I'm good at noticing when I have a judgment of another person.",
      "aaq_s_18": "I rarely worry about getting my evaluations towards others under control.",
      "aaq_s_19": "I accept that I will sometimes have unpleasant thoughts about other people.",
      "aaq_s_20": "I often get caught up in my evaluations of what others are doing wrong.",
      "aaq_s_21": "The bad things I think about others must be true."
    }
  }
}