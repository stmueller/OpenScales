      {"id": "bfi31", "type": "likert", "text_key": "bfi31", "dimension": "extraversion"},
      {"id": "bfi32", "type": "likert", "text_key": "bfi32", "dimension": "agreeableness"},
      {"id": "bfi33", "type": "likert", "text_key": "bfi33", "dimension": "conscientiousness", "reverse": true},
      {"id": "bfi34", "type": "likert", "text_key": "bfi34", "dimension": "neuroticism"},
      {"id": "bfi35", "type": "likert", "text_key": "bfi35", "dimension": "openness"},
      {"id": "bfi36", "type": "likert", "text_key": "bfi36", "dimension": "extraversion",     "reverse": true},
      {"id": "bfi37", "type": "likert", "text_key": "bfi37", "dimension": "agreeableness"},
      {"id": "bfi38", "type": "likert", "text_key": "bfi38", "dimension": "conscientiousness"},
      {"id": "bfi39", "type": "likert", "text_key": "bfi39", "dimension": "neuroticism"},
      {"id": "bfi40", "type": "likert", "text_key": "bfi40", "dimension": "neuroticism",      "reverse": true},
      {"id": "bfi41", "type": "likert", "text_key": "bfi41", "dimension": "openness"},
      {"id": "bfi42", "type": "likert", "text_key": "bfi42", "dimension": "agreeableness"},
      {"id": "bfi43", "type": "likert", "text_key": "bfi43", "dimension": "conscientiousness"},
      {"id": "bfi44", "type": "likert", "text_key": "bfi44", "dimension": "openness",         "reverse": true}
    ],
    "scoring": {
      "extraversion": {
        "description": "Mean of 8 items: bfi1, bfi6R, bfi11, bfi16, bfi21, bfi26, bfi31, bfi36R. Range 1–5; higher = more extraverted.",
        "method": "mean_coded",
        "items": ["bfi1", "bfi6", "bfi11", "bfi16", "bfi21", "bfi26", "bfi31", "bfi36"],
        "reverse": ["bfi6", "bfi36"]
      },
      "agreeableness": {
        "description": "Mean of 9 items: bfi2R, bfi7, bfi12, bfi17, bfi22R, bfi27, bfi32, bfi37, bfi42. Range 1–5; higher = more agreeable.",
        "method": "mean_coded",
        "items": ["bfi2", "bfi7", "bfi12", "bfi17", "bfi22", "bfi27", "bfi32", "bfi37", "bfi42"],
        "reverse": ["bfi2", "bfi22"]
      },
      "conscientiousness": {
        "description": "Mean of 9 items: bfi3, bfi8R, bfi13R, bfi18, bfi23, bfi28, bfi33R, bfi38, bfi43. Range 1–5; higher = more conscientious.",
        "method": "mean_coded",
        "items": ["bfi3", "bfi8", "bfi13", "bfi18", "bfi23", "bfi28", "bfi33", "bfi38", "bfi43"],
        "reverse": ["bfi8", "bfi13", "bfi33"]
      },
      "neuroticism": {
        "description": "Mean of 8 items: bfi4, bfi9, bfi14, bfi19, bfi24, bfi29, bfi34, bfi39; bfi12R, bfi22R, bfi40R also contribute. Range 1–5; higher = more neurotic.",
        "method": "mean_coded",
        "items": ["bfi4", "bfi9", "bfi14", "bfi19", "bfi24", "bfi29", "bfi34", "bfi39", "bfi12", "bfi22", "bfi40"],
        "reverse": ["bfi12", "bfi22", "bfi40"]
      },
      "openness": {
        "description": "Mean of 10 items: bfi5, bfi10, bfi15, bfi20R, bfi25, bfi30, bfi35, bfi40R, bfi41, bfi44R. Range 1–5; higher = more open.",
        "method": "mean_coded",
        "items": ["bfi5", "bfi10", "bfi15", "bfi20", "bfi25", "bfi30", "bfi35", "bfi41", "bfi44"],
        "reverse": ["bfi20", "bfi44"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "Big Five Inventory (BFI) Report",
      "footer_refs": [
        "John, O. P., Donahue, E. M., & Kentle, R. L. (1991). The Big Five Inventory—Versions 4a and 54. University of California, Berkeley.",
        "John, O. P., Naumann, L. P., & Soto, C. J. (2008). Paradigm shift to the integrative Big Five trait taxonomy. In O. P. John, R. W. Robins, & L. A. Pervin (Eds.), Handbook of personality: Theory and research (3rd ed., pp. 114–158). Guilford Press."
      ]
    }
  },
  "translations": {
    "en": {
      "bfi_r1": "Disagree strongly",
      "bfi_r2": "Disagree a little",
      "bfi_r3": "Neither agree nor disagree",
      "bfi_r4": "Agree a little",
      "bfi_r5": "Agree strongly",
      "bfi_qhead": "I see myself as someone who...",
      "bfi1":  "Is talkative",
      "bfi2":  "Tends to find fault with others",
      "bfi3":  "Does a thorough job",
      "bfi4":  "Is depressed, blue",
      "bfi5":  "Is original, comes up with new ideas",
      "bfi6":  "Is reserved",
      "bfi7":  "Is helpful and unselfish with others",
      "bfi8":  "Can be somewhat careless",
      "bfi9":  "Is relaxed, handles stress well",
      "bfi10": "Is curious about many different things",
      "bfi11": "Is full of energy",
      "bfi12": "Starts quarrels with others",
      "bfi13": "Is a reliable worker",
      "bfi14": "Can be tense",
      "bfi15": "Is ingenious, a deep thinker",
      "bfi16": "Generates a lot of enthusiasm",
      "bfi17": "Has a forgiving nature",
      "bfi18": "Tends to be disorganized",
      "bfi19": "Worries a lot",
      "bfi20": "Has an active imagination",
      "bfi21": "Tends to be quiet",
      "bfi22": "Is generally trusting",
      "bfi23": "Tends to be lazy",
      "bfi24": "Is emotionally stable, not easily upset",
      "bfi25": "Is inventive",
      "bfi26": "Has an assertive personality",
      "bfi27": "Can be cold and aloof",
      "bfi28": "Perseveres until the task is finished",
      "bfi29": "Can be moody",
      "bfi30": "Values artistic, aesthetic experiences",
      "bfi31": "Is sometimes shy, inhibited",
      "bfi32": "Is considerate and kind to almost everyone",
      "bfi33": "Does things efficiently",
      "bfi34": "Remains calm in tense situations",
      "bfi35": "Prefers work that is routine",
      "bfi36": "Is outgoing, sociable",
      "bfi37": "Is sometimes rude to others",
      "bfi38": "Makes plans and follows through with them",
      "bfi39": "Gets nervous easily",
      "bfi40": "Likes to reflect, play with ideas",
      "bfi41": "Has few artistic interests",
      "bfi42": "Likes to cooperate with others",
      "bfi43": "Is easily distracted",
      "bfi44": "Is sophisticated in art, music, or literature",
      "debrief": "Thank you for completing this questionnaire."
    },
    "sw": {
      "bfi_r1": "Sikubaliani kabisa",
      "bfi_r2": "Sikubaliani kidogo",
      "bfi_r3": "Wala kukubaliana wala kutokukubaliana",
      "bfi_r4": "Nakubaliana kidogo",
      "bfi_r5": "Nakubaliana kabisa",
      "bfi_qhead": "Najiona mimi ni mtu ambaye...",
      "bfi1":  "Ni mzungumzaji",
      "bfi2":  "Hupendelea kuona makosa ya wengine",
      "bfi3":  "Hufanya kazi kikamilifu",
      "bfi4":  "Mwenye moyo mzito, unyogovu",
      "bfi5":  "Mtungaji, huleta mitazamo mipya",
      "bfi6":  "Mnyamavu",
      "bfi7":  "Mwenye kufaa wengine na si mchoyo",
      "bfi8":  "Anaweza kuwa mzembe, si mwangalifu",
      "bfi9":  "Ametulia kimawazo, anayehimili misukosuko",
      "bfi10": "Ni mdadisi juu ya mambo tofauti tofauti",
      "bfi11": "Mkakamavu",
      "bfi12": "Anayeanzisha ugomvi na wengine",
      "bfi13": "Ni mfanyikazi wa kutegemeeka",
      "bfi14": "Awezae kufadhaika",
      "bfi15": "Stadi, mwenye tafakari ya ndani",
      "bfi16": "Huleta mshawasha",
      "bfi17": "Anamaumbile ya kusamehe, msamehevu",
      "bfi18": "Hukosa mpangilio wa mambo",
      "bfi19": "Mawazo yanavutika kwengine kwa urahisi",
      "bfi20": "Ana mawazo hai",
      "bfi21": "Huwa mkimya",
      "bfi22": "Anayeamini watu kwa ujumla",
      "bfi23": "Huwa mvuvi",
      "bfi24": "Mwenye kudhibiti hisia, asiye tibuka kwa urahisi",
      "bfi25": "M'bunifu",
      "bfi26": "Mwenye hulka ilothibiti, yenye kujitokeza",
      "bfi27": "Awezae kukosa uchangamfu na mpkweke",
      "bfi28": "Hustahimili katika shughuli mpaka mwisho",
      "bfi29": "Awezae kukosa furaha, kununa",
      "bfi30": "Anaethamini Sanaa, uzuri wa mambo",
      "bfi31": "Wakati mwengine huona haya, hujizuia kufanya jambo",
      "bfi32": "Anayejali na mkarimu takriban kwa kila mtu",
      "bfi33": "Hufanya mambo kiustadi",
      "bfi34": "Hubaki mtulivu wakati wa mfadhaiko",
      "bfi35": "Anayependelea kazi iliyo na utaratibu maalum",
      "bfi36": "Mwenye bashasha, mchangamfu",
      "bfi37": "Wakati mwengine mjuri kwa wengine",
      "bfi38": "Hupanga mipango na kuifatilia",
      "bfi39": "Hushikwa na wahaka kwa urahisi",
      "bfi40": "Hupendelea kuwaza na kuwazua",
      "bfi41": "Si shabiki mkubwa wa sanaa",
      "bfi42": "Anapenda kushirikiana na wengine",
      "bfi43": "Mawazo yanavutika kwengine kwa urahisi",
      "bfi44": "Aliyebobea katika Sanaa, muziki, au fasihi",
      "debrief": "Asante kwa kukamilisha dodoso hili."
    }
  }
}
