{
  "scale_info": {
    "name": "Racial/Ethnic Discrimination - Recent and Lifetime",
    "code": "PX281501",
    "abbreviation": "PX281501",
    "description": "The GED Scale is an 18-item instrument with three sub questions per item that addresses discrimination prevalence and related stress in the last year and over one’s lifetime. Each question is rated on a 6-point Likert scale.",
    "domain": "Health Technology & Spirituality",
    "citation": "Derogatis, L. R., Lipman, R. S., Rickles, K., Ulenhuth, E., and Covi, L. (1994). The Hopkins Symptom Checklist (HSCL): A self-report symptom inventory. Behavioral Science, 19(1), 1-15. https://doi.org/10.1002/bs.3830190102 Landrine, H., & Klonoff, E. A. (1996). The schedule of racist events: a measure of racial discrimination and a study of its negative physical and mental health consequences. Journal of Black Psychology, 22(2), 144-168. https://doi.org/10.1177/00957984960222002 [PhenX: https://www.phenxtoolkit.org/protocols/view/281501]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/281501"
  },
