        "dimension": "Gratitude"
      },
      {
        "id": "GQ6005",
        "type": "likert",
        "text_key": "GQ6005",
        "dimension": "Gratitude"
      },
      {
        "id": "GQ6006",
        "type": "likert",
        "text_key": "GQ6006",
        "dimension": "Gratitude"
      }
    ],
    "scoring": {
      "Gratitude": {
        "method": "sum_coded",
        "description": "Total gratitude score (range 6–42). Items 3 and 6 are reverse-scored.",
        "items": {
          "GQ6001": 1,
          "GQ6002": 1,
          "GQ6003": -1,
          "GQ6004": 1,
          "GQ6005": 1,
          "GQ6006": -1
        }
      }
    }
  },
  "translations": {
    "en": {
      "GQ6_head": "Using the scale below, indicate how much you agree with each statement.",
      "GQ6_r1": "Strongly disagree",
      "GQ6_r7": "Strongly agree",
      "GQ6001": "I have so much in life to be thankful for.",
      "GQ6002": "If I had to list everything that I felt grateful for, it would be a very long list.",
      "GQ6003": "When I look at the world, I don't see much to be grateful for.",
      "GQ6004": "I am grateful to a wide variety of people.",
      "GQ6005": "As I get older I find myself more able to appreciate the people, events, and situations that have been part of my life history.",
      "GQ6006": "Long amounts of time can go by before I feel grateful to something or someone."
    }
  }
}