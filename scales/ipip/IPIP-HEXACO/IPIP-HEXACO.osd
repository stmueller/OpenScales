      "ipip_X163": "Am exacting in my work.",
      "ipip_H1285": "Complete tasks successfully.",
      "ipip_X115": "Do just enough work to get by.",
      "ipip_P385": "Do too little work.",
      "ipip_Q197": "Get started quickly on doing a job.",
      "ipip_H627": "Hang around doing nothing.",
      "ipip_Q204": "Push myself very hard to succeed.",
