      ],
      "header": "General Life Satisfaction Short Scale (L-1) Report",
      "footer_refs": [
        "Nießen, D., Groskurth, K., Rammstedt, B., & Lechner, C. M. (2021). General Life Satisfaction Short Scale (L-1). Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS). https://doi.org/10.6102/zis284",
        "ZIS Documentation: https://doi.org/10.6102/zis284"
      ]
    }
  },
  "translations": {
    "en": {
      "l_1_inst": "The next question is about your general satisfaction with life. All things considered, how satisfied are you with your life these days?",
      "l_101": "All things considered, how satisfied are you with your life these days?",
      "l_1_r0": "Not at all satisfied",
      "l_1_r10": "Completely satisfied",
      "debrief": "Thank you for completing this questionnaire."
