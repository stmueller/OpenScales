    "scale_info": {
      "name": "IPIP Behavioral Inhibition/Activation Scales",
      "code": "IPIP-BISBAS",
      "abbreviation": "IPIP-BIS/BAS",
      "description": "IPIP representation of Carver & White's BIS/BAS scales measuring behavioral inhibition and activation systems.",
      "citation": "Carver, C. S., & White, T. L. (1994). Behavioral inhibition, behavioral activation, and affective responses to impending reward and punishment. Journal of Personality and Social Psychology, 67(2), 319-333.",
