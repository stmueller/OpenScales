{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-PVQ21",
      "name": "Portrait Values Questionnaire – 21 (ESS Human Values Scale)",
      "abbreviation": "ESS-PVQ21",
      "description": "21-item measure of Schwartz's 10 basic human values using the Portrait Values Questionnaire short form. Respondents rate how much a briefly described person (whose gender matches the respondent's) is like them. Items cover Self-Direction, Stimulation, Hedonism, Achievement, Power, Security, Conformity, Tradition, Benevolence, and Universalism. The scale has been administered as a core module in every round of the European Social Survey since Round 1 (2002). Scores are typically ipsatized (centered on the respondent's grand mean) before analysis.",
      "citation": "Sandy, C. J., Gosling, S. D., Schwartz, S. H., & Koelkebeck, T. (2017). The development and validation of brief and ultrabrief measures of values. Journal of Personality Assessment, 99(5), 545–555. https://doi.org/10.1080/00223891.2016.1231115\nBilsky, W., Janik, M., & Schwartz, S. H. (2011). The structural organization of human values — Evidence from three rounds of the European Social Survey (ESS). Journal of Cross-Cultural Psychology, 42, 759–776. https://doi.org/10.1177/0022022110362757\nSchwartz, S. H. (2003). A proposal for measuring value orientations across nations. In Questionnaire development report of the European Social Survey (pp. 259–319). European Social Survey. http://www.europeansocialsurvey.org\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC. The PVQ-21 portrait items appear as Section H in every ESS round source questionnaire. National translations are available from ESS country documentation under the same license.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Personality & Values"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items from ESS10 GB source questionnaire (Section H). Gender-tailored portraits: male wording (H1) used when respondent gender = male; female wording (H2) used when gender = female. Text keys use suffix _m (male) or _f (female). A gender selection screen precedes the items. Non-binary/other respondents: implementer should decide which wording to present or provide a gender-neutral adaptation. ESS variable names (ipcrtiv, imprich, …) used as item IDs for compatibility with ESS data. Scoring: raw subscale means (range 1–6; lower = more like me); ipsatized score = raw subscale mean minus grand mean of all 21 items. Reversed interpretation: lower raw score indicates stronger endorsement of that value."
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "gender": {
        "type": "string",
        "default": "ask",
        "options": [
          "ask",
          "m",
          "f"
        ],
        "description": "Respondent gender for portrait selection. 'ask' presents a gender question before items; 'm' forces male portraits; 'f' forces female portraits."
      }
    },
    "likert_options": {
      "points": 6,
      "min": 1,
      "labels": [
        "pvq_r1",
        "pvq_r2",
        "pvq_r3",
        "pvq_r4",
        "pvq_r5",
        "pvq_r6"
      ],
      "question_head": "pvq_head"
    },
    "dimensions": [
      {
        "id": "self_direction",
        "name": "Self-Direction",
        "description": "Independent thought and action — choosing, creating, exploring. Items: ipcrtiv (A), impfree (K)."
      },
      {
        "id": "stimulation",
        "name": "Stimulation",
        "description": "Excitement, novelty, and challenge in life. Items: impdiff (F), ipadvnt (O)."
      },
      {
        "id": "hedonism",
        "name": "Hedonism",
        "description": "Pleasure and sensuous gratification for oneself. Items: ipgdtim (J), impfun (U)."
      },
      {
        "id": "achievement",
        "name": "Achievement",
        "description": "Personal success through demonstrating competence according to social standards. Items: ipshabt (D), ipsuces (M)."
      },
      {
        "id": "power",
        "name": "Power",
        "description": "Social status, prestige, control or dominance over people and resources. Items: imprich (B), iprspot (Q)."
      },
      {
        "id": "security",
        "name": "Security",
        "description": "Safety, harmony, and stability of society, relationships, and self. Items: impsafe (E), ipstrgv (N)."
      },
      {
        "id": "conformity",
        "name": "Conformity",
        "description": "Restraint of actions, inclinations, and impulses likely to upset or harm others and violate social expectations or norms. Items: ipfrule (G), ipbhprp (P)."
      },
      {
        "id": "tradition",
        "name": "Tradition",
        "description": "Respect, commitment, and acceptance of the customs and ideas that traditional culture or religion provide. Items: ipmodst (I), imptrad (T)."
      },
      {
        "id": "benevolence",
        "name": "Benevolence",
        "description": "Preservation and enhancement of the welfare of people with whom one is in frequent personal contact. Items: iphlppl (L), iplylfr (R)."
      },
      {
        "id": "universalism",
        "name": "Universalism",
        "description": "Understanding, appreciation, tolerance, and protection for the welfare of all people and nature. Items: ipeqopt (C), ipudrst (H), impenv (S)."
      }
    ],
    "items": [
      {
