  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_H34": "Am the life of the party.",
      "ipip_X244": "Feel little concern for others.",
      "ipip_X87": "Am always prepared.",
      "ipip_X107": "Get stressed out easily.",
      "ipip_H1276": "Have a rich vocabulary.",
      "ipip_X56": "Don't talk a lot.",
      "ipip_H21": "Am interested in people.",
      "ipip_text_leave_my_belongings_around": "Leave my belongings around.",
      "ipip_E141": "Am relaxed most of the time.",
      "ipip_X176": "Have difficulty understanding abstract ideas.",
      "ipip_X112": "Feel comfortable around people.",
      "ipip_H1103": "Insult people.",
      "ipip_H1362": "Pay attention to details.",
      "ipip_H1157": "Worry about things.",
      "ipip_X14": "Have a vivid imagination.",
      "ipip_H154": "Keep in the background.",
      "ipip_H1130": "Sympathize with others' feelings.",
      "ipip_H1467": "Make a mess of things.",
      "ipip_X156": "Seldom feel blue.",
      "ipip_X228": "Am not interested in abstract ideas.",
      "ipip_H16": "Start conversations.",
      "ipip_X227": "Am not interested in other people's problems.",
      "ipip_E119": "Get chores done right away.",
      "ipip_text_am_easily_disturbed": "Am easily disturbed.",
      "ipip_H1313": "Have excellent ideas.",
      "ipip_H1039": "Have little to say.",
      "ipip_X177": "Have a soft heart.",
      "ipip_X82": "Often forget to put things back in their proper place.",
      "ipip_X95": "Get upset easily.",
      "ipip_X272": "Do not have a good imagination.",
      "ipip_X83": "Talk to a lot of different people at parties.",
      "ipip_X165": "Am not really interested in others.",
      "ipip_X118": "Like order.",
      "ipip_H926": "Change my mood a lot.",
      "ipip_X100": "Am quick to understand things.",
      "ipip_X68": "Don't like to draw attention to myself.",
      "ipip_H160": "Take time out for others.",
      "ipip_H1140": "Shirk my duties.",
      "ipip_E92": "Have frequent mood swings.",
      "ipip_H1272": "Use difficult words.",
      "ipip_X78": "Don't mind being the center of attention.",
      "ipip_E136": "Feel others' emotions.",
      "ipip_X179": "Follow a schedule.",
      "ipip_H761": "Get irritated easily.",
      "ipip_X114": "Spend time reflecting on things.",
      "ipip_H661": "Am quiet around strangers.",
      "ipip_H107": "Make people feel at ease.",
      "ipip_X163": "Am exacting in my work.",
      "ipip_X74": "Often feel blue.",
      "ipip_H53": "Am full of ideas."
    },
    "hr": {
      "ipip_question_head": "<h3>Koliko točno možete opisati sebe?</h3><p>Na sljedećim stranicama nalaze se tvrdnje koje opisuju uobičajeno ponašanje ljudi. Molimo vas da, koristeći se priloženom ljestvicom, procijenite koliko pojedini iskaz vjerno opisuje baš vas.</p>",
      "ipip_likert_3": "Ni točno ni netočno",
      "ipip_likert_1": "Posve netočno",
      "ipip_debrief": "Hvala vam na sudjelovanju.",
      "ipip_likert_4": "Uglavnom točno",
      "ipip_likert_2": "Uglavnom netočno",
      "ipip_likert_5": "Posve točno",
      "ipip_H761": "Lako se uzrujam.",
      "ipip_H154": "Držim se po strani.",
      "ipip_H1313": "Imam izvrsne ideje.",
      "ipip_X78": "Ne smeta me biti u središtu pažnje.",
      "ipip_X165": "Drugi me zapravo i ne zanimaju.",
      "ipip_H1140": "Izbjegavam obaveze.",
      "ipip_X228": "Ne zanimaju me apstraktne ideje.",
      "ipip_E136": "Osjećam tuđe emocije.",
      "ipip_text_am_easily_disturbed": "Lako me zasmetati.",
      "ipip_X177": "Imam meko srce.",
      "ipip_H926": "Često mijenjam raspoloženja.",
      "ipip_X87": "Uvijek sam pripravan.",
      "ipip_H16": "Prvi započinjem razgovore.",
      "ipip_H1103": "Vrijeđam ljude.",
      "ipip_H1130": "Suosjećam s drugima.",
      "ipip_X114": "Provodim vrijeme razmišljajući o stvarima.",
      "ipip_H661": "Šutljiv(a) sam s nepoznatima.",
      "ipip_H160": "Posvećujem vrijeme drugim ljudima.",
      "ipip_X14": "Imam živu maštu.",
      "ipip_X112": "Ugodno se osjećam među ljudima.",
      "ipip_H21": "Zanimaju me drugi ljudi.",
      "ipip_X100": "Brzo shvaćam različite stvari.",
      "ipip_E119": "Odmah obavljam svakodnevne poslove.",
      "ipip_H1272": "Koristim učene izraze.",
      "ipip_H1039": "Imam malo toga reći.",
      "ipip_H107": "Nastojim da se drugi osjećaju ugodno.",
      "ipip_X118": "Volim red.",
      "ipip_X74": "Često sam potišten.",
      "ipip_H34": "Unosim živost u svaku zabavu.",
      "ipip_X272": "Nisam maštovit.",
      "ipip_text_leave_my_belongings_around": "Ostavljam stvari uokolo.",
      "ipip_X82": "Često zaboravljam vratiti stvari na njihovo mjesto.",
      "ipip_E141": "Uglavnom sam opušten.",
      "ipip_X179": "Slijedim zacrtani plan.",
      "ipip_X163": "Posao obavljam točno i precizno.",
      "ipip_X176": "Teško razumijem apstraktne ideje.",
      "ipip_H53": "Pun(a) sam ideja.",
      "ipip_X68": "Ne volim privlačiti pažnju.",
      "ipip_X56": "Ne pričam mnogo.",
      "ipip_E92": "Često mijenjam raspoloženja.",
      "ipip_H1467": "Unosim zbrku.",
      "ipip_X95": "Lako se uznemirim.",
      "ipip_X107": "Lako se uznemirim.",
      "ipip_X156": "Rijetko sam tužan.",
      "ipip_X227": "Ne zanimaju me tuđi problemi.",
      "ipip_X244": "Ne brinem se puno za druge ljude.",
      "ipip_H1362": "Obraćam pažnju na detalje.",
      "ipip_H1276": "Imam bogat rječnik.",
      "ipip_X83": "Na zabavama razgovaram s mnogo različitih ljudi.",
      "ipip_H1157": "Zabrinut sam."
    },
    "sl": {
      "ipip_likert_3": "Niti točno niti netočno",
      "ipip_likert_5": "Zelo točno",
      "ipip_likert_4": "Dokaj točno",
      "ipip_likert_1": "Zelo netočno",
      "ipip_question_head": "<h3>Kako natančno se lahko opišete?</h3><p>Na naslednjih straneh so trditve, ki opisujejo vedenje ljudi. S pomočjo spodnje lestvice ocenite, kako natančno vsaka trditev opisuje vas. Opišite se, kakršni ste na splošno zdaj, ne kakršni bi želeli biti v prihodnosti. Vaši odgovori bodo ostali zaupni.</p>",
      "ipip_debrief": "Hvala, ker ste izpolnili ta vprašalnik.",
      "ipip_likert_2": "Dokaj netočno",
      "ipip_X82": "Pogosto pozabim pospraviti stvari na svoje mesto.",
      "ipip_H661": "V prisotnosti tujcev sem tih.",
      "ipip_H1467": "Povzročam zmešnjavo.",
      "ipip_E136": "Čutim, kaj doživljajo drugi ljudje.",
      "ipip_E141": "Večino časa sem sproščen.",
      "ipip_X272": "Nimam bujne domišljije.",
      "ipip_H16": "Rad začnem pogovor.",
      "ipip_X14": "Imam bogato domišljijo.",
      "ipip_X74": "Pogosto sem otožen.",
      "ipip_H34": "Sem gonilna sila zabav.",
      "ipip_H1130": "Sočustvujem z drugimi.",
      "ipip_X78": "Nič nimam proti, če sem v središču pozornosti.",
      "ipip_X156": "Redko sem potrt.",
      "ipip_X163": "Pri svojem delu sem natančen.",
      "ipip_H1103": "Žalim ljudi.",
      "ipip_H53": "Imam polno idej.",
      "ipip_X83": "Na zabavi se rad pogovarjam z veliko različnimi ljudmi.",
      "ipip_X227": "Ne zanimam se za probleme drugih ljudi.",
      "ipip_X87": "Vedno sem pripravljen.",
      "ipip_X165": "Nisem ravno zainteresiran za druge.",
      "ipip_H1157": "Skrbi me za različne stvari.",
      "ipip_X228": "Ne zanimam se za abstraktne ideje.",
      "ipip_H1039": "Imam malo za povedati.",
      "ipip_H926": "Pogosto spreminjam svoje razpoloženje.",
      "ipip_H160": "Vzamem si čas za druge.",
      "ipip_H1140": "Izmikam se dolžnostim.",
      "ipip_H1313": "Imam odlične ideje.",
      "ipip_X107": "Hitro postanem preobremenjen.",
      "ipip_H107": "Ob meni se ljudje počutijo sproščeni.",
      "ipip_X114": "Veliko časa porabim za razmišljanje.",
      "ipip_X68": "Nerad zbujam pozornost.",
      "ipip_H1272": "Uporabljam zahtevne besede.",
      "ipip_X112": "V družbi se prijetno počutim.",
      "ipip_text_leave_my_belongings_around": "Svoje stvari puščam naokoli.",
      "ipip_X100": "Stvari hitro dojemam.",
      "ipip_text_am_easily_disturbed": "Hitro se zmedem.",
      "ipip_X56": "Ne govorim veliko.",
      "ipip_H154": "Držim se v ozadju.",
      "ipip_H761": "Zapravljam čas.",
      "ipip_H21": "Zanimam se za druge.",
      "ipip_E92": "Moje razpoloženje pogosto niha.",
      "ipip_X176": "Težko razumem abstraktne pojme.",
      "ipip_X244": "Ne skrbi me za druge.",
      "ipip_H1362": "Pozoren sem na podrobnosti.",
      "ipip_H1276": "Imam bogat besedni zaklad.",
      "ipip_X179": "Držim se svojega urnika.",
      "ipip_X177": "Sem »mehkega srca«.",
      "ipip_X95": "Zlahka se razburim.",
      "ipip_X118": "Rad imam red.",
      "ipip_E119": "Obveznosti opravim takoj."
    },
    "ru": {
      "ipip_likert_5": "Да",
      "ipip_likert_2": "Скорее нет, чем да",
      "ipip_debrief": "Благодарим вас за заполнение этого опросника.",
      "ipip_likert_3": "Ни да, ни нет",
      "ipip_question_head": "<h3>Насколько точно вы можете описать себя?</h3><p>Следующие фразы описывают поведение людей. Пожалуйста, оцените, насколько точно каждое утверждение описывает вас. Описывайте себя так, какие вы есть сейчас, а не какими хотели бы быть. Ваши ответы останутся строго конфиденциальными.</p>",
      "ipip_likert_4": "Скорее да, чем нет",
      "ipip_likert_1": "Совсем нет",
      "ipip_X156": "Редко грустите.",
      "ipip_X177": "У вас мягкое сердце.",
      "ipip_H21": "Люди Вам интересны.",
      "ipip_X165": "На самом деле люди вам не интересны.",
      "ipip_X83": "Говорите с большим количеством различных людей на вечеринках.",
      "ipip_X227": "Вам не интересны проблемы окружающих.",
      "ipip_X118": "Любите порядок.",
      "ipip_H761": "Легко раздражитесь.",
      "ipip_H160": "Вы уделяете время другим.",
      "ipip_X56": "Не говорите много.",
      "ipip_X100": "Легко вникаете в суть вещей.",
      "ipip_X68": "Не любите привлекать к себе внимание.",
      "ipip_E92": "Подвержены частым колебаниям настроения.",
      "ipip_X244": "Вы редко беспокоитесь за других.",
      "ipip_X107": "Легко подвергаетесь стрессу.",
      "ipip_H1313": "У вас часто возникают превосходные идеи.",
      "ipip_H1272": "Используете сложные слова.",
      "ipip_H1039": "Вы немногословны.",
      "ipip_H1276": "У вас богатый словарный запас.",
      "ipip_X87": "Жизнь редко застает Вас врасплох.",
      "ipip_X176": "Вам сложо понимать абстрактные идеи.",
      "ipip_H1467": "Создаете беспорядок.",
      "ipip_X95": "Легко расстраиваетесь.",
      "ipip_X112": "Вы чувствуeте себя комфортно в кругу людей.",
      "ipip_X272": "У вас не очень хорошее воображение.",
      "ipip_H926": "Часто меняете настроение.",
      "ipip_H661": "Вы мало говорите в кругу незнакомых Вам людей.",
      "ipip_H1362": "Обращаете внимание на детали.",
      "ipip_E141": "Обычно спокойны.",
      "ipip_H154": "Держитесь на заднем плане.",
      "ipip_H1157": "Часто беспокоитесь.",
      "ipip_H16": "Вы часто начинаете разговор сами.",
      "ipip_H53": "Полны идей.",
      "ipip_H107": "С вами люди чувствуют себя непринужденно.",
      "ipip_X228": "Вы не интересуетесь абстрактными идеями.",
      "ipip_X14": "У вас богатое воображение.",
      "ipip_E136": "Чувствуете настроения/ эмоции окружающих.",
      "ipip_X114": "Останавливаетесь, чтобы обдумать происходяшее.",
      "ipip_X82": "Часто забываете положить вещи на место.",
      "ipip_H34": "Вы - душа любой вечеринки.",
      "ipip_X74": "Часто бываете грустны.",
      "ipip_X179": "Следуете распорядку/плану.",
      "ipip_X163": "Вы аккуратны в работе.",
      "ipip_X78": "Не возражаете быть центром внимания.",
      "ipip_E119": "Работаете эффективно.",
      "ipip_text_am_easily_disturbed": "Вас легко вывести из равновесия.",
      "ipip_H1103": "Вы можете оскорбить.",
      "ipip_H1140": "Уклоняетесь от обязанностей.",
      "ipip_text_leave_my_belongings_around": "Часто разбрасываете вещи.",
      "ipip_H1130": "Сочувствуете чувствам других."
