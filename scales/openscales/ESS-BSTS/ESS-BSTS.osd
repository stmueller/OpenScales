  "translations": {
    "en": {
      "ppltrst": "Generally speaking, would you say that most people can be trusted, or that you can't be too careful in dealing with people?",
      "bsts_trst_lo": "You can't be too careful",
      "bsts_trst_hi": "Most people can be trusted",
      "pplfair": "Do you think that most people would try to take advantage of you if they got the chance, or would they try to be fair?",
      "bsts_fair_lo": "Most people would try to take advantage of me",
      "bsts_fair_hi": "Most people would try to be fair",
      "pplhlp": "Would you say that most of the time people try to be helpful or that they are mostly looking out for themselves?",
      "bsts_hlp_lo": "People mostly look out for themselves",
      "bsts_hlp_hi": "People mostly try to be helpful",
      "debrief": "Thank you for completing this questionnaire.",
      "bsts_head": "Please answer the following questions using a score from 0 to 10."
    },
    "at": {
      "ppltrst": "Würden Sie ganz generell sagen, dass man den meisten Menschen vertrauen kann oder, dass man im Umgang mit anderen Menschen nicht vorsichtig genug sein kann?",
      "bsts_trst_lo": "Man kann nicht vorsichtig genug sein",
      "bsts_trst_hi": "Den meisten Menschen kann man vertrauen",
      "pplfair": "Glauben Sie, dass die meisten Menschen versuchen, Sie auszunutzen, wenn sie die Möglichkeit dazu hätten, oder würden sie sich Ihnen gegenüber fair verhalten?",
      "bsts_fair_lo": "Die meisten Menschen würden versuchen mich auszunutzen",
      "bsts_fair_hi": "Die meisten Menschen würden versuchen sich fair zu verhalten",
      "pplhlp": "Würden Sie sagen, dass die meisten Menschen im Großen und Ganzen versuchen, hilfsbereit zu sein, oder sind sie meistens nur auf den eigenen Vorteil bedacht?",
      "bsts_hlp_lo": "Die meisten Menschen sind nur auf den eigenen Vorteil bedacht",
      "bsts_hlp_hi": "Die meisten Menschen versuchen hilfsbereit zu sein",
      "debrief": "Vielen Dank für Ihre Teilnahme.",
      "bsts_head": "Bitte beantworten Sie die folgenden Fragen auf einer Skala von 0 bis 10."
    },
    "de": {
      "ppltrst": "Ganz allgemein gesprochen: Glauben Sie, dass man den meisten Menschen vertrauen kann, oder dass man im Umgang mit anderen Menschen nicht vorsichtig genug sein kann?",
      "bsts_trst_lo": "Man kann nicht vorsichtig genug sein",
      "bsts_trst_hi": "Den meisten Menschen kann man vertrauen",
      "pplfair": "Glauben Sie, dass die meisten Menschen versuchen, Sie auszunutzen, wenn sie die Gelegenheit dazu haben, oder versuchen die meisten Menschen, sich fair zu verhalten?",
      "bsts_fair_lo": "Die meisten Menschen versuchen, mich auszunutzen",
      "bsts_fair_hi": "Die meisten Menschen versuchen, sich fair zu verhalten",
      "pplhlp": "Und glauben Sie, dass die Menschen meistens versuchen, hilfsbereit zu sein, oder dass die Menschen meistens auf den eigenen Vorteil bedacht sind?",
      "bsts_hlp_lo": "Die Menschen sind meistens auf den eigenen Vorteil bedacht",
      "bsts_hlp_hi": "Die Menschen versuchen meistens, hilfsbereit zu sein",
      "debrief": "Vielen Dank für Ihre Teilnahme.",
      "bsts_head": "Bitte beantworten Sie die folgenden Fragen auf einer Skala von 0 bis 10."
    },
    "bg": {
      "ppltrst": "КАЗАНО НАЙ-ОБЩО, СМЯТАТЕ ЛИ, ЧЕ ВИНАГИ ТРЯБВА ДА ИМАТЕ «ЕДНО НА УМ», ИЛИ ЧЕ НА ПОВЕЧЕТО ХОРА МОЖЕ ДА СЕ ВЯРВА?",
      "bsts_trst_lo": "Винаги трябва да имате «едно на ум»",
      "bsts_trst_hi": "На повечето хора може да се вярва",
      "pplfair": "А БИХТЕ ЛИ КАЗАЛИ, ЧЕ ПОВЕЧЕТО ХОРА БИХА СЕ ОПИТАЛИ ДА ВИ ИЗМАМЯТ ИЛИ ДА СЕ ВЪЗПОЛЗВАТ ОТ ВАС, АКО ИМАТ ТАЗИ ВЪЗМОЖНОСТ ИЛИ ЧЕ ПОВЕЧЕТО ХОРА БИХА СЕ ОПИТАЛИ ДА СА ЧЕСТНИ С ВАС?",
      "bsts_fair_lo": "Повечето хора биха се опитали да Ви измамят или да се възползват от Вас",
      "bsts_fair_hi": "Повечето хора биха се опитали да са честни",
      "pplhlp": "БИХТЕ ЛИ КАЗАЛИ, ЧЕ ПОВЕЧЕТО ХОРА СЕ ИНТЕРЕСУВАТ НАЙ-ВЕЧЕ ОТ СЕБЕ СИ ИЛИ ПЪК СЕ ОПИТВАТ ДА БЪДАТ ПОЛЕЗНИ НА ДРУГИТЕ?",
      "bsts_hlp_lo": "Повечето хора се интересуват най-вече от себе си",
      "bsts_hlp_hi": "Повечето хора се опитват да бъдат полезни на другите",
      "debrief": "Благодарим Ви за участието.",
      "bsts_head": "Моля, отговорете на следните въпроси, като използвате скала от 0 до 10."
    },
    "cs": {
      "ppltrst": "Obecně vzato, řekl(a) byste, že se většině lidí dá důvěřovat, nebo že člověk nemůže být při jednání s lidmi nikdy dost opatrný?",
      "bsts_trst_lo": "Člověk nemůže být nikdy dost opatrný",
      "bsts_trst_hi": "Většině lidí se dá důvěřovat",
      "pplfair": "Myslíte si, že by se vás většina lidí snažila podvést, pokud by měli možnost, nebo by se snažili být poctiví?",
      "bsts_fair_lo": "Většina lidí by se mě snažila podvést",
      "bsts_fair_hi": "Většina lidí by se snažila být poctivá",
      "pplhlp": "Řekl(a) byste, že se většina lidí snaží pomáhat druhým, nebo že se většinou starají o sebe?",
      "bsts_hlp_lo": "Lidé se většinou starají o sebe",
      "bsts_hlp_hi": "Lidé se většinou snaží pomáhat",
      "debrief": "Děkujeme za vyplnění tohoto dotazníku.",
      "bsts_head": "Prosím, odpovězte na následující otázky na stupnici od 0 do 10."
    },
    "el": {
      "ppltrst": "Χρησιμοποιώντας αυτή την κάρτα, γενικά, πιστεύετε ότι μπορούμε να έχουμε εμπιστοσύνη στους περισσότερους ανθρώπους, ή ότι πρέπει να είμαστε πάντα επιφυλακτικοί στις σχέσεις μας με τους ανθρώπους;",
      "bsts_trst_lo": "Πρέπει να είμαστε πάντα επιφυλακτικοί στις σχέσεις μας με τους ανθρώπους",
      "bsts_trst_hi": "Μπορούμε να έχουμε εμπιστοσύνη στους περισσότερους ανθρώπους",
      "pplfair": "Χρησιμοποιώντας αυτή την κάρτα, πιστεύετε πως οι περισσότεροι άνθρωποι θα προσπαθούσαν να σας εκμεταλλευτούν αν είχαν την ευκαιρία, ή θα προσπαθούσαν να είναι δίκαιοι απέναντί σας;",
      "bsts_fair_lo": "Οι περισσότεροι άνθρωποι θα προσπαθούσαν να με εκμεταλλευτούν",
      "bsts_fair_hi": "Οι περισσότεροι άνθρωποι θα προσπαθούσαν να είναι δίκαιοι απέναντί μου",
      "pplhlp": "Θα λέγατε ότι τις περισσότερες φορές οι άνθρωποι προσπαθούν να βοηθάνε τον άλλον, ή ότι νοιάζονται κυρίως για τον εαυτό τους;",
      "bsts_hlp_lo": "Οι άνθρωποι τις περισσότερες φορές νοιάζονται κυρίως για τον εαυτό τους",
      "bsts_hlp_hi": "Οι άνθρωποι τις περισσότερες φορές προσπαθούν να βοηθάνε τον άλλον",
      "debrief": "Ευχαριστούμε για τη συμμετοχή σας.",
      "bsts_head": "Παρακαλώ απαντήστε στις παρακάτω ερωτήσεις χρησιμοποιώντας μια βαθμολογία από 0 έως 10."
    },
    "et": {
      "ppltrst": "Üldiselt hinnates, kas Teie arvates võib enamikku inimesi usaldada?",
      "bsts_trst_lo": "Enamikku inimesi ei saa usaldada",
      "bsts_trst_hi": "Enamikku inimesi võib usaldada",
      "pplfair": "Mida Te arvate, kas enamus inimesi püüaks Teid võimaluse korral ära kasutada või püüaksid nad käituda ausalt?",
      "bsts_fair_lo": "Enamus inimesi püüaks mind ära kasutada",
      "bsts_fair_hi": "Enamus inimesi püüaks käituda ausalt",
      "pplhlp": "Mida Te arvate, kas enamuse ajast püüavad inimesed olla teiste suhtes abivalmid või hoolivad nad ennekõike iseendast?",
      "bsts_hlp_lo": "Inimesed hoolivad ennekõike iseendast",
      "bsts_hlp_hi": "Inimesed püüavad enamasti teiste suhtes abivalmid olla",
      "debrief": "Täname teid küsimustiku täitmise eest.",
      "bsts_head": "Palun vastake järgmistele küsimustele, kasutades skaalat 0 kuni 10."
    },
    "fi": {
      "ppltrst": "Voiko mielestäsi ihmisiin luottaa, vai onko niin, ettei ihmisten suhteen voi olla liian varovainen?",
      "bsts_trst_lo": "Ei voi olla liian varovainen",
      "bsts_trst_hi": "Useimpiin ihmisiin voi luottaa",
      "pplfair": "Oletko sitä mieltä, että useimmat ihmiset tilaisuuden tullen yrittäisivät käyttää sinua hyväkseen vai luuletko, että ihmiset yrittäisivät olla reiluja?",
      "bsts_fair_lo": "Useimmat ihmiset yrittäisivät käyttää minua hyväkseen",
      "bsts_fair_hi": "Useimmat ihmiset yrittäisivät olla reiluja",
      "pplhlp": "Katsotko, että useimmiten ihmiset pyrkivät olemaan auttavaisia toisia kohtaan vai että enimmäkseen he ajattelevat vain omaa etuaan?",
      "bsts_hlp_lo": "Ihmiset ajattelevat enimmäkseen omaa etuaan",
      "bsts_hlp_hi": "Ihmiset yrittävät enimmäkseen olla auttavaisia",
      "debrief": "Kiitos osallistumisestasi.",
      "bsts_head": "Vastaa seuraaviin kysymyksiin asteikolla 0–10."
    },
    "fr": {
      "ppltrst": "D'une manière générale, sur une échelle de 0 à 10, diriez-vous que l'on peut faire confiance à la plupart des gens ou que l'on n'est jamais assez prudent quand on a affaire aux autres ?",
      "bsts_trst_lo": "On n'est jamais assez prudent",
      "bsts_trst_hi": "On peut faire confiance aux gens",
      "pplfair": "À l'aide de cette liste de réponses, diriez-vous que la plupart des gens cherchent à profiter de vous quand ils le peuvent ou qu'ils font leur possible pour se conduire correctement ?",
      "bsts_fair_lo": "La plupart des gens cherchent à profiter de moi",
      "bsts_fair_hi": "La plupart des gens font leur possible pour se conduire correctement",
      "pplhlp": "Diriez-vous que la plupart du temps les gens essaient de rendre service ou qu'ils se préoccupent surtout d'eux-mêmes ?",
      "bsts_hlp_lo": "Les gens se préoccupent surtout d'eux-mêmes",
      "bsts_hlp_hi": "Les gens essaient de rendre service",
      "debrief": "Merci d'avoir participé à ce questionnaire.",
      "bsts_head": "Veuillez répondre aux questions suivantes sur une échelle de 0 à 10."
    },
    "he": {
      "ppltrst": "באופן כללי, האם לדעתך ניתן לתת אמון ברוב האנשים, או שתמיד יש מקום לחשדנות מסוימת בקשרים עם אנשים?",
      "bsts_trst_lo": "תמיד יש מקום לחשדנות מסוימת",
      "bsts_trst_hi": "ניתן לתת אמון ברוב האנשים",
      "pplfair": "האם לדעתך רוב האנשים ינסו לנצל אותך אם יש להם ההזדמנות, או יש להם הנטייה להיות הוגנים כלפיך?",
      "bsts_fair_lo": "רוב האנשים ינסו לנצל",
      "bsts_fair_hi": "יש להם הנטייה להיות הוגנים",
      "pplhlp": "האם לדעתך, בדרך כלל, אנשים משתדלים לעזור לאחרים או שבדרך כלל הם דואגים לעצמם?",
      "bsts_hlp_lo": "אנשים בדרך כלל דואגים לעצמם",
      "bsts_hlp_hi": "אנשים בדרך כלל משתדלים לעזור לאחרים",
      "debrief": "תודה על מילוי השאלון.",
      "bsts_head": "אנא ענה על השאלות הבאות באמצעות ציון מ-0 עד 10."
    },
    "ar": {
      "ppltrst": "بشكل عام، حسب رأيك، هل يمكن الثقة بمعظم الناس، أو أن هنالك دائماً مكان لشكوك معينة في العلاقات مع الناس؟",
      "bsts_trst_lo": "هنالك دائماً مكان لشكوك معينة",
      "bsts_trst_hi": "يمكن الثقة بمعظم الناس",
      "pplfair": "هل، حسب رأيك، معظم الناس سيُحاولون استغلالك إذا كانت لديهم الفرصة لذلك، أو أنهم سيحاولون أن يكونوا منصفين تجاهك؟",
      "bsts_fair_lo": "معظم الناس سيُحاولون استغلالي",
      "bsts_fair_hi": "معظم الناس سيحاولون أن يكونوا منصفين تجاهي",
      "pplhlp": "هل، حسب رأيك، بشكل عام، يحاول الناس مساعدة الآخرين أو أنهم بشكل عام يهتمون بأنفسهم؟",
      "bsts_hlp_lo": "الناس بشكل عام يهتمون بأنفسهم",
      "bsts_hlp_hi": "الناس بشكل عام يحاولون مساعدة الآخرين",
      "debrief": "شكراً لك على إكمال هذا الاستبيان.",
      "bsts_head": "يرجى الإجابة على الأسئلة التالية باستخدام درجة من 0 إلى 10."
    },
    "hr": {
      "ppltrst": "Koristeći ovu karticu, općenito govoreći, smatrate li da se većini ljudi može vjerovati ili da nikada ne možete biti previše oprezni kada se radi o ljudima?",
      "bsts_trst_lo": "Nikada ne možeš biti previše oprezan",
      "bsts_trst_hi": "Većini ljudi može se vjerovati",
      "pplfair": "Koristeći ovu karticu, navedite mislite li da bi vas većina ljudi pokušala iskoristiti kada bi za to imali priliku, ili bi pokušali biti fer i korektni?",
      "bsts_fair_lo": "Većina ljudi pokušala bi me iskoristiti",
      "bsts_fair_hi": "Većina ljudi pokušala bi biti fer",
      "pplhlp": "Smatrate li da ljudi većinom pokušavaju pomoći drugima ili da se uglavnom brinu o sebi?",
      "bsts_hlp_lo": "Ljudi se uglavnom brinu o sebi",
      "bsts_hlp_hi": "Ljudi uglavnom pokušavaju pomoći drugima",
      "debrief": "Hvala Vam na sudjelovanju.",
      "bsts_head": "Molimo odgovorite na sljedeća pitanja koristeći ljestvicu od 0 do 10."
    },
    "hu": {
      "ppltrst": "Általánosságban Ön mit mondana? A legtöbb emberben meg lehet bízni, vagy inkább azt, hogy nem lehetünk eléggé óvatosak az emberi kapcsolatokban?",
      "bsts_trst_lo": "Nem lehetünk eléggé óvatosak",
      "bsts_trst_hi": "A legtöbb ember megbízható",
      "pplfair": "Gondolja, hogy a legtöbb ember, megpróbálná kihasználni Önt, ha alkalma nyílna rá, vagy igyekeznének tisztességesek lenni?",
      "bsts_fair_lo": "A legtöbb ember meg próbálná kihasználni",
      "bsts_fair_hi": "A legtöbb ember igyekezne tisztességes lenni",
      "pplhlp": "Ön szerint az emberek inkább csak magukkal törődnek, vagy általában segítőkészek?",
      "bsts_hlp_lo": "Az emberek inkább csak magukkal törődnek",
      "bsts_hlp_hi": "Az emberek általában segítőkészek",
      "debrief": "Köszönjük a részvételt.",
      "bsts_head": "Kérjük, válaszoljon a következő kérdésekre egy 0-tól 10-ig terjedő skálán."
    },
    "is": {
      "ppltrst": "Telur þú almennt að flestu fólki sé treystandi eða finnst þér að aldrei sé of varlega farið í samskiptum við fólk?",
      "bsts_trst_lo": "Það er aldrei of varlega farið",
      "bsts_trst_hi": "Flestu fólki er treystandi",
      "pplfair": "Telur þú að flestir myndu reyna að notfæra sér þig ef þeir gætu, eða telur þú að flestir myndu reyna að koma fram af sanngirni?",
      "bsts_fair_lo": "Flestir myndu reyna að notfæra sér mig",
      "bsts_fair_hi": "Flestir myndu reyna að koma fram af sanngirni",
      "pplhlp": "Telur þú að fólk reyni oftast að vera hjálpsamt, eða telur þú að oftast hugsi fólk aðallega um sjálft sig?",
      "bsts_hlp_lo": "Fólk hugsar aðallega um sjálft sig",
      "bsts_hlp_hi": "Fólk reynir oftast að vera hjálpsamt",
      "debrief": "Þakka þér fyrir þátttökuna.",
      "bsts_head": "Vinsamlegast svaraðu eftirfarandi spurningum með stig frá 0 til 10."
    },
    "it": {
      "ppltrst": "In generale, Lei ritiene che si possa avere fiducia nella maggior parte delle persone, o che sia meglio essere diffidenti?",
      "bsts_trst_lo": "È meglio essere diffidenti",
      "bsts_trst_hi": "Ci si può fidare della maggior parte della gente",
      "pplfair": "Pensa che la maggior parte delle persone tenterebbe di approfittare di Lei se ne avesse l'opportunità, o cercherebbe di agire correttamente?",
      "bsts_fair_lo": "La maggior parte delle persone tenterebbe di approfittarne",
      "bsts_fair_hi": "La maggior parte delle persone agirebbe correttamente",
