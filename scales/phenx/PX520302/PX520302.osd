  "translations": {
    "en": {
      "opt_1": "STRONGLY DISAGREE",
      "opt_2": "2",
      "opt_3": "3",
      "opt_4": "4",
      "opt_5": "5",
      "opt_6": "6",
      "opt_7": "STRONGLY AGREE",
      "instructions_520302": "Indicate how strongly you agree or disagree with each of the following statements by selecting a number between 1 (STRONGLY DISAGREE) and 7 (STRONGLY AGREE). The closer your selection to one end or the other indicates the strength of your agreement or disagreement If you don't agree or disagree with a statement, select the mid-point number 4. Please complete every item. We are interested in how you are thinking or feeling right now as you are filling out the questionnaire.",
      "want_cocaine_almost_taste": "I want cocaine so bad I can almost taste it.",
      "urge_for_cocaine": "I have an urge for cocaine.",
      "use_cocaine_soon_as_possible": "I am going to use cocaine as soon as possible.",
      "could_resist_using_coke": "I think that I could resist using \"coke\" now.",
      "crave_coke": "I crave \"coke\" right now.",
      "want_to_use_cocaine": "All I want to use now is cocaine.",
      "no_desire_for_cocaine": "I have no desire for cocaine right now.",
      "cocaine_make_things_perfect": "Using cocaine now would make things seem just perfect.",
      "use_cocaine_soon": "I will use cocaine as soon as I get the chance.",
      "nothing_better_than_coke_now": "Nothing would be better than using \"coke\" right now.",
      "scoring_510302": "Scoring Procedure and Interpretation\n\n\n\nEach item is scored on a scale ranging from 1 for \"Strongly Disagree\" to 7 for \"Strongly Agree.\" The scores from items 1-3, 5, 6, and 8-10 are used as the raw scores. Items 4 and 7 should be reverse-scored (raw score = 8 minus reverse-keyed item score) (Heinz et al., 2006). A total score is obtained by averaging all items (Sussner et al., 2006)."
    }
  }
