  "translations": {
    "en": {
      "r1": "strongly disagree",
      "r2": "somewhat disagree",
      "r3": "somewhat agree",
      "r4": "strongly agree",
      "qh": "Still thinking about the person you are supporting, please indicate how you behaved during the past week.",
      "LANGUAGE": "English",
      "pb1": "I kept all bad news from them.",
      "pb2": "I avoided everything that could upset them.",
      "pb3": "I showed strength in their presence.",
      "pb4": "I did not let them notice how bad and depressed I really felt.",
      "pb5": "I avoided any criticism.",
      "pb6": "I pretended to be very strong, although I did not feel that way."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Weiterhin in Bezug auf diese Person: Bitte geben Sie an, wie Sie sich in der letzten Woche verhalten haben.",
      "LANGUAGE": "Deutsch",
      "pb1": "Ich habe schlechte Nachrichten von dieser Person ferngehalten.",
      "pb2": "Ich habe alles vermieden, was diese Person aufregen könnte.",
      "pb3": "Ich habe in ihrer Gegenwart Stärke gezeigt.",
      "pb4": "Ich habe mir nicht anmerken lassen, wie verstimmt ich war.",
      "pb5": "Ich habe jegliche Kritik vermieden.",
      "pb6": "Ich habe so getan, als ob ich sehr stark wäre, obwohl ich mich ganz anders fühlte."
    },
    "es": {
      "r1": "falsa",
      "r2": "rara vez verdadero",
      "r3": "moderadamente verdadero",
      "r4": "totalmente verdadero",
      "qh": "Pensando en el paciente, indique cómo se comportó usted durante la última semana.",
      "LANGUAGE": "Español",
      "pb1": "Lo aparté de las malas noticias (al paciente).",
      "pb2": "Evité cualquier cosa que pudiera trastornarlo.",
      "pb3": "Muestro fortaleza en su presencia.",
      "pb4": "No dejo que el se de cuenta que tan mal o deprimido me siento realmente.",
      "pb5": "Evito cualquier crítica.",
      "pb6": "Fingí ser muy fuerte aunque no me sentía de esa manera."
    },
    "fr": {
      "r1": "pas du tout vrai",
      "r2": "plutôt pas vrai",
      "r3": "plutôt vrai",
      "r4": "tout à fait vrai",
      "qh": "En pensant au patient, indiquez comment vous vous êtes comporté durant la dernière semaine.",
      "LANGUAGE": "Français",
      "pb1": "Je l'ai tenu loin des mauvaises nouvelles.",
      "pb2": "J'ai évité tout ce qui pouvait l'énerver.",
      "pb3": "Je me suis montré fort en sa présence.",
      "pb4": "Je n'ai rien laissé paraître quand j'étais de mauvaise humeur ou découragé.",
      "pb5": "J'ai évité toute critique.",
      "pb6": "Je faisais en sorte de paraître très fort alors que je me sentais tout à fait autrement."
    },
    "pl": {
      "r1": "całkowicie nieprawdziwe",
      "r2": "w małym stopniu prawdziwe",
      "r3": "w umiarkowanym stopniu prawdziwe",
      "r4": "całkowicie prawdziwe",
      "qh": "Myśląc o pacjencie, proszę wskazać, jak Pan/Pani się zachowywał(a) w ostatnim tygodniu.",
      "LANGUAGE": "Polski",
      "pb1": "Ukrywałem przed nim/nią wszystkie złe wiadomości (pacjent)",
      "pb2": "Unikałem wszystkiego, co mogłoby go/ją zaniepokoić",
      "pb3": "Okazałem w jego obecności, że jestem silny",
      "pb4": "Nie dałem mu/jej poznać jak naprawdę źle się czuję i jaki jestem przygnębiony",
      "pb5": "Unikałem jakiegokolwiek krytykowania",
      "pb6": "Udawałem, że jestem bardzo silny, chociaż tak się nie czułem"
    },
    "sr": {
      "r1": "uopšte ne",
      "r2": "uglavnom ne",
      "r3": "uglavnom da",
      "r4": "da, u potpunosti",
      "qh": "U vezi sa pacijentom: molimo Vas da označite kako ste se poslednje nedelje ponašali.",
      "LANGUAGE": "Srpski",
      "pb1": "Loše vesti sam držao podalje od pacijenta.",
      "pb2": "Izbegavao sam sve što ga je moglo uznemiriti.",
      "pb3": "Pokazao sam jačinu u njegovom prisustvu.",
      "pb4": "Nisam dozvolio da se na meni primeti da sam neraspoložen.",
      "pb5": "Izbegavao sam svaku kritiku.",
      "pb6": "Pravio sam se da sam veoma jak, iako sam se osećao sasvim drugačije."
    }
  }
