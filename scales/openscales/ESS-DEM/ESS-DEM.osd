{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "ESS-DEM",
      "name": "Democracy Battery (ESS)",
      "abbreviation": "ESS-DEM",
      "description": "24-item battery assessing democratic values and evaluations from the European Social Survey rotating module (ESS6 and ESS10). Twelve normative items (D1–D12) ask how important each feature is for democracy in general (0–10); twelve paired evaluative items (D13–D24) ask how well each feature describes the respondent's own country (0–10). Six content dimensions are assessed: liberal democracy, electoral democracy, social democracy, rule of law/equality, accountability, and sovereignty. Gap scores (normative minus evaluative) indicate democratic deficit perception.",
      "citation": "Ferrín, M., & Kriesi, H. (Eds.). (2016). How Europeans view and evaluate democracy. Oxford University Press.\nVan Ham, C., & Thomassen, J. (2023). Indicators of the quality of democracy from the perspective of citizens. In P. Norris (Ed.), Critical Citizens Revisited. Cambridge University Press.\nESS ERIC (2022). ESS Round 10 Source Questionnaire. https://ess.sikt.no\nEuropean Social Survey European Research Infrastructure (ESS ERIC) (2025) ESS round 11 - 2023. Social inequalities in health, Gender in contemporary Europe. Sikt - Norwegian Agency for Shared Services in Education and Research. https://doi.org/10.21338/ess11-2023.",
      "license": "CC BY-SA 4.0",
      "license_url": "https://www.europeansocialsurvey.org/contact/disclaimer",
      "license_explanation": "ESS item texts and documentation are published under CC BY-SA 4.0 by ESS ERIC.",
      "url": "https://www.europeansocialsurvey.org/methodology/source-questionnaire",
      "version": "1.0",
      "domain": "Social & Political"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-14",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "Items D1–D24 from ESS10 GB source questionnaire (rotating module, also in ESS6). ESS variable names used as item IDs. Normative items (D1–D12): 0=Not at all important for democracy in general, 10=Extremely important for democracy in general. Evaluative items (D13–D24): 0=Does not apply at all to [country], 10=Applies completely to [country]. Paired design: each normative item has a parallel evaluative item for the same democratic feature. Gap scoring: evaluative − normative for each pair (negative gap = country falls short of ideal; positive = country exceeds expectations). Dimensional groupings follow Ferrín & Kriesi (2016): liberal (minority rights, media), electoral (choice, participation), social (poverty reduction, income equality), accountability (punishment of parties, courts), rule of law (fair elections, equal treatment), sovereignty (referendums, national decisions, will of the people). See ESS Round 10 documentation for full theoretical framework."
    },
    "dimensions": [
      {
        "id": "norm_liberal",
        "name": "Liberal Democracy (Normative)",
        "description": "Importance of minority rights and free media for democracy. Items: rghmgpr, medcrgv."
      },
      {
        "id": "norm_electoral",
        "name": "Electoral Democracy (Normative)",
        "description": "Importance of party choice and electoral accountability for democracy. Items: dfprtal, fairelc, gptpelc."
      },
      {
        "id": "norm_social",
        "name": "Social Democracy (Normative)",
        "description": "Importance of poverty protection and income redistribution for democracy. Items: gvctzpv, grdfinc."
      },
      {
        "id": "norm_populist",
        "name": "Populist Democracy (Normative)",
        "description": "Importance of direct citizen power and anti-elite features for democracy. Items: votedir, viepol, wpestop."
      },
      {
        "id": "norm_rule_of_law",
        "name": "Rule of Law (Normative)",
        "description": "Importance of equal treatment by courts for democracy. Item: cttresa."
      },
      {
        "id": "norm_sovereignty",
        "name": "National Sovereignty (Normative)",
        "description": "Importance of national decision-making over EU for democracy. Item: keydec."
      },
      {
        "id": "norm_total",
        "name": "Normative Democratic Values (Total)",
        "description": "Mean of all 12 normative items. Range 0–10; higher = stronger democratic norms overall."
      },
      {
        "id": "eval_liberal",
        "name": "Liberal Democracy (Evaluative)",
        "description": "Perceived protection of minority rights and media freedom in [country]. Items: rghmgpr_e, medcrgv_e."
      },
      {
        "id": "eval_electoral",
        "name": "Electoral Democracy (Evaluative)",
        "description": "Perceived electoral quality and accountability in [country]. Items: dfprtal_e, fairelc_e, gptpelc_e."
      },
      {
        "id": "eval_social",
        "name": "Social Democracy (Evaluative)",
        "description": "Perceived social protection and equality in [country]. Items: gvctzpv_e, grdfinc_e."
      },
      {
        "id": "eval_populist",
        "name": "Populist Democracy (Evaluative)",
        "description": "Perceived citizen power and responsiveness in [country]. Items: votedir_e, viepol_e, wpestop_e."
      },
      {
        "id": "eval_rule_of_law",
        "name": "Rule of Law (Evaluative)",
        "description": "Perceived equal court treatment in [country]. Item: cttresa_e."
      },
      {
        "id": "eval_sovereignty",
        "name": "National Sovereignty (Evaluative)",
        "description": "Perceived national decision-making autonomy in [country]. Item: keydec_e."
      },
      {
        "id": "eval_total",
        "name": "Democratic Evaluation (Total)",
        "description": "Mean of all 12 evaluative items. Range 0–10; higher = more positive overall evaluation of [country]'s democracy."
      }
    ],
