{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "AppRoVE-Social",
      "name": "AppRoVE-Social: Assertive (vs. Passive or Provoking) Responding to Others",
      "abbreviation": "AppRoVE-Social",
      "description": "15-item measure of how a person responds when other people are being difficult, across three relating styles: assertive, aggressive, and submissive/passive. Part of the AppRoVE pair (parallel Social and Voices forms). 11-point (0-10) agreement scale; subscale scores are the mean of their items.",
      "citation": "Hayward, M., Schlier, B., Strauss, C., Rammou, A., & Lincoln, T. (2026). AppRoVE. Assertive (vs. Passive or Provoking) Responding to Voice-hearing Experiences [Verfahrensdokumentation, Fragebogenversionen AppRoVE-Voices und AppRoVE-Social]. In Leibniz-Institut für Psychologie (ZPID) (Hrsg.), Open Test Archive. Trier: ZPID. https://doi.org/10.23668/psycharchives.22178",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "license_explanation": "Licensed CC BY-SA 4.0 via the ZPID Open Test Archive (Leibniz Institute for Psychology). Free to use, share, and adapt with attribution; derivatives must be shared alike. The authors request notification of use via the feedback form. Cite the documentation (https://doi.org/10.23668/psycharchives.22178).",
      "url": "https://www.testarchiv.eu/en/test/9010007",
      "version": "1.0",
      "domain": "Mental Health"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-24",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "notes": "AppRoVE other people form (Hayward et al., 2026). 11-point Likert 0-10 (disagree completely 0 - agree completely 10) with an N/A option in the original (left blank / missing here). Three subscales scored as the MEAN of their items (per the documentation, psycharchives.22179): Assertive Relating = items 4,5,7,9,12; Aggressive Relating = items 1,3,6,8,11; Submissive/Passive Relating = items 2,10,13,14,15. No reverse coding (the three styles are distinct constructs). The companion form is the other AppRoVE scale (same 15 items, different referent)."
    },
