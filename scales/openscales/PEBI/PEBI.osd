  "translations": {
    "en": {
      "PEBI_head": "Listed below are some nature-protecting behaviors. How likely will you do each of these behaviors in the near future?",
      "PEBI_r0": "0% — certainly will NOT do it",
      "PEBI_r10": "100% — certainly WILL do it",
      "PEBI001": "Looking for ways to reuse things.",
      "PEBI002": "Recycling things (e.g., papers, cans or bottles).",
      "PEBI003": "Encouraging friends or family to recycle.",
      "PEBI004": "Purchasing products in reusable containers.",
      "PEBI005": "Buying environmentally friendly products even if they may not work as well as competing products.",
      "PEBI006": "Purchasing something made of recycled materials even though it is more expensive.",
      "PEBI007": "Taking shorter showers.",
      "PEBI008": "Using energy-efficient products.",
      "PEBI009": "Turning off lights when not being used.",
      "PEBI010": "Replacing old-style incandescent light bulbs.",
      "PEBI011": "Turning off standby household appliances not being used.",
      "PEBI012": "Increasing temperature setting on air-conditioners."
    }
  }
