{
  "scale_info": {
    "name": "Visual Function",
    "code": "PX111201",
    "abbreviation": "PX111201",
    "description": "Self-reported vision-targeted health status is measured with the Vision Function Questionnaire (VFQ-25). This interviewer or self administered questionnaire consists of a base set of 25 vision-targeted questions representing 11 vision-related constructs, plus an additional single-item general health",
    "domain": "Vision & Eye Health",
    "citation": "Mangione, C. M., Lee, P. P., Pitts, J., Gutierrez, P., Berry S., & Hays, R. D. (1998). Psychometric properties of the National Eye Institute Visual Function Questionnaire, the NEI-VFQ. Archives of Ophthalmology , 116: 1496-1504. [PhenX: https://www.phenxtoolkit.org/protocols/view/111201]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/111201"
  },
