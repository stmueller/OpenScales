    ],
    "scoring": {
      "Gratitude": {
        "method": "sum_coded",
        "description": "Total gratitude score (range 6–42). Items 3 and 6 are reverse-scored.",
        "items": {
          "GQ6001": 1,
          "GQ6002": 1,
          "GQ6003": -1,
          "GQ6004": 1,
          "GQ6005": 1,
          "GQ6006": -1
        }
      }
    }
  },
  "translations": {
    "de": {
      "GQ6_head": "Bitte geben Sie an, inwieweit Sie den folgenden Aussagen zustimmen.",
      "GQ6_r1": "Stimme überhaupt nicht zu",
      "GQ6_r7": "Stimme vollständig zu",
      "GQ6001": "Es gibt so viel in meinem Leben, für das ich dankbar bin.",
      "GQ6002": "Wenn ich alles auflisten müsste, für das ich dankbar bin, wäre dies eine sehr lange Liste.",
      "GQ6003": "Wenn ich die Welt betrachte, dann sehe ich nicht viel, für das ich dankbar bin.",
      "GQ6004": "Ich bin einer Vielzahl an Menschen dankbar.",
      "GQ6005": "Je älter ich werde, desto mehr bin ich in der Lage, für die Menschen, die Ereignisse und die Situationen, die ein Teil meiner Lebensgeschichte gewesen sind, dankbar zu sein.",
      "GQ6006": "Eine lange Zeit kann verstreichen, bis ich für etwas oder jemandem dankbar bin."
    }
  }
}