      {"id": "MAIA019", "type": "likert", "text_key": "MAIA019", "dimension": "emotional_awareness"},
      {"id": "MAIA020", "type": "likert", "text_key": "MAIA020", "dimension": "emotional_awareness"},
      {"id": "MAIA021", "type": "likert", "text_key": "MAIA021", "dimension": "emotional_awareness"},
      {"id": "MAIA022", "type": "likert", "text_key": "MAIA022", "dimension": "emotional_awareness"},
      {"id": "MAIA023", "type": "likert", "text_key": "MAIA023", "dimension": "self_regulation"},
      {"id": "MAIA024", "type": "likert", "text_key": "MAIA024", "dimension": "self_regulation"},
      {"id": "MAIA025", "type": "likert", "text_key": "MAIA025", "dimension": "self_regulation"},
      {"id": "MAIA026", "type": "likert", "text_key": "MAIA026", "dimension": "self_regulation"},
      {"id": "MAIA027", "type": "likert", "text_key": "MAIA027", "dimension": "body_listening"},
      {"id": "MAIA028", "type": "likert", "text_key": "MAIA028", "dimension": "body_listening"},
      {"id": "MAIA029", "type": "likert", "text_key": "MAIA029", "dimension": "body_listening"},
      {"id": "MAIA030", "type": "likert", "text_key": "MAIA030", "dimension": "trusting"},
      {"id": "MAIA031", "type": "likert", "text_key": "MAIA031", "dimension": "trusting"},
      {"id": "MAIA032", "type": "likert", "text_key": "MAIA032", "dimension": "trusting"}
    ],
    "scoring": {
      "noticing": {
        "method": "mean_coded",
        "description": "Mean of items 1-4; higher scores indicate greater body sensation awareness",
        "items": {
          "MAIA001": 1, "MAIA002": 1, "MAIA003": 1, "MAIA004": 1
        }
      },
      "not_distracting": {
        "method": "mean_coded",
        "description": "Mean of items 5-7, all reverse-scored; higher scores indicate less tendency to distract from discomfort",
        "items": {
          "MAIA005": -1, "MAIA006": -1, "MAIA007": -1
        }
      },
      "not_worrying": {
        "method": "mean_coded",
        "description": "Mean of items 8-10; items 8 and 9 reverse-scored; higher scores indicate less worry about body sensations",
        "items": {
          "MAIA008": -1, "MAIA009": -1, "MAIA010": 1
        }
      },
      "attention_regulation": {
        "method": "mean_coded",
        "description": "Mean of items 11-17; higher scores indicate greater ability to sustain and control attention to body sensations",
        "items": {
          "MAIA011": 1, "MAIA012": 1, "MAIA013": 1, "MAIA014": 1,
          "MAIA015": 1, "MAIA016": 1, "MAIA017": 1
        }
      },
      "emotional_awareness": {
        "method": "mean_coded",
        "description": "Mean of items 18-22; higher scores indicate greater awareness of body-emotion connection",
        "items": {
          "MAIA018": 1, "MAIA019": 1, "MAIA020": 1, "MAIA021": 1, "MAIA022": 1
        }
      },
      "self_regulation": {
        "method": "mean_coded",
        "description": "Mean of items 23-26; higher scores indicate greater ability to regulate distress through body awareness",
        "items": {
          "MAIA023": 1, "MAIA024": 1, "MAIA025": 1, "MAIA026": 1
        }
      },
      "body_listening": {
        "method": "mean_coded",
        "description": "Mean of items 27-29; higher scores indicate more active listening to body for insight",
        "items": {
          "MAIA027": 1, "MAIA028": 1, "MAIA029": 1
        }
      },
      "trusting": {
        "method": "mean_coded",
        "description": "Mean of items 30-32; higher scores indicate greater experience of body as safe and trustworthy",
        "items": {
          "MAIA030": 1, "MAIA031": 1, "MAIA032": 1
        }
      }
    }
  },
  "translations": {
    "en": {
      "MAIA_head": "Below you will find a list of statements. Please indicate how often each statement applies to you generally in daily life.",
      "MAIA_r0": "Never",
      "MAIA_r1": "1",
      "MAIA_r2": "2",
      "MAIA_r3": "3",
      "MAIA_r4": "4",
      "MAIA_r5": "Always",
      "MAIA001": "When I am tense I notice where the tension is located in my body.",
      "MAIA002": "I notice when I am uncomfortable in my body.",
      "MAIA003": "I notice where in my body I am comfortable.",
      "MAIA004": "I notice changes in my breathing, such as whether it slows down or speeds up.",
      "MAIA005": "I do not notice (I ignore) physical tension or discomfort until they become more severe.",
      "MAIA006": "I distract myself from sensations of discomfort.",
      "MAIA007": "When I feel pain or discomfort, I try to power through it.",
      "MAIA008": "When I feel physical pain, I become upset.",
      "MAIA009": "I start to worry that something is wrong if I feel any discomfort.",
      "MAIA010": "I can notice an unpleasant body sensation without worrying about it.",
      "MAIA011": "I can pay attention to my breath without being distracted by things happening around me.",
      "MAIA012": "I can maintain awareness of my inner bodily sensations even when there is a lot going on around me.",
      "MAIA013": "When I am in conversation with someone, I can pay attention to my posture.",
      "MAIA014": "I can return awareness to my body if I am distracted.",
      "MAIA015": "I can refocus my attention from thinking to sensing my body.",
      "MAIA016": "I can maintain awareness of my whole body even when a part of me is in pain or discomfort.",
      "MAIA017": "I am able to consciously focus on my body as a whole.",
      "MAIA018": "I notice how my body changes when I am angry.",
      "MAIA019": "When something is wrong in my life I can feel it in my body.",
      "MAIA020": "I notice that my body feels different after a peaceful experience.",
      "MAIA021": "I notice that my breathing becomes free and easy when I feel comfortable.",
      "MAIA022": "I notice how my body changes when I feel happy / joyful.",
      "MAIA023": "When I feel overwhelmed I can find a calm place inside.",
      "MAIA024": "When I bring awareness to my body I feel a sense of calm.",
      "MAIA025": "I can use my breath to reduce tension.",
      "MAIA026": "When I am caught up in thoughts, I can calm my mind by focusing on my body/breathing.",
      "MAIA027": "I listen for information from my body about my emotional state.",
      "MAIA028": "When I am upset, I take time to explore how my body feels.",
      "MAIA029": "I listen to my body to inform me about what to do.",
      "MAIA030": "I am at home in my body.",
      "MAIA031": "I feel my body is a safe place.",
      "MAIA032": "I trust my body sensations."
    }
  }
}
