{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "BMCQ",
      "name": "Body-Mind Connection Questionnaire",
      "abbreviation": "BMCQ",
      "description": "13-item scale measuring three aspects of mind-body connection: values for physical and mental wellbeing, ability to articulate sensations and emotions, and interoceptive attention.",
      "citation": "Van Bael, K., Ball, M., Scarfo, J., & Suleyman, E. (2023). Assessment of the mind-body connection: Preliminary psychometric evidence for a new self-report questionnaire. BMC Psychology, 11(1). https://doi.org/10.1186/s40359-023-01302-3",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1186/s40359-023-01302-3",
      "version": "1.0",
      "domain": "Health"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "BMCQ_r1",
        null,
        null,
        null,
        null,
        null,
        "BMCQ_r7"
      ],
      "question_head": "BMCQ_head"
    },
    "dimensions": [
      {
        "id": "BMV",
        "name": "Body-Mind Values",
        "description": "Valuing and attending to physical and mental wellbeing"
      },
      {
        "id": "SEA",
        "name": "Sensation-Emotion Articulation",
        "description": "Ability to identify and describe bodily sensations linked to emotions"
      },
      {
        "id": "IA",
        "name": "Interoceptive Attention",
        "description": "Capacity to direct focused attention toward bodily sensations"
      }
    ],
    "items": [
