{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Berlin Social Support Scales – Actually Received Support",
      "code": "BSS-RS",
      "abbreviation": "BSS-RS",
      "description": "Actually received support, recipient perspective (Schwarzer & Schulz). 14 items (items 4,5,6 reverse) + 1 separate satisfaction item; 4-point agreement; mean.",
      "citation": "Schwarzer, R., & Schulz, U. (2000). Berlin Social Support Scales (BSSS). http://www.coping.de ; Schulz, U., & Schwarzer, R. (2003). Die Berliner Social Support Skalen (BSSS). Diagnostica, 49, 73-82.",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales. English items from userpage.fu-berlin.de/~health/soc_e.htm; German items from the FU-Berlin skalen documentation.",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~health/bsss.htm",
      "domain": "Social",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "RECIPIENT perspective (e.g., a patient reporting support received from their closest person). EN/DE verbatim. Reverse: rs4,5,6. rs15 is a standalone satisfaction item, not part of the received-support score. Part of the Berlin Social Support Scales family. Added official Spanish (soc_s.htm, Varela/Galain/Schwarzer/Schulz 2004), French (soc_f.htm, Schwarzer/Schulz/Katsap 2000), and Polish (soc_pol.htm) translations. NOTE: French source page had NO response anchors — the 4-point French anchors here are implementer-supplied (true-style, matching es/pl), VERIFY. es/fr/pl are the OFFICIAL versions and are gendered (and, for some subscales, assume a female respondent / male patient), unlike the gender-neutral en/de — VERIFY. Added Serbian (Latin; soc … Language_Selection/Serbian; Schwarzer/Schulz/Stula 2003) — official, gendered (masculine self-report)."
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "max": 4,
      "labels": [
        "r1",
        "r2",
        "r3",
        "r4"
      ],
      "question_head": "qh"
    },
