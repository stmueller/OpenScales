    "pl": {
      "pvq_gender_q": "Czy jest Pan/Pani mężczyzną czy kobietą?",
      "pvq_gender_m": "Mężczyzna",
      "pvq_gender_f": "Kobieta",
      "pvq_head": "Na ile ta osoba jest podobna do Ciebie?",
      "pvq_r1": "Bardzo podobna do mnie",
      "pvq_r2": "Podobna do mnie",
      "pvq_r3": "Trochę podobna do mnie",
      "pvq_r4": "Trochę niepodobna do mnie",
      "pvq_r5": "Niepodobna do mnie",
      "pvq_r6": "Zupełnie niepodobna do mnie",
      "debrief": "DZIĘKUJEMY ZA POŚWIĘCONY CZAS NA UDZIELENIE ODPOWIEDZI NA TE PYTANIA.",
      "pvq_inst": "Teraz krótko opiszę kilka osób. Proszę wysłuchać każdego opisu i powiedzieć mi, jak bardzo każda osoba jest podobna do Ciebie lub niepodobna. Proszę skorzystać z tej karty."
    },
    "pt": {
      "pvq_inst": "Vou descrever-lhe pessoas com diferentes características e vou pedir-lhe que me diga em que medida cada uma dessas pessoas é ou não parecida consigo. Para isso utilize por favor o seguinte cartão:",
      "pvq_r1": "Exactamente como eu",
      "pvq_r2": "Muito parecido comigo",
      "pvq_r3": "Parecido comigo",
      "pvq_r4": "Um bocadinho parecido comigo",
      "pvq_r5": "Nada parecido comigo",
      "pvq_r6": "Nada a ver comigo",
      "ipcrtiv_m": "ideias e ser criativo. Gosta",
      "imprich_m": "importante ser rico. Quer ter muito dinheiro e coisas caras. Um homem que acha importante que todas as pessoas no mundo sejam",
      "ipeqopt_m": "tratadas igualmente.",
      "ipshabt_m": "mostrar as suas capacidades. Quer que as pessoas admirem o que faz. Um homem que dá importância a viver num",
      "impsafe_m": "sítio onde se sinta seguro.",
      "impdiff_m": "procura de coisas novas para fazer. Acha que é importante fazer muitas coisas diferentes na vida. Um homem que acha que as pessoas devem fazer o que lhes mandam. Acha",
      "ipfrule_m": "que as pessoas devem",
      "ipudrst_m": "quando discorda de",
      "ipmodst_m": "modesto. Tenta não",
      "ipgdtim_m": "importante passar bons momentos. Gosta de tratar bem de si. Um homem para quem é importante tomar as suas",
      "impfree_m": "próprias decisões sobre o que faz. Gosta de ser livre e não estar dependente dos outros Um homem para quem é importante ajudar os que o",
      "iphlppl_m": "rodeiam. Preocupa-se",
      "ipsuces_m": "Gosta de receber o",
      "ipstrgv_m": "contra todas as ameaças.",
      "ipadvnt_m": "aventura e gosta de correr riscos. Quer ter uma vida emocionante Um homem para quem é importante portar-se",
      "ipbhprp_m": "sempre como deve ser. Evita fazer coisas que os outros digam que é errado. Um homem para quem é importante que os outros",
      "iprspot_m": "lhe tenham respeito. Quer",
      "iplylfr_m": "com os amigos. Dedica-se",
      "impenv_m": "pessoas devem proteger a",
      "imptrad_m": "Faz tudo o que pode para",
      "impfun_m": "oportunidades para se",
      "ipcrtiv_f": "novas ideias e ser criativa. Gosta de fazer as coisas à sua maneira. Uma mulher para quem é importante",
      "imprich_f": "ser rica. Quer ter",
      "ipeqopt_f": "igualmente. Acredita",
      "ipshabt_f": "poder mostrar as suas capacidades. Quer que as pessoas admirem o que faz. Uma mulher que dá importância a viver num sítio onde se",
      "impsafe_f": "sinta segura. Evita",
      "impdiff_f": "novas para fazer.",
      "ipfrule_f": "que as pessoas",
      "ipudrst_f": "Mesmo quando",
      "ipmodst_f": "ser humilde e modesta. Tenta não chamar a atenção sobre si. Uma mulher para quem é importante",
      "ipgdtim_f": "passar bons",
      "impfree_f": "próprias decisões sobre o que faz. Gosta de ser livre e não estar dependente dos outros Uma mulher para quem é importante",
      "iphlppl_f": "ajudar os que a rodeiam. Preocupa-se com o bem-estar dos outros. Uma mulher para quem é importante ter",
      "ipsuces_f": "sucesso. Gosta de receber o reconhecimento dos outros. Uma mulher para quem é importante",
      "ipstrgv_f": "que o Governo",
      "ipadvnt_f": "gosta de correr riscos.",
      "ipbhprp_f": "como deve ser. Evita",
      "iprspot_f": "que os outros lhe tenham respeito. Quer que as pessoas façam o que ela diz. Uma mulher para quem é importante",
      "iplylfr_f": "ser leal para com os amigos. Dedica-se às pessoas que lhe são próximas. Uma mulher que acredita seriamente que as pessoas",
      "impenv_f": "devem proteger a",
      "imptrad_f": "que pode para agir de",
      "impfun_f": "oportunidades para se",
      "pvq_gender_q": "É homem ou mulher?",
      "pvq_gender_m": "Homem",
      "pvq_gender_f": "Mulher",
      "pvq_head": "Em que medida esta pessoa é parecida consigo?",
      "debrief": "Agradecemos muito a sua disponibilidade para participar."
    },
    "ru": {
      "pvq_inst": "H1 КАРТОЧКА 85 Ниже приведены краткие описания некоторых людей. Пожалуйста прослушайте каждое описание и попробуйте оценить, насколько описание каждого из этих людей похоже на Вас. Для ответа пожалуйста используйте карточку 85.",
      "pvq_r1": "Очень похоже на меня",
      "pvq_r2": "Похоже на меня",
      "pvq_r3": "Немного похоже на меня",
      "pvq_r4": "Только чуть-чуть похоже на меня",
      "pvq_r5": "Не похоже на меня",
      "pvq_r6": "Совсем не похоже на меня",
      "ipcrtiv_m": "Для него важно выдумывать новые идеи и быть творческим человеком. Ему нравится делать все по-своему.",
      "imprich_m": "Для него важно быть богатым. Он хочет чтобы у него было много денег и дорогих вещей.",
      "ipeqopt_m": "Он считает, что очень важно чтобы с каждым человеком в мире обращались одинаково. Он верит, что у всех должны быть равные возможности в жизни.",
      "ipshabt_m": "Для него очень важно показать свои способности. Он хочет, чтобы люди восхищались тем, что он делает.",
      "impsafe_m": "Для него важно жить в безопасном окружении. Он избегает всего, что может угрожать его безопасности.",
      "impdiff_m": "Ему нравятся сюрпризы и он всегда ищет какую-нибудь новую деятельность. Он считает, что важно попробовать много разного в жизни.",
      "ipfrule_m": "Он верит, что люди должны подчиняться указаниям. Он считает что люди должны всегда следовать правилам, даже когда никто за этим не следит.",
      "ipudrst_m": "Он считает важным выслушивать мнение людей, которые отличаются от него. Даже когда он с ними не согласен, он все же хочет понять их точку зрения.",
      "ipmodst_m": "Для него важно быть простым и скромным. Он старается не привлекать к себе внимание.",
      "ipgdtim_m": "Для него важно хорошо проводить время. Ему нравится позволять себе что-нибудь особенное.",
      "impfree_m": "Для него важно самому решать, что он предпримет. Ему нравится быть свободным и не зависеть от других.",
      "iphlppl_m": "Для него очень важно помогать окружающим людям. Он хочет заботиться об их благополучии.",
      "ipsuces_m": "Для него очень важно быть успешным. Он надеется, что люди оценят его достижения.",
      "ipstrgv_m": "Для него важно, чтобы правительство обеспечивало его безопасность. Он хочет, чтобы государство было сильным, и могло защитить своих граждан.",
      "ipadvnt_m": "Он ищет приключений и ему нравится рисковать. Ему хочется, чтобы его жизнь была захватывающей.",
      "ipbhprp_m": "Для него важно всегда вести себя правильно. Он старается не совершать поступки, которые другие люди могли бы осудить.",
      "iprspot_m": "Для него важно быть уважаемым человеком. Он хочет, чтобы люди слушались его и делали так, как он им скажет.",
      "iplylfr_m": "Для него очень важна верность своим друзьям. Он хотел бы посвятить себя близким людям.",
      "impenv_m": "Он твердо верит, что люди должны беречь природу. Заботиться о природе очень важно для него.",
      "imptrad_m": "Он очень ценит традиции. Он старается следовать религиозным и семейным обычаям, передаваемым из поколения в поколение.",
      "impfun_m": "Он ищет любую возможность, чтобы повеселиться. Для него важно заниматься теми вещами, от которых он получает удовольствие.",
      "ipcrtiv_f": "Для неё важно выдумывать новые идеи и быть творческим человеком. Ей нравится делать все по-своему.",
      "imprich_f": "Для неё важно быть богатой. Она хочет чтобы у неё было много денег и дорогих вещей.",
      "ipeqopt_f": "Она считает, что очень важно чтобы с каждым человеком в мире обращались одинаково. Она верит, что у всех должны быть равные возможности в жизни.",
      "ipshabt_f": "Для неё очень важно показать свои способности. Она хочет, чтобы люди восхищались тем, что она делает.",
      "impsafe_f": "Для неё важно жить в безопасном окружении. Она избегает всего, что может угрожать её безопасности.",
      "impdiff_f": "Ей нравятся сюрпризы и она всегда ищет какую-нибудь новую деятельность. Она считает, что важно попробовать много разного в жизни.",
      "ipfrule_f": "Она верит, что люди должны подчиняться указаниям. Она считает что люди должны всегда следовать правилам, даже когда никто за этим не следит.",
      "ipudrst_f": "Она считает важным выслушивать мнение людей, которые отличаются от неё. Даже когда она с ними не согласна, она все же хочет понять их точку зрения.",
      "ipmodst_f": "Для неё важно быть простой и скромной. Она старается не привлекать к себе внимание.",
      "ipgdtim_f": "Для неё важно хорошо проводить время. Ей нравится позволять себе что-нибудь особенное.",
      "impfree_f": "Для неё важно самой решать что она предпримет. Ей нравится быть свободной и не зависеть от других.",
      "iphlppl_f": "Для неё очень важно помогать окружающим людям. Она хочет заботиться об их благополучии.",
      "ipsuces_f": "Для неё очень важно быть успешной. Она надеется, что люди оценят её достижения.",
      "ipstrgv_f": "Для неё важно, чтобы правительство обеспечивало её безопасность. Она хочет, чтобы государство было сильным, и могло защитить своих граждан.",
      "ipadvnt_f": "Она ищет приключений и ей нравится рисковать. Ей хочется, чтобы её жизнь была захватывающей.",
      "ipbhprp_f": "Для неё важно всегда вести себя правильно. Она старается не совершать поступки, которые другие люди могли бы осудить.",
      "iprspot_f": "Для неё важно быть уважаемым человеком. Она хочет, чтобы люди слушались ее и делали так, как она им скажет.",
      "iplylfr_f": "Для неё очень важна верность своим друзьям. Она хотела бы посвятить себя близким людям.",
      "impenv_f": "Она твердо верит, что люди должны беречь природу. Заботиться о природе очень важно для неё.",
      "imptrad_f": "Она очень ценит традиции. Она старается следовать религиозным и семейным обычаям, передаваемым из поколения в поколение.",
      "impfun_f": "Она ищет любую возможность, чтобы повеселиться. Для неё важно заниматься теми вещами, от которых она получает удовольствие.",
      "pvq_gender_q": "Вы мужчина или женщина?",
      "pvq_gender_m": "Мужчина",
      "pvq_gender_f": "Женщина",
      "pvq_head": "Насколько этот человек похож на Вас?",
      "debrief": "КОМАНДА ЕВРОПЕЙСКОГО СОЦИАЛЬНОГО ИССЛЕДОВАНИЯ БЛАГОДАРИТ ВАС!!!"
    },
    "sk": {
      "ipcrtiv_m": "Je preňho dôležité vymýšľať nové veci a byť tvorivý. Rád robí veci vlastným originálnym spôsobom.",
      "imprich_m": "Je preňho dôležité byť bohatý. Chce mať veľa peňazí a drahé veci",
      "ipeqopt_m": "Myslí si, že je dôležité, aby sa s každým človekom na svete zaobchádzalo rovnoprávne. Verí, že každý by mal mať v živote rovnaké príležitosti.",
      "ipshabt_m": "Je preňho dôležité ukázať čo vie. Chce, aby ľudia obdivovali čo robí.",
      "impsafe_m": "Je preňho dôležité žiť v bezpečnom prostredí. Vyhýba sa všetkému, čo by mohlo ohroziť jeho bezpečnosť.",
      "impdiff_m": "Má rád prekvapenia a stále vyhľadáva nové veci, čo by robil. Myslí si, že v živote je dôležité robiť veľa rozličných vecí.",
      "ipfrule_m": "Verí, že ľudia by mali počúvnuť, čo sa im prikáže. Myslí si, že ľudia by mali stále dodržiavať pravidlá, aj vtedy keď na nich nikto nedozerá.",
      "ipudrst_m": "Je preňho dôležité načúvať ľuďom, ktorí sú iní ako on. Aj vtedy, keď s nimi nesúhlasí, im aj tak chce porozumieť.",
      "ipmodst_m": "Je preňho dôležité byť jednoduchý a skromný. Snaží sa nepriťahovať na seba pozornosť.",
      "ipgdtim_m": "Je preňho dôležité užívať si. Rád sa rozmaznáva.",
      "impfree_m": "Je preňho dôležité rozhodovať sám o tom, čo robí. Chce byť slobodný a nezávislý od ostatných.",
      "iphlppl_m": "Je preňho veľmi dôležité pomáhať ľuďom okolo neho. Chce sa starať o ich blaho.",
      "ipsuces_m": "Je preňho dôležité byť veľmi úspešný. Dúfa, že ľudia vyjadria uznanie nad tým, čo dosiahol.",
      "ipstrgv_m": "Je preňho dôležité, aby vláda zabezpečila jeho bezpečnosť pred všetkými ohrozeniami. Chce, aby bol štát silný, tak, aby mohol ochrániť svojich občanov.",
      "ipadvnt_m": "Vyhľadáva dobrodružstvo a rád riskuje. Chce mať vzrušujúci život.",
      "ipbhprp_m": "Je preňho dôležité stále sa správať riadne. Vyhýba sa urobiť niečo, o čom by ľudia mohli povedať, že je nesprávne.",
      "iprspot_m": "Je preňho dôležité získať si rešpekt iných. Chce, aby ľudia robili to, čo povie.",
      "iplylfr_m": "Je preňho dôležité byť oddaný svojim priateľom. Chce sa obetovať pre ľudí, ktorí sú mu blízki.",
      "impenv_m": "Silno verí v to, že by sa ľudia mali starať o prírodu. Starať sa o životné prostredie je preňho dôležité.",
      "imptrad_m": "Tradície sú preňho dôležité. Snaží sa dodržiavať zvyky, ktoré mu odkazuje jeho náboženstvo alebo rodina.",
      "impfun_m": "Vyhľadáva každú príležitosť, aby sa zabavil. Je preňho dôležité robiť veci, ktoré mu spôsobujú potešenie.",
      "pvq_inst": "OPÝTAJTE SA, AK RESPONDENT JE MUŽ (AK F2 = 1)",
      "ipcrtiv_f": "Je pre ňu dôležité vymýšľať nové veci a byť tvorivá. Rada robí veci vlastným originálnym spôsobom.",
      "imprich_f": "Je pre ňu dôležité byť bohatá. Chce mať veľa peňazí a drahé veci.",
      "ipeqopt_f": "Myslí si, že je dôležité, aby sa s každým človekom na svete zaobchádzalo rovnoprávne. Verí, že každý by mal mať v živote rovnaké príležitosti.",
      "ipshabt_f": "Je pre ňu dôležité ukázať čo vie. Chce, aby ľudia obdivovali čo robí.",
      "impsafe_f": "Je pre ňu dôležité žiť v bezpečnom prostredí. Vyhýba sa všetkému, čo by mohlo ohroziť jej bezpečnosť.",
      "impdiff_f": "Má rada prekvapenia a stále vyhľadáva nové veci, čo by robila. Myslí si, že v živote je dôležité robiť veľa rozličných vecí.",
      "ipfrule_f": "Verí, že ľudia by mali počúvnuť, čo sa im prikáže. Myslí si, že ľudia by mali stále dodržiavať pravidlá, aj vtedy keď na nich nikto nedozerá.",
      "ipudrst_f": "Je pre ňu dôležité načúvať ľuďom, ktorí sú iní ako ona. Aj vtedy, keď s nimi nesúhlasí, im aj tak chce porozumieť.",
      "ipmodst_f": "Je pre ňu dôležité byť jednoduchá a skromná. Snaží sa nepriťahovať na seba pozornosť.",
      "ipgdtim_f": "Je pre ňu dôležité užívať si. Rada sa rozmaznáva.",
      "impfree_f": "Je pre ňu dôležité rozhodovať sama o tom, čo robí. Chce byť slobodná a nezávislá od ostatných.",
      "iphlppl_f": "Je pre ňu veľmi dôležité pomáhať ľuďom okolo nej. Chce sa starať o ich blaho.",
      "ipsuces_f": "Je pre ňu dôležité byť veľmi úspešná. Dúfa, že ľudia vyjadria uznanie nad tým, čo dosiahla.",
      "ipstrgv_f": "Je pre ňu dôležité, aby vláda zabezpečila jej bezpečnosť pred všetkými ohrozeniami. Chce, aby bol štát silný, tak, aby mohol ochrániť svojich občanov.",
      "ipadvnt_f": "Vyhľadáva dobrodružstvo a rada riskuje. Chce mať vzrušujúci život.",
      "ipbhprp_f": "Je pre ňu dôležité stále sa správať riadne. Vyhýba sa urobiť niečo, o čom by ľudia mohli povedať, že je nesprávne.",
      "iprspot_f": "Je pre ňu dôležité získať si rešpekt iných. Chce, aby ľudia robili to, čo povie.",
      "iplylfr_f": "Je pre ňu dôležité byť oddaná svojim priateľom. Chce sa obetovať pre ľudí, ktorí sú jej blízki.",
      "impenv_f": "Silno verí v to, že by sa ľudia mali starať o prírodu. Starať sa o životné prostredie je pre ňu dôležité.",
      "imptrad_f": "Tradície sú pre ňu dôležité. Snaží sa dodržiavať zvyky, ktoré jej odkazuje jej náboženstvo alebo rodina.",
      "impfun_f": "Vyhľadáva každú príležitosť, aby sa zabavila. Je pre ňu dôležité robiť veci, ktoré jej spôsobujú potešenie.",
      "pvq_r1": "Veľmi sa mi podobá",
      "pvq_r2": "Podobá sa mi",
      "pvq_r3": "Do istej miery sa mi podobá",
      "pvq_r4": "Málo sa mi podobá",
      "pvq_r5": "Nepodobá sa mi",
      "pvq_r6": "Vôbec sa mi nepodobá",
      "pvq_gender_q": "Ste muž alebo žena?",
      "pvq_gender_m": "Muž",
      "pvq_gender_f": "Žena",
      "pvq_head": "Nakoľko sa Vám táto osoba podobá?",
      "debrief": "ĎAKUJEME VÁM, ŽE STE SI NAŠLI ČAS NA ZODPOVEDANIE TÝCHTO OTÁZOK."
    },
    "sl": {
      "pvq_gender_q": "Ste moški ali ženska?",
      "pvq_gender_m": "Moški",
      "pvq_gender_f": "Ženska",
      "pvq_head": "Koliko vam je ta oseba podobna?",
      "pvq_r1": "zelo podoben/podobna mi je",
      "pvq_r2": "podoben/podobna mi je",
      "pvq_r3": "malo podoben/podobna mi je",
      "pvq_r4": "čisto malo podoben/podobna mi je",
      "pvq_r5": "ni mi podoben/podobna",
      "pvq_r6": "sploh mi ni podoben/podobna",
      "ipcrtiv_m": "Zanj(o) je pomembno, da ima veliko novih zamisli in da je ustvarjalen(a). Stvari rad(a) počne na izviren način.",
      "ipcrtiv_f": "Zanj(o) je pomembno, da ima veliko novih zamisli in da je ustvarjalen(a). Stvari rad(a) počne na izviren način.",
      "imprich_m": "Zanj(o) je pomembno, da je premožen(a). Imeti želi veliko denarja in dragih predmetov.",
      "imprich_f": "Zanj(o) je pomembno, da je premožen(a). Imeti želi veliko denarja in dragih predmetov.",
      "ipeqopt_m": "Zanj(o) je pomembno, da se vsakega na tem svetu obravnava enako. Verjame, da mora imeti vsakdo v življenju enake možnosti.",
      "ipeqopt_f": "Zanj(o) je pomembno, da se vsakega na tem svetu obravnava enako. Verjame, da mora imeti vsakdo v življenju enake možnosti.",
      "ipshabt_m": "Zanj(o) je pomembno, da pokaže svoje sposobnosti. Rad(a) vidi, da ljudje občudujejo to, kar počne.",
      "ipshabt_f": "Zanj(o) je pomembno, da pokaže svoje sposobnosti. Rad(a) vidi, da ljudje občudujejo to, kar počne.",
      "impsafe_m": "Zanj(o) je pomembno, da živi v varnem okolju. Izogiba se vsemu, kar bi njegovo / njeno varnost lahko ogrozilo.",
      "impsafe_f": "Zanj(o) je pomembno, da živi v varnem okolju. Izogiba se vsemu, kar bi njegovo / njeno varnost lahko ogrozilo.",
      "impdiff_m": "Rad(a) ima presenečenja in skuša vedno početi kaj novega. Zdi se mu/ji pomembno, da v življenju počne čim več različnih stvari.",
      "impdiff_f": "Rad(a) ima presenečenja in skuša vedno početi kaj novega. Zdi se mu/ji pomembno, da v življenju počne čim več različnih stvari.",
      "ipfrule_m": "Verjame, da bi morali ljudje narediti to, kar jim ukažejo. Meni, da bi morali ljudje spoštovati pravila ves čas, tudi takrat, ko jih nihče ne opazuje.",
      "ipfrule_f": "Verjame, da bi morali ljudje narediti to, kar jim ukažejo. Meni, da bi morali ljudje spoštovati pravila ves čas, tudi takrat, ko jih nihče ne opazuje.",
      "ipudrst_m": "Zanj(o) je pomembno, da posluša ljudi, ki so drugačni od njega/nje. Tudi če se z njimi ne strinja, jih še vedno poskuša razumeti.",
      "ipudrst_f": "Zanj(o) je pomembno, da posluša ljudi, ki so drugačni od njega/nje. Tudi če se z njimi ne strinja, jih še vedno poskuša razumeti.",
      "ipmodst_m": "Zanj(o) je pomembno biti spoštljiv in skromen. Ne želi vzbujati pozornosti.",
      "ipmodst_f": "Zanj(o) je pomembno biti spoštljiv in skromen. Ne želi vzbujati pozornosti.",
      "ipgdtim_m": "Zanj(o) je pomembno, da se ima dobro. Rad(a) se razvaja.",
      "ipgdtim_f": "Zanj(o) je pomembno, da se ima dobro. Rad(a) se razvaja.",
      "impfree_m": "Zanj(o) je pomembno, da sam(a) odloča o tem, kaj počne. Rad(a) je svoboden(a) in neodvisen(a) od drugih.",
      "impfree_f": "Zanj(o) je pomembno, da sam(a) odloča o tem, kaj počne. Rad(a) je svoboden(a) in neodvisen(a) od drugih.",
      "iphlppl_m": "Zanj(o) je zelo pomembno, da pomaga ljudem okrog sebe. Hoče poskrbeti za njihovo blagostanje.",
      "iphlppl_f": "Zanj(o) je zelo pomembno, da pomaga ljudem okrog sebe. Hoče poskrbeti za njihovo blagostanje.",
      "ipsuces_m": "Zanj(o) je pomembno, da je zelo uspešen(a). Upa, da bodo drugi cenili njegove/ njene dosežke.",
      "ipsuces_f": "Zanj(o) je pomembno, da je zelo uspešen(a). Upa, da bodo drugi cenili njegove/ njene dosežke.",
      "ipstrgv_m": "Zanj(o) je pomembno, da mu/ ji država zagotavlja varnost pred grožnjami. Želi si močno državo, ki bo lahko zaščitila svoje državljane.",
      "ipstrgv_f": "Zanj(o) je pomembno, da mu/ ji država zagotavlja varnost pred grožnjami. Želi si močno državo, ki bo lahko zaščitila svoje državljane.",
      "ipadvnt_m": "Išče pustolovščine in rad(a) tvega. Imeti želi vznemirljivo življenje.",
      "ipadvnt_f": "Išče pustolovščine in rad(a) tvega. Imeti želi vznemirljivo življenje.",
      "ipbhprp_m": "Zanj(o) je pomembno, da se vedno spodobno obnaša. Ne želi narediti česa takega, kar bi drugi označili kot neprimerno.",
      "ipbhprp_f": "Zanj(o) je pomembno, da se vedno spodobno obnaša. Ne želi narediti česa takega, kar bi drugi označili kot neprimerno.",
      "iprspot_m": "Zanj(o) je pomembno, da si pridobi spoštovanje drugih. Rad(a) vidi, da ljudje storijo to, kar reče.",
      "iprspot_f": "Zanj(o) je pomembno, da si pridobi spoštovanje drugih. Rad(a) vidi, da ljudje storijo to, kar reče.",
      "iplylfr_m": "Zanj(o) je pomembno, da je vdan(a) svojim prijateljem. Rad(a) se razdaja bližnjim.",
      "iplylfr_f": "Zanj(o) je pomembno, da je vdan(a) svojim prijateljem. Rad(a) se razdaja bližnjim.",
      "impenv_m": "Močno je prepričan(a), da bi morali ljudje skrbeti za naravo. Skrb za okolje ima zanj(o) velik pomen.",
      "impenv_f": "Močno je prepričan(a), da bi morali ljudje skrbeti za naravo. Skrb za okolje ima zanj(o) velik pomen.",
      "imptrad_m": "Tradicija je zanj(o) pomembna. Skuša se ravnati po ustaljenih običajih svoje družine in vere.",
      "imptrad_f": "Tradicija je zanj(o) pomembna. Skuša se ravnati po ustaljenih običajih svoje družine in vere.",
      "impfun_m": "Išče priložnosti, da bi se zabaval(a). Zanj(o) je pomembno, da počne stvari, v katerih uživa.",
      "impfun_f": "Išče priložnosti, da bi se zabaval(a). Zanj(o) je pomembno, da počne stvari, v katerih uživa.",
      "pvq_inst": "Na kratko vam bomo opisali različne ljudi. Pomislite na vsakega izmed opisov in s pomočjo kartice povejte, koliko je oseba podobna vam.",
      "debrief": "ANKETAR/KA: Še enkrat se zahvalite anketirancu in zaključite intervju."
    },
    "sq": {
      "ipcrtiv_m": "Të menduarit e ideve të reja dhe kreativiteti janë të rëndësishme për të. Atij i pëlqen të bëj gjërat në mënyrën e vet origjinale.",
      "imprich_m": "Është e rëndësishme për të që të jetë i pasur Ai do që të ketë shumë para dhe gjëra të shtrenjta.",
      "ipeqopt_m": "Ai mendon se është e rëndësishme që secili person në botë të trajtohet në mënyrë të barabartë. Ai beson se çdokush duhet të ketë mundësi të barabarta në jetë.",
      "ipshabt_m": "Është e rëndësishme për të që të tregojë aftësitë e tij. Ai do që njerëzit ta admirojnë për atë që bën.",
      "impsafe_m": "Është e rëndësishme për të që të jetojë në mjedis të sigurt. Ai i shmanget çdo gjëje që mund të rrezikojë sigurinë e tij.",
      "impdiff_m": "Atij i pëlqejnë surprizat dhe gjithmonë kërkon të bëjë gjëra të reja. Ai mendon se është e rëndësishme që të bëjë gjëra të ndryshme në jetë.",
      "ipfrule_m": "Ai beson se njerëzit duhet të bëjnë atë që u thuhet. Ai mendon se njerëzit duhet të ndjekin rregullat gjatë gjithë kohës, edhe atëherë kur nuk po i shikon askush.",
      "ipudrst_m": "Është e rëndësishme për të që të dëgjojë njerëzit të cilët janë të ndryshëm nga ai. Edhe kur ai nuk pajtohet me ta, ai përsëri dëshiron t’i kuptoj ata.",
      "ipmodst_m": "Është e rëndësishme për të që të jetë i thjeshtë dhe modest. Ai mundohet që të mos tërheqë shumë vëmendje.",
      "ipgdtim_m": "Është e rëndësishme për të që të kalojë mirë. I pëlqen të “lazdrojë” veten.",
      "impfree_m": "Është e rëndësishme për të që të marrrë vet vendimet për atë që bën. Ai ka dëshirë të jetë i lirë dhe të mos varet nga të tjerët.",
      "iphlppl_m": "Është shumë e rëndësishme për të që të ndihmojë njerëzit rreth tij. Ai dëshiron të kujdeset për mirëqenien e tyre.",
      "ipsuces_m": "Të jetë shumë i suksesshëm është e rëndësishme për të. Ai shpreson që njerëzit do ti njohin arritjet e tij.",
      "ipstrgv_m": "Është e rëndësishme për të që shteti të garantojë sigurinë e tij ndaj të gjitha kërcënimeve. Ai do që shteti të jetë i fortë dhe të mbrojë qytetarët e tij.",
      "ipadvnt_m": "Ai kërkon aventura dhe ka dëshirë të rrezikoje. Ai dëshiron të ketë një jetë emocionuese.",
      "ipbhprp_m": "Është e rëndësishme për të që gjithmonë të sillet siç duhet. Ai dëshiron të shmang çdo sjellje të cilën njerëzit do ta konsideronin si të gabuar.",
      "iprspot_m": "Është e rëndësishme për të që të respektohet nga të tjerët. Ai do që njerëzit të bëjnë atë çka thotë ai.",
      "iplylfr_m": "Është e rëndësishme për të që të jetë besnik ndaj miqve të tij. Ai do që të përkushtohet ndaj njerëzve të tij afërt.",
      "impenv_m": "Ai është thellësisht i bindur që njerëzit duhet të kujdesen për natyrën. Përkujdesja ndaj mjedisit është e rëndësishme për të.",
      "imptrad_m": "Tradita është e rëndësishme për të. Ai përpiqet t’i ndjek zakonet që i ka lënë familja e tij apo besimi i tij fetar.",
      "impfun_m": "Ai kërkon çdo mundësi për argëtim. Është e rëndësishme për të që të bëjë gjëra që i sjellin kënaqësi.",
      "pvq_inst": "PYET NËSE I ANKETUARI ËSHTË MASHKULL (NËSE F2 = 1)",
      "ipcrtiv_f": "Të menduarit e ideve të reja dhe të qenurit kreativ është shumë e rëndësishme për të. Asaj i pëlqen të bëj gjërat në mënyrën e vet origjinale.",
      "imprich_f": "Është e rëndësishme për të që të jetë e pasur. Ajo do që të ketë shumë para dhe gjëra të shtrenjta.",
      "ipeqopt_f": "Ajo mendon se është e rëndësishme që secili person në botë të trajtohet në mënyrë të barabartë. Ajo beson se çdokush duhet të ketë mundësi të barabartë në jetë.",
      "ipshabt_f": "Është e rëndësishme për të që të tregojë aftësitë e saj. Ajo do që njerëzit të admirojnë atë që bën ajo.",
      "impsafe_f": "Është e rëndësishme për të që të jetojë në mjedis të sigurt. Ajo i shmanget çdo gjëje që mund të rrezikojë sigurinë e saj.",
      "impdiff_f": "Asaj i pëlqejnë surprizat dhe gjithmonë kërkon të bëjë gjëra të reja. Ajo mendon se është e rëndësishme që të bëjë gjëra të ndryshme në jetë.",
      "ipfrule_f": "Ajo beson se njerëzit duhet të bëjnë atë që u thuhet. Ajo mendon se njerëzit duhet të ndjekin rregullat gjatë gjithë kohës, edhe atëherë kur nuk po i shikon askush.",
      "ipudrst_f": "Është e rëndësishme për të që të dëgjojë njerëzit të cilët janë të ndryshëm nga ajo. Edhe kur ajo nuk pajtohet me ta, ajo përsëri dëshiron t’i kuptojë ata.",
      "ipmodst_f": "Është e rëndësishme për të që të jetë i thjeshtë dhe modest. Ajo mundohet që të mos tërheqë shumë vëmendje.",
      "ipgdtim_f": "Është e rëndësishme për të që të kalojë mirë I pëlqen të \"lazdrojë” veten.",
      "impfree_f": "Është e rëndësishme për të që të marrë vendimet vet për atë që bën. Ajo ka dëshirë të jetë e lirë dhe të mos varet nga të tjerët.",
      "iphlppl_f": "Është shumë e rëndësishme për të që të ndihmojë njerëzit rreth saj. Ajo dëshiron të kujdeset për mirëqenien e tyre.",
      "ipsuces_f": "Të jetë shumë e suksesshme është e rëndësishme për të. Ajo shpreson që njerëzit do ti njohin arritjet e saj.",
      "ipstrgv_f": "Është e rëndësishme për të që shteti të garantojë sigurinë e saj ndaj të gjitha kërcënimeve. Ajo dëshiron që shteti të jetë i fortë që të mund të mbrojë qytetarët e tij.",
      "ipadvnt_f": "Ajo kërkon aventura dhe ka dëshirë të rrezikojë. Ajo dëshiron të ketë një jetë emocionuese.",
      "ipbhprp_f": "Është e rëndësishme për të që gjithmonë të sillet siç duhet. Ajo mundohet të shmang çdo sjellje të cilën njerëzit do ta konsideronin si të gabuar.",
      "iprspot_f": "Është e rëndësishme për të që të respektohet nga të tjerët. Ajo do që njerëzit të bëjnë atë çka thotë ajo.",
      "iplylfr_f": "Është e rëndësishme për të që të jetë besnike ndaj miqve të saj. Ajo do që t'u përkushtohet njerëzve të afërt.",
      "impenv_f": "Ajo është thellësisht e bindur që njerëzit duhet të kujdesen për natyrën. Kujdesi për mjedisin është i rëndësishëm për të.",
      "imptrad_f": "Tradita është e rëndësishme për të. Ajo përpiqet t’i ndjek zakonet që i ka lënë familja apo besimi i saj fetar.",
      "impfun_f": "Ajo kërkon çdo mundësi për argëtim. Është e rëndësishme për të që të bëjë gjëra që i sjellin kënaqësi.",
      "pvq_r1": "Shumë si unë",
      "pvq_r2": "Si unë",
      "pvq_r3": "Deri diku si unë",
      "pvq_r4": "Pak si unë",
      "pvq_r5": "Jo si unë",
      "pvq_r6": "Aspak si unë",
      "pvq_gender_q": "Jeni mashkull apo femër?",
      "pvq_gender_m": "Mashkull",
      "pvq_gender_f": "Femër",
      "pvq_head": "Sa ngjason kjo person me ju?",
      "debrief": "JU FALËNDEROJMË QË NDATË KOHË PËR T'U PËRGJIGJUR KËTYRE PYETJEVE."
    },
    "sr": {
      "pvq_gender_q": "Da li ste muškarac ili žena?",
      "pvq_gender_m": "Muškarac",
      "pvq_gender_f": "Žena",
      "pvq_head": "Koliko je svaka od ovih osoba slična Vama?",
      "pvq_r1": "Veoma nalik meni",
      "pvq_r2": "Nalik meni",
      "pvq_r3": "Donekle nalik meni",
      "pvq_r4": "Malo nalik meni",
      "pvq_r5": "Nije nalik meni",
      "pvq_r6": "Uopšte nije nalik meni",
      "debrief": "HVALA VAM NA VREMENU KOJE STE ODVOJILI ZA ODGOVARANJE NA OVA PITANJA.",
      "pvq_inst": "Sada ću vam ukratko opisati neke ljude. Molim vas da saslušate svaki opis i kažete mi koliko vam je svaka osoba slična ili nije slična. Koristite ovu karticu."
    },
    "sv": {
      "pvq_gender_q": "Är du man eller kvinna?",
      "pvq_gender_m": "Man",
      "pvq_gender_f": "Kvinna",
      "pvq_head": "Hur lik dig är den här personen?",
      "pvq_r1": "Mycket lik mig",
      "pvq_r2": "Lik mig",
      "pvq_r3": "Något lik mig",
      "pvq_r4": "Lite lik mig",
      "pvq_r5": "Inte lik mig",
      "pvq_r6": "Inte alls lik mig",
      "debrief": "TACK FÖR ATT DU TOG DIG TID ATT SVARA PÅ DESSA FRÅGOR.",
      "pvq_inst": "Jag kommer nu att kort beskriva några personer. Lyssna på varje beskrivning och berätta för mig hur lik eller olik dig varje person är. Använd det här kortet."
    }
  }
