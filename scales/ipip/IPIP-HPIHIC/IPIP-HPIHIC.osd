    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_H755": "Često gubim živce.",
      "ipip_X106": "Više volim da idem u bioskop nego da gledam filmove kod kuće.",
      "ipip_H7": "Često se šalim.",
      "ipip_H1356": "Imam oko za detalje.",
      "ipip_H250": "Radim stvari \"po PS-u\".",
      "ipip_H1172": "Često izražavam sumnju.",
      "ipip_H1309": "Razumem kako stvari funkcionišu.",
      "ipip_H991": "Lako me je zastrašiti.",
      "ipip_X80": "Verujem da su ljudi u suštini zli.",
      "ipip_H1269": "Sklon sam da isprobavam nove stvari.",
      "ipip_E15": "Lako me je nagovoriti na luckaste stvari.",
      "ipip_H761": "Lako se iznerviram.",
      "ipip_H1214": "Tražim objašnjenja stvari.",
      "ipip_H26": "Činim da se drugi osećaju dobro.",
      "ipip_H617": "Osećam se uskraćeno u životu.",
      "ipip_X138": "Ne potresam se lako zbog stvari.",
      "ipip_H515": "Rado prihvatam izazovne zadatke.",
      "ipip_E157": "Verujem u ono što drugi kažu.",
      "ipip_H834": "Ne obraćam pažnju na svoj izgled.",
      "ipip_E90": "Volim strateške igre.",
      "ipip_H643": "Osećam se slomljeno zbog raznih neuspeha.",
      "ipip_H870": "Često radim nešto ludo.",
      "ipip_E36": "Ne volim novu hranu.",
      "ipip_H86": "Često zbijam šale.",
      "ipip_H446": "Tragam za pustolovinama.",
      "ipip_H2027": "Volim da čitam.",
      "ipip_E55": "Volim žurke iznenađenja.",
      "ipip_X145": "Često jedem previše.",
      "ipip_H535": "Često dovodim sebe u centar pažnje.",
      "ipip_H893": "Radim neočekivane stvari.",
      "ipip_H1259": "Dosta sam čitao.",
      "ipip_H954": "Imam osećaj da nisam u stanju da se nosim sa stvarima.",
      "ipip_H843": "Lako me je omesti.",
      "ipip_H352": "Siguran sam u sebe.",
      "ipip_X240": "Više cenim saradnju nego nadmetanje.",
      "ipip_X211": "Volim da čitam zahtevna štiva.",
      "ipip_X129": "Osećam se prijatno kad provodim vreme sam.",
      "ipip_H1124": "Nekad pričam loše o drugima.",
      "ipip_H650": "Izbegavam gužvu.",
      "ipip_X253": "Duboko me potresaju tuđe nesreće.",
      "ipip_H1246": "Dobar sam u mnogim stvarima.",
      "ipip_H691": "Radim stvari koje drugima deluju čudno.",
      "ipip_H2023": "Volim da uveseljavam druge.",
      "ipip_H910": "Ne volim promene.",
      "ipip_X212": "Ne volim pričati o sebi.",
      "ipip_H37": "U dobrim sam odnosima skoro sa svima.",
      "ipip_X120": "Lako se \"zapetljam\" u probleme.",
      "ipip_H1366": "Vešt sam u socijalnim situacijama.",
      "ipip_H1093": "Zabavljam svoje prijatelje.",
      "ipip_H557": "Kada sam zahvalan, to i pokažem.",
      "ipip_E150": "Ne brinem o onome što se već dogodilo.",
      "ipip_X231": "Retko se naljutim.",
      "ipip_H173": "Umem da utešim druge.",
      "ipip_H1195": "Ne verujem ljudima.",
      "ipip_H1120": "Često hrabrim druge.",
      "ipip_H2020": "Uglavnom osećam da imam sreće.",
      "ipip_X105": "Nisam siguran u kom pravcu ide moj život.",
