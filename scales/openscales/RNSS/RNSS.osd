{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "RNSS",
      "name": "Relational Needs Satisfaction Scale",
      "abbreviation": "RNSS",
      "description": "20-item scale measuring satisfaction of eight core relational needs based on Erskine's relational needs framework: security, validation, acceptance by a stable other, shared experience, self-definition, having an impact, having the other initiate, and expressing love.",
      "citation": "Žvelc, G., Jovanoska, K., & Žvelc, M. (2020). Development and validation of the Relational Needs Satisfaction Scale. Frontiers in Psychology, 11, 901. https://doi.org/10.3389/fpsyg.2020.00901\n\nIraurgi, I., Gómez-Marroquín, I., Erskine, R., Mauriz, A., Martínez-Rodríguez, S., Gorbeña, S., & Žvelc, G. (2022). Adaptation to Spanish of the \"Relational Needs Satisfaction Scale\": Translation and psychometric testing. Frontiers in Psychology, 13. https://doi.org/10.3389/fpsyg.2022.992205\n\nPourová, M., Řiháček, T., & Žvelc, G. (2020). Validation of the Czech version of the Relational Needs Satisfaction Scale. Frontiers in Psychology, 11, 359. https://doi.org/10.3389/fpsyg.2020.00359",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2020.00901\nhttps://doi.org/10.3389/fpsyg.2022.992205",
      "version": "1.0",
      "domain": "Relationships"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "RNSS_r1", "RNSS_r2", "RNSS_r3", "RNSS_r4", "RNSS_r5"
      ],
      "question_head": "RNSS_head"
    },
    "dimensions": [
      {
        "id": "RNSS",
        "name": "Relational Needs Satisfaction",
        "description": "Overall satisfaction of core relational needs in relationships with others"
      }
    ],
    "items": [
      { "id": "RNSS001", "type": "likert", "text_key": "RNSS001", "dimension": "RNSS" },
      { "id": "RNSS002", "type": "likert", "text_key": "RNSS002", "dimension": "RNSS" },
      { "id": "RNSS003", "type": "likert", "text_key": "RNSS003", "dimension": "RNSS" },
      { "id": "RNSS004", "type": "likert", "text_key": "RNSS004", "dimension": "RNSS" },
      { "id": "RNSS005", "type": "likert", "text_key": "RNSS005", "dimension": "RNSS" },
      { "id": "RNSS006", "type": "likert", "text_key": "RNSS006", "dimension": "RNSS" },
      { "id": "RNSS007", "type": "likert", "text_key": "RNSS007", "dimension": "RNSS" },
      { "id": "RNSS008", "type": "likert", "text_key": "RNSS008", "dimension": "RNSS" },
      { "id": "RNSS009", "type": "likert", "text_key": "RNSS009", "dimension": "RNSS" },
      { "id": "RNSS010", "type": "likert", "text_key": "RNSS010", "dimension": "RNSS" },
      { "id": "RNSS011", "type": "likert", "text_key": "RNSS011", "dimension": "RNSS" },
      { "id": "RNSS012", "type": "likert", "text_key": "RNSS012", "dimension": "RNSS" },
      { "id": "RNSS013", "type": "likert", "text_key": "RNSS013", "dimension": "RNSS" },
      { "id": "RNSS014", "type": "likert", "text_key": "RNSS014", "dimension": "RNSS" },
      { "id": "RNSS015", "type": "likert", "text_key": "RNSS015", "dimension": "RNSS" },
      { "id": "RNSS016", "type": "likert", "text_key": "RNSS016", "dimension": "RNSS" },
      { "id": "RNSS017", "type": "likert", "text_key": "RNSS017", "dimension": "RNSS" },
      { "id": "RNSS018", "type": "likert", "text_key": "RNSS018", "dimension": "RNSS" },
      { "id": "RNSS019", "type": "likert", "text_key": "RNSS019", "dimension": "RNSS" },
      { "id": "RNSS020", "type": "likert", "text_key": "RNSS020", "dimension": "RNSS" }
    ],
    "scoring": {
      "RNSS": {
        "method": "mean_coded",
        "description": "Relational Needs Satisfaction total — mean of all 20 items; item 18 reverse-scored",
        "items": {
          "RNSS001": 1, "RNSS002": 1, "RNSS003": 1, "RNSS004": 1,
          "RNSS005": 1, "RNSS006": 1, "RNSS007": 1, "RNSS008": 1,
          "RNSS009": 1, "RNSS010": 1, "RNSS011": 1, "RNSS012": 1,
          "RNSS013": 1, "RNSS014": 1, "RNSS015": 1, "RNSS016": 1,
          "RNSS017": 1, "RNSS018": -1, "RNSS019": 1, "RNSS020": 1
        }
      }
    }
  },
  "translations": {
    "en": {
      "RNSS_head": "Please indicate how true each statement is of you.",
      "RNSS_r1": "Never true",
      "RNSS_r2": "Rarely true",
      "RNSS_r3": "Sometimes true",
      "RNSS_r4": "Often true",
      "RNSS_r5": "Always true",
      "RNSS001": "My social circle consists of people who share a similar life experience (e.g., a hobby, a profession, belonging to the same group or online forum).",
      "RNSS002": "I hardly have to hide anything in the company of people close to me.",
      "RNSS003": "I have a strong, stable and protective person in my life, whom I can rely on.",
      "RNSS004": "I have a capable individual who would help me if I found myself in trouble.",
      "RNSS005": "I know people who experience some things similarly to me.",
      "RNSS006": "Others often take my advice to heart.",
      "RNSS007": "Other people often help me even if I do not specifically ask them to.",
      "RNSS008": "I know people with a worldview similar to mine.",
      "RNSS009": "Other people sometimes surprise me in a nice way.",
      "RNSS010": "I see that other people listen to my advice or my suggestion.",
      "RNSS011": "People close to me would sometimes do things for me without me having to ask.",
      "RNSS012": "I feel free to show my feelings to others and speak my mind, because I know they accept me for who I am.",
      "RNSS013": "I do not have to pretend with people who are important to me.",
      "RNSS014": "I have at least one person in my life who encourages me, protects me or provides me with the information I need.",
      "RNSS015": "There are people in my life with whom I share similar experiences.",
      "RNSS016": "I can show my true self to people who are important to me without fear or rejection.",
      "RNSS017": "In times of trouble, I have someone who stands by me and who is strong enough to handle my problems.",
      "RNSS018": "No-one ever prepares a nice surprise for me.",
      "RNSS019": "People encourage me to follow my own judgement regardless of their wishes.",
      "RNSS020": "Other people often ask about my opinion on a certain topic."
    },
    "es": {
      "_translator": "Iraurgi, I., Gómez-Marroquín, I., Erskine, R., Mauriz, A., Martínez-Rodríguez, S., Gorbeña, S., & Žvelc, G. (2022). https://doi.org/10.3389/fpsyg.2022.992205",
      "RNSS_head": "Por favor, indique en qué medida cada afirmación es verdadera para usted.",
      "RNSS_r1": "Nunca es verdad",
      "RNSS_r2": "Raramente es verdad",
      "RNSS_r3": "A veces es verdad",
      "RNSS_r4": "A menudo es verdad",
      "RNSS_r5": "Siempre es verdad",
      "RNSS001": "Mi círculo social consiste en personas que han compartido experiencias de la vida similares a las mías (por ejemplo: aficiones, profesión, ser parte del mismo grupo o foro online).",
      "RNSS002": "Casi nunca tengo que esconder nada cuando estoy en compañía de personas cercanas.",
      "RNSS003": "Tengo una persona fuerte, estable y protectora en mi vida que puedo contar.",
      "RNSS004": "Sé de alguna persona que me ayudaría en el caso de estar en peligro.",
      "RNSS005": "Se de algunas personas que han pasado por las mismas experiencias que yo.",
      "RNSS006": "Hay personas que se toman mis opiniones a pecho.",
      "RNSS007": "La gente frecuentemente me ayuda sin que yo les pida ayuda.",
      "RNSS008": "Conozco a personas que tienen la misma forma de ver la vida que yo.",
      "RNSS009": "A veces hay personas que me sorprenden positivamente/agradablemente.",
      "RNSS010": "Veo que la gente escucha mis consejos y sugerencias.",
      "RNSS011": "A veces la gente que es cercana a mí hace cosas para mí sin que yo les pida nada.",
      "RNSS012": "Me siento libre de expresar mis sentimientos y decir lo que pienso a los demás porque se que me aceptan tal como soy.",
      "RNSS013": "No tengo que aparentar con personas que son importantes para mí.",
      "RNSS014": "Tengo al menos una persona en mi vida que me anima, protege y/o proporciona la información que necesito.",
      "RNSS015": "Hay personas en mi vida con quienes comparto experiencias similares.",
      "RNSS016": "Puedo enseñar mi verdadero yo a las personas que son importantes para mi sin miedo o rechazo.",
      "RNSS017": "Cuando hay problemas, tengo alguien que me apoya y que es suficientemente fuerte para encargarse de mis problemas.",
      "RNSS018": "Nadie prepara ninguna sorpresa agradable para mí.",
      "RNSS019": "La gente me anima a seguir mi propio juicio sin tener en cuenta sus deseos.",
      "RNSS020": "Frecuentemente la gente me pregunta por mi opinión en ciertos temas."
    }
  }
}
