  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "ipip_P425": "Am considered attractive by others.",
      "ipip_P347": "Attract attention from the opposite sex.",
      "ipip_P414": "Dislike looking at my body.",
      "ipip_P349": "Dislike looking at myself in the mirror.",
      "ipip_P471": "Don't consider myself attractive.",
      "ipip_P358": "Have a pleasing physique.",
      "ipip_P386": "Like to look at my body.",
      "ipip_P396": "Like to look at myself in the mirror.",
      "ipip_P474": "Like to show off my body.",
      "ipip_R79": "Check on things more often than necessary.",
      "ipip_R34": "Feel that I have to repeat certain numbers.",
      "ipip_R19": "Feel that there are good and bad numbers.",
      "ipip_R37": "Get upset by unpleasant thoughts that come into my mind.",
      "ipip_R31": "Get upset if objects are not arranged properly.",
      "ipip_R24": "Get upset if others change the way that I have arranged things.",
      "ipip_R45": "Have difficulty getting rid of nasty thoughts.",
      "ipip_R48": "Need things to be arranged in a particular order.",
      "ipip_R7": "Repeatedly check doors, windows, and drawers.",
      "ipip_R59": "Sometimes have to clean myself simply because I feel contaminated.",
      "ipip_R47": "Wash my hands more often than is necessary.",
      "ipip_R46": "Find it difficult to touch an object that has been touched by other"
    },
    "sr": {
      "_translator": "Boele De Raad & colleagues (Serbia); machine translation",
      "ipip_likert_4": "Uglavnom tačno",
      "ipip_likert_1": "Potpuno netačno",
      "ipip_likert_2": "Uglavnom netačno",
      "ipip_debrief": "Hvala vam što ste popunili ovaj upitnik.",
      "ipip_question_head": "<h3>Kako tačno možete da opišete sebe?</h3><p>Opišite sebe onakvi kakvi generalno jeste sada, a ne onakvi kakvi biste želeli da budete u budućnosti. Opišite sebe onako kako iskreno vidite sebe, u poređenju sa drugim ljudima istog pola i otprilike iste starosti. Da biste mogli da se opišete na iskren način, vaši odgovori će biti čuvani u apsolutnoj tajnosti. Označite tačnost svake tvrdnje koja se odnosi na vas, koristeći sledeću skalu:</p>",
      "ipip_likert_5": "Potpuno tačno",
      "ipip_likert_3": "Ni tačno ni netačno",
      "ipip_P425": "Drugi me smatraju privlačnim.",
      "ipip_P396": "Volim da se gledam u ogledalu.",
      "ipip_R24": "Uznemirim se ako drugi poremete moje planove.",
      "ipip_R59": "Ponekad imam potrebu da se okupam jer se osetim prljavim.",
      "ipip_R79": "Proveravam stvari češće nego što je potrebno.",
      "ipip_P349": "Ne volim da se gledam u ogledalu.",
      "ipip_R7": "Stalno proveravam da li sam zatvorio vrata, prozore i fioke.",
      "ipip_P347": "Privlačim pažnju suprotnog pola.",
      "ipip_P358": "Imam dobar stas.",
      "ipip_R31": "Uznemirim se ako stvari oko mene nisu uredno poslagane.",
      "ipip_R47": "Perem ruke češće nego što treba.",
      "ipip_P474": "Volim da se ponosim lepotom svog tela.",
      "ipip_R48": "Potrebno mi je da stvaru budu poređanje da određen način.",
      "ipip_P386": "Volim da posmatram svoje telo.",
      "ipip_P414": "Ne volim da gledam svoje telo.",
      "ipip_R46": "Teško mi je da dodirnem predmet koji su dirali drugi.",
      "ipip_R19": "Imam osećaj da postoje dobri i loši brojevi.",
      "ipip_P471": "Ne smatram sebe privlačnim.",
      "ipip_R37": "Nekad se uznemirim od neprijatnih misli",
      "ipip_R45": "Teško mi je da se otarasim bezobraznih misli.",
      "ipip_R34": "Ponekad osećam potrebu da ponavljam neke brojeve."
    }
  }
}
