  "translations": {
    "en": {
      "approve_social_inst": "Please select the answer that best reflects your typical response to other people on the scale 0 (disagree completely) to 10 (agree completely). If an item is not relevant to you, you may skip it. When other people are being difficult (e.g., treating me badly), I respond by:",
      "approve_social01": "Telling them to shut up",
      "approve_social02": "Giving in",
      "approve_social03": "Shouting and screaming",
      "approve_social04": "Hearing what they are saying but also stating my own views",
      "approve_social05": "Standing up for myself",
      "approve_social06": "Swearing at them",
      "approve_social07": "Repeating my own opinion if they don't listen the first time",
      "approve_social08": "Yelling at them",
      "approve_social09": "Presenting and defending my own view",
      "approve_social10": "Finding myself at their mercy",
      "approve_social11": "Shouting out loud at them",
      "approve_social12": "Letting them know that I wish to be left in peace right now",
      "approve_social13": "Allowing them to get on top of me",
      "approve_social14": "Telling myself they are right, even though I don't believe they are right",
      "approve_social15": "Doing what they want",
      "approve_social_r0": "Disagree completely",
      "approve_social_r10": "Agree completely",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
