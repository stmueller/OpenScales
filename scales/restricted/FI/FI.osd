    "pt-BR": {
      "fi_01": "No geral, qual o seu nível de satisfação com a sua vida como um todo atualmente?",
      "fi_rs_satisfied_r10": "Completamente satisfeito com minha vida",
      "fi_rs_satisfied_r0": "Nem um pouco satisfeito com minha vida",
      "fi_02": "Em geral, o quão feliz ou infeliz você geralmente se sente?",
      "fi_rs_happy_r10": "Extremamente feliz",
      "fi_rs_happy_r0": "Extremamente infeliz",
      "fi_03": "Em geral, como você classificaria sua saúde física?",
      "fi_rs_physical_r10": "Excelente saúde física",
      "fi_rs_physical_r0": "Péssima saúde física",
      "fi_04": "Como você classificaria sua saúde mental geral?",
      "fi_rs_mental_r10": "Excelente saúde mental",
      "fi_rs_mental_r0": "Péssima saúde mental",
      "fi_05": "No geral, até que ponto você sente que as coisas que você faz em sua vida valem a pena?",
      "fi_rs_worthwhile_r10": "Valem a pena completamente",
      "fi_rs_worthwhile_r0": "Não valem a pena nem um pouco",
      "fi_06": "Eu entendo o meu propósito na vida.",
      "fi_rs_agree_r10": "Concordo totalmente",
      "fi_rs_agree_r0": "Discordo totalmente",
      "fi_07": "Eu sempre atuo para promover o bem em todas as circunstâncias, mesmo em situações difíceis e desafiadoras.",
      "fi_rs_trueme_r10": "Completamente verdade sobre mim",
      "fi_rs_trueme_r0": "Nem um pouco verdade sobre mim",
      "fi_08": "Eu sempre sou capaz de abrir mão de alguma felicidade agora para uma maior felicidade mais tarde.",
      "fi_09": "Eu estou contente com minhas amizades e relacionamentos.",
      "fi_10": "Meus relacionamentos são tão satisfatórios quanto eu gostaria que fossem.",
      "fi_11": "Com que frequência você se preocupa sobre ser capaz de atender às despesas de vida mensais normais?",
      "fi_rs_worry_r10": "Nunca me preocupo",
      "fi_rs_worry_r0": "Me preocupo o tempo todo",
      "fi_12": "Com que frequência você se preocupa com segurança, alimentação ou moradia?"
    },
    "pa": {
      "fi_01": "ਕੁੱਲ ਮਿਲਾ ਕੇ, ਤੁਸੀਂ ਇਨ੍ਹਾਂ ਦਿਨਾਂ ਵਿੱਚ ਸਮੁੱਚੇ ਜੀਵਨ ਤੋਂ ਕਿੰਨੇ ਸੰਤੁਸ਼ਟ ਹੋ?",
      "fi_rs_satisfied_r10": "ਆਪਣੀ ਜ਼ਿੰਦਗੀ ਤੋਂ ਪੂਰੀ ਤਰ੍ਹਾਂ ਸੰਤੁਸ਼ਟ",
      "fi_rs_satisfied_r0": "ਆਪਣੀ ਜ਼ਿੰਦਗੀ ਤੋਂ ਬਿਲਕੁਲ ਵੀ ਸੰਤੁਸ਼ਟ ਨਹੀਂ",
      "fi_02": "ਆਮ ਤੌਰ ’ਤੇ, ਤੁਸੀਂ ਕਿੰਨਾ ਖੁਸ਼ ਜਾਂ ਦੁਖੀ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ?",
      "fi_rs_happy_r10": "ਬਹੁਤ ਖੁਸ਼",
      "fi_rs_happy_r0": "ਬਹੁਤ ਜ਼ਿਆਦਾ ਦੁਖੀ",
      "fi_03": "ਆਮ ਤੌਰ ’ਤੇ, ਤੁਸੀਂ ਆਪਣੀ ਸਰੀਰਕ ਸਿਹਤ ਨੂੰ ਕਿਵੇਂ ਰੇਟ ਕਰੋਗੇ?",
      "fi_rs_physical_r10": "ਸ਼ਾਨਦਾਰ ਸਰੀਰਕ ਸਿਹਤ",
      "fi_rs_physical_r0": "ਮਾੜੀ ਸਰੀਰਕ ਸਿਹਤ",
      "fi_04": "ਤੁਸੀਂ ਆਪਣੀ ਸਮੁੱਚੀ ਮਾਨਸਿਕ ਸਿਹਤ ਨੂੰ ਕਿਵੇਂ ਰੇਟ ਕਰੋਗੇ?",
      "fi_rs_mental_r10": "ਸ਼ਾਨਦਾਰ ਮਾਨਸਿਕ ਸਿਹਤ",
      "fi_rs_mental_r0": "ਮਾੜੀ ਮਾਨਸਿਕ ਸਿਹਤ",
      "fi_05": "ਕੁੱਲ ਮਿਲਾ ਕੇ, ਤੁਸੀਂ ਆਪਣੇ ਜੀਵਨ ਵਿੱਚ ਕੀਤੀਆਂ ਚੀਜ਼ਾਂ ਨੂੰ ਕਿਸ ਹੱਦ ਤੱਕ ਉਚਿਤ ਮਹਿਸੂਸ ਕਰਦੇ ਹੋ?",
      "fi_rs_worthwhile_r10": "ਪੂਰੀ ਤਰ੍ਹਾਂ ਉਚਿਤ",
      "fi_rs_worthwhile_r0": "ਬਿਲਕੁਲ ਵੀ ਉਚਿਤ ਨਹੀਂ",
      "fi_06": "ਮੈਂ ਆਪਣੇ ਜੀਵਨ ਦੇ ਮਕਸਦ ਨੂੰ ਸਮਝਦਾ ਹਾਂ।",
      "fi_rs_agree_r10": "ਪੂਰੀ ਤਰ੍ਹਾਂ ਸਹਿਮਤ",
      "fi_rs_agree_r0": "ਜ਼ੋਰਦਾਰ ਅਸਹਿਮਤ",
      "fi_07": "ਮੈਂ ਹਮੇਸ਼ਾ ਹਰ ਸਥਿਤੀ ਵਿੱਚ ਚੰਗੇ ਨੂੰ ਉਤਸ਼ਾਹਿਤ ਕਰਨ ਲਈ ਕੰਮ ਕਰਦਾ ਹਾਂ, ਇੱਥੋਂ ਤੱਕ ਕਿ ਮੁਸ਼ਕਲ ਅਤੇ ਚੁਣੌਤੀਪੂਰਨ ਸਥਿਤੀਆਂ ਵਿੱਚ ਵੀ।",
      "fi_rs_trueme_r10": "ਮੇਰੇ ਬਾਰੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਸੱਚ ਹੈ",
      "fi_rs_trueme_r0": "ਮੇਰੇ ਬਾਰੇ ਬਿਲਕੁਲ ਵੀ ਸੱਚ ਨਹੀਂ ਹੈ",
      "fi_08": "ਮੈਂ ਹਮੇਸ਼ਾ ਬਾਅਦ ਵਿੱਚ ਵਧੇਰੇ ਖੁਸ਼ੀ ਲਈ ਹੁਣ ਕੁਝ ਖੁਸ਼ੀ ਛੱਡਣ ਦੇ ਯੋਗ ਹਾਂ।",
      "fi_09": "ਮੈਂ ਆਪਣੀਆਂ ਦੋਸਤੀਆਂ ਅਤੇ ਰਿਸ਼ਤਿਆਂ ਤੋਂ ਸੰਤੁਸ਼ਟ ਹਾਂ।",
      "fi_10": "ਮੇਰੇ ਰਿਸ਼ਤੇ ਓਨੇ ਹੀ ਸੰਤੁਸ਼ਟੀਜਨਕ ਹਨ ਜਿੰਨਾ ਮੈਂ ਚਾਹੁੰਦਾ ਹਾਂ ਕਿ ਉਹ ਹੋਣ।",
      "fi_11": "ਤੁਸੀਂ ਸਧਾਰਣ ਮਹੀਨਾਵਾਰ ਰਹਿਣ ਦੇ ਖਰਚਿਆਂ ਨੂੰ ਪੂਰਾ ਕਰਨ ਦੇ ਯੋਗ ਹੋਣ ਬਾਰੇ ਕਿੰਨੀ ਵਾਰ ਚਿੰਤਾ ਕਰਦੇ ਹੋ?",
      "fi_rs_worry_r10": "ਕਦੇ ਵੀ ਚਿੰਤਾ ਨਹੀਂ ਕੀਤੀ",
      "fi_rs_worry_r0": "ਹਰ ਵੇਲੇ ਚਿੰਤਾ ਕਰਦੇ ਹੋ",
      "fi_12": "ਤੁਸੀਂ ਕਿੰਨੀ ਵਾਰ ਸੁਰੱਖਿਆ, ਭੋਜਨ ਜਾਂ ਰਿਹਾਇਸ਼ ਬਾਰੇ ਚਿੰਤਾ ਕਰਦੇ ਹੋ?"
    },
    "st": {
      "fi_01": "Ka kakaretso, u khotsofetse hakae ka bophelo ka kakaretso matsatsing aa?",
      "fi_rs_satisfied_r10": "Ho khotsofala ka botlalo ka bophelo ba hau",
      "fi_rs_satisfied_r0": "Ha ua khotsofala ho hang ka bophelo ba hau",
      "fi_02": "Ka kakaretso, hangata u ikutloa u thabile kapa u sa thaba hakae?",
      "fi_rs_happy_r10": "Ho thaba haholo",
      "fi_rs_happy_r0": "Ho sa thabe haholo",
      "fi_03": "Ka kakaretso, u ka lekanya bophelo bo botle ba 'MELE joang?",
      "fi_rs_physical_r10": "Bophelo bo botle ba 'mele",
      "fi_rs_physical_r0": "Ho fokola 'meleng",
      "fi_04": "U ka lekanya bophelo bo botle ba KELELLO joang?",
      "fi_rs_mental_r10": "Bophelo bo botle ba kelello",
      "fi_rs_mental_r0": "Bophelo bo bobe ba kelello",
      "fi_05": "Ka kakaretso, u bona eka dintho tseo u di etsang bophelong ba hao di u tsoela molemo hakae?",
      "fi_rs_worthwhile_r10": "Ee bohlokoa ka ho feletseng",
      "fi_rs_worthwhile_r0": "Ha ho na thuso ho hang",
      "fi_06": "Ke utloisisa morero oa ka bophelong.",
      "fi_rs_agree_r10": "Dumellana ka matla",
      "fi_rs_agree_r0": "Ha ke dumellane ka matla",
      "fi_07": "Ke dula ke nka khato ho khothaletsa botle maemong ohle, esita le maemong a thata le a phephetso.",
      "fi_rs_trueme_r10": "Ke 'nete ka ho felletseng ka nna",
      "fi_rs_trueme_r0": "Ha se nnete ko nna ho hang",
      "fi_08": "Ka dinako tsohle ke khona ho tela thabo e itseng hona joale bakeng sa thabo e kholoanyane hamorao.",
      "fi_09": "Ke khotsofetse ke metsoalle le dikamano tsa hau.",
      "fi_10": "Dikamano tsa ka di khotsofetsa kamoo ke neng ke ka batla hore di be ka teng.",
      "fi_11": "Ke hangata hakae u tšoenyehang ka ho khona ho kopana le ditšenyehelo tse tloaelehileng tsa khoedi le khoedi?",
      "fi_rs_worry_r10": "Le se ke la tšoenyeha",
      "fi_rs_worry_r0": "Tšoenyeha ka dinako tsohle",
      "fi_12": "Ke hangata hakae u tšoenyehang ka tšireletseho, dijo kapa bolulo?"
    },
    "es-419": {
      "fi_01": "En general, ¿qué tan satisfecho(a) está usted con su vida últimamente?",
      "fi_rs_satisfied_r10": "Completamente satisfecho(a) con su vida",
      "fi_rs_satisfied_r0": "Nada satisfecho(a) con su vida",
      "fi_02": "En general ¿qué tan feliz o infeliz se siente usted normalmente?",
      "fi_rs_happy_r10": "Extremadamente feliz",
      "fi_rs_happy_r0": "Extremadamente infeliz",
      "fi_03": "En general, ¿cómo calificaría usted su salud física?",
      "fi_rs_physical_r10": "Excelente salud física",
      "fi_rs_physical_r0": "Muy mala salud física",
      "fi_04": "¿Cómo calificaría usted su salud mental en general?",
      "fi_rs_mental_r10": "Excelente salud mental",
      "fi_rs_mental_r0": "Muy mala salud mental",
      "fi_05": "En general, ¿en qué medida siente usted que las cosas que hace en su vida valen la pena?",
      "fi_rs_worthwhile_r10": "Valen totalmente la pena",
      "fi_rs_worthwhile_r0": "No valen la pena en absoluto",
      "fi_06": "Yo entiendo cuál es mi propósito en la vida.",
      "fi_rs_agree_r10": "Totalmente de acuerdo",
      "fi_rs_agree_r0": "Totalmente en desacuerdo",
      "fi_07": "Yo siempre actúo para promover el bien en toda circunstancia, incluso en situaciones difíciles y complicadas.",
      "fi_rs_trueme_r10": "Totalmente cierto sobre mí",
      "fi_rs_trueme_r0": "No es cierto sobre mí en lo absoluto",
      "fi_08": "Yo siempre soy capaz de renunciar a un poco de felicidad ahora por una felicidad mayor más adelante.",
      "fi_09": "Yo estoy contento(a) con mis amistades y relaciones personales.",
      "fi_10": "Mis relaciones personales son tan satisfactorias como a mí me gustaría que fueran.",
      "fi_11": "¿Con qué frecuencia se preocupa usted por poder cubrir los gastos mensuales normales del costo de vida?",
      "fi_rs_worry_r10": "Nunca le preocupa",
      "fi_rs_worry_r0": "Le preocupa todo el tiempo",
      "fi_12": "¿Con qué frecuencia se preocupa usted por la seguridad, la alimentación o la vivienda?"
    },
    "es": {
      "fi_01": "¿Cómo de satisfecho está con la vida en general en estos días?",
      "fi_rs_satisfied_r10": "Completamente satisfecho con su vida",
      "fi_rs_satisfied_r0": "Nada satisfecho con su vida",
      "fi_02": "En general, ¿cómo de feliz o infeliz se siente?",
      "fi_rs_happy_r10": "Extraordinariamente feliz",
      "fi_rs_happy_r0": "Extraordinariamente infeliz",
      "fi_03": "En general, ¿cómo calificaría su salud física?",
      "fi_rs_physical_r10": "Salud física excelente",
      "fi_rs_physical_r0": "Mala salud física",
      "fi_04": "¿Cómo calificaría su salud mental en general?",
      "fi_rs_mental_r10": "Salud mental excelente",
      "fi_rs_mental_r0": "Mala salud mental",
      "fi_05": "En general, ¿en qué medida siente que las cosas que hace en su vida valen la pena?",
      "fi_rs_worthwhile_r10": "Totalmente",
      "fi_rs_worthwhile_r0": "Nada",
      "fi_06": "Entiendo mi propósito en la vida.",
      "fi_rs_agree_r10": "Totalmente de acuerdo",
      "fi_rs_agree_r0": "Totalmente en desacuerdo",
      "fi_07": "Siempre actúo en aras del bien en todas las circunstancias, aun en situaciones complejas y difíciles.",
      "fi_rs_trueme_r10": "Completamente cierto",
      "fi_rs_trueme_r0": "Nada cierto",
      "fi_08": "Siempre soy capaz de renunciar a una parte de la felicidad momentánea por una felicidad futura mayor.",
      "fi_09": "Mis amistades y relaciones me resultan satisfactorias.",
      "fi_10": "Mis relaciones son tan satisfactorias como me gustaría que fueran.",
      "fi_11": "¿Con qué frecuencia le preocupa poder contar con suficientes ingresos para satisfacer sus gastos mensuales de subsistencia habituales?",
      "fi_rs_worry_r10": "No me preocupo nunca",
      "fi_rs_worry_r0": "Me preocupo continuamente",
      "fi_12": "¿Con qué frecuencia se preocupa por la seguridad, la comida o la vivienda?"
    },
    "sw-KE": {
      "fi_01": "Kwa ujumla, je, ni kwa kiwango gani umeridhika na maisha?",
      "fi_rs_satisfied_r10": "Umeridhika sana na maisha yako",
      "fi_rs_satisfied_r0": "Hujaridhika kamwe na maisha yako",
      "fi_02": "Kwa ujumla, je, ni kwa kiwango gani kwa kawaida unajisikia mwenye furaha au mwenye huzuni?",
      "fi_rs_happy_r10": "Furaha sana",
      "fi_rs_happy_r0": "Huzuni sana",
      "fi_03": "Kwa ujumla, je, ni kwa kiwango gani unaweza kupima afya yako ya kimwili?",
      "fi_rs_physical_r10": "Afya bora ya kimwili",
      "fi_rs_physical_r0": "Afya duni ya kimwili",
      "fi_04": "Je, ni kwa kiwango gani unaweza kupima afya yako ya akili?",
      "fi_rs_mental_r10": "Afya bora ya akili",
      "fi_rs_mental_r0": "Poor mental health",
      "fi_05": "Kwa jumla, je, ni kwa kiwango gani unaona vitu unavyofanya maishani mwako vinathamani.",
      "fi_rs_worthwhile_r10": "Vinathamani kabisa",
      "fi_rs_worthwhile_r0": "Havinathamani kabisa",
      "fi_06": "Naelewa kusudi langu maishani.",
      "fi_rs_agree_r10": "Nakubaliana kabisa",
      "fi_rs_agree_r0": "Sikubaliani kabisa",
      "fi_07": "Ninachukua hatua kila wakati kukuza wema katika hali zote, hata katika hali ngumu na zenye changamoto.",
      "fi_rs_trueme_r10": "Ukweli kabisa kukuhusu",
      "fi_rs_trueme_r0": "Sio kweli kabisa kukuhusu",
      "fi_08": "Nina uwezo wakati wote wa kujitolea kutokuwa na furaha sasa ili kuweza kuwa na furaha zaidi baadaye.",
      "fi_09": "Ninaridhika na urafiki wangu na mahusiano.",
      "fi_10": "Mahusiano yangu yanaridhisha kama vile ningetaka yawe.",
      "fi_11": "Ni mara ngapi una wasiwasi juu ya kuweza kukidhi gharama za kawaida za maisha ya kila mwezi?",
      "fi_rs_worry_r10": "Huna wasiwasi kamwe",
      "fi_rs_worry_r0": "Wasiwasi wakati wote",
      "fi_12": "Ni mara ngapi una wasiwasi juu ya usalama, chakula, au nyumba?"
    },
    "sw-TZ": {
      "fi_01": "Kwa ujumla, ni kwa kiasi gani unaridhika na maisha yako kwa ujumla siku hizi?",
      "fi_rs_satisfied_r10": "Umeridhika kabisa na maisha yako",
      "fi_rs_satisfied_r0": "Hujaridhika kabisa na maisha yako",
      "fi_02": "Kwa ujumla, je, ni kwa kiasi gani una furaha au hauna furaha kwa kawaida unavyojisikia?",
      "fi_rs_happy_r10": "Una furaha kupita kiasi",
      "fi_rs_happy_r0": "Hauna furaha kabisa",
      "fi_03": "Kwa ujumla, utapimaje, NGUVU ZA KIMWILI za afya yako?",
      "fi_rs_physical_r10": "Nguvu bora za mwili",
      "fi_rs_physical_r0": "Nguvu duni za mwili",
      "fi_04": "Je, kwa ujumla utapimaje afya ya AKILI yako?",
      "fi_rs_mental_r10": "Afya bora ya akili",
      "fi_rs_mental_r0": "Afya duni ya akili",
      "fi_05": "Kwa ujumla, je, ni kwa kiasi gani unajisikia kuwa vitu unavyovifanya kwenye maisha vina thamani?",
      "fi_rs_worthwhile_r10": "Vina thamani kabisa",
      "fi_rs_worthwhile_r0": "Havina thamani kabisa",
      "fi_06": "Ninaelewa azima yangu kwenye maisha.",
      "fi_rs_agree_r10": "Unakubali kabisa",
      "fi_rs_agree_r0": "Haukubali kabisa",
      "fi_07": "Wakati wote huwa ninahamasisha mazuri katika mazingira yote, hata kama ni magumu na yana changamoto.",
      "fi_rs_trueme_r10": "Ni kweli kabisa kuhusu wewe",
      "fi_rs_trueme_r0": "Sio kweli kabisa kuhusu wewe",
      "fi_08": "Wakati wote huwa ninaweza kujinyima baadhi ya furaha kwa sasa kwa ajili ya furaha kubwa baadaye.",
      "fi_09": "Ninatosheka na urafiki wangu pamoja na mahusiano yangu.",
      "fi_10": "Mahusiano yangu yanaridhisha kama nilivyotaka yawe.",
      "fi_11": "Je, ni mara ngapi unakuwa na hofu ya kutoweza kujitosheleza gharama za kuishi kwa mwezi?",
      "fi_rs_worry_r10": "Kamwe huna hofu",
      "fi_rs_worry_r0": "Hofu wakati wote",
      "fi_12": "Je, ni mara ngapi unakuwa na hofu kuhusu usalama, chakula, au makazi?"
    },
    "sv": {
      "fi_01": "Hur nöjd är du med ditt liv överlag för tillfället?",
      "fi_rs_satisfied_r10": "Helt nöjd med ditt liv",
      "fi_rs_satisfied_r0": "Inte alls nöjd med ditt liv",
      "fi_02": "Hur lycklig eller olycklig känner du dig i allmänhet?",
      "fi_rs_happy_r10": "Ytterst lycklig",
      "fi_rs_happy_r0": "Ytterst olycklig",
      "fi_03": "Hur skulle du bedöma din fysiska hälsa överlag?",
      "fi_rs_physical_r10": "Utmärkt fysisk hälsa",
      "fi_rs_physical_r0": "Dålig fysisk hälsa",
      "fi_04": "Hur skulle du bedöma din mentala hälsa överlag?",
      "fi_rs_mental_r10": "Utmärkt mental hälsa",
      "fi_rs_mental_r0": "Dålig mental hälsa",
      "fi_05": "I vilken utsträckning känner du att det du gör i ditt liv är meningsfullt, överlag?",
      "fi_rs_worthwhile_r10": "Mycket meningsfullt",
      "fi_rs_worthwhile_r0": "Inte meningsfullt alls",
      "fi_06": "Jag förstår mitt syfte i livet.",
      "fi_rs_agree_r10": "Instämmer helt",
      "fi_rs_agree_r0": "Instämmer inte alls",
      "fi_07": "Jag agerar alltid för att främja det goda i alla lägen, även i svåra och utmanande situationer.",
      "fi_rs_trueme_r10": "Helt sant om mig",
      "fi_rs_trueme_r0": "Inte alls sant om mig",
      "fi_08": "Jag kan alltid ge upp lite lycka nu för att uppleva större lycka senare.",
      "fi_09": "Jag är nöjd med mina vänner och relationer.",
      "fi_10": "Mina relationer är så tillfredsställande som jag vill att de ska vara.",
      "fi_11": "Hur ofta oroar du dig över att inte ha råd med dina normala månatliga utgifter?",
      "fi_rs_worry_r10": "Oroar mig aldrig",
      "fi_rs_worry_r0": "Oroar mig hela tiden",
      "fi_12": "Hur ofta oroar du dig över säkerhet, mat eller boende?"
    },
    "ta": {
      "fi_01": "ஒட்டுமொத்தத்தில், நீங்கள் இன்றைய நாட்களில் மொத்தமாக வாழ்க்கையில் எவ்வாறு திருப்தியாக இருக்கிறீர்கள்?",
      "fi_rs_satisfied_r10": "உங்களது வாழ்க்கையில் முழுமையாக திருப்தியாக",
      "fi_rs_satisfied_r0": "உங்களது வாழ்க்கையில் திருப்தியாக இல்லவேயில்லை",
      "fi_02": "பொதுவாக, நீங்கள் வழக்கமாக எவ்வாறு மகிழ்ச்சியாக அல்லது மகிழ்ச்சியாக இல்லாமல் உணர்கிறீர்கள்?",
      "fi_rs_happy_r10": "முற்றிலும் மகிழ்ச்சியாக",
      "fi_rs_happy_r0": "முற்றிலும் மகிழ்ச்சியாக இல்லாமல்",
      "fi_03": "பொதுவாக, நீங்கள் உங்களது உடல் ஆரோக்கியத்தை எவ்வாறு மதிப்பிடுகிறீர்கள்?",
      "fi_rs_physical_r10": "பிரமாதமான உடல் ஆரோக்கியம்",
      "fi_rs_physical_r0": "மோசமான உடல் ஆரோக்கியம்",
      "fi_04": "நீங்கள் உங்களது ஒட்டுமொத்த மன ஆரோக்கியத்தை எவ்வாறு மதிப்பிடுவீர்கள்?",
      "fi_rs_mental_r10": "பிரமாதமான மன ஆரோக்கியம்",
      "fi_rs_mental_r0": "மோசமான மன ஆரோக்கியம்",
      "fi_05": "ஒட்டுமொத்தத்தில், நீங்கள் உங்களது வாழ்க்கையில் செய்கிற விஷயங்கள் எந்த அளவிற்கு மதிப்புள்ளதாக உள்ளன என உணர்கிறீர்கள்?",
      "fi_rs_worthwhile_r10": "முழுமையாக மதிப்புள்ளதாக",
      "fi_rs_worthwhile_r0": "மதிப்புள்ளதாக இல்லவேயில்லை",
      "fi_06": "நான் வாழ்க்கையில் எனது நோக்கத்தைப் புரிந்து கொள்கிறேன்.",
      "fi_rs_agree_r10": "உறுதியாக ஒத்துக் கொள்கிறேன்",
      "fi_rs_agree_r0": "உறுதியாக ஒத்துக் கொள்ளவில்லை",
      "fi_07": "சிரமமான மற்றும் சவாலான சூழ்நிலைகளில் கூட, நான் அனைத்து சூழ்நிலைகளில் எப்பொழுதும் நல்லதைச் செய்வதற்கு செயல்படுகிறேன்.",
      "fi_rs_trueme_r10": "எனக்கு முழுமையாக உண்மையாக",
      "fi_rs_trueme_r0": "எனக்கு உண்மையாகவே இல்லை",
      "fi_08": "பிற்காலத்தில் மிகவும் மகிழ்ச்சியாக இருப்பதற்காக இப்பொழுது என்னால் எப்பொழுதும் சிறிது மகிழ்ச்சியை விட்டுத் தரமுடியும்.",
      "fi_09": "நான் எனது நண்பர்கள் மற்றும் உறவுமுறைகளுடன் திருப்தியாக இருக்கிறேன்.",
      "fi_10": "நான் விரும்புகிற அளவிற்கு எனது உறவுமுறைகள் திருப்தியாக உள்ளன.",
      "fi_11": "நீங்கள் சாதாரணமாக வாழ்க்கைக்கான மாதாந்திர செலவுகளைச் சமாளிக்க முடிவது பற்றி எவ்வளவு அடிக்கடி கவலைப்படுகிறீர்கள்?",
      "fi_rs_worry_r10": "எப்பொழுதும் கவலைப்படுவதில்லை",
      "fi_rs_worry_r0": "எல்லா நேரங்களிலும் கவலைப்படுகிறேன்",
      "fi_12": "நீங்கள் எவ்வளவு அடிக்கடி பாதுகாப்பு, உணவு அல்லது தங்குமிடம் பற்றி கவலைப்படுகிறீர்கள்?"
    },
    "te": {
      "fi_01": "మొత్తంగా, ప్రస్తుతం మొత్తంగా మీ జీవితంతో ఎంత సంతృప్తిగా ఉన్నారు?",
      "fi_rs_satisfied_r10": "మీ జీవితంలో పూర్తిగా సంతృప్తిగా ఉన్నారు",
      "fi_rs_satisfied_r0": "మీ జీవితంతో అస్సలు సంతృప్తిగా లేరు",
      "fi_02": "మామూలుగా, మీరు సాధారణంగా ఎంత సంతోషంగా లేదా విచారంగా భావిస్తారు?",
      "fi_rs_happy_r10": "అత్యంత సంతోషంగా",
      "fi_rs_happy_r0": "అత్యంత విచారంగా",
      "fi_03": "మామూలుగా, మీ శారీరక ఆరోగ్యమును ఎలా రేట్ చేస్తారు?",
      "fi_rs_physical_r10": "అద్భుతమైన శారీరక ఆరోగ్యం",
      "fi_rs_physical_r0": "పేలవమైన శారీరక ఆరోగ్యం",
      "fi_04": "మీ మొత్తంగా మానసిక ఆరోగ్యాన్ని మీరు ఎలా రేట్ చేస్తారు?",
      "fi_rs_mental_r10": "అద్భుతమైన మానసిక ఆరోగ్యం",
      "fi_rs_mental_r0": "పేలవమైన మానసిక ఆరోగ్యం",
      "fi_05": "మొత్తంమీద, మీ జీవిత౦లో మీరు చేసే పనులు ఎ౦తమేరకు విలువైనవని మీరు భావిస్తారు?",
      "fi_rs_worthwhile_r10": "పూర్తిగా విలువైనవి",
      "fi_rs_worthwhile_r0": "అస్సలు ఏమాత్రం విలువ లేనివి",
      "fi_06": "జీవితంలో నా ఉద్దేశ్యాన్ని అర్థం చేసుకున్నాను",
      "fi_rs_agree_r10": "గట్టిగా అంగీకరిస్తాను",
      "fi_rs_agree_r0": "గట్టిగా విభేదిస్తాను",
      "fi_07": "క్లిష్టమైన మరియు సవాలుతో కూడిన పరిస్థితుల్లో కూడా, అన్ని పరిస్థితుల్లోనూ మంచిని ప్రోత్సహించు విధంగా నేను ఎల్లప్పుడూ పనిచేస్తాను.",
      "fi_rs_trueme_r10": "నాకు పూర్తి వాస్తవము",
      "fi_rs_trueme_r0": "నాకు ఏమాత్రం వాస్తవం కాదు",
      "fi_08": "తరువాత గొప్ప ఆనందం కోసం నేను ఎల్లప్పుడూ కొంత ఆనందాన్ని వదులుకోగలను.",
      "fi_09": "నా స్నేహాలు మరియు బంధుత్వాలతో నేను సంతృప్తి చెందుతాను",
      "fi_10": "నా బంధుత్వాలు నేను కోరుకున్నంత సంతృప్తికరంగా ఉన్నాయి",
      "fi_11": "సాధారణ నెలవారీ జీవన వ్యయాలను తీర్చగలగడం గురించి మీరు ఎంత తరచుగా ఆందోళన చెందుతారు?",
      "fi_rs_worry_r10": "ఎన్నడూ ఆందోళన చెందను",
      "fi_rs_worry_r0": "అన్ని వేళలా ఆందోళన చెందుతాను",
      "fi_12": "భద్రత, ఆహారం లేదా ఇంటి గురించి మీరు ఎంత తరచుగా ఆందోళన చెందుతారు?"
    },
    "tr": {
      "fi_01": "Genel olarak, bu günlerde hayatınızdan ne kadar memnunsunuz?",
      "fi_rs_satisfied_r10": "Hayatından tamamen memnun",
      "fi_rs_satisfied_r0": "Hayatından hiç memnun değil",
      "fi_02": "Genel olarak, ne kadar mutlu ya da mutsuz hissediyorsunuz?",
      "fi_rs_happy_r10": "Son derece mutlu",
      "fi_rs_happy_r0": "Son derece mutsuz",
      "fi_03": "Genel olarak, fiziksel sağlık durumunuzu nasıl puanlarsınız?",
      "fi_rs_physical_r10": "Mükemmel fiziksel sağlık durumu",
      "fi_rs_physical_r0": "Kötü fiziksel sağlık durumu",
      "fi_04": "Genel olarak, ruhsal sağlık durumunuzu nasıl puanlarsınız?",
      "fi_rs_mental_r10": "Mükemmel ruhsal sağlık durumu",
      "fi_rs_mental_r0": "kötü ruh sağlığı durumu",
      "fi_05": "Genel olarak, hayatınızda yaptıklarınızın ne ölçüde anlamlı olduğunu düşünüyorsunuz?",
      "fi_rs_worthwhile_r10": "Tamamen anlamlı",
      "fi_rs_worthwhile_r0": "Hiç anlamlı değil",
      "fi_06": "Hayattaki amacımı anlıyorum.",
      "fi_rs_agree_r10": "Kesinlikle katılıyorum",
      "fi_rs_agree_r0": "Kesinlikle katılmıyorum",
      "fi_07": "Her zaman, zor ve sıkıntılı durumlar dahil, iyi olanı yapmak yönünde hareket ederim.",
      "fi_rs_trueme_r10": "Benim için tamamen geçerli",
      "fi_rs_trueme_r0": "Benim için hiç geçerli değil",
      "fi_08": "Her zaman gelecekte daha fazla mutluluk için bugün biraz mutluluğu feda edebilirim.",
      "fi_09": "Arkadaşlıklarım ve ilişkilerimden memnunum.",
      "fi_10": "İlişkilerim istediğim kadar tatmin edicidir.",
      "fi_11": "Ne sıklıkla normal aylık yaşam masraflarınızı karşılamak konusunda endişe yaşarsınız?",
      "fi_rs_worry_r10": "Hiç endişe yaşamam",
      "fi_rs_worry_r0": "Her zaman endişe yaşarım",
      "fi_12": "Ne sıklıkla güvenlik, gıda ya da barınma konusunda endişelenirsiniz?"
    },
    "xh": {
      "fi_01": "Lilonke, waneliseke kangakanani bubomi xa bubonke kwezi ntsuku?",
      "fi_rs_satisfied_r10": "Waneliseke ngokupheleleyo ngobomi bakho",
      "fi_rs_satisfied_r0": "Akonelisekanga kwaphela bubomi bakho",
      "fi_02": "Ngokubanzi, udla ngokuziva wonwabile okanye ungonwabanga kangakanani?",
      "fi_rs_happy_r10": "Ndonwabe kakhulu",
      "fi_rs_happy_r0": "Andonwabanga kakhulu",
      "fi_03": "Ngokubanzi, ungayilinganisa njani impilo yakho YOMZIMBA?",
      "fi_rs_physical_r10": "Impilo egqwesileyo yomzimba",
      "fi_rs_physical_r0": "Impilo enkenenkene yomzimba",
      "fi_04": "Ungayilinganisela njani impilo yakho yonke ye-MENTAL?",
      "fi_rs_mental_r10": "Impilo yengqondo egqwesileyo",
      "fi_rs_mental_r0": "Impilo yengqondo engalunganga",
      "fi_05": "Lilonke, uvakalelwa kukuba zixabiseke kangakanani izinto ozenzayo ebomini bakho?",
      "fi_rs_worthwhile_r10": "Ixabiseke ngokupheleleyo",
      "fi_rs_worthwhile_r0": "Ayinamsebenzi kwaphela",
      "fi_06": "Ndiyayiqonda injongo yam ebomini.",
      "fi_rs_agree_r10": "Uvumelana kakhulu",
      "fi_rs_agree_r0": "Awuvumelani kakhulu",
      "fi_07": "Ndihlala ndisenza ukukhuthaza okulungileyo kuzo zonke iimeko, nakwiimeko ezinzima kunye nomngeni.",
      "fi_rs_trueme_r10": "Yinyani ngokupheleleyo kum",
      "fi_rs_trueme_r0": "Ayinyani kum kwaphela",
      "fi_08": "Ndisoloko ndikwazi ukuyeka ulonwabo ngoku ukuze ndonwabe ngakumbi kamva.",
      "fi_09": "Ndanelisekile bubuhlobo kunye nobudlelwane bam.",
      "fi_10": "Ulwalamano lam luyanelisa njengoko ndibuya kuthanda ukuba lube.",
      "fi_11": "Uzikhathaza kangaphi ngokukwazi ukuhlangabezana neendleko zokuhlala zenyanga?",
      "fi_rs_worry_r10": "Ungaze ube nexhala",
      "fi_rs_worry_r0": "Ixhala lonke ixesha",
      "fi_12": "Uzikhathaza kangaphi ngokhuseleko, ukutya okanye indawo yokuhlala?"
    },
    "war": {
      "fi_01": "Ha ngatanan, mationan-o mo pinabibilhan ka kakuntento hit kinabuhi ha kabug-usan yana nga mga adlaw?",
      "fi_rs_satisfied_r10": "Duro kakuntento hit imo kinabuhi",
      "fi_rs_satisfied_r0": "Diri gud kuntento hit imo kinabuhi",
      "fi_02": "Ha kabug-usan, mationan-o mo pinabibilhan an kalipay o diri kamalipay an imo inaabat?",
      "fi_rs_happy_r10": "Diri Gud Duro nga Makalilipay",
      "fi_rs_happy_r0": "Duro kamakalilipay",
      "fi_03": "Ha kabug-usan, mationan-o mo pinabibilhan gud an pisikal nga kahimsog?",
      "fi_rs_physical_r10": "Maupay nga pisikal nga kahimsog",
      "fi_rs_physical_r0": "Diri maupay nga pisikal nga kahimsog",
      "fi_04": "Matiunan-o mo pinabibilhan an imo kabug-usan nga mental nga kahimsog?",
      "fi_rs_mental_r10": "Maupay nga mental nga kahimsog",
      "fi_rs_mental_r0": "Diri maupay nga mental nga kahimsog",
      "fi_05": "Ha ngatanan, kutob diin nga naabat mo nga an mga butang nga imo hinihimo ha kinabuhi hin may pulos?",
      "fi_rs_worthwhile_r10": "Duro nga mapulsanon",
      "fi_rs_worthwhile_r0": "Diri gud mapulsanon",
      "fi_06": "Naiintindihan ko an akon katuyuan ha kinabuhi.",
      "fi_rs_agree_r10": "Mahugot nga naabuyon",
      "fi_rs_agree_r0": "Mahugot nga nakontra",
      "fi_07": "Pirme ako nagi-os para maaghat an kaupayan ha ngatanan nga kahimtang, bisan ha makuri ngan makaulang nga mga sitwasyon.",
      "fi_rs_trueme_r10": "Pinaka-kamatuoran ha akon",
      "fi_rs_trueme_r0": "Diri pinaka-kamatuoran ha akon",
      "fi_08": "Pirme ko nahihimo bayaan an akon iba nga kalipayan yana para hin durudako nga kalipayan ha urhi nga panahon.",
      "fi_09": "Kuntento akon han akon mga kasangkayan ngan mga relasyon.",
      "fi_10": "Makapatagbaw an akon mga relasyon base ha ko karuyag.",
      "fi_11": "Matiunan-o mo kasagaran kabarak-an an diri mo masunod an normal nga binulan nga gasto ha pag-ukoy?",
      "fi_rs_worry_r10": "Diri gud nababaraka",
      "fi_rs_worry_r0": "Pirme gud nababaraka",
      "fi_12": "Matiunan-o mo kasagaran kabarak-an an katalwasan, pagkaon ngan urukyan?"
    },
    "yo": {
      "fi_01": "Lápapọ̀, báwo ni o ṣe ní ìtẹ́lọ́rùn pẹ̀lú ìgbésí ayé ní àwọn ọjọ́ wọ̀nyí?",
      "fi_rs_satisfied_r10": "ìtẹ́lọ́rùn pátá pátá pẹ̀lú ìgbésí ayé rẹ",
      "fi_rs_satisfied_r0": "O kò ní ìtẹ́lọ́rùn pẹ̀lú ìgbésí ayé rẹ rárá",
      "fi_02": "Ní gbogboogbò, bibáwo ni o ti ndùnnú tàbí banuje nípa lílo ìwọ̀n 0 sí 10 níbi tí 10 túmọ̀ sí \"ayọ̀ alailopin” tí 0 túmọ̀ sí “ibanuje alailopin”?",
      "fi_rs_happy_r10": "Ayọ̀ alailopin",
      "fi_rs_happy_r0": "Ibanuje alailopin",
      "fi_03": "Ní gbogboogbò, báwo ni ìwọ yóò ṣe ṣe ìwọ̀n ìlera nípa ti ara rẹ?",
      "fi_rs_physical_r10": "Ó dára jùlọ",
      "fi_rs_physical_r0": "Kò dára",
      "fi_04": "Báwo ni o ṣe lè ṣe ìwọ̀n ìlera ọpọlọ rẹ lapapọ?",
      "fi_rs_mental_r10": "Ó dára jù lọ",
      "fi_rs_mental_r0": "Kò dára",
      "fi_05": "Lapapo, sí iye wo ni o lérò pé àwọn ohun tí o ṣe nínú ìgbésí ayé rẹ ní ìwúlò nípa lílo ìwọ̀n 0 sí 10 níbi tí 10 túmọ̀ sí “ó dára pátápátá ” tí 0 túmọ̀ sí “kò dára rárá”?",
      "fi_rs_worthwhile_r10": "Ó dára pátápátá",
      "fi_rs_worthwhile_r0": "Kò dára rárá",
      "fi_06": "Ó lóye ìdí rẹ̀ tí o fi wá sínú ayé.",
      "fi_rs_agree_r10": "Faramọ́ ọ gidigidi",
      "fi_rs_agree_r0": "Kò faramọ́ ọ rárá",
      "fi_07": "Nígbà gbogbo ni o ńsise láti ṣe igbega ohun rere ní gbogbo àwọn àyídáyidà, pàápàá ní àwọn ipò àti ààyè tí ó nira.",
      "fi_rs_trueme_r10": "Òtítọ́ pátápátá ni èyí nípa mi",
      "fi_rs_trueme_r0": "Kì í ṣe òtítọ́ nípa mi",
      "fi_08": "Ìgbà gbogbo ni o máa ńní àǹfààní láti jowo ìdùnnú isisinyin fún ayọ̀ ńlá nígbà mìíràn.",
      "fi_09": "Mo ní ìtẹ́lọ́rùn pẹ̀lú àwọn ìbádọrẹ àti ìbátan mi.",
      "fi_10": "Àwọn ìbádọ́rẹ rẹ tẹ́ o lọ́rùn bí ìwọ ṣe fẹ́ kí wọn jẹ́.",
      "fi_11": "Bí ìgbà mélòó ni o ronu nípa bíbá iye ìwọ̀n ìnáwó osoosu pàdé?",
      "fi_rs_worry_r10": "Ko yọ ara rẹ lẹ́nu rí",
      "fi_rs_worry_r0": "Ṣe àníyàn ní gbogbo ìgbà",
      "fi_12": "Iye ìgbà mélòó ni o ń ṣe àníyàn nípa ààbò, oúnjẹ, tàbí ilé?"
    },
    "zu": {
      "fi_01": "Sekukonke, waneliseke kangakanani ngempilo yakho yonke kulezi zinsuku?",
      "fi_rs_satisfied_r10": "Ukwaneliseka ngokuphelele ngempilo yakho",
      "fi_rs_satisfied_r0": "Awaneliseki nhlobo ngempilo yakho",
      "fi_02": "Ngokuvamile, uvamise ukuzizwa ujabule noma ungajabuli kangakanani?",
      "fi_rs_happy_r10": "Ukuthokoza ngokwedlulele",
      "fi_rs_happy_r0": "Akujabulisi ngokwedlulele",
      "fi_03": "Ngokuvamile, ungayikala kanjani impilo yakho YOMZIMBA?",
      "fi_rs_physical_r10": "Impilo enhle yomzimba",
      "fi_rs_physical_r0": "Impilo engokomzimba ebuthaka",
      "fi_04": "Ungayilinganisa kanjani impilo yakho yonke ye-MENTAL?",
      "fi_rs_mental_r10": "Impilo yengqondo enhle kakhulu",
      "fi_rs_mental_r0": "Impilo yengqondo ebuthaka",
      "fi_05": "Sekukonke, unomuzwa wokuthi izinto ozenzayo ekuphileni kwakho zizuzisa kangakanani?",
      "fi_rs_worthwhile_r10": "Kuyafaneleka ngokuphelele",
      "fi_rs_worthwhile_r0": "Akufanele neze",
      "fi_06": "Ngiyayiqonda inhloso yami emplilweni.",
      "fi_rs_agree_r10": "Kuvuma ngokuqinile",
      "fi_rs_agree_r0": "Angivumi neze",
      "fi_07": "Ngihlala ngenza ukukhuthaza okuhle kuzo zonke izimo, ngisho nasezimweni ezinzima neziyinselele.",
      "fi_rs_trueme_r10": "Kuyiqiniso ngokuphelele ngami",
      "fi_rs_trueme_r0": "Akulona iqiniso ngami nhlobo",
      "fi_08": "Ngihlale ngikwazi ukuyeka injabulo ethile manje ukuze ngithole injabulo enkulu kamuva.",
      "fi_09": "Nganelisekile ngobungane bami nobudlelwano.",
      "fi_10": "Ubudlelwano bami bugculisa ngendlela engingathanda bube ngayo.",
      "fi_11": "Kukangaki ukhathazeka ngokuthi uzokwazi ukuhlangabezana nezindleko zokuphila zanyanga zonke?",
      "fi_rs_worry_r10": "Ungalokothi ukhathazeke",
      "fi_rs_worry_r0": "Ukukhathazeka ngaso sonke isikhathi",
      "fi_12": "Kukangaki ukhathazeka ngokuphepha, ukudla, noma indawo yokuhlala?"
    },
    "en": {
      "fi_inst": "Please answer each of the following questions on a scale of 0–10.",
      "fi_01": "Overall, how satisfied are you with life as a whole these days?",
      "fi_02": "In general, how happy or unhappy do you usually feel?",
      "fi_03": "In general, how would you rate your physical health?",
      "fi_04": "How would you rate your overall mental health?",
      "fi_05": "Overall, to what extent do you feel the things you do in your life are worthwhile?",
      "fi_06": "I understand my purpose in life.",
      "fi_07": "I always act to promote good in all circumstances, even in difficult and challenging situations.",
      "fi_08": "I am always able to give up some happiness now for greater happiness later.",
      "fi_09": "I am content with my friendships and relationships.",
      "fi_10": "My relationships are as satisfying as I would want them to be.",
      "fi_11": "How often do you worry about being able to meet normal monthly living expenses?",
      "fi_12": "How often do you worry about safety, food, or housing?",
      "fi_rs_satisfied_r0": "Not at all satisfied with your life",
      "fi_rs_satisfied_r10": "Completely satisfied with your life",
      "fi_rs_happy_r0": "Extremely unhappy",
