{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Overactive Bladder Symptoms and Quality of Life",
      "code": "PX880101",
      "abbreviation": "PX880101",
      "description": "The Overactive Bladder Short Form Questionnaire (OAB-q SF) is a self-administered questionnaire containing 19 items that assess a participant’s experience with overactive bladder over the past four weeks. Each item is rated on a Likert-style scale from 1 (Not at all) to 6 (A very great deal). Scores",
      "domain": "Women's Health",
      "citation": "Anele, U. A., Morrison, B. F., Reid, M. E., Madden, W., Foster, S., & Burnett, A. L. (2016). Overactive bladder in adults with sickle cell disease. Neurology and Urodynamics, 35(5), 642–646. https://doi.org/10.1002/nau.22777 [PhenX: https://www.phenxtoolkit.org/protocols/view/880101]",
      "license": "PhenX Toolkit freely available protocol",
      "version": "1.0",
      "url": "https://www.phenxtoolkit.org/protocols/view/880101"
    },
    "option_sets": {
