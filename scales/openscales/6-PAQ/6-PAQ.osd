  "translations": {
    "en": {
      "lk_1": "Strongly Disagree / Never",
      "lk_2": "Disagree / Infrequently",
      "lk_3": "Agree / Often",
      "lk_4": "Strongly Agree / Almost Always",
      "question_head": "Carefully read each of the following items. Then choose the answer or description that best describes your thoughts, feelings, or style of interacting with your child. Your answers should reflect your most consistent feelings and reactions that have been present over the past few months.",
      "paq_1": "When interacting with my child, I focus on our time together.",
      "paq_2": "I am consistent in my parenting practices.",
      "paq_3": "I would rather give in to my child than have him/her make a scene in public.",
      "paq_4": "I get upset if things don't go my way when I interact with my child.",
      "paq_5": "I can clearly state my values related to parenting.",
      "paq_6": "If someone criticizes my parenting, I must be a bad parent.",
      "paq_7": "My parenting behaviors are based on what matters to me as a parent rather than how I feel in the moment.",
      "paq_8": "I feel like my mind is somewhere else when I play with my child.",
      "paq_9": "When my child misbehaves I find myself wrapped in my emotions rather than dealing with the behavior.",
      "paq_10": "My actions as a parent are consistent with my values.",
      "paq_11": "I have negative thoughts about myself when my child behaves in a negative way.",
      "paq_12": "It is difficult to initiate/maintain routines because I don't want to deal with my child's reactions.",
      "paq_13": "When parenting doesn't go as I had planned, I feel like a failure.",
      "paq_14": "I avoid taking my child to the store for fear of how they will behave.",
      "paq_15": "I am able to sacrifice convenience for effective discipline.",
      "paq_16": "I'm a bad parent when my child misbehaves.",
      "paq_17": "When spending time with my child, I find myself planning my day and thinking of the things I need to get done.",
      "paq_18": "I have clear parenting values that guide my interactions with my child."
    }
  }
}