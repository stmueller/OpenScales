      "ipip_X184": "Verujem da ne postoji apsolutno dobro i zlo.",
      "ipip_X225": "Volim da smišljam nove načine kako da uradim nesto.",
      "ipip_H555": "Brzo obavljam stvari.",
      "ipip_X62": "Otvoren sam za promene.",
      "ipip_E39": "Strastven sam u svemu u čemu sam angažovan.",
      "ipip_H601": "Ne otkrivam puno o sebi.",
      "ipip_X113": "Pravim se da mi je stalo do drugih ljudi.",
      "ipip_H699": "Vraćam drugima \"milo za drago\".",
      "ipip_H914": "Često se osećam napadnuto od strane drugih.",
      "ipip_E65": "Brzo sudim o drugim ljudima.",
      "ipip_H1086": "Trudim se da nadmašim druge.",
      "ipip_X150": "Trudim se da se pridržavam pravila.",
      "ipip_H1203": "Želim da budem najbolji što mogu.",
      "ipip_H853": "Često donosim ishitrene odluke.",
      "ipip_E133": "Uživam u preispitivanju sebe i svog života.",
