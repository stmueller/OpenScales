{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "General Self-Efficacy Scale",
      "code": "GSE",
      "abbreviation": "GSE",
      "description": "10-item unidimensional self-report measure of general self-efficacy — the belief in one's overall competence to cope with challenging demands and difficult situations. Uses a 4-point Likert scale (1=Not at all true to 4=Exactly true). Scored as the sum of all 10 items (range 10–40); higher scores indicate greater self-efficacy. No reverse-coded items. Validated in over 30 countries with consistent unidimensional structure and high internal consistency. Available in 32 languages from the author's website.",
      "citation": "Schwarzer, R., & Jerusalem, M. (1995). Generalized Self-Efficacy scale. In J. Weinman, S. Wright, & M. Johnston (Eds.), Measures in health psychology: A user's portfolio. Causal and control beliefs (pp. 35–37). Windsor, UK: NFER-NELSON.",
      "license": "Free for research and professional use with attribution; not open-licensed",
      "license_url": "http://userpage.fu-berlin.de/~health/selfscal.htm",
      "url": "http://userpage.fu-berlin.de/~health/selfscal.htm",
      "domain": "Self & Coping",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items and translations from Schwarzer's official multilingual page at http://userpage.fu-berlin.de/~health/selfscal.htm. Scale is freely available for research use with attribution to Schwarzer & Jerusalem (1995); no formal open license declared. German translation uses a different item order from English (both orderings reflect the same items). Languages included: en, de, fr, es, pt, nl, it, ja, pl. Languages with items stored as images on source page and not yet extracted: ar, zh, ru, ko. Scoring: sum of all 10 items, range 10–40, no reverse-coded items. MISS article 13651 is a psychometric evaluation in Indian adolescents."
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "max": 4,
      "labels": ["gse_r1","gse_r2","gse_r3","gse_r4"],
      "question_head": "gse_qhead"
    },
    "dimensions": [
      {
        "id": "self_efficacy",
        "name": "General Self-Efficacy",
        "abbreviation": "GSE",
        "description": "Unidimensional. Sum of all 10 items; range 10–40; higher = greater general self-efficacy."
      }
    ],
    "items": [
      {"id": "gse1",  "type": "likert", "text_key": "gse1",  "dimension": "self_efficacy"},
      {"id": "gse2",  "type": "likert", "text_key": "gse2",  "dimension": "self_efficacy"},
      {"id": "gse3",  "type": "likert", "text_key": "gse3",  "dimension": "self_efficacy"},
      {"id": "gse4",  "type": "likert", "text_key": "gse4",  "dimension": "self_efficacy"},
      {"id": "gse5",  "type": "likert", "text_key": "gse5",  "dimension": "self_efficacy"},
      {"id": "gse6",  "type": "likert", "text_key": "gse6",  "dimension": "self_efficacy"},
      {"id": "gse7",  "type": "likert", "text_key": "gse7",  "dimension": "self_efficacy"},
      {"id": "gse8",  "type": "likert", "text_key": "gse8",  "dimension": "self_efficacy"},
      {"id": "gse9",  "type": "likert", "text_key": "gse9",  "dimension": "self_efficacy"},
      {"id": "gse10", "type": "likert", "text_key": "gse10", "dimension": "self_efficacy"}
    ],
    "scoring": {
      "self_efficacy": {
        "description": "Sum of all 10 items. Range 10–40; higher = greater general self-efficacy. No recoding required.",
        "method": "sum_coded",
        "items": ["gse1","gse2","gse3","gse4","gse5","gse6","gse7","gse8","gse9","gse10"]
      }
    },
    "report": {
      "template": "standard",
      "include": ["timestamp", "completion_time", "dimension_scores"],
      "header": "General Self-Efficacy Scale (GSE) Report",
      "footer_refs": [
        "Schwarzer, R., & Jerusalem, M. (1995). Generalized Self-Efficacy scale. In J. Weinman, S. Wright, & M. Johnston (Eds.), Measures in health psychology: A user's portfolio. Causal and control beliefs (pp. 35–37). Windsor, UK: NFER-NELSON.",
        "Scale available at: http://userpage.fu-berlin.de/~health/selfscal.htm"
      ]
    }
  },
  "translations": {
    "en": {
      "gse_r1": "Not at all true",
      "gse_r2": "Hardly true",
      "gse_r3": "Moderately true",
      "gse_r4": "Exactly true",
      "gse_qhead": "Please indicate your level of agreement with each of the following statements.",
      "gse1":  "I can always manage to solve difficult problems if I try hard enough.",
      "gse2":  "If someone opposes me, I can find the means and ways to get what I want.",
      "gse3":  "It is easy for me to stick to my aims and accomplish my goals.",
      "gse4":  "I am confident that I could deal efficiently with unexpected events.",
      "gse5":  "Thanks to my resourcefulness, I know how to handle unforeseen situations.",
      "gse6":  "I can solve most problems if I invest the necessary effort.",
      "gse7":  "I can remain calm when facing difficulties because I can rely on my coping abilities.",
      "gse8":  "When I am confronted with a problem, I can usually find several solutions.",
      "gse9":  "If I am in trouble, I can usually think of a solution.",
      "gse10": "I can usually handle whatever comes my way.",
      "debrief": "Thank you for completing this questionnaire."
    },
    "de": {
      "gse_r1": "stimmt nicht",
      "gse_r2": "stimmt kaum",
      "gse_r3": "stimmt eher",
      "gse_r4": "stimmt genau",
      "gse_qhead": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "gse1":  "Wenn sich Widerstände auftun, finde ich Mittel und Wege, mich durchzusetzen.",
      "gse2":  "Die Lösung schwieriger Probleme gelingt mir immer, wenn ich mich darum bemühe.",
      "gse3":  "Es bereitet mir keine Schwierigkeiten, meine Absichten und Ziele zu verwirklichen.",
      "gse4":  "In unerwarteten Situationen weiß ich immer, wie ich mich verhalten soll.",
      "gse5":  "Auch bei überraschenden Ereignissen glaube ich, daß ich gut mit ihnen zurechtkommen kann.",
      "gse6":  "Schwierigkeiten sehe ich gelassen entgegen, weil ich meinen Fähigkeiten immer vertrauen kann.",
      "gse7":  "Was auch immer passiert, ich werde schon klarkommen.",
      "gse8":  "Für jedes Problem kann ich eine Lösung finden.",
      "gse9":  "Wenn eine neue Sache auf mich zukommt, weiß ich, wie ich damit umgehen kann.",
      "gse10": "Wenn ein Problem auftaucht, kann ich es aus eigener Kraft meistern.",
      "debrief": "Vielen Dank für Ihre Teilnahme."
    },
    "fr": {
