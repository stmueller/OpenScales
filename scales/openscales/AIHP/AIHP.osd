  "translations": {
    "en": {
      "likert_1": "Strongly disagree",
      "likert_7": "Strongly agree",
      "stem_use": "The reasons why you would use this application for diagnosis are:",
      "stem_notuse": "The reasons why you would NOT use this application for diagnosis are:",
      "ubiq1": "Using Medical AI apps is an efficient way to manage my time",
      "ubiq2": "Using Medical AI apps makes my life easier",
      "ubiq3": "Using Medical AI apps enables me to access health services at any place",
      "ubiq4": "Using Medical AI apps fits any location, whenever I go",
      "exped1": "Using Medical AI apps will help me to check my symptoms at the earliest time",
      "exped2": "Using Medical AI apps makes me aware of my health problem at the earliest time",
      "exped3": "By using Medical AI apps, I can detect symptomatic diseases as early as possible",
      "corrob1": "I can use this app when I doubt my doctor's diagnosis",
      "corrob2": "I can use this app for making informed decisions about my disease",
      "corrob3": "This app will provide me with the opportunity for cross-checking (double-checking) my GP's advice.",
      "afford1": "Usually, the cost of using Medical AI apps is reasonable",
      "afford2": "I think using such apps is better value for money than what I would pay for the same service in traditional settings",
      "afford3": "Using mobile apps for medical services is costly",
      "healthinfo1": "Checking my symptoms with a Medical AI app enables me to have access to valuable health-related information",
      "healthinfo2": "Using Medical AI apps would give me access to information about symptoms and solutions",
      "healthinfo3": "I can rely on Medical AI apps sources for health information",
      "err1": "Using Medical AI apps might lead to the wrong diagnosis",
      "err2": "I am concerned that this app diagnoses incorrectly.",
      "err3": "I cannot trust that a mobile app can identify my health issue correctly",
      "depers1": "I think the app would recommend something as a general rule",
      "depers2": "I am suspicious of this app being capable of considering my personal needs and specification",
      "depers3": "I doubt if this app can consider my unique symptoms and conditions",
      "dehum1": "I prefer to talk to a doctor about my symptoms and problems, not to an application",
      "dehum2": "I think Medical AI apps are not able to understand my feelings",
      "dehum3": "I cannot get the same feeling from this app that I can get from interacting with my GP.",
      "privacy1": "I think by using this app I would be more subject to data breaches",
      "privacy2": "Medical AI apps will require me to share my personal information that I am not happy to share with applications",
      "privacy3": "I am concerned about abusing my health information by this app or others",
      "opaque1": "I cannot understand how Medical AI apps work",
      "opaque2": "The logic of the application is not understandable to me",
      "opaque3": "This app does not explain how it can diagnose my disease.",
      "willuse1": "I would use this application for diagnosis purposes",
      "willuse2": "I predict I will use this application to get the diagnosis",
      "willuse3": "I do NOT use this application for diagnosis purposes",
      "willpay1": "How much are you happy to pay for using this application?",
      "debrief": "Thank you for completing this questionnaire."
    }
  }
}