{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Metacognitive Prospective Memory Inventory – Short Version",
      "code": "MISS10999",
      "abbreviation": "MPMI-s",
      "description": "A 22-item short form of the Metacognitive Prospective Memory Inventory measuring self-reported prospective memory (PM) across three subscales: Prospective Memory Abilities (PMA, 8 items), Internal PM Strategies (PMSi, 7 items; mental/cognitive strategies), and External PM Strategies (PMSe, 7 items; external aids). 5-point frequency scale. Higher PMA scores indicate better PM abilities; higher PMSi and PMSe scores indicate more frequent strategy use. Validated in German with English translations provided in paper. Age-specific reference data recommended.",
      "citation": "Rummel, J., Danner, D., & Kuhlmann, B. G. (2019). The short version of the Metacognitive Prospective Memory Inventory (MPMI-s): Factor structure, reliability, validity, and reference data. Measurement Instruments for the Social Sciences, 1, Article e10999. https://doi.org/10.1186/s42409-019-0008-6",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://miss.psychopen.eu/index.php/miss/article/view/10999",
      "domain": "Cognitive",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "English item translations verbatim from Table 1; German original in Additional File 1. 5-point scale: 1=Rarely to 5=Often. PMA items are mixed-direction: some are positively worded (good memory = agree = high score) and some negatively worded (forgetting = agree = low ability). Specifically pma1, pma4, pma5, pma8 describe forgetting/failure and should be reverse-coded so that higher score = better ability across all PMA items. PMSi and PMSe items all describe strategy use (higher = more frequent use; no reverse coding needed). Also documented in GESIS-ZIS: https://doi.org/10.6102/zis339_exz"
    },
    "likert_options": {
      "points": 5,
      "min": 1,
      "max": 5,
      "labels": [
        "mpmi_r1",
        "mpmi_r2",
        "mpmi_r3",
        "mpmi_r4",
        "mpmi_r5"
      ]
    },
    "dimensions": [
      {
        "id": "pma",
        "name": "Prospective Memory Abilities",
        "abbreviation": "PMA",
        "description": "Self-rated prospective memory ability in everyday situations. Mean of 8 items (4 reverse-coded), range 1–5; higher = better prospective memory abilities."
      },
      {
        "id": "pmsi",
        "name": "Internal Prospective Memory Strategies",
        "abbreviation": "PMSi",
        "description": "Use of internal/mental strategies to remember future intentions. Mean of 7 items, range 1–5; higher = more frequent internal strategy use."
      },
      {
        "id": "pmse",
        "name": "External Prospective Memory Strategies",
        "abbreviation": "PMSe",
        "description": "Use of external aids (lists, calendars, reminders) to remember future intentions. Mean of 7 items, range 1–5; higher = more frequent external strategy use."
      }
    ],
