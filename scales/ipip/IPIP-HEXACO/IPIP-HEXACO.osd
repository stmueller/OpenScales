      "ipip_P405": "Have trouble guessing how others will react.",
      "ipip_X225": "Love to think up new ways of doing things.",
      "ipip_D11": "Seldom experience sudden intuitive insights.",
      "ipip_P364": "Am good at making impromptu speeches.",
      "ipip_X78": "Don't mind being the center of attention.",
      "ipip_X112": "Feel comfortable around people.",
      "ipip_H592": "Find it difficult to approach others.",
      "ipip_P434": "Hate being the center of attention.",
      "ipip_Q14": "Have a strong personality.",
      "ipip_Q134": "Have leadership abilities.",
      "ipip_H1039": "Have little to say.",
      "ipip_H154": "Keep in the background.",
