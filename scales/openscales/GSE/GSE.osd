  "translations": {
    "en": {
      "gse_qhead": "Please indicate your level of agreement with each of the following statements.",
      "gse1": "I can always manage to solve difficult problems if I try hard enough.",
      "gse2": "If someone opposes me, I can find the ways and means to get what I want.",
      "gse3": "I am certain that I can accomplish my goals.",
      "gse4": "I am confident that I could deal efficiently with unexpected events.",
      "gse5": "Thanks to my resourcefulness, I can handle unforeseen situations.",
      "gse6": "I can solve most problems if I invest the necessary effort.",
      "gse7": "I can remain calm when facing difficulties because I can rely on my coping abilities.",
      "gse8": "When I am confronted with a problem, I can find several solutions.",
      "gse9": "If I am in trouble, I can think of a good solution.",
      "gse10": "I can handle whatever comes my way.",
      "gse_r1": "not at all true",
      "gse_r2": "barely true",
      "gse_r3": "moderately true",
      "gse_r4": "exactly true",
      "LANGUAGE": "English"
    },
    "de": {
      "gse_qhead": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "gse1": "Die Lösung schwieriger Probleme gelingt mir immer, wenn ich mich darum bemühe.",
      "gse2": "Wenn sich Widerstände auftun, finde ich Mittel und Wege, mich durchzusetzen.",
      "gse3": "Es bereitet mir keine Schwierigkeiten, meine Absichten und Ziele zu verwirklichen.",
      "gse4": "In unerwarteten Situationen weiß ich immer, wie ich mich verhalten soll.",
      "gse5": "Auch bei überraschenden Ereignissen glaube ich, daß ich gut mit ihnen zurechtkommen kann.",
      "gse6": "Wenn ein Problem auftaucht, kann ich es aus eigener Kraft meistern.",
      "gse7": "Schwierigkeiten sehe ich gelassen entgegen, weil ich meinen Fähigkeiten immer vertrauen kann.",
      "gse8": "Für jedes Problem kann ich eine Lösung finden.",
      "gse9": "Wenn eine neue Sache auf mich zukommt, weiß ich, wie ich damit umgehen kann.",
      "gse10": "Was auch immer passiert, ich werde schon klarkommen.",
      "gse_r1": "stimmt nicht",
      "gse_r2": "stimmt kaum",
      "gse_r3": "stimmt eher",
      "gse_r4": "stimmt genau",
      "LANGUAGE": "Deutsch"
    },
    "fr": {
      "gse_qhead": "Veuillez indiquer votre niveau d'accord avec chacune des affirmations suivantes.",
      "gse1": "Je peux arriver toujours à résoudre mes difficultés si j'essaie assez fort.",
      "gse2": "Si quelqu'un s'oppose à moi, je peux trouver une façon pour obtenir ce que je veux.",
      "gse3": "C'est facile pour moi de maintenir mon attention sur mes objectifs et accomplir mes buts.",
      "gse4": "J'ai confiance que je peux faire face efficacement aux événements inattendus.",
      "gse5": "Grâce à ma débrouillardise, je sais comment faire face aux situations imprévues.",
      "gse6": "Je peux résoudre la plupart de mes problèmes si j'investis les efforts nécessaires.",
      "gse7": "Je peux rester calme lorsque je suis confronté à des difficultés car je peux me fier à mes habiletés pour faire face aux problèmes.",
      "gse8": "Lorsque je suis confronté à un problème, je peux habituellement trouver plusieurs solutions.",
      "gse9": "Si je suis coincé, je peux habituellement penser à ce que je pourrais faire.",
      "gse10": "Peu importe ce qui arrive, je suis capable d'y faire face généralement.",
      "gse_r1": "pas du tout vrai",
      "gse_r2": "à peine vrai",
      "gse_r3": "moyennement vrai",
      "gse_r4": "totalement vrai",
      "LANGUAGE": "Français"
    },
    "es": {
      "gse_qhead": "Por favor, indique su nivel de acuerdo con cada una de las siguientes afirmaciones.",
      "gse1": "Puedo resolver problemas difíciles si me esfuerzo lo suficiente.",
      "gse2": "Puedo encontrar la manera de obtener lo que quiero aunque alguien se me oponga.",
      "gse3": "Me es fácil persistir en lo que me he propuesto hasta llegar a alcanzar mis metas.",
      "gse4": "Tengo confianza en que podría manejar eficazmente acontecimientos inesperados.",
      "gse5": "Gracias a mis cualidades y recursos puedo superar situaciones imprevistas.",
      "gse6": "Puedo resolver la mayoría de los problemas si me esfuerzo lo necesario.",
      "gse7": "Cuando me encuentro en dificultades puedo permanecer tranquilo/a porque cuento con las habilidades necesarias para manejar situaciones difíciles.",
      "gse8": "Al tener que hacer frente a un problema, generalmente se me ocurren varias alternativas de cómo resolverlo.",
      "gse9": "Si me encuentro en una situación difícil, generalmente se me ocurre qué debo hacer.",
      "gse10": "Venga lo que venga, por lo general soy capaz de manejarlo.",
      "gse_r1": "incorrecto",
      "gse_r2": "apenas cierto",
      "gse_r3": "más bien cierto",
      "gse_r4": "cierto",
      "LANGUAGE": "Español"
    },
    "pt": {
      "gse_qhead": "Por favor, indique o seu nível de concordância com cada uma das seguintes afirmações.",
      "gse1": "Eu consigo resolver sempre os problemas difíceis se eu tentar bastante.",
      "gse2": "Se alguém se opuser, eu posso encontrar os meios e as formas de alcançar o que eu quero.",
      "gse3": "É fácil para mim agarrar-me às minhas intenções e atingir os meus objectivos.",
      "gse4": "Eu estou confiante que poderia lidar, eficientemente, com acontecimentos inesperados.",
      "gse5": "Graças ao meu desembaraço, eu sei como lidar com situações imprevistas.",
      "gse6": "Eu posso resolver a maioria de problemas se eu investir o esforço necessário.",
      "gse7": "Eu posso manter-me calmo ao enfrentar dificuldades porque eu posso confiar nas minhas capacidades para enfrentar as situações.",
      "gse8": "Quando eu sou confrontado com um problema, geralmente eu consigo encontrar diversas soluções.",
      "gse9": "Se eu estiver com problemas, geralmente consigo pensar em algo para fazer.",
      "gse10": "Quando tenho um problema pela frente, geralmente ocorrem-me várias formas para resolvê-lo.",
      "gse_r1": "De modo nenhum é verdade",
      "gse_r2": "Dificilmente é verdade",
      "gse_r3": "Moderadamente verdade",
      "gse_r4": "Exactamente verdade",
      "LANGUAGE": "Português"
    },
    "nl": {
      "gse_qhead": "Geef aan in hoeverre u het eens bent met elk van de volgende uitspraken.",
      "gse1": "Het lukt me altijd moeilijke problemen op te lossen, als ik er genoeg moeite voor doe.",
      "gse2": "Als iemand mij tegenwerkt, vind ik toch manieren om te krijgen wat ik wil.",
      "gse3": "Het is voor mij makkelijk om vast te houden aan mijn plannen en mijn doel te bereiken.",
      "gse4": "Ik vertrouw erop dat ik onverwachte gebeurtenissen doeltreffend aanpak.",
      "gse5": "Dankzij mijn vindingrijkheid weet ik hoe ik in onvoorziene situaties moet handelen.",
      "gse6": "Ik kan de meeste problemen oplossen als ik er de nodige moeite voor doe.",
      "gse7": "Ik blijf kalm als ik voor moeilijkheden kom te staan omdat ik vertrouw op mijn vermogen om problemen op te lossen.",
      "gse8": "Als ik geconfronteerd word met een probleem, heb ik meestal meerdere oplossingen.",
      "gse9": "Als ik in een benarde situatie zit, weet ik meestal wat ik moet doen.",
      "gse10": "Wat er ook gebeurt, ik kom er wel uit.",
      "gse_r1": "volledig onjuist",
      "gse_r2": "nauwelijks juist",
      "gse_r3": "enigszins juist",
      "gse_r4": "volledig juist",
      "LANGUAGE": "Nederlands"
    },
    "it": {
      "gse_qhead": "Indichi il suo livello di accordo con ciascuna delle seguenti affermazioni.",
      "gse1": "Riesco sempre a risolvere problemi difficili se ci provo abbastanza seriamente.",
      "gse2": "Se qualcuno mi contrasta, posso trovare il modo o il sistema di ottenere ciò che voglio.",
      "gse3": "Per me è facile attenermi alle mie intenzioni e raggiungere i miei obiettivi.",
      "gse4": "Ho fiducia di poter affrontare efficacemente eventi inattesi.",
      "gse5": "Grazie alle mie risorse, so come gestire situazioni impreviste.",
      "gse6": "Posso risolvere la maggior parte dei problemi se ci metto il necessario impegno.",
      "gse7": "Rimango calmo nell'affrontare le difficoltà perché posso confidare nelle mie capacità.",
      "gse8": "Quando mi trovo di fronte ad un problema, di solito trovo parecchie soluzioni.",
      "gse9": "Se sono in difficoltà, posso sempre pensare a qualcosa da mettere in atto.",
      "gse10": "Non importa quello che mi può capitare, di solito sono in grado di gestirlo.",
      "gse_r1": "Per nulla vero",
      "gse_r2": "Poco vero",
      "gse_r3": "Abbastanza vero",
      "gse_r4": "Totalmente vero",
      "LANGUAGE": "Italiano"
    },
    "ja": {
      "gse_qhead": "以下の各項目について、あなたの考えに最も近いものをお選びください。",
      "gse1": "私は、一生懸命がんばれば、困難な問題でもいつも解決することができる。",
      "gse2": "私は、誰かが私に反対しても、自分が欲しいものを手にするための手段や道を探すことができる。",
      "gse3": "目的を見失わず、ゴールを達成することは私にとって難しいことではない。",
      "gse4": "予期せぬ出来事に遭遇しても、私は効率よく対処できる自信がある。",
      "gse5": "私は色々な才略に長けているので、思いがけない場面に出くわしても、どうやってきりぬければよいのか分かる。",
      "gse6": "必要な努力さえ惜しまなければ、私はだいたいの問題を解決することができる。",
      "gse7": "自分の物事に対処する能力を信じているので、困難なことに立ち向かっても取り乱したりしない。",
      "gse8": "問題に直面しても、いつもいくつかの解決策を見つけることができる。",
      "gse9": "苦境に陥っても、いつも解決策を考えつく。",
      "gse10": "どんなことが起ころうとも、私はいつもその事に対処することができる。",
      "gse_r1": "全く当てはまらない",
      "gse_r2": "当てはまらない",
      "gse_r3": "まあ当てはまる",
      "gse_r4": "全くその通り",
      "LANGUAGE": "日本語"
    },
    "pl": {
      "gse_qhead": "Proszę wskazać, w jakim stopniu zgadza się Pan/Pani z każdym z poniższych stwierdzeń.",
      "gse1": "Zawsze jestem w stanie rozwiązać trudne problemy, jeśli tylko wystarczająco się postaram.",
      "gse2": "Nawet gdy ktoś mi się sprzeciwia, jestem w stanie znaleźć sposób na osiągnięcie tego, czego chcę.",
      "gse3": "Z łatwością potrafię trzymać się swoich celów i je osiągać.",
      "gse4": "Jestem przekonany, że skutecznie poradziłbym sobie z nieoczekiwanymi wydarzeniami.",
      "gse5": "Dzięki swojej pomysłowości i zaradności wiem, jak poradzić sobie z nieprzewidzianymi sytuacjami.",
      "gse6": "Jestem w stanie rozwiązać większość problemów, jeśli tylko włożę w to odpowiednio dużo wysiłku.",
      "gse7": "Kiedy zmagam się z przeciwnościami, jestem w stanie zachować spokój, gdyż mogę polegać na swoich umiejętnościach radzenia sobie.",
      "gse8": "Kiedy zmagam się z jakimś problemem, to zazwyczaj jestem w stanie znaleźć kilka sposobów jego rozwiązania.",
      "gse9": "Gdy mam kłopoty, to zazwyczaj jestem w stanie wymyślić sposób, jak z nich wyjść.",
      "gse10": "Zazwyczaj jestem w stanie poradzić sobie z tym, co mnie spotyka.",
      "gse_r1": "NIE",
      "gse_r2": "raczej NIE",
      "gse_r3": "raczej TAK",
      "gse_r4": "TAK",
      "LANGUAGE": "Polski"
    },
    "nb": {
      "gse1": "Jeg klarer alltid å løse vanskelige problemer hvis jeg prøver hardt nok.",
      "gse2": "Hvis noen motarbeider meg, så kan jeg finne måter og veier for å få det som jeg vil.",
      "gse3": "Det er lett for meg å holde fast på planene mine og nå målene mine.",
      "gse4": "Jeg føler meg trygg på at jeg ville kunne takle uventede hendelser på en effektiv måte.",
      "gse5": "Takket være ressursene mine så vet jeg hvordan jeg skal takle uventede situasjoner.",
      "gse6": "Jeg kan løse de fleste problemer hvis jeg går tilstrekkelig inn for det.",
      "gse7": "Jeg beholder roen når jeg møter vanskeligheter fordi jeg stoler på mestringsevnen min.",
      "gse8": "Når jeg møter et problem, så finner jeg vanligvis flere løsninger på det.",
      "gse9": "Hvis jeg er i knipe, så finner jeg vanligvis en vei ut.",
      "gse10": "Samme hva som hender så er jeg vanligvis i stand til å takle det.",
      "gse_r1": "Helt galt",
      "gse_r2": "Nokså galt",
      "gse_r3": "Nokså riktig",
      "gse_r4": "Helt riktig",
      "LANGUAGE": "Norsk"
    },
    "da": {
      "gse1": "Jeg kan altid løse vanskelige problemer, hvis jeg prøver ihærdigt nok",
      "gse2": "Hvis nogen modarbejder mig, finder jeg en måde til at opnå det, jeg vil",
      "gse3": "Det er let for mig at holde fast ved mine planer og realisere mine mål",
      "gse4": "Jeg er sikker på, at jeg kan håndtere uventede hændelser",
      "gse5": "Takket være mine personlige ressourcer, ved jeg, hvordan jeg skal klare uforudsete situationer",
      "gse6": "Jeg kan løse de fleste problemer, hvis jeg yder den nødvendige indsats",
      "gse7": "Jeg bevarer roen, når der er problemer, da jeg stoler på mine evner til at løse dem",
      "gse8": "Når jeg støder på et problem, kan jeg som regel finde flere løsninger",
      "gse9": "Hvis jeg er i vanskeligheder, kan jeg som regel finde en udvej",
      "gse10": "Lige meget hvad der sker, kan jeg som regel klare det",
      "gse_r1": "Passer slet ikke",
      "gse_r2": "Passer en smule",
      "gse_r3": "Passer nogenlunde",
      "gse_r4": "Passer præcist",
      "LANGUAGE": "Dansk"
    },
    "sl": {
      "gse1": "Vedno uspem rešiti težave, če se le dovolj potrudim.",
      "gse2": "Tudi kadar mi kdo nasprotuje, najdem načine in poti, da dosežem to, kar želim.",
      "gse3": "Z lahkoto ostajam pri svojih namerah in dosegam svoje cilje.",
      "gse4": "Prepričan sem, da se znam učinkovito spoprijeti z nepričakovanimi dogodki.",
      "gse5": "Zaradi svoje iznajdljivosti se znam spoprijeti z nepredvidljivimi situacijami.",
      "gse6": "Lahko razrešim večino problemov, če si za to dovolj prizadevam.",
      "gse7": "Ko se soočam s težavami, lahko ostanem miren/a zato, ker se znam obvladati.",
      "gse8": "Kadar imam problem, lahko običajno poiščem več rešitev.",
      "gse9": "Če sem v težavah, se zmeraj lahko spomnim kakšne rešitve.",
      "gse10": "Karkoli mi pride na proti, obvladam brez večjih naporov.",
      "gse_r1": "Popolnoma neresnično",
      "gse_r2": "Komaj resnično",
      "gse_r3": "Delno resnično",
      "gse_r4": "Popolnoma resnično",
      "LANGUAGE": "Slovenščina"
    },
    "sr": {
      "gse1": "Ako se dovoljno potrudim, uvek mogu da prebrodim teške probleme.",
      "gse2": "I ako mi se neko suprotstavi, ja mogu da pronađem sredstva i načine da dobijem ono što želim.",
      "gse3": "Lako mi je da dostignem svoje ciljeve i ostvarim svoje namere.",
      "gse4": "Siguran sam da mogu uspešno da izađem na kraj sa neočekivanim događajima.",
      "gse5": "Zahvaljujući mojoj snalažljivosti, ja znam kako da savladam nepredviđene situacije.",
      "gse6": "Ja mogu rešiti većinu problema ako uložim dovoljno napora.",
      "gse7": "Mogu ostati pribran kada se susretnem sa poteškoćama, jer znam da mogu da se oslonim na svoje sposobnosti.",
      "gse8": "Kad se suočim sa problemom, ja obično nađem nekoliko rešenja.",
      "gse9": "I kada sam u nevolji, obično mogu da smislim rešenje.",
      "gse10": "Ja obično mogu da izađem na kraj sa svim što mi se nađe na putu.",
      "gse_r1": "potpuno netačno",
      "gse_r2": "delimično netačno",
      "gse_r3": "delimično tačno",
      "gse_r4": "potpuno tačno",
      "LANGUAGE": "Српски"
    },
    "ru": {
      "gse1": "Если я как следует постараюсь, то я всегда найду решение даже сложным проблемам.",
      "gse2": "Если мне что-либо мешает, то я всё же нахожу пути достижения своей цели.",
      "gse3": "Мне довольно просто удается достичь своих целей.",
