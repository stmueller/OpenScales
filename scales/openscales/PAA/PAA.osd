        "dimension": "autonomy"
      },
      {
        "id": "paa3",
        "type": "likert",
        "text_key": "paa3",
        "dimension": "autonomy"
      },
      {
        "id": "paa4",
        "type": "likert",
        "text_key": "paa4",
        "dimension": "autonomy"
      }
    ],
    "scoring": {
      "autonomy": {
        "name": "Perceived Autonomy",
        "method": "mean_coded",
        "description": "Mean of paa1-4 (1-4).",
        "items": [
          "paa1",
          "paa2",
          "paa3",
          "paa4"
        ]
      }
    }
  },
  "translations": {
    "en": {
      "r1": "not at all true",
      "r2": "rather not true",
      "r3": "somewhat true",
      "r4": "definitely true",
      "qh": "Please indicate how true each of the following statements is for you.",
      "paa1": "I live by my own choices now that I am old.",
      "paa2": "I make my own decisions and don't need others to protect me.",
      "paa3": "I organize my life according to my own ideas.",
      "paa4": "I cope with my daily life without outside help.",
      "LANGUAGE": "English"
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "paa1": "Ich komme im Alter gut allein zurecht.",
      "paa2": "Ich treffe meine eigenen Entscheidungen und lasse mich nicht von anderen Menschen bevormunden.",
      "paa3": "Ich gestalte mein Leben nach meinen eigenen Vorstellungen.",
      "paa4": "Ich bewältige meinen Alltag ohne fremde Hilfe.",
      "LANGUAGE": "Deutsch"
    }
  }
}