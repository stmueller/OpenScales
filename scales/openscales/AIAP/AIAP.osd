{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "AIAP",
      "name": "AI Attitudes and Perceptions Scale",
      "abbreviation": "AIAP",
      "description": "Multi-factor instrument measuring perceptions of and attitudes toward AI across 9 subscales: Transparency (4 items), Intelligence (8 items), Interdependence (4 items), Autonomy (5 items), Conspiracy Beliefs (10 items), Threat to Self (3 items), Threat to Society (3 items), Lack of Control (2 items), and Powerlessness (3 items). Each subscale is toggled via a show_* parameter; section-level visible_when hides the entire block when disabled.",
      "citation": "Zhao, Q., van Prooijen, J. W., Jiang, X., & Spadaro, G. (2025). Suspicious of AI? Perceived autonomy and interdependence predict AI-related conspiracy beliefs. British Journal of Social Psychology, 64(2). https://doi.org/10.1111/bjso.12883",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.1111/bjso.12883",
      "version": "1.0",
      "domain": "Technology"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default": 0,
        "description": "Randomize item presentation order within sections"
      },
      "show_transparency": {
        "type": "boolean",
        "default": 1,
        "description": "Include Transparency of AI subscale (4 items)"
      },
      "show_intelligence": {
        "type": "boolean",
        "default": 1,
        "description": "Include Intelligence of AI subscale (8 items)"
      },
      "show_interdependence": {
        "type": "boolean",
        "default": 1,
        "description": "Include Interdependence of AI subscale (4 items)"
      },
      "show_autonomy": {
        "type": "boolean",
        "default": 1,
        "description": "Include Autonomy of AI subscale (5 items)"
      },
      "show_conspiracy": {
        "type": "boolean",
        "default": 1,
        "description": "Include AI Conspiracy Beliefs subscale (10 items)"
      },
      "show_threat_self": {
        "type": "boolean",
        "default": 1,
        "description": "Include Perceived Threat to Self subscale (3 items)"
      },
      "show_threat_society": {
        "type": "boolean",
        "default": 1,
        "description": "Include Perceived Threat to Society subscale (3 items)"
      },
      "show_lack_control": {
        "type": "boolean",
        "default": 1,
        "description": "Include Lack of Control subscale (2 items)"
      },
      "show_powerlessness": {
        "type": "boolean",
        "default": 1,
        "description": "Include Powerlessness subscale (3 items)"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "AIAP_ra1",
        null,
        null,
        null,
        null,
        null,
        "AIAP_ra7"
      ],
      "question_head": "AIAP_head_agree"
    },
    "dimensions": [
      {
        "id": "Transparency",
        "name": "Transparency",
        "description": "Perceived transparency of AI decision-making for lay people"
      },
      {
        "id": "Intelligence",
        "name": "Intelligence",
        "description": "Perceived AI intelligence relative to humans"
      },
      {
        "id": "Interdependence",
        "name": "Interdependence",
        "description": "Perceived alignment of AI and human interests"
      },
      {
        "id": "Autonomy",
        "name": "Autonomy",
        "description": "Perceived ability of AI to operate independently of humans"
      },
      {
        "id": "Conspiracy",
        "name": "Conspiracy",
        "description": "Belief that AI is used for surveillance, manipulation, or control by powerful groups"
      },
      {
        "id": "ThreatSelf",
        "name": "Threat to Self",
        "description": "Perceived personal threat from AI"
      },
      {
        "id": "ThreatSociety",
        "name": "Threat to Society",
        "description": "Perceived societal threat from AI"
      },
      {
        "id": "LackControl",
        "name": "Lack of Control",
        "description": "Perceived loss of control over important life domains due to AI"
      },
      {
        "id": "Powerlessness",
        "name": "Powerlessness",
        "description": "Feelings of powerlessness, hopelessness, and helplessness due to AI"
      }
    ],
