    "sr": {
      "cb_head": "U kojoj meri se slažete ili ne slažete sa sledećim tvrdnjama?",
      "secgrdec": "Jedna mala tajna grupa ljudi je odgovorna za donošenje svih bitnih odluka u svetskoj politici.",
