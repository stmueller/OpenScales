      "circumstances_of_hip_fracture": "CIRCUMSTANCES OF HIP FRACTURE:",
      "circumstances_of_hip_fracture_opt_1": "Fall from standing height or less",
      "circumstances_of_hip_fracture_opt_2": "Motor vehicle accident or fall from greater than standing height",
      "circumstances_of_hip_fracture_opt_3": "Other",
      "circumstances_of_hip_fracture_opt_9": "Unknown",
