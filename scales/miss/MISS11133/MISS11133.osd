      "durel_nora_0": "Nunca o raras veces",
      "durel_nora_1": "Pocas veces al año",
      "durel_nora_2": "Pocas veces al mes",
      "durel_nora_3": "Pocas veces a la semana",
      "durel_nora_4": "Una vez al día",
      "durel_nora_5": "Más de una vez al día",
