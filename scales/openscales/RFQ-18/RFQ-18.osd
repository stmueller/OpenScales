  "translations": {
    "en": {
      "instructions": "Please work through the statements. For each, choose a number between 1 (strongly disagree) and 7 (strongly agree). Do not think too much about it — your initial responses are usually the best. Thank you.",
      "question_head": "",
      "debrief": "Thank you for completing this questionnaire.",
      "LANGUAGE": "English",
      "rfq18_r1": "Strongly Disagree",
      "rfq18_r2": "",
      "rfq18_r3": "",
      "rfq18_r4": "",
      "rfq18_r5": "",
      "rfq18_r6": "",
      "rfq18_r7": "Strongly Agree",
      "rfq18_1": "I always know what I feel",
      "rfq18_2": "I often get confused about what I am feeling",
      "rfq18_3": "I don’t always know why I do what I do",
      "rfq18_4": "When I get angry I say things without really knowing why I am saying them",
      "rfq18_5": "Strong feelings often cloud my thinking",
      "rfq18_6": "I trust my feelings",
      "rfq18_7": "If I feel insecure I can behave in ways that put others’ backs up",
      "rfq18_8": "I pay attention to my feelings",
      "rfq18_9": "In an argument, I keep the other person’s point of view in mind",
      "rfq18_10": "People’s thoughts are a mystery to me",
      "rfq18_11": "It’s easy for me to figure out what someone else is thinking or feeling",
      "rfq18_12": "It takes me a long time to understand other people’s thoughts and feelings",
      "rfq18_13": "I know exactly what my close friends are thinking",
      "rfq18_14": "Understanding what’s on someone else’s mind is never difficult for me",
      "rfq18_15": "It’s really hard for me to figure out what goes on in other people’s heads",
      "rfq18_16": "Other people’s thoughts and feelings are confusing to me",
      "rfq18_17": "I can mostly predict what someone else will do",
      "rfq18_18": "I am a good mind reader"
    },
    "ko": {
      "instructions": "아래의 각 문항을 잘 읽은 후, 평소 자신을 잘 나타내는 곳에 \"O\"표를 해 주십시오.",
      "question_head": "",
      "debrief": "설문에 응해 주셔서 감사합니다.",
      "LANGUAGE": "한국어",
      "rfq18_r1": "전혀 그렇지 않다",
      "rfq18_r2": "거의 그렇지 않다",
      "rfq18_r3": "별로 그렇지 않다",
      "rfq18_r4": "보통이다",
      "rfq18_r5": "조금 그렇다",
      "rfq18_r6": "거의 그렇다",
      "rfq18_r7": "매우 그렇다",
      "rfq18_1": "나는 항상 내가 느끼는 감정이 무엇인지 안다.",
      "rfq18_2": "가끔 내가 어떤 기분인지 혼란스럽다.",
      "rfq18_3": "내가 왜, 어떤 행동을 했는지 항상 알지는 못한다.",
      "rfq18_4": "화가 나면, 무슨 말을 하는지도 모른 채 말을 한다.",
      "rfq18_5": "종종 격한 감정이 일어나 생각이 흐려진다.",
      "rfq18_6": "나는 내 느낌을 믿는다.",
      "rfq18_7": "불안해지면, 다른 사람을 짜증나게끔 행동 하곤 한다.",
      "rfq18_8": "내 감정에 주의를 기울인다.",
      "rfq18_9": "어떤 주장을 할 때 다른 사람은 어떻게 생각할지 마음을 쓴다.",
      "rfq18_10": "사람들의 생각은 내게 알 수 없는 수수께끼 같다.",
      "rfq18_11": "사람들이 무슨 생각을 하고 어떻게 느끼는지 알아내기란 쉬운 일이다.",
      "rfq18_12": "사람들의 생각과 감정을 이해하는 데 시간이 오래 걸린다.",
      "rfq18_13": "친한 친구들이 무슨 생각을 하는지 정확하게 알 수 있다.",
      "rfq18_14": "다른 사람의 마음을 이해하는 일이 나에게는 결코 어렵지 않다.",
      "rfq18_15": "다른 사람의 머릿속에 무슨 일이 일어나는지 알아내기란 정말 힘든 일이다.",
      "rfq18_16": "다른 사람이 어떻게 생각하고 느끼는지 헷갈릴 때가 많다.",
      "rfq18_17": "사람들이 무슨 일을 하려고 하는지 대부분 예측할 수 있다.",
      "rfq18_18": "남의 마음을 곧잘 읽는다."
    }
  }
}