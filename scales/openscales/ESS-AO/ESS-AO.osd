      "loylead": "أكثر ما تحتاجه إسرائيل هو الولاء لقادتها.",
      "ao_r1": "جدا موافق/ة",
      "ao_r2": "موافق/ة",
      "ao_r3": "بالوسط، موافق/ة وغير موافق/ة",
