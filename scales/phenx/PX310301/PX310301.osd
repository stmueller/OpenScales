{
  "scale_info": {
    "name": "Awareness of Pharmacogenomics",
    "code": "PX310301",
    "abbreviation": "PX310301",
    "description": "This series of questions can be used to determine an individual’s knowledge of pharmacogenomics (PGx) and if the individual is willing to participate in PGx research. It is beneficial for patients to understand that genetic traits may influence the effects of medications and that clinicians are usin",
    "domain": "Genomics & Genetics",
    "citation": "Vermeulen, E., Henneman, L., van El, C. G., & Cornel, M. C. (2014). Public attitudes towards preventive genomics and personal interest in genetic testing to prevent disease: a survey study. European Journal of Public Health, 24(5), 768–775. [PhenX: https://www.phenxtoolkit.org/protocols/view/310301]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/310301"
  },
