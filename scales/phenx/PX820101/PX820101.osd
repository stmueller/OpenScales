{
  "scale_info": {
    "name": "Quality of Care - Adults",
    "code": "PX820101",
    "abbreviation": "PX820101",
    "description": "The Adult Sickle Cell Quality of Life Measurement Information System (ASCQ-Me) Quality of Care Module is a set of 27 questions administered to adults with sickle cell disease (SCD) to determine the quality of care that they have received from health care providers.",
    "domain": "Sickle Cell Disease - Quality of Life",
    "citation": "Treadwell, M. J., Hassell, K., Levine, R., & Keller, S. (2014). Adult Sickle Cell Quality-of-Life Measurement Information System (ASCQ-Me): Conceptual model based on review of the literature and formative research. The Clinical Journal of Pain, 30 (10), 902-914. doi:10.1097/ajp.0000000000000054 [PhenX: https://www.phenxtoolkit.org/protocols/view/820101]",
    "license": "PhenX Toolkit freely available protocol",
    "version": "1.0",
    "url": "https://www.phenxtoolkit.org/protocols/view/820101"
  },
