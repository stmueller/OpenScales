    "scale_info": {
      "code": "IPIP-JPI",
      "name": "IPIP JPI",
      "abbreviation": "IPIP-JPI",
      "description": "Meta-scale aggregating all 15 IPIP-JPI subscales. Each subscale is a separate section controlled by a boolean parameter. Intended primarily for translation and bulk administration.",
