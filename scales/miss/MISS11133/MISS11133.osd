{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Duke University Religion Index",
      "code": "MISS11133",
      "abbreviation": "DUREL",
      "description": "A 5-item index measuring religious involvement across two subscales: Religious Activity (ORA: organizational religious activity/attendance; NORA: non-organizational religious activity/private practice) and Intrinsic Religiosity (IR1–IR3: internalized religious motivation). Items use different response scales: ORA and NORA use 6-point frequency scales (0–5); IR items use a 5-point truth scale (1–5). Subscale scores are summed; higher scores indicate greater religious involvement. Originally validated in a US clinical population (Koenig et al. 1997). Psychometric properties in cross-cultural samples reported by Toscanelli et al. (2022).",
      "citation": "Toscanelli, C., Rezende, A. T., Pinto, J. M. de S., Branco, J. C., & Marques, L. F. (2022). Measurement of religiosity and spirituality: A cross-cultural validation study of the Duke University Religion Index (DUREL). Measurement Instruments for the Social Sciences, 4, Article e11133. https://doi.org/10.5964/miss.11133",
      "license": "Free for any use",
      "license_url": "https://psychometriglossia.uoregon.edu/",
      "url": "https://doi.org/10.5964/miss.11133",
      "domain": "Social",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-08",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Items and translations sourced from Psychometriglossia (https://psychometriglossia.uoregon.edu/), which states: 'You are welcome to download, peruse, edit, and use these measures in any way you see fit.' Original English items from Koenig, H. G., Meador, K. G., & Parkerson, G. (1997). Religion index for psychiatric research. American Journal of Psychiatry, 154, 885–886. ORA and NORA use 6-point frequency scales (0=Never to 5=More than once a week/day). IR items use 5-point truth scale (1=Definitely untrue to 5=Definitely true). Scoring: ORA+NORA summed (range 0–10); IR1+IR2+IR3 summed (range 3–15); Total all 5 summed (range 3–25). Psychometriglossia distributes two survey versions (A and B) that differ in overall survey length but contain identical DUREL items. Translations for French, Italian, Brazilian Portuguese, Urdu, and Vietnamese were not completed in the source XLS files and are excluded. Polish IR3 appears at a non-contiguous row due to formatting; item text confirmed correct."
    },
    "dimensions": [
      {
        "id": "ra",
        "name": "Religious Activity",
        "abbreviation": "RA",
        "description": "Organizational and non-organizational religious activity. ORA (item 1): attendance at religious services; NORA (item 2): private religious practices. Sum of ORA+NORA, range 0–10; higher = greater religious activity."
      },
      {
        "id": "ir",
        "name": "Intrinsic Religiosity",
        "abbreviation": "IR",
        "description": "Internalized religious motivation — the degree to which religion is a central organizing principle of life. Sum of IR1+IR2+IR3, range 3–15; higher = stronger intrinsic religiosity."
      }
    ],
