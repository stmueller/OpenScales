{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Teacher Self-Efficacy Scale",
      "code": "TSES",
      "abbreviation": "TSES",
      "description": "10-item Teacher Self-Efficacy Scale (Schwarzer et al.). Rated 1-4 (not at all true..exactly true). No reverse-coded items.",
      "citation": "Schwarzer, R., Schmitz, G. S., & Daytner, G. T. (1999). The Teacher Self-Efficacy Scale [measurement instrument]. http://userpage.fu-berlin.de/~health/teacher_se.htm",
      "license": "CC BY 4.0",
      "license_explanation": "Licensed to the OpenScales project under CC BY 4.0 by the author, Ralf Schwarzer (permission granted June 2026), who authorized inclusion of his scales. Items reproduced from the authors' official documentation (userpage.fu-berlin.de/~gesund/skalen/ and userpage.fu-berlin.de/~health/).",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "http://userpage.fu-berlin.de/~health/teacher_se.htm",
      "domain": "Education",
      "version": "1.0"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-17",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "notes": "Bilingual+ Teacher Self-Efficacy. ITEM 7 IS A LANGUAGE VARIANT (variant_when, selector language): English & Brazilian-Portuguese use the positively-worded form (forward); German & Turkish use the officially negatively-worded, reverse-scored form ('...weiß ich, daß ich nicht viel ausrichten kann' / '...inanmıyorum'). This restores the OFFICIAL German item 7 (the earlier build used a positive German rendering). Other 9 items shared. EN (Schwarzer/Schmitz/Daytner 1999), DE (skalen), pt-BR (Schwarzer/Schmitz/Bellico da Costa 1999), tr (Schwarzer/Schmitz/Balta 2000; transcribed from page images, encoding-normalized — VERIFY). Sum 10-40."
    },
    "likert_options": {
      "points": 4,
      "min": 1,
      "max": 4,
      "labels": [
        "tse_r1",
        "tse_r2",
        "tse_r3",
        "tse_r4"
      ],
      "question_head": "tse_qhead"
    },
    "dimensions": [
      {
        "id": "teacher_self_efficacy",
        "name": "Teacher Self-Efficacy",
        "abbreviation": "TSES",
        "description": "Unidimensional teacher self-efficacy; sum of 10 items (range 10-40)."
      }
    ],
