  "translations": {
    "en": {
      "r1": "not at all true",
      "r2": "barely true",
      "r3": "moderately true",
      "r4": "exactly true",
      "qh": "Indicate how true each of the following statements is for you.",
      "LANGUAGE": "English",
      "pc_en1": "I am a \"take charge\" person.",
      "pc_en2": "I try to let things work out on their own.",
      "pc_en3": "After attaining a goal, I look for another, more challenging one.",
      "pc_en4": "I like challenges and beating the odds.",
      "pc_en5": "I visualize my dreams and try to achieve them.",
      "pc_en6": "Despite numerous setbacks, I usually succeed in getting what I want.",
      "pc_en7": "I try to pinpoint what I need to succeed.",
      "pc_en8": "I always try to find a way to work around obstacles; nothing really stops me.",
      "pc_en9": "I often see myself failing so I don't get my hopes up too high.",
      "pc_en10": "When I apply for a position, I imagine myself filling it.",
      "pc_en11": "I turn obstacles into positive experiences.",
      "pc_en12": "If someone tells me I can't do something, you can be sure I will do it.",
      "pc_en13": "When I experience a problem, I take the initiative in resolving it.",
      "pc_en14": "When I have a problem, I usually see myself in a no-win situation."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "LANGUAGE": "Deutsch",
      "pc1": "Habe ich ein Ziel erreicht, dann suche ich mir eine größere Herausforderung.",
      "pc2": "Mir kommt es immer darauf an, etwas zu bewirken.",
      "pc3": "In brenzligen Situationen habe ich oft das Gefühl, auf verlorenem Posten zu stehen.",
      "pc4": "Ich ziehe aus alltäglichen Schwierigkeiten wichtige Erfahrungen, um mein Leben besser zu gestalten.",
      "pc5": "Ich male mir meine Wunschträume genau aus, um sie zu verwirklichen.",
      "pc6": "Ich möchte mit dem, was ich tue, etwas Wichtiges in dieser Welt bewegen.",
      "pc7": "Wenn ich mir etwas vorgenommen habe, kann mich nichts mehr aufhalten.",
      "pc8": "Wenn die Dinge nicht so gut laufen, warte ich lieber, bis sie sich von selbst regeln.",
      "pc9": "Ich konzentriere mich für meinen Erfolg auf das, was ich für wesentlich halte und lasse mich dabei nicht ablenken.",
      "pc10": "Ich denke immer daran, was man wohl noch verbessern könnte.",
      "pc11": "Ich arbeite mich nach oben, auch wenn der Weg oft steinig ist.",
      "pc12": "Ich übernehme gerne Verantwortung und ziehe dabei oft für andere „den Karren aus dem Dreck\".",
      "pc13": "Wenn es „hart auf hart kommt\", nehme ich die Sache in die Hand und finde einen Weg.",
      "pc14": "Ich baue nur auf sicherem Boden und lasse die Finger von Experimenten.",
      "pc15": "Ich stecke meine Ziele nicht allzu hoch, weil ich oft befürchte, daß ich scheitere.",
      "pc16": "Ich habe Freude daran, die Qualität meiner Arbeit zu verbessern.",
      "pc17": "Ich suche mir gern Herausforderungen und gehe dafür auch Wagnisse ein."
    },
    "es": {
      "r1": "Totalmente en desacuerdo",
      "r2": "Poco de acuerdo",
      "r3": "Moderadamente de acuerdo",
      "r4": "Totalmente de acuerdo",
      "qh": "Seguidamente se presentan un grupo de afirmaciones que podrían describir la forma en que usted reacciona ante situaciones de la vida. Por favor, indique cuán ciertas son cada una de estas oraciones para su persona.",
      "LANGUAGE": "Español",
      "pc1": "Una vez alcanzada una meta voy en busca de retos más grandes.",
      "pc2": "Siempre estoy planteándome situaciones para llegar a lograr algo más.",
      "pc3": "Cuando enfrento situaciones difíciles, muchas veces me siento como si estuviera perdido.",
      "pc4": "Siempre me baso en mis logros y vivencias previas para perfeccionarme en la vida.",
      "pc5": "Cuando quiero realizar mis sueños, me los imagino y me concentro en ellos.",
      "pc6": "Deseo que las cosas que realizo dejen una huella en la vida de los demás.",
      "pc7": "Una vez que me defino un propósito determinado, no me detengo hasta alcanzarlo.",
      "pc8": "Cuando las cosas salen mal, entonces prefiero esperar a que se resuelvan por si mismas.",
      "pc9": "Siempre dedico esfuerzos considerables a las cosas que me parecen relevantes sin dejar distraerme por lo demás.",
      "pc10": "Vivo pensando en las cosas que podría mejorar.",
      "pc11": "Sigo mi camino hacia arriba aunque sea duro.",
      "pc12": "Siempre asumo la responsabilidad de las cosas y además me involucro en solucionar los problemas que otros han causado.",
      "pc13": "Cuando se me viene una dificultad tras otra, entonces prefiero \"agarrar el toro por los cuernos\" y busco la mejor solución.",
      "pc14": "Siempre me inclino a construir en suelo firme e ir a lo seguro, en vez de experimentar con las cosas.",
      "pc15": "Prefiero definirme metas que son de poca dificultad, porque cuando éstas son muy altas, entonces me invade un temor al fracaso.",
      "pc16": "Me encanta mejorar la calidad de mi trabajo.",
      "pc17": "Me fascinan los retos y no me importa tener que correr riesgos."
    }
  }
}