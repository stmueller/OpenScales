  "translations": {
    "en": {
      "r1": "not at all true",
      "r2": "barely true",
      "r3": "somewhat true",
      "r4": "completely true",
      "qh": "The following statements deal with reactions you may have to various situations. Indicate how true each statement is for you.",
      "LANGUAGE": "English",
      "pci_en_proactive1": "I am a \"take charge\" person.",
      "pci_en_proactive2": "I try to let things work out on their own.",
      "pci_en_proactive3": "After attaining a goal, I look for another, more challenging one.",
      "pci_en_proactive4": "I like challenges and beating the odds.",
      "pci_en_proactive5": "I visualise my dreams and try to achieve them.",
      "pci_en_proactive6": "Despite numerous setbacks, I usually succeed in getting what I want.",
      "pci_en_proactive7": "I try to pinpoint what I need to succeed.",
      "pci_en_proactive8": "I always try to find a way to work around obstacles; nothing really stops me.",
      "pci_en_proactive9": "I often see myself failing so I don't get my hopes up too high.",
      "pci_en_proactive10": "When I apply for a position, I imagine myself filling it.",
      "pci_en_proactive11": "I turn obstacles into positive experiences.",
      "pci_en_proactive12": "If someone tells me I can't do something, you can be sure I will do it.",
      "pci_en_proactive13": "When I experience a problem, I take the initiative in resolving it.",
      "pci_en_proactive14": "When I have a problem, I usually see myself in a no-win situation.",
      "pci_en_reflective1": "I imagine myself solving difficult problems.",
      "pci_en_reflective2": "Rather than acting impulsively, I usually think of various ways to solve a problem.",
      "pci_en_reflective3": "In my mind I go through many different scenarios in order to prepare myself for different outcomes.",
      "pci_en_reflective4": "I tackle a problem by thinking about realistic alternatives.",
      "pci_en_reflective5": "When I have a problem with my co-workers, friends, or family, I imagine beforehand how I will deal with them successfully.",
      "pci_en_reflective6": "Before tackling a difficult task I imagine success scenarios.",
      "pci_en_reflective7": "I take action only after thinking carefully about a problem.",
      "pci_en_reflective8": "I imagine myself solving a difficult problem before I actually have to face it.",
      "pci_en_reflective9": "I address a problem from various angles until I find the appropriate action.",
      "pci_en_reflective10": "When there are serious misunderstandings with co-workers, family members or friends, I practice before how I will deal with them.",
      "pci_en_reflective11": "I think about every possible outcome to a problem before tackling it.",
      "pci_en_strategic1": "I often find ways to break down difficult problems into manageable components.",
      "pci_en_strategic2": "I make a plan and follow it.",
      "pci_en_strategic3": "I break down a problem into smaller parts and do one part at a time.",
      "pci_en_strategic4": "I make lists and try to focus on the most important things first.",
      "pci_en_preventive1": "I plan for future eventualities.",
      "pci_en_preventive2": "Rather than spending every cent I make, I like to save for a rainy day.",
      "pci_en_preventive3": "I prepare for adverse events.",
      "pci_en_preventive4": "Before disaster strikes I am well-prepared for its consequences.",
      "pci_en_preventive5": "I plan my strategies to change a situation before I act.",
      "pci_en_preventive6": "I develop my job skills to protect myself against unemployment.",
      "pci_en_preventive7": "I make sure my family is well taken care of to protect them from adversity in the future.",
      "pci_en_preventive8": "I think ahead to avoid dangerous situations.",
      "pci_en_preventive9": "I plan strategies for what I hope will be the best possible outcome.",
      "pci_en_preventive10": "I try to manage my money well in order to avoid being destitute in old age.",
      "pci_en_instrumental1": "When solving my own problems other people's advice can be helpful.",
      "pci_en_instrumental2": "I try to talk and explain my stress in order to get feedback from my friends.",
      "pci_en_instrumental3": "Information I get from others has often helped me deal with my problems.",
      "pci_en_instrumental4": "I can usually identify people who can help me develop my own solutions to problems.",
      "pci_en_instrumental5": "I ask others what they would do in my situation.",
      "pci_en_instrumental6": "Talking to others can be really useful because it provides another perspective on the problem.",
      "pci_en_instrumental7": "Before getting messed up with a problem I'll call a friend to talk about it.",
      "pci_en_instrumental8": "When I am in trouble I can usually work out something with the help of others.",
      "pci_en_emotional1": "If I am depressed I know who I can call to help me feel better.",
      "pci_en_emotional2": "Others help me feel cared for.",
      "pci_en_emotional3": "I know who can be counted on when the chips are down.",
      "pci_en_emotional4": "When I'm depressed I get out and talk to others.",
      "pci_en_emotional5": "I confide my feelings in others to build up and maintain close relationships.",
      "pci_en_avoidance1": "When I have a problem I like to sleep on it.",
      "pci_en_avoidance2": "If I find a problem too difficult sometimes I put it aside until I'm ready to deal with it.",
      "pci_en_avoidance3": "When I have a problem I usually let it simmer on the back burner for a while."
    },
    "de": {
      "r1": "stimmt nicht",
      "r2": "stimmt kaum",
      "r3": "stimmt eher",
      "r4": "stimmt genau",
      "qh": "Hier geht es um Ihre persönlichen Einschätzungen und Gefühle. Bitte kreuzen Sie immer diejenige Antwortalternative an, mit der Sie am ehesten übereinstimmen. Antworten Sie spontan, ohne längeres Zögern.",
      "LANGUAGE": "Deutsch",
      "pci_de_proaktiv1": "Habe ich ein Ziel erreicht, dann suche ich mir eine größere Herausforderung.",
      "pci_de_proaktiv2": "In brenzligen Situationen habe ich oft das Gefühl, auf verlorenem Posten zu stehen.",
      "pci_de_proaktiv3": "Ich ziehe aus alltäglichen Schwierigkeiten wichtige Erfahrungen, um mein Leben besser zu gestalten.",
      "pci_de_proaktiv4": "Ich male mir meine Wunschträume genau aus, um sie zu verwirklichen.",
      "pci_de_proaktiv5": "Ich möchte mit dem, was ich tue, etwas Wichtiges in dieser Welt bewegen.",
      "pci_de_proaktiv6": "Wenn ich mir etwas vorgenommen habe, kann mich nichts mehr aufhalten.",
      "pci_de_proaktiv7": "Wenn die Dinge nicht so gut laufen, warte ich lieber, bis sie sich von selbst regeln.",
      "pci_de_proaktiv8": "Ich konzentriere mich für meinen Erfolg auf das, was ich für wesentlich halte und lasse mich dabei nicht ablenken.",
      "pci_de_proaktiv9": "Ich denke immer daran, was man wohl noch verbessern könnte.",
      "pci_de_proaktiv10": "Ich arbeite mich nach oben, auch wenn der Weg oft steinig ist.",
      "pci_de_proaktiv11": "Ich übernehme gerne Verantwortung und ziehe dabei oft für andere „den Karren aus dem Dreck\".",
      "pci_de_proaktiv12": "Wenn es „hart auf hart kommt\", nehme ich die Sache in die Hand und finde einen Weg.",
      "pci_de_proaktiv13": "Ich baue nur auf sicherem Boden und lasse die Finger von Experimenten.",
      "pci_de_proaktiv14": "Ich stecke meine Ziele nicht allzu hoch, weil ich oft befürchte, daß ich scheitere.",
      "pci_de_proaktiv15": "Ich habe Freude daran, die Qualität meiner Arbeit zu verbessern.",
      "pci_de_proaktiv16": "Ich suche mir gern Herausforderungen und gehe dafür auch Wagnisse ein.",
      "pci_de_handlungsaufschub1": "Wenn ich ein Problem habe, schlafe ich erst einmal eine Nacht darüber.",
      "pci_de_handlungsaufschub2": "Wenn mir ein Problem zu schwierig erscheint, dann lasse ich es so lange ruhen, bis ich mich ihm gewachsen fühle.",
      "pci_de_handlungsaufschub3": "Wenn ich ein Problem habe, lasse ich es erst einmal auf kleiner Flamme köcheln, bevor ich es anpacke.",
      "pci_de_kognitiv1": "Ich traue mir zu, schwierige Probleme zu lösen.",
      "pci_de_kognitiv2": "Anstatt voreilig zu handeln, überlege ich mir normalerweise verschiedene Lösungsmöglichkeiten für ein Problem.",
      "pci_de_kognitiv3": "Ich male mir verschiedene Handlungsweisen aus, um für alles gewappnet zu sein.",
      "pci_de_kognitiv4": "Ich gehe ein Problem an, indem ich mir verschiedene Handlungsmöglichkeiten überlege.",
      "pci_de_kognitiv5": "Wenn ich ein Problem mit Kollegen, Freunden oder meiner Familie habe, mache ich mir zunächst Gedanken, wie ich erfolgreich damit umgehen kann.",
      "pci_de_kognitiv6": "Bevor ich ein Problem anpacke, stelle ich mir erfolgreiche Problemlösungen vor.",
      "pci_de_kognitiv7": "Ich handle erst, nachdem ich mir sorgfältig Gedanken über das Problem gemacht habe.",
      "pci_de_kognitiv8": "Ich stelle mir schon vor, wie ich ein schwieriges Problem löse, bevor es überhaupt auftritt.",
      "pci_de_kognitiv9": "Ich betrachte ein Problem von verschiedenen Seiten, bevor ich den richtigen Lösungsweg finde.",
      "pci_de_kognitiv10": "Wenn ich Konflikte mit meinen Kollegen, Familienmitgliedern oder Freunden habe, spiele ich zunächst einmal durch, wie ich mich ihnen gegenüber verhalten werde.",
      "pci_de_kognitiv11": "Bevor ich etwas in Gang bringe, stelle ich mir alle möglichen Konsequenzen vor.",
      "pci_de_praeventiv1": "Ich treffe Vorkehrungen für die Zukunft.",
      "pci_de_praeventiv2": "Ehe ich mein Geld zum Fenster hinauswerfe, spare ich es für schlechte Zeiten.",
      "pci_de_praeventiv3": "Ich wappne mich frühzeitig gegen mögliche Schicksalsschläge.",
      "pci_de_praeventiv4": "Schon bevor etwas Schlimmes eintritt, bin ich auf die Folgen gut vorbereitet.",
      "pci_de_praeventiv5": "Wenn ich etwas vorhabe, sehe ich mein Ziel klar vor Augen.",
      "pci_de_praeventiv6": "Ich nutze jede Gelegenheit zur Weiterbildung, um dem beruflichen Abstieg vorzubeugen.",
      "pci_de_praeventiv7": "Ich kümmere mich darum, dass meine Angehörigen in der Zukunft gut versorgt sind.",
      "pci_de_praeventiv8": "Ich mache mir Gedanken darüber, wie ich Gefahren am besten aus dem Weg gehe.",
      "pci_de_praeventiv9": "Ich bin darauf bedacht, mögliche Krisen zum Guten zu wenden.",
      "pci_de_praeventiv10": "Ich versuche, mein Geld so anzulegen, dass es mir im Alter an nichts fehlt.",
      "pci_de_strategisch1": "Bei einer umfangreichen Aufgabe neige ich dazu, aus einem großen Packet viele kleine Päckchen zu schnüren.",
      "pci_de_strategisch2": "Ich mache einen Plan und gehe danach vor.",
      "pci_de_strategisch3": "Ich löse Probleme Schritt für Schritt.",
      "pci_de_strategisch4": "Ich mache mir einen Plan und konzentriere mich zuerst auf die wesentlichsten Dinge.",
      "pci_de_emotionale_us1": "Wenn ich niedergeschlagen bin, treffe ich mich mit Leuten, damit sie mich aufmuntern.",
      "pci_de_emotionale_us2": "Ich suche Unterstützung bei anderen.",
      "pci_de_emotionale_us3": "Ich weiß, auf wen ich zählen kann, wenn es darauf ankommt.",
      "pci_de_emotionale_us4": "Wenn ich niedergeschlagen bin, suche ich das Gespräch mit anderen.",
      "pci_de_emotionale_us5": "Um enge Beziehungen aufzubauen und aufrechtzuerhalten, vertraue ich anderen meine Gefühle an.",
      "pci_de_us1": "Wenn es kritisch wird, hole ich mir gerne Rat von anderen.",
      "pci_de_us2": "Bevor mir meine Probleme über den Kopf wachsen, versuche ich, meine Gedanken mit Hilfe meiner Freunde zu ordnen.",
      "pci_de_us3": "Nützliche Tipps von anderen haben mir schon oft dabei geholfen, mit meinen Problemen umzugehen.",
      "pci_de_us4": "Ich habe einen guten Blick dafür, wer mir bei bestimmten Problemen auf die Sprünge helfen kann.",
      "pci_de_us5": "Ich frage andere, was sie an meiner Stelle tun würden.",
      "pci_de_us6": "Es hilft mir, wenn andere Leute ihre Sichtweise meines Problems darstellen.",
      "pci_de_us7": "Wenn mich etwas überfordert, sehe ich mich nach tatkräftiger Unterstützung um.",
      "pci_de_us8": "Wenn mir andere Leute helfen, komme ich auch mit schwierigen Situationen zurecht."
    }
  }
}