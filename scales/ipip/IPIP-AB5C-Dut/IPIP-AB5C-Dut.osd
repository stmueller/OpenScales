      "ipip_H897": "Do improper things.",
      "ipip_H497": "Do the opposite of what is asked.",
      "ipip_text_don_t_think_laws_apply_to_me": "Don't think laws apply to me.",
      "ipip_H319": "Follow directions.",
      "ipip_H314": "Keep myself well-groomed.",
      "ipip_H853": "Make rash decisions.",
