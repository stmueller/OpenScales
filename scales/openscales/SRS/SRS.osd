  "translations": {
    "en": {
      "srs_qhead": "Please indicate how true each of the following statements is for you.",
      "srs_r1": "not at all true",
      "srs_r2": "barely true",
      "srs_r3": "moderately true",
      "srs_r4": "exactly true",
      "srs1": "I can concentrate on one activity for a long time, if necessary.",
      "srs2": "If I am distracted from an activity, I don't have any problem coming back to the topic quickly.",
      "srs3": "If an activity arouses my feelings too much, I can calm myself down so that I can continue with the activity soon.",
      "srs4": "If an activity requires a problem-oriented attitude, I can control my feelings.",
      "srs5": "It is difficult for me to suppress thoughts that interfere with what I need to do.",
      "srs6": "I can control my thoughts from distracting me from the task at hand.",
      "srs7": "When I worry about something, I cannot concentrate on an activity.",
      "srs8": "After an interruption, I don't have any problem resuming my concentrated style of working.",
      "srs9": "I have a whole bunch of thoughts and feelings that interfere with my ability to work in a focused way.",
      "srs10": "I stay focused on my goal and don't allow anything to distract me from my plan of action.",
      "LANGUAGE": "English"
    },
    "de": {
      "srs_qhead": "Bitte geben Sie an, inwieweit die folgenden Aussagen auf Sie zutreffen.",
      "srs_r1": "stimmt nicht",
      "srs_r2": "stimmt kaum",
      "srs_r3": "stimmt eher",
      "srs_r4": "stimmt genau",
      "srs1": "Ich kann mich lange Zeit auf eine Sache konzentrieren, wenn es nötig ist.",
      "srs2": "Wenn ich von einer Sache abgelenkt werde, komme ich schnell wieder zum Thema zurück.",
      "srs3": "Wenn ich bei einer Tätigkeit zu aufgeregt werde, kann ich mich so beruhigen, daß ich bald wieder weitermachen kann.",
      "srs4": "Wenn bei einer Tätigkeit eine sachliche Haltung nötig ist, kann ich meine Gefühle unter Kontrolle bringen.",
      "srs5": "Wenn störende Gedanken auftreten, kann ich sie nur schwer von mir wegschieben.",
      "srs6": "Ich kann es verhindern, daß die Gedanken ständig von meiner Aufgabe abschweifen.",
      "srs7": "Wenn ich Sorgen habe, kann ich mich nicht auf eine Tätigkeit konzentrieren.",
      "srs8": "Nach einer Unterbrechung finde ich problemlos zu einer konzentrierten Arbeitsweise zurück.",
      "srs9": "Alle möglichen Gedanken oder Gefühle lassen mir einfach keine Ruhe zum Arbeiten.",
      "srs10": "Ich behalte mein Ziel im Auge und lasse mich nicht vom Weg abbringen.",
      "LANGUAGE": "Deutsch"
    }
  }
}