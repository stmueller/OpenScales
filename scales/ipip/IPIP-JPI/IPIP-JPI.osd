  "translations": {
    "en": {
      "ipip_likert_1": "Very Inaccurate",
      "ipip_likert_2": "Moderately Inaccurate",
      "ipip_likert_3": "Neither Accurate Nor Inaccurate",
      "ipip_likert_4": "Moderately Accurate",
      "ipip_likert_5": "Very Accurate",
      "ipip_question_head": "<h3>How Accurately Can You Describe Yourself?</h3><p>Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate the accuracy of the item as it applies to you, using the following rating scale:</p>",
      "ipip_debrief": "Thank you for completing this questionnaire.",
      "section_title_ipip_jpi_axy": "IPIP JPI: Anxiety",
      "section_title_ipip_jpi_bdi": "IPIP JPI: Intellectual-Breadth",
      "section_title_ipip_jpi_cpr": "IPIP JPI: Conformity/Dependence/Need for approval",
      "section_title_ipip_jpi_cpx": "IPIP JPI: Intellectual-Complexity",
      "section_title_ipip_jpi_emp": "IPIP JPI: Empathy",
      "section_title_ipip_jpi_enl": "IPIP JPI: Activity-Level",
      "section_title_ipip_jpi_inv": "IPIP JPI: Ingenuity",
      "section_title_ipip_jpi_org": "IPIP JPI: Organization",
      "section_title_ipip_jpi_rkt": "IPIP JPI: Risk-taking/Sensation-Seeking/Thrill-Seeking",
      "section_title_ipip_jpi_rsy": "IPIP JPI: Responsibility",
      "section_title_ipip_jpi_sas": "IPIP JPI: Machiavellianism",
      "section_title_ipip_jpi_scf": "IPIP JPI: Social-confidence",
      "section_title_ipip_jpi_soc": "IPIP JPI: Sociability",
      "section_title_ipip_jpi_tol": "IPIP JPI: Tolerance",
      "section_title_ipip_jpi_trv": "IPIP JPI: Traditionalism",
      "ipip_X59": "Am not easily frustrated.",
      "ipip_E141": "Am relaxed most of the time.",
      "ipip_X95": "Get upset easily.",
