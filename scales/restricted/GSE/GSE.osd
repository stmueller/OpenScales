    "it": {
      "gse_r1": "Per nulla vero",
      "gse_r2": "Poco vero",
      "gse_r3": "Abbastanza vero",
      "gse_r4": "Totalmente vero",
      "gse_qhead": "Indichi il suo livello di accordo con ciascuna delle seguenti affermazioni.",
      "gse1":  "Riesco sempre a risolvere problemi difficili se ci provo abbastanza seriamente.",
