      "bfi2xs_r2": "In disaccordo",
      "bfi2xs_r3": "Né d'accordo né in disaccordo",
      "bfi2xs_r4": "D'accordo",
      "bfi2xs_r5": "Totalmente d'accordo",
      "bfi2xs1": "Tendo a stare in silenzio.",
      "bfi2xs2": "Sono compassionevole, ho un cuore tenero.",
      "bfi2xs3": "Tendo a essere disorganizzata/o.",
      "bfi2xs4": "Mi preoccupo molto.",
