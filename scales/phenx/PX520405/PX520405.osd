{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "name": "Expectancies - Alcohol, Cigarette Smoking, and Other Smoking - Prescription Stimulant Drugs",
      "code": "PX520405",
      "abbreviation": "PX520405",
      "description": "The Prescription Stimulant Expectancy Questionnaire (PSEQ) is a 40-item instrument containing statements about the positive and negative effect expectancies of prescription stimulants, such as methylphenidate (Ritalin?, Concerta?), dextroamphetamine (Dexedrine?), and amphetamine and dextroamphetamin",
      "domain": "Substance Use - Acute Response",
      "citation": "Looby, A., & Earleywine, M. (2010). Psychometric evaluation of a prescription stimulant expectancy questionnaire. Experimental and Clinical Psychopharmacology, 18 (4), 375–383. [PhenX: https://www.phenxtoolkit.org/protocols/view/520405]",
      "license": "PhenX Toolkit freely available protocol",
      "version": "1.0",
      "url": "https://www.phenxtoolkit.org/protocols/view/520405"
    },
