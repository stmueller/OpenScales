      {"id": "bfi27", "type": "likert", "text_key": "bfi27", "dimension": "agreeableness"},
      {"id": "bfi28", "type": "likert", "text_key": "bfi28", "dimension": "conscientiousness"},
      {"id": "bfi29", "type": "likert", "text_key": "bfi29", "dimension": "neuroticism"},
