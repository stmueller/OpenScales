  "translations": {
    "en": {
      "opt_1": "None of the time",
      "opt_2": "A little of the time",
      "opt_3": "Some of the time",
      "opt_4": "A good bit of the time",
      "opt_5": "Most of the time",
      "opt_6": "All of the time",
      "px880101_intro_text": "Overactive Bladder Short Form Questionnaire (OAB-q SF)Part A. Symptom BotherThis questionnaire asks about how much you have been bothered by selected bladder symptoms during the past 4 weeks. Please place a ✓ or x in the box that best describes the extent to which you were bothered by each symptom during the past four weeks. There are no right or wrong answers. Please be sure to answer every question.",
      "sec_during_the_past_4_weeks_how_bothered_wer_title": "During the past 4 weeks, how bothered were you by...",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate": "An uncomfortable urge to urinate?",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_uncomfortable_urge_urinate_opt_6": "A very great deal",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate": "A sudden urge to urinate with little or no warning?",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_sudden_urge_urinate_opt_6": "A very great deal",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine": "Accidental loss of small amounts of urine?",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_accidental_loss_small_urine_opt_6": "A very great deal",
      "overactive_bladder_4_weeks_bothered_nighttime_urination": "Nighttime urination?",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_nighttime_urination_opt_6": "A very great deal",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate": "Waking up at night because you had to urinate?",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_wake_up_night_urinate_opt_6": "A very great deal",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate": "Urine loss associated with a strong desire to urinate?",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_1": "Not at all",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_2": "A little bit",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_3": "Some- what",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_4": "Quite a bit",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_5": "A great deal",
      "overactive_bladder_4_weeks_bothered_urine_loss_desire_urinate_opt_6": "A very great deal",
      "px880101_middle_text": "Part B. Health Related Quality of LifeThe previous questions asked about your feelings about individual bladder symptoms. For the following questions, please think about your overall bladder symptoms in the past four weeks and how these symptoms have affected your life. Please answer each question about how often you have felt this way to the best of your ability. Please place a ✓ or x in the box that best answers each question.",
      "sec_during_the_past_week_how_often_have_your_title": "During the past week, how often have your bladder symptoms...",
      "overactive_bladder_past_week_symptoms_plan_escape_routes": "Caused you to plan \"escape routes\" to restrooms in public places?",
      "overactive_bladder_past_week_symptoms_feel_like_something_wrong": "Made you feel like there is something wrong with you?",
      "overactive_bladder_past_week_symptoms_interfere_ability_good_night_rest": "Interfered with your ability to get a good night's rest?",
      "overactive_bladder_past_week_symptoms_frustrated_annoyed_amount_time_in_restroom": "Made you frustrated or annoyed about the amount of time you spend in the restroom?",
      "overactive_bladder_past_week_symptoms_avoid_activities_away_from_restroom": "Made you avoid activities away from restrooms (i.e., walks, running, hiking)?",
      "overactive_bladder_past_week_symptoms_awakened_during_sleep": "Awakened you during sleep?",
      "overactive_bladder_past_week_symptoms_decrease_physical_activities": "Caused you to decrease your physical activities (exercising, sports, etc.)?",
      "overactive_bladder_past_week_symptoms_caused_problems_partner_spouse": "Caused you to have problems with your partner or spouse?",
      "overactive_bladder_past_week_symptoms_uncomfortable_traveling_need_stop_restroom": "Made you uncomfortable while traveling with others because of needing to stop for a restroom?",
      "overactive_bladder_past_week_symptoms_affect_relationships_friends_family": "Affected your relationships with family and friends?",
      "overactive_bladder_past_week_symptoms_interfere_getting_amount_sleep_needed": "Interfered with getting the amount of sleep you needed?",
      "overactive_bladder_past_week_symptoms_caused_embarrassment": "Caused you embarrassment?",
      "overactive_bladder_past_week_symptoms_caused_locate_closest_restroom": "Caused you to locate the closest restroom as soon as you arrive at a place you have never been?",
      "px880101_scoring": "<div class=\"rich-text-field-label\"><p>Scoring<br /><br />Symptom Bother Scale:<br /><br />To score the Symptom Bother scale, sum items 1-6 from part A.<br /><br />Lowest possible raw score: 6<br />Highest possible raw score: 36<br />Possible raw score range: 30<br /><br />A transformed symptom severity score can be obtained according to the following formula:<br /><br />Transformed Symptom Severity Score:</p> <table style=\"border-collapse: collapse; width: 43.4783%; height: 70px;\" border=\"1\"> <tbody> <tr style=\"height: 35px;\"> <td style=\"width: 100%; height: 35px;\">Actual raw score - lowest possible raw score</td> </tr> <tr style=\"height: 35px;\"> <td style=\"width: 100%; height: 35px;\">Possible raw score range</td> </tr> </tbody> </table> <p>X 100</p> <p>Health Related Quality of Life (HRQL) Scale:<br /><br />To score the HRQL scale, sum items 1-13 from part B. <br /><br />Lowest possible raw score: 13<br />Highest possible raw score: 78<br />Possible raw score range: 65<br /><br />A transformed HRQL score can be obtained according to the following formula:<br /><br />Transformed HRQL Score:</p> <table style=\"border-collapse: collapse; width: 41.3043%; height: 42px;\" border=\"1\"> <tbody> <tr style=\"height: 18px;\"> <td style=\"width: 100%; height: 18px;\">Highest possible score - Actual raw score</td> </tr> <tr style=\"height: 18px;\"> <td style=\"width: 100%; height: 18px;\">Possible raw score range</td> </tr> </tbody> </table> <p>X 100</p> <p>Missing Items. For the subscale analyses, if < 50% of the scale items are missing, the scale should be retained with the mean scale score of the items present used to impute a score for the missing items. If ≥50% of the items are missing, no scale score should be calculated, the subscale score should be considered missing.</p></div>"
    }
  }
}