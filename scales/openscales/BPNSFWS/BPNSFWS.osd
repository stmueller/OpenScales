{
  "osd_version": "1.0",
  "definition": {
    "scale_info": {
      "code": "BPNSFWS",
      "name": "Basic Psychological Need Satisfaction and Frustration at Work Scale",
      "abbreviation": "BPNSFWS",
      "description": "24-item scale measuring satisfaction and frustration of three basic psychological needs (autonomy, competence, relatedness) in the work context. Six subscales of 4 items each.",
      "citation": "Olafsen, A. H., Halvari, H., & Frølund, C. W. (2021). The Basic Psychological Need Satisfaction and Frustration at Work Scale: A validation study. Frontiers in Psychology, 12. https://doi.org/10.3389/fpsyg.2021.697306",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "url": "https://doi.org/10.3389/fpsyg.2021.697306",
      "version": "1.0",
      "domain": "Work & Organizational"
    },
    "implementation": {
      "author": "Shane T. Mueller",
      "organization": "OpenScales Project",
      "date": "2026-06-09",
      "license": "CC BY 4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "parameters": {
      "show_header": {
        "type": "boolean",
        "default": 1,
        "description": "Show scale title to respondents"
      },
      "shuffle_questions": {
        "type": "boolean",
        "default":  0,
        "description": "Randomize item presentation order"
      }
    },
    "likert_options": {
      "points": 7,
      "min": 1,
      "labels": [
        "BPNSFWS_r1", "BPNSFWS_r2", "BPNSFWS_r3", "BPNSFWS_r4",
        "BPNSFWS_r5", "BPNSFWS_r6", "BPNSFWS_r7"
      ],
      "question_head": "BPNSFWS_head"
    },
    "dimensions": [
      {
        "id": "AutonSat",
        "name": "Autonomy Satisfaction",
        "description": "Sense of choice, volition, and authentic expression at work"
      },
      {
        "id": "CompSat",
        "name": "Competence Satisfaction",
        "description": "Feeling capable and effective at work"
      },
      {
        "id": "RelSat",
        "name": "Relatedness Satisfaction",
        "description": "Feeling connected and cared for by colleagues"
      },
      {
        "id": "AutonFrus",
        "name": "Autonomy Frustration",
        "description": "Feeling pressured, controlled, or obligated at work"
      },
      {
        "id": "CompFrus",
        "name": "Competence Frustration",
        "description": "Feeling doubtful, insecure, or like a failure at work"
      },
      {
        "id": "RelFrus",
        "name": "Relatedness Frustration",
        "description": "Feeling excluded, disliked, or having only superficial work relationships"
      }
    ],
    "items": [
      { "id": "BPNSFWS001", "type": "likert", "text_key": "BPNSFWS001", "dimension": "AutonSat" },
      { "id": "BPNSFWS002", "type": "likert", "text_key": "BPNSFWS002", "dimension": "AutonSat" },
      { "id": "BPNSFWS003", "type": "likert", "text_key": "BPNSFWS003", "dimension": "AutonSat" },
      { "id": "BPNSFWS004", "type": "likert", "text_key": "BPNSFWS004", "dimension": "AutonSat" },
      { "id": "BPNSFWS005", "type": "likert", "text_key": "BPNSFWS005", "dimension": "CompSat" },
      { "id": "BPNSFWS006", "type": "likert", "text_key": "BPNSFWS006", "dimension": "CompSat" },
      { "id": "BPNSFWS007", "type": "likert", "text_key": "BPNSFWS007", "dimension": "CompSat" },
      { "id": "BPNSFWS008", "type": "likert", "text_key": "BPNSFWS008", "dimension": "CompSat" },
      { "id": "BPNSFWS009", "type": "likert", "text_key": "BPNSFWS009", "dimension": "RelSat" },
      { "id": "BPNSFWS010", "type": "likert", "text_key": "BPNSFWS010", "dimension": "RelSat" },
      { "id": "BPNSFWS011", "type": "likert", "text_key": "BPNSFWS011", "dimension": "RelSat" },
      { "id": "BPNSFWS012", "type": "likert", "text_key": "BPNSFWS012", "dimension": "RelSat" },
      { "id": "BPNSFWS013", "type": "likert", "text_key": "BPNSFWS013", "dimension": "AutonFrus" },
      { "id": "BPNSFWS014", "type": "likert", "text_key": "BPNSFWS014", "dimension": "AutonFrus" },
      { "id": "BPNSFWS015", "type": "likert", "text_key": "BPNSFWS015", "dimension": "AutonFrus" },
      { "id": "BPNSFWS016", "type": "likert", "text_key": "BPNSFWS016", "dimension": "AutonFrus" },
      { "id": "BPNSFWS017", "type": "likert", "text_key": "BPNSFWS017", "dimension": "CompFrus" },
      { "id": "BPNSFWS018", "type": "likert", "text_key": "BPNSFWS018", "dimension": "CompFrus" },
      { "id": "BPNSFWS019", "type": "likert", "text_key": "BPNSFWS019", "dimension": "CompFrus" },
      { "id": "BPNSFWS020", "type": "likert", "text_key": "BPNSFWS020", "dimension": "CompFrus" },
      { "id": "BPNSFWS021", "type": "likert", "text_key": "BPNSFWS021", "dimension": "RelFrus" },
      { "id": "BPNSFWS022", "type": "likert", "text_key": "BPNSFWS022", "dimension": "RelFrus" },
      { "id": "BPNSFWS023", "type": "likert", "text_key": "BPNSFWS023", "dimension": "RelFrus" },
      { "id": "BPNSFWS024", "type": "likert", "text_key": "BPNSFWS024", "dimension": "RelFrus" }
    ],
    "scoring": {
      "AutonSat": {
        "method": "mean_coded",
        "description": "Autonomy Satisfaction — mean of items 1–4",
        "items": { "BPNSFWS001": 1, "BPNSFWS002": 1, "BPNSFWS003": 1, "BPNSFWS004": 1 }
      },
      "CompSat": {
        "method": "mean_coded",
        "description": "Competence Satisfaction — mean of items 5–8",
        "items": { "BPNSFWS005": 1, "BPNSFWS006": 1, "BPNSFWS007": 1, "BPNSFWS008": 1 }
      },
      "RelSat": {
        "method": "mean_coded",
        "description": "Relatedness Satisfaction — mean of items 9–12",
        "items": { "BPNSFWS009": 1, "BPNSFWS010": 1, "BPNSFWS011": 1, "BPNSFWS012": 1 }
      },
      "AutonFrus": {
        "method": "mean_coded",
        "description": "Autonomy Frustration — mean of items 13–16",
        "items": { "BPNSFWS013": 1, "BPNSFWS014": 1, "BPNSFWS015": 1, "BPNSFWS016": 1 }
      },
      "CompFrus": {
        "method": "mean_coded",
        "description": "Competence Frustration — mean of items 17–20",
        "items": { "BPNSFWS017": 1, "BPNSFWS018": 1, "BPNSFWS019": 1, "BPNSFWS020": 1 }
      },
      "RelFrus": {
        "method": "mean_coded",
        "description": "Relatedness Frustration — mean of items 21–24",
        "items": { "BPNSFWS021": 1, "BPNSFWS022": 1, "BPNSFWS023": 1, "BPNSFWS024": 1 }
      }
    }
  },
  "translations": {
    "en": {
      "BPNSFWS_head": "Please indicate how much you agree or disagree with each statement about your work.",
      "BPNSFWS_r1": "Completely disagree",
      "BPNSFWS_r2": "2",
      "BPNSFWS_r3": "3",
      "BPNSFWS_r4": "4",
      "BPNSFWS_r5": "5",
      "BPNSFWS_r6": "6",
      "BPNSFWS_r7": "Completely agree",
      "BPNSFWS001": "I have a feeling of choice and freedom in what I do at work.",
      "BPNSFWS002": "I feel that the decisions I make at work reflect what I really want.",
      "BPNSFWS003": "At work, I feel that the choices I make express who I really am.",
      "BPNSFWS004": "At work, I feel that I do what really interests me.",
      "BPNSFWS005": "I feel confident that I can do things well at work.",
      "BPNSFWS006": "I feel capable of doing what I do at work.",
      "BPNSFWS007": "I feel competent in reaching my goals at work.",
      "BPNSFWS008": "I feel that I can successfully complete difficult tasks at work.",
      "BPNSFWS009": "I feel that the people I care about at work also care about me.",
      "BPNSFWS010": "I feel connected to the people at work who care about me and whom I care about.",
      "BPNSFWS011": "I feel closely connected to other people who are important to me at work.",
      "BPNSFWS012": "I experience a warm and good feeling with the people I spend time with at work.",
      "BPNSFWS013": "Most of the things I do at work, I do because I feel that I have to.",
      "BPNSFWS014": "At work, I feel forced to do many things that I would not have chosen to do.",
      "BPNSFWS015": "I feel pressured to do many of the things I do at work.",
      "BPNSFWS016": "My daily activities at work feel like a continuous line of duties.",
      "BPNSFWS017": "I seriously doubt whether I can do things well at work.",
      "BPNSFWS018": "I feel disappointment at many of my achievements at work.",
      "BPNSFWS019": "I feel insecure about my abilities at work.",
      "BPNSFWS020": "At work, I feel like a failure because of the mistakes I make.",
      "BPNSFWS021": "At work, I feel excluded from the group that I want to be a part of.",
      "BPNSFWS022": "At work, I feel that the people that are important to me are cold and distant towards me.",
      "BPNSFWS023": "I have the impression that people that I spend time with at work dislike me.",
      "BPNSFWS024": "I feel that the relations I have at work are only superficial."
    }
  }
}
