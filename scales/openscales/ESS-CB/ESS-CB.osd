    "sl": {
      "cb_head": "Koliko soglašate ali ne soglašate z naslednjima trditvama?",
      "secgrdec": "Majhna prikrita skupina ljudi je odgovorna za sprejemanje vseh najpomembnejših odločitev v svetovni politiki.",
